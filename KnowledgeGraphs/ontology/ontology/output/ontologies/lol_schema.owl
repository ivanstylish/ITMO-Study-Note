>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Mechanic">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Mechanic</rdfs:label>
    <rdfs:comment xml:lang="ru">Тип механики: щит, урон, обездвиживание и т. п.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#isAbilityOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>isAbilityOf</rdfs:label>
    <rdfs:comment xml:lang="ru">Умение принадлежит чемпиону; обратное hasAbility.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/lol-ontology#Ability"/>
    <rdfs:range rdf:resource="https://example.org/lol-ontology#Champion"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#canApplyMechanic">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>canApplyMechanic</rdfs:label>
    <rdfs:comment xml:lang="ru">Выводится цепочкой hasAbility / hasEffect / hasMechanic; не хранит условия.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/lol-ontology#Champion"/>
    <rdfs:range rdf:resource="https://example.org/lol-ontology#Mechanic"/>
    <owl:propertyChainAxiom rdf:nodeID="N9aaae5c7e8ed404b8c9f9994ec621293"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nb11c38d563ca47ffb8708c38dc8b8b2b">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://example.org/lol-ontology#hasEffect"/>
    <owl:someValuesFrom rdf:nodeID="Na869a23795b24e55bdf650fd9190144b"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <owl:versionInfo>1.0 / Data Dragon 16.20.1 / ru_RU</owl:versionInfo>
    <rdfs:label xml:lang="en">League of Legends: champions, abilities and effects</rdfs:label>
    <dcterms:title xml:lang="en">League of Legends: champions, abilities and effects</dcterms:title>
    <dcterms:description xml:lang="en">An OWL 2 DL ontology of champions, abilities and qualified effects. The demo contains Lux, Morgana and Karma. Effect conditions and source evidence are preserved. Data Dragon 16.20.1, ru_RU. Effect annotations reviewed by an assistant.</dcterms:description>
    <rdfs:comment xml:lang="ru">Учебная онтология. Качественная разметка эффектов проверена ассистентом только для Lux, Morgana, Karma. Условия сохранены текстом; вывод означает наличие способности при указанных условиях, а не результат любого применения. Отсутствие разметки не означает отсутствие механики. Числа из шаблонов tooltip не угадываются.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N73f8aec4db3d4cfa903df3f55757a13f">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://example.org/lol-ontology#hasCategory"/>
    <owl:hasValue rdf:resource="https://example.org/lol-ontology#Category_Mage"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#conditionText">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>conditionText</rdfs:label>
    <rdfs:domain rdf:resource="https://example.org/lol-ontology#AbilityEffect"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
