lol:Morgana_R a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Morgana_R" ;
    lol:description "Моргана высвобождает всю свою небесную мощь, расправляя крылья и взмывая над землей. Она выпускает цепи темной агонии во вражеских чемпионов поблизости и увеличивает свою скорость передвижения. Ее цепи замедляют и наносят начальный урон, а после задержки оглушают тех, кто не смог их разорвать."^^xsd:string ;
    lol:entityId "Morgana:R"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasEffect lol:Morgana_R_Damage_Enemy,
        lol:Morgana_R_MovementSpeedBoost_Self,
        lol:Morgana_R_Slow_Enemy,
        lol:Morgana_R_Stun_Enemy ;
    lol:hasSource lol:Source_Morgana ;
    lol:name "Оковы души"^^xsd:string ;
    lol:slot "R"^^xsd:string ;
    lol:tooltipText "Моргана приковывает себя цепями к окружающим вражеским чемпионам, нанося {{ totaldamage }} магического урона и замедляя их на {{ slowpercent }}%. Через {{ chainduration }} сек. враги, которые не смогли разорвать цепи, дополнительно получают {{ totaldamage }} магического урона и оглушаются на {{ stunduration }} сек. При применении этого умения Моргана увеличивает свою скорость передвижения на {{ hastepercent }}% .{{ spellmodifierdescriptionappend }}"^^xsd:string .

