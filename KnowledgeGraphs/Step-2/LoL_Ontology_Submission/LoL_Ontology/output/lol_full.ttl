lol:Karma_R a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Karma_R" ;
    lol:description "Карма усиливает свое следующее умение дополнительным эффектом. Мантра доступна на 1-м уровне и не требует очка умений."^^xsd:string ;
    lol:entityId "Karma:R"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasEffect lol:Karma_R_Empower_OwnAbility ;
    lol:hasSource lol:Source_Karma ;
    lol:name "Мантра"^^xsd:string ;
    lol:slot "R"^^xsd:string ;
    lol:tooltipText "Карма усиливает свое следующее умение, примененное в течение 8 сек. Внутреннее пламя : дополнительно наносит {{ rqimpactdamage }} магического урона и оставляет круг пламени, который замедляет врагов и наносит еще {{ rqfielddamage }} магического урона . Решимость : Карма восстанавливает {{ rwhealamount }} от недостающего здоровья во время образования и разрыва связи, а продолжительность обездвиживания увеличивается на {{ rwbonusroot }} сек. Воодушевление : прочность щита , накладываемого на цель, увеличивается на {{ rebonusshield }} . Кроме того, Карма накладывает на окружающих чемпионов щит прочностью {{ rebonusshieldarea }} и увеличивает их скорость передвижения на {{ removespeed*100 }}% .{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Karma_R_Empower_OwnAbility a owl:NamedIndividual,
        lol:AbilityEffect ;
    rdfs:label "Karma_R_Empower_OwnAbility" ;
    lol:conditionText "Усиливает следующее умение Кармы, примененное в течение 8 секунд."^^xsd:string ;
    lol:evidenceField "tooltip_text"^^xsd:string ;
    lol:evidenceText "Карма усиливает свое следующее умение, примененное в течение 8 сек. Внутреннее пламя : дополнительно наносит {{ rqimpactdamage }} магического урона и оставляет круг пламени, который замедляет врагов и наносит еще {{ rqfielddamage }} магического урона . Решимость : Карма восстанавливает {{ rwhealamount }} от недостающего здоровья во время образования и разрыва связи, а продолжительность обездвиживания увеличивается на {{ rwbonusroot }} сек. Воодушевление : прочность щита , накладываемого на цель, увеличивается на {{ rebonusshield }} . Кроме того, Карма накладывает на окружающих чемпионов щит прочностью {{ rebonusshieldarea }} и увеличивает их скорость передвижения на {{ removespeed*100 }}% .{{ spellmodifierdescriptionappend }}"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasMechanic lol:Empower ;
    lol:hasSource lol:Source_Karma ;
    lol:hasTargetType lol:OwnAbility ;
    lol:reviewStatus "reviewed_by_assistant"^^xsd:string .

lol:Karma_W a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Karma_W" ;
    lol:description "Карма создает связь с выбранным вражеским чемпионом, делая его видимым и нанося ему урон. Если связь не прерывается, враг обездвиживается и вновь получает урон. Эффект Мантры: Карма усиливает связь с врагом, восстанавливая себе здоровье и увеличивая продолжительность обездвиживания."^^xsd:string ;
    lol:entityId "Karma:W"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasEffect lol:Karma_W_Damage_Enemy,
        lol:Karma_W_Heal_Self,
        lol:Karma_W_Reveal_Enemy,
        lol:Karma_W_Root_Enemy ;
    lol:hasSource lol:Source_Karma ;
    lol:name "Решимость"^^xsd:string ;
    lol:slot "W"^^xsd:string ;
    lol:tooltipText "Карма создает связь между собой и чемпионом или лесным монстром, нанося цели {{ initialdamage }} магического урона и раскрывая ее на {{ tetherduration }} сек. Если связь не разрывается, цель снова получает {{ initialdamage }} магического урона и обездвиживается на {{ rootduration }} сек.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Karma_W_Damage_Enemy a owl:NamedIndividual,
        lol:AbilityEffect ;
    rdfs:label "Karma_W_Damage_Enemy" ;
    lol:conditionText "Выбранная вражеская цель связана с Кармой; повторный урон, если связь сохраняется."^^xsd:string ;
    lol:evidenceField "tooltip_text"^^xsd:string ;
    lol:evidenceText "Карма создает связь между собой и чемпионом или лесным монстром, нанося цели {{ initialdamage }} магического урона и раскрывая ее на {{ tetherduration }} сек. Если связь не разрывается, цель снова получает {{ initialdamage }} магического урона и обездвиживается на {{ rootduration }} сек.{{ spellmodifierdescriptionappend }}"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasMechanic lol:Damage ;
    lol:hasSource lol:Source_Karma ;
    lol:hasTargetType lol:Enemy ;
    lol:reviewStatus "reviewed_by_assistant"^^xsd:string .

lol:Karma_W_Heal_Self a owl:NamedIndividual,
        lol:AbilityEffect ;
    rdfs:label "Karma_W_Heal_Self" ;
    lol:conditionText "Только усиление Мантрой; Карма восстанавливает собственное здоровье."^^xsd:string ;
    lol:evidenceField "description_text"^^xsd:string ;
    lol:evidenceText "Карма создает связь с выбранным вражеским чемпионом, делая его видимым и нанося ему урон. Если связь не прерывается, враг обездвиживается и вновь получает урон. Эффект Мантры: Карма усиливает связь с врагом, восстанавливая себе здоровье и увеличивая продолжительность обездвиживания."^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasMechanic lol:Heal ;
    lol:hasSource lol:Source_Karma ;
    lol:hasTargetType lol:Self ;
    lol:reviewStatus "reviewed_by_assistant"^^xsd:string .

lol:Karma_W_Reveal_Enemy a owl:NamedIndividual,
        lol:AbilityEffect ;
    rdfs:label "Karma_W_Reveal_Enemy" ;
    lol:conditionText "На время связи раскрывается выбранная вражеская цель."^^xsd:string ;
    lol:evidenceField "tooltip_text"^^xsd:string ;
    lol:evidenceText "Карма создает связь между собой и чемпионом или лесным монстром, нанося цели {{ initialdamage }} магического урона и раскрывая ее на {{ tetherduration }} сек. Если связь не разрывается, цель снова получает {{ initialdamage }} магического урона и обездвиживается на {{ rootduration }} сек.{{ spellmodifierdescriptionappend }}"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasMechanic lol:Reveal ;
    lol:hasSource lol:Source_Karma ;
    lol:hasTargetType lol:Enemy ;
    lol:reviewStatus "reviewed_by_assistant"^^xsd:string .

lol:Karma_W_Root_Enemy a owl:NamedIndividual,
        lol:AbilityEffect ;
    rdfs:label "Karma_W_Root_Enemy" ;
    lol:conditionText "Связь должна сохраниться до конца задержки; для усиленной версии длительность увеличивается."^^xsd:string ;
    lol:evidenceField "description_text"^^xsd:string ;
    lol:evidenceText "Карма создает связь с выбранным вражеским чемпионом, делая его видимым и нанося ему урон. Если связь не прерывается, враг обездвиживается и вновь получает урон. Эффект Мантры: Карма усиливает связь с врагом, восстанавливая себе здоровье и увеличивая продолжительность обездвиживания."^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasMechanic lol:Root ;
    lol:hasSource lol:Source_Karma ;
    lol:hasTargetType lol:Enemy ;
    lol:reviewStatus "reviewed_by_assistant"^^xsd:string .

lol:Karthus_E a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Karthus_E" ;
    lol:description "Картус пассивно высасывает жизненную энергию из убитых им врагов, восстанавливая себе ману при каждом убийстве. Или же вместо этого он может окружить себя душами своих жертв, которые наносят урон ближайшим врагам, но быстро расходуют его ману."^^xsd:string ;
    lol:entityId "Karthus:E"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Karthus ;
    lol:name "Осквернение"^^xsd:string ;
    lol:slot "E"^^xsd:string ;
    lol:tooltipText "Пассивно: убивая бойца, Картус восстанавливает {{ manarestoreonkill }} ед. маны . Включено: Картус создает вокруг себя ауру смерти, нанося {{ totaldps }} ед. маг. урона в секунду врагам поблизости.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Karthus_P a owl:NamedIndividual,
        lol:PassiveAbility ;
    rdfs:label "Karthus_P" ;
    lol:description "После смерти Картус приобретает форму духа, которая позволяет ему продолжать использовать заклинания."^^xsd:string ;
    lol:entityId "Karthus:P"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Karthus ;
    lol:name "Победа над смертью"^^xsd:string ;
    lol:slot "P"^^xsd:string .

lol:Karthus_Q a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Karthus_Q" ;
    lol:description "Картус производит отложенный взрыв в указанном месте, нанося урон всем ближайшим врагам. Изолированные враги получают больше урона."^^xsd:string ;
    lol:entityId "Karthus:Q"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Karthus ;
    lol:name "Опустошение"^^xsd:string ;
    lol:slot "Q"^^xsd:string ;
    lol:tooltipText "Картус создает магический взрыв, который наносит {{ qdamage }} магического урона . Если взрыв поражает только одного врага, он наносит {{ qsingletargetdamage }} магического урона .{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Karthus_R a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Karthus_R" ;
    lol:description "Картус читает заклинание в течение 3 секунд, после чего наносит урон всем вражеским чемпионам."^^xsd:string ;
    lol:entityId "Karthus:R"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Karthus ;
    lol:name "Реквием"^^xsd:string ;
    lol:slot "R"^^xsd:string ;
    lol:tooltipText "Картус читает заклинание в течение 3 сек., после чего наносит {{ totaldamage }} магического урона всем вражеским чемпионам независимо от расстояния.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Karthus_W a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Karthus_W" ;
    lol:description "Картус создает энергетический барьер, который замедляет проходящих сквозь него врагов и уменьшает их сопротивление магии на некоторое время."^^xsd:string ;
    lol:entityId "Karthus:W"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Karthus ;
    lol:name "Стена боли"^^xsd:string ;
    lol:slot "W"^^xsd:string ;
    lol:tooltipText "Картус создает стену на {{ wallduration }} сек. Враги, проходящие сквозь нее, теряют {{ magicresistshred }}% сопр. магии на {{ debuffduration }} сек. и замедляются на {{ slowpercent }}% (эффект ослабевает в течение времени действия).{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Kassadin_E a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Kassadin_E" ;
    lol:description "Кассадин вытягивает энергию из заклинаний, применяющихся вокруг. Когда вытянуто достаточно энергии, Кассадин может использовать Выброс силы, чтобы нанести урон и замедлить противников перед собой."^^xsd:string ;
    lol:entityId "Kassadin:E"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Kassadin ;
    lol:name "Выброс силы"^^xsd:string ;
    lol:slot "E"^^xsd:string ;
    lol:tooltipText "Пассивно: перезарядка умения Выброс силы сокращается на {{ reductionperspellcast }} сек. каждый раз, когда около Кассадина применяется любое умение. Активно: Кассадин выпускает волну энергии Бездны, нанося {{ totaldamage }} ед. маг. урона и замедляя цели на {{ slowamount }}% на {{ slowduration }} сек.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Kassadin_P a owl:NamedIndividual,
        lol:PassiveAbility ;
    rdfs:label "Kassadin_P" ;
    lol:description "Кассадин получает меньше магического урона и может проходить сквозь бойцов."^^xsd:string ;
    lol:entityId "Kassadin:P"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Kassadin ;
    lol:name "Камень Бездны"^^xsd:string ;
    lol:slot "P"^^xsd:string .

lol:Kassadin_Q a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Kassadin_Q" ;
    lol:description "Кассадин выпускает во врага сгусток энергии Бездны, который наносит урон и прерывает использование умений. Кроме того, избыток энергии формирует вокруг Кассадина временный щит, поглощающий магический урон."^^xsd:string ;
    lol:entityId "Kassadin:Q"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Kassadin ;
    lol:name "Сфера пустоты"^^xsd:string ;
    lol:slot "Q"^^xsd:string ;
    lol:tooltipText "Кассадин выпускает сферу энергии Бездны, нанося {{ totaldamage }} магического урона и прерывая врагов, которые применяют умения. Кроме того, Кассадин получает щит от магического урона прочностью {{ totalshield }} на 1.5 сек.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Kassadin_R a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Kassadin_R" ;
    lol:description "Кассадин телепортируется в указанную точку, нанося урон ближайшим противникам. Последующие Шаги в Бездну в течение короткого промежутка времени требуют больше маны, но наносят больше урона."^^xsd:string ;
    lol:entityId "Kassadin:R"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Kassadin ;
    lol:name "Шаг в Бездну"^^xsd:string ;
    lol:slot "R"^^xsd:string ;
    lol:tooltipText "Кассадин телепортируется в указанную точку, нанося врагам {{ basedamage }} магического урона . Каждое последующее применение этого умения в течение следующих {{ rstackduration }} сек. расходует вдвое больше маны и дополнительно наносит {{ bonusdamage }} магического урона . Затраты и урон суммируются до {{ maxstacks }} раз.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Kassadin_W a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Kassadin_W" ;
    lol:description "Кассадин пассивно наносит дополнительный магический урон при автоатаках. При активации умения следующая автоатака Кассадина наносит существенный дополнительный магический урон и восстанавливает ману."^^xsd:string ;
    lol:entityId "Kassadin:W"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Kassadin ;
    lol:name "Клинок пустоты"^^xsd:string ;
    lol:slot "W"^^xsd:string ;
    lol:tooltipText "Пассивно: автоатаки Кассадина дополнительно наносят {{ onhitdamage }} магического урона . Активно: Кассадин заряжает свой клинок и при следующей автоатаке дополнительно наносит {{ activedamage }} магического урона , а также восстанавливает себе {{ missingmanaratio }}% от недостающей маны . Если цель – чемпион, восстановление увеличивается до {{ championmissingmanaratio }}% .{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Katarina_E a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Katarina_E" ;
    lol:description "Катарина телепортируется к цели, нанося урон этой цели, если ей окажется враг, или ближайшему врагу."^^xsd:string ;
    lol:entityId "Katarina:E"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Katarina ;
    lol:name "Шунпо"^^xsd:string ;
    lol:slot "E"^^xsd:string ;
    lol:tooltipText "Катарина мгновенно перемещается к выбранному союзнику, врагу или кинжалу , нанося {{ totaldamage }} магического урона , если целью оказался враг. Иначе этот урон получает ближайший противник. Каждый раз, когда Катарина подбирает кинжал , перезарядка этого умения сокращается на {{ daggercooldownreduction }} сек. ({{ tooltipdaggerreduction }} ). Катарина может переместиться в любое место рядом с целью.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Katarina_P a owl:NamedIndividual,
        lol:PassiveAbility ;
    rdfs:label "Katarina_P" ;
    lol:description "Оставшееся время перезарядки умений Катарины значительно сокращается каждый раз, когда умирает вражеский чемпион, которому она недавно нанесла урон. Когда Катарина подбирает кинжал , она производит круговую атаку, наносящую магический урон."^^xsd:string ;
    lol:entityId "Katarina:P"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Katarina ;
    lol:name "Ненасытность"^^xsd:string ;
    lol:slot "P"^^xsd:string .

lol:Katarina_Q a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Katarina_Q" ;
    lol:description "Катарина мечет во врага кинжал , который рикошетом поражает еще несколько целей, после чего падает на землю."^^xsd:string ;
    lol:entityId "Katarina:Q"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Katarina ;
    lol:name "Танцующий клинок"^^xsd:string ;
    lol:slot "Q"^^xsd:string ;
    lol:tooltipText "Катарина мечет кинжал , нанося {{ totaldamage }} магического урона цели и {{ maxbounces }} врагам поблизости. После этого кинжал отскакивает и падает на землю за основной целью.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Katarina_R a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Katarina_R" ;
    lol:description "Катарина становится вихрем клинков и наносит огромный магический урон трем ближайшим вражеским чемпионам."^^xsd:string ;
    lol:entityId "Katarina:R"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Katarina ;
    lol:name "Цветок смерти"^^xsd:string ;
    lol:slot "R"^^xsd:string ;
    lol:tooltipText "Катарина становится вихрем клинков и начинает быстро метать кинжалы в трех ближайших вражеских чемпионов. Каждый кинжал наносит {{ damagecalc }} магического урона и {{ addamagecalc }} физического урона , а также накладывает Страшные раны ({{ grievousamount*100 }}%) на {{ grievousduration }} сек. За {{ duration }} сек. каждый враг получает {{ totaldamagecalc }} магического урона и {{ totaladdamagecalc }} физического урона .{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Katarina_W a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Katarina_W" ;
    lol:description "Катарина подбрасывает над собой кинжал , ненадолго увеличивая свою скорость передвижения."^^xsd:string ;
    lol:entityId "Katarina:W"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Katarina ;
    lol:name "Подготовка"^^xsd:string ;
    lol:slot "W"^^xsd:string ;
    lol:tooltipText "Катарина подбрасывает в воздух кинжал , повышая свою скорость передвижения на {{ movespeedamount }}% (падает в течение {{ movespeedduration }} сек.).{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Kayle_E a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Kayle_E" ;
    lol:description "Пассивно: небесный меч Кейл, Добродетель, наносит дополнительный магический урон врагам, которых она атакует. Активно: следующая атака Кейл поражает врага небесным огнем, нанося дополнительный урон в зависимости от недостающего здоровья цели."^^xsd:string ;
    lol:entityId "Kayle:E"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Kayle ;
    lol:name "Клинок звездного огня"^^xsd:string ;
    lol:slot "E"^^xsd:string ;
    lol:tooltipText "Пассивно: автоатаки дополнительно наносят {{ epassivetotaldamage }} магического урона . Активно: следующая автоатака Кейл становится дальнобойной и дополнительно наносит магический урон в размере {{ activetotalexecutedamage }} от недостающего здоровья . Эта атака улучшается, когда Кейл достигает {{ spell.kaylepassive:levelforpassiverank2 }}-го уровня , и взрывается при поражении цели, нанося урон врагам поблизости.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Kayle_P a owl:NamedIndividual,
        lol:PassiveAbility ;
    rdfs:label "Kayle_P" ;
    lol:description "По мере того, как Кейл набирает уровни и тратит очки умений, ее автоатаки усиливаются небесами. Ее крылья воспламеняются, и она постепенно увеличивает скорость атаки, скорость передвижения и дальность атаки. Кроме того, она начинает выпускать волны пламени при автоатаках."^^xsd:string ;
    lol:entityId "Kayle:P"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Kayle ;
    lol:name "Божественное восхождение"^^xsd:string ;
    lol:slot "P"^^xsd:string .

lol:Kayle_Q a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Kayle_Q" ;
    lol:description "Кейл создает портал, призывая небесный меч, который пронзает врагов, снижая скорость передвижения, нанося урон и уменьшая защитные показатели при попадании."^^xsd:string ;
    lol:entityId "Kayle:Q"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Kayle ;
    lol:name "Лучезарный взрыв"^^xsd:string ;
    lol:slot "Q"^^xsd:string ;
    lol:tooltipText "Кейл запускает вперед небесный меч, который останавливается при поражении первого врага на пути, нанося цели и врагам за ней {{ totaldamage }} магического урона , замедляя их на {{ slowpercent }}% на {{ slowduration }} сек., а также уменьшая их броню и сопротивление магии на {{ shredpercent }}% на {{ shredduration }} сек.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Kayle_R a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Kayle_R" ;
    lol:description "Кейл делает союзника неуязвимым и взывает к прошлым Сущностям правосудия, чтобы те очистили область вокруг цели священным дождем из мечей."^^xsd:string ;
    lol:entityId "Kayle:R"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Kayle ;
    lol:name "Божественный приговор"^^xsd:string ;
    lol:slot "R"^^xsd:string ;
    lol:tooltipText "Кейл делает союзного чемпиона неуязвимым на {{ invulnduration }} сек. Затем она очищает область вокруг цели, нанося {{ totaldamage }} магического урона врагам поблизости.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Kayle_W a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Kayle_W" ;
    lol:description "Благословленная богами, Кейл восстанавливает здоровье и увеличивает скорость передвижения себе и ближайшему союзнику."^^xsd:string ;
    lol:entityId "Kayle:W"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Kayle ;
    lol:name "Благословение небес"^^xsd:string ;
    lol:slot "W"^^xsd:string ;
    lol:tooltipText "Кейл наполняет себя и союзного чемпиона светом, восстанавливая {{ totalheal }} здоровья и увеличивая скорость передвижения на {{ totalhaste }} на {{ hasteduration }} сек.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Kayn_E a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Kayn_E" ;
    lol:description "Каин может проходить сквозь элементы ландшафта."^^xsd:string ;
    lol:entityId "Kayn:E"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Kayn ;
    lol:name "Шаг в сумерки"^^xsd:string ;
    lol:slot "E"^^xsd:string ;
    lol:tooltipText "Каин увеличивает свою скорость передвижения на {{ e1 }}% , становится призрачным и получает способность проходить сквозь элементы ландшафта на {{ e2 }} сек. При первом прохождении сквозь элемент ландшафта Каин восстанавливает {{ totalhealing }} здоровья . Если Каина обездвиживают или он находится вне элементов ландшафта более {{ e3 }} сек. подряд, действие этого умения прекращается преждевременно. Сумеречный убийца: скорость передвижения Каина увеличивается на {{ e5 }}% . Кроме того, он становится невосприимчивым к замедлению и сокращает перезарядку этого умения до {{ assassincdreduction }} сек.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Kayn_P a owl:NamedIndividual,
        lol:PassiveAbility ;
    rdfs:label "Kayn_P" ;
    lol:description "Каин владеет древним оружием и ведет борьбу с заключенным в нем даркином Раастом. В итоге либо побеждает даркин , либо Каин берет верх над Раастом и становится Сумеречным убийцей . Даркин: восстанавливает здоровье на величину, зависящую от урона, нанесенного чемпионам умениями. Сумеречный убийца: в течение первых секунд после начала боя с вражескими чемпионами наносит дополнительный урон."^^xsd:string ;
    lol:entityId "Kayn:P"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Kayn ;
    lol:name "Коса даркинов"^^xsd:string ;
    lol:slot "P"^^xsd:string .

lol:Kayn_Q a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Kayn_Q" ;
    lol:description "Каин делает рывок, а затем совершает удар. И то, и другое наносит урон."^^xsd:string ;
    lol:entityId "Kayn:Q"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Kayn ;
    lol:name "Смертельный росчерк"^^xsd:string ;
    lol:slot "Q"^^xsd:string ;
    lol:tooltipText "Каин совершает рывок, нанося врагам на пути {{ totaldamage }} физического урона , а затем бьет косой по кругу, нанося врагам поблизости такой же урон. Даркин-душегуб: умение наносит физический урон в размере {{ darkinflatdamage }} плюс {{ darkinpercentdamage }} от максимального запаса здоровья .{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Kayn_R a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Kayn_R" ;
    lol:description "Каин прячется в теле врага, нанося значительный урон во время выхода."^^xsd:string ;
    lol:entityId "Kayn:R"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Kayn ;
    lol:name "Теневая интервенция"^^xsd:string ;
    lol:slot "R"^^xsd:string ;
    lol:tooltipText "Пассивно: когда Каин наносит урон чемпиону, тот помечается на 3.15 сек. Каин вселяется в помеченного врага, становясь недосягаемым. Через {{ infestduration }} сек. или при повторном применении Каин вырывается из врага, нанося ему {{ damage }} физического урона . Сумеречный убийца: дальность действия увеличена (как при вселении в жертву, так и при покидании ее). Когда Каин покидает жертву, он сбрасывает перезарядку Косы даркинов . Даркин-душегуб: умение наносит физический урон в размере {{ slayerdamage }} от максимального запаса здоровья и восстанавливает {{ healvalue }} здоровья ({{ slayerhealpercent*100 }}% от нанесенного урона).{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Kayn_W a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Kayn_W" ;
    lol:description "Каин наносит урон врагам на линии перед собой, а также замедляет их."^^xsd:string ;
    lol:entityId "Kayn:W"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Kayn ;
    lol:name "Широкий размах"^^xsd:string ;
    lol:slot "W"^^xsd:string ;
    lol:tooltipText "Каин бьет косой снизу вверх, нанося пораженным врагам {{ totaldamage }} физического урона и замедляя их на {{ e3 }}% (эффект ослабевает в течение {{ e5 }} сек.). Сумеречный убийца: Каин может передвигаться во время применения этого умения, при этом дальность умения увеличена. Даркин-душегуб: умение подбрасывает пораженных врагов на {{ e2 }} сек.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Kennen_E a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Kennen_E" ;
    lol:description "Кеннен превращается в молнию, получая возможность проходить сквозь бойцов и накладывать Знак бури. В этой форме у Кеннена увеличивается скорость передвижения, а после выхода из нее – скорость атаки."^^xsd:string ;
    lol:entityId "Kennen:E"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Kennen ;
    lol:name "Молниеносный рывок"^^xsd:string ;
    lol:slot "E"^^xsd:string ;
    lol:tooltipText "Кеннен превращается в шаровую молнию, получает {{ movementspeed*100 }}% скорости передвижения и наносит {{ totaldamage }} ед. маг. урона врагам, которых коснется, и получает призрачность на {{ durationasball }} сек. Если Кеннен наносит урон хотя бы 1 врагу, он получает {{ energyrefund }} энергии. По окончании действия умения Кеннен получает {{ totalas*100 }}% скорости атаки на {{ durationafterball }} сек. Крит. удары повышают длительность эффекта на {{ critdurationbonus }} сек. Кеннен может повторно применить это умение, чтобы досрочно прекратить его действие.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Kennen_P a owl:NamedIndividual,
        lol:PassiveAbility ;
    rdfs:label "Kennen_P" ;
    lol:description "Кеннен оглушает врагов, которых поражает своими умениями 3 раза."^^xsd:string ;
    lol:entityId "Kennen:P"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Kennen ;
    lol:name "Знак бури"^^xsd:string ;
    lol:slot "P"^^xsd:string .

lol:Kennen_Q a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Kennen_Q" ;
    lol:description "Кеннен мечет сюрикен в указанном направлении, нанося урон и накладывая Знак бури, если попадет в противника."^^xsd:string ;
    lol:entityId "Kennen:Q"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Kennen ;
    lol:name "Грохочущий сюрикен"^^xsd:string ;
    lol:slot "Q"^^xsd:string ;
    lol:tooltipText "Кеннен мечет сюрикен, наносящий {{ totaldamage }} магического урона первому врагу на пути.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Kennen_R a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Kennen_R" ;
    lol:description "Кеннен призывает бурю, которая наносит магический урон окружающим вражеским чемпионам."^^xsd:string ;
    lol:entityId "Kennen:R"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Kennen ;
    lol:name "Убийственный шторм"^^xsd:string ;
    lol:slot "R"^^xsd:string ;
    lol:tooltipText "Кеннен создает бурю, нанося {{ pertickdamagecalculated }} магического урона всем окружающим врагам раз в {{ kennenrtickrate }} сек., а также получая {{ kennenrdefenses }} брони и {{ kennenrdefenses }} сопротивления магии . Буря действует в течение {{ kennenrduration }} сек. Если враг поражается несколько раз, каждый последующий разряд наносит ему на {{ damageamp*100 }}% больше урона.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Kennen_W a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Kennen_W" ;
    lol:description "Кеннен пассивно наносит дополнительный урон и накладывает на цель Знак бури при каждой пятой автоатаке. Активация этого умения накладывает еще один Знак бури на всех уже отмеченных врагов неподалеку и наносит им урон."^^xsd:string ;
    lol:entityId "Kennen:W"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Kennen ;
    lol:name "Скачок напряжения"^^xsd:string ;
    lol:slot "W"^^xsd:string ;
    lol:tooltipText "Пассивно: каждая 5-я автоатака дополнительно наносит {{ totaldamagepassive }} ед. маг. урона %i:OnHit% при попадании . Активно: Кеннен выпускает заряд электричества, нанося {{ totaldamageactive }} ед. маг. урона ближайшим врагам, на которых наложен Знак бури . {{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Khazix_E a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Khazix_E" ;
    lol:description "Ка'Зикс прыгает в указанную область, нанося физ. урон врагам поблизости при приземлении. Если у него развиты Крылья , дальность прыжка растет, а перезарядка сбрасывается при убийстве враж. чемпиона или содействии."^^xsd:string ;
    lol:entityId "Khazix:E"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Khazix ;
    lol:name "Прыжок"^^xsd:string ;
    lol:slot "E"^^xsd:string ;
    lol:tooltipText "Ка'Зикс прыгает в выбранное место, нанося {{ totaldamage }} физического урона при приземлении.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Khazix_P a owl:NamedIndividual,
        lol:PassiveAbility ;
    rdfs:label "Khazix_P" ;
    lol:description "Ближайшие враги, изолированные от своих союзников, помечаются. Умения Ка'Зикса усиливаются при охоте на изолированных врагов. Когда вражеская команда не видит Ка'Зикса, он создает Невидимую угрозу и при следующей автоатаке против вражеского чемпиона дополнительно наносит ему магический урон и уменьшает его скорость передвижения на несколько секунд."^^xsd:string ;
    lol:entityId "Khazix:P"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Khazix ;
    lol:name "Невидимая угроза"^^xsd:string ;
    lol:slot "P"^^xsd:string .

lol:Khazix_Q a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Khazix_Q" ;
    lol:description "Наносит физический урон цели. Урон увеличивается против изолированных врагов. Если развиты Когти Жнеца , перезарядка умения сокращается при атаке изолированной цели. Дальность атаки Ка'Зикса и дальность поражения Вкуса страха увеличены."^^xsd:string ;
    lol:entityId "Khazix:Q"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Khazix ;
    lol:name "Вкус страха"^^xsd:string ;
    lol:slot "Q"^^xsd:string ;
    lol:tooltipText "Ка'Зикс рассекает врага поблизости, нанося {{ spell.khazixq:basedamage }} физического урона . Если цель изолирована , урон увеличивается до {{ spell.khazixq:isodamage }} . {{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Khazix_R a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Khazix_R" ;
    lol:description "Каждый новый уровень Атаки из Бездны позволяет Ка'Зиксу развить одно из своих умений, придав ему дополнительный уникальный эффект. При активации умения Ка'Зикс становится невидимым , создавая Невидимую угрозу, и его скорость передвижения увеличивается. Если развит Адаптивный камуфляж , продолжительность действия невидимости Атаки из Бездны увеличивается, и Ка'Зикс может применить умение еще раз."^^xsd:string ;
    lol:entityId "Khazix:R"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Khazix ;
    lol:name "Атака из Бездны"^^xsd:string ;
    lol:slot "R"^^xsd:string ;
    lol:tooltipText "Активно: Ка'Зикс становится невидимым на {{ stealthduration }} сек. и увеличивает свою скорость передвижения на {{ bonusmovementspeedpercent*100 }}% . Ка'Зикс может один раз повторно применить это умение в течение {{ recastwindow }} сек. Пассивно: при повышении уровня этого умения Ка'Зикс получает возможность развить одно из своих умений, получив дополнительные эффекты. Вкус страха: дальность действия этого умения и автоатак увеличена, а при применении к изолированным целям его перезарядка сокращается на {{ spell.khazixq:effect4amount }}%. Шипы Бездны: Ка'Зикс выпускает 3 шипа, которые замедляют на {{ spell.khazixw:effect3amount }}%. Сила замедления против изолированных целей увеличена. Прыжок: дальность увеличена, а при участии в убийстве чемпиона перезарядка этого умения сбрасывается. Атака из Бездны: продолжительность невидимости увеличена на {{ evolvedstealthduration }} сек., и Ка'Зикс может второй раз повторно применить это умение.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Khazix_W a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Khazix_W" ;
    lol:description "Ка'Зикс стреляет шипами, которые взрываются при попадании, нанося физический урон всем пораженным врагам. Если взрыв задевает самого Ка'Зикса, он восстанавливает себе здоровье. Если развиты Шипованные наросты , Ка'Зикс стреляет тремя группами шипов веером, при этом замедляя пораженных врагов и раскрывая вражеских чемпионов на 2 сек. Замедление усиливается против изолированных целей."^^xsd:string ;
    lol:entityId "Khazix:W"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Khazix ;
    lol:name "Шипы Бездны"^^xsd:string ;
    lol:slot "W"^^xsd:string ;
    lol:tooltipText "Ка'Зикс выпускает шип, нанося {{ basedamage }} физического урона первому пораженному врагу в небольшой области. Если Ка'Зикс находится в этой области, он восстанавливает себе {{ healamount }} здоровья .{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Kindred_E a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Kindred_E" ;
    lol:description "Овечка делает точный выстрел, замедляя врага. Если после этого она дважды поражает его автоатаками, при третьей автоатаке на него набрасывается Волк, нанося огромный урон."^^xsd:string ;
    lol:entityId "Kindred:E"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Kindred ;
    lol:name "Всепоглощающий ужас"^^xsd:string ;
    lol:slot "E"^^xsd:string ;
    lol:tooltipText "Киндред ослабляют врага, замедляя его на {{ totalslow }}% на {{ slowduration }} сек. Во время третьей автоатаки Киндред против цели на нее набрасывается Волк, нанося физический урон в размере {{ basebitedamage }} ед. плюс {{ percentbitedamage }} от недостающего здоровья . Если между атаками проходит {{ totalduration }} сек., эффект пропадает.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Kindred_P a owl:NamedIndividual,
        lol:PassiveAbility ;
    rdfs:label "Kindred_P" ;
    lol:description "Киндред могут помечать цели для охоты. Удачная охота усиливает базовые умения Киндред до конца игры. Каждые 4 удачные попытки поохотиться увеличивают дальность автоатак Киндред."^^xsd:string ;
    lol:entityId "Kindred:P"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Kindred ;
    lol:name "Знак Киндред"^^xsd:string ;
    lol:slot "P"^^xsd:string .

lol:Kindred_Q a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Kindred_Q" ;
    lol:description "Овечка делает рывок в выбранном направлении, а затем стреляет, поражая до трех врагов."^^xsd:string ;
    lol:entityId "Kindred:Q"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Kindred ;
    lol:name "Танец стрел"^^xsd:string ;
    lol:slot "Q"^^xsd:string ;
    lol:tooltipText "Киндред совершают рывок и выпускают стрелы в 3 врагов, нанося {{ totaldamage }} ед. физ. урона и получая {{ totalqattackspeed }} скорости атаки на {{ baseasduration }} сек. Пока Киндред в области действия умения Волчье бешенство , перезарядка этого умения сокращена до {{ cdnewvalue }} сек.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Kindred_R a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Kindred_R" ;
    lol:description "Овечка дарует всем бойцам в зоне действия умения защиту от смерти. Во время действия умения никто не может умереть. По окончании его действия всем восстанавливается здоровье."^^xsd:string ;
    lol:entityId "Kindred:R"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Kindred ;
    lol:name "Милость Овечки"^^xsd:string ;
    lol:slot "R"^^xsd:string ;
    lol:tooltipText "Киндред благословляют землю вокруг себя на {{ buffduration }} сек., создавая область, в которой никто не умирает (действует на всех союзных, вражеских и нейтр. бойцов). Когда здоровье бойца достигает 10%, он получает невосприимчивость к урону и лечению, пока не покинет область. По окончании действия благословения все бойцы в области восстанавливают {{ healflat }} здоровья .{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Kindred_W a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Kindred_W" ;
    lol:description "Волк впадает в ярость и атакует врагов вокруг себя. Атакуя и передвигаясь, Овечка пассивно накапливает заряды. При накоплении максимального количества зарядов следующая атака Овечки восстанавливает здоровье."^^xsd:string ;
    lol:entityId "Kindred:W"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Kindred ;
    lol:name "Волчье бешенство"^^xsd:string ;
    lol:slot "W"^^xsd:string ;
    lol:tooltipText "Пассивно: Киндред получают заряды, когда передвигаются и атакуют. После накопления 100 зарядов следующая автоатака восстанавливает Киндред до {{ attackheal }} здоровья в зависимости от их недостающего здоровья. Активно: Киндред очерчивают область, в которой Волк кусает последнего врага, атакованного Овечкой. Укусы Волка наносят магический урон в размере {{ basewolfdamage }} плюс {{ percentwolfdamage }} от текущего здоровья .{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Kled_E a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Kled_E" ;
    lol:description "Клед совершает рывок, нанося физический урон и временно увеличивая свою скорость передвижения. Клед может повторно активировать это умение, чтобы совершить рывок через цель предыдущего рывка, повторно нанося ей урон."^^xsd:string ;
    lol:entityId "Kled:E"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Kled ;
    lol:name "Рыцарский поединок"^^xsd:string ;
    lol:slot "E"^^xsd:string ;
    lol:tooltipText "Клед совершает рывок, нанося {{ totaldamage }} ед. физического урона всем врагам на пути, а также подтягивая к себе миньонов и небольших монстров. Если во время рывка был поражен вражеский чемпион или большой лесной монстр, скорость передвижения Кледа увеличивается на {{ movespeed*100 }}% на {{ movespeedduration }} сек. и он получает возможность повторно применить это умение в течение {{ recastwindow }} сек., совершив рывок через ту же цель.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Kled_P a owl:NamedIndividual,
        lol:PassiveAbility ;
    rdfs:label "Kled_P" ;
    lol:description "Клед ездит верхом на своей верной ящерице Скарл, которая получает за него урон. Когда здоровье Скарл достигает нуля, она оставляет Кледа одного. У спешившегося Кледа изменяются умения, и он наносит меньше урона чемпионам. Вступая в бой с врагами, Клед может вернуть мужество Скарл. Когда Скарл наберется мужества, она возвращается к Кледу и увеличивает его запас здоровья."^^xsd:string ;
    lol:entityId "Kled:P"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Kled ;
    lol:name "Трусливая ящерица Скарл"^^xsd:string ;
    lol:slot "P"^^xsd:string .

lol:Kled_Q a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Kled_Q" ;
    lol:description "Клед бросает капкан, который наносит урон и вцепляется в первого попавшегося вражеского чемпиона. Если капкан удержится на цели в течение некоторого времени, Клед притянет к себе цель и нанесет ей дополнительный физический урон. Когда Клед идет пешком, это умение превращается в Карманный пистолет - дальнобойное оружие, которое отбрасывает Кледа отдачей и возвращает мужество Скарл."^^xsd:string ;
    lol:entityId "Kled:Q"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Kled ;
    lol:name "Капкан на веревке"^^xsd:string ;
    lol:slot "Q"^^xsd:string ;
    lol:tooltipText "Верхом: Клед бросает капкан, который наносит первому пораженному вражескому чемпиону или большому лесному монстру {{ totaldamage }} ед. физического урона и цепляется за него. Если Клед остается рядом с зацепленной целью в течение {{ tetherpoptime }} сек., он дергает за веревку, нанося врагу {{ totalyankdamage }} ед. физического урона , подтягивая его к себе и замедляя на {{ slowamount*-100 }}% на {{ slowduration }} сек.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Kled_R a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Kled_R" ;
    lol:description "Клед и Скарл скачут вперед в выбранном направлении, получая крепнущий со временем щит и увеличивая скорость передвижения союзников, следующих за ними. Скарл выбирает целью первого встреченного вражеского чемпиона и таранит его."^^xsd:string ;
    lol:entityId "Kled:R"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Kled ;
    lol:name "В бо-о-ой!!!"^^xsd:string ;
    lol:slot "R"^^xsd:string ;
    lol:tooltipText "Клед скачет в выбранную область, оставляя за собой след, который постепенно увеличивает скорость передвижения союзников. Во время разгона и в течение 2 сек. после этого на Кледа действует щит прочностью до {{ maximumshield }} . Скарл таранит первого встреченного на своем пути вражеского чемпиона, нанося ему магический урон в размере {{ minimumdamagetooltip }}–{{ maximumchargedamage }} от максимального запаса здоровья (в зависимости от пройденного расстояния) и ненадолго отбрасывая .{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Kled_W a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Kled_W" ;
    lol:description "Скорость атаки Кледа значительно увеличивается на следующие четыре автоатаки. Четвертая автоатака наносит еще больше урона."^^xsd:string ;
    lol:entityId "Kled:W"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Kled ;
    lol:name "Склонность к насилию"^^xsd:string ;
    lol:slot "W"^^xsd:string ;
    lol:tooltipText "Пассивно: следующая автоатака Кледа увеличивает его скорость атаки на {{ attackspeed*100 }}% на четыре автоатаки или на {{ activeduration }} сек. Четвертая автоатака дополнительно наносит физический урон в размере {{ baseflatdamage }} ед. плюс {{ percentdamage }} от максимального запаса здоровья .{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:KogMaw_E a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "KogMaw_E" ;
    lol:description "Ког'Мао выплевывает сгусток слизи, который наносит урон всем врагам на своем пути и оставляет за собой след, замедляющий прошедших по нему противников."^^xsd:string ;
    lol:entityId "KogMaw:E"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_KogMaw ;
    lol:name "Слизь Бездны"^^xsd:string ;
    lol:slot "E"^^xsd:string ;
    lol:tooltipText "Ког'Мао выплевывает слизь, которая наносит {{ totaldamage }} ед. магического урона и оставляет за собой след на {{ trailduration }} сек. Враги в слизи замедляются на {{ slowamount }}%.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:KogMaw_P a owl:NamedIndividual,
        lol:PassiveAbility ;
    rdfs:label "KogMaw_P" ;
    lol:description "В течение 4 сек. после смерти Ког'Мао взрывается, нанося чистый урон окружающим противникам."^^xsd:string ;
    lol:entityId "KogMaw:P"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_KogMaw ;
    lol:name "Привет из Икатии"^^xsd:string ;
    lol:slot "P"^^xsd:string .

lol:KogMaw_Q a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "KogMaw_Q" ;
    lol:description "Ког'Мао плюет кислотой, нанося магический урон и на короткое время уменьшая броню и сопротивление магии цели. Скорость атаки Ког'Мао увеличивается."^^xsd:string ;
    lol:entityId "KogMaw:Q"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_KogMaw ;
    lol:name "Едкий плевок"^^xsd:string ;
    lol:slot "Q"^^xsd:string ;
    lol:tooltipText "Пассивно: скорость атаки Ког'Мао увеличена на {{ attackspeed*100 }}% . Активно: Ког'Мао плюется сгустком кислоты, который наносит первому пораженному врагу {{ totaldamage }} ед. магического урона и уменьшает его броню и сопротивление магии на {{ shredamount }}% на {{ shredduration }} сек.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:KogMaw_R a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "KogMaw_R" ;
    lol:description "Ког'Мао выпускает снаряд на большое расстояние, нанося магический урон и раскрывая пораженных врагов (кроме невидимых). Враги, у которых осталось мало здоровья, получают гораздо больше урона. Каждое последующее использование Живой артиллерии в течение короткого промежутка времени требует все больших затрат маны."^^xsd:string ;
    lol:entityId "KogMaw:R"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_KogMaw ;
    lol:name "Живая артиллерия"^^xsd:string ;
    lol:slot "R"^^xsd:string ;
    lol:tooltipText "Ког'Мао стреляет кислотой в выбранную область, нанося пораженным врагам магический урон в размере {{ basedamagecalc }} плюс {{ tooltipmissinghealthdamageamp }}% за каждый 1% недостающего здоровья и раскрывая их на 2 сек. Враги, у которых осталось менее 40% здоровья , вместо этого получают {{ maxdamagecalc }} магического урона . Каждый последующий выстрел в течение {{ manacostduration }} сек. расходует на {{ basecost }} больше маны (максимальные затраты: {{ manacostcap }} маны ).{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:KogMaw_W a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "KogMaw_W" ;
    lol:description "Дальность атаки Ког'Мао растет, его автоатаки начинают наносить доп. маг. урон, зависящий от макс. здоровья цели, %i:OnHit% при попадании ."^^xsd:string ;
    lol:entityId "KogMaw:W"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_KogMaw ;
    lol:name "Биомагический обстрел"^^xsd:string ;
    lol:slot "W"^^xsd:string ;
    lol:tooltipText "Ког'Мао повышает свою дальности атаки на {{ range }} на {{ duration }} сек. В течение этого времени его автоатаки дополнительно наносят маг. урон в размере {{ totalhealthdamage }} от макс. здоровья %i:OnHit% при попадании .{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Leblanc_E a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Leblanc_E" ;
    lol:description "Ле Блан бросает цепь, которая сковывает первого пораженного врага. Если цель остается скованной в течение 1.5 секунды, Ле Блан обездвиживает ее и наносит дополнительный урон."^^xsd:string ;
    lol:entityId "Leblanc:E"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Leblanc ;
    lol:name "Эфемерные цепи"^^xsd:string ;
    lol:slot "E"^^xsd:string ;
    lol:tooltipText "Ле Блан бросает цепь, которая сковывает первого пораженного врага, нанося {{ initialdamage }} ед. магического урона . Ле Блан получает истинное видение цели. Если цель скована в течение {{ tetherduration }} сек., Ле Блан обездвиживает ее на {{ rootduration }} сек. и дополнительно наносит {{ delayeddamage }} ед. магического урона .{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Leblanc_P a owl:NamedIndividual,
        lol:PassiveAbility ;
    rdfs:label "Leblanc_P" ;
    lol:description "Когда у Ле Блан остается менее 40% здоровья, она становится невидимой на 1 сек. и на 8 сек. создает свою копию, которая не наносит урона."^^xsd:string ;
    lol:entityId "Leblanc:P"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Leblanc ;
    lol:name "Отражение"^^xsd:string ;
    lol:slot "P"^^xsd:string .

lol:Leblanc_Q a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Leblanc_Q" ;
    lol:description "Ле Блан накладывает на врага печать, нанося ему урон и помечая на 3.5 секунды. При нанесении урона умением помеченной цели печать взрывается, нанося дополнительный урон. Если любой из этих эффектов убивает цель, Ле Блан восстанавливает себе часть затраченной маны и сокращает оставшееся время перезарядки этого умения."^^xsd:string ;
    lol:entityId "Leblanc:Q"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Leblanc ;
    lol:name "Печать порока"^^xsd:string ;
    lol:slot "Q"^^xsd:string ;
    lol:tooltipText "Ле Блан накладывает на врага печать, нанося {{ damage }} магического урона и помечая его на {{ markduration }} сек. Когда Ле Блан наносит помеченной цели урон умением, печать взрывается, нанося {{ markdamage }} магического урона . Если любой из этих эффектов убивает цель, Ле Блан восстанавливает себе {{ manarefund*100 }}% от затраченной маны и сокращает оставшееся время перезарядки этого умения на {{ cooldownrefund*100 }}%. Первый эффект наносит {{ bonusminiondamage }} дополнительного урона миньонам. {{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Leblanc_R a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Leblanc_R" ;
    lol:description "Ле Блан применяет копию одного из своих базовых умений."^^xsd:string ;
    lol:entityId "Leblanc:R"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Leblanc ;
    lol:name "Копия"^^xsd:string ;
    lol:slot "R"^^xsd:string ;
    lol:tooltipText "Ле Блан копирует последнее использованное умение, применяя его снова. Копия умения наносит больше урона. Копия Печати порока наносит {{ rq1damage }} магического урона при наложении печати и {{ rq2damage }} магического урона при ее взрыве. Копия Искажения наносит {{ rwdamage }} магического урона . Копия Эфемерных цепей наносит {{ re1damage }} магического урона при попадании цепью и {{ re2damage }} магического урона при обездвиживании .{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Leblanc_W a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Leblanc_W" ;
    lol:description "Ле Блан совершает рывок в выбранную точку, после чего наносит урон врагам вокруг себя. При повторной активации умения в течение следующих 4 секунд она возвращается в исходную точку."^^xsd:string ;
    lol:entityId "Leblanc:W"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Leblanc ;
    lol:name "Искажение"^^xsd:string ;
    lol:slot "W"^^xsd:string ;
    lol:tooltipText "Ле Блан совершает рывок, после чего наносит {{ totaldamage }} ед. магического урона врагам поблизости. Ле Блан может повторно применить это умение в течение {{ snapbacktimeallowed }} сек. Повторное применение: Ле Блан возвращается в место, из которого совершила рывок.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:LeeSin_E a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "LeeSin_E" ;
    lol:description "Натиск: Ли Син бьет по земле, создавая ударную волну, которая наносит магический урон и раскрывает вражеских бойцов. Если Натиск поражает противника, Ли Син получает возможность использовать Увечье. Увечье: Ли Син калечит ближайших врагов, пораженных Натиском, замедляя их (эффект постепенно ослабевает)."^^xsd:string ;
    lol:entityId "LeeSin:E"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_LeeSin ;
    lol:name "Натиск / Увечье"^^xsd:string ;
    lol:slot "E"^^xsd:string ;
    lol:tooltipText "Ли Син бьет по земле, создавая ударную волну, которая наносит {{ initialdamage }} магического урона и раскрывает врагов на {{ slowduration }} сек. Если этот эффект поражает врага, Ли Син может повторно применить это умение в течение {{ reactivatetime }} сек. Повторное применение: Ли Син замедляет окружающих врагов, пораженных ударной волной, на {{ slowamount }}% (эффект ослабевает в течение {{ slowduration }} сек.).{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:LeeSin_P a owl:NamedIndividual,
        lol:PassiveAbility ;
    rdfs:label "LeeSin_P" ;
    lol:description "После использования любого умения скорость атаки Ли Сина увеличивается, пока он не проведет две автоатаки. Эти автоатаки восстанавливают ему энергию."^^xsd:string ;
    lol:entityId "LeeSin:P"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_LeeSin ;
    lol:name "Шквал"^^xsd:string ;
    lol:slot "P"^^xsd:string .

lol:LeeSin_Q a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "LeeSin_Q" ;
    lol:description "Звуковая волна: Ли Син создает диссонирующую волну звука, которая позволяет обнаружить противников и наносит физический урон первому врагу, с которым столкнется. Если Звуковая волна поражает врага, Ли Син может использовать Резонирующий удар в течение следующих 3 секунд. Резонирующий удар: Ли Син совершает рывок к врагу, пораженному Звуковой волной, и наносит физический урон, который зависит от недостающего запаса здоровья цели."^^xsd:string ;
    lol:entityId "LeeSin:Q"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_LeeSin ;
    lol:name "Звуковая волна / Резонирующий удар"^^xsd:string ;
    lol:slot "Q"^^xsd:string ;
    lol:tooltipText "Ли Син создает диссонирующую волну звука, которая наносит {{ initialdamage }} ед. физического урона первому врагу на пути. Кроме того, Ли Син получает истинное видение цели и может повторно применить умение в течение {{ reactivatetime }} сек. Повторное применение: Ли Син совершает рывок к врагу, пораженному Звуковой волной, и наносит от {{ recastdamage }} до {{ empowereddamage }} ед. физического урона в зависимости от недостающего здоровья цели. {{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:LeeSin_R a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "LeeSin_R" ;
    lol:description "Ли Син выполняет мощный удар с разворота, отбрасывая вражеского чемпиона назад и нанося при этом физический урон как ему, так и врагам, с которыми он столкнется. Враги, в которых попадает отброшенный чемпион, на короткое время подбрасываются в воздух. Этой технике его обучил Джесси Перринг, хотя Ли Син и не выкидывает игроков за пределы карты."^^xsd:string ;
    lol:entityId "LeeSin:R"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_LeeSin ;
    lol:name "Ярость дракона"^^xsd:string ;
    lol:slot "R"^^xsd:string ;
    lol:tooltipText "Ли Син выполняет мощный удар с разворота, отбрасывая вражеского чемпиона и нанося ему {{ damage }} физического урона . Враги, в которых попадает отброшенный чемпион, ненадолго подбрасываются и получают физический урон в размере {{ damage }} плюс {{ percenthpcarrythrough }}% от дополнительного здоровья отброшенного чемпиона .{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:LeeSin_W a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "LeeSin_W" ;
    lol:description "Защитник: Ли Син бросается к выбранному союзнику, ограждая себя и его (если это чемпион) от урона. После применения Защитника Ли Син может использовать Железную волю. Железная воля: интенсивные тренировки позволяют Ли Сину прекрасно чувствовать себя в бою. У него увеличивается всестороннее вытягивание жизни."^^xsd:string ;
    lol:entityId "LeeSin:W"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_LeeSin ;
    lol:name "Защитник / Железная воля"^^xsd:string ;
    lol:slot "W"^^xsd:string ;
    lol:tooltipText "Ли Син совершает рывок к союзнику или тотему. Если это чемпион, Ли Син накладывает на себя и него щит прочностью {{ shieldamount }} на {{ shieldduration }} сек. Ли Син может повторно применить умение в течение {{ w1reactivatetime }} сек. Повт. применение: Ли Син получает {{ lifestealandspellvamp }}% всестор. вытягивания жизни на {{ lifestealandspellvamptime }} сек.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Leona_E a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Leona_E" ;
    lol:description "Леона выпускает копию своего меча, сотканную из лучей солнца и наносящую магический урон всем врагам на своем пути. Когда эта копия рассеется, последний вражеский чемпион на ее пути будет ненадолго обездвижен, и Леона совершит рывок к нему."^^xsd:string ;
    lol:entityId "Leona:E"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Leona ;
    lol:name "Клинок зенита"^^xsd:string ;
    lol:slot "E"^^xsd:string ;
    lol:tooltipText "Леона вытягивает вперед свой меч из света, нанося {{ totaldamagetooltip }} ед. маг. урона . Последний пораженный чемпион обездвиживается на {{ rootduration }} сек., а Леона совершает к нему рывок.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Leona_P a owl:NamedIndividual,
        lol:PassiveAbility ;
    rdfs:label "Leona_P" ;
    lol:description "Вместе с полученным уроном от заклинаний цель помечается Сиянием солнца на 1,5 секунды. Первая в течение этого времени атака союзного чемпиона снимет этот эффект, но нанесет дополнительный магический урон."^^xsd:string ;
    lol:entityId "Leona:P"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Leona ;
    lol:name "Сияние солнца"^^xsd:string ;
    lol:slot "P"^^xsd:string .

lol:Leona_Q a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Leona_Q" ;
    lol:description "Леона использует свой щит для выполнения следующей автоатаки, нанося дополнительный магический урон и оглушая цель."^^xsd:string ;
    lol:entityId "Leona:Q"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Leona ;
    lol:name "Щит рассвета"^^xsd:string ;
    lol:slot "Q"^^xsd:string ;
    lol:tooltipText "Следующая автоатака Леоны оглушает врага на {{ stunduration }} сек. и дополнительно наносит {{ totaldamagetooltip }} ед. маг. урона.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Leona_R a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Leona_R" ;
    lol:description "Леона призывает луч солнечной энергии, наносящий урон противникам в области действия заклинания. Противники в центре области будут оглушены, а находящиеся по краям - замедлены."^^xsd:string ;
    lol:entityId "Leona:R"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Leona ;
    lol:name "Солнечная вспышка"^^xsd:string ;
    lol:slot "R"^^xsd:string ;
    lol:tooltipText "Леона обрушивает поток солнечной энергии в указанную точку, нанося врагам {{ explosioncalculateddamage }} магического урона и замедляя их на {{ slowpercent }}% на {{ ccduration }} сек. Враги, оказавшиеся в центре области поражения, вместо замедления оглушаются .{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Leona_W a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Leona_W" ;
    lol:description "Леона поднимает щит, чтобы увеличить свою броню и сопротивление магии, а также получить сопротивление урону. Если во время окончания этого эффекта рядом с ней будут противники, то они получат магический урон, а время действия умения будет увеличено, но только один раз."^^xsd:string ;
    lol:entityId "Leona:W"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Leona ;
    lol:name "Затмение"^^xsd:string ;
    lol:slot "W"^^xsd:string ;
    lol:tooltipText "Леона поднимает щит, снижая получаемый урон на {{ flatdamagereduction }} и получая {{ bonusarmortooltip }} брони и {{ bonusmrtooltip }} сопр. магии на {{ armormrduration }} сек. После щит взрывается, нанося {{ totaldamagetooltip }} ед. маг. урона врагам поблизости. Если взрыв поражает хотя бы 1 врага, Леона сохраняет бонус к броне и сопр. магии еще на {{ armormrduration }} сек. {{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Lillia_E a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Lillia_E" ;
    lol:description "Лиллия бросает семя, которое наносит урон первому врагу на пути и замедляет его. Если Лиллия промахивается, семя продолжает катиться, пока не столкнется со стеной или целью."^^xsd:string ;
    lol:entityId "Lillia:E"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Lillia ;
    lol:name "Вихревое семя"^^xsd:string ;
    lol:slot "E"^^xsd:string ;
    lol:tooltipText "Лиллия бросает вперед Вихревое семя, которое наносит {{ impactdamagetotal }} магического урона при столкновении с врагами, а также раскрывает и замедляет их на {{ slowamount*100 }}% на {{ slowduration }} сек. Если Лиллия промахивается Вихревым семенем, оно продолжает катиться, пока не столкнется со врагом или элементом ландшафта.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Lillia_P a owl:NamedIndividual,
        lol:PassiveAbility ;
    rdfs:label "Lillia_P" ;
    lol:description "При попадании умением по чемпиону или монстру Лиллия наносит им дополнительный периодический урон от максимального запаса здоровья."^^xsd:string ;
    lol:entityId "Lillia:P"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Lillia ;
    lol:name "Посох снов"^^xsd:string ;
    lol:slot "P"^^xsd:string .

lol:Lillia_Q a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Lillia_Q" ;
    lol:description "Пассивно: поражая врагов умениями, Лиллия увеличивает свою скорость передвижения (эффект суммируется). Активно: Лиллия наносит магический урон врагам поблизости. Цели на краю области поражения получают дополнительный чистый урон."^^xsd:string ;
    lol:entityId "Lillia:Q"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Lillia ;
    lol:name "Удар природы"^^xsd:string ;
    lol:slot "Q"^^xsd:string ;
    lol:tooltipText "Пассивно: поражая врагов умениями, Лиллия увеличивает скорость передвижения на {{ prancespeed }} на {{ pranceduration }} сек. (эффект суммируется до {{ prancemaxstacks }} раз). Активно: Лиллия совершает круговой удар своим посохом, нанося {{ totaldamage }} магического урона врагам плюс {{ bonustruedamage }} чистого урона тем, кто находится на краю области поражения.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Lillia_R a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Lillia_R" ;
    lol:description "Все враги, на которых действует усыпляющая пыльца, становятся сонливыми, а затем засыпают. При пробуждении от урона эти враги получают дополнительный урон."^^xsd:string ;
    lol:entityId "Lillia:R"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Lillia ;
    lol:name "Чарующая колыбельная"^^xsd:string ;
    lol:slot "R"^^xsd:string ;
    lol:tooltipText "Все вражеские чемпионы, на которых действует усыпляющая пыльца , становятся сонливыми на {{ drowsyduration }} сек. После этого они засыпают на {{ sleepduration }} сек. При пробуждении от урона они дополнительно получают {{ totaldamage }} магического урона .{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Lillia_W a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Lillia_W" ;
    lol:description "Лиллия наносит урон по площади. В центре области поражения урон значительно выше."^^xsd:string ;
    lol:entityId "Lillia:W"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Lillia ;
    lol:name "Ой, осторожно!"^^xsd:string ;
    lol:slot "W"^^xsd:string ;
    lol:tooltipText "Лиллия с размаху бьет изо всех сил своим посохом, нанося {{ flatdamage }} магического урона . Урон врагам в центре увеличивается до {{ flatdamagesweetspot }} .{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Lissandra_E a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Lissandra_E" ;
    lol:description "Лиссандра создает ледяные когти, наносящие урон. Повторная активация умения переносит Лиссандру к месту текущего положения когтей."^^xsd:string ;
    lol:entityId "Lissandra:E"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Lissandra ;
    lol:name "Ледяная тропа"^^xsd:string ;
    lol:slot "E"^^xsd:string ;
    lol:tooltipText "Лиссандра выпускает вперед ледяные когти, которые наносят {{ totaldamage }} магического урона . Лиссандра может повторно применить это умение во время перемещения когтей, чтобы телепортироваться к ним.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Lissandra_P a owl:NamedIndividual,
        lol:PassiveAbility ;
    rdfs:label "Lissandra_P" ;
    lol:description "Когда вражеский чемпион погибает рядом с Лиссандрой, он превращается в ледяного раба. Ледяные рабы уменьшают скорость передвижения ближайших врагов, а после задержки взрываются из-за чрезмерного охлаждения, нанося магический урон целям поблизости."^^xsd:string ;
    lol:entityId "Lissandra:P"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Lissandra ;
    lol:name "Порабощение Хладорожденной"^^xsd:string ;
    lol:slot "P"^^xsd:string .

lol:Lissandra_Q a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Lissandra_Q" ;
    lol:description "Лиссандра бросает ледяное копье, которое при попадании в противника раскалывается, замедляя его и нанося магический урон. Осколки проходят сквозь цель и наносят такой же урон другим пораженным врагам."^^xsd:string ;
    lol:entityId "Lissandra:Q"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Lissandra ;
    lol:name "Ледяной осколок"^^xsd:string ;
    lol:slot "Q"^^xsd:string ;
    lol:tooltipText "Лиссандра бросает ледяное копье. При попадании во врага оно раскалывается, нанося ему и врагам позади него {{ totaldamage }} ед. маг. урона и замедляя их на {{ slowpercentage*-100 }}% на {{ slowduration }} сек.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Lissandra_R a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Lissandra_R" ;
    lol:description "Если целью умения является сама Лиссандра, ее окружает темный лед, восстанавливая ей здоровье. При этом она становится недосягаемой и неуязвимой. Если целью умения является вражеский чемпион, Лиссандра замораживает его, оглушая. Затем темный лед распространяется от цели, нанося магический урон врагам и замедляя их."^^xsd:string ;
    lol:entityId "Lissandra:R"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Lissandra ;
    lol:name "Ледяная гробница"^^xsd:string ;
    lol:slot "R"^^xsd:string ;
    lol:tooltipText "Лиссандра заковывает себя или вражеского чемпиона в лед. Враги оглушаются на {{ enemycastduration }} сек. При применении к себе Лиссандра входит в стазис на {{ selfcastduration }} сек. и восстанавливает себе {{ healamount }} здоровья . Эффективность лечения увеличивается на {{ selfcastmissinghpratio }}% за каждые {{ selfcastmissinghpperabove }}% недостающего здоровья. От цели распространяется темный лед, нанося {{ calculateddamage }} магического урона . Лед существует {{ slowduration }} сек., замедляя врагов на {{ slowamount*-100 }}%.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Lissandra_W a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Lissandra_W" ;
    lol:description "Лиссандра сковывает льдом окружающих врагов, обездвиживая их и нанося им урон."^^xsd:string ;
    lol:entityId "Lissandra:W"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Lissandra ;
    lol:name "Кольцо мороза"^^xsd:string ;
    lol:slot "W"^^xsd:string ;
    lol:tooltipText "Лиссандра создает ледяное поле, обездвиживая врагов поблизости на {{ snareduration }} сек. и нанося им {{ totaldamage }} ед. маг. урона .{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Locke_E a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Locke_E" ;
    lol:description "Локк телепортируется в выбранную точку, а затем совершает рывок к следующей цели, нанося урон врагам на пути."^^xsd:string ;
    lol:entityId "Locke:E"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Locke ;
    lol:name "Путь пепла"^^xsd:string ;
    lol:slot "E"^^xsd:string ;
    lol:tooltipText "Локк телепортируется в выбранную точку, нанося {{ onhitdamage }} ед. маг. урона врагам поблизости. Его следующая атака стремительно перемещает его к цели, позволяя нанести {{ dashdamage }} ед. маг. урона всем врагам на пути. Каждое из этих попаданий расходует гвозди души . Перезарядка сбрасывается при участии в убийстве.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Locke_P a owl:NamedIndividual,
        lol:PassiveAbility ;
    rdfs:label "Locke_P" ;
    lol:description "Автоатаки Локка дополнительно наносят маг. урон при попадании, зависящий от недост. здоровья врага."^^xsd:string ;
    lol:entityId "Locke:P"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Locke ;
    lol:name "Серебряный кол"^^xsd:string ;
    lol:slot "P"^^xsd:string .

lol:Locke_Q a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Locke_Q" ;
    lol:description "Локк подготавливает набор гвоздей души и бросает их, нанося урон пораженным врагам и ставя на них метку. Локк может поглотить метку, нанося доп. урон."^^xsd:string ;
    lol:entityId "Locke:Q"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Locke ;
    lol:name "Ритуальные гвозди"^^xsd:string ;
    lol:slot "Q"^^xsd:string ;
    lol:tooltipText "Локк подготавливает набор гвоздей души и бросает их, нанося {{ missiledamage }} ед. маг. урона и помечая пораженных врагов. Гвозди накладывают замедление ({{ slowamount1*100 }}/{{ slowamount2*100 }}/{{ slowamount3*100 }}%) на {{ slowduration1 }}/{{ slowduration2 }}/{{ slowduration3 }} сек. в зависимости от числа попаданий гвоздями. Атаки по врагу расходуют гвозди души , нанося {{ naildamage }} ед. маг. урона за каждый накопленный заряд. Урон растет на {{ twomarkbonuspercent }}% за 2 и на {{ threemarkbonuspercent }}% – за 3 гвоздя.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Locke_R a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Locke_R" ;
    lol:description "Локк бросает сковывающий артефакт, наносящий урон и способный казнить пораженных врагов. Мощь Локка растет за каждого запечатанного враж. чемпиона."^^xsd:string ;
    lol:entityId "Locke:R"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Locke ;
    lol:name "Чистилище"^^xsd:string ;
    lol:slot "R"^^xsd:string ;
    lol:tooltipText "Локк бросает в выбранную точку сковывающий артефакт, нанося {{ damage }} ед. маг. урона врагам в области и замедляя их на {{ slowamount*100 }}% (эффект ослабевает в течение {{ slowduration }} сек.). Артефакт помечает пораженных врагов на {{ duration }} сек., запечатывая чемпионов с меткой. Если здоровье любого из них падает ниже {{ executetooltipcalc }} , артефакт запечатывает его и сбрасывает длительность эффекта на прочих чемпионах с меткой. Если по завершении действия эффекта артефакт запечатал хотя бы 1 чемпиона, он падает на землю. Локк может подобрать артефакт, повысив порог срабатывания казни его эффекта на {{ executethresholdperstack*100 }}% и снизив его сумм. перезарядку на {{ cooldownreduction }}% за каждого запечатанного чемпиона. {{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Locke_W a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Locke_W" ;
    lol:description "Душа Локка воспламеняется – он получает скорость атаки и передвижения и начинает наносить себе урон. По завершении действия эффекта Локк восстановит здоровье в размере части урона, полученного при действии эффекта."^^xsd:string ;
    lol:entityId "Locke:W"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Locke ;
    lol:name "Пламя души"^^xsd:string ;
    lol:slot "W"^^xsd:string ;
    lol:tooltipText "Душа Локка воспламеняется. Он получает {{ attackspeed }} скорости атаки и {{ movespeed }} скорости передвижения (бонус ослабевает за {{ decaytimehelper }} сек.). В течение {{ baseduration }} сек. он получает чистый урон в размере {{ healthcost*100 }}% от тек. здоровья в секунду, но восстанавливает здоровье в размере {{ damagerestoreamount }} от получ. урона, а также {{ additionalheal }} здоровья в зависимости от недост. здоровья и длительности умения, вплоть до {{ maxhealingthreshold }} от оставшегося здоровья . Повт. применение завершает действие умения.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Lucian_E a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Lucian_E" ;
    lol:description "Люциан быстро бросается вперед на небольшое расстояние. Автоатаки с эффектом Стрелка света сокращают перезарядку Нескончаемой погони."^^xsd:string ;
    lol:entityId "Lucian:E"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Lucian ;
    lol:name "Нескончаемая погоня"^^xsd:string ;
    lol:slot "E"^^xsd:string ;
    lol:tooltipText "Люциан совершает рывок. Перезарядка этого умения сокращается на {{ cdrefundbase }} сек., когда Люциан поражает врага Стрелком света (на {{ cdrefundchampion }} сек., если цель – чемпион). {{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Lucian_P a owl:NamedIndividual,
        lol:PassiveAbility ;
    rdfs:label "Lucian_P" ;
    lol:description "Во время следующей автоатаки после применения умения Люциан совершает двойной выстрел. Когда союзник лечит Люциана или накладывает на него щит, а также когда поблизости обездвиживается вражеский чемпион, следующие 2 автоатаки Люциана наносят дополнительный магический урон."^^xsd:string ;
    lol:entityId "Lucian:P"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Lucian ;
    lol:name "Стрелок света"^^xsd:string ;
    lol:slot "P"^^xsd:string .

lol:Lucian_Q a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Lucian_Q" ;
    lol:description "Люциан выпускает заряд света, пронзающий цель."^^xsd:string ;
    lol:entityId "Lucian:Q"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Lucian ;
    lol:name "Пронзающий свет"^^xsd:string ;
    lol:slot "Q"^^xsd:string ;
    lol:tooltipText "Люциан выпускает пронзающий заряд света, нанося {{ totaldamage }} физического урона . {{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Lucian_R a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Lucian_R" ;
    lol:description "Люциан безостановочно палит из своих пистолетов."^^xsd:string ;
    lol:entityId "Lucian:R"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Lucian ;
    lol:name "Отстрел"^^xsd:string ;
    lol:slot "R"^^xsd:string ;
    lol:tooltipText "Люциан стреляет очередью в выбранном направлении в течение {{ duration }} сек. или до повторного применения умения, выпуская до {{ totalnumshots }} снарядов. Каждый выстрел наносит {{ damageperbullet }} физического урона первому пораженному врагу. Во время стрельбы Люциан может применять Нескончаемую погоню . Общий урон: {{ totaldamage }} физического урона {{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Lucian_W a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Lucian_W" ;
    lol:description "Люциан выпускает снаряд, который взрывается в форме звезды, помечая и ненадолго раскрывая врагов. Если Люциан атакует помеченных врагов, его скорость передвижения увеличивается."^^xsd:string ;
    lol:entityId "Lucian:W"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Lucian ;
    lol:name "Обжигающее пламя"^^xsd:string ;
    lol:slot "W"^^xsd:string ;
    lol:tooltipText "Люциан выпускает снаряд, взрывающийся в конце своего пути или при поражении врага и наносящий {{ totaldamage }} ед. маг. урона . Снаряд ненадолго раскрывает врагов и помечает их на 6 сек. Когда Люциан или его союзник наносят урон врагу с меткой, Люциан получает {{ movespeedamount }} скорости передвижения на 1 сек. Когда союзник активирует этот эффект, Люциан получает Бдительность .{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Lulu_E a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Lulu_E" ;
    lol:description "Если целью умения является союзник, Лулу приказывает Пиксу подскочить к нему и защитить его. После этого Пикс следует за ним и помогает ему атаковать. Если целью умения является враг, Лулу приказывает Пиксу подскочить к нему и нанести ему урон. После этого Пикс следует за ним и дает возможность его видеть."^^xsd:string ;
    lol:entityId "Lulu:E"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Lulu ;
    lol:name "Помоги, Пикс!"^^xsd:string ;
    lol:slot "E"^^xsd:string ;
    lol:tooltipText "При применении к союзнику Пикс бросается к цели и дает ей эффект Пикс, волшебный спутник на {{ pixonallyduration }} сек. Если цель – чемпион, Пикс также накладывает щит прочностью {{ totalshield }} на {{ shieldduration }} сек. При применении к вражескому чемпиону Пикс бросается к цели, нанося ей {{ totaldamage }} ед. маг. урона . Он дает истинное видение цели на {{ pixonenemyduration }} сек.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Lulu_P a owl:NamedIndividual,
        lol:PassiveAbility ;
    rdfs:label "Lulu_P" ;
    lol:description "Пикс выпускает магические заряды при каждой автоатаке чемпиона, за которым он следует. Заряды наводятся на цель, но могут быть блокированы другими бойцами."^^xsd:string ;
    lol:entityId "Lulu:P"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Lulu ;
    lol:name "Пикс, волшебный спутник"^^xsd:string ;
    lol:slot "P"^^xsd:string .

lol:Lulu_Q a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Lulu_Q" ;
    lol:description "Пикс и Лулу выпускают по заряду магической энергии, нанося урон всем пораженным врагам, а также сильно их замедляя."^^xsd:string ;
    lol:entityId "Lulu:Q"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Lulu ;
    lol:name "Сияющая стрела"^^xsd:string ;
    lol:slot "Q"^^xsd:string ;
    lol:tooltipText "Лулу и Пикс выпускают по заряду магической энергии, которые наносят {{ totaldamage }} ед. магического урона и замедляют на {{ slowamount*-100 }}% (эффект ослабевает в течение {{ slowduration }} сек.). Дополнительные заряды наносят врагам {{ bonusmissiledamage }} ед. магического урона .{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Lulu_R a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Lulu_R" ;
    lol:description "Лулу увеличивает союзника в размере, подбрасывая окружающих его врагов в воздух. На несколько секунд он получает большое количество дополнительного здоровья и ауру, которая замедляет врагов поблизости."^^xsd:string ;
    lol:entityId "Lulu:R"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Lulu ;
    lol:name "Буйный рост"^^xsd:string ;
    lol:slot "R"^^xsd:string ;
    lol:tooltipText "Лулу увеличивает союзника, подбрасывая окружающих его врагов на {{ knockbackduration }} сек. При этом максимальный запас здоровья цели увеличивается на {{ totalbonushealth }} и она замедляет окружающих врагов на {{ slowpercent }}% на {{ buffduration }} сек.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Lulu_W a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Lulu_W" ;
    lol:description "Если целью умения является союзник, Лулу увеличивает его скорость атаки и передвижения на короткое время. Если целью умения является враг, Лулу превращает его в очаровательную зверушку, которая не может атаковать или использовать умения."^^xsd:string ;
    lol:entityId "Lulu:W"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Lulu ;
    lol:name "Причуда"^^xsd:string ;
    lol:slot "W"^^xsd:string ;
    lol:tooltipText "При применении к союзнику Лулу повышает скорость передвижения цели на {{ totalms }} и скорость атаки на {{ asbonus*100 }}% на {{ msduration }} сек. При применении к врагу Лулу превращает цель в зверушку на {{ ccduration }} сек.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Lux_E a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Lux_E" ;
    lol:description "Люкс создает в указанной области световую аномалию, замедляющую противников. Люкс может взорвать ее, нанеся урон всем находящимся в зоне поражения врагам."^^xsd:string ;
    lol:entityId "Lux:E"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasEffect lol:Lux_E_Damage_Enemy,
        lol:Lux_E_Slow_Enemy ;
    lol:hasSource lol:Source_Lux ;
    lol:name "Светящаяся сингулярность"^^xsd:string ;
    lol:slot "E"^^xsd:string ;
    lol:tooltipText "Люкс создает световую аномалию, замедляющую на {{ slowpercent }}% и раскрывающую область под собой. Через {{ slowzoneduration }} сек. или при повт. применении этого умения аномалия взрывается, нанося {{ totaldamagett }} ед. маг. урона и замедляя еще на {{ slowlingerduration }} сек.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Lux_E_Damage_Enemy a owl:NamedIndividual,
        lol:AbilityEffect ;
    rdfs:label "Lux_E_Damage_Enemy" ;
    lol:conditionText "Враг находится в зоне поражения при взрыве; взрыв по таймеру или повторному применению."^^xsd:string ;
    lol:evidenceField "tooltip_text"^^xsd:string ;
    lol:evidenceText "Люкс создает световую аномалию, замедляющую на {{ slowpercent }}% и раскрывающую область под собой. Через {{ slowzoneduration }} сек. или при повт. применении этого умения аномалия взрывается, нанося {{ totaldamagett }} ед. маг. урона и замедляя еще на {{ slowlingerduration }} сек.{{ spellmodifierdescriptionappend }}"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasMechanic lol:Damage ;
    lol:hasSource lol:Source_Lux ;
    lol:hasTargetType lol:Enemy ;
    lol:reviewStatus "reviewed_by_assistant"^^xsd:string .

lol:Lux_E_Slow_Enemy a owl:NamedIndividual,
        lol:AbilityEffect ;
    rdfs:label "Lux_E_Slow_Enemy" ;
    lol:conditionText "Противник находится в области аномалии; tooltip также описывает краткое замедление после взрыва."^^xsd:string ;
    lol:evidenceField "tooltip_text"^^xsd:string ;
    lol:evidenceText "Люкс создает световую аномалию, замедляющую на {{ slowpercent }}% и раскрывающую область под собой. Через {{ slowzoneduration }} сек. или при повт. применении этого умения аномалия взрывается, нанося {{ totaldamagett }} ед. маг. урона и замедляя еще на {{ slowlingerduration }} сек.{{ spellmodifierdescriptionappend }}"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasMechanic lol:Slow ;
    lol:hasSource lol:Source_Lux ;
    lol:hasTargetType lol:Enemy ;
    lol:reviewStatus "reviewed_by_assistant"^^xsd:string .

lol:Lux_P a owl:NamedIndividual,
        lol:PassiveAbility ;
    rdfs:label "Lux_P" ;
    lol:description "Используя атакующие умения, Люкс накладывает на врагов эффект Иллюминации на несколько секунд. Ее последующие автоатаки поджигают находящихся под действием эффекта врагов, нанося им дополнительный магический урон (тем больший, чем выше уровень Люкс), но снимают эффект."^^xsd:string ;
    lol:entityId "Lux:P"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasEffect lol:Lux_P_Damage_Enemy ;
    lol:hasSource lol:Source_Lux ;
    lol:name "Иллюминация"^^xsd:string ;
    lol:slot "P"^^xsd:string .

lol:Lux_P_Damage_Enemy a owl:NamedIndividual,
        lol:AbilityEffect ;
    rdfs:label "Lux_P_Damage_Enemy" ;
    lol:conditionText "Враг отмечен Иллюминацией от атакующего умения; последующая автоатака расходует метку и наносит дополнительный урон."^^xsd:string ;
    lol:evidenceField "description_text"^^xsd:string ;
    lol:evidenceText "Используя атакующие умения, Люкс накладывает на врагов эффект Иллюминации на несколько секунд. Ее последующие автоатаки поджигают находящихся под действием эффекта врагов, нанося им дополнительный магический урон (тем больший, чем выше уровень Люкс), но снимают эффект."^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasMechanic lol:Damage ;
    lol:hasSource lol:Source_Lux ;
    lol:hasTargetType lol:Enemy ;
    lol:reviewStatus "reviewed_by_assistant"^^xsd:string .

lol:Lux_Q a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Lux_Q" ;
    lol:description "Люкс выпускает сферу света, которая наносит урон и обездвиживает до двух врагов."^^xsd:string ;
    lol:entityId "Lux:Q"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasEffect lol:Lux_Q_Damage_Enemy,
        lol:Lux_Q_Root_Enemy ;
    lol:hasSource lol:Source_Lux ;
    lol:name "Сковывание света"^^xsd:string ;
    lol:slot "Q"^^xsd:string ;
    lol:tooltipText "Люкс выпускает сферу света, обездвиживающую первых 2 врагов на пути на {{ rootduration }} сек. и наносящую им по {{ totaldamagett }} ед. маг. урона .{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Lux_Q_Damage_Enemy a owl:NamedIndividual,
        lol:AbilityEffect ;
    rdfs:label "Lux_Q_Damage_Enemy" ;
    lol:conditionText "Сфера должна попасть в цель; поражает первых двух врагов на пути."^^xsd:string ;
    lol:evidenceField "tooltip_text"^^xsd:string ;
    lol:evidenceText "Люкс выпускает сферу света, обездвиживающую первых 2 врагов на пути на {{ rootduration }} сек. и наносящую им по {{ totaldamagett }} ед. маг. урона .{{ spellmodifierdescriptionappend }}"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasMechanic lol:Damage ;
    lol:hasSource lol:Source_Lux ;
    lol:hasTargetType lol:Enemy ;
    lol:reviewStatus "reviewed_by_assistant"^^xsd:string .

lol:Lux_Q_Root_Enemy a owl:NamedIndividual,
        lol:AbilityEffect ;
    rdfs:label "Lux_Q_Root_Enemy" ;
    lol:conditionText "Сфера должна попасть в цель; обездвиживаются первые два врага на пути."^^xsd:string ;
    lol:evidenceField "tooltip_text"^^xsd:string ;
    lol:evidenceText "Люкс выпускает сферу света, обездвиживающую первых 2 врагов на пути на {{ rootduration }} сек. и наносящую им по {{ totaldamagett }} ед. маг. урона .{{ spellmodifierdescriptionappend }}"^^xsd:string ;
