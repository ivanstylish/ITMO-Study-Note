dcterms:description a owl:AnnotationProperty .

dcterms:title a owl:AnnotationProperty .

<https://example.org/lol-ontology> a owl:Ontology ;
    rdfs:label "League of Legends: champions, abilities and effects"@en ;
    dcterms:description "An OWL 2 DL ontology of champions, abilities and qualified effects. The demo contains Lux, Morgana and Karma. Effect conditions and source evidence are preserved. Data Dragon 16.20.1, ru_RU. Effect annotations reviewed by an assistant."@en ;
    dcterms:title "League of Legends: champions, abilities and effects"@en ;
    rdfs:comment "Учебная онтология. Качественная разметка эффектов проверена ассистентом только для Lux, Morgana, Karma. Условия сохранены текстом; вывод означает наличие способности при указанных условиях, а не результат любого применения. Отсутствие разметки не означает отсутствие механики. Числа из шаблонов tooltip не угадываются."@ru ;
    owl:versionInfo "1.0 / Data Dragon 16.20.1 / ru_RU" .

