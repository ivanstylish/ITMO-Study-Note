    lol:hasSource lol:Source_Karma ;
    lol:name "Внутреннее пламя"^^xsd:string ;
    lol:slot "Q"^^xsd:string ;
    lol:tooltipText "Карма выпускает сгусток энергии, нанося {{ totaldamage }} магического урона первой пораженной цели и окружающим врагам, а также замедляя их на {{ slowamount*-100 }}% на {{ slowduration }} сек.{{ spellmodifierdescriptionappend }}"^^xsd:string .

