    lol:hasMechanic lol:Root ;
    lol:hasSource lol:Source_Lux ;
    lol:hasTargetType lol:Enemy ;
    lol:reviewStatus "reviewed_by_assistant"^^xsd:string .

lol:Lux_R a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Lux_R" ;
    lol:description "Люкс накапливает энергию и выпускает мощный луч света, наносящий урон всем врагам на своем пути. Кроме того, луч поджигает врагов, на которых наложен эффект Иллюминации, после чего этот эффект обновляется."^^xsd:string ;
    lol:entityId "Lux:R"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasEffect lol:Lux_R_Damage_Enemy ;
    lol:hasSource lol:Source_Lux ;
    lol:name "Последняя искра"^^xsd:string ;
    lol:slot "R"^^xsd:string ;
    lol:tooltipText "Люкс выпускает мощный луч света, который наносит {{ totaldamage }} магического урона всем врагам на своем пути.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Lux_R_Damage_Enemy a owl:NamedIndividual,
        lol:AbilityEffect ;
    rdfs:label "Lux_R_Damage_Enemy" ;
    lol:conditionText "Враг находится на пути луча; дополнительные взаимодействия с Иллюминацией описаны в исходном тексте."^^xsd:string ;
    lol:evidenceField "description_text"^^xsd:string ;
    lol:evidenceText "Люкс накапливает энергию и выпускает мощный луч света, наносящий урон всем врагам на своем пути. Кроме того, луч поджигает врагов, на которых наложен эффект Иллюминации, после чего этот эффект обновляется."^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasMechanic lol:Damage ;
    lol:hasSource lol:Source_Lux ;
    lol:hasTargetType lol:Enemy ;
    lol:reviewStatus "reviewed_by_assistant"^^xsd:string .

lol:Lux_W a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Lux_W" ;
    lol:description "Люкс бросает свой жезл, который, касаясь союзных чемпионов, искривляет вокруг них лучи света, защищая от входящего урона."^^xsd:string ;
    lol:entityId "Lux:W"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasEffect lol:Lux_W_Shield_Ally ;
    lol:hasSource lol:Source_Lux ;
    lol:name "Призматический барьер"^^xsd:string ;
    lol:slot "W"^^xsd:string ;
    lol:tooltipText "Люкс бросает свой жезл, на {{ shieldduration }} сек. накладывая щит прочностью {{ totalshieldtt }} на союзников, которых он касается. Затем жезл возвращается, повторно накладывая щит на пути назад.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Lux_W_Shield_Ally a owl:NamedIndividual,
        lol:AbilityEffect ;
    rdfs:label "Lux_W_Shield_Ally" ;
    lol:conditionText "Жезл должен коснуться союзника на пути вперед или обратно."^^xsd:string ;
    lol:evidenceField "tooltip_text"^^xsd:string ;
    lol:evidenceText "Люкс бросает свой жезл, на {{ shieldduration }} сек. накладывая щит прочностью {{ totalshieldtt }} на союзников, которых он касается. Затем жезл возвращается, повторно накладывая щит на пути назад.{{ spellmodifierdescriptionappend }}"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasMechanic lol:Shield ;
    lol:hasSource lol:Source_Lux ;
    lol:hasTargetType lol:Ally ;
    lol:reviewStatus "reviewed_by_assistant"^^xsd:string .

lol:MageChampion a owl:Class ;
    rdfs:label "MageChampion" ;
    rdfs:comment "Чемпион с категорией Mage; классифицируется ризонером."@ru ;
    rdfs:subClassOf lol:Champion ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( lol:Champion [ a owl:Restriction ;
                        owl:hasValue lol:Category_Mage ;
                        owl:onProperty lol:hasCategory ] ) ] .

lol:Malphite_E a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Malphite_E" ;
    lol:description "Мальфит бьет по земле, создавая ударную волну, которая наносит магический урон, зависящий от его брони, и уменьшает скорость атаки врагов на короткое время."^^xsd:string ;
    lol:entityId "Malphite:E"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Malphite ;
    lol:name "Удар по земле"^^xsd:string ;
    lol:slot "E"^^xsd:string ;
    lol:tooltipText "Мальфит бьет по земле, нанося врагам {{ edamagecalc }} магического урона и уменьшая их скорость атаки на {{ asreduction }}% на {{ duration }} сек.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Malphite_P a owl:NamedIndividual,
        lol:PassiveAbility ;
    rdfs:label "Malphite_P" ;
    lol:description "Мальфит защищен каменным щитом, поглощающим урон, равный 10% от его максимального запаса здоровья. Если в течение нескольких секунд Мальфит не получает урона, щит возникает вновь."^^xsd:string ;
    lol:entityId "Malphite:P"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Malphite ;
    lol:name "Гранитный щит"^^xsd:string ;
    lol:slot "P"^^xsd:string .

lol:Malphite_Q a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Malphite_Q" ;
    lol:description "Мальфит выпускает во врага осколок скалы, нанося ему урон и похищая у него часть скорости передвижения на 3 сек."^^xsd:string ;
    lol:entityId "Malphite:Q"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Malphite ;
    lol:name "Сейсмический осколок"^^xsd:string ;
    lol:slot "Q"^^xsd:string ;
    lol:tooltipText "Мальфит выпускает во врага осколок скалы, нанося ему {{ qdamagecalc }} ед. маг. урона и замедляя его на {{ speedsteal }}% на {{ slowduration }} сек. Также Мальфит на {{ slowduration }} сек. повышает свою скорость передвижения на величину замедления врага.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Malphite_R a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Malphite_R" ;
    lol:description "Мальфит с высокой скоростью бросается в указанную область, нанося урон врагам и подбрасывая их в воздух."^^xsd:string ;
    lol:entityId "Malphite:R"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Malphite ;
    lol:name "Безудержная сила"^^xsd:string ;
    lol:slot "R"^^xsd:string ;
    lol:tooltipText "Мальфит совершает рывок с мощью оползня, становясь неудержимым. По окончании рывка Мальфит подбрасывает врагов на {{ knockupduration }} сек. и наносит им {{ totaldamage }} магического урона .{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Malphite_W a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Malphite_W" ;
    lol:description "Мальфит атакует с такой силой, что возникает звуковой удар. В течение нескольких следующих секунд в зоне перед собой Мальфит создает ударные волны."^^xsd:string ;
    lol:entityId "Malphite:W"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Malphite ;
    lol:name "Удар грома"^^xsd:string ;
    lol:slot "W"^^xsd:string ;
    lol:tooltipText "Пассивно: Мальфит получает {{ bonusarmorpassive*100 }}% брони (%i:scaleArmor%{{ f1 }}) . Сила эффекта растет до {{ bonusarmorpassive*300 }}% (%i:scaleArmor%{{ f2 }}) при активном Гранитном щите . Активно: следующая автоатака Мальфита дополнительно наносит {{ totalbonusdamage }} ед. физ. урона и создает ударную волну, наносящую {{ thunderclapsplash }} ед. физ. урона %i:OnHit% при попадании . Автоатаки Мальфита продолжают создавать ударные волны %i:OnHit% при попадании еще {{ thunderclapbuffduration }} сек.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Malzahar_E a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Malzahar_E" ;
    lol:description "Мальзахар наполняет разум врага ужасными видениями его гибели, нанося урон в течение нескольких секунд. Использование других умений на этой цели обновляет продолжительность действия видений. Если цель умирает, пока страдает от видений, они переходят на ближайшего врага, а Мальзахар восстанавливает себе некоторое количество маны. Враги, находящиеся под действием этого умения, притягивают войдлингов."^^xsd:string ;
    lol:entityId "Malzahar:E"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Malzahar ;
    lol:name "Пагубные видения"^^xsd:string ;
    lol:slot "E"^^xsd:string ;
    lol:tooltipText "Мальзахар вызывает у цели ужасные видения, нанося {{ totaldamage }} магического урона в течение {{ duration }} сек. Применение Зова Бездны или Потусторонней хватки к цели обновляет продолжительность видений. Если цель умирает, видения перекидываются на ближайшего врага, а Мальзахар восстанавливает себе {{ manarestore }} маны . Пагубные видения добивают миньонов, у которых осталось менее {{ minionexecutethreshold }} здоровья. {{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Malzahar_P a owl:NamedIndividual,
        lol:PassiveAbility ;
    rdfs:label "Malzahar_P" ;
    lol:description "Если Мальзахар не получает урон или на него не накладывают эффект контроля в течение какого-то времени, он начинает получать значительно меньше урона, а также становится невосприимчивым к эффектам контроля. После получения урона Сдвиг Бездны продолжает действовать еще некоторое время."^^xsd:string ;
    lol:entityId "Malzahar:P"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Malzahar ;
    lol:name "Сдвиг Бездны"^^xsd:string ;
    lol:slot "P"^^xsd:string .

lol:Malzahar_Q a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Malzahar_Q" ;
    lol:description "Мальзахар открывает два портала в Бездну. После небольшой задержки они выпускают друг в друга заряды энергии, которые наносят магический урон и заставляют замолчать вражеских чемпионов."^^xsd:string ;
    lol:entityId "Malzahar:Q"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Malzahar ;
    lol:name "Зов Бездны"^^xsd:string ;
    lol:slot "Q"^^xsd:string ;
    lol:tooltipText "Мальзахар открывает 2 портала в Бездну, которые выпускают друг в друга заряды энергии, нанося {{ totaldamagetooltip }} ед. магического урона и накладывая безмолвие на {{ silenceduration }} сек.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Malzahar_R a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Malzahar_R" ;
    lol:description "Мальзахар потоком эссенции Бездны парализует выбранного вражеского чемпиона над областью отрицательной энергии, которая постоянно наносит урон."^^xsd:string ;
    lol:entityId "Malzahar:R"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Malzahar ;
    lol:name "Потусторонняя хватка"^^xsd:string ;
    lol:slot "R"^^xsd:string ;
    lol:tooltipText "Мальзахар подавляет вражеского чемпиона и наносит ему {{ totaldamagetooltip }} ед. магического урона за {{ ccduration }} сек. Вокруг врага появляется область отрицательной энергии, наносящая магический урон в размере {{ zonedamagetooltip }} от макс. запаса здоровья за {{ poolduration }} сек.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Malzahar_W a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Malzahar_W" ;
    lol:description "Мальзахар призывает войдлингов для атаки ближайших врагов."^^xsd:string ;
    lol:entityId "Malzahar:W"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Malzahar ;
    lol:name "Рой Бездны"^^xsd:string ;
    lol:slot "W"^^xsd:string ;
    lol:tooltipText "Пассивно: при применении других умений Мальзахар получает заряды (не более {{ stackcap }} суммарно). Активно: Мальзахар призывает войдлинга плюс еще по одному войдлингу за заряд. Войдлинги существуют в течение {{ voidlingduration }} сек. и с каждым попаданием наносят {{ voidlingbonusdamagetooltip }} магического урона .{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Maokai_E a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Maokai_E" ;
    lol:description "Маокай запускает саженец в выбранную область для ведения дозора. Саженцы более эффективны в кустах."^^xsd:string ;
    lol:entityId "Maokai:E"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Maokai ;
    lol:name "Бросок саженца"^^xsd:string ;
    lol:slot "E"^^xsd:string ;
    lol:tooltipText "Маокай бросает саженец, который следит за окружающей обстановкой в течение {{ saplingduration }} сек. При приближении врага саженец преследует его, а затем взрывается, нанося {{ totaldamage }} магического урона и замедляя окружающих противников на {{ slowamount*100 }}% на {{ slowduration }} сек. Если саженец поражает вражеского чемпиона или эпического монстра, перезарядка Вытягивания магии дополнительно сокращается на 4 сек. Саженцы, брошенные в кусты, живут {{ empoweredsaplingduration }} сек. и взрываются сильнее, нанося врагам {{ totalempowereddamage }} магического урона в течение {{ empowereddotduration }} сек., а также замедляя их на {{ empoweredslowamount }}.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Maokai_P a owl:NamedIndividual,
        lol:PassiveAbility ;
    rdfs:label "Maokai_P" ;
    lol:description "Периодически автоатаки Маокая восстанавливают ему здоровье, а также наносят целям дополнительный урон. Каждый раз, когда Маокай использует умение или враги применяют умение к нему, перезарядка эффекта сокращается."^^xsd:string ;
    lol:entityId "Maokai:P"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Maokai ;
    lol:name "Вытягивание магии"^^xsd:string ;
    lol:slot "P"^^xsd:string .

lol:Maokai_Q a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Maokai_Q" ;
    lol:description "Маокай запускает магическую ударную волну, разбрасывая ближайших врагов, а также нанося им и всем врагам по ходу волны магический урон и замедляя их."^^xsd:string ;
    lol:entityId "Maokai:Q"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Maokai ;
    lol:name "Терновый удар"^^xsd:string ;
    lol:slot "Q"^^xsd:string ;
    lol:tooltipText "Маокай бьет кулаком по земле, нанося врагам магический урон в размере {{ totaldamage }} плюс {{ basepercenthealth*100 }}% от максимального запаса здоровья и ненадолго их замедляя . Противники поблизости также отбрасываются .{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Maokai_R a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Maokai_R" ;
    lol:description "Маокай призывает огромную стену из корней и шипов, которая медленно движется вперед, обездвиживая всех врагов на пути и нанося им урон."^^xsd:string ;
    lol:entityId "Maokai:R"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Maokai ;
    lol:name "Объятья природы"^^xsd:string ;
    lol:slot "R"^^xsd:string ;
    lol:tooltipText "Маокай призывает огромную волну из корней и шипов, которая обездвиживает врагов на {{ minrootduration }}-{{ maxrootduration }} сек. (продолжительность зависит от преодоленного расстояния) и наносит им {{ totaldamage }} магического урона . Если шипы поражают чемпиона, скорость передвижения Маокая увеличивается на {{ movehaste*100 }}% . Ускорение ослабевает в течение {{ hasteduration }} сек. {{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Maokai_W a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Maokai_W" ;
    lol:description "Маокай превращается в клубок двигающихся корней, становится недосягаемым и совершает рывок к цели, обездвиживая ее по прибытии."^^xsd:string ;
    lol:entityId "Maokai:W"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Maokai ;
    lol:name "Неестественное наступление"^^xsd:string ;
    lol:slot "W"^^xsd:string ;
    lol:tooltipText "Маокай превращается в клубок двигающихся корней, становится недосягаемым и совершает рывок к врагу. По прибытии он обездвиживает цель на {{ rootduration }} сек. и наносит ей {{ totaldamage }} ед. маг. урона . {{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:MasterYi_E a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "MasterYi_E" ;
    lol:description "Автоатаки дополнительно наносят чистый урон."^^xsd:string ;
    lol:entityId "MasterYi:E"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_MasterYi ;
    lol:name "Стиль вуджу"^^xsd:string ;
    lol:slot "E"^^xsd:string ;
    lol:tooltipText "Автоатаки Мастера Йи дополнительно наносят {{ totaldamage }} чистого урона в течение {{ duration }} сек.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:MasterYi_P a owl:NamedIndividual,
        lol:PassiveAbility ;
    rdfs:label "MasterYi_P" ;
    lol:description "Мастер Йи бьет дважды через каждые несколько автоатак."^^xsd:string ;
    lol:entityId "MasterYi:P"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_MasterYi ;
    lol:name "Двойной удар"^^xsd:string ;
    lol:slot "P"^^xsd:string .

lol:MasterYi_Q a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "MasterYi_Q" ;
    lol:description "Мастер Йи становится недосягаемым и беспорядочно телепортируется по полю боя, нанося физический урон многочисленным врагам, стоящим на его пути. Первый удар может нанести критический урон и наносит дополнительный физический урон монстрам. Автоатаки сокращают время перезарядки умения."^^xsd:string ;
    lol:entityId "MasterYi:Q"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_MasterYi ;
    lol:name "Первый удар"^^xsd:string ;
    lol:slot "Q"^^xsd:string ;
    lol:tooltipText "Мастер Йи становится недосягаемым и телепортируется по полю боя, быстро поражая врагов около цели. После {{ alphastrikebounces }} ударов он наносит всем задетым противникам {{ totaldamage }} физического урона . Это умение может поражать одного и того же врага несколько раз, если рядом нет других целей. При этом каждое попадание после первого наносит {{ subsequenthitmultiplier*100 }}% урона ({{ subesquentdamage }} ). Максимальный общий урон одной цели: {{ singletotaldamage }} .{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:MasterYi_R a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "MasterYi_R" ;
    lol:description "Любое убийство вражеского чемпиона или содействие сокращает перезарядку остальных умений Мастера Йи. При активации умения Мастер Йи приобретает невероятную быстроту движений, временно увеличивая свою скорость передвижения и скорость атаки. При этом он становится невосприимчивым к любым замедляющим эффектам. Убийство вражеского чемпиона или содействие продлевает действие умения."^^xsd:string ;
    lol:entityId "MasterYi:R"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_MasterYi ;
    lol:name "Горец"^^xsd:string ;
    lol:slot "R"^^xsd:string ;
    lol:tooltipText "Пассивно: когда Мастер Йи участвует в убийстве чемпиона, оставшаяся перезарядка его базовых умений сокращается на {{ rcooldownrefund*100 }}%. Активно: Мастер Йи впадает в транс, увеличивая скорость передвижения на {{ rmsbonus }}% и скорость атаки на {{ rasbonus }}% , а также получая иммунитет к замедлению на {{ rduration }} сек. Пока активно, убийства или содействия увеличивают продолжительность действия этого умения на {{ rkillassistextension }} сек.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:MasterYi_W a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "MasterYi_W" ;
    lol:description "Мастер Йи обновляет свое тело силой разума, восстанавливая здоровье и получая уменьшенный входящий урон в течение короткого времени. Кроме того, Мастер Йи получает заряды Двойного удара и приостанавливает действие Стиля вуджу и Горца на каждую секунду действия умения."^^xsd:string ;
    lol:entityId "MasterYi:W"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_MasterYi ;
    lol:name "Медитация"^^xsd:string ;
    lol:slot "W"^^xsd:string ;
    lol:tooltipText "Мастер Йи начинает медитировать, восстанавливая {{ totalheal }} здоровья в течение {{ healduration }} сек. Эффективность лечения может увеличиваться на величину вплоть до {{ maxmissinghealthpercent*100 }}% в зависимости от недостающего здоровья Мастера Йи. Во время медитации и в течение {{ drlinger }} сек. после нее Мастер Йи получает на {{ initialdr }} меньше урона. Это значение уменьшается до {{ damagereduction*100 }}% после первых {{ initialextradrduration }} сек.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Mel_E a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Mel_E" ;
    lol:description "Мэл выпускает сферу света, наносящую периодический урон. Враги в центре сферы обездвиживаются, а по краям – замедляются."^^xsd:string ;
    lol:entityId "Mel:E"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Mel ;
    lol:name "Солнечная ловушка"^^xsd:string ;
    lol:slot "E"^^xsd:string ;
    lol:tooltipText "Мэл выпускает сферу света, которая обездвиживает врагов в центре на {{ rootduration }} сек. и наносит им {{ damage }} магического урона . Враги, попавшие в область вокруг сферы, замедляются на {{ areaslowamount*100 }}% и получают {{ areadamagepersecond }} магического урона в секунду .{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Mel_P a owl:NamedIndividual,
        lol:PassiveAbility ;
    rdfs:label "Mel_P" ;
    lol:description "При следующей автоатаке после применения умения Мэл дополнительно выпускает 3 снаряда (максимум – 9). Нанося урон автоатаками и умениями, Мэл накладывает на цель заряды ошеломления (суммируются бесконечно). Поразив врага с достаточным количеством зарядов, она мгновенно добивает его."^^xsd:string ;
    lol:entityId "Mel:P"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Mel ;
    lol:name "Обжигающий свет"^^xsd:string ;
    lol:slot "P"^^xsd:string .

lol:Mel_Q a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Mel_Q" ;
    lol:description "Мэл выпускает несколько снарядов, которые взрываются в выбранном месте, нанося урон врагам в области поражения."^^xsd:string ;
    lol:entityId "Mel:Q"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Mel ;
    lol:name "Лучезарный залп"^^xsd:string ;
    lol:slot "Q"^^xsd:string ;
    lol:tooltipText "Мэл выпускает залп из {{ explosioncount }} снарядов, которые взрываются в выбранном месте. Первый взрыв наносит {{ initialexplosiondamage }} ед. магического урона , а каждый последующий взрыв наносит {{ totalexplosiondamage }} ед. магического урона (до {{ alldamagehit }} ед. магического урона суммарно).{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Mel_R a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Mel_R" ;
    lol:description "Мэл поражает всех врагов, на которых наложено ошеломление, где бы они ни находились, нанося дополнительный урон за каждый заряд. Урон от ошеломления увеличивается с каждым уровнем Золотого затмения."^^xsd:string ;
    lol:entityId "Mel:R"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Mel ;
    lol:name "Золотое затмение"^^xsd:string ;
    lol:slot "R"^^xsd:string ;
    lol:tooltipText "Пассивно : магический урон от ошеломления увеличивается до {{ passiveflatdamage }} плюс {{ passivestackdamage }} за заряд . Активно : Мэл поражает всех врагов, на которых наложено ошеломление , нанося им {{ ultflatdamage }} магического урона плюс еще {{ ultstackdamage }} магического урона за заряд ошеломления . Умение можно применить, только когда ошеломление наложено хотя бы на одного вражеского чемпиона. {{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Mel_W a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Mel_W" ;
    lol:description "Мэл создает вокруг себя барьер, который отражает вражеские снаряды обратно в атакующих и предотвращает получение урона. Кроме того, у Мэл увеличивается скорость передвижения."^^xsd:string ;
    lol:entityId "Mel:W"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Mel ;
    lol:name "Зеркальный щит"^^xsd:string ;
    lol:slot "W"^^xsd:string ;
    lol:tooltipText "Мэл создает вокруг себя барьер, который отражает снаряды, выпускаемые вражескими чемпионами, обратно в атакующих. Кроме того, Мэл получает щит прочностью {{ shieldamount }} на {{ duration }} сек., а ее скорость передвижения увеличивается на {{ movespeed*100 }}% на {{ movespeedduration }} сек. (ускорение постепенно ослабевает). Отраженные снаряды наносят магический урон в размере {{ damagepercent }} от изначального .{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Milio_E a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Milio_E" ;
    lol:description "Милио накладывает щит на союзника, временно повышая его скорость передвижения. У этого умения может быть до 2 зарядов."^^xsd:string ;
    lol:entityId "Milio:E"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Milio ;
    lol:name "Теплые объятия"^^xsd:string ;
    lol:slot "E"^^xsd:string ;
    lol:tooltipText "Милио окружает союзного чемпиона защитным пламенем, накладывая на него щит прочностью {{ shieldcalc }} и увеличивая его скорость передвижения на {{ movespeedamount*100 }}% на {{ movespeedduration }} сек. У этого умения может быть до 2 зарядов. Эффект суммируется.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Milio_P a owl:NamedIndividual,
        lol:PassiveAbility ;
    rdfs:label "Milio_P" ;
    lol:description "Умения Милио усиливают союзников при касании. Усиленный союзник наносит дополнительный урон и поджигает цель."^^xsd:string ;
    lol:entityId "Milio:P"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Milio ;
    lol:name "Запал"^^xsd:string ;
    lol:slot "P"^^xsd:string .

lol:Milio_Q a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Milio_Q" ;
    lol:description "Милио пинает огненный мяч. При попадании мяч отбрасывает врага, подлетает вверх, а затем падает обратно, замедляя всех противников в области поражения и нанося им урон."^^xsd:string ;
    lol:entityId "Milio:Q"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Milio ;
    lol:name "Огненный мяч"^^xsd:string ;
    lol:slot "Q"^^xsd:string ;
    lol:tooltipText "Милио пинает огненный мяч, который отбрасывает первого пораженного врага. Если мяч попадает в цель, он отскакивает дальше и взрывается, нанося {{ damage }} магического урона окружающим врагам и замедляя их на {{ slowamountpercent }} на {{ slowduration }} сек. Если Огненный мяч поражает хотя бы одного вражеского чемпиона, Милио восстанавливает {{ refundratio*100 }}% от затраченной маны.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Milio_R a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Milio_R" ;
    lol:description "Милио выпускает волну целительного пламени, которое лечит союзников и снимает с них эффекты контроля."^^xsd:string ;
    lol:entityId "Milio:R"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Milio ;
    lol:name "Дыхание жизни"^^xsd:string ;
    lol:slot "R"^^xsd:string ;
    lol:tooltipText "Милио выпускает волну целительного пламени, которая снимает с ближайших союзных чемпионов нейтрализующие и обездвиживающие эффекты, а также восстанавливает им {{ healcalc }} здоровья и дает {{ tenacityamount*100 }}% стойкости на {{ tenacityduration }} сек.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Milio_W a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Milio_W" ;
    lol:description "Милио создает область усиления, которая лечит союзников и увеличивает дальность атаки бойцов, находящихся внутри. Область следует за союзником, который находится ближе всего к точке применения умения."^^xsd:string ;
    lol:entityId "Milio:W"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Milio ;
    lol:name "Посиделки у костра"^^xsd:string ;
    lol:slot "W"^^xsd:string ;
    lol:tooltipText "Милио создает очаг, который следует за союзными чемпионами {{ zoneduration }} сек. Дальность атаки союзных чемпионов поблизости увеличивается на {{ rangepercent }}, и они восстанавливают {{ healingovertime }} здоровья во время действия умения. Очаг также применяет Запал раз в {{ healfrequencyseconds }} сек. Повторное применение: Милио меняет союзника, за которым следует очаг.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:MissFortune_E a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "MissFortune_E" ;
    lol:description "Мисс Фортуна обрушивает град пуль на выбранную область, раскрывая ее. Все находящиеся там противники в течение нескольких секунд получают урон и замедляются."^^xsd:string ;
    lol:entityId "MissFortune:E"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_MissFortune ;
    lol:name "Свинцовый дождь"^^xsd:string ;
    lol:slot "E"^^xsd:string ;
    lol:tooltipText "Мисс Фортуна обрушивает град пуль на выбранную область, раскрывая ее. Враги внутри замедляются на {{ totalslowamount }} и получают {{ totaldamagepersecond }} магического урона в секунду в течение {{ baseduration }} сек. (всего: {{ totaldamage }} магического урона ).{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:MissFortune_P a owl:NamedIndividual,
        lol:PassiveAbility ;
    rdfs:label "MissFortune_P" ;
    lol:description "Автоатаки Мисс Фортуны наносят дополнительный физический урон каждый раз, когда она меняет цель."^^xsd:string ;
    lol:entityId "MissFortune:P"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_MissFortune ;
    lol:name "Приветственный выстрел"^^xsd:string ;
    lol:slot "P"^^xsd:string .

lol:MissFortune_Q a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "MissFortune_Q" ;
    lol:description "Мисс Фортуна стреляет в противника, нанося урон и ему, и цели за ним. Оба выстрела могут наложить эффект Приветственного выстрела."^^xsd:string ;
    lol:entityId "MissFortune:Q"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_MissFortune ;
    lol:name "Два по цене одного"^^xsd:string ;
    lol:slot "Q"^^xsd:string ;
    lol:tooltipText "Мисс Фортуна стреляет отскакивающей пулей, нанося {{ totaldamagetooltip }} ед. физического урона цели и врагу за ней. Второе попадание может стать критическим, нанеся {{ totaldamagecrit }} ед. физического урона , и всегда становится критическим, если первое попадание убивает цель.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:MissFortune_R a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "MissFortune_R" ;
    lol:description "Мисс Фортуна выпускает шквал пуль веером перед собой, нанося гигантский урон врагам. Каждая волна может наносить критический урон."^^xsd:string ;
    lol:entityId "MissFortune:R"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_MissFortune ;
    lol:name "Время умирать"^^xsd:string ;
    lol:slot "R"^^xsd:string ;
    lol:tooltipText "Мисс Фортуна выпускает шквал пуль из {{ basewaves }} залпов в течение {{ basechannelduration }} сек., нанося {{ physicaldamageperwave }} ед. физического урона каждым залпом (всего умение наносит {{ totalphysicaldamage }} ед. физического урона ). Каждый залп может быть критическим. В таком случае он наносит %i:scaleCrit% {{ critdamageperwave }} ед. физического урона .{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:MissFortune_W a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "MissFortune_W" ;
    lol:description "Скорость передвижения Мисс Фортуны пассивно увеличивается, когда ей не наносят урон. При активации умения скорость атаки Мисс Фортуны на короткое время увеличивается. Перезарядку Походочки можно уменьшить использованием Приветственного выстрела."^^xsd:string ;
    lol:entityId "MissFortune:W"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_MissFortune ;
    lol:name "Походочка"^^xsd:string ;
    lol:slot "W"^^xsd:string ;
    lol:tooltipText "Пассивно: если Мисс Фортуна не получает урона в течение {{ passivebasemsooc }} сек., ее скорость передвижения увеличивается на {{ passivebasems }} . Еще через {{ passivemaxmsextraooc }} сек. это увеличение достигает {{ passivemaxms }} . Активно: Мисс Фортуна сразу получает максимальное увеличение скорости передвижения пассивного эффекта, а также увеличивает свою скорость атаки на {{ activeas*100 }}% на {{ activeduration }} сек. Приветственный выстрел сокращает перезарядку этого умения на {{ lovetaprefund }} сек.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:MonkeyKing_E a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "MonkeyKing_E" ;
    lol:description "Вуконг совершает рывок к выбранному врагу и бьет его, нанося урон. Кроме того, он создает свои копии, которые бьют врагов рядом с основной целью, нанося тот же урон."^^xsd:string ;
    lol:entityId "MonkeyKing:E"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_MonkeyKing ;
    lol:name "Верхом на облаке"^^xsd:string ;
    lol:slot "E"^^xsd:string ;
    lol:tooltipText "Вуконг совершает рывок к врагу и выпускает клонов , которые имитируют рывок к {{ extratargets }} дополнительным врагам поблизости. Все пораженные враги получают {{ totaldamage }} магического урона . После этого скорость атаки Вуконга и его клона увеличивается на {{ attackspeed*100 }}% на {{ attackspeedduration }} сек. {{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:MonkeyKing_P a owl:NamedIndividual,
        lol:PassiveAbility ;
    rdfs:label "MonkeyKing_P" ;
    lol:description "Сражаясь с чемпионами и монстрами, Вуконг увеличивает броню и восстановление здоровья. Эффект суммируется."^^xsd:string ;
    lol:entityId "MonkeyKing:P"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_MonkeyKing ;
    lol:name "Каменная кожа"^^xsd:string ;
    lol:slot "P"^^xsd:string .

lol:MonkeyKing_Q a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "MonkeyKing_Q" ;
    lol:description "Следующая автоатака Вуконга имеет увеличенную дальность, наносит дополнительный урон и уменьшает броню цели на несколько секунд."^^xsd:string ;
    lol:entityId "MonkeyKing:Q"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_MonkeyKing ;
    lol:name "Сокрушительный удар"^^xsd:string ;
    lol:slot "Q"^^xsd:string ;
    lol:tooltipText "Следующая автоатака Вуконга и его клона имеет увеличенную до {{ attackrangebonus }} дальность, дополнительно наносит {{ bonusdamagett }} физического урона и уменьшает броню на {{ armorshredpercent*100 }}% на {{ shredduration }} сек. Перезарядка этого умения сокращается на {{ cooldowndecrease }} сек. каждый раз, когда Вуконг или его клон поражают врага атакой или умением. При нанесении урона это умение активирует эффекты заклинаний. {{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:MonkeyKing_R a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "MonkeyKing_R" ;
    lol:description "Вуконг увеличивает свой посох и начинает вращать им вокруг себя, увеличивая скорость передвижения. Пораженные враги получают урон и подбрасываются."^^xsd:string ;
    lol:entityId "MonkeyKing:R"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_MonkeyKing ;
    lol:name "Циклон"^^xsd:string ;
    lol:slot "R"^^xsd:string ;
    lol:tooltipText "Вуконг увеличивает свою скорость передвижения на {{ movespeed*100 }}% и начинает вращаться с посохом, подбрасывая окружающих врагов на {{ knockupduration }} сек. и нанося физический урон в размере {{ totaldamagett }} плюс {{ percenthpdamagett }} от максимального запаса здоровья в течение {{ spinduration }} сек. Это умение можно применить еще раз в течение {{ recastwindow }} сек., после чего оно уходит на перезарядку.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:MonkeyKing_W a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "MonkeyKing_W" ;
    lol:description "Вуконг становится невидимым и совершает рывок в выбранном направлении, оставляя за собой клона, который атакует ближайших врагов."^^xsd:string ;
    lol:entityId "MonkeyKing:W"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_MonkeyKing ;
    lol:name "Воин-обманщик"^^xsd:string ;
    lol:slot "W"^^xsd:string ;
    lol:tooltipText "Вуконг совершает рывок и становится невидимым на {{ stealthduration }} сек., оставляя за собой неподвижного клона на {{ cloneduration }} сек. Клон атакует врагов поблизости, которым недавно наносил урон Вуконг, и имитирует его абсолютное умение, нанося {{ clonedamagemod*100 }}% от обычного урона.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Mordekaiser_E a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Mordekaiser_E" ;
    lol:description "Мордекайзер подтягивает всех врагов в области поражения."^^xsd:string ;
    lol:entityId "Mordekaiser:E"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Mordekaiser ;
    lol:name "Смертельная хватка"^^xsd:string ;
    lol:slot "E"^^xsd:string ;
    lol:tooltipText "Пассивно: Мордекайзер получает {{ magicpen*100 }}% маг. пробивания . Активно: Мордекайзер подтягивает врагов к себе, нанося {{ totaldamage }} ед. маг. урона .{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Mordekaiser_P a owl:NamedIndividual,
        lol:PassiveAbility ;
    rdfs:label "Mordekaiser_P" ;
    lol:description "Мордекайзер получает ауру, наносящую большой урон, и ускоряется после попадания 3 атаками или умениями по чемпионам или монстрам."^^xsd:string ;
    lol:entityId "Mordekaiser:P"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Mordekaiser ;
    lol:name "Восхождение тьмы"^^xsd:string ;
    lol:slot "P"^^xsd:string .

lol:Mordekaiser_Q a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Mordekaiser_Q" ;
    lol:description "Мордекайзер бьет по земле булавой, нанося урон каждому пораженному врагу. Если враг один, урон по нему увеличивается."^^xsd:string ;
    lol:entityId "Mordekaiser:Q"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Mordekaiser ;
    lol:name "Уничтожение"^^xsd:string ;
    lol:slot "Q"^^xsd:string ;
    lol:tooltipText "Мордекайзер ударяет по земле Вечерней звездой, нанося {{ qdamage }} магического урона . Если враг один, урон увеличивается до {{ empowereddamagetooltip }} .{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Mordekaiser_R a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Mordekaiser_R" ;
    lol:description "Мордекайзер переносит себя и жертву в другое измерение и похищает часть показателей цели. Если Мордекайзер убивает ее, он сохраняет показатели жертвы до ее возрождения."^^xsd:string ;
    lol:entityId "Mordekaiser:R"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Mordekaiser ;
    lol:name "Царство смерти"^^xsd:string ;
    lol:slot "R"^^xsd:string ;
    lol:tooltipText "Мордекайзер отправляет чемпиона в царство смерти и переносится туда вместе с ним на {{ spiritrealmduration }} сек., похищая на это время {{ statstealpercentscalar*100 }}% от его основных показателей. Если Мордекайзер убивает этого врага в царстве смерти, он поглощает его душу и сохраняет похищенные показатели до его возрождения.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Mordekaiser_W a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Mordekaiser_W" ;
    lol:description "Мордекайзер накапливает нанесенный и полученный урон, а затем превращает его в щит. Он может поглотить щит, восстановив себе здоровье."^^xsd:string ;
    lol:entityId "Mordekaiser:W"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Mordekaiser ;
    lol:name "Несокрушимый"^^xsd:string ;
    lol:slot "W"^^xsd:string ;
    lol:tooltipText "Пассивно: Мордекайзер сохраняет {{ damageconversion*100 }}% от наносимого урона и {{ damagetakenconversion*100 }}% от получаемого урона. Активно: Мордекайзер превращает сохраненный урон в щит . Он может повторно применить это умение, чтобы восстановить здоровье в размере {{ healingpercent*100 }}% от оставшейся прочности щита . Минимальная прочность щита: {{ minhealthtooltip }} Максимальная прочность щита: {{ maxhealthtooltip }} {{ spellmodifierdescriptionappend }}"^^xsd:string .

