lol:baseArmor a owl:DatatypeProperty ;
    rdfs:label "baseArmor" ;
    rdfs:domain lol:Champion ;
    rdfs:range xsd:decimal .

lol:baseAttackDamage a owl:DatatypeProperty ;
    rdfs:label "baseAttackDamage" ;
    rdfs:domain lol:Champion ;
    rdfs:range xsd:decimal .

lol:baseHP a owl:DatatypeProperty ;
    rdfs:label "baseHP" ;
    rdfs:domain lol:Champion ;
    rdfs:range xsd:decimal .

lol:baseMP a owl:DatatypeProperty ;
    rdfs:label "baseMP" ;
    rdfs:domain lol:Champion ;
    rdfs:range xsd:decimal .

lol:baseMoveSpeed a owl:DatatypeProperty ;
    rdfs:label "baseMoveSpeed" ;
    rdfs:domain lol:Champion ;
    rdfs:range xsd:decimal .

lol:canApplyMechanic a owl:ObjectProperty ;
    rdfs:label "canApplyMechanic" ;
    rdfs:comment "Выводится цепочкой hasAbility / hasEffect / hasMechanic; не хранит условия."@ru ;
    rdfs:domain lol:Champion ;
    rdfs:range lol:Mechanic ;
    owl:propertyChainAxiom ( lol:hasAbility lol:hasEffect lol:hasMechanic ) .

lol:conditionText a owl:DatatypeProperty ;
    rdfs:label "conditionText" ;
    rdfs:domain lol:AbilityEffect ;
    rdfs:range xsd:string .

lol:description a owl:DatatypeProperty ;
    rdfs:label "description" ;
    rdfs:range xsd:string .

lol:entityId a owl:DatatypeProperty ;
    rdfs:label "entityId" ;
    rdfs:range xsd:string .

lol:evidenceField a owl:DatatypeProperty ;
    rdfs:label "evidenceField" ;
    rdfs:domain lol:AbilityEffect ;
    rdfs:range xsd:string .

lol:evidenceText a owl:DatatypeProperty ;
    rdfs:label "evidenceText" ;
    rdfs:domain lol:AbilityEffect ;
    rdfs:range xsd:string .

lol:gameVersion a owl:DatatypeProperty ;
    rdfs:label "gameVersion" ;
    rdfs:range xsd:string .

lol:hasSource a owl:ObjectProperty ;
    rdfs:label "hasSource" ;
    rdfs:comment "Источник сведений об объекте."@ru ;
    rdfs:range lol:SourceDocument .

lol:name a owl:DatatypeProperty ;
    rdfs:label "name" ;
    rdfs:range xsd:string .

lol:resourceType a owl:DatatypeProperty ;
    rdfs:label "resourceType" ;
    rdfs:domain lol:Champion ;
    rdfs:range xsd:string .

lol:reviewStatus a owl:DatatypeProperty ;
    rdfs:label "reviewStatus" ;
    rdfs:range xsd:string .

lol:slot a owl:DatatypeProperty ;
    rdfs:label "slot" ;
    rdfs:domain lol:Ability ;
    rdfs:range xsd:string .

lol:sourceURL a owl:DatatypeProperty ;
    rdfs:label "sourceURL" ;
    rdfs:domain lol:SourceDocument ;
    rdfs:range xsd:anyURI .

lol:title a owl:DatatypeProperty ;
    rdfs:label "title" ;
    rdfs:domain lol:Champion ;
    rdfs:range xsd:string .

lol:tooltipText a owl:DatatypeProperty ;
    rdfs:label "tooltipText" ;
    rdfs:domain lol:Ability ;
    rdfs:range xsd:string .

lol:Aatrox_E a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Aatrox_E" ;
    lol:description "Атрокс пассивно восстанавливает себе здоровье при нанесении урона вражеским чемпионам. При активации он совершает рывок в выбранном направлении."^^xsd:string ;
    lol:entityId "Aatrox:E"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Aatrox ;
    lol:name "Темный рывок"^^xsd:string ;
    lol:slot "E"^^xsd:string ;
    lol:tooltipText "Пассивно: Атрокс лечится на {{ totalevamp }} от урона, который он наносит чемпионам. Активно: Атрокс совершает рывок. Он может активировать это умение при применении других умений.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Aatrox_P a owl:NamedIndividual,
        lol:PassiveAbility ;
    rdfs:label "Aatrox_P" ;
    lol:description "Периодически следующая автоатака Атрокса дополнительно наносит магический урон в зависимости от максимального запаса здоровья цели и лечит его."^^xsd:string ;
    lol:entityId "Aatrox:P"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Aatrox ;
    lol:name "Стойка разрушителя"^^xsd:string ;
    lol:slot "P"^^xsd:string .

lol:Aatrox_Q a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Aatrox_Q" ;
    lol:description "Атрокс бьет мечом сверху вниз, нанося физический урон. Он может ударить три раза, и каждый раз область поражения будет меняться."^^xsd:string ;
    lol:entityId "Aatrox:Q"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Aatrox ;
    lol:name "Клинок даркинов"^^xsd:string ;
    lol:slot "Q"^^xsd:string ;
    lol:tooltipText "Атрокс бьет своим мечом, нанося {{ qdamage }} физического урона . Если цель находится на краю области поражения, она ненадолго подбрасывается , а урон по ней увеличивается до {{ qedgedamage }} . Это умение можно дважды применить повторно - при каждом повторном применении область поражения меняет форму, а урон увеличивается на 25%.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Aatrox_R a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Aatrox_R" ;
    lol:description "Атрокс принимает демоническую форму, пугая ближайших вражеских миньонов, а также увеличивая свою силу атаки, принимаемое лечение и скорость передвижения. Если он зарабатывает убийство или содействие, продолжительность эффекта увеличивается."^^xsd:string ;
    lol:entityId "Aatrox:R"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Aatrox ;
    lol:name "Губитель мира"^^xsd:string ;
    lol:slot "R"^^xsd:string ;
    lol:tooltipText "Атрокс принимает свою истинную демоническую форму, пугая миньонов поблизости на {{ rminionfearduration }} сек. и получая {{ rmovementspeedbonus*100 }}% скорости передвижения (эффект пропадает в течение {{ rduration }} сек.). Кроме того, он получает {{ rtotaladamp*100 }}% силы атаки и увеличивает эффективность самолечения на {{ rhealingamp*100 }}% до конца действия умения. Убийства и содействия увеличивают продолжительность действия этого эффекта на {{ rextension }} сек. и снова дают прибавку к скорости передвижения .{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Aatrox_W a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Aatrox_W" ;
    lol:description "Атрокс бьет по земле, нанося урон первому пораженному врагу. Если чемпионы или большие монстры не покинут область действия, то будут притянуты к ее центру и снова получат урон."^^xsd:string ;
    lol:entityId "Aatrox:W"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Aatrox ;
    lol:name "Проклятые цепи"^^xsd:string ;
    lol:slot "W"^^xsd:string ;
    lol:tooltipText "Атрокс выпускает цепь, замедляя первого пораженного врага на {{ wslowpercentage*-100 }}% на {{ wslowduration }} сек. и нанося ему {{ wdamage }} ед. физического урона . Если пораженные чемпионы или большие лесные монстры не покидают область действия в течение {{ wslowduration }} сек., они притягиваются в ее центр и снова получают такой же урон.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Ahri_E a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Ahri_E" ;
    lol:description "Ари посылает воздушный поцелуй, который наносит магический урон и очаровывает врага, мгновенно останавливая умения перемещения и заставляя его завороженно идти по направлению к ней."^^xsd:string ;
    lol:entityId "Ahri:E"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Ahri ;
    lol:name "Очарование"^^xsd:string ;
    lol:slot "E"^^xsd:string ;
    lol:tooltipText "Ари посылает воздушный поцелуй, который очаровывает первого пораженного врага на {{ charmduration }} сек. и наносит ему {{ totaldamage }} магического урона .{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Ahri_P a owl:NamedIndividual,
        lol:PassiveAbility ;
    rdfs:label "Ahri_P" ;
    lol:description "Ари лечится, когда убивает 9 миньонов или монстров. Поучаствовав в убийстве чемпиона, она восстанавливает себе еще больше здоровья."^^xsd:string ;
    lol:entityId "Ahri:P"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Ahri ;
    lol:name "Похищение сущности"^^xsd:string ;
    lol:slot "P"^^xsd:string .

lol:Ahri_Q a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Ahri_Q" ;
    lol:description "Ари запускает сферу, которая наносит магический урон всем врагам на своем пути, пока летит от Ари, и чистый урон по пути назад."^^xsd:string ;
    lol:entityId "Ahri:Q"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Ahri ;
    lol:name "Сфера обмана"^^xsd:string ;
    lol:slot "Q"^^xsd:string ;
    lol:tooltipText "Ари выпускает сферу, которая наносит {{ totaldamage }} магического урона всем врагам на своем пути, пока летит от Ари, и {{ totaldamage }} чистого урона по пути назад.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Ahri_R a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Ahri_R" ;
    lol:description "Ари совершает рывок вперед и стреляет молниями душ, нанося урон врагам поблизости. Призрачный рывок можно использовать до 3 раз до перезарядки умения. Количество применений увеличивается, когда Ари участвует в убийстве вражеских чемпионов."^^xsd:string ;
    lol:entityId "Ahri:R"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Ahri ;
    lol:name "Призрачный рывок"^^xsd:string ;
    lol:slot "R"^^xsd:string ;
    lol:tooltipText "Ари совершает рывок, выпуская {{ rmaxtargetspercast }} молнии душ в ближайших врагов (приоритет отдается чемпионам). Каждая молния наносит {{ rcalculateddamage }} магического урона . Призрачный рывок можно повторно применить до 2 раз в течение {{ rrecastwindow }} сек. Если во время действия эффекта Ари поглощает сущность чемпиона при помощи Похищения сущности , она получает возможность еще раз применить Призрачный рывок (максимум доступных применений – {{ rmaxcasts }}), а период повторной активации продлевается на величину вплоть до {{ pdurationextension }} сек.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Ahri_W a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Ahri_W" ;
    lol:description "Ари ненадолго ускоряется и выпускает три огонька, которые нацеливаются на ближайших врагов и атакуют их."^^xsd:string ;
    lol:entityId "Ahri:W"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Ahri ;
    lol:name "Лисий огонь"^^xsd:string ;
    lol:slot "W"^^xsd:string ;
    lol:tooltipText "Ари выпускает 3 огонька, которые стремятся к ближайшим врагам и наносят им {{ singlefiredamage }} магического урона (все огоньки после первого наносят {{ multifiredamage }} урона ). Также она получает {{ movementspeed*100 }}% скорости передвижения (эффект пропадает в течение {{ movementspeedduration }} сек.).{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Akali_E a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Akali_E" ;
    lol:description "Акали совершает сальто назад и бросает перед собой сюрикен, нанося магический урон и помечая первого пораженного врага или дымовую завесу. При повторном применении Акали совершает рывок к помеченной цели, нанося дополнительный урон."^^xsd:string ;
    lol:entityId "Akali:E"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Akali ;
    lol:name "Сюрикен убийцы"^^xsd:string ;
    lol:slot "E"^^xsd:string ;
    lol:tooltipText "Акали совершает сальто назад и бросает перед собой сюрикен, нанося {{ e1damage }} магического урона и помечая первого пораженного врага или дымовую завесу. Акали может повторно применить это умение, чтобы совершить рывок к помеченной цели, нанеся {{ e2damagecalc }} магического урона .{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Akali_P a owl:NamedIndividual,
        lol:PassiveAbility ;
    rdfs:label "Akali_P" ;
    lol:description "При нанесении урона умением чемпиону вокруг него появляется круг энергии. При выходе из круга Акали усиливает следующую автоатаку, увеличивая ее дальность и урон."^^xsd:string ;
    lol:entityId "Akali:P"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Akali ;
    lol:name "Метка убийцы"^^xsd:string ;
    lol:slot "P"^^xsd:string .

lol:Akali_Q a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Akali_Q" ;
    lol:description "Акали бросает пять кунаев, нанося урон в зависимости от дополнительной силы атаки и силы умений, а также замедляя цель."^^xsd:string ;
    lol:entityId "Akali:Q"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Akali ;
    lol:name "Пятиточечный удар"^^xsd:string ;
    lol:slot "Q"^^xsd:string ;
    lol:tooltipText "Акали бросает кунаи по дуге перед собой, нанося {{ damage }} магического урона и замедляя врагов в дальней части области поражения на {{ slowpercentage*100 }}% на {{ slowduration }} сек.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Akali_R a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Akali_R" ;
    lol:description "Акали совершает рывок в выбранном направлении, нанося урон пораженным врагам. При повторном применении Акали совершает еще один рывок в выбранном направлении, нанося урон в зависимости от недостающего здоровья цели."^^xsd:string ;
    lol:entityId "Akali:R"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Akali ;
    lol:name "Идеальное убийство"^^xsd:string ;
    lol:slot "R"^^xsd:string ;
    lol:tooltipText "Акали перепрыгивает через вражеского чемпиона, нанося {{ cast1damage }} магического урона всем врагам на пути. Акали может повторно применить умение через {{ cooldownbetweencasts }} сек. При этом она совершает рывок, пронзая врагов и нанося им от {{ cast2damagemin }} до {{ cast2damagemax }} магического урона в зависимости от недостающего здоровья.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Akali_W a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Akali_W" ;
    lol:description "Акали создает дымовую завесу и ненадолго увеличивает свою скорость передвижения. Находясь внутри, она становится невидимой, а враги не могут выбрать ее в качестве цели для умений или автоатак. При применении автоатак или умений Акали ненадолго раскрывает себя."^^xsd:string ;
    lol:entityId "Akali:W"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Akali ;
    lol:name "Покров сумерек"^^xsd:string ;
    lol:slot "W"^^xsd:string ;
    lol:tooltipText "Акали бросает дымовую бомбу, создавая растущую завесу, которая существует {{ baseduration }} сек. и дает Акали {{ movementspeed }}% скорости передвижения (эффект пропадает в течение {{ movementspeedduration }} сек.). Пока существует завеса, максимальный запас энергии Акали увеличивается на {{ energyrestore }}. Пока Акали находится в дыму, она невидима .{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Akshan_E a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Akshan_E" ;
    lol:description "Акшан выстреливает крюком в элемент ландшафта, а затем облетает его, непрерывно расстреливая ближайшего врага. Он может спрыгнуть раньше времени. При столкновении с чемпионом или элементом ландшафта Акшан спрыгивает автоматически."^^xsd:string ;
    lol:entityId "Akshan:E"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Akshan ;
    lol:name "Зацепной пистолет"^^xsd:string ;
    lol:slot "E"^^xsd:string ;
    lol:tooltipText "Первое применение: Акшан выстреливает крюком, который цепляется за первый элемент ландшафта на пути. Второе применение: Акшан облетает элемент ландшафта, расстреливая ближайшего врага. Каждый выстрел наносит {{ damagetodeal }} ед. физического урона . Третье применение: Акшан спрыгивает и совершает последний выстрел. Если Акшан сталкивается с вражеским чемпионом или элементом ландшафта, он спрыгивает преждевременно. Участие в убийствах чемпионов сбрасывает перезарядку этого умения.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Akshan_P a owl:NamedIndividual,
        lol:PassiveAbility ;
    rdfs:label "Akshan_P" ;
    lol:description "При каждом третьем попадании автоатакой или умением по врагу Акшан наносит дополнительный урон, а также получает щит, если цель - чемпион. После каждой автоатаки Акшан стреляет еще раз, нанося меньше урона. Если он отменяет этот выстрел, его скорость передвижения увеличивается."^^xsd:string ;
    lol:entityId "Akshan:P"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Akshan ;
    lol:name "Бой без правил"^^xsd:string ;
    lol:slot "P"^^xsd:string .

lol:Akshan_Q a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Akshan_Q" ;
    lol:description "Акшан бросает бумеранг, который наносит урон, когда летит вперед и когда возвращается. Дальность полета увеличивается с каждой пораженной целью."^^xsd:string ;
    lol:entityId "Akshan:Q"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Akshan ;
    lol:name "Бумеранг мстителя"^^xsd:string ;
    lol:slot "Q"^^xsd:string ;
    lol:tooltipText "Акшан бросает бумеранг, который наносит {{ finaldamage }} физического урона . Дальность полета бумеранга увеличивается с каждым пораженным врагом. При поражении чемпиона Акшан увеличивает свою скорость передвижения на {{ totalhaste }} (эффект ослабевает в течение {{ hasteduration }} сек.).{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Akshan_R a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Akshan_R" ;
    lol:description "Акшан фиксируется на вражеском чемпионе и накапливает пули. Затем он начинает стрелять. Каждая пуля наносит первому пораженному чемпиону, миньону или строению урон, который зависит от недостающего здоровья цели."^^xsd:string ;
    lol:entityId "Akshan:R"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Akshan ;
    lol:name "Расплата"^^xsd:string ;
    lol:slot "R"^^xsd:string ;
    lol:tooltipText "Акшан фиксируется на вражеском чемпионе и начинает заряжать пистолет энергией. Подготовка длится до {{ channelduration }} сек., и за это время накапливается до {{ numberofbullets }} пуль. Повторное применение: Акшан выпускает все накопленные пули. Каждая из них наносит {{ damageperbulletwithcrit }} физического урона первому пораженному врагу или строению. Урон увеличивается вплоть до {{ maxdamageperbullet }} в зависимости от недостающего здоровья.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Akshan_W a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Akshan_W" ;
    lol:description "Пассивно: когда вражеский чемпион убивает союзника Акшана, он становится негодяем. Если Акшан убивает негодяя, он воскрешает всех убитых им союзников и получает дополнительное золото. При этом остальные негодяи избавляются от этого статуса. Активно: Акшан маскируется, а также увеличивает свои скорость передвижения и восстановление маны при перемещении к негодяям. Акшан быстро теряет маскировку, если находится не в кустах и не около элемента ландшафта."^^xsd:string ;
    lol:entityId "Akshan:W"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Akshan ;
    lol:name "Опасная игра"^^xsd:string ;
    lol:slot "W"^^xsd:string ;
    lol:tooltipText "{{ Spell_AkshanW_Tooltip_{{ gamemodeinteger }} }}{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Alistar_E a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Alistar_E" ;
    lol:description "Алистар топчет ближайших врагов, получая возможность проходить сквозь бойцов и накапливая заряд за каждое повреждение вражеского чемпиона. При накоплении максимального количества зарядов следующая автоатака Алистара нанесет вражескому чемпиону дополнительный магический урон и оглушит его."^^xsd:string ;
    lol:entityId "Alistar:E"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Alistar ;
    lol:name "Топот"^^xsd:string ;
    lol:slot "E"^^xsd:string ;
    lol:tooltipText "Алистар начинает топтать землю, получая призрачность и нанося {{ totaldamage }} ед. магического урона врагам поблизости в течение {{ duration }} сек. Каждая волна умения, нанесшая урон чемпиону, дает Алистару заряд. Когда Алистар накапливает {{ maxstacks }} зар., его следующая автоатака против чемпиона оглушает цель на {{ stunduration }} сек. и дополнительно наносит {{ attackbonusdamage }} ед. магического урона .{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Alistar_P a owl:NamedIndividual,
        lol:PassiveAbility ;
    rdfs:label "Alistar_P" ;
    lol:description "Алистар готовит свой рев, оглушая или смещая вражеских чемпионов, а также находясь рядом с умирающими врагами. Заряженный рев восстанавливает здоровье Алистару и всем ближайшим союзным чемпионам."^^xsd:string ;
    lol:entityId "Alistar:P"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Alistar ;
    lol:name "Торжествующий рев"^^xsd:string ;
    lol:slot "P"^^xsd:string .

lol:Alistar_Q a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Alistar_Q" ;
    lol:description "Алистар бьет по земле, нанося урон окружающим врагам и подбрасывая их в воздух."^^xsd:string ;
    lol:entityId "Alistar:Q"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Alistar ;
    lol:name "Сокрушение"^^xsd:string ;
    lol:slot "Q"^^xsd:string ;
    lol:tooltipText "Алистар бьет по земле, подбрасывая врагов на {{ knockupduration }} сек., а также нанося им {{ totaldamage }} магического урона .{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Alistar_R a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Alistar_R" ;
    lol:description "Алистар издает неистовый рев, освобождаясь ото всех эффектов контроля, а также на некоторое время уменьшая входящий физический и магический урон."^^xsd:string ;
    lol:entityId "Alistar:R"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Alistar ;
    lol:name "Несокрушимая воля"^^xsd:string ;
    lol:slot "R"^^xsd:string ;
    lol:tooltipText "Алистар мгновенно снимает с себя все нейтрализующие эффекты. В течение {{ rduration }} сек. после этого Алистар получает на {{ rdamagereduction }}% меньше урона.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Alistar_W a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Alistar_W" ;
    lol:description "Алистар таранит цель, нанося урон и отбрасывая ее назад."^^xsd:string ;
    lol:entityId "Alistar:W"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Alistar ;
    lol:name "Удар головой"^^xsd:string ;
    lol:slot "W"^^xsd:string ;
    lol:tooltipText "Алистар таранит цель, отбрасывая ее и нанося {{ totaldamage }} магического урона .{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:AllyShieldChampion a owl:Class ;
    rdfs:label "AllyShieldChampion" ;
    rdfs:comment "Чемпион с хотя бы одним эффектом щита для союзников."@ru ;
    rdfs:subClassOf lol:Champion ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( lol:Champion [ a owl:Restriction ;
                        owl:onProperty lol:hasAbility ;
                        owl:someValuesFrom [ a owl:Restriction ;
                                owl:onProperty lol:hasEffect ;
                                owl:someValuesFrom [ a owl:Class ;
                                        owl:intersectionOf ( lol:AbilityEffect [ a owl:Restriction ;
                                                    owl:hasValue lol:Shield ;
                                                    owl:onProperty lol:hasMechanic ] [ a owl:Restriction ;
                                                    owl:hasValue lol:Ally ;
                                                    owl:onProperty lol:hasTargetType ] ) ] ] ] ) ] .

lol:Ambessa_E a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Ambessa_E" ;
    lol:description "Амбесса совершает круговой удар драконьими гончими, нанося урон врагам вокруг нее и замедляя их. Если это умение активирует Поступь драконьей гончей, она совершает второй удар по окончании рывка."^^xsd:string ;
    lol:entityId "Ambessa:E"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Ambessa ;
    lol:name "Истязание"^^xsd:string ;
    lol:slot "E"^^xsd:string ;
    lol:tooltipText "Амбесса совершает круговой удар цепями, нанося врагам {{ calc_damage_flat }} физического урона и замедляя их на {{ slow_amount*100 }}% (замедление ослабевает в течение {{ slow_duration }} сек.). Если это умение активирует Поступь драконьей гончей , Амбесса совершает еще один удар.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Ambessa_P a owl:NamedIndividual,
        lol:PassiveAbility ;
    rdfs:label "Ambessa_P" ;
    lol:description "Если во время применения умения Амбесса получает команду атаки или передвижения, она совершает небольшой рывок. У ее следующей автоатаки увеличиваются дальность, урон и скорость. Кроме того, она восстанавливает энергию."^^xsd:string ;
    lol:entityId "Ambessa:P"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Ambessa ;
    lol:name "Поступь драконьей гончей"^^xsd:string ;
    lol:slot "P"^^xsd:string .

lol:Ambessa_Q a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Ambessa_Q" ;
    lol:description "Амбесса бьет драконьими гончими в полукруге перед собой, нанося дополнительный урон врагам, задетым лезвиями. Поразив врага, она ненадолго получает возможность применить умение снова и бьет драконьими гончими по прямой линии перед собой. Первый пораженный противник получает дополнительный урон."^^xsd:string ;
    lol:entityId "Ambessa:Q"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Ambessa ;
    lol:name "Коварный взмах / Раскалывающий удар"^^xsd:string ;
    lol:slot "Q"^^xsd:string ;
    lol:tooltipText "Коварный взмах : Амбесса бьет клинками перед собой, нанося врагам на краю области поражения физический урон в размере {{ calc_damage_1_max }} + {{ calc_damage_1_percent_max }} от максимального запаса здоровья . Остальные задетые бойцы получают {{ calc_damage_1_min_ratio }} урона. Если Амбесса попадает хотя бы по одному врагу, она получает возможность применить Раскалывающий удар . Раскалывающий удар : Амбесса бьет клинками по прямой линии перед собой, нанося первому пораженному врагу физический урон в размере {{ calc_damage_2_max }} + {{ calc_damage_2_percent_max }} от максимального запаса здоровья . Остальные задетые бойцы получают {{ calc_damage_2_min_ratio }} урона.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Ambessa_R a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Ambessa_R" ;
    lol:description "Амбесса телепортируется к самому дальнему вражескому чемпиону на прямой линии и подавляет его. Затем она бьет его об землю, нанося урон и оглушая."^^xsd:string ;
    lol:entityId "Ambessa:R"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Ambessa ;
    lol:name "Показательная расправа"^^xsd:string ;
    lol:slot "R"^^xsd:string ;
    lol:tooltipText "Пассивно : %i:scaleAPen% пробивание брони Амбессы увеличено на {{ armor_penetration*100 }}% . Умения лечат ее на {{ calc_omnivamp }} от наносимого урона . Активно : Амбесса становится неудержимой и телепортируется к самому дальнему вражескому чемпиону на прямой линии, подавляя его на {{ suppress_duration }} сек. и ударяя об землю. Цель получает {{ calc_damage }} физического урона и оглушается на {{ stun_duration }} сек.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Ambessa_W a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Ambessa_W" ;
    lol:description "Амбесса получает щит и после небольшой подготовки бьет по земле, нанося урон врагам поблизости. Если во время подготовки она блокирует урон от любых бойцов, кроме миньонов, это умение наносит больше урона."^^xsd:string ;
    lol:entityId "Ambessa:W"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Ambessa ;
    lol:name "Отречение"^^xsd:string ;
    lol:slot "W"^^xsd:string ;
    lol:tooltipText "Амбесса получает щит прочностью {{ calc_shield }} на {{ shield_duration }} сек. и собирается с силами в течение {{ buff_duration }} сек. Затем она бьет по земле, нанося врагам поблизости {{ calc_damage_low }} физического урона . Этот урон увеличивается до {{ calc_damage_high }} , если во время подготовки она блокирует урон от вражеских чемпионов, больших монстров или строений.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Amumu_E a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Amumu_E" ;
    lol:description "Амуму получает уменьшенный физический урон. При активации умения Амуму дает волю гневу, нанося урон всем окружающим врагам. Каждый раз, когда Амуму получает урон, перезарядка умения сокращается."^^xsd:string ;
    lol:entityId "Amumu:E"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Amumu ;
    lol:name "Вспышка гнева"^^xsd:string ;
    lol:slot "E"^^xsd:string ;
    lol:tooltipText "Пассивно: Амуму получает на {{ damagereduction }} меньше физ. урона. Когда Амуму поражают автоатакой, перезарядка этого умения сокращается на {{ cdronhit }} сек. Активно: Амуму срывается, нанося {{ tantrumdamage }} ед. маг. урона врагам поблизости.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Amumu_P a owl:NamedIndividual,
        lol:PassiveAbility ;
    rdfs:label "Amumu_P" ;
    lol:description "Автоатаки Амуму накладывают Проклятие на цель, из-за чего она получает дополнительный чистый урон при поражении магическим уроном."^^xsd:string ;
    lol:entityId "Amumu:P"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Amumu ;
    lol:name "Прикосновение мумии"^^xsd:string ;
    lol:slot "P"^^xsd:string .

lol:Amumu_Q a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Amumu_Q" ;
    lol:description "Амуму кидает во врага бинт. При попадании бинт приклеивается к врагу, оглушая его, и Амуму подтягивается к цели, нанося ей урон."^^xsd:string ;
    lol:entityId "Amumu:Q"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Amumu ;
    lol:name "Бросок бинта"^^xsd:string ;
    lol:slot "Q"^^xsd:string ;
    lol:tooltipText "Амуму выпускает бинт и притягивается к первому пораженному врагу, оглушая его на {{ stunduration }} сек. и нанося {{ totaldamage }} ед. маг. урона . У этого умения может быть до 2 зарядов.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Amumu_R a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Amumu_R" ;
    lol:description "Амуму опутывает окружающих врагов бинтами, накладывая на них Проклятие , нанося урон и оглушая."^^xsd:string ;
    lol:entityId "Amumu:R"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Amumu ;
    lol:name "Проклятие печальной мумии"^^xsd:string ;
    lol:slot "R"^^xsd:string ;
    lol:tooltipText "Амуму выпускает в стороны свои бинты, оглушая врагов на {{ rduration }} сек., нанося {{ rcalculateddamage }} магического урона и накладывая Проклятие .{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Amumu_W a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Amumu_W" ;
    lol:description "Амуму внушает отчаяние окружающим врагам, отчего они теряют долю от своего максимального запаса здоровья каждую секунду, а наложенное на них Проклятие обновляется."^^xsd:string ;
    lol:entityId "Amumu:W"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Amumu ;
    lol:name "Отчаяние"^^xsd:string ;
    lol:slot "W"^^xsd:string ;
    lol:tooltipText "Переключение: Амуму начинает плакать, нанося магический урон в размере {{ basedamage }} плюс {{ totalhealthdamage }}% от максимального запаса здоровья окружающим врагам каждую секунду и обновляя Проклятие .{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Anivia_E a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Anivia_E" ;
    lol:description "Анивия взмахивает крыльями и направляет порыв ледяного ветра в указанную цель, нанося урон. Если цель была недавно поражена Мгновенной заморозкой или получила урон от Ледяной бури максимального размера, урон удваивается."^^xsd:string ;
    lol:entityId "Anivia:E"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Anivia ;
    lol:name "Обморожение"^^xsd:string ;
    lol:slot "E"^^xsd:string ;
    lol:tooltipText "Анивия направляет в указанную цель порыв ледяного ветра, нанося {{ totaldamage }} магического урона . Если на цель действует переохлаждение , урон умения увеличивается до {{ empowereddamage }} .{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Anivia_P a owl:NamedIndividual,
        lol:PassiveAbility ;
    rdfs:label "Anivia_P" ;
    lol:description "При получении смертельного урона Анивия превращается в яйцо, а затем перерождается с полным запасом здоровья."^^xsd:string ;
    lol:entityId "Anivia:P"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Anivia ;
    lol:name "Перерождение"^^xsd:string ;
    lol:slot "P"^^xsd:string .

lol:Anivia_Q a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Anivia_Q" ;
    lol:description "Анивия создает сферу льда, которая летит к противникам, охлаждая и нанося урон каждому, кто попадется на ее пути. Когда сфера взрывается, она наносит урон по площади и оглушает всех в зоне поражения."^^xsd:string ;
    lol:entityId "Anivia:Q"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Anivia ;
    lol:name "Мгновенная заморозка"^^xsd:string ;
    lol:slot "Q"^^xsd:string ;
    lol:tooltipText "Анивия выпускает большую сферу льда, которая наносит {{ totalpassthroughdamage }} магического урона и переохлаждает врагов на {{ slowduration }} сек., замедляя их на {{ spell.glacialstorm:slowamount }}%. Когда сфера пролетает весь путь до конца, она взрывается, оглушая врагов на {{ stunduration }} сек. и нанося им {{ totalexplosiondamage }} магического урона . Анивия может повторно применить это умение, чтобы преждевременно взорвать сферу.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Anivia_R a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Anivia_R" ;
    lol:description "Анивия призывает ледяную бурю, которая замедляет противников и наносит им урон."^^xsd:string ;
    lol:entityId "Anivia:R"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Anivia ;
    lol:name "Ледяная буря"^^xsd:string ;
    lol:slot "R"^^xsd:string ;
    lol:tooltipText "Включено: Анивия призывает бурю изо льда и града, которая замедляет врагов на {{ slowamount }}% и наносит им {{ totaldamagepersecond }} магического урона в секунду . Буря увеличивается в размере в течение {{ growthtime }} сек. Когда буря достигает максимального размера, она переохлаждает и замедляет врагов на {{ slowpercentempoweredtt }}%, а ее урон увеличивается до {{ empowereddamagepersecondtooltiponly }} в секунду .{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Anivia_W a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Anivia_W" ;
    lol:description "Анивия конденсирует влагу из воздуха и замораживает ее, создавая непроходимую ледяную стену. Спустя некоторое время стена тает."^^xsd:string ;
    lol:entityId "Anivia:W"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Anivia ;
    lol:name "Кристаллизация"^^xsd:string ;
    lol:slot "W"^^xsd:string ;
    lol:tooltipText "Анивия создает ледяную стену шириной {{ wallwidth }}. Стена держится {{ wallduration }} сек., затем тает.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Annie_E a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Annie_E" ;
    lol:description "Энни накладывает на себя или на союзника щит, кратковременно увеличивает скорость передвижения цели, а также наносит урон врагам, которые поражают ее автоатаками или умениями."^^xsd:string ;
    lol:entityId "Annie:E"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Annie ;
    lol:name "Пылающий щит"^^xsd:string ;
    lol:slot "E"^^xsd:string ;
    lol:tooltipText "Энни накладывает на союзного чемпиона щит прочностью {{ shieldblocktotal }} на {{ shieldduration }} сек. и увеличивает скорость передвижения цели на {{ movespeedcalc }} (эффект пропадает в течение {{ movementspeedduration }} сек.). Пока существует щит, враги, которые поражают соответствующего союзника автоатаками или умениями, получают {{ damagereturn }} магического урона (не более одного раза за каждый щит). Тибберс всегда получает эффекты Пылающего щита во время призыва.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Annie_P a owl:NamedIndividual,
        lol:PassiveAbility ;
    rdfs:label "Annie_P" ;
    lol:description "Каждое пятое умение Энни оглушает цель. Энни начинает игру и возрождается с полностью подготовленной Пироманией."^^xsd:string ;
    lol:entityId "Annie:P"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Annie ;
    lol:name "Пиромания"^^xsd:string ;
    lol:slot "P"^^xsd:string .

lol:Annie_Q a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Annie_Q" ;
    lol:description "Энни швыряет во врага заряженный маной огненный шар, нанося ему магический урон. Если враг умирает, затраченная мана восстанавливается."^^xsd:string ;
    lol:entityId "Annie:Q"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Annie ;
    lol:name "Расщепление"^^xsd:string ;
    lol:slot "Q"^^xsd:string ;
    lol:tooltipText "Энни выпускает огненный шар, который наносит {{ totaldamage }} магического урона . Если цель погибает, Энни получает назад затраченную ману, а перезарядка умения сокращается на 50%.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Annie_R a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Annie_R" ;
    lol:description "Энни призывает своего медведя Тибберса, который будет сражаться на ее стороне и поджигать ближайших врагов. В момент призыва все враги рядом с Тибберсом получают урон."^^xsd:string ;
    lol:entityId "Annie:R"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Annie ;
    lol:name "Призыв Тибберса"^^xsd:string ;
    lol:slot "R"^^xsd:string ;
    lol:tooltipText "Пассивно: Энни получает {{ rpercentpenbuff*100 }}% маг. пробивания . Энни призывает своего медведя Тибберса, нанося {{ initialburstdamage }} ед. маг. урона . В течение следующих {{ tibberslifetime }} сек. Тибберс обжигает всех врагов поблизости, нанося {{ tibbersauradamage }} ед. маг. урона в секунду . Тибберс впадает в ярость при призыве, а также когда Энни оглушает вражеского чемпиона или погибает. При этом его скорость атаки растет на 275% , а скорость передвижения – на 100% (эффект ослабевает в течение 3 сек.). Повторное применение: Энни отдает Тибберсу новый приказ.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Annie_W a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Annie_W" ;
    lol:description "Энни создает конус из пламени, нанося урон всем врагам в зоне поражения."^^xsd:string ;
    lol:entityId "Annie:W"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Annie ;
    lol:name "Испепеление"^^xsd:string ;
    lol:slot "W"^^xsd:string ;
    lol:tooltipText "Энни выпускает волну пламени, которая наносит {{ totaldamage }} магического урона .{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Aphelios_E a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Aphelios_E" ;
    lol:description "У Афелия нет третьего умения. В этой ячейке показывается следующее оружие, которое ему даст Алуна. Порядок получения оружия фиксированный, но может меняться по ходу игры. Когда заканчиваются боеприпасы для текущего оружия, оно переносится в конец очереди."^^xsd:string ;
    lol:entityId "Aphelios:E"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Aphelios ;
    lol:name "Система очереди видов оружия"^^xsd:string ;
    lol:slot "E"^^xsd:string ;
    lol:tooltipText "{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Aphelios_P a owl:NamedIndividual,
        lol:PassiveAbility ;
    rdfs:label "Aphelios_P" ;
    lol:description "Афелий владеет 5 видами оружия Лунари, которые создала его сестра Алуна. Одновременно он использует два оружия: основное и дополнительное. У каждого оружия уникальные автоатаки и умение. Атаки и умения расходуют боеприпасы оружия. Когда они заканчиваются, Афелий выбрасывает текущее оружие и Алуна дает ему следующее в очереди из пяти."^^xsd:string ;
    lol:entityId "Aphelios:P"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Aphelios ;
    lol:name "Убийца и провидица"^^xsd:string ;
    lol:slot "P"^^xsd:string .

lol:Aphelios_Q a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Aphelios_Q" ;
    lol:description "У Афелия есть 5 разных активируемых умений, которые зависят от основного оружия: Калибрум (винтовка): Афелий совершает выстрел с большого расстояния, помечая цель. После этого он может поразить помеченного врага еще раз с дальнего расстояния. Северум (пистолет-коса): Афелий ускоряется и расстреливает ближайших врагов из обоих видов оружия. Гравитум (пушка): Афелий обездвиживает всех врагов, замедленных этим оружием. Инфернум (огнемет): Афелий поражает врагов в конусе и атакует их с помощью дополнительного оружия. Кресцендум (шакрам): Афелий создает стража, который атакует врагов с помощью дополнительного оружия."^^xsd:string ;
    lol:entityId "Aphelios:Q"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Aphelios ;
    lol:name "Оружейные умения"^^xsd:string ;
    lol:slot "Q"^^xsd:string ;
    lol:tooltipText "{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Aphelios_R a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Aphelios_R" ;
    lol:description "Афелий выпускает концентрированный сгусток лунного света, который взрывается при поражении вражеских чемпионов. Накладывает уникальный эффект основного оружия Афелия."^^xsd:string ;
    lol:entityId "Aphelios:R"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Aphelios ;
    lol:name "Лунный дозор"^^xsd:string ;
    lol:slot "R"^^xsd:string ;
    lol:tooltipText "Афелий выпускает концентрированный сгусток лунного света, который взрывается при поражении чемпиона и наносит {{ maxdamage }} физического урона всем вокруг. После этого Афелий атакует всех пораженных чемпионов с помощью основного оружия. {{ Spell_ApheliosR_WeaponMod_{{ f1 }} }}{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Aphelios_W a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Aphelios_W" ;
    lol:description "Афелий меняет местами основное и дополнительное оружие, получая новые автоатаки и активируемое умение."^^xsd:string ;
    lol:entityId "Aphelios:W"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Aphelios ;
    lol:name "Фаза"^^xsd:string ;
    lol:slot "W"^^xsd:string ;
    lol:tooltipText "Афелий меняет местами основное и дополнительное оружие, беря в руки Гравитум .{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Ashe_E a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Ashe_E" ;
    lol:description "Эш отправляет дух ястреба на разведку в любую точку на карте."^^xsd:string ;
    lol:entityId "Ashe:E"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Ashe ;
    lol:name "Ястребиная разведка"^^xsd:string ;
    lol:slot "E"^^xsd:string ;
    lol:tooltipText "Эш посылает ястреба, который раскрывает любое место на карте на 5 сек. Кроме того, он раскрывает область вокруг себя во время полета. У этого умения может быть до 2 зарядов (частота получения зарядов: {{ chargecooldown }} сек.).{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Ashe_P a owl:NamedIndividual,
        lol:PassiveAbility ;
    rdfs:label "Ashe_P" ;
    lol:description "Автоатаки Эш замедляют врагов и помечают их. Помеченным целям Эш наносит дополнительный урон. Критические удары Эш не наносят увеличенного урона, однако сильнее замедляют цель."^^xsd:string ;
    lol:entityId "Ashe:P"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Ashe ;
    lol:name "Морозный выстрел"^^xsd:string ;
    lol:slot "P"^^xsd:string .

lol:Ashe_Q a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Ashe_Q" ;
    lol:description "Автоатаки Эш повышают Сосредоточенность. Когда накапливается максимальное количество зарядов, умение можно активировать. При этом все заряды Сосредоточенности поглощаются, и скорость атаки Эш на некоторое время увеличивается. Кроме того, в течение этого времени при каждой автоатаке Эш выпускает град стрел."^^xsd:string ;
    lol:entityId "Ashe:Q"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Ashe ;
    lol:name "Сосредоточенность стрелка"^^xsd:string ;
    lol:slot "Q"^^xsd:string ;
    lol:tooltipText "Пассивно: каждая автоатака Эш дает ей заряд на {{ stackduration }} сек. Набрав {{ maxstacks }} зар., она может применить это умение. Активно: Эш на {{ buffduration }} сек. получает {{ bonusas }}% скорости атаки , и ее автоатаки в течение этого времени наносят {{ empowereddamage }} ед. урона .{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Ashe_R a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Ashe_R" ;
    lol:description "Эш выпускает ледяную стрелу в указанном направлении. Если стрела попадает во вражеского чемпиона, она наносит урон и оглушает его на некоторое время (зависит от дальности полета стрелы). Окружающие цель противники тоже получают урон и замедляются."^^xsd:string ;
    lol:entityId "Ashe:R"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Ashe ;
    lol:name "Зачарованная ледяная стрела"^^xsd:string ;
    lol:slot "R"^^xsd:string ;
    lol:tooltipText "Эш выпускает ледяную стрелу, которая оглушает первого пораженного чемпиона и наносит ему {{ rmaindamage }} ед. магического урона . Длительность оглушения зависит от дальности полета стрелы (но не может превышать {{ maxstunduration }} сек.). Окружающие чемпиона враги замедляются Морозным выстрелом .{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Ashe_W a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Ashe_W" ;
    lol:description "Эш выпускает веер из стрел, нанося увеличенный урон. Умение также накладывает эффект Морозного выстрела."^^xsd:string ;
    lol:entityId "Ashe:W"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Ashe ;
    lol:name "Залп"^^xsd:string ;
    lol:slot "W"^^xsd:string ;
    lol:tooltipText "Эш выпускает веер из {{ numberofarrowstooltip }} стрел, каждая из которых наносит {{ totaldamage }} физического урона . Врагов могут поразить нескольких стрел, но урон им нанесет только первая.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:AurelionSol_E a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "AurelionSol_E" ;
    lol:description "Аурелион Сол создает черную дыру, которая наносит врагам урон и медленно притягивает их к своему центру. Это умение дает звездную материю каждый раз, когда в черной дыре погибает враг, и за каждую секунду, когда в ней находятся вражеские чемпионы. Враги в центре черной дыры погибают, когда у них остается определенное количество здоровья. Звездная материя увеличивает размер Сингулярности и порог казни."^^xsd:string ;
    lol:entityId "AurelionSol:E"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_AurelionSol ;
    lol:name "Сингулярность"^^xsd:string ;
    lol:slot "E"^^xsd:string ;
    lol:tooltipText "Аурелион Сол создает черную дыру, которая наносит врагам {{ damagepersecond }} магического урона в секунду и притягивает их к своему центру в течение {{ duration }} сек. Враги в центре, у которых остается менее {{ currentexecutionthreshold }}% здоровья , мгновенно погибают. Аурелион Сол получает звездную материю каждый раз, когда в черной дыре погибает враг, и за каждую секунду, когда в ней находятся вражеские чемпионы.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:AurelionSol_P a owl:NamedIndividual,
        lol:PassiveAbility ;
    rdfs:label "AurelionSol_P" ;
    lol:description "Умения, наносящие урон, дают Аурелиону Солу звездную материю , которая навсегда улучшает весь его арсенал."^^xsd:string ;
    lol:entityId "AurelionSol:P"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_AurelionSol ;
    lol:name "Вселенский творец"^^xsd:string ;
    lol:slot "P"^^xsd:string .

lol:AurelionSol_Q a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "AurelionSol_Q" ;
    lol:description "В течение нескольких секунд Аурелион Сол дышит огнем, нанося урон первому пораженному врагу, а также меньшее количество урона другим противникам поблизости. Каждый раз, когда цель поражается огнем 1 секунду суммарно, она получает дополнительный урон в зависимости от количества собранной звездной материи. Если цель – чемпион, это умение дает Аурелиону Солу звездную материю."^^xsd:string ;
    lol:entityId "AurelionSol:Q"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_AurelionSol ;
    lol:name "Дыхание солнца"^^xsd:string ;
    lol:slot "Q"^^xsd:string ;
    lol:tooltipText "Аурелион Сол дышит звездным огнем до {{ maxchannelduration }} сек., ежесекундно нанося {{ damagepersecond }} магического урона первому пораженному врагу и {{ aoemodifier*100 }}% от этого урона противникам поблизости. Каждый раз, когда цель поражается огнем 1 секунду суммарно, происходит взрыв, который наносит {{ burstdamage }} магического урона плюс магический урон в размере {{ burstbonustruedamagetochamps }} от максимального запаса здоровья . Если цель – чемпион, Аурелион Сол получает {{ qmassstolen }} звездной материи .{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:AurelionSol_R a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "AurelionSol_R" ;
    lol:description "Падающая звезда. На землю падает звезда, которая наносит пораженным врагам магический урон и оглушает их. Аурелион Сол получает звездную материю за каждого задетого вражеского чемпиона. Когда Аурелион Сол накапливает достаточное количество звездной материи, его следующая Падающая звезда превращается в Обрушение небес. Обрушение небес. Аурелион Сол обрушивает на землю огромную звезду со значительно увеличенной областью поражения. Она наносит больше урона и вместо оглушения подбрасывает врагов. Затем из области поражения распространяется ударная волна, которая наносит чемпионам урон и замедляет их. Звездная материя увеличивает область поражения Падающей звезды и Обрушения небес."^^xsd:string ;
    lol:entityId "AurelionSol:R"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_AurelionSol ;
    lol:name "Падающая звезда / Обрушение небес"^^xsd:string ;
    lol:slot "R"^^xsd:string ;
    lol:tooltipText "На землю падает звезда, которая наносит пораженным врагам {{ maxdamagetooltip }} магического урона и оглушает их на {{ stunduration }} сек. Аурелион Сол получает {{ massstolen }} звездной материи за каждого задетого вражеского чемпиона. Когда Аурелион Сол накапливает {{ calamitystacks }} звездной материи , его следующая Падающая звезда превращается в Обрушение небес . Обрушение небес : Аурелион Сол обрушивает на землю огромную звезду, которая наносит всем врагам в большой области {{ r2damage }} магического урона и подбрасывает их на {{ stunduration }} сек. Затем из области поражения распространяется ударная волна, которая наносит {{ shockwavedamage }} магического урона чемпионам и эпическим монстрам и замедляет всех пораженных врагов на {{ shockwaveslow*100 }}% на 1 сек.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:AurelionSol_W a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "AurelionSol_W" ;
    lol:description "Аурелион Сол летит в выбранном направлении сквозь элементы ландшафта. Во время полета он может применять другие умения. Кроме того, в течение этого времени Дыхание солнца можно применять без ограничений и оно наносит дополнительный урон. Оставшееся время перезарядки Космического полета сокращается, когда погибает вражеский чемпион, которому Аурелион Сол недавно нанес урон. Звездная материя увеличивает максимальную дальность Космического полета."^^xsd:string ;
    lol:entityId "AurelionSol:W"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_AurelionSol ;
    lol:name "Космический полет"^^xsd:string ;
    lol:slot "W"^^xsd:string ;
    lol:tooltipText "Аурелион Сол летит в выбранном направлении. Во время полета Дыхание солнца можно применять без перезарядки и его максимальная продолжительность действия не ограничена. Кроме того, его фиксированный урон увеличен на {{ truedamagebonus*100 }}%. Участия в убийствах чемпионов в течение {{ resetwindow }} сек. после нанесения им урона сокращают перезарядку этого умения на {{ tooltiptakedowncooldownmultiplier }}%. Повторное применение: полет прекращается преждевременно.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Aurora_E a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Aurora_E" ;
    lol:description "Аврора соединяет два мира, выпуская заряд духовной энергии, который замедляет врагов и наносит им урон. Затем Аврора отпрыгивает в безопасное место."^^xsd:string ;
    lol:entityId "Aurora:E"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Aurora ;
    lol:name "Чудовство"^^xsd:string ;
    lol:slot "E"^^xsd:string ;
    lol:tooltipText "Аврора соединяет два мира, выпуская заряд духовной энергии, который наносит {{ damagecalc }} магического урона врагам в области поражения и замедляет их на {{ slowpercent*-100 }}% (эффект ослабевает в течение {{ slowduration }} сек.). После применения умения Аврора отскакивает назад на небольшое расстояние. {{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Aurora_P a owl:NamedIndividual,
        lol:PassiveAbility ;
    rdfs:label "Aurora_P" ;
    lol:description "Когда Аврора наносит урон автоатаками или умениями, она освобождает духов, вселившихся во врагов. Эти духи следуют за Авророй, восстанавливая ей здоровье."^^xsd:string ;
    lol:entityId "Aurora:P"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Aurora ;
    lol:name "Изгнание духа"^^xsd:string ;
    lol:slot "P"^^xsd:string .

lol:Aurora_Q a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Aurora_Q" ;
    lol:description "Аврора выпускает сгусток энергии, который накладывает проклятие на всех пораженных врагов. При повторном применении Аврора снимает проклятия и притягивает энергию к себе, нанося урон всем врагам на пути."^^xsd:string ;
    lol:entityId "Aurora:Q"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Aurora ;
    lol:name "Двойное проклятие"^^xsd:string ;
    lol:slot "Q"^^xsd:string ;
    lol:tooltipText "Аврора выпускает сгусток энергии в выбранном направлении, нанося врагам {{ damage }} магического урона и проклиная их на {{ markduration }} сек. Повторное применение: Аврора снимает проклятие и вытягивает из врагов фрагменты души. Противники, сквозь которых пролетают эти фрагменты, получают до {{ q2damagemax }} магического урона в зависимости от своего недостающего здоровья. Враги после первого получают на 20% меньше урона. Если время действия проклятия истекает, Аврора автоматически применяет умение повторно .{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Aurora_R a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Aurora_R" ;
    lol:description "Аврора прыгает в выбранном направлении и выпускает ударную волну, которая замедляет врагов и наносит им урон. Затем она создает область, которая замедляет врагов внутри. Аврора может телепортироваться от одного края области к другому."^^xsd:string ;
    lol:entityId "Aurora:R"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Aurora ;
    lol:name "Междумирье"^^xsd:string ;
    lol:slot "R"^^xsd:string ;
    lol:tooltipText "Аврора прыгает в выбранном направлении. По приземлении она соединяет два мира, выпуская волну энергии, которая наносит {{ damagecalc }} ед. магического урона пораженным врагам и замедляет их на {{ slowpercent*-100 }}% на 2 сек. Область двух миров существует {{ areaduration }} сек. и дает Авроре Потустороннюю прогулку на {{ rbuffduration }} сек. Она может перемещаться от одного края области к другому. Враги, которые пытаются зайти в область или выйти из нее, замедляются на {{ exitslowpercent*-100 }}% на {{ stunduration }} сек. Умение можно применить повторно , чтобы преждевременно прекратить его действие.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Aurora_W a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Aurora_W" ;
    lol:description "Аврора прыгает в выбранном направлении и переносится в мир духов, ненадолго становясь невидимой и увеличивая свою скорость передвижения."^^xsd:string ;
    lol:entityId "Aurora:W"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Aurora ;
    lol:name "За завесой"^^xsd:string ;
    lol:slot "W"^^xsd:string ;
    lol:tooltipText "Аврора прыгает в выбранном направлении. По приземлении она переходит в мир духов, становясь невидимой на {{ invisduration }} сек. При этом она получает Потустороннюю прогулку , которая увеличивает ее скорость передвижения на {{ movespeedbonus }}% . Участия в убийствах вражеских чемпионов сбрасывают перезарядку этого умения.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Azir_E a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Azir_E" ;
    lol:description "Азир ненадолго защищает себя щитом и совершает рывок к одному из своих песчаных воинов, нанося урон врагам на своем пути. Если Азир сталкивается с вражеским чемпионом, у него мгновенно появляется в запасе еще один воин, а рывок прекращается."^^xsd:string ;
    lol:entityId "Azir:E"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Azir ;
    lol:name "Подвижный песок"^^xsd:string ;
    lol:slot "E"^^xsd:string ;
    lol:tooltipText "Азир накладывает на себя щит прочностью {{ totalshield }} на {{ shieldduration }} сек. и совершает рывок к одному из своих песчаных воинов , нанося {{ totaldamage }} ед. маг. урона всем врагам на пути. Столкнувшись с вражеским чемпионом, Азир останавливается и добавляет в резерв 1 песчаного воина .{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Azir_P a owl:NamedIndividual,
        lol:PassiveAbility ;
    rdfs:label "Azir_P" ;
    lol:description "Азир может установить солнечный диск на развалинах союзной или вражеской башни."^^xsd:string ;
    lol:entityId "Azir:P"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Azir ;
    lol:name "Наследие Шуримы"^^xsd:string ;
    lol:slot "P"^^xsd:string .

lol:Azir_Q a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Azir_Q" ;
    lol:description "Азир отдает приказ всем песчаным воинам сделать рывок в указанную точку. Воины наносят магический урон врагам на своем пути и замедляют их на 1 секунду."^^xsd:string ;
    lol:entityId "Azir:Q"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Azir ;
    lol:name "Неумолимые пески"^^xsd:string ;
    lol:slot "Q"^^xsd:string ;
    lol:tooltipText "Азир приказывает всем песчаным воинам сделать рывок в указанную область. При этом они наносят {{ totaldamage }} ед. магического урона всем врагам на пути и замедляют их на {{ slowamount*-100 }}% на 1 сек.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Azir_R a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Azir_R" ;
    lol:description "Азир призывает фалангу неуправляемых воинов, которые устремляются вперед, отбрасывая врагов и нанося им урон."^^xsd:string ;
    lol:entityId "Azir:R"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Azir ;
    lol:name "Разделяй и властвуй"^^xsd:string ;
    lol:slot "R"^^xsd:string ;
    lol:tooltipText "Азир призывает фалангу закованных в броню воинов, которые устремляются вперед, отбрасывая врагов и нанося им {{ totaldamage }} ед. маг. урона . По завершении броска воины на {{ wallduration }} сек. образуют непреодолимую для врагов стену щитов.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Azir_W a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Azir_W" ;
    lol:description "При активации умения Азир призывает песчаного воина, который автоатакует вместо него в пределах своей дальности атаки. Автоатаки песчаных воинов наносят магический урон всем врагам на прямой линии."^^xsd:string ;
    lol:entityId "Azir:W"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Azir ;
    lol:name "Восстань!"^^xsd:string ;
    lol:slot "W"^^xsd:string ;
    lol:tooltipText "Азир призывает песчаного воина на {{ soldierduration }} сек. Когда Азир применяет автоатаку к врагу около песчаного воина , воин атакует вместо Азира, нанося {{ totaldamage }} ед. маг. урона всем врагам перед собой в направлении цели. У этого умения до {{ maxammo }} зар.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Bard_E a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Bard_E" ;
    lol:description "Бард создает портал, позволяющий пройти сквозь выбранное препятствие. Порталом могут воспользоваться как союзные, так и вражеские чемпионы, но только в одном направлении."^^xsd:string ;
    lol:entityId "Bard:E"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Bard ;
    lol:name "Волшебное путешествие"^^xsd:string ;
    lol:slot "E"^^xsd:string ;
    lol:tooltipText "Бард открывает портал через элемент ландшафта на {{ doorduration }} сек. Любой чемпион может воспользоваться порталом, подойдя к его входу.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Bard_P a owl:NamedIndividual,
        lol:PassiveAbility ;
    rdfs:label "Bard_P" ;
    lol:description "Мипы: Бард притягивает маленьких духов, которые помогают ему при автоатаках, нанося дополнительный магический урон. Когда Бард собирает достаточно колокольчиков , его мипы начинают наносить урон по площади и замедлять пораженных врагов. Колокольчики: в случайных местах на карте появляются древние колокольчики , которые Бард может собирать. Они дают опыт, восстанавливают ману и увеличивают скорость передвижения вне боя."^^xsd:string ;
    lol:entityId "Bard:P"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Bard ;
    lol:name "Зов скитальца"^^xsd:string ;
    lol:slot "P"^^xsd:string .

lol:Bard_Q a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Bard_Q" ;
    lol:description "Бард выпускает в выбранном направлении энергетический заряд, который поражает до двух врагов на своем пути, нанося им урон. Первая пораженная цель замедляется. Если после поражения первой цели заряд попадает во врага или стену, все пораженные цели оглушаются."^^xsd:string ;
    lol:entityId "Bard:Q"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Bard ;
    lol:name "Оковы Вселенной"^^xsd:string ;
    lol:slot "Q"^^xsd:string ;
    lol:tooltipText "Бард выпускает энергетический заряд, который наносит {{ totaldamage }} магического урона первым двум пораженным врагам. Первая цель замедляется на {{ slowamountpercentage }}% на {{ slowduration }} сек. Если после поражения первой цели заряд попадает во врага или в стену, все пораженные цели оглушаются на {{ stunduration }} сек. {{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Bard_R a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Bard_R" ;
    lol:description "Бард посылает энергию духов в указанную область, на короткое время помещая всех бойцов и башни в ней в стазис."^^xsd:string ;
    lol:entityId "Bard:R"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Bard ;
    lol:name "Отсрочка неизбежного"^^xsd:string ;
    lol:slot "R"^^xsd:string ;
    lol:tooltipText "Бард посылает магическую защитную энергию в выбранную область, помещая всех бойцов и строения в ней в стазис на {{ rstasisduration }} сек.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Bard_W a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Bard_W" ;
    lol:description "Бард призывает древний артефакт, который набирает силу в течение некоторого времени. Артефакт восстанавливает здоровье и ненадолго увеличивает скорость передвижения первому союзному чемпиону, который его коснется, перед тем, как исчезнуть."^^xsd:string ;
    lol:entityId "Bard:W"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Bard ;
    lol:name "Алтарь Хранителя"^^xsd:string ;
    lol:slot "W"^^xsd:string ;
    lol:tooltipText "Бард создает целебный артефакт, который увеличивает скорость передвижения первого коснувшегося его союзника на {{ calc_movespeed }} (уменьшается в течение {{ movespeed_duration }} сек.) и восстанавливает ему как минимум {{ initialheal }} здоровья . Артефакт набирает силу в течение {{ chargeuptime }} сек., после чего эффективность его лечения увеличивается до {{ maxheal }} . Бард может создать до {{ maxpacks }} артефактов одновременно. Если вражеский чемпион наступает на артефакт, тот уничтожается. У этого умения может быть до {{ ammo_limit }} зарядов. Установлено артефактов: {{ f1 }}/{{ f2 }}{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Belveth_E a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Belveth_E" ;
    lol:description "Бел'Вет замирает на месте и создает вокруг себя убийственный вихрь, который наносит урон врагу с самым низким уровнем здоровья. Вихрь дает ей прибавку к вампиризму и уменьшает получаемый урон."^^xsd:string ;
    lol:entityId "Belveth:E"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Belveth ;
    lol:name "Ярость императрицы"^^xsd:string ;
    lol:slot "E"^^xsd:string ;
    lol:tooltipText "Бел'Вет создает вокруг себя убийственный вихрь, уменьшая получаемый урон на {{ drpercent*100 }}% и увеличивая вампиризм на {{ totallifesteal }}. Кроме того, она атакует {{ f2.0 }} раз в течение {{ totalduration }} сек. (количество атак зависит от скорости атаки ). Каждая атака поражает врага с самым низким уровнем здоровья, нанося от {{ damageperstrike }} до {{ maxdamageperstriketooltip }} физического урона в зависимости от недостающего здоровья цели. Если Бел'Вет активирует другое умение или повторно применяет это, действие эффекта заканчивается преждевременно. {{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Belveth_P a owl:NamedIndividual,
        lol:PassiveAbility ;
    rdfs:label "Belveth_P" ;
    lol:description "Участвуя в убийствах чемпионов, больших миньонов и больших монстров, Бел'Вет получает заряды, которые навсегда повышают ее скорость атаки. Кроме того, ее скорость атаки ненадолго повышается после применения умений."^^xsd:string ;
    lol:entityId "Belveth:P"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Belveth ;
    lol:name "Лиловая смерть "^^xsd:string ;
    lol:slot "P"^^xsd:string .

lol:Belveth_Q a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Belveth_Q" ;
    lol:description "Бел'Вет совершает рывок в выбранном направлении и наносит урон всем врагам на своем пути."^^xsd:string ;
    lol:entityId "Belveth:Q"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Belveth ;
    lol:name "Неотвратимая Бездна"^^xsd:string ;
    lol:slot "Q"^^xsd:string ;
    lol:tooltipText "Бел'Вет совершает рывок, нанося {{ basedamage }} физического урона всем пораженным врагам. У каждого направления отдельная перезарядка – {{ f1 }} сек. (сокращается по мере роста скорости атаки ). {{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Belveth_R a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Belveth_R" ;
    lol:description "Бел'Вет поглощает коралл Бездны и принимает истинную форму, получая бонусы к макс. здоровью, дальности атаки и скорости атаки. Поглотив коралл Бездны, оставшийся после эпического монстра из Бездны, Бел'Вет продлевает действие умения и получает способность призывать ремор Бездны."^^xsd:string ;
    lol:entityId "Belveth:R"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Belveth ;
    lol:name "Неутолимый голод"^^xsd:string ;
    lol:slot "R"^^xsd:string ;
    lol:tooltipText "Пассивно: автоатаки дополнительно наносят {{ finalonhitdamage }} ед. чистого урона (суммируется бесконечно). Когда Бел'Вет участвует в убийстве эпич. монстров и чемпионов, те оставляют после себя кораллы Бездны. Активно: Бел'Вет поглощает коралл Бездны, получая {{ passivestacksondevour }} лиловый заряд и принимая истинную форму. Когда Бел'Вет поглощает кораллы Бездны, оставленные эпич. монстрами из Бездны, миньоны, погибающие около нее, начинают возрождаться в виде ремор Бездны. Во время применения умения Бел'Вет замедляет врагов поблизости, затем взрывается, нанося чистый урон в размере {{ totalexplosiondamage }} + {{ missinghealthdamage*100 }}% от недост. здоровья . В истинной форме Бел'Вет получает бонусы: +{{ maxhealthondevour }} к макс. здоровью , +{{ bonusaarange }} к дальности атаки, +{{ totalasmod*100 }}% к общей скорости атаки . Ее Неотвратимая Бездна позволяет преодолевать препятствия. Истинная форма действует {{ steroidduration }} сек. ({{ steroiddurationupgrade }} сек. при {{ stackthresholdforupgrade }} лиловых зар.). При {{ stackthresholdforpermanent }} лиловых зар. истинная форма действует до гибели Бел'Вет. {{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Belveth_W a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Belveth_W" ;
    lol:description "Бел'Вет бьет хвостом, нанося пораженным врагам урон, а также подбрасывая их и замедляя."^^xsd:string ;
    lol:entityId "Belveth:W"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Belveth ;
    lol:name "Сверху и снизу"^^xsd:string ;
    lol:slot "W"^^xsd:string ;
    lol:tooltipText "Бел'Вет бьет хвостом, нанося врагам {{ damage }} магического урона , а также подбрасывая их на {{ duration }} сек. и замедляя на {{ slowpercent*100 }}% на {{ slowduration }} сек. При попадании по вражескому чемпиону это умение сокращает перезарядку Неотвратимой Бездны в том направлении, в котором находилась цель.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Blitzcrank_E a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Blitzcrank_E" ;
    lol:description "Блицкранк заряжает кулак энергией, чтобы нанести двойной урон и подбросить противника в воздух при следующей атаке."^^xsd:string ;
    lol:entityId "Blitzcrank:E"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Blitzcrank ;
    lol:name "Силовой кулак"^^xsd:string ;
    lol:slot "E"^^xsd:string ;
    lol:tooltipText "Блицкранк заряжает свой кулак, и его следующая автоатака подбрасывает цель на {{ ccduration }} сек. и наносит {{ totaldamage }} физического урона .{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Blitzcrank_P a owl:NamedIndividual,
        lol:PassiveAbility ;
    rdfs:label "Blitzcrank_P" ;
    lol:description "Когда у Блицкранка остается мало здоровья, он получает щит, прочность которого зависит от его запаса маны."^^xsd:string ;
    lol:entityId "Blitzcrank:P"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Blitzcrank ;
    lol:name "Щит маны"^^xsd:string ;
    lol:slot "P"^^xsd:string .

lol:Blitzcrank_Q a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Blitzcrank_Q" ;
    lol:description "Блицкранк выстреливает правой рукой, притягивая первого пораженного врага к себе и нанося ему урон."^^xsd:string ;
    lol:entityId "Blitzcrank:Q"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Blitzcrank ;
    lol:name "Ракетный захват"^^xsd:string ;
    lol:slot "Q"^^xsd:string ;
    lol:tooltipText "Блицкранк выстреливает своей правой рукой, притягивая первого пораженного врага к себе и нанося ему {{ totaldamage }} магического урона .{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Blitzcrank_R a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Blitzcrank_R" ;
    lol:description "Враги, которых атакует Блицкранк, помечаются и через 1 секунду поражаются молнией, которая наносит урон. Умение можно активировать, чтобы уничтожить щиты ближайших врагов, нанести им урон и ненадолго наложить безмолвие."^^xsd:string ;
    lol:entityId "Blitzcrank:R"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Blitzcrank ;
    lol:name "Статическое поле"^^xsd:string ;
    lol:slot "R"^^xsd:string ;
    lol:tooltipText "Пассивно: когда умение не находится на перезарядке, Блицкранк заряжает свои кулаки электричеством и его автоатаки помечают врагов. Через 1 сек. помеченные цели получают {{ passivedamage }} магического урона . Активно: Блицкранк перегружается, нанося {{ activedamage }} магического урона окружающим врагам и накладывая на них безмолвие на {{ silenceduration }} сек. При этом он разрушает их щиты.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Blitzcrank_W a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Blitzcrank_W" ;
    lol:description "Блицкранк перегружает себя, значительно увеличивая свои скорость передвижения и скорость атаки. По окончании перегрузки его скорость передвижения на время уменьшается."^^xsd:string ;
    lol:entityId "Blitzcrank:W"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Blitzcrank ;
    lol:name "Ускорение"^^xsd:string ;
    lol:slot "W"^^xsd:string ;
    lol:tooltipText "Блицкранк перегружает себя, увеличивая скорость передвижения на {{ movespeedmod*100 }}% (эффект ослабевает со временем) и скорость атаки на {{ attackspeedmod*100 }}% на {{ duration }} сек. По окончании действия эффекта Блицкранк замедляется на {{ movespeedmodreduction*100 }}% на {{ slowduration }} сек.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Brand_E a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Brand_E" ;
    lol:description "Брэнд воспламеняет цель, после чего пламя распространяется на ближайших врагов, нанося магический урон. Если цель в огне, дальность распространения Воспламенения увеличивается вдвое."^^xsd:string ;
    lol:entityId "Brand:E"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Brand ;
    lol:name "Воспламенение"^^xsd:string ;
    lol:slot "E"^^xsd:string ;
    lol:tooltipText "Брэнд вызывает огненную вспышку, которая поражает указанную цель, нанося {{ edamagecalc }} магического урона окружающим бойцам. Если цель подожжена , дальность распространения увеличивается вдвое.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Brand_P a owl:NamedIndividual,
        lol:PassiveAbility ;
    rdfs:label "Brand_P" ;
    lol:description "Умения Брэнда поджигают врагов, в течение 4 секунд нанося им урон (накапливается до 3 зарядов). Если Брэнд убивает подожженного врага, он восстанавливает себе ману. Достигая максимального количества зарядов, Поджог чемпиона или большого монстра становится нестабильным. Он взрывается через 2 секунды, накладывая эффекты заклинания и нанося огромный урон в области вокруг жертвы."^^xsd:string ;
    lol:entityId "Brand:P"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Brand ;
    lol:name "Поджог"^^xsd:string ;
    lol:slot "P"^^xsd:string .

lol:Brand_Q a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Brand_Q" ;
    lol:description "Брэнд выпускает в указанном направлении огненный шар, который наносит магический урон. Если цель в огне, Выгорание оглушает ее."^^xsd:string ;
    lol:entityId "Brand:Q"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Brand ;
    lol:name "Выгорание"^^xsd:string ;
    lol:slot "Q"^^xsd:string ;
    lol:tooltipText "Брэнд выпускает огненный шар, который наносит {{ totaldamage }} магического урона первому пораженному врагу. Если цель подожжена , она оглушается на {{ stunduration }} сек.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Brand_R a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Brand_R" ;
    lol:description "Брэнд высвобождает разрушительный поток огня, который перекидывается между Брэндом и врагами поблизости до 5 раз. При каждом поражении враги получают магический урон. Очищение огнем старается перекинуться на чемпионов для увеличения количества зарядов Поджога. Если цель в огне, Очищение огнем ненадолго замедляет ее."^^xsd:string ;
    lol:entityId "Brand:R"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Brand ;
    lol:name "Очищение огнем"^^xsd:string ;
    lol:slot "R"^^xsd:string ;
    lol:tooltipText "Брэнд высвобождает разрушительный поток огня, который перекидывается между Брэндом и врагами поблизости до 5 раз. При каждом поражении враги получают {{ totaldamage }} магического урона . Умение старается перекинуться на чемпионов для увеличения количества зарядов Поджога . Если цель подожжена , она ненадолго замедляется на {{ slowamount }}%.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Brand_W a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Brand_W" ;
    lol:description "После небольшой задержки Брэнд создает в указанной точке огненный столб, который наносит магический урон всем врагам в зоне поражения. Если цель в огне, Столб пламени наносит ей на 25% урона больше."^^xsd:string ;
    lol:entityId "Brand:W"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Brand ;
    lol:name "Столб пламени"^^xsd:string ;
    lol:slot "W"^^xsd:string ;
    lol:tooltipText "Брэнд создает столб чистого огня, который наносит {{ totaldamage }} магического урона . Если цель подожжена , урон по ней увеличивается до {{ empowereddamage }} .{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Braum_E a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Braum_E" ;
    lol:description "Браум поднимает щит и уменьшает урон от всех атак с определенного направления. Первая атака блокируется целиком, остальные наносят лишь часть урона все то время, пока щит поднят. Браум также перехватывает все выстрелы - они наносят ему урон и разрушаются."^^xsd:string ;
    lol:entityId "Braum:E"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Braum ;
    lol:name "Неуязвимый"^^xsd:string ;
    lol:slot "E"^^xsd:string ;
    lol:tooltipText "Браум поднимает свой щит на {{ shieldholdduration }} сек. и закрывается от вражеских снарядов с выбранной стороны. Эти снаряды попадают в Браума, а затем уничтожаются. Первый снаряд не наносит урона, урон всех последующих падает на {{ shieldfacingdramount }}%. С поднятым щитом Браум получает {{ movespeedpercent }}% скорости передвижения .{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Braum_P a owl:NamedIndividual,
        lol:PassiveAbility ;
    rdfs:label "Braum_P" ;
    lol:description "Автоатаки Браума накладывают на врагов заряды Оглушающих ударов. После появления первого заряда на цели автоатаки союзников начинают накладывать на нее дополнительные заряды. Цель, получившая 4 заряда, получает магический урон и оглушается. В течение следующих нескольких секунд цель не может получить новые заряды Оглушающих ударов, но получает дополнительный магический урон от автоатак Браума."^^xsd:string ;
    lol:entityId "Braum:P"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Braum ;
    lol:name "Оглушающие удары"^^xsd:string ;
    lol:slot "P"^^xsd:string .

lol:Braum_Q a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Braum_Q" ;
    lol:description "Браум стряхивает лед со своего щита, замедляя пораженного врага и нанося ему магический урон. Умение накладывает заряд Оглушающих ударов ."^^xsd:string ;
    lol:entityId "Braum:Q"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Braum ;
    lol:name "Укус зимы"^^xsd:string ;
    lol:slot "Q"^^xsd:string ;
    lol:tooltipText "Браум сбрасывает лед со своего щита, нанося {{ totaldamage }} ед. магического урона первому пораженному врагу и замедляя его на {{ initialslow }}% (эффект пропадает за {{ slowduration }} сек.). Накладывает заряд Оглушающих ударов . {{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Braum_R a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Braum_R" ;
    lol:description "Браум бьет щитом по земле, создавая мощный и дальнобойный направленный удар. Пораженные враги подбрасываются в воздух, получают урон и замедляются."^^xsd:string ;
    lol:entityId "Braum:R"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Braum ;
    lol:name "Ледниковый разлом"^^xsd:string ;
    lol:slot "R"^^xsd:string ;
    lol:tooltipText "Браум бьет по земле, создавая перед собой разлом, который подбрасывает врагов на своем пути и около Браума, а также наносит им {{ totaldamage }} магического урона . Первая пораженная цель подбрасывается на {{ minknockup }}-{{ maxknockup }} сек. в зависимости от расстояния до Браума. Все остальные пораженные враги подбрасываются на {{ minknockup }} сек. Разлом также создает ледяную область на {{ slowzoneduration }} сек., которая замедляет на {{ movespeedmod }}%. {{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Braum_W a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Braum_W" ;
    lol:description "Браум бросается на помощь союзному чемпиону или миньону. Оказавшись рядом с ним, Браум и его союзник получают дополнительную броню и сопротивление магии на несколько секунд."^^xsd:string ;
    lol:entityId "Braum:W"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Braum ;
    lol:name "Прячься за меня"^^xsd:string ;
    lol:slot "W"^^xsd:string ;
    lol:tooltipText "Браум бросается к союзному чемпиону или миньону. Достигнув цели, он дает ей {{ grantedallyarmor }} брони и {{ grantedallymr }} сопротивления магии на {{ duration }} сек. Он сам получает {{ grantedbraumarmor }} брони и {{ grantedbraummr }} сопротивления магии на то же время.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Briar_E a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Briar_E" ;
    lol:description "Брайер берет себя в руки и выходит из состояния Кровавого бешенства. Затем она сосредотачивается и издает чудовищный крик, который замедляет врагов и наносит им урон. Во время подготовки Брайер получает меньше урона и восстанавливает часть от максимального запаса здоровья. Полностью заряженный крик отбрасывает врагов. Если боец попадает в стену, он получает дополнительный урон и оглушается."^^xsd:string ;
    lol:entityId "Briar:E"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Briar ;
    lol:name "Жуткий вопль"^^xsd:string ;
    lol:slot "E"^^xsd:string ;
    lol:tooltipText "Начало подготовки: Брайер выходит из состояния Кровавого бешенства и начинает собираться с силами. В течение 1 сек. она получает на {{ drpercent }}% меньше урона и восстанавливает {{ percentmaxhpheal }} здоровья . Применение: Брайер издает крик, который наносит до {{ damage }} магического урона (в зависимости от времени подготовки) и замедляет врагов на {{ slowpercent*100 }}% на {{ slowduration }} сек. Полностью заряженный крик отбрасывает жертв. Если противник попадает в стену, он получает {{ wallhitdamage }} магического урона и оглушается на {{ wallstunduration }} сек.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Briar_P a owl:NamedIndividual,
        lol:PassiveAbility ;
    rdfs:label "Briar_P" ;
    lol:description "Автоатаки и умения Брайер вызывают у врагов кровотечение (эффект суммируется), которое восстанавливает ей здоровье в размере части от нанесенного урона. Ее здоровье не регенерирует со временем, но чем меньше его остается, тем эффективнее становится лечение."^^xsd:string ;
    lol:entityId "Briar:P"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Briar ;
    lol:name "Алое проклятие"^^xsd:string ;
    lol:slot "P"^^xsd:string .

lol:Briar_Q a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Briar_Q" ;
    lol:description "Брайер прыгает к бойцу. Если это враг, она пинает его, нанося урон, оглушая и раскалывая броню."^^xsd:string ;
    lol:entityId "Briar:Q"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Briar ;
    lol:name "Наскок"^^xsd:string ;
    lol:slot "Q"^^xsd:string ;
    lol:tooltipText "Брайер прыгает к цели и оглушает ее на {{ stunduration }} сек., а также наносит {{ totaldamage }} ед. физического урона и ослабляет броню и сопротивление магии на {{ shredpercent*100 }}% на {{ shredduration }} сек. Если Брайер применяет это умение к миньону или монстру во время Кровавого бешенства , она перестает атаковать чемпионов в приоритетном порядке. {{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Briar_R a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Briar_R" ;
    lol:description "Брайер пинает гемолит из своих колодок, помечая первого пораженного чемпиона. Затем она летит к своей добыче, а по прибытии пугает всех врагов вокруг и полностью подчиняется жажде крови. Брайер преследует добычу до самой смерти. При этом у нее срабатывает Кровавое бешенство, а также увеличиваются броня, сопротивление магии, вампиризм и скорость передвижения."^^xsd:string ;
    lol:entityId "Briar:R"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Briar ;
    lol:name "Верная смерть"^^xsd:string ;
    lol:slot "R"^^xsd:string ;
    lol:tooltipText "Брайер пинает гемолит из своих колодок и летит к первому пораженному чемпиону, помечая его как свою добычу. По прибытии она наносит {{ damage }} магического урона врагам поблизости и пугает всех, кроме добычи, на {{ fearduration }} сек. Затем Брайер переходит в состояние усиленного Кровавого бешенства и преследует добычу до самой смерти. Во время действия эффекта у нее увеличены броня и сопротивление магии (на {{ totalresists }}), вампиризм (на {{ lifestealpercent*100 }}%) и скорость передвижения (на {{ extramovespeedpercent*100 }}%) .{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Briar_W a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Briar_W" ;
    lol:description "Брайер прыгает вперед, разбивает свои колодки и переходит в состояние Кровавого бешенства, начиная гоняться за ближайшим врагом (приоритет отдается чемпионам). Во время Кровавого бешенства у Брайер повышены скорость атаки и скорость передвижения, а ее автоатаки наносят урон всем, кто находится вокруг цели. Брайер может применить это умение повторно. В таком случае при следующей автоатаке она кусает врага, нанося дополнительный урон, который зависит от недостающего здоровья цели. Сама же Брайер восстанавливает себе здоровье в размере части от нанесенного урона."^^xsd:string ;
    lol:entityId "Briar:W"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Briar ;
    lol:name "Кровавое бешенство / Перекус"^^xsd:string ;
    lol:slot "W"^^xsd:string ;
    lol:tooltipText "Брайер прыгает в выбранное место и переходит в состояние Кровавого бешенства , натравливая себя на ближайшего врага на {{ berserkduration }} сек. (приоритет отдается чемпионам). В этом состоянии она получает {{ berserkas*100 }}% скорости атаки и {{ berserkms*100 }}% скорости передвижения , а ее автоатаки наносят {{ totalaoedamage }} физического урона врагам вокруг цели. При повторном применении умения Брайер усиливает свою следующую автоатаку. Она наносит физический урон в размере {{ totalattackbonusdamage }} + {{ totalattackpercentmissinghealth }}% от недостающего здоровья и восстанавливает Брайер здоровье в размере {{ attackmaxhpheal }} + {{ attackhealpercent*100 }}% от нанесенного урона . {{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Caitlyn_E a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Caitlyn_E" ;
    lol:description "Кейтлин выстреливает тяжелой сетью, замедляя цель. Отдача отбрасывает ее назад."^^xsd:string ;
    lol:entityId "Caitlyn:E"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Caitlyn ;
    lol:name "Сеть 90 калибра"^^xsd:string ;
    lol:slot "E"^^xsd:string ;
    lol:tooltipText "Кейтлин выстреливает сетью, отталкивая себя назад. Сеть замедляет первого пораженного врага на {{ slowamount }}% на {{ slowduration }} сек. и наносит {{ netdamage }} ед. маг. урона .{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Caitlyn_P a owl:NamedIndividual,
        lol:PassiveAbility ;
    rdfs:label "Caitlyn_P" ;
    lol:description "Каждые несколько автоатак или при атаке пойманных в ловушку или сеть врагов Кейтлин стреляет противнику в голову, нанося дополнительный урон, зависящий от шанса критического удара. При стрельбе по пойманным в ловушку или сеть врагам дальность автоатаки увеличивается вдвое."^^xsd:string ;
    lol:entityId "Caitlyn:P"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Caitlyn ;
    lol:name "Выстрел в голову"^^xsd:string ;
    lol:slot "P"^^xsd:string .

lol:Caitlyn_Q a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Caitlyn_Q" ;
    lol:description "Кейтлин подстраивает свою винтовку в течение секунды, а затем делает выстрел, который пробивает врагов насквозь, нанося всем пораженным целям физический урон (каждая следующая цель получает меньший урон)."^^xsd:string ;
    lol:entityId "Caitlyn:Q"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Caitlyn ;
    lol:name "Пилтоверский миротворец"^^xsd:string ;
    lol:slot "Q"^^xsd:string ;
    lol:tooltipText "Кейтлин подстраивает свою винтовку, а затем совершает выстрел пробивной пулей, нанося {{ initialdamage }} физического урона . Поразив первую цель, пуля раскрывается и продолжает полет, нанося {{ secondarydamage }} физического урона последующим целям. Враги, раскрытые умением Ловушка на йордлов , всегда получают полный урон.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Caitlyn_R a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Caitlyn_R" ;
    lol:description "Кейтлин тщательно прицеливается и делает превосходный выстрел, наносящий огромный урон одиночной цели на гигантском расстоянии. Вражеские чемпионы могут заслонить собой своего союзника."^^xsd:string ;
    lol:entityId "Caitlyn:R"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Caitlyn ;
    lol:name "Главный козырь"^^xsd:string ;
    lol:slot "R"^^xsd:string ;
    lol:tooltipText "Кейтлин тщательно прицеливается, а затем делает превосходный выстрел, нанося {{ rtotaldamage }} ед. физического урона . Другие вражеские чемпионы могут заслонить собой цель. Это умение дает истинное видение цели на время подготовки умения. Урон повышается в зависимости от шанса критического удара и критического урона Кейтлин. {{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Caitlyn_W a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Caitlyn_W" ;
    lol:description "Кейтлин устанавливает ловушку. После срабатывания она раскрывает и обездвиживает вражеского чемпиона на 1.5 сек., а также позволяет Кейтлин применить усиленный Выстрел в голову."^^xsd:string ;
    lol:entityId "Caitlyn:W"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Caitlyn ;
    lol:name "Ловушка на йордлов"^^xsd:string ;
    lol:slot "W"^^xsd:string ;
    lol:tooltipText "Кейтлин устанавливает ловушку, которая обездвиживает первого ступившего на нее чемпиона на {{ rootduration }} сек., а также дает истинное видение цели на 3 сек. Ловушки существуют {{ trapduration }} сек., а одновременно можно установить не более {{ maximumtraps }} ловушек. У этого умения может быть до {{ maximumcharges }} зар. (новый заряд дается раз в {{ ammorechargetime }} сек.). Цели, обездвиженные этим умением, дополнительно получают {{ headshotbonusdamage }} ед. физического урона от Выстрела в голову .{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Camille_E a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Camille_E" ;
    lol:description "Камилла притягивает себя к препятствию, отпрыгивает от него и по приземлении подбрасывает вражеских чемпионов."^^xsd:string ;
    lol:entityId "Camille:E"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Camille ;
    lol:name "Выстрел крюком"^^xsd:string ;
    lol:slot "E"^^xsd:string ;
    lol:tooltipText "Камилла выстреливает крюком, который прикрепляется к элементу ландшафта и притягивает ее к нему. После этого Камилла в течение 1 сек. может повторно применить это умение. Повторное применение: Камилла отпрыгивает от элемента ландшафта, сталкиваясь с первым попавшимся на пути вражеским чемпионом. По приземлении она получает {{ asbuff*100 }}% скорости атаки на {{ asduration }} сек., наносит {{ totaldamage }} ед. физического урона врагам поблизости и оглушает вражеских чемпионов на {{ knockupduration }} сек. Если Камилла направляется к вражескому чемпиону, она отпрыгивает вдвое дальше.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Camille_P a owl:NamedIndividual,
        lol:PassiveAbility ;
    rdfs:label "Camille_P" ;
    lol:description "При поражении чемпиона автоатакой Камилла ненадолго получает щит против урона, соответствующего основному типу урона пораженной цели (физическому или магическому). Прочность щита зависит от максимального запаса здоровья Камиллы."^^xsd:string ;
    lol:entityId "Camille:P"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Camille ;
    lol:name "Адаптивная защита"^^xsd:string ;
    lol:slot "P"^^xsd:string .

lol:Camille_Q a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Camille_Q" ;
    lol:description "Следующая автоатака Камиллы наносит дополнительный урон и увеличивает ее скорость передвижения. В течение короткого времени это умение можно использовать снова. Урон от второго удара увеличивается, если Камилла нанесет второй удар с задержкой."^^xsd:string ;
    lol:entityId "Camille:Q"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Camille ;
    lol:name "Протокол точности"^^xsd:string ;
    lol:slot "Q"^^xsd:string ;
    lol:tooltipText "Следующая автоатака Камиллы дополнительно наносит {{ bonusdamage }} физического урона и дает ей {{ msbonus*100 }}% скорости передвижения на {{ msduration }} сек. Это умение можно применить повторно в течение {{ qtotalrecasttime }} сек. Если автоатака, усиленная повторным применением умения, поражает врага хотя бы спустя {{ qrampuptime }} сек. после первой атаки, дополнительный урон увеличивается до {{ empoweredbonusdamage }} и {{ damageconversionpercentage }} от урона этой атаки будет чистым . При нанесении урона это умение активирует эффекты заклинаний. {{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Camille_R a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Camille_R" ;
    lol:description "Камилла совершает рывок к выбранному чемпиону и запирает его внутри барьера. Кроме того, ее автоатаки дополнительно наносят магический урон выбранной цели."^^xsd:string ;
    lol:entityId "Camille:R"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Camille ;
    lol:name "Хекстековый ультиматум"^^xsd:string ;
    lol:slot "R"^^xsd:string ;
    lol:tooltipText "Камилла на некоторое время становится недосягаемой и прыгает на вражеского чемпиона, на {{ rduration }} сек. прерывая используемое умение и запирая его внутри барьера, из которого невозможно выбраться. Остальные враги отбрасываются от основной цели. Автоатаки Камиллы по запертой цели дополнительно наносят магический урон в размере {{ rpercentcurrenthpdamage }}% от текущего запаса здоровья .{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Camille_W a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Camille_W" ;
    lol:description "Камилла с небольшой задержкой наносит удар по врагам, находящимся перед собой. Враги в дальней половине поражаемой области замедляются, получают дополнительный урон и восстанавливают Камилле здоровье."^^xsd:string ;
    lol:entityId "Camille:W"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Camille ;
    lol:name "Тактический взмах"^^xsd:string ;
    lol:slot "W"^^xsd:string ;
    lol:tooltipText "Камилла подготавливается и рассекает область перед собой, нанося {{ basedamagetotal }} физического урона . Враги в дальней половине области поражения замедляются на {{ slowpercentage }}% (эффект пропадает в течение {{ slowduration }} сек.). Кроме того, они дополнительно получают физический урон в размере {{ outeredgetooltip }} от максимального запаса здоровья . Камилла восстанавливает здоровье в размере {{ outerconehealingratio }}% от нанесенного дополнительного урона чемпионам .{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Cassiopeia_E a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Cassiopeia_E" ;
    lol:description "Кассиопея запускает во врага клыки, нанося увеличенный урон отравленным врагам и восстанавливая здоровье на величину, равную доле от нанесенного урона. Если цель умирает, Кассиопея получает обратно затраченную ману."^^xsd:string ;
    lol:entityId "Cassiopeia:E"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Cassiopeia ;
    lol:name "Два клыка"^^xsd:string ;
    lol:slot "E"^^xsd:string ;
    lol:tooltipText "Кассиопея выпускает смертоносные шипы, которые наносят {{ basicdamage }} магического урона . Если враг отравлен , он дополнительно получает {{ bonuspoisoneddamage }} магического урона , а Кассиопея восстанавливает себе {{ healcalc }} здоровья . Если цель – миньон с линии или небольшой монстр, эффективность лечения уменьшается до {{ healcalcminion }} . Если это умение убивает цель, Кассиопея восстанавливает себе {{ cost }} маны . {{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Cassiopeia_P a owl:NamedIndividual,
        lol:PassiveAbility ;
    rdfs:label "Cassiopeia_P" ;
    lol:description "Для Кассиопеи бонусы к скорости передвижения становятся эффективнее."^^xsd:string ;
    lol:entityId "Cassiopeia:P"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Cassiopeia ;
    lol:name "Змеиная грация"^^xsd:string ;
    lol:slot "P"^^xsd:string .

lol:Cassiopeia_Q a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Cassiopeia_Q" ;
    lol:description "Кассиопея поражает указанную область сильнодействующим ядом, наносящим урон после небольшой задержки. Если был задет вражеский чемпион, скорость передвижения Кассиопеи увеличивается."^^xsd:string ;
    lol:entityId "Cassiopeia:Q"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Cassiopeia ;
    lol:name "Ядовитый взрыв"^^xsd:string ;
    lol:slot "Q"^^xsd:string ;
    lol:tooltipText "Кассиопея выпускает ядовитый газ, который отравляет врагов и наносит им {{ tooltiptotaldamage }} ед. магического урона в течение {{ poisonduration }} сек. При поражении чемпиона Кассиопея увеличивает свою скорость передвижения на {{ champhitmsbonus }}% (бонус уменьшается в течение {{ champhitmsduration }} сек.).{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Cassiopeia_R a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Cassiopeia_R" ;
    lol:description "Кассиопея выпускает из глаз поток магической энергии, оглушая всех врагов перед собой, обращенных к ней лицом, и замедляя обращенных к ней спиной."^^xsd:string ;
    lol:entityId "Cassiopeia:R"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Cassiopeia ;
    lol:name "Каменящий взгляд"^^xsd:string ;
    lol:slot "R"^^xsd:string ;
    lol:tooltipText "Кассиопея применяет каменящий взгляд, нанося {{ rdamage }} магического урона и оглушая врагов, которые повернуты к ней, на {{ rccduration }} сек. Враги, которые повернуты в другую сторону, замедляются на {{ rslowpercent }}% (эффект ослабевает в течение того же времени).{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Cassiopeia_W a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Cassiopeia_W" ;
    lol:description "Кассиопея выпускает несколько облаков яда, которые наносят небольшой урон, замедляют и парализуют врагов, проходящих сквозь них. Парализованные враги не могут использовать умения перемещения."^^xsd:string ;
    lol:entityId "Cassiopeia:W"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Cassiopeia ;
    lol:name "Миазмы"^^xsd:string ;
    lol:slot "W"^^xsd:string ;
    lol:tooltipText "Кассиопея выплевывает перед собой яд, оставляя на земле токсичные лужи на {{ cloudduration }} сек. Враги в лужах получают {{ damagepersecond }} ед. магического урона в секунду, а также отравляются , парализуются и замедляются на {{ slowpercent }}%.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Chogath_E a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Chogath_E" ;
    lol:description "При каждой автоатаке Чо'Гат выпускает смертоносные шипы, наносящие урон всем врагам перед ним и замедляя их."^^xsd:string ;
    lol:entityId "Chogath:E"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Chogath ;
    lol:name "Смертоносные шипы"^^xsd:string ;
    lol:slot "E"^^xsd:string ;
    lol:tooltipText "Во время 3 следующих автоатак Чо'Гат выпускает шипы, которые наносят магический урон в размере {{ flatdamagecalc }} ед. плюс {{ maxhealthpercentcalc }} от максимального запаса здоровья цели и замедляют на {{ slowamountpercentage }}% (эффект ослабевает в течение {{ slowduration }} сек.).{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Chogath_P a owl:NamedIndividual,
        lol:PassiveAbility ;
    rdfs:label "Chogath_P" ;
    lol:description "Каждый раз, когда Чо'Гат убивает бойца, он восстанавливает себе здоровье и ману. Величина восстановления растет с уровнем Чо'Гата."^^xsd:string ;
    lol:entityId "Chogath:P"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Chogath ;
    lol:name "Плотоядность"^^xsd:string ;
    lol:slot "P"^^xsd:string .

lol:Chogath_Q a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Chogath_Q" ;
    lol:description "Пронзает землю в указанной области, подбрасывая в воздух врагов и замедляя их."^^xsd:string ;
    lol:entityId "Chogath:Q"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Chogath ;
    lol:name "Пролом"^^xsd:string ;
    lol:slot "Q"^^xsd:string ;
    lol:tooltipText "Чо'Гат пронзает землю, подбрасывая врагов на {{ e5 }} сек., а также нанося им {{ totaldamagetooltip }} магического урона и замедляя на {{ e2 }}% на {{ e3 }} сек.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Chogath_R a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Chogath_R" ;
    lol:description "Чо'Гат пожирает врага, нанося ему большое количество чистого урона. Если цель умирает, Чо'Гат растет, получая прибавку к максимальному запасу здоровья."^^xsd:string ;
    lol:entityId "Chogath:R"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Chogath ;
    lol:name "Пожирание"^^xsd:string ;
    lol:slot "R"^^xsd:string ;
    lol:tooltipText "Чо'Гат жадно пожирает противника, нанося {{ rdamage }} чистого урона чемпионам или {{ rmonsterdamage }} урона миньонам и лесным монстрам. Если цель умирает, Чо'Гат получает заряд, от чего он растет, увеличивая свой максимальный запас здоровья на {{ rhealthperstack }} . Пожирая миньонов и неэпических лесных монстров, можно накопить не более {{ rminionmaxstacks }} зарядов. {{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Chogath_W a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Chogath_W" ;
    lol:description "Чо'Гат издает ужасающий крик, который наносит находящимся перед ним врагам магический урон и заставляет их замолчать на несколько секунд."^^xsd:string ;
    lol:entityId "Chogath:W"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Chogath ;
    lol:name "Дикий крик"^^xsd:string ;
    lol:slot "W"^^xsd:string ;
    lol:tooltipText "Чо'Гат издает крик, накладывая на врагов безмолвие на {{ e2 }} сек. и нанося им {{ totaldamagetooltip }} магического урона .{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Corki_E a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Corki_E" ;
    lol:description "Корки ведет огонь из пулемета по противникам перед собой, нанося им урон и уменьшая их броню и сопротивление магии."^^xsd:string ;
    lol:entityId "Corki:E"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Corki ;
    lol:name "Пулемет"^^xsd:string ;
    lol:slot "E"^^xsd:string ;
    lol:tooltipText "Корки стреляет из пулемета перед собой, нанося врагам {{ totaldamage }} физического урона в течение {{ sprayduration }} сек., а также уменьшая их броню и сопротивление магии на {{ shredmax*-1 }}.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Corki_P a owl:NamedIndividual,
        lol:PassiveAbility ;
    rdfs:label "Corki_P" ;
    lol:description "Часть урона от автоатак Корки наносится в виде дополнительного чистого урона ."^^xsd:string ;
    lol:entityId "Corki:P"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Corki ;
    lol:name "Хекстековые боеприпасы"^^xsd:string ;
    lol:slot "P"^^xsd:string .

lol:Corki_Q a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Corki_Q" ;
    lol:description "Корки выпускает фосфорный снаряд в указанную область, нанося магический урон всем врагам в зоне поражения и делая видимыми находящихся там бойцов на некоторое время."^^xsd:string ;
    lol:entityId "Corki:Q"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Corki ;
    lol:name "Фосфорная бомба"^^xsd:string ;
    lol:slot "Q"^^xsd:string ;
    lol:tooltipText "Корки бросает бомбу, которая наносит {{ totaldamage }} магического урона . Область взрыва и пораженные чемпионы раскрываются на {{ revealduration }} сек.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Corki_R a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Corki_R" ;
    lol:description "Корки выпускает ракету в указанном направлении, которая взрывается при попадании, нанося урон всем окружающим врагам. Корки получает новые ракеты с течением времени, пока их запас не достигнет максимума. Каждая третья выпущенная ракета является мегаракетой, наносящей дополнительный урон."^^xsd:string ;
    lol:entityId "Corki:R"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Corki ;
    lol:name "Ракетный обстрел"^^xsd:string ;
    lol:slot "R"^^xsd:string ;
    lol:tooltipText "Корки выпускает ракету, которая взрывается при попадании во врага, нанося {{ rsmallmissiledamage }} физического урона окружающим врагам. Каждая 3-я ракета вместо этого наносит {{ rbigmissiledamage }} физического урона . У этого умения может быть до {{ maxammotooltip }} зарядов. Автоатаки против вражеских чемпионов сокращают время получения зарядов на {{ attackrefund }} сек.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Corki_W a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Corki_W" ;
    lol:description "Корки устремляется к выбранной точке неподалеку, сбрасывая бомбы и оставляя за собой огненный след, наносящий урон всем находящимся в нем противникам."^^xsd:string ;
    lol:entityId "Corki:W"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Corki ;
    lol:name "Валькирия"^^xsd:string ;
    lol:slot "W"^^xsd:string ;
    lol:tooltipText "Корки летит вперед, поджигая за собой землю на {{ trailduration }} сек. Враги в огне получают до {{ maximumdamage }} магического урона в течение этого времени.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Darius_E a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Darius_E" ;
    lol:description "Дариус затачивает свой топор, пассивно игнорируя часть брони цели. При активации умения Дариус цепляет врагов крюком топора и притягивает их к себе."^^xsd:string ;
    lol:entityId "Darius:E"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Darius ;
    lol:name "Задержание"^^xsd:string ;
    lol:slot "E"^^xsd:string ;
    lol:tooltipText "Пассивно: Дариус получает {{ passivepercentarmorpen }}% пробивания брони. Активно: Дариус совершает захват топором, притягивая , подбрасывая и замедляя врагов на {{ slowpercent }}% на {{ slowduration }} сек.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Darius_P a owl:NamedIndividual,
        lol:PassiveAbility ;
    rdfs:label "Darius_P" ;
    lol:description "Автоатаки и наносящие урон умения Дариуса заставляют врагов истекать кровью и получать физический урон в течение 5 сек. Эффект может суммироваться до 5 раз. Когда на цели накапливается максимальное количество зарядов, Дариус впадает в ярость и значительно увеличивает свою силу атаки."^^xsd:string ;
    lol:entityId "Darius:P"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Darius ;
    lol:name "Кровотечение"^^xsd:string ;
    lol:slot "P"^^xsd:string .

lol:Darius_Q a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Darius_Q" ;
    lol:description "После небольшой задержки Дариус выполняет круговой удар топором. Враги, задетые лезвием, получают больше урона, чем те, по которым пришелся удар рукоятью. Кроме того, запас здоровья Дариуса восстанавливается на величину, зависящую от числа чемпионов и больших монстров, пораженных лезвием."^^xsd:string ;
    lol:entityId "Darius:Q"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Darius ;
    lol:name "Истребление"^^xsd:string ;
    lol:slot "Q"^^xsd:string ;
    lol:tooltipText "Дариус замахивается топором и вращает им вокруг себя, нанося {{ bladedamage }} ед. физ. урона лезвием и {{ handledamage }} ед. урона рукоятью. Враги, пораженные рукоятью, не получают заряд Кровотечения . Дариус восстанавливает {{ missinghealthheal }}% от недост. здоровья за каждого вражеского чемпиона или большого лесного монстра, пораженного лезвием, вплоть до {{ missinghealpercent }}% .{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Darius_R a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Darius_R" ;
    lol:description "Дариус прыгает на вражеского чемпиона и выполняет смертоносный удар, нанося чистый урон. Этот урон увеличивается с каждым зарядом Кровотечения на цели. Если цель погибает от Ноксианской гильотины, в течение короткого времени умение можно использовать еще раз."^^xsd:string ;
    lol:entityId "Darius:R"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Darius ;
    lol:name "Ноксианская гильотина"^^xsd:string ;
    lol:slot "R"^^xsd:string ;
    lol:tooltipText "Дариус прыгает к врагу и совершает смертельный удар, нанося {{ damage }} чистого урона . За каждый заряд Кровотечения на цели это умение дополнительно наносит {{ rdamagepercentperhemostack*100 }}% урона (максимальный урон - {{ maximumdamage }} ). Если это умение убивает цель, Дариус может применить его повторно в течение {{ rrecastduration }} сек. На 3-м уровне умения оно перестает расходовать ману, а убийство полностью сбрасывает перезарядку.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Darius_W a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Darius_W" ;
    lol:description "Следующая автоатака Дариуса повреждает жизненно важную артерию врага. Пока цель истекает кровью, ее скорость передвижения уменьшена."^^xsd:string ;
    lol:entityId "Darius:W"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Darius ;
    lol:name "Калечащий удар"^^xsd:string ;
    lol:slot "W"^^xsd:string ;
    lol:tooltipText "Следующая автоатака Дариуса наносит {{ empoweredattackdamage }} ед. физ. урона и замедляет цель на {{ slowpercent }}% на {{ slowduration }} сек. Если цель умирает, Дариус восстанавливает затраченную ману, а перезарядка этого умения сокращается на {{ percentcdrefund }}%. При нанесении урона это умение активирует эффекты заклинаний. {{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Diana_E a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Diana_E" ;
    lol:description "Диана становится живым воплощением мстительной луны, совершает рывок к врагу и наносит ему магический урон. Перезарядка Лунного рывка не требуется, если цель находится под действием Лунного света. После использования Лунного рывка эффект Лунного света пропадает для всех врагов, вне зависимости от того, были ли они целью умения или нет."^^xsd:string ;
    lol:entityId "Diana:E"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Diana ;
    lol:name "Лунный рывок"^^xsd:string ;
    lol:slot "E"^^xsd:string ;
    lol:tooltipText "Диана становится воплощением мстительной луны, совершает рывок к врагу и наносит ему {{ totaldamage }} магического урона . Если цель поражена Лунным светом , перезарядка этого умения сбрасывается.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Diana_P a owl:NamedIndividual,
        lol:PassiveAbility ;
    rdfs:label "Diana_P" ;
    lol:description "Во время каждой третьей автоатаки Диана рассекает ближайших врагов, дополнительно нанося магический урон. После использования умения скорость атаки Дианы увеличивается на 5 сек."^^xsd:string ;
    lol:entityId "Diana:P"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Diana ;
    lol:name "Клинок лунного сияния"^^xsd:string ;
    lol:slot "P"^^xsd:string .

lol:Diana_Q a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Diana_Q" ;
    lol:description "Диана взмахивает клинком, создавая поток энергии, наносящий магический урон по дуге. Пораженные враги попадают под действие Лунного света, который раскрывает их на 3 сек. (не действует на невидимых бойцов)."^^xsd:string ;
    lol:entityId "Diana:Q"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Diana ;
    lol:name "Удар полумесяца"^^xsd:string ;
    lol:slot "Q"^^xsd:string ;
    lol:tooltipText "Диана выпускает дугу лунной энергии, которая наносит {{ totaldamage }} магического урона и помечает цели Лунным светом на {{ moonlightduration }} сек. Лунный свет раскрывает врагов, если они не невидимы .{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Diana_R a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Diana_R" ;
    lol:description "Диана раскрывает и притягивает всех врагов поблизости, а также замедляет их. Если Диана притягивает хотя бы одного вражеского чемпиона, через короткое время ее озаряет лунный свет, который наносит магический урон всем врагам вокруг. Урон увеличивается за каждую притянутую цель, кроме первой."^^xsd:string ;
    lol:entityId "Diana:R"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Diana ;
    lol:name "Притяжение Луны"^^xsd:string ;
    lol:slot "R"^^xsd:string ;
    lol:tooltipText "Диана притягивает к себе окружающих врагов, а также замедляет их на {{ slowtooltip }}% и раскрывает на {{ slowduration }} сек. Если Диана поразила хотя бы одного вражеского чемпиона, она взывает к луне и наносит {{ rexplosiondamage }} магического урона плюс еще {{ rmultihitamplification }} за каждого притянутого чемпиона после первого. Максимальный дополнительный урон - {{ maxdamage }} .{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Diana_W a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Diana_W" ;
    lol:description "Диана создает вокруг себя три вращающиеся сферы, которые взрываются при столкновении с врагами, нанося урон по площади. Кроме того, она получает временный щит, поглощающий урон. Прочность щита увеличивается, когда взрывается третья сфера."^^xsd:string ;
    lol:entityId "Diana:W"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Diana ;
    lol:name "Бледный каскад"^^xsd:string ;
    lol:slot "W"^^xsd:string ;
    lol:tooltipText "Диана на {{ shieldduration }} сек. создает три сферы, которые вращаются вокруг нее и взрываются при столкновении с врагами. Каждая сфера наносит {{ totaldamage }} магического урона (максимальный общий урон - {{ totalmaxdamage }} ). Диана также получает щит прочностью {{ shieldvalue }} на то же время. Когда взрывается последняя сфера, Диана получает еще один щит прочностью {{ shieldvalue }} , а время его существования обновляется.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:DrMundo_E a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "DrMundo_E" ;
    lol:description "Пассивно: Доктор Мундо получает прибавку к силе атаки, которая зависит от его максимального запаса здоровья. Активно: Доктор Мундо бьет цель саквояжем, нанося дополнительный урон, который зависит от его недостающего здоровья. Если цель погибает, тело отбрасывает, и оно наносит урон всем задетым врагам."^^xsd:string ;
    lol:entityId "DrMundo:E"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_DrMundo ;
    lol:name "Тупая травма"^^xsd:string ;
    lol:slot "E"^^xsd:string ;
    lol:tooltipText "Пассивно: сила атаки Доктора Мундо увеличена на {{ passivebonusad }} . Активно: во время следующей автоатаки Доктор Мундо бьет врага саквояжем, дополнительно нанося {{ additionaldamage }} физического урона . Урон увеличивается на величину до {{ maxdamageamptooltip }} в зависимости от недостающего здоровья Доктора Мундо. Если цель погибает, тело отбрасывает, и оно наносит {{ additionaldamage }} физического урона всем задетым врагам.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:DrMundo_P a owl:NamedIndividual,
        lol:PassiveAbility ;
    rdfs:label "DrMundo_P" ;
    lol:description "Доктор Мундо игнорирует первый направленный в него обездвиживающий эффект, но теряет здоровье и роняет неподалеку емкость с химикатами. Когда Доктор Мундо проходит над емкостью, он подбирает ее, восстанавливая здоровье и сокращая перезарядку этого умения. Восстановление здоровья Доктора Мундо значительно увеличено."^^xsd:string ;
    lol:entityId "DrMundo:P"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_DrMundo ;
    lol:name "Ходить куда хотеть"^^xsd:string ;
    lol:slot "P"^^xsd:string .

lol:DrMundo_Q a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "DrMundo_Q" ;
    lol:description "Доктор Мундо бросает зараженную хирургическую пилу, которая замедляет первого пораженного врага и наносит урон в зависимости от его текущего здоровья."^^xsd:string ;
    lol:entityId "DrMundo:Q"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_DrMundo ;
    lol:name "Зараженная пила"^^xsd:string ;
    lol:slot "Q"^^xsd:string ;
    lol:tooltipText "Доктор Мундо швыряет свою хирургическую пилу, которая наносит первому пораженному врагу магический урон в размере {{ currenthealthdamage*100 }}% от текущего здоровья и замедляет его на {{ slowamount*100 }}% на {{ slowduration }} сек. Если пила попадает в чемпиона или монстра, Доктор Мундо восстанавливает себе {{ healthrestoreonhitchampionmonster }} здоровья . Если пила попадает в другую цель, Доктор Мундо восстанавливает себе {{ healthrestoreonhitminion }} здоровья .{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:DrMundo_R a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "DrMundo_R" ;
    lol:description "Доктор Мундо накачивает себя химикатами, мгновенно восстанавливая часть от недостающего здоровья. После этого на протяжении долгого времени он восстанавливает себе часть от максимального запаса здоровья. Пока действует лечение, скорость передвижения Доктора Мундо увеличена."^^xsd:string ;
    lol:entityId "DrMundo:R"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_DrMundo ;
    lol:name "Максимальная доза"^^xsd:string ;
    lol:slot "R"^^xsd:string ;
    lol:tooltipText "Доктор Мундо накачивает себя химикатами, увеличивая максимальный запас здоровья на {{ missinghealthheal*100 }}% от недостающего здоровья и скорость передвижения на {{ speedboostamount*100 }}% . Кроме того, он восстанавливает {{ maxhealthhot*100 }}% от максимального запаса здоровья в течение {{ duration }} сек. На 3-м уровне умения оба лечащих эффекта усиливаются на {{ bonuspernearbychampion*100 }}% за каждого вражеского чемпиона поблизости.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:DrMundo_W a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "DrMundo_W" ;
    lol:description "Доктор Мундо пропускает через себя ток, нанося постоянный урон врагам поблизости и сохраняя часть получаемого урона. По окончании действия умения или при повторном применении Доктор Мундо наносит дополнительный урон окружающим врагам. Если при этом был задет враг, Доктор Мундо восстанавливает себе здоровье в размере части от сохраненного урона."^^xsd:string ;
    lol:entityId "DrMundo:W"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_DrMundo ;
    lol:name "Шоковая терапия"^^xsd:string ;
    lol:slot "W"^^xsd:string ;
    lol:tooltipText "Доктор Мундо бьет себя дефибриллятором до {{ duration }} сек., каждую секунду нанося врагам поблизости {{ damagepertick*4 }} магического урона . При этом он сохраняет в виде серого здоровья {{ grayhealthstorageinitial }} от урона, получаемого в течение первых {{ grayhealthinitialduration }} сек., и {{ grayhealthstorage*100 }}% от последующего урона. Кроме того, он может повторно применить это умение. Повторное применение: дефибриллятор взрывается, нанося врагам поблизости {{ totaldamage }} магического урона . Если взрыв поражает хотя бы одного чемпиона, Мундо лечится на {{ grayhealthbigmod*100 }}% от серого здоровья . В противном случае он лечится на {{ grayhealthsmallmod*100 }}% от серого здоровья .{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Draven_E a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Draven_E" ;
    lol:description "Дрейвен бросает свои топоры, которые наносят физический урон, отбрасывают в сторону и замедляют всех врагов на своем пути."^^xsd:string ;
    lol:entityId "Draven:E"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Draven ;
    lol:name "Расходимся!"^^xsd:string ;
    lol:slot "E"^^xsd:string ;
    lol:tooltipText "Дрейвен бросает свои топоры боком, нанося {{ totaldamage }} ед. физ. урона врагам, а также отбрасывая их и замедляя на {{ slowamount }}% на {{ slowduration }} сек.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Draven_P a owl:NamedIndividual,
        lol:PassiveAbility ;
    rdfs:label "Draven_P" ;
    lol:description "Дрейвен получает Обожание своих поклонников, когда ловит Вращающийся топор или убивает миньона или монстра, либо разрушает башню. Убийства вражеских чемпионов приносят Дрейвену награду в золоте, тем большую, чем больше Обожания у него есть."^^xsd:string ;
    lol:entityId "Draven:P"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Draven ;
    lol:name "Лига Дрейвена"^^xsd:string ;
    lol:slot "P"^^xsd:string .

lol:Draven_Q a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Draven_Q" ;
    lol:description "При следующей автоатаке Дрейвен бросает топор и наносит дополнительный физический урон врагу. Брошенный топор рикошетит от цели и подлетает высоко в воздух. Если Дрейвен ловит его, то снова использует при автоатаке. Дрейвен может использовать до двух топоров одновременно."^^xsd:string ;
    lol:entityId "Draven:Q"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Draven ;
    lol:name "Вращающийся топор"^^xsd:string ;
    lol:slot "Q"^^xsd:string ;
    lol:tooltipText "Дрейвен подготавливает Вращающийся топор , и его следующая автоатака дополнительно наносит {{ totaldamage }} физического урона . Брошенный топор рикошетит от цели и подлетает в воздух. Если Дрейвен ловит его, он подготавливает еще один Вращающийся топор . Дрейвен может иметь до двух Вращающихся топоров одновременно.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Draven_R a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Draven_R" ;
    lol:description "Дрейвен с силой швыряет два массивных топора, которые наносят физический урон всем врагам на своем пути. Топоры меняют направление движения на обратное и возвращаются к Дрейвену после поражения вражеского чемпиона. Дрейвен может активировать умение повторно, чтобы заставить их вернуться раньше. Топоры наносят меньше урона каждому последующему врагу (при смене направления уменьшение урона сбрасывается). Если у врага остается меньше здоровья, чем текущее количество зарядов Обожания, Дрейвен добивает его."^^xsd:string ;
    lol:entityId "Draven:R"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Draven ;
    lol:name "Кружащаяся смерть"^^xsd:string ;
    lol:slot "R"^^xsd:string ;
    lol:tooltipText "Дрейвен кидает два больших топора, которые наносят {{ rcalculateddamage }} физического урона . При поражении вражеского чемпиона или повторном применении умения топоры разворачиваются и возвращаются к Дрейвену. Топоры наносят на {{ rdamagereductionperhit*100 }}% меньше урона за каждого пораженного врага (минимальный урон - {{ rmindamagepercent }}%). Если после поражения умением Кружащаяся смерть у вражеского чемпиона остается меньше здоровья, чем {{ rpassivestackscoefficient*100 }}% от текущего количества зарядов умения Лига Дрейвена ({{ rpassivetruedamage }}), Дрейвен добивает его.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Draven_W a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Draven_W" ;
    lol:description "Дрейвен увеличивает скорость передвижения (ускорение быстро уменьшается в течение действия умения) и скорость атаки. Подхват Вращающегося топора обнуляет время перезарядки умения."^^xsd:string ;
    lol:entityId "Draven:W"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Draven ;
    lol:name "Прилив крови"^^xsd:string ;
    lol:slot "W"^^xsd:string ;
    lol:tooltipText "Дрейвен получает призрачность, {{ temp_msmod }}% скорости передвижения (бонус снижается в течение {{ temp_msduration }} сек.) и {{ temp_as }}% скорости атаки на {{ temp_asduration }} сек. Когда Дрейвен ловит Вращающийся топор , перезарядка этого умения сбрасывается.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Ekko_E a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Ekko_E" ;
    lol:description "Экко перекатывается, уклоняясь от атак и одновременно заряжая Z-привод. При следующей автоатаке Экко наносит дополнительный магический урон и искривляет пространство, телепортируясь к своей цели."^^xsd:string ;
    lol:entityId "Ekko:E"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Ekko ;
    lol:name "Фазовый скачок"^^xsd:string ;
    lol:slot "E"^^xsd:string ;
    lol:tooltipText "Экко совершает рывок и усиливает свою следующую автоатаку: ее дальность увеличивается, она телепортирует Экко к своей цели, а также дополнительно наносит {{ totaldamage }} магического урона .{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Ekko_P a owl:NamedIndividual,
        lol:PassiveAbility ;
    rdfs:label "Ekko_P" ;
    lol:description "Каждая третья автоатака или наносящее урон умение против одной и той же цели наносит дополнительный магический урон. Если цель - чемпион, Экко также ненадолго ускоряется."^^xsd:string ;
    lol:entityId "Ekko:P"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Ekko ;
    lol:name "Резонанс Z-привода"^^xsd:string ;
    lol:slot "P"^^xsd:string .

lol:Ekko_Q a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Ekko_Q" ;
    lol:description "Экко бросает в выбранном направлении устройство, которое наносит магический урон всем врагам на своем пути. Поразив вражеского чемпиона, оно раскрывается, создавая темпоральное поле, которое замедляет всех вражеских бойцов. Через короткое время устройство устремляется обратно к Экко, вновь нанося магический урон всем врагам на своем пути."^^xsd:string ;
    lol:entityId "Ekko:Q"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Ekko ;
    lol:name "Временной ключ"^^xsd:string ;
    lol:slot "Q"^^xsd:string ;
    lol:tooltipText "Экко бросает устройство, наносящее врагам на пути {{ initialdamage }} ед. маг. урона . Поражая чемпиона или достигая конца пути, оно раскрывается и создает поле, замедляющее врагов внутри на {{ slowpercent*-100 }}%. Затем оно возвращается к Экко, нанося врагам на пути {{ recalldamage }} ед. маг. урона .{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Ekko_R a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Ekko_R" ;
    lol:description "Экко отматывает время назад, на короткое время становясь неуязвимым и недосягаемым, а затем появляется там, где находился за несколько секунд до начала перемотки. При этом Экко восстанавливает часть здоровья, которое он потерял за это время, и наносит большой урон всем врагам, оказавшимся поблизости."^^xsd:string ;
    lol:entityId "Ekko:R"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Ekko ;
    lol:name "Управление временем"^^xsd:string ;
    lol:slot "R"^^xsd:string ;
    lol:tooltipText "Экко отматывает время назад, входит в Стазис и телепортируется в то место, где он был 4 сек. назад. При этом он наносит {{ totaldamage }} магического урона врагам поблизости и восстанавливает себе {{ totalbaseheal }} здоровья плюс {{ percenthealampperpercentmissinghealth }}% за каждый 1% здоровья, потерянного за последние 4 сек.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Ekko_W a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Ekko_W" ;
    lol:description "Автоатаки Экко наносят дополнительный магический урон целям с низким уровнем здоровья. Он может применить Параллельную конвергенцию, чтобы разделить временную линию и через несколько секунд создать аномалию, которая замедляет оказавшихся внутри врагов. Если сам Экко оказывается в зоне аномалии, он получает поглощающий урон щит и оглушает всех врагов, находящихся внутри."^^xsd:string ;
    lol:entityId "Ekko:W"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Ekko ;
    lol:name "Параллельная конвергенция"^^xsd:string ;
    lol:slot "W"^^xsd:string ;
    lol:tooltipText "Пассивно: автоатаки Экко против врагов со здоровьем ниже {{ belowhealththreshold*100 }}% дополнительно наносят маг. урон в размере {{ missinghealthpercent }} от недост. здоровья . Активно: Экко выпускает хроносферу, раскрывающуюся после небольшой задержки. Она существует {{ slowzoneduration }} сек. и замедляет врагов внутри на {{ slowpercent }}%. Если Экко входит в сферу, она взрывается, оглушая врагов внутри на {{ stunduration }} сек. и накладывая на Экко щит прочностью {{ totalshield }} .{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Elise_E a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Elise_E" ;
    lol:description "Человеческая форма: Элиза выпускает паутину, оглушая первого пораженного противника, а также раскрывая его на некоторое время (не действует на невидимых бойцов). Форма паука: Элиза и ее паучки поднимаются в воздух, а затем обрушиваются на выбранного врага. После спуска на вражескую цель дополнительный урон и лечение Королевы пауков увеличиваются."^^xsd:string ;
    lol:entityId "Elise:E"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Elise ;
    lol:name "Кокон / Спуск"^^xsd:string ;
    lol:slot "E"^^xsd:string ;
    lol:tooltipText "Человеческая форма : Элиза выпускает кокон, оглушающий и раскрывающий первого пораженного врага на {{ totalstunduration }} сек.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Elise_P a owl:NamedIndividual,
        lol:PassiveAbility ;
    rdfs:label "Elise_P" ;
    lol:description "Человеческая форма: каждый раз, когда Элиза поражает противника умением, она подготавливает спящего паучка. Форма паука: Элиза наносит дополнительный магический урон и восстанавливает себе здоровье при автоатаках."^^xsd:string ;
    lol:entityId "Elise:P"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Elise ;
    lol:name "Королева пауков"^^xsd:string ;
    lol:slot "P"^^xsd:string .

lol:Elise_Q a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Elise_Q" ;
    lol:description "Человеческая форма: Элиза поражает врага ядом, нанося ему магический урон тем больший, чем больше у него осталось здоровья. Форма паука: Элиза бросается к противнику и наносит ему урон тем больший, чем меньше у него осталось здоровья."^^xsd:string ;
    lol:entityId "Elise:Q"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Elise ;
    lol:name "Нейротоксин / Ядовитый укус"^^xsd:string ;
    lol:slot "Q"^^xsd:string ;
    lol:tooltipText "Человеческая форма : Элиза впрыскивает во врага нейротоксин, нанося магический урон в размере {{ basedamage }} плюс {{ humanpercenthealth }} от текущего здоровья цели .{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Elise_R a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Elise_R" ;
    lol:description "Элиза превращается в грозного паука и обретает новые умения. Будучи в форме паука, она имеет увеличенную скорость передвижения, но ее дальность атаки уменьшается. Кроме того, она призывает паучков, чтобы они атаковали врагов поблизости."^^xsd:string ;
    lol:entityId "Elise:R"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Elise ;
    lol:name "Форма паука"^^xsd:string ;
    lol:slot "R"^^xsd:string ;
    lol:tooltipText "Человеческая форма : Элиза превращается в грозного паука, становится чемпионом ближнего боя и получает умения формы паука . Кроме того, она призывает всех спящих паучков .{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Elise_W a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Elise_W" ;
    lol:description "Человеческая форма: Элиза выпускает ядовитого паучка, который взрывается при приближении к цели. Форма паука: скорость атаки Элизы и ее паучков увеличивается."^^xsd:string ;
    lol:entityId "Elise:W"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Elise ;
    lol:name "Взрывоопасный паучок / Паучье бешенство"^^xsd:string ;
    lol:slot "W"^^xsd:string ;
    lol:tooltipText "Человеческая форма : Элиза призывает взрывного паука, который бежит в указанную область и взрывается при приближении к врагу или через 3 сек. Паук наносит {{ spell.elisehumanw:totaldamage }} магического урона .{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:EnemyMovementControlChampion a owl:Class ;
    rdfs:label "EnemyMovementControlChampion" ;
    rdfs:comment "Чемпион с хотя бы одним эффектом ограничения передвижения врага."@ru ;
    rdfs:subClassOf lol:Champion ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( lol:Champion [ a owl:Restriction ;
                        owl:onProperty lol:hasAbility ;
                        owl:someValuesFrom [ a owl:Restriction ;
                                owl:onProperty lol:hasEffect ;
                                owl:someValuesFrom [ a owl:Class ;
                                        owl:intersectionOf ( lol:AbilityEffect [ a owl:Restriction ;
                                                    owl:onProperty lol:hasMechanic ;
                                                    owl:someValuesFrom lol:MovementControlMechanic ] [ a owl:Restriction ;
                                                    owl:hasValue lol:Enemy ;
                                                    owl:onProperty lol:hasTargetType ] ) ] ] ] ) ] .

lol:Evelynn_E a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Evelynn_E" ;
    lol:description "Эвелинн бьет противника плетью, нанося урон. После этого ее скорость передвижения ненадолго увеличивается."^^xsd:string ;
    lol:entityId "Evelynn:E"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Evelynn ;
    lol:name "Удар хлыста"^^xsd:string ;
    lol:slot "E"^^xsd:string ;
    lol:tooltipText "Эвелинн хлещет врага, нанося магический урон в размере {{ basedamage }} плюс {{ percenthealthbasetooltip }} от максимального запаса здоровья . Эвелинн получает {{ speedamount*100 }}% скорости передвижения на {{ speedduration }} сек. При входе в Демоническую тень перезарядка этого умения сбрасывается и оно усиливается. Когда это умение усилено, Эвелинн совершает рывок к цели и наносит ей и всем врагам, через которых проходит, магический урон в размере {{ empowereddamage }} плюс {{ percenthealthempoweredtooltip }} от максимального запаса здоровья .{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Evelynn_P a owl:NamedIndividual,
        lol:PassiveAbility ;
    rdfs:label "Evelynn_P" ;
    lol:description "Находясь вне боя, Эвелинн окутывает себя Демонической тенью. Демоническая тень лечит Эвелинн при низком запасе здоровья, а по достижении 6 уровня дает маскировку."^^xsd:string ;
    lol:entityId "Evelynn:P"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Evelynn ;
    lol:name "Демоническая тень"^^xsd:string ;
    lol:slot "P"^^xsd:string .

lol:Evelynn_Q a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Evelynn_Q" ;
    lol:description "Эвелинн бьет врага своим хлыстом, нанося урон первому пораженному бойцу. Затем она может несколько раз выпустить цепь шипов в ближайших врагов."^^xsd:string ;
    lol:entityId "Evelynn:Q"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Evelynn ;
    lol:name "Всплеск ненависти"^^xsd:string ;
    lol:slot "Q"^^xsd:string ;
    lol:tooltipText "Эвелинн бьет плетью, нанося {{ missiledamage }} магического урона первому пораженному врагу. Следующие 3 автоатаки или умения Эвелинн против этого бойца дополнительно наносят {{ totalbonusdamage }} магического урона . Эвелинн может повторно применять это умение до {{ qstackcount }} раз. Повторное применение: Эвелинн выпускает шипы сквозь ближайшего врага, нанося {{ missiledamage }} магического урона всем пораженным врагам.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Evelynn_R a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Evelynn_R" ;
    lol:description "Эвелинн ненадолго становится недосягаемой и истребляет врагов прямо перед собой. После этого она телепортируется назад на большое расстояние."^^xsd:string ;
    lol:entityId "Evelynn:R"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Evelynn ;
    lol:name "Последний поцелуй"^^xsd:string ;
    lol:slot "R"^^xsd:string ;
    lol:tooltipText "Эвелинн выпускает свою демоническую энергию, нанося большой урон, становясь недосягаемой и телепортируясь назад. Умение наносит {{ damage }} магического урона , который увеличивается до {{ critdamage }} против врагов, у которых осталось менее 30% здоровья . При применении время перезарядки Демонической тени сокращается до 1.25 сек.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Evelynn_W a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Evelynn_W" ;
    lol:description "Эвелинн проклинает свою цель. Следующие атака или умение Эвелинн, примененные после задержки, очаровывают цель и уменьшают ее сопротивление магии."^^xsd:string ;
    lol:entityId "Evelynn:W"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Evelynn ;
    lol:name "Обольщение"^^xsd:string ;
    lol:slot "W"^^xsd:string ;
    lol:tooltipText "Эвелинн помечает выбранного чемпиона или монстра на 5 сек. Если после этого она применяет к цели автоатаку или умение, метка снимается, Эвелинн получает назад затраченную ману, а цель замедляется на {{ slowamount*100 }}% на {{ slowduration }} сек. Если метка существует как минимум 2.5 сек., при ее снятии возникают новые эффекты: Против чемпионов: Эвелинн очаровывает цель на {{ charmduration }} сек. и уменьшает ее сопротивление магии на {{ mrshred*100 }}% на {{ shredduration }} сек. Против монстров: Эвелинн очаровывает цель на {{ monstercharm }} сек. и наносит {{ monsterdamagetotaltooltip }} магического урона .{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Ezreal_E a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Ezreal_E" ;
    lol:description "Эзреаль телепортируется в указанное место неподалеку и делает выстрел, который наносит урон ближайшему противнику. Приоритет отдается целям, пораженным Искажением сущности."^^xsd:string ;
    lol:entityId "Ezreal:E"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Ezreal ;
    lol:name "Магический сдвиг"^^xsd:string ;
    lol:slot "E"^^xsd:string ;
    lol:tooltipText "Эзреаль телепортируется и выпускает заряд в ближайшего врага, нанося {{ damage }} магического урона . Заряд ставит в приоритет цели, пораженные Искажением сущности .{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Ezreal_P a owl:NamedIndividual,
        lol:PassiveAbility ;
    rdfs:label "Ezreal_P" ;
    lol:description "Каждый раз, когда Эзреаль поражает врага умением, его скорость атаки увеличивается (суммируется до 5 раз)."^^xsd:string ;
    lol:entityId "Ezreal:P"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Ezreal ;
    lol:name "Переполняющая магия"^^xsd:string ;
    lol:slot "P"^^xsd:string .

lol:Ezreal_Q a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Ezreal_Q" ;
    lol:description "Эзреаль выстреливает энергетическим зарядом. Если заряд попадает в противника, тому наносится урон, а время перезарядки умений Эзреаля немного сокращается."^^xsd:string ;
    lol:entityId "Ezreal:Q"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Ezreal ;
    lol:name "Мистический выстрел"^^xsd:string ;
    lol:slot "Q"^^xsd:string ;
    lol:tooltipText "Эзреаль выпускает заряд энергии, нанося {{ damage }} физического урона первому пораженному врагу и сокращая перезарядку своих умений на {{ cdrefund }} сек.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Ezreal_R a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Ezreal_R" ;
    lol:description "После небольшой подготовки Эзреаль выпускает мощный заряд энергии, который наносит большой урон каждому пораженному бойцу (миньоны и неэпические монстры получают меньше урона)."^^xsd:string ;
    lol:entityId "Ezreal:R"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Ezreal ;
    lol:name "Прицельный залп"^^xsd:string ;
    lol:slot "R"^^xsd:string ;
    lol:tooltipText "Эзреаль выпускает большую волну энергии, наносящую {{ damage }} ед. маг. урона . Миньоны и неэпические лесные монстры получают {{ damageminionmonster }} ед. маг. урона .{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Ezreal_W a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Ezreal_W" ;
    lol:description "Эзреаль выпускает сферу, которая прикрепляется к первому пораженному чемпиону или объекту. Если Эзреаль поражает врага со сферой, она взрывается и наносит урон."^^xsd:string ;
    lol:entityId "Ezreal:W"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Ezreal ;
    lol:name "Искажение сущности"^^xsd:string ;
    lol:slot "W"^^xsd:string ;
    lol:tooltipText "Эзреаль выпускает магическую сферу, которая прикрепляется к первому пораженному чемпиону, строению или эпическому лесному монстру на {{ detonationtimeout }} сек. Если Эзреаль попадает по этой цели умением или автоатакой, сфера взрывается, нанося {{ damage }} магического урона . Если сфера взрывается от умения, Эзреаль восстанавливает себе ману в размере стоимости этого умения плюс {{ manareturn }} .{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Fiddlesticks_E a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Fiddlesticks_E" ;
    lol:description "Фиддлстикс рассекает область своей косой, замедляя всех пораженных врагов и накладывая безмолвие на тех из них, кто оказался в центре этой области."^^xsd:string ;
    lol:entityId "Fiddlesticks:E"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Fiddlesticks ;
    lol:name "Жатва"^^xsd:string ;
    lol:slot "E"^^xsd:string ;
    lol:tooltipText "Фиддлстикс выпускает темную магию, нанося врагам {{ damage }} магического урона и замедляя их на {{ slowamount*-100 }}% на {{ silenceduration }} сек. На врагов в центре также накладывается безмолвие на то же время.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Fiddlesticks_P a owl:NamedIndividual,
        lol:PassiveAbility ;
    rdfs:label "Fiddlesticks_P" ;
    lol:description "Аксессуар Фиддлстикса заменяется на чучела."^^xsd:string ;
    lol:entityId "Fiddlesticks:P"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Fiddlesticks ;
    lol:name "Безобидное пугало"^^xsd:string ;
    lol:slot "P"^^xsd:string .

lol:Fiddlesticks_Q a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Fiddlesticks_Q" ;
    lol:description "Если Фиддлстикс наносит урон врагам с помощью умений, будучи скрытым, или применяет к ним Ужас, он пугает их, заставляя беспорядочно бегать в течение некоторого времени."^^xsd:string ;
    lol:entityId "Fiddlesticks:Q"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Fiddlesticks ;
    lol:name "Ужас"^^xsd:string ;
    lol:slot "Q"^^xsd:string ;
    lol:tooltipText "Пассивно: если Фиддлстикс наносит урон врагу с помощью умений, когда не раскрыт и находится вне боя либо когда притворяется чучелом , на цель накладывается страх на {{ fearduration }} сек. Активно: Фиддлстикс пугает цель на {{ fearduration }} сек. и наносит ей магический урон в размере {{ totalpercenthealthdamage }} от ее текущего запаса здоровья . Если незадолго до применения Фиддлстикс пугал цель, он наносит магический урон в размере {{ totalpercenthealthdamagefeared }} от ее текущего запаса здоровья . {{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Fiddlesticks_R a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Fiddlesticks_R" ;
    lol:description "Вокруг Фиддлстикса начинает кружить стая воронов, каждую секунду нанося урон окружающим врагам."^^xsd:string ;
    lol:entityId "Fiddlesticks:R"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Fiddlesticks ;
    lol:name "Нашествие воронов"^^xsd:string ;
    lol:slot "R"^^xsd:string ;
    lol:tooltipText "Фиддлстикс готовится в течение {{ channeltime }} сек., а затем телепортируется и выпускает вокруг себя стаю воронов, нанося {{ totaldamage }} магического урона в течение {{ duration }} сек.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Fiddlesticks_W a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Fiddlesticks_W" ;
    lol:description "Фиддлстикс вытягивает здоровье из врагов поблизости, нанося дополнительный урон в конце действия умения, который зависит от недостающего здоровья целей."^^xsd:string ;
    lol:entityId "Fiddlesticks:W"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Fiddlesticks ;
    lol:name "Обильный урожай"^^xsd:string ;
    lol:slot "W"^^xsd:string ;
    lol:tooltipText "Фиддлстикс вытягивает души окружающих врагов, нанося им {{ draindamagecalc }} магического урона в секунду в течение 2 сек., а также магический урон в размере {{ percentfortooltip }}% от недостающего здоровья по окончании действия. Фиддлстикс восстанавливает себе здоровье в размере {{ vamppercentage }}% от нанесенного урона . Если Фиддлстикс применяет умение до конца, не прерываясь, его оставшаяся перезарядка сокращается на 60%. {{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Fiora_E a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Fiora_E" ;
    lol:description "Скорость атаки Фиоры увеличивается на две следующие автоатаки. Первая автоатака уменьшает скорость передвижения цели, а вторая наносит критический урон."^^xsd:string ;
    lol:entityId "Fiora:E"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Fiora ;
    lol:name "Мастер клинка"^^xsd:string ;
    lol:slot "E"^^xsd:string ;
    lol:tooltipText "Фиора получает {{ aspercent*100 }}% скорости атаки на две следующие автоатаки. Первая автоатака замедляет цель на {{ slowpercent*-100 }}% на {{ slowduration }} сек. Вторая автоатака всегда бьет критически, нанося {{ attacktwopercenttad*100 }}% урона .{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Fiora_P a owl:NamedIndividual,
        lol:PassiveAbility ;
    rdfs:label "Fiora_P" ;
    lol:description "Фиора определила слабое место этого чемпиона. Поразив слабое место , она восстановит здоровье , а ее скорость передвижения увеличится."^^xsd:string ;
    lol:entityId "Fiora:P"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Fiora ;
    lol:name "Танец дуэлянта"^^xsd:string ;
    lol:slot "P"^^xsd:string .

lol:Fiora_Q a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Fiora_Q" ;
    lol:description "Фиора делает выпад в указанном направлении и поражает ближайшего врага, нанося ему физический урон и накладывая эффекты при попадании."^^xsd:string ;
    lol:entityId "Fiora:Q"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Fiora ;
    lol:name "Выпад"^^xsd:string ;
    lol:slot "Q"^^xsd:string ;
    lol:tooltipText "Фиора делает выпад в выбранном направлении и поражает ближайшего врага, тотем или строение, нанося цели {{ totaldamage }} физического урона . Этот удар ставит в приоритет слабые места и врагов, которых можно убить. Если Фиора поражает врага, перезарядка этого умения сокращается на {{ cdrefundpercent*100 }}%.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Fiora_R a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Fiora_R" ;
    lol:description "Фиора определяет четыре слабых места чемпиона. При этом, когда она находится рядом с целью, ее скорость передвижения увеличивается. Если Фиора поражает все четыре слабых места цели или поражает хотя бы одно из них до того, как цель умрет, вокруг врага на несколько секунд возникает область, восстанавливающая здоровье Фиоре и ее союзникам."^^xsd:string ;
    lol:entityId "Fiora:R"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Fiora ;
    lol:name "Дерзкий вызов"^^xsd:string ;
    lol:slot "R"^^xsd:string ;
    lol:tooltipText "Пассивно: прибавка к скорости передвижения умения Танец дуэлянта увеличена до {{ percentms*100 }}%. Активно: Фиора определяет все четыре слабых места чемпиона и может нанести ему чистый урон в размере до {{ spell.fiorapassive:rdamagetotal }} от максимального запаса здоровья . Кроме того, находясь рядом с целью, она получает прибавку к скорости передвижения от умения Танец дуэлянта . Если Фиора поражает все четыре слабых места в течение {{ markduration }} сек. или если цель умирает после поражения хотя бы одного слабого места, Фиора восстанавливает {{ healpersecondcalc }} здоровья в секунду окружающим союзным чемпионам в течение {{ healduration }} сек.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Fiora_W a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Fiora_W" ;
    lol:description "В течение короткого времени Фиора парирует весь входящий урон и игнорирует эффекты контроля, а затем совершает атаку в выбранном направлении. Атака уменьшает скорость передвижения пораженного чемпиона или оглушает его, если Фиора отражает обездвиживающий эффект контроля."^^xsd:string ;
    lol:entityId "Fiora:W"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Fiora ;
    lol:name "Парирование"^^xsd:string ;
    lol:slot "W"^^xsd:string ;
    lol:tooltipText "Фиора парирует весь входящий урон, а также нейтрализующие и отрицательные эффекты в течение {{ parryduration }} сек., после чего совершает атаку. Атака наносит {{ stabdamage }} магического урона первому пораженному чемпиону, а также замедляет его на {{ msslowpercent*-100 }}% и уменьшает его скорость атаки на {{ attackslowpercent*-100 }}% на {{ ccduration }} сек. Если Фиора отражает обездвиживающий эффект, враг оглушается , а не замедляется .{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Fizz_E a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Fizz_E" ;
    lol:description "Физз подпрыгивает в воздух и грациозно приземляется на свой трезубец, становясь недосягаемым. Из этого положения Физз может либо спрыгнуть вниз и ударить по земле, либо прыгнуть снова, прежде чем обрушиться на землю."^^xsd:string ;
    lol:entityId "Fizz:E"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Fizz ;
    lol:name "Баловство / Обман"^^xsd:string ;
    lol:slot "E"^^xsd:string ;
    lol:tooltipText "Физз запрыгивает на свой трезубец, становясь недосягаемым на 0,75 сек., после чего наносит {{ edamage }} магического урона врагам поблизости и замедляет их на {{ slowamount*100 }}% на {{ slowduration }} сек. Во время недосягаемости Физз может повторно применить это умение, совершив еще один рывок и преждевременно прекратив действие эффекта. При этом он наносит урон в меньшей области и не замедляет .{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Fizz_P a owl:NamedIndividual,
        lol:PassiveAbility ;
    rdfs:label "Fizz_P" ;
    lol:description "Физз может проходить сквозь бойцов и уменьшает получаемый урон из всех источников на фиксированную величину"^^xsd:string ;
    lol:entityId "Fizz:P"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Fizz ;
    lol:name "Проворный боец"^^xsd:string ;
    lol:slot "P"^^xsd:string .

lol:Fizz_Q a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Fizz_Q" ;
    lol:description "Физз совершает рывок сквозь свою цель, нанося дополнительный магический урон и накладывая эффекты при попадании."^^xsd:string ;
    lol:entityId "Fizz:Q"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Fizz ;
    lol:name "Удар сорванца"^^xsd:string ;
    lol:slot "Q"^^xsd:string ;
    lol:tooltipText "Физз совершает рывок сквозь врага, нанося {{ totaldamage }} физического урона плюс {{ qdamage }} магического урона .{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Fizz_R a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Fizz_R" ;
    lol:description "Физз выпускает рыбку в выбранном направлении, которая прикрепляется к первому вражескому чемпиону, дотронувшемуся до нее, уменьшая его скорость передвижения. Через некоторое время из-под земли прорывается акула, которая подбрасывает цель в воздух и разбрасывает остальных врагов, находящихся рядом, нанося при этом всем пораженным магический урон и замедляя их."^^xsd:string ;
    lol:entityId "Fizz:R"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Fizz ;
    lol:name "Ловля на живца"^^xsd:string ;
    lol:slot "R"^^xsd:string ;
    lol:tooltipText "Физз бросает рыбку, которая цепляется за первого пораженного чемпиона. На жертву действует истинное видение , и она замедляется на 40-80% в зависимости от расстояния, которое пролетела рыбка. Через {{ detonationtime }} сек. в месте нахождения рыбки из-под земли прорывается акула, которая подбрасывает цель с рыбкой на 1 сек., отбрасывает всех остальных и наносит от {{ smallsharkdamage }} до {{ bigsharkdamage }} магического урона в зависимости от расстояния, которое пролетела рыбка.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Fizz_W a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Fizz_W" ;
    lol:description "Автоатаки Физза вызывают у врагов кровотечение, нанося магический урон в течение нескольких секунд. Физз может усилить свою следующую автоатаку, чтобы она нанесла дополнительный урон и усилила его последующие атаки на короткое время."^^xsd:string ;
    lol:entityId "Fizz:W"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Fizz ;
    lol:name "Морской трезубец"^^xsd:string ;
    lol:slot "W"^^xsd:string ;
    lol:tooltipText "Пассивно : автоатаки Физза вызывают у врагов кровотечение, которое наносит {{ dotdamage }} магического урона в течение {{ bleedduration }} сек. Активно : следующая автоатака Физза дополнительно наносит {{ activedamage }} магического урона . Если эта автоатака убивает цель, Физз восстанавливает {{ onkillmanarefund }} маны и сокращает время перезарядки этого умения на {{ onkillnewcooldown }} сек. Если цель не погибает, автоатаки Физза начинают дополнительно наносить {{ onhitbuffdamage }} магического урона в течение следующих {{ onhitbuffduration }} сек.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Galio_E a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Galio_E" ;
    lol:description "Галио делает шаг назад и совершает рывок вперед, подбрасывая в воздух первого вражеского чемпиона на своем пути."^^xsd:string ;
    lol:entityId "Galio:E"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Galio ;
    lol:name "Кулак правосудия"^^xsd:string ;
    lol:slot "E"^^xsd:string ;
    lol:tooltipText "Галио совершает рывок вперед, подбрасывая первого пораженного чемпиона на {{ knockupduration }} сек. и нанося ему {{ totaldamage }} магического урона . Остальные враги на пути получают {{ pvedamage }} магического урона . Галио останавливается при столкновении с элементом ландшафта.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Galio_P a owl:NamedIndividual,
        lol:PassiveAbility ;
    rdfs:label "Galio_P" ;
    lol:description "Каждые несколько секунд следующая автоатака Галио дополнительно наносит магический урон по площади."^^xsd:string ;
    lol:entityId "Galio:P"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Galio ;
    lol:name "Колоссальный удар"^^xsd:string ;
    lol:slot "P"^^xsd:string .

lol:Galio_Q a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Galio_Q" ;
    lol:description "Галио запускает два порыва ветра, и они объединяются в большой вихрь, который наносит периодический урон."^^xsd:string ;
    lol:entityId "Galio:Q"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Galio ;
    lol:name "Ветра войны"^^xsd:string ;
    lol:slot "Q"^^xsd:string ;
    lol:tooltipText "Галио выпускает два порыва ветра, каждый из которых наносит {{ qmissiledamage }} магического урона . Когда порывы соединяются, формируется вихрь, который наносит магический урон в размере {{ percentsuperqdamagett }}% от максимального запаса здоровья в течение {{ superqduration }} сек.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Galio_R a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Galio_R" ;
    lol:description "Галио выбирает местоположение союзного чемпиона в качестве точки приземления, накладывая на всех союзников в области действия щит от магического урона. После небольшой задержки Галио приземляется в выбранное место, подбрасывая в воздух находящихся поблизости врагов."^^xsd:string ;
    lol:entityId "Galio:R"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Galio ;
    lol:name "Появление героя"^^xsd:string ;
    lol:slot "R"^^xsd:string ;
    lol:tooltipText "Галио выбирает местоположение союзного чемпиона в качестве точки приземления, накладывая на всех союзных чемпионов в области действия щит пассивного эффекта Щита Дюрана на {{ temporarywshieldduration }} сек. После этого он приземляется в выбранном месте. Приземляясь, Галио подбрасывает врагов на {{ stundurationouter }} сек. и наносит им {{ totaldamage }} магического урона .{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Galio_W a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Galio_W" ;
    lol:description "Галио уменьшает свою скорость передвижения, подготавливая защитную стойку. После окончания подготовки Галио провоцирует всех ближайших врагов и наносит им урон."^^xsd:string ;
    lol:entityId "Galio:W"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Galio ;
    lol:name "Щит Дюрана"^^xsd:string ;
    lol:slot "W"^^xsd:string ;
    lol:tooltipText "Пассивно: если Галио не получает урон в течение {{ passiveshieldooctimer }} сек., он накладывает на себя магический щит прочностью {{ totalpassiveshield }} . Начало подготовки: Галио снижает получаемый магический урон на {{ magicdamagereduction }} и физический урон на {{ physicaldamagereduction }}, а также замедляет себя на {{ selfslowpercent }}%. Применение: Галио провоцирует вражеских чемпионов на {{ ccdurationmin }}–{{ ccdurationmax }} сек., наносит им {{ mintotaldamage }} –{{ maxtotaldamage }} ед. магического урона и продлевает снижение урона на {{ drlingerduration }} сек. Продолжительность, урон и радиус провокации зависят от времени подготовки.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Gangplank_E a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Gangplank_E" ;
    lol:description "Гангпланк откапывает в указанной точке спрятанную пороховую бочку. Если он атакует ее, та взрывается, нанося всем врагам вокруг урон, равный силе атаки Гангпланка, и замедляя их."^^xsd:string ;
    lol:entityId "Gangplank:E"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Gangplank ;
    lol:name "Пороховая бочка"^^xsd:string ;
    lol:slot "E"^^xsd:string ;
    lol:tooltipText "Гангпланк на {{ barrelduration }} сек. ставит пороховую бочку – ее могут атаковать вражеские чемпионы и он сам. Если бочку уничтожает враг, она исчезает. Если бочку уничтожает Гангпланк, она взрывается, замедляет врагов на {{ finalslowamount }}% на {{ debuffduration }} сек. и наносит им урон автоатаки , игнорируя {{ barrelarmorpenetration }}% брони. Чемпионы дополнительно получают {{ bonusdamagetochampions }} ед. физ. урона . Здоровье бочки снижается раз в {{ barreldecaytime }} сек. Если в области взрыва есть другие бочки, они тоже взрываются, но враг может получить урон лишь от 1 бочки за раз. Гангпланк может взрывать бочки с помощью умения Аррргумент , получая доп. золото при убийстве целей.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Gangplank_P a owl:NamedIndividual,
        lol:PassiveAbility ;
    rdfs:label "Gangplank_P" ;
    lol:description "Раз в несколько секунд при очередной автоатаке Гангпланк поджигает врагов."^^xsd:string ;
    lol:entityId "Gangplank:P"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Gangplank ;
    lol:name "Испытание огнем"^^xsd:string ;
    lol:slot "P"^^xsd:string .

lol:Gangplank_Q a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Gangplank_Q" ;
    lol:description "Гангпланк стреляет в цель. За каждого убитого в результате этого бойца Гангпланк получает золото."^^xsd:string ;
    lol:entityId "Gangplank:Q"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Gangplank ;
    lol:name "Аррргумент"^^xsd:string ;
    lol:slot "Q"^^xsd:string ;
    lol:tooltipText "{{Spell_GangplankQWrapper_Tooltip_{{ gamemodeinteger }}}}{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Gangplank_R a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Gangplank_R" ;
    lol:description "Гангпланк дает сигнал своему судну вести обстрел указанной области. Все противники в зоне обстрела замедляются и получают урон."^^xsd:string ;
    lol:entityId "Gangplank:R"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Gangplank ;
    lol:name "Пушечный обстрел"^^xsd:string ;
    lol:slot "R"^^xsd:string ;
    lol:tooltipText "Гангпланк дает сигнал своему судну на протяжении {{ zoneduration }} сек. вести обстрел любой выбранной области на карте, накрыв ее {{ totalwavestooltip }} волнами ядер. Каждая волна замедляет врагов на {{ slowpercent }}% на {{ slowduration }} сек. и наносит {{ onewavedamage }} магического урона . Максимальный урон: {{ totaldamagetooltip }}. Это умение можно улучшать в магазине с помощью умения Аррргумент . Стрельба по готовности : судно Гангпланка выпускает 6 дополнительных волн ядер. Дочь смерти : судно Гангпланка выпускает мегаядро, которое наносит {{ deathsdaughterdamage }} чистого урона и замедляет на {{ deathsdaughterslow }}% на {{ deathsdaughterslowduration }} сек. Боевой дух : скорость передвижения союзников в области обстрела увеличивается на {{ raisemoralehaste }}% на {{ raisemoralehasteduration }} сек.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Gangplank_W a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Gangplank_W" ;
    lol:description "Гангпланк ест цитрусовые, восстанавливая себе здоровье и снимая эффекты контроля."^^xsd:string ;
    lol:entityId "Gangplank:W"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Gangplank ;
    lol:name "Заедание цинги"^^xsd:string ;
    lol:slot "W"^^xsd:string ;
    lol:tooltipText "Гангпланк поглощает большое число цитрусовых, снимая с себя все нейтрализующие эффекты и восстанавливая {{ basehealth }} плюс {{ percentheal }}% от недост. здоровья .{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Garen_E a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Garen_E" ;
    lol:description "Гарен быстро вращается на месте с мечом в руках, нанося физический урон врагам поблизости."^^xsd:string ;
    lol:entityId "Garen:E"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Garen ;
    lol:name "Вердикт"^^xsd:string ;
    lol:slot "E"^^xsd:string ;
    lol:tooltipText "Гарен быстро вращает меч вокруг себя в течение {{ duration }} сек., нанося окружающим врагам {{ totaldamage }} ед. физического урона {{ f1 }} р. Ближайший враг получает на {{ nearestenemybonus*100 }}% больше урона . Чемпионы, пораженные хотя бы {{ stackstoshred }} ударами, теряют {{ shredamount*100 }}% брони на {{ shredduration }} сек. Повторное применение : действие этого умения прекращается преждевременно.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Garen_P a owl:NamedIndividual,
        lol:PassiveAbility ;
    rdfs:label "Garen_P" ;
    lol:description "Если Гарен не получает урона и не подвергается действию вражеских умений в течение некоторого времени, он начинает восстанавливать часть от своего общего запаса здоровья каждую секунду."^^xsd:string ;
    lol:entityId "Garen:P"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Garen ;
    lol:name "Упорство"^^xsd:string ;
    lol:slot "P"^^xsd:string .

lol:Garen_Q a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Garen_Q" ;
    lol:description "Гарен избавляется ото всех замедляющих эффектов, и его скорость передвижения увеличивается. Его следующая автоатака поражает слабое место цели, заставляя ее замолчать и нанося ей дополнительный урон."^^xsd:string ;
    lol:entityId "Garen:Q"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Garen ;
    lol:name "Решающий удар"^^xsd:string ;
    lol:slot "Q"^^xsd:string ;
    lol:tooltipText "Гарен снимает с себя все эффекты замедления и получает {{ movementspeedamount*100 }}% скорости передвижения на {{ movementspeedduration }} сек. Его следующая автоатака накладывает на цель безмолвие на {{ silenceduration }} сек. и наносит ей {{ totaldamage }} физического урона .{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Garen_R a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Garen_R" ;
    lol:description "Гарен призывает мощь Демасии, чтобы казнить вражеского чемпиона."^^xsd:string ;
    lol:entityId "Garen:R"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Garen ;
    lol:name "Правосудие Демасии"^^xsd:string ;
    lol:slot "R"^^xsd:string ;
    lol:tooltipText "Гарен призывает мощь Демасии, чтобы сразить вражеского чемпиона, нанося чистый урон в размере {{ basedamage }} плюс {{ executedamage*100 }}% от недостающего здоровья цели .{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Garen_W a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Garen_W" ;
    lol:description "Броня и сопротивление магии Гарена увеличиваются, когда он убивает врагов. При активации умения он получает щит и значительный бонус к стойкости на короткий период. В течение оставшегося времени действия Гарен получает немного меньше урона."^^xsd:string ;
    lol:entityId "Garen:W"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Garen ;
    lol:name "Храбрость"^^xsd:string ;
    lol:slot "W"^^xsd:string ;
    lol:tooltipText "Пассивно: Гарен имеет{{ resistsfortooltip }} дополнительной брони и {{ resistsfortooltip }} дополнительного сопротивления магии . Каждое убийство бойца навсегда дает защитные показатели в размере {{ resistgainonkilltooltip }} (максимальный бонус – {{ resistmax }} ). Активно: Гарен становится храбрее на {{ drduration }} сек., уменьшая получаемый урон на {{ drpercent*100 }}%. Кроме того, он получает щит прочностью {{ totalshield }} и {{ upfronttenacity*100 }}% стойкости на {{ upfrontduration }} сек.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Gnar_E a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Gnar_E" ;
    lol:description "Гнар прыгает в выбранном направлении, увеличивая свою скорость атаки. Если он приземляется на любого бойца, он совершает еще один прыжок в том же направлении. Если этот боец вражеский, Гнар наносит ему урон и замедляет его. Мега-Гнар слишком большой для второго прыжка - прыгнув один раз, он обрушивается на землю с ужасающей силой, нанося урон всем врагам вокруг."^^xsd:string ;
    lol:entityId "Gnar:E"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Gnar ;
    lol:name "Прыг / Хрясь"^^xsd:string ;
    lol:slot "E"^^xsd:string ;
    lol:tooltipText "Мини-Гнар: Гнар совершает прыжок, увеличивая свою скорость атаки на {{ spell.gnare:minibas*100 }}% на {{ spell.gnare:miniasduration }} сек. При приземлении на любого бойца Гнар совершает еще один прыжок в том же направлении. Если этот боец вражеский, Гнар наносит ему {{ spell.gnare:minitotaldamage }} физического урона и ненадолго замедляет на {{ spell.gnare:movespeedmod*-100 }}%.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Gnar_P a owl:NamedIndividual,
        lol:PassiveAbility ;
    rdfs:label "Gnar_P" ;
    lol:description "Гнар накапливает ярость в бою. Когда шкала ярости заполняется, следующее использованное умение превращает Гнара в Мега-Гнара, увеличивая его выживаемость и изменяя доступный ему набор умений."^^xsd:string ;
    lol:entityId "Gnar:P"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Gnar ;
    lol:name "Ген ярости"^^xsd:string ;
    lol:slot "P"^^xsd:string .

lol:Gnar_Q a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Gnar_Q" ;
    lol:description "Гнар бросает бумеранг, который наносит урон и замедляет врагов, прежде чем вернуться к Гнару. Если Гнар ловит бумеранг, время перезарядки сокращается. Мега-Гнар швыряет огромный валун, который летит, пока не столкнется с противником, нанося урон ему и всем врагам вокруг и уменьшив их скорость передвижения. Подбирание валуна сокращает время перезарядки."^^xsd:string ;
    lol:entityId "Gnar:Q"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Gnar ;
    lol:name "Бросок бумеранга / Бросок валуна"^^xsd:string ;
    lol:slot "Q"^^xsd:string ;
    lol:tooltipText "Мини-Гнар: Гнар бросает бумеранг, который наносит {{ spell.gnarq:minitotaldamage }} физического урона и замедляет на {{ spell.gnarq:slowamount*100 }}% на {{ spell.gnarq:slowduration }} сек. После поражения врага бумеранг возвращается, нанося меньше урона последующим целям. Бумеранг может поразить одну и ту же цель только один раз. Если Гнар ловит бумеранг, его перезарядка сокращается на {{ spell.gnarq:minicdrefund*100 }}%.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Gnar_R a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Gnar_R" ;
    lol:description "Гнар хватает всех врагов вокруг себя и бросает их в выбранном направлении, нанося им урон и замедляя их. Если враг врезается в препятствие, он не замедляется, а оглушается, а наносимый ему урон увеличивается."^^xsd:string ;
    lol:entityId "Gnar:R"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Gnar ;
    lol:name "ГНА-А-А-Р!"^^xsd:string ;
    lol:slot "R"^^xsd:string ;
    lol:tooltipText "Мини-Гнар - пассивно: дополнительная скорость передвижения от Торопыжки увеличена. Мега-Гнар: Гнар толкает врагов поблизости, нанося им {{ damage }} физического урона , а также отбрасывая и замедляя на {{ rslowpercent }}% на {{ rccduration }} сек. Если враги врезаются в стену, они вместо этого получают {{ walldamage }} физического урона и оглушаются .{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Gnar_W a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Gnar_W" ;
    lol:description "Автоатаки Гнара против одной и той же цели наносят дополнительный урон и увеличивают его скорость передвижения. Мега-Гнар слишком большой, чтобы быть Торопыжкой, вместо этого он становится на задние лапы и бьет кулаками по земле, нанося урон всем врагам перед собой и оглушая их на короткое время."^^xsd:string ;
    lol:entityId "Gnar:W"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Gnar ;
    lol:name "Торопыжка / Бум"^^xsd:string ;
    lol:slot "W"^^xsd:string ;
    lol:tooltipText "Мини-Гнар – пассивно: каждые третьи автоатака или умение против одного и того же врага дополнительно наносят магический урон в размере {{ spell.gnarw:minitotaldamage }} ед. плюс {{ spell.gnarw:minipercenthpdamage*100 }}% от максимального запаса здоровья . Гнар при этом увеличивает свою скорость передвижения на {{ spell.gnarr:rhypermovementspeedpercent }}% (уменьшается в течение {{ spell.gnarw:minihasteduration }} сек.).{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Gragas_E a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Gragas_E" ;
    lol:description "Грагас совершает рывок в указанную точку. Первый противник, с которым он сталкивается на своем пути, и все враги вокруг него получают урон и оглушаются."^^xsd:string ;
    lol:entityId "Gragas:E"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Gragas ;
    lol:name "Таран"^^xsd:string ;
    lol:slot "E"^^xsd:string ;
    lol:tooltipText "Грагас совершает рывок вперед, останавливаясь при столкновении с первым врагом на пути. При этом он подбрасывает врагов поблизости на {{ stunduration }} сек. и наносит им {{ totaldamage }} магического урона . При столкновении с врагом время перезарядки этого умения сокращается на {{ cooldownrefund*100 }}%.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Gragas_P a owl:NamedIndividual,
        lol:PassiveAbility ;
    rdfs:label "Gragas_P" ;
    lol:description "Грагас периодически лечится при использовании умений."^^xsd:string ;
    lol:entityId "Gragas:P"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Gragas ;
    lol:name "Пойло со скидкой"^^xsd:string ;
    lol:slot "P"^^xsd:string .

lol:Gragas_Q a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Gragas_Q" ;
    lol:description "Грагас катит бочку в указанную точку, а затем может взорвать ее, или же она сама взрывается по прошествии 4 секунд. Сила взрыва со временем увеличивается. Враги, пораженные взрывом, замедляются."^^xsd:string ;
    lol:entityId "Gragas:Q"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Gragas ;
    lol:name "Бочка"^^xsd:string ;
    lol:slot "Q"^^xsd:string ;
    lol:tooltipText "Грагас выпускает бочку, которая взрывается через {{ barrelmaxduration }} сек., нанося {{ mindamage }} –{{ maxdamage }} ед. маг. урона и замедляя врагов на {{ slowpercent }}–{{ slowpercent*1.5 }}% на {{ slowduration }} сек. Урон и замедление зависят от того, сколько пролежала бочка. Грагас может повторно применить это умение, чтобы взорвать бочку преждевременно.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Gragas_R a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Gragas_R" ;
    lol:description "Грагас бросает бочку в указанное место, нанося урон всем врагам в зоне поражения и отбрасывая их."^^xsd:string ;
    lol:entityId "Gragas:R"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Gragas ;
    lol:name "Взрывной бочонок"^^xsd:string ;
    lol:slot "R"^^xsd:string ;
    lol:tooltipText "Грагас бросает бочку, нанося {{ damagedone }} магического урона и отбрасывая врагов от точки ее приземления.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Gragas_W a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Gragas_W" ;
    lol:description "Грагас пробует свой новый напиток в течение 1 секунды, на некоторое время уменьшая получаемый урон. После этого он впадает в буйство, и его следующая автоатака наносит магический урон по площади."^^xsd:string ;
    lol:entityId "Gragas:W"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Gragas ;
    lol:name "Пьяный угар"^^xsd:string ;
    lol:slot "W"^^xsd:string ;
    lol:tooltipText "Грагас пробует свой напиток, уменьшая получаемый урон на {{ damagereduction }} на {{ defenseduration }} сек., а его следующая автоатака дополнительно наносит цели и окружающим врагам магический урон в размере {{ totaldamage }} ед. плюс {{ maxhppercentdamage }}% от максимального запаса здоровья .{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Graves_E a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Graves_E" ;
    lol:description "Грейвз совершает рывок вперед, и его броня и сопротивление магии увеличиваются на несколько секунд. Если Грейвз совершает рывок по направлению к вражескому чемпиону, он получает два заряда Настоящего мужества. Автоатаки сокращают время перезарядки умения и продлевают продолжительность действия защитного эффекта."^^xsd:string ;
    lol:entityId "Graves:E"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Graves ;
    lol:name "На изготовку"^^xsd:string ;
    lol:slot "E"^^xsd:string ;
    lol:tooltipText "Грейвз совершает рывок и заряжает дробовик одним патроном . Также он получает заряд на {{ buffduration }} сек. (максимум зарядов – {{ maxstacks }}) или 2 заряда, если рывок совершается в сторону вражеского чемпиона. Каждый заряд дает ему {{ armorperstack }} брони и {{ mrgrant }} сопротивления магии . Заряды обновляются, когда Грейвз наносит урон цели, не являющейся миньоном. Каждая попавшая в цель пуля от автоатак Грейвза сокращает перезарядку этого умения на {{ cooldownperhit }} сек.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Graves_P a owl:NamedIndividual,
        lol:PassiveAbility ;
    rdfs:label "Graves_P" ;
    lol:description "У дробовика Грейвза есть несколько уникальных свойств. Грейвз должен периодически его перезаряжать. При автоатаках дробовик выпускает 4 пули, которые не могут пробить цель насквозь. Нечемпионы, в которых попало несколько пуль, отбрасываются."^^xsd:string ;
    lol:entityId "Graves:P"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Graves ;
    lol:name "Новая Судьба"^^xsd:string ;
    lol:slot "P"^^xsd:string .

lol:Graves_Q a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Graves_Q" ;
    lol:description "Грейвз выпускает разрывной снаряд, который взрывается через 1 секунду или при столкновении с препятствием."^^xsd:string ;
    lol:entityId "Graves:Q"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Graves ;
    lol:name "Финита ля комедия"^^xsd:string ;
    lol:slot "Q"^^xsd:string ;
    lol:tooltipText "Грейвз выпускает снаряд, который наносит {{ totaldamage }} физического урона . Через 1 сек. или при столкновении с элементом ландшафта снаряд взрывается, нанося {{ totaldetonationdamage }} физического урона там, где он пролетел, и около взрыва.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Graves_R a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Graves_R" ;
    lol:description "Грейвз выпускает разрывной снаряд, который поражает первого вражеского чемпиона на своем пути, нанося ему большой урон. Кроме того, после попадания в чемпиона или при достижении предельной дальности полета снаряд взрывается, нанося урон всем врагам в секторе за точкой взрыва."^^xsd:string ;
    lol:entityId "Graves:R"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Graves ;
    lol:name "Сопутствующий ущерб"^^xsd:string ;
    lol:slot "R"^^xsd:string ;
    lol:tooltipText "Грейвз выпускает разрывной снаряд, при этом отдача от выстрела отбрасывает его назад. Снаряд наносит {{ damage }} физического урона первому пораженному врагу. После попадания в чемпиона или при достижении максимальной дальности снаряд взрывается в направлении полета, нанося {{ falloffdamage }} физического урона .{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Graves_W a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Graves_W" ;
    lol:description "Грейвз запускает дымовую шашку в указанную область, создавая там дымовую завесу, которая ограничивает обзор. Враги, пораженные первоначальным взрывом шашки, получают магический урон, а их скорость передвижения ненадолго уменьшается."^^xsd:string ;
    lol:entityId "Graves:W"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Graves ;
    lol:name "Дымовая завеса"^^xsd:string ;
    lol:slot "W"^^xsd:string ;
    lol:tooltipText "Грейвз на 4 сек. создает дымовую завесу, замедляющую врагов внутри на {{ slowamount }}%. Они не видят, что происходит снаружи. Первоначальный взрыв шашки наносит {{ impactdamage }} ед. маг. урона .{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Gwen_E a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Gwen_E" ;
    lol:description "Гвен совершает рывок на небольшое расстояние и усиливает свои автоатаки на несколько секунд: их дальность и скорость увеличиваются, и они наносят магический урон при попадании . Если она поражает врага в течение этого времени, перезарядка умения частично сокращается."^^xsd:string ;
    lol:entityId "Gwen:E"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Gwen ;
    lol:name "Свободный крой"^^xsd:string ;
    lol:slot "E"^^xsd:string ;
    lol:tooltipText "Гвен совершает рывок и усиливает свои автоатаки на {{ buffduration }} сек. Во время действия усиления скорость атаки Гвен увеличена на {{ bonusattackspeed }}, а дальность атак - на {{ bonusattackrange }}. Кроме того, они наносят {{ onhitdamage }} магического урона %i:OnHit% при попадании . Первая усиленная атака, поразившая врага, сокращает перезарядку этого умения на {{ cdrefund*100 }}%.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Gwen_P a owl:NamedIndividual,
        lol:PassiveAbility ;
    rdfs:label "Gwen_P" ;
    lol:description "Автоатаки Гвен наносят дополнительный магический урон в зависимости от запаса здоровья цели. Гвен восстанавливает себе здоровье в размере части урона, нанесенного чемпионам с помощью этого эффекта."^^xsd:string ;
    lol:entityId "Gwen:P"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Gwen ;
    lol:name "Тысяча порезов"^^xsd:string ;
    lol:slot "P"^^xsd:string .

lol:Gwen_Q a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Gwen_Q" ;
    lol:description "Гвен щелкает ножницами в конусе перед собой до 6 раз, нанося магический урон. Бойцы в центре области поражения получают чистый урон, и каждый разрез накладывает на них эффект пассивного умения."^^xsd:string ;
    lol:entityId "Gwen:Q"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Gwen ;
    lol:name "Чик-чик!"^^xsd:string ;
    lol:slot "Q"^^xsd:string ;
    lol:tooltipText "Пассивно : Гвен получает 1 заряд, когда поражает врага автоатакой (максимум зарядов - 4; заряды существуют {{ buffduration }} сек.). Активно : Гвен поглощает заряды и щелкает ножницами перед собой, нанося {{ miniswipedamage }} магического урона , после чего щелкает еще по одному разу за каждый поглощенный заряд. Затем она щелкает последний раз, нанося {{ finalswipedamage }} магического урона . {{ truedamageconversion*100 }}% от урона, получаемого врагами в центре области поражения, наносится в виде чистого урона . Также на эти цели накладывается эффект Тысячи порезов . Наносит {{ minionmod*100 }}% урона миньонам. Урон миньонам, у которых осталось менее {{ executethreshold*100 }}% здоровья, не уменьшается. Кроме того, они получают {{ executebonus }}% дополнительного урона. {{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Gwen_R a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Gwen_R" ;
    lol:description "Гвен выпускает перед собой иголку, которая замедляет врагов, наносит магический урон и накладывает на пораженных чемпионов эффект Тысячи порезов. Это умение можно применить еще два раза – при каждой повторной активации Гвен выпускает больше иголок и наносит увеличенный урон."^^xsd:string ;
    lol:entityId "Gwen:R"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Gwen ;
    lol:name "Вышивание"^^xsd:string ;
    lol:slot "R"^^xsd:string ;
    lol:tooltipText "Первое применение: Гвен выпускает перед собой иголку, которая наносит {{ totaldamage }} магического урона , замедляет на {{ initialslow*-100 }}% на {{ debuffduration }} сек. и накладывает эффект Тысячи порезов на всех пораженных врагов. Гвен может повторно применить это умение до 2 раз в течение 6 сек. (перезарядка между применениями - {{ lockouttime }} сек.). Второе применение: Гвен выпускает перед собой 3 иголки, которые наносят {{ totaldamage3 }} магического урона . Третье применение: Гвен выпускает перед собой 5 иголок, которые наносят {{ totaldamage5 }} магического урона .{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Gwen_W a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Gwen_W" ;
    lol:description "Гвен создает область из тумана, которая защищает ее от врагов извне. Выбрать ее целью могут лишь враги, которые находятся в тумане."^^xsd:string ;
    lol:entityId "Gwen:W"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Gwen ;
    lol:name "Священный туман"^^xsd:string ;
    lol:slot "W"^^xsd:string ;
    lol:tooltipText "Гвен создает вокруг себя область из священного тумана, становясь недосягаемой для всех врагов (кроме башен) извне на {{ zoneduration }} сек. или до тех пор, пока она не покинет область. Пока Гвен находится в тумане, ее броня и сопротивление магии увеличены на {{ totalresists }}. Гвен может один раз повторно применить это умение, призвав туман к себе. Кроме того, оно автоматически применяется повторно при первой попытке Гвен покинуть область.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Hecarim_E a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Hecarim_E" ;
    lol:description "Гекарим постепенно ускоряется и в течение некоторого времени может проходить сквозь бойцов. Его следующая автоатака отбрасывает цель и наносит ей дополнительный физический урон, зависящий от пройденного после активации умения расстояния."^^xsd:string ;
    lol:entityId "Hecarim:E"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Hecarim ;
    lol:name "Разрушительный рывок"^^xsd:string ;
    lol:slot "E"^^xsd:string ;
    lol:tooltipText "Гекарим получает призрачность и {{ minmovespeed*100 }}% скорости передвижения (растет до {{ maxmovespeed*100 }}% за {{ duration }} сек.). Следующая автоатака Гекарима отбрасывает цель, нанося ей {{ mindamage }} –{{ maxdamage }} ед. физ. урона . Дальность отбрасывания и урон зависят от расстояния, преодоленного в ходе действия этого умения.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Hecarim_P a owl:NamedIndividual,
        lol:PassiveAbility ;
    rdfs:label "Hecarim_P" ;
    lol:description "Сила атаки Гекарима увеличивается на долю от его дополнительной скорости передвижения."^^xsd:string ;
    lol:entityId "Hecarim:P"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Hecarim ;
    lol:name "Тропа войны"^^xsd:string ;
    lol:slot "P"^^xsd:string .

lol:Hecarim_Q a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Hecarim_Q" ;
    lol:description "Гекарим рассекает ближайших врагов, нанося физический урон. Если Гекарим наносит урон хотя бы одному врагу, он увеличивает урон и сокращает перезарядку последующих применений Буйства."^^xsd:string ;
    lol:entityId "Hecarim:Q"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Hecarim ;
    lol:name "Буйство"^^xsd:string ;
    lol:slot "Q"^^xsd:string ;
    lol:tooltipText "Гекарим рассекает ближайших врагов, нанося {{ damage }} ед. физ. урона . Поражая врага, Гекарим получает заряд, сокращающий перезарядку этого умения на {{ rampagecooldownreduction }} сек. и повышающий его урон на {{ rampagebonusdamageperc }}% на {{ buffduration }} сек. Макс. {{ maxstacks }} зар. {{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Hecarim_R a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Hecarim_R" ;
    lol:description "Гекарим призывает призрачных всадников и устремляется вперед, нанося магический урон всем повстречавшимся врагам. В конечной точке его пути возникает ударная волна, заставляющая окружающих противников бежать в ужасе."^^xsd:string ;
    lol:entityId "Hecarim:R"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Hecarim ;
    lol:name "Натиск теней"^^xsd:string ;
    lol:slot "R"^^xsd:string ;
    lol:tooltipText "Гекарим призывает призрачных всадников и устремляется вперед, нанося врагам {{ damagedone }} магического урона . В конечной точке пути Гекарима возникает ударная волна, которая пугает врагов на {{ feardurationmin }}-{{ feardurationmax }} сек. (продолжительность зависит от дальности рывка).{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Hecarim_W a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Hecarim_W" ;
    lol:description "Гекарим получает прибавку к броне и сопротивлению магии. Кроме того, он наносит магический урон окружающим врагам и восстанавливает себе здоровье в размере части от любого нанесенного этим врагам урона."^^xsd:string ;
    lol:entityId "Hecarim:W"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Hecarim ;
    lol:name "Аура ужаса"^^xsd:string ;
    lol:slot "W"^^xsd:string ;
    lol:tooltipText "Гекарим наносит врагам поблизости {{ totaldamage }} магического урона в течение {{ buffduration }} сек. Кроме того, он получает {{ resistamount }} брони и сопротивления магии , а также лечится на {{ leechamount }}% от урона , который эти враги получают от Гекарима, и на {{ allytooltipleachvalue }}% от урона , который они получают от его союзников.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Heimerdinger_E a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Heimerdinger_E" ;
    lol:description "Хеймердингер бросает гранату в указанную точку, нанося урон и замедляя всех противников в зоне поражения, а также оглушая врагов, оказавшихся в эпицентре взрыва."^^xsd:string ;
    lol:entityId "Heimerdinger:E"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Heimerdinger ;
    lol:name "Оглушающая граната CH-2"^^xsd:string ;
    lol:slot "E"^^xsd:string ;
    lol:tooltipText "Хеймердингер бросает гранату, которая наносит {{ damage }} магического урона врагам в области поражения и замедляет их на {{ slowpercent.0*100 }}% на {{ slowduration }} сек. Враги, оказавшиеся в эпицентре взрыва, вдобавок оглушаются на {{ stunduration }} сек. Если граната попадает в чемпиона, ближайшие турели полностью заряжаются.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Heimerdinger_P a owl:NamedIndividual,
        lol:PassiveAbility ;
    rdfs:label "Heimerdinger_P" ;
    lol:description "Увеличивает скорость передвижения при нахождении рядом с союзными башнями или турелями Хеймердингера."^^xsd:string ;
    lol:entityId "Heimerdinger:P"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Heimerdinger ;
    lol:name "Тяга к хекстеку"^^xsd:string ;
    lol:slot "P"^^xsd:string .

lol:Heimerdinger_Q a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Heimerdinger_Q" ;
    lol:description "Хеймердингер сооружает турель, оборудованную скорострельной пушкой и пронзающим цели лазером (турели наносят вдвое меньше урона башням)."^^xsd:string ;
    lol:entityId "Heimerdinger:Q"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Heimerdinger ;
    lol:name "Эволюционирующая турель H-28G"^^xsd:string ;
    lol:slot "Q"^^xsd:string ;
    lol:tooltipText "Хеймердингер создает турель , которая атакует врагов поблизости. Одновременно он может установить до {{ maxturrets }} турелей. Турели постепенно заряжаются. Полностью зарядившись, они применяют усиленную атаку. Если Хеймердингер отходит слишком далеко, его турели отключаются через 8 сек. У этого умения может быть до {{ maxkits }} зарядов.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Heimerdinger_R a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Heimerdinger_R" ;
    lol:description "Хеймердингер разрабатывает улучшение, и его следующее умение имеет усиленный эффект."^^xsd:string ;
    lol:entityId "Heimerdinger:R"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Heimerdinger ;
    lol:name "МОДЕРНИЗАЦИЯ!!!"^^xsd:string ;
    lol:slot "R"^^xsd:string ;
    lol:tooltipText "Хеймердингер улучшает свое следующее неабсолютное умение. Улучшенная турель H-28Q: Хеймердингер на 8 сек. устанавливает улучшенную турель , которая не учитывается в ограничении на максимальное количество турелей. Эта турель наносит {{ qultdamage }} магического урона за обычный выстрел и {{ qultdamagebeam }} магического урона за заряженный выстрел. Ее атаки наносят урон по площади и замедляют на 25% на 2 сек. Усиленные турели невосприимчивы к эффектам контроля. Рой хекстек-ракет: Хеймердингер выпускает 4 волны ракет, каждая из которых наносит {{ wultdamage }} магического урона . Чемпионы и лесные монстры, пораженные несколькими ракетами, получают меньше урона, а миньоны - больше. Максимальный урон: {{ wulttotaldamage }} . Шоковая граната CH-3X: Хеймердингер бросает отскакивающую гранату, которая трижды выпускает электрический заряд, нанося {{ eultdamage }} магического урона . Области действия оглушения и замедления увеличены. Повторное применение: это умение отменяется.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Heimerdinger_W a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Heimerdinger_W" ;
    lol:description "Хеймердингер выпускает дальнобойные ракеты, сходящиеся в точке курсора."^^xsd:string ;
    lol:entityId "Heimerdinger:W"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Heimerdinger ;
    lol:name "Хекстек-микроракеты"^^xsd:string ;
    lol:slot "W"^^xsd:string ;
    lol:tooltipText "Хеймердингер выпускает шквал из {{ rockets }} ракет, нанося {{ damage }} магического урона первому пораженному врагу. Дополнительные ракеты наносят меньше урона. Максимальный урон: {{ totaldamage }} . За каждую ракету, попавшую в чемпиона, уровень заряда турелей поблизости увеличивается на 20%.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Hwei_E a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Hwei_E" ;
    lol:description "Хвэй представляет себе мучения, получая возможность рисовать образы, которые контролируют врагов. Применив Мучение, Хвэй переключается на умения с эффектами контроля: Мрачный лик, Взор бездны и Челюсти смерти."^^xsd:string ;
    lol:entityId "Hwei:E"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Hwei ;
    lol:name "Тема: Мучение"^^xsd:string ;
    lol:slot "E"^^xsd:string ;
    lol:tooltipText "Хвэй рисует мучительные образы, которые накладывают на врагов эффекты контроля. Мрачный лик Хвэй посылает вперед изображение страшного лица, которое пугает первого врага на пути на {{ tooltip_eqfleeduration }} сек. и наносит ему {{ tooltip_eqdamage }} магического урона . Взор бездны Хвэй рисует глаз, который обеспечивает обзор. Когда в область действия заходит вражеский чемпион, в него выпускается самонаводящийся снаряд, который обездвиживает первого врага на пути на {{ tooltip_ewrootduration }} сек. и наносит ему {{ tooltip_ewdamage }} магического урона . Челюсти смерти Хвэй рисует челюсти, которые тянут пораженных врагов к центру. Челюсти наносят {{ tooltip_eedamage }} магического урона и замедляют жертв на {{ tooltip_eeslowamount }}% (замедление ослабевает в течение 1.25 сек.).{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Hwei_P a owl:NamedIndividual,
        lol:PassiveAbility ;
    rdfs:label "Hwei_P" ;
    lol:description "Хвэй помечает вражеских чемпионов, которым он наносит урон при помощи умений. Поразив врага другим умением, наносящим урон, Хвэй ставит под ним свою подпись. После небольшой задержки она взрывается, нанося магический урон всем врагам поблизости."^^xsd:string ;
    lol:entityId "Hwei:P"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Hwei ;
    lol:name "Подпись творца"^^xsd:string ;
    lol:slot "P"^^xsd:string .

lol:Hwei_Q a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Hwei_Q" ;
    lol:description "Хвэй представляет себе катастрофы, получая возможность рисовать образы, которые наносят урон врагам. Применив Катастрофу, Хвэй переключается на умения с уроном: Разрушительное пламя, Калечащий разряд и Извержение лавы."^^xsd:string ;
    lol:entityId "Hwei:Q"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Hwei ;
    lol:name "Тема: Катастрофа"^^xsd:string ;
    lol:slot "Q"^^xsd:string ;
    lol:tooltipText "Хвэй рисует катастрофические образы, которые наносят большой урон врагам. Разрушительное пламя Хвэй выпускает вперед огненный шар. При попадании во врага шар взрывается, нанося всем вокруг магический урон в размере {{ tooltip_qqdamage }} плюс {{ tooltip_qqbonusdamage }}% от максимального запаса здоровья . Калечащий разряд Хвэй рисует разрушительную молнию в выбранном месте на большом расстоянии. После задержки она бьет в землю, нанося врагам {{ tooltip_qwdamage }} магического урона . Изолированные или обездвиженные цели дополнительно получают до {{ tooltip_qwbonusdamage }} магического урона в зависимости от их недостающего здоровья. Извержение лавы Хвэй рисует серию вулканических извержений, после которых остаются лужи лавы. Каждое извержение наносит {{ tooltip_qedamage }} магического урона . Лужи лавы замедляют врагов на {{ spell.hweiqe:slowpercent }}% и наносят им {{ tooltip_qedamagepersecond }} магического урона в секунду в течение {{ spell.hweiqe:duration }} сек.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Hwei_R a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Hwei_R" ;
    lol:description "Хвэй рисует образ полного отчаяния. Первый пораженный вражеский чемпион становится центром картины, которая постепенно расширяется, замедляя врагов поблизости и нанося им урон. Когда чемпион погибает или картина достигает максимального размера, образ взрывается."^^xsd:string ;
    lol:entityId "Hwei:R"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Hwei ;
    lol:name "Растущее отчаяние"^^xsd:string ;
    lol:slot "R"^^xsd:string ;
    lol:tooltipText "Хвэй создает образ полного отчаяния, который на {{ duration }} сек. обволакивает вражеского чемпиона. Образ расширяется, каждые 0.25 сек. замедляя врагов на {{ slowpercentperstack }}% (замедление суммируется) и ежесекундно нанося им {{ damageovertime }} магического урона . Затем образ взрывается, нанося {{ damage }} магического урона .{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Hwei_W a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Hwei_W" ;
    lol:description "Хвэй представляет себе безмятежность, получая возможность рисовать образы, которые помогают ему и союзникам. Применив Безмятежность, Хвэй переключается на умения с полезными эффектами: Быстрое течение, Тихую заводь и Парящие огоньки."^^xsd:string ;
    lol:entityId "Hwei:W"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Hwei ;
    lol:name "Тема: Безмятежность"^^xsd:string ;
    lol:slot "W"^^xsd:string ;
    lol:tooltipText "Хвэй рисует безмятежные образы, которые наделяют полезными эффектами его самого и союзных чемпионов. Быстрое течение Хвэй создает стремительный водный поток, который дает {{ tooltip_wqmovespeed }} скорости передвижения всем союзникам. Тихая заводь Хвэй создает защитную заводь, которая накладывает на союзных чемпионов щиты прочностью {{ tooltip_wwshieldamount }} (постепенно увеличивается). Союзники получают щиты прочностью {{ spell.hweiww:tooltipallymod*100 }}% от обычной. Парящие огоньки Хвэй рисует вокруг себя три парящих огонька, которые усиливают три его умения или автоатаки. Они дополнительно наносят {{ tooltip_weonhitdamage }} магического урона и восстанавливают {{ tooltip_weonhitmanarestore }} маны .{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Illaoi_E a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Illaoi_E" ;
    lol:description "Иллаой вытягивает душу из вражеского чемпиона и притягивает ее к себе. Часть нанесенного душе урона получает сам чемпион. Если душа уничтожается или если лишенный души чемпион слишком далеко отходит от нее, он становится вместилищем и начинает порождать щупальца."^^xsd:string ;
    lol:entityId "Illaoi:E"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Illaoi ;
    lol:name "Испытание духа"^^xsd:string ;
    lol:slot "E"^^xsd:string ;
    lol:tooltipText "Иллаой вытягивает душу из вражеского чемпиона на {{ spiritduration }} сек. Иллаой и ее союзники могут наносить душе урон как чемпиону, при этом {{ echopercent }} от этого урона передается ее владельцу. Если душа уничтожается или ее владелец покидает область действия, он помечается на {{ vesselduration }} сек. и замедляется на {{ slowamount*100 }}% на {{ slowduration }} сек. Если это возможно, вокруг помеченных врагов появляются щупальца. Щупальца автоматически атакуют души и помеченных врагов каждые {{ timebetweenvesseltentacleslams }} сек.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Illaoi_P a owl:NamedIndividual,
        lol:PassiveAbility ;
    rdfs:label "Illaoi_P" ;
    lol:description "Иллаой и вместилища , которые она создает, порождают щупальца на ближайших стенах. Щупальца бьют души, вместилища и бойцов, которым Иллаой преподала Жестокий урок, нанося физический урон и восстанавливая здоровье Иллаой, если они поразили чемпиона."^^xsd:string ;
    lol:entityId "Illaoi:P"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Illaoi ;
    lol:name "Вестница древнего божества"^^xsd:string ;
    lol:slot "P"^^xsd:string .

lol:Illaoi_Q a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Illaoi_Q" ;
    lol:description "Увеличивает наносимый щупальцами урон. При активации умения Иллаой призывает щупальце, которое бьет в указанном направлении, нанося физический урон всем пораженным врагам."^^xsd:string ;
    lol:entityId "Illaoi:Q"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Illaoi ;
    lol:name "Удар щупальцем"^^xsd:string ;
    lol:slot "Q"^^xsd:string ;
    lol:tooltipText "Пассивно: атака щупалец дополнительно наносит {{ spell.illaoiq:tentacledamageamp*100 }}% урона (текущее увеличение: {{ spell.illaoiq:tentacledamagetotal }} ед. физического урона ). Активно: Иллаой взмахивает своим идолом, приказывая щупальцу атаковать в указанном направлении.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Illaoi_R a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Illaoi_R" ;
    lol:description "Иллаой прыгает в воздух и швыряет своего идола на землю, нанося физический урон всем окружающим врагам и призывая по щупальцу за каждого пораженного вражеского чемпиона."^^xsd:string ;
    lol:entityId "Illaoi:R"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Illaoi ;
    lol:name "Прыжок веры"^^xsd:string ;
    lol:slot "R"^^xsd:string ;
    lol:tooltipText "Иллаой прыгает в воздух и швыряет своего идола на землю, нанося {{ damagecalc }} ед. физического урона врагам поблизости и призывая по щупальцу за каждого пораженного вражеского чемпиона. В течение следующих {{ duration }} сек. щупальца атакуют на 50% быстрее. При этом они недосягаемы, а время перезарядки Жестокого урока составляет {{ spell.illaoiw:cooldownduringr }} сек.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Illaoi_W a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Illaoi_W" ;
    lol:description "При следующей автоатаке Иллаой совершает рывок вперед, нанося дополнительный физический урон, и приказывает всем ближайшим щупальцам атаковать цель."^^xsd:string ;
    lol:entityId "Illaoi:W"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Illaoi ;
    lol:name "Жестокий урок"^^xsd:string ;
    lol:slot "W"^^xsd:string ;
    lol:tooltipText "Во время следующей автоатаки Иллаой прыгает к своей цели, дополнительно нанося физический урон в размере {{ healthpercenttotal }} от максимального запаса здоровья . Когда Иллаой поражает цель, щупальца поблизости также атакуют ее.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Irelia_E a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Irelia_E" ;
    lol:description "Ирелия бросает два клинка, которые затем летят навстречу друг другу. Пораженные ими враги получают урон, оглушаются и помечаются."^^xsd:string ;
    lol:entityId "Irelia:E"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Irelia ;
    lol:name "Безупречный дуэт"^^xsd:string ;
    lol:slot "E"^^xsd:string ;
    lol:tooltipText "Ирелия бросает на землю клинок, после чего может повторно применить умение в течение {{ buffduration }} сек. Повторное применение: Ирелия бросает второй клинок, после чего оба клинка летят друг к другу навстречу, оглушая пораженных врагов на {{ stunduration }} сек. и нанося им {{ totaldamage }} магического урона . Чемпионы и большие лесные монстры ослабляются на {{ markduration }} сек.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Irelia_P a owl:NamedIndividual,
        lol:PassiveAbility ;
    rdfs:label "Irelia_P" ;
    lol:description "Когда Ирелия поражает врагов своими умениями, она получает суммирующуюся прибавку к скорости атаки. Набрав максимальное количество зарядов, она также начинает наносить дополнительный урон при попадании."^^xsd:string ;
    lol:entityId "Irelia:P"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Irelia ;
    lol:name "Ионийский пыл"^^xsd:string ;
    lol:slot "P"^^xsd:string .

lol:Irelia_Q a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Irelia_Q" ;
    lol:description "Ирелия совершает рывок к своей цели, восстанавливая здоровье. Если цель помечена или умирает от Пульсирующего клинка, перезарядка умения сбрасывается."^^xsd:string ;
    lol:entityId "Irelia:Q"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Irelia ;
    lol:name "Пульсирующий клинок"^^xsd:string ;
    lol:slot "Q"^^xsd:string ;
    lol:tooltipText "Ирелия совершает рывок к врагу, нанося ему {{ championdamage }} физического урона и восстанавливая себе {{ healamount }} здоровья . Если враг умирает или был ослаблен , перезарядка умения сбрасывается. Наносит {{ miniondamage }} урона миньонам.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Irelia_R a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Irelia_R" ;
    lol:description "Ирелия выпускает множество клинков, которые разлетаются в стороны при попадании во вражеского чемпиона. Враги, пораженные клинками, получают урон и помечаются. После этого клинки формируют стену, которая наносит урон прошедшим сквозь нее врагам, а также замедляет их."^^xsd:string ;
    lol:entityId "Irelia:R"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Irelia ;
    lol:name "Острие авангарда"^^xsd:string ;
    lol:slot "R"^^xsd:string ;
    lol:tooltipText "Ирелия выпускает град из клинков, нанося врагам {{ missiledamage }} магического урона и ослабляя чемпионов и больших лесных монстров на {{ markduration }} сек. При поражении первого чемпиона клинки разлетаются и принимают форму клетки на {{ zoneduration }} сек. Клетка наносит {{ zonedamage }} магического урона и замедляет на {{ slowamount }}% на {{ ccduration }} сек.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Irelia_W a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Irelia_W" ;
    lol:description "Ирелия готовится произвести удар, урон которого зависит от времени подготовки. Во время подготовки Ирелия получает меньше физического урона."^^xsd:string ;
    lol:entityId "Irelia:W"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Irelia ;
    lol:name "Дерзкий танец"^^xsd:string ;
    lol:slot "W"^^xsd:string ;
    lol:tooltipText "Начало подготовки: Ирелия встает в защитную стойку на время до {{ maxduration }} сек. - при этом она не может совершать действия, но уменьшает получаемый физический урон на {{ finalphysicaldr }}% и получаемый магический урон на {{ finalmagicdr }}%. Применение: Ирелия совершает удар своими клинками, нанося {{ mindamagecalc }} физического урона . Этот урон увеличивается на величину до {{ maxdamagecalc }} в зависимости от времени подготовки.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Ivern_E a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Ivern_E" ;
    lol:description "Иверн защищает союзника щитом, который взрывается через некоторое время, нанося урон и замедляя врагов. Если взрыв не задевает врагов, прочность щита восстанавливается."^^xsd:string ;
    lol:entityId "Ivern:E"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Ivern ;
    lol:name "Посадка семян"^^xsd:string ;
    lol:slot "E"^^xsd:string ;
    lol:tooltipText "Иверн накладывает на союзного чемпиона или Маргаритку щит прочностью {{ totalshield }} . Через {{ shieldduration }} сек. щит взрывается, нанося врагам {{ totaldamage }} магического урона и замедляя их на {{ slowamount*100 }}% на {{ slowduration }} сек. Если взрыв от Посадки семян не поражает вражеских чемпионов, а щит еще действует, союзник получает новый щит прочностью {{ totalshield }} на {{ shieldduration }} сек.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Ivern_P a owl:NamedIndividual,
        lol:PassiveAbility ;
    rdfs:label "Ivern_P" ;
    lol:description "Иверн не может атаковать никаких монстров, кроме эпических, и они тоже не станут нападать на него. Иверн способен окружать лагери монстров волшебными рощами, которые со временем разрастаются. Когда роща полностью созреет, Иверн может освободить монстров, получив за них опыт и золото."^^xsd:string ;
    lol:entityId "Ivern:P"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Ivern ;
    lol:name "Друг леса"^^xsd:string ;
    lol:slot "P"^^xsd:string .

lol:Ivern_Q a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Ivern_Q" ;
    lol:description "Иверн бросает цепкий корень, наносящий урон и обездвиживающий первую попавшуюся цель. Союзники Иверна могут совершить рывок к обездвиженной цели."^^xsd:string ;
    lol:entityId "Ivern:Q"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Ivern ;
    lol:name "Зов корней"^^xsd:string ;
    lol:slot "Q"^^xsd:string ;
    lol:tooltipText "Иверн выпускает цепкий корень, который наносит первому пораженному врагу {{ totaldamage }} магического урона и обездвиживает его на {{ rootduration }} сек. Союзники, которые атакуют обездвиженную цель, приближаются к ней на расстояние атаки. Повторное применение: Иверн совершает рывок к обездвиженному врагу. При поражении неэпических монстров перезарядка этого умения сокращается на 50%. {{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Ivern_R a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Ivern_R" ;
    lol:description "Иверн призывает стража по имени Маргаритка, которая помогает ему в бою. Применяйте умение повторно, чтобы отдавать Маргаритке новые команды."^^xsd:string ;
    lol:entityId "Ivern:R"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Ivern ;
    lol:name "Маргаритка!"^^xsd:string ;
    lol:slot "R"^^xsd:string ;
    lol:tooltipText "Иверн призывает стража по имени Маргаритка, которая помогает ему в бою в течение {{ daisyduration }} сек. Маргаритка, бей!: каждая 3-я атака Маргаритки подряд против одного и того же чемпиона либо эпического монстра запускает ударную волну, которая наносит всем пораженным врагам {{ totalshockwavedamage }} магического урона , а также подбрасывает их на {{ shockwaveccduration }} сек. Этот эффект срабатывает не чаще чем раз в {{ shockwavecd }} сек. Повторное применение: Иверн указывает Маргаритке, кого атаковать и куда перемещаться.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Ivern_W a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Ivern_W" ;
    lol:description "Когда Иверн и его союзники поблизости находятся в кустах, их автоатаки наносят дополнительный магический урон. Иверн может активировать это умение, чтобы создать куст."^^xsd:string ;
    lol:entityId "Ivern:W"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Ivern ;
    lol:name "Создатель кустов"^^xsd:string ;
    lol:slot "W"^^xsd:string ;
    lol:tooltipText "Пассивно: автоатаки Иверна дополнительно наносят {{ totaldamage }} магического урона , когда он находится в кустах, а также в течение {{ buffduration }} сек. после выхода из них. Союзники поблизости тоже получают этот эффект на {{ allybuffduration }} сек., но наносят {{ totalallydamage }} магического урона . Активно: Иверн выращивает куст и раскрывает область на {{ revealduration }} сек. Куст существует, пока команда Иверна не теряет его обзор, или до {{ maxbrushduration }} сек.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Janna_E a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Janna_E" ;
    lol:description "Жанна призывает бурю, которая защищает союзного чемпиона или башню от входящего урона, а также увеличивает их силу атаки."^^xsd:string ;
    lol:entityId "Janna:E"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Janna ;
    lol:name "Око бури"^^xsd:string ;
    lol:slot "E"^^xsd:string ;
    lol:tooltipText "Жанна накладывает на союзного чемпиона или башню щит прочностью {{ totalshield }} на {{ shieldduration }} сек. Пока наложен щит, сила атаки цели увеличена на {{ totalad }}. Когда Жанна ограничивает передвижение вражеских чемпионов при помощи умений, ее перезарядка сокращается на {{ ecdrefundforcc*100 }}%.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Janna_P a owl:NamedIndividual,
        lol:PassiveAbility ;
    rdfs:label "Janna_P" ;
    lol:description "Скорость передвижения союзников Жанны увеличивается при перемещении к ней. Жанна наносит дополнительный магический урон при попадании и при применении Западного ветра в зависимости от ее дополнительной скорости передвижения."^^xsd:string ;
    lol:entityId "Janna:P"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Janna ;
    lol:name "Попутный ветер"^^xsd:string ;
    lol:slot "P"^^xsd:string .

lol:Janna_Q a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Janna_Q" ;
    lol:description "Изменяя в данной точке атмосферное давление и температуру, Жанна создает маленький смерч, который быстро увеличивается в размере. Она может активировать умение повторно, чтобы запустить смерч. После этого смерч летит в заданном направлении, нанося урон и подбрасывая в воздух всех врагов на пути."^^xsd:string ;
    lol:entityId "Janna:Q"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Janna ;
    lol:name "Воющий вихрь"^^xsd:string ;
    lol:slot "Q"^^xsd:string ;
    lol:tooltipText "Жанна призывает торнадо, мощность которого растет в течение {{ maxduration }} сек. После подготовки торнадо летит в выбранном направлении. Торнадо наносит {{ minimumdamage }}-{{ maxdamage }} магического урона и подбрасывает цели на {{ baseknockup }}-{{ maxknockup }} сек. Дальность, урон и продолжительность подбрасывания торнадо зависят от времени подготовки. Жанна может повторно применить умение, чтобы запустить торнадо преждевременно.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Janna_R a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Janna_R" ;
    lol:description "Жанна окружает себя магическим штормом, разбрасывая противников. После окончания шторма появляется ласкающий ветер, который лечит находящихся рядом союзников, пока умение активно."^^xsd:string ;
    lol:entityId "Janna:R"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Janna ;
    lol:name "Муссон"^^xsd:string ;
    lol:slot "R"^^xsd:string ;
    lol:tooltipText "Жанна призывает магический муссон, отбрасывая окружающих врагов и восстанавливая окружающим союзникам {{ totalheal }} здоровья в течение {{ duration }} сек. Действие муссона прекращается, если Жанна сходит с места или применяет умение.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Janna_W a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Janna_W" ;
    lol:description "Жанна призывает элементаля воздуха, пассивно увеличивающего ее скорость передвижения и позволяющего ей проходить сквозь других бойцов. Умение можно активировать, чтобы нанести урон и замедлить врага."^^xsd:string ;
    lol:entityId "Janna:W"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Janna ;
    lol:name "Западный ветер"^^xsd:string ;
    lol:slot "W"^^xsd:string ;
    lol:tooltipText "Пассивно: скорость передвижения Жанны увеличена на {{ totalms }} , и на нее действует призрачность. Активно: Жанна поражает врага стихией, замедляя его на {{ totalslow }} на {{ slowduration }} сек. и нанося {{ totaldamage }} + {{ spell.tailwindself:bonusdamage }} магического урона .{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:JarvanIV_E a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "JarvanIV_E" ;
    lol:description "Джарван IV несет цвета Демасии, и его скорость атаки пассивно увеличена. При активации умения Джарван IV водружает флаг Демасии, нанося магический урон врагам. Водруженный флаг увеличивает скорость атаки всех союзных чемпионов неподалеку."^^xsd:string ;
    lol:entityId "JarvanIV:E"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_JarvanIV ;
    lol:name "Штандарт Демасии"^^xsd:string ;
    lol:slot "E"^^xsd:string ;
    lol:tooltipText "Пассивно: Джарван IV получает {{ permanentattackspeed*100 }}% скорости атаки . Активно: Джарван IV бросает свой штандарт, нанося {{ totaldamage }} ед. маг. урона и давая союзникам поблизости {{ baseauraas*100 }}% скорости атаки на {{ e4 }} сек.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:JarvanIV_P a owl:NamedIndividual,
        lol:PassiveAbility ;
    rdfs:label "JarvanIV_P" ;
    lol:description "При первой автоатаке Джарван IV наносит врагу дополнительный физический урон, который зависит от текущего здоровья цели. В отношении одной и той же цели этот эффект может возникать не чаще одного раза в несколько секунд."^^xsd:string ;
    lol:entityId "JarvanIV:P"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_JarvanIV ;
    lol:name "Поступь войны"^^xsd:string ;
    lol:slot "P"^^xsd:string .

lol:JarvanIV_Q a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "JarvanIV_Q" ;
    lol:description "Джарван IV делает выпад своим копьем, уменьшая броню всех противников, которых оно пронзит, и нанося им физический урон. Кроме того, Джарван подтягивается к Штандарту Демасии, по пути подбрасывая врагов в воздух."^^xsd:string ;
    lol:entityId "JarvanIV:Q"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_JarvanIV ;
    lol:name "Удар дракона"^^xsd:string ;
    lol:slot "Q"^^xsd:string ;
    lol:tooltipText "Джарван IV вытягивает свое копье, нанося врагам {{ totaldamage }} ед. физ. урона и снижая их броню на {{ basearshred*100 }}% на {{ e3 }} сек. Если копье попадает в Штандарт Демасии , Джарван IV притягивается к нему, подбрасывая всех на пути на 0,75 сек.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:JarvanIV_R a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "JarvanIV_R" ;
    lol:description "Джарван IV отважно бросается в бой, совершая прыжок к цели и обрушиваясь на землю с такой силой, что образуется кратер. Всем окружающим врагам при этом наносится физический урон."^^xsd:string ;
    lol:entityId "JarvanIV:R"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_JarvanIV ;
    lol:name "Катаклизм"^^xsd:string ;
    lol:slot "R"^^xsd:string ;
    lol:tooltipText "Джарван IV отважно прыгает к вражескому чемпиону, нанося ему и окружающим врагам {{ damagecalc }} физического урона , а также создавая вокруг кратер с непроходимым валом на {{ wallduration }} сек. Джарван IV может повторно применить это умение, чтобы разрушить вал.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:JarvanIV_W a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "JarvanIV_W" ;
    lol:description "Джарван IV взывает к древним королям Демасии, чтобы они защитили его от урона и замедлили ближайших противников."^^xsd:string ;
    lol:entityId "JarvanIV:W"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_JarvanIV ;
    lol:name "Золотая эгида"^^xsd:string ;
    lol:slot "W"^^xsd:string ;
    lol:tooltipText "Джарван IV призывает эгиду, замедляя врагов поблизости на {{ baseslowamount*100 }}% на {{ e5 }} сек. и накладывая на себя щит прочностью {{ totalshield }} . Прочность выше на {{ bonusshield }} за каждого пораженного вражеского чемпиона.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Jax_E a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Jax_E" ;
    lol:description "Искусность Джакса позволяет ему некоторое время уклоняться ото всех автоатак, а затем контратаковать, оглушая всех противников вокруг себя."^^xsd:string ;
    lol:entityId "Jax:E"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Jax ;
    lol:name "Встречный удар"^^xsd:string ;
    lol:slot "E"^^xsd:string ;
    lol:tooltipText "Джакс принимает защитную стойку на срок до {{ dodgeduration }} сек., уклоняясь от всех автоатак и получая на {{ aoedamagereduction }}% меньше урона от умений, действующих по площади. Через {{ dodgeduration }} сек. или при повторном применении Джакс наносит врагам поблизости магический урон в размере {{ totaldamage }} + {{ percenthealthdamage }}% от максимального запаса здоровья и оглушает их на {{ stunduration }} сек. Умение наносит на {{ percentincreasedperdodge*100 }}% больше урона за каждую автоатаку, от которой уклонился Джакс (максимальная прибавка – {{ maxdamage }} + {{ maxpercenthealthdamage }}% от максимального запаса здоровья ).{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Jax_P a owl:NamedIndividual,
        lol:PassiveAbility ;
    rdfs:label "Jax_P" ;
    lol:description "Последовательные автоатаки Джакса увеличивают его скорость атаки."^^xsd:string ;
    lol:entityId "Jax:P"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Jax ;
    lol:name "Град ударов"^^xsd:string ;
    lol:slot "P"^^xsd:string .

lol:Jax_Q a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Jax_Q" ;
    lol:description "Джакс прыгает к цели. Если это враг, Джакс наносит удар."^^xsd:string ;
    lol:entityId "Jax:Q"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Jax ;
    lol:name "Удар в прыжке"^^xsd:string ;
    lol:slot "Q"^^xsd:string ;
    lol:tooltipText "Джакс прыгает к союзному или вражескому бойцу либо тотему, нанося {{ totaldamage }} физического урона , если это враг.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Jax_R a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Jax_R" ;
    lol:description "Каждая третья последовательная автоатака Джакса наносит дополнительный магический урон. Кроме того, Джакс может активировать это умение. При этом он наносит урон окружающим врагам и ненадолго увеличивает свои сопротивление магии и броню."^^xsd:string ;
    lol:entityId "Jax:R"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Jax ;
    lol:name "Мастер оружия"^^xsd:string ;
    lol:slot "R"^^xsd:string ;
    lol:tooltipText "Пассивно: каждая третья автоатака Джакса в пределах {{ passivefallofftime }} сек. дополнительно наносит {{ onhitdamage }} магического урона . Активно: Джакс бьет фонарем, нанося {{ swingdamagetotal }} магического урона врагам поблизости. Поразив чемпиона, он получает {{ basearmor }} брони и {{ basemr }} сопротивления магии . Прибавки увеличиваются на {{ bonusarmor }} и {{ bonusmr }} за каждого пораженного чемпиона (время действия – {{ duration }} сек.). В течение этого времени Джакс наносит дополнительный магический урон каждую вторую автоатаку, а не каждую третью.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Jax_W a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Jax_W" ;
    lol:description "Джакс заряжает свое оружие энергией, в результате чего его следующая автоатака наносит дополнительный урон."^^xsd:string ;
    lol:entityId "Jax:W"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Jax ;
    lol:name "Усиление"^^xsd:string ;
    lol:slot "W"^^xsd:string ;
    lol:tooltipText "Джакс заряжает свое оружие энергией, из-за чего его следующая автоатака или Удар в прыжке дополнительно наносят {{ totaldamage }} магического урона .{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Jayce_E a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Jayce_E" ;
    lol:description "Стойка с молотом: Джейс наносит врагу магический урон и отбрасывает его назад на небольшое расстояние. Стойка с пушкой: Джейс устанавливает Врата ускорения, которые увеличивают скорость передвижения всех союзных чемпионов, проходящих через них. Если Шоковый заряд пролетает сквозь врата, его скорость, дальность поражения и урон увеличиваются."^^xsd:string ;
    lol:entityId "Jayce:E"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Jayce ;
    lol:name "Грохочущий удар / Врата ускорения"^^xsd:string ;
    lol:slot "E"^^xsd:string ;
    lol:tooltipText "Стойка с молотом : Джейс бьет своим молотом, отбрасывая цель и нанося магический урон в размере {{ spell.jaycethunderingblow:flatdamage }} плюс {{ spell.jaycethunderingblow:perchpdamage*100 }}% от максимального запаса здоровья .{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Jayce_P a owl:NamedIndividual,
        lol:PassiveAbility ;
    rdfs:label "Jayce_P" ;
    lol:description "Когда Джейс меняет оружие, его скорость передвижения ненадолго увеличивается."^^xsd:string ;
    lol:entityId "Jayce:P"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Jayce ;
    lol:name "Хекстек-конденсатор"^^xsd:string ;
    lol:slot "P"^^xsd:string .

lol:Jayce_Q a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Jayce_Q" ;
    lol:description "Стойка с молотом: Прыгает на врага, нанося физический урон и замедляя врагов. Стойка с пушкой: Выпускает электрический шар, взрывающийся при ударе о противника (или в конце своей дистанции), который наносит физический урон всем пораженным врагам."^^xsd:string ;
    lol:entityId "Jayce:Q"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Jayce ;
    lol:name "В небо! / Шоковый заряд"^^xsd:string ;
    lol:slot "Q"^^xsd:string ;
    lol:tooltipText "Ртутный молот: Джейс прыгает на врага, нанося {{ spell.jaycetotheskies:damage }} физического урона окружающим врагам и замедляя их на {{ spell.jaycetotheskies:slow*-100 }}% на {{ spell.jaycetotheskies:slowduration }} сек.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Jayce_R a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Jayce_R" ;
    lol:description "Стойка с молотом: Джейс трансформирует Ртутный молот в Ртутную пушку, приобретая новые умения и возможность атаковать на расстоянии. Первая автоатака в новой стойке уменьшает броню и сопротивление магии цели. Стойка с пушкой: Джейс трансформирует Ртутную пушку в Ртутный молот, приобретая новые умения и увеличивая броню и сопротивление магии. Первая автоатака в новой стойке наносит дополнительный магический урон."^^xsd:string ;
    lol:entityId "Jayce:R"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Jayce ;
    lol:name "Ртутная пушка / Ртутный молот"^^xsd:string ;
    lol:slot "R"^^xsd:string ;
    lol:tooltipText "Ртутный молот : Джейс превращает свое оружие в Ртутную пушку , становится чемпионом дальнего боя и получает новые умения. Следующая автоатака Джейса уменьшает броню и сопротивление магии цели на {{ spell.jaycestancehtg:rangedformshred }} на {{ spell.jaycestancehtg:shredduration }} сек.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Jayce_W a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Jayce_W" ;
    lol:description "Стойка с молотом: Джейс восстанавливает себе ману при каждой автоатаке. При активации умения Джейс создает электрическое поле, нанося урон окружающим врагам в течение нескольких секунд. Стойка с пушкой: Джейс заряжает себя энергией, увеличивая скорость атаки до максимума на несколько автоатак."^^xsd:string ;
    lol:entityId "Jayce:W"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Jayce ;
    lol:name "Электрическое поле / Гиперзаряд"^^xsd:string ;
    lol:slot "W"^^xsd:string ;
    lol:tooltipText "Ртутный молот - пассивно: автоатаки Джейса с помощью молота восстанавливают ему {{ spell.jaycestaticfield:managain }} маны . Ртутный молот - активно: Джейс создает вокруг себя электрическую ауру, которая наносит {{ spell.jaycestaticfield:damage }} магического урона в течение {{ spell.jaycestaticfield:duration }} сек.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Jhin_E a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Jhin_E" ;
    lol:description "Джин устанавливает невидимую ловушку-лотос, которая срабатывает, если на нее наступить. При этом она раскрывает и замедляет всех окружающих вражеских бойцов, а затем через некоторое время взрывается вихрем зазубренных лепестков, нанося урон. Красота в смерти: когда Джин убивает вражеского чемпиона, он устанавливает рядом с его телом ловушку, которая тут же срабатывает."^^xsd:string ;
    lol:entityId "Jhin:E"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Jhin ;
    lol:name "Закрытый показ"^^xsd:string ;
    lol:slot "E"^^xsd:string ;
    lol:tooltipText "Пассивно: на месте убитых Джином чемпионов появляются и взрываются ловушки-лотосы. Активно: Джин устанавливает невидимую ловушку-лотос на {{ trapduration }} мин. Когда враг наступает на нее, вокруг образуется область, которая замедляет противников на {{ trapslowamount*100 }}%. Через {{ trapdetonationtime }} сек. ловушка взрывается, нанося {{ totaldamage }} магического урона . У этого умения может быть 2 заряда (новый заряд дается раз в {{ ammorechargeratetooltip }} сек.).{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Jhin_P a owl:NamedIndividual,
        lol:PassiveAbility ;
    rdfs:label "Jhin_P" ;
    lol:description "Шепот, ружье Джина, - сложный механизм, созданный для нанесения большого урона. Он вмещает всего четыре патрона, и скорость стрельбы из него постоянна. Джин наполняет последний патрон темной магической энергией, поэтому четвертый выстрел всегда критический и наносит дополнительный урон. После каждого критического выстрела скорость передвижения Джина ненадолго увеличивается."^^xsd:string ;
    lol:entityId "Jhin:P"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Jhin ;
    lol:name "Шепот"^^xsd:string ;
    lol:slot "P"^^xsd:string .

lol:Jhin_Q a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Jhin_Q" ;
    lol:description "Джин бросает шашку в выбранного врага неподалеку. После поражения первой цели шашка до трех раз отскакивает в других находящихся рядом врагов. Если шашка убивает врага, она наносит дополнительный урон последующим целям."^^xsd:string ;
    lol:entityId "Jhin:Q"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Jhin ;
    lol:name "Танцующая граната"^^xsd:string ;
    lol:slot "Q"^^xsd:string ;
    lol:tooltipText "Джин бросает шашку, которая наносит {{ totaldamage }} физического урона , а затем отскакивает в другого еще не пораженного врага неподалеку. Шашка может поразить до {{ tooltipmaxtargetshit }} целей. Если враг умирает вскоре после поражения шашкой, урон последующим целям увеличивается на {{ percentamponkill*100 }}%.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Jhin_R a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Jhin_R" ;
    lol:description "Джин подготавливает свое оружие, а затем может выпустить четыре пули в выбранном секторе, каждая из которых летит, пока не поразит вражеского чемпиона, замедлив его и нанеся большой урон. Последний выстрел Выхода на поклон совершенен: он всегда критический и наносит гораздо больший урон."^^xsd:string ;
    lol:entityId "Jhin:R"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Jhin ;
    lol:name "Выход на поклон"^^xsd:string ;
    lol:slot "R"^^xsd:string ;
    lol:tooltipText "Джин занимает позицию, после чего может совершить 4 мощных выстрела, каждый из которых наносит от {{ damagecalc }} до {{ maxincreasecalc }} физического урона первому чемпиону на пути в зависимости от его недостающего здоровья и замедляет его на {{ slowpercent*100 }}% на {{ slowduration }} сек. Четвертый выстрел всегда критический и наносит {{ fourthshotmultiplier*100 }}% урона.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Jhin_W a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Jhin_W" ;
    lol:description "Джин стреляет в выбранном направлении на большое расстояние, нанося урон всем вражеским миньонам и первому вражескому чемпиону на пути полета пули. Если противник недавно получал урон от союзников Джина, ловушек-лотосов или самого Джина, он ненадолго обездвиживается."^^xsd:string ;
    lol:entityId "Jhin:W"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Jhin ;
    lol:name "Смертельное действо"^^xsd:string ;
    lol:slot "W"^^xsd:string ;
    lol:tooltipText "Джин стреляет на большое расстояние, нанося {{ totaldamage }} физического урона первому чемпиону на пути, а также остальным врагам до него. Если это умение поражает чемпиона, который получил урон от союзника Джина за последние {{ spottingduration }} сек., цель обездвиживается на {{ rootduration }} сек., а Джин получает ускорение Шепота .{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Jinx_E a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Jinx_E" ;
    lol:description "Джинкс бросает линию из гранат-ловушек. Гранаты взрываются через 5 секунд, поджигая врагов. Если над гранатой проходит вражеский чемпион, граната кусает и обездвиживает его."^^xsd:string ;
    lol:entityId "Jinx:E"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Jinx ;
    lol:name "Огненные кусаки!"^^xsd:string ;
    lol:slot "E"^^xsd:string ;
    lol:tooltipText "Джинкс бросает 3 гранаты-кусаки, которые существуют {{ grenadeduration }} сек. Гранаты взрываются при контакте с вражескими чемпионами, обездвиживая их на {{ rootduration }} сек. и нанося окружающим врагам {{ totaldamage }} магического урона .{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Jinx_P a owl:NamedIndividual,
        lol:PassiveAbility ;
    rdfs:label "Jinx_P" ;
    lol:description "Скорость передвижения и скорость атаки Джинкс сильно увеличиваются, когда она помогает уничтожить строение либо убить вражеского чемпиона или эпического лесного монстра."^^xsd:string ;
    lol:entityId "Jinx:P"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Jinx ;
    lol:name "Бодрячком!"^^xsd:string ;
    lol:slot "P"^^xsd:string .

lol:Jinx_Q a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Jinx_Q" ;
    lol:description "Джинкс меняет свое основное оружие, выбирая либо пулемет Пыщ-Пыщ, либо ракетницу Скелетницу. Автоатаки пулеметом Пыщ-Пыщ увеличивают ее скорость атаки, а ракетница Скелетница наносит урон по площади на большом расстоянии, но расходует ману и медленнее стреляет."^^xsd:string ;
    lol:entityId "Jinx:Q"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Jinx ;
    lol:name "Кручу-верчу!"^^xsd:string ;
    lol:slot "Q"^^xsd:string ;
    lol:tooltipText "Джинкс переключается между ракетницей Скелетницей и пулеметом Пыщ-Пыщ. При использовании ракетницы автоатаки Джинкс расходуют ману, дальность автоатак увеличивается на {{ rocketbonusrange }}, и они наносят {{ rocketdamage }} ед. физического урона цели и врагам рядом с ней, однако дополнительная скорость атаки уменьшается на {{ rocketaspdpenalty*100 }}%. При использовании пулемета автоатаки Джинкс увеличивают ее скорость атаки на {{ minigunattackspeedduration }} сек. Этот эффект может суммироваться до {{ minigunattackspeedstacks }} раз (вплоть до {{ minigunattackspeedmax }}% %i:scaleAS% ).{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Jinx_R a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Jinx_R" ;
    lol:description "Джинкс выпускает супер-мега-ракету, которая летит через всю карту. Урон, который она нанесет, увеличивается за время ее полета. Ракета взрывается при столкновении с вражеским чемпионом, нанося урон ему и окружающим врагам, тем больший, чем больше здоровья у них недостает."^^xsd:string ;
    lol:entityId "Jinx:R"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Jinx ;
    lol:name "Супер-мега-ракета смерти!"^^xsd:string ;
    lol:slot "R"^^xsd:string ;
    lol:tooltipText "Джинкс выпускает ракету, которая взрывается при столкновении с вражеским чемпионом, нанося ему физический урон в размере {{ damagefloor }}-{{ damagemax }} плюс {{ percentdamage }}% от недостающего здоровья . Урон ракеты увеличивается на протяжении первой секунды полета. Окружающие враги получают {{ aoedamagemult*100 }}% урона. Максимальный урон от недостающего здоровья против монстров - {{ monsterexecutemax }}. {{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Jinx_W a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Jinx_W" ;
    lol:description "Джинкс стреляет из своего пистолета-шокера Чпокера. Заряд поражает первого врага на своем пути, раскрывая его, замедляя и нанося ему урон."^^xsd:string ;
    lol:entityId "Jinx:W"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Jinx ;
    lol:name "Пиу-пиу!"^^xsd:string ;
    lol:slot "W"^^xsd:string ;
    lol:tooltipText "Джинкс стреляет шоковым зарядом, который наносит {{ totaldamage }} физического урона первому пораженному врагу, замедляет его на {{ slowpercent }}% и раскрывает на {{ slowduration }} сек.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:KSante_E a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "KSante_E" ;
    lol:description "К'Санте совершает рывок и получает щит. Если рывок совершается к союзнику, его дальность увеличивается, а союзник тоже получает щит. Высвобождение: у умения сокращается перезарядка, а скорость рывка становится выше."^^xsd:string ;
    lol:entityId "KSante:E"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_KSante ;
    lol:name "Удаль"^^xsd:string ;
    lol:slot "E"^^xsd:string ;
    lol:tooltipText "К'Санте совершает рывок, получая щит прочностью {{ totalshield }} на {{ shieldduration }} сек. Если рывок совершается к союзнику, его дальность значительно увеличивается, а союзник тоже получает щит . Высвобождение : перезарядка умения сокращается на {{ cooldownmodao*100 }}%, а скорость рывка становится выше.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:KSante_P a owl:NamedIndividual,
        lol:PassiveAbility ;
    rdfs:label "KSante_P" ;
    lol:description "Умения К'Санте помечают цели, увеличивая урон от его следующей автоатаки. Высвобождение: все автоатаки и умения К'Санте наносят больше урона."^^xsd:string ;
    lol:entityId "KSante:P"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_KSante ;
    lol:name "Бесстрашие"^^xsd:string ;
    lol:slot "P"^^xsd:string .

lol:KSante_Q a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "KSante_Q" ;
    lol:description "К'Санте совершает удар, нанося урон врагам перед собой и замедляя их. Поразив цель, К'Санте получает заряд Ударов нтофо. Когда накапливается 2 заряда, он выпускает ударную волну, которая притягивает врагов. Высвобождение: у умения сокращается перезарядка."^^xsd:string ;
    lol:entityId "KSante:Q"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_KSante ;
    lol:name "Удары нтофо"^^xsd:string ;
    lol:slot "Q"^^xsd:string ;
    lol:tooltipText "К'Санте бьет своим оружием, нанося врагам {{ basedamage }} физического урона и замедляя их на {{ slowpercent*100 }}% на {{ slowduration }} сек. Поразив цель, К'Санте получает заряд Ударов нтофо на {{ recastwindow }} сек. Когда накапливается 2 заряда, он выпускает ударную волну, которая притягивает врагов и оглушает их на {{ stunduration }} сек. Высвобождение : перезарядка умения сокращается на {{ rcooldownreduction.0*100 }}%.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:KSante_R a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "KSante_R" ;
    lol:description "К'Санте отбрасывает врага. Если на его пути есть стена, он перелетает через нее. Затем К'Санте высвобождает клинки и совершает рывок к цели, увеличивая свой урон, усиливая лечение и меняя умения. При этом он теряет часть защитных показателей."^^xsd:string ;
    lol:entityId "KSante:R"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_KSante ;
    lol:name "Высвобождение"^^xsd:string ;
    lol:slot "R"^^xsd:string ;
    lol:tooltipText "К'Санте разбивает свои нтофо и отбрасывает вражеского чемпиона, нанося ему {{ basedamage }} физического урона . Затем К'Санте совершает рывок за него и высвобождает оружие на {{ alloutduration }} сек. Если враг попадает в стену, он перелетает через нее, а К'Санте бьет его снова, нанося {{ totaldamageslamdown }} физического урона . Пока действует Высвобождение , К'Санте может применять усиленные версии своих умений. Кроме того, он получает {{ attackspeed*100 }}% скорости атаки , {{ armorpenpercent*100 }}% дополнительного пробивания брони и {{ omnivamp*100 }}% всестороннего вытягивания жизни , но теряет {{ healthlost*100 }}% от максимального запаса здоровья , {{ defenseslost*100 }}% от дополнительной брони и {{ defenseslost*100 }}% от дополнительного сопротивления магии .{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:KSante_W a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "KSante_W" ;
    lol:description "К'Санте укрывается оружием и начинает получать меньше урона. После этого он совершает рывок, отбрасывая и оглушая врагов. Высвобождение: К'Санте наносит больше урона, но не отбрасывает и не оглушает врагов."^^xsd:string ;
    lol:entityId "KSante:W"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_KSante ;
    lol:name "Напролом"^^xsd:string ;
    lol:slot "W"^^xsd:string ;
    lol:tooltipText "К'Санте укрывается своим оружием на {{ mindurationtooltip }}-{{ maxduration.1 }} сек., становясь неудержимым и получая на {{ damagereduction*100 }}% меньше урона. После этого он совершает рывок вперед, нанося пораженным врагам физический урон в размере {{ basedamage }} + {{ totalmaxhealthdamage }} от максимального запаса здоровья , а также отбрасывая их и оглушая на {{ minknockbackduration }}-{{ maxknockbackduration }} сек. (в зависимости от времени подготовки). Высвобождение : у умения сбрасывается перезарядка. К'Санте дополнительно наносит {{ rdamageincreasemin*100 }}-{{ rdamageincreasemax*100 }}% чистого урона (в зависимости от времени подготовки), а уменьшение урона увеличивается до {{ rdamagereduction*100 }}%. Также увеличивается скорость рывка, но умение больше не отбрасывает и не оглушает врагов.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Kaisa_E a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Kaisa_E" ;
    lol:description "Кай'Са ненадолго увеличивает скорость передвижения, а затем - скорость атаки. Живое оружие: Сверхзаряд улучшен и ненадолго дает невидимость."^^xsd:string ;
    lol:entityId "Kaisa:E"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Kaisa ;
    lol:name "Сверхзаряд"^^xsd:string ;
    lol:slot "E"^^xsd:string ;
    lol:tooltipText "Кай'Са заряжается энергией Бездны, ненадолго увеличивая свою скорость передвижения на {{ totalmovespeed }} и получая призрачность. После этого она увеличивает свою скорость атаки на {{ e5 }}% на {{ e2 }} сек. Автоатаки сокращают перезарядку этого умения на {{ e4 }} сек. Развитие : Кай'Са также становится невидимой на {{ e7 }} сек. Прогресс: {{ f10.1 }}%/{{ e6 }}% дополнительной скорости атаки {{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Kaisa_P a owl:NamedIndividual,
        lol:PassiveAbility ;
    rdfs:label "Kaisa_P" ;
    lol:description "Автоатаки Кай'Сы накладывают заряды плазмы, нанося дополнительный магический урон. Обездвиживающие эффекты союзников также накладывают заряды плазмы. Кроме того, при покупке предметов Кай'Са развивает свои базовые умения, и у них появляются дополнительные эффекты."^^xsd:string ;
    lol:entityId "Kaisa:P"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Kaisa ;
    lol:name "Вторая кожа"^^xsd:string ;
    lol:slot "P"^^xsd:string .

lol:Kaisa_Q a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Kaisa_Q" ;
    lol:description "Кай'Са выпускает множество снарядов, которые летят к ближайшим целям. Живое оружие: Дождь Икатии улучшен и выпускает больше зарядов."^^xsd:string ;
    lol:entityId "Kaisa:Q"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Kaisa ;
    lol:name "Дождь Икатии"^^xsd:string ;
    lol:slot "Q"^^xsd:string ;
    lol:tooltipText "Кай'Са выпускает снаряды ({{ e2 }}), которые летят в ближайших врагов. Каждый снаряд наносит {{ totalindividualmissiledamage }} ед. физического урона (максимум: {{ maxdamagedisplay }}). Все последующие попадания по чемпионам или монстрам после первого наносят {{ extrahitreduction*100 }}% урона. Развитие : количество снарядов увеличивается до {{ e7 }}. Прогресс: {{ f11.1 }}/{{ e6 }} дополнительной силы атаки {{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Kaisa_R a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Kaisa_R" ;
    lol:description "Кай'Са совершает рывок к вражескому чемпиону."^^xsd:string ;
    lol:entityId "Kaisa:R"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Kaisa ;
    lol:name "Охотничий инстинкт"^^xsd:string ;
    lol:slot "R"^^xsd:string ;
    lol:tooltipText "Кай'Са совершает рывок к вражескому чемпиону, пораженному плазмой , и получает щит прочностью {{ rcalculatedshieldvalue }} на {{ rshieldduration }} сек.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Kaisa_W a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Kaisa_W" ;
    lol:description "Кай'Са выпускает дальнобойный снаряд, помечая врагов пассивным умением. Живое оружие: Ловчая из Бездны улучшена и накладывает больше зарядов пассивного умения, а также сокращает перезарядку при поражении чемпионов."^^xsd:string ;
    lol:entityId "Kaisa:W"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Kaisa ;
    lol:name "Ловчая из Бездны"^^xsd:string ;
    lol:slot "W"^^xsd:string ;
    lol:tooltipText "Кай'Са выпускает сгусток энергии Бездны, который наносит первому пораженному врагу {{ totaldamage }} магического урона , накладывает {{ e4 }} заряда плазмы и дает истинное видение цели на {{ spell.kaisapassive:pduration }} сек. Развитие : количество накладываемых зарядов плазмы увеличивается до {{ e5 }}. При поражении чемпиона перезарядка этого умения сокращается на {{ e3 }}%. Прогресс: {{ f2.1 }}/{{ e2 }} силы умений {{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Kalista_E a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Kalista_E" ;
    lol:description "Копья Калисты застревают в атакуемых ею целях. При активации умения Калиста вырывает копья из находящихся неподалеку врагов, нанося им увеличивающийся в зависимости от числа копий физический урон и замедляя их."^^xsd:string ;
    lol:entityId "Kalista:E"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Kalista ;
    lol:name "Раздирание"^^xsd:string ;
    lol:slot "E"^^xsd:string ;
    lol:tooltipText "Пассивно: копья Калисты застревают в пораженных целях на 4 сек. (количество копий в каждой цели не ограничено). Активно: Калиста вырывает копья из врагов поблизости, нанося им {{ normaldamage }} физического урона плюс еще {{ additionaldamage }} физического урона за каждое копье после первого, а также замедляя их на {{ totalslowamount }} на {{ slowduration }} сек. Если это умение убивает хотя бы одну цель, его перезарядка сбрасывается, а Калиста восстанавливает себе {{ manarefund }} маны .{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Kalista_P a owl:NamedIndividual,
        lol:PassiveAbility ;
    rdfs:label "Kalista_P" ;
    lol:description "Если во время автоатаки или при использовании Пронзающего копья Калиста решает сдвинуться с места, она прыгает в указанном курсором направлении после броска копья."^^xsd:string ;
    lol:entityId "Kalista:P"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Kalista ;
    lol:name "Боевая готовность"^^xsd:string ;
    lol:slot "P"^^xsd:string .

lol:Kalista_Q a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Kalista_Q" ;
    lol:description "Калиста мечет тонкое быстролетящее копье, которое пробивает убитых им врагов насквозь, продолжая свой путь."^^xsd:string ;
    lol:entityId "Kalista:Q"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Kalista ;
    lol:name "Пронзающее копье"^^xsd:string ;
    lol:slot "Q"^^xsd:string ;
    lol:tooltipText "Калиста швыряет копье, нанося {{ totaldamage }} физического урона первой пораженной цели. Если копье убивает цель, оно летит дальше, перенося все заряды умения Раздирание на следующего пораженного врага. Калиста может совершить рывок после этого умения с помощью умения Боевая готовность .{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Kalista_R a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Kalista_R" ;
    lol:description "Калиста телепортирует к себе давшего ей Клятву верности союзника, который по прибытии может совершить полет в указанном направлении, разбрасывая вражеских чемпионов."^^xsd:string ;
    lol:entityId "Kalista:R"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Kalista ;
    lol:name "Зов судьбы"^^xsd:string ;
    lol:slot "R"^^xsd:string ;
    lol:tooltipText "Калиста помещает союзника, связанного с ней Клятвой верности , в стазис на время до 4 сек. После этого союзник может щелкнуть по карте, чтобы запустить себя в выбранное место. При столкновении с чемпионом он останавливается и отбрасывает всех врагов поблизости, а также перемещается от цели на расстояние атаки.{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Kalista_W a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Kalista_W" ;
    lol:description "Когда Калиста и чемпион, принесший ей Клятву верности, атакуют одну и ту же цель, та получает дополнительный урон. При активации умения Калиста посылает на разведку духа, который раскрывает область перед собой."^^xsd:string ;
    lol:entityId "Kalista:W"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasSource lol:Source_Kalista ;
    lol:name "Дух-хранитель"^^xsd:string ;
    lol:slot "W"^^xsd:string ;
    lol:tooltipText "Пассивно: когда Калиста и союзник, связанный с ней Клятвой верности , применяют автоатаки к одному и тому же врагу, она наносит ему магический урон в размере {{ maxhealthdamage*100 }}% от максимального запаса здоровья . Перезарядка эффекта для каждой цели – {{ pertargetcooldown }} сек. Он наносит не более {{ maximummonsterdamage }} урона целям, не являющимся чемпионами. Активно: Калиста выпускает призрака, который делает три круга по указанной области. Замеченные им чемпионы раскрываются на 4 сек. У этого умения может быть до 2 зарядов (новый заряд дается раз в {{ ammorechargetooltip }} сек.).{{ spellmodifierdescriptionappend }}"^^xsd:string .

lol:Karma_E a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Karma_E" ;
    lol:description "Карма защищает союзника щитом, поглощающим урон и увеличивающим его скорость передвижения. Эффект Мантры: щит излучает энергию, которая увеличивает его прочность и накладывает Воодушевление на ближайших союзных чемпионов."^^xsd:string ;
    lol:entityId "Karma:E"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasEffect lol:Karma_E_MovementSpeedBoost_Ally,
        lol:Karma_E_Shield_Ally ;
    lol:hasSource lol:Source_Karma ;
    lol:name "Воодушевление"^^xsd:string ;
    lol:slot "E"^^xsd:string ;
    lol:tooltipText "Карма накладывает на союзного чемпиона щит прочностью {{ totalshield }} на {{ shieldduration }} сек. и увеличивает его скорость передвижения на {{ movespeed*100 }}% на {{ movespeedduration }} сек.{{ spellmodifierdescriptionappend }}"^^xsd:string .

