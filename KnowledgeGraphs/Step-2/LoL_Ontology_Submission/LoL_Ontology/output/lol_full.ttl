lol:Morgana_W a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Morgana_W" ;
    lol:description "Моргана создает проклятую тень в выбранной области, нанося урон всем, кто рискнул ступить в ее темный круг. Враги внутри получают периодический магический урон, размер которого зависит от их уровня здоровья."^^xsd:string ;
    lol:entityId "Morgana:W"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasEffect lol:Morgana_W_CooldownReduction_OwnAbility,
        lol:Morgana_W_Damage_Enemy ;
    lol:hasSource lol:Source_Morgana ;
    lol:name "Измученная тень"^^xsd:string ;
    lol:slot "W"^^xsd:string ;
    lol:tooltipText "Моргана поджигает землю на {{ wduration }} сек., нанося {{ totalmindamage }} ед. магического урона в секунду. Урон увеличивается вплоть до {{ totalmaxdamage }} ед. в зависимости от недостающего здоровья целей. Перезарядка этого умения сокращается на {{ cdrefundpercent*100 }}% каждый раз, когда Моргану лечит Вытягивание души .{{ spellmodifierdescriptionappend }}"^^xsd:string .

