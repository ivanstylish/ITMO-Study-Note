lol:Karma_Q a owl:NamedIndividual,
        lol:ActiveAbility ;
    rdfs:label "Karma_Q" ;
    lol:description "Карма выпускает заряд духовной энергии, который взрывается при столкновении с противником, нанося урон. Эффект Мантры: Карма дополнительно увеличивает разрушительную силу Внутреннего пламени, создавая на земле энергетическую аномалию, наносящую урон по прошествии некоторого времени."^^xsd:string ;
    lol:entityId "Karma:Q"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasEffect lol:Karma_Q_Damage_Enemy,
        lol:Karma_Q_Slow_Enemy ;
    lol:hasSource lol:Source_Karma ;
    lol:name "Внутреннее пламя"^^xsd:string ;
    lol:slot "Q"^^xsd:string ;
    lol:tooltipText "Карма выпускает сгусток энергии, нанося {{ totaldamage }} магического урона первой пораженной цели и окружающим врагам, а также замедляя их на {{ slowamount*-100 }}% на {{ slowduration }} сек.{{ spellmodifierdescriptionappend }}"^^xsd:string .

