        lol:AbilityEffect ;
    rdfs:label "Karma_Q_Damage_Enemy" ;
    lol:conditionText "Попадание сгустком энергии; урон получает первая цель и окружающие враги."^^xsd:string ;
    lol:evidenceField "tooltip_text"^^xsd:string ;
    lol:evidenceText "Карма выпускает сгусток энергии, нанося {{ totaldamage }} магического урона первой пораженной цели и окружающим врагам, а также замедляя их на {{ slowamount*-100 }}% на {{ slowduration }} сек.{{ spellmodifierdescriptionappend }}"^^xsd:string ;
    lol:gameVersion "16.20.1"^^xsd:string ;
    lol:hasMechanic lol:Damage ;
    lol:hasSource lol:Source_Karma ;
    lol:hasTargetType lol:Enemy ;
