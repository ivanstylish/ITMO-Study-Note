  <rdf:Description rdf:about="https://example.org/lol-ontology#effectOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>effectOf</rdfs:label>
    <rdfs:comment xml:lang="ru">Эффект относится к умению; обратное hasEffect.</rdfs:comment>
