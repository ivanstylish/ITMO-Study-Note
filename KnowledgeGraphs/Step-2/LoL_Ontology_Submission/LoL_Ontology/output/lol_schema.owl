  <rdf:Description rdf:about="https://example.org/lol-ontology#PassiveAbility">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>PassiveAbility</rdfs:label>
    <rdfs:comment xml:lang="ru">Пассивное умение, слот P.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://example.org/lol-ontology#Ability"/>
