    <rdf:type rdf:resource="https://example.org/lol-ontology#MovementControlMechanic"/>
    <rdfs:label>Stun</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Оглушение</lol:name>
  </rdf:Description>
