  <rdf:Description rdf:about="https://example.org/lol-ontology#Lux_P_Damage_Enemy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#AbilityEffect"/>
    <rdfs:label>Lux_P_Damage_Enemy</rdfs:label>
    <lol:hasMechanic rdf:resource="https://example.org/lol-ontology#Damage"/>
    <lol:hasTargetType rdf:resource="https://example.org/lol-ontology#Enemy"/>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Lux"/>
    <lol:conditionText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Враг отмечен Иллюминацией от атакующего умения; последующая автоатака расходует метку и наносит дополнительный урон.</lol:conditionText>
    <lol:evidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Используя атакующие умения, Люкс накладывает на врагов эффект Иллюминации на несколько секунд. Ее последующие автоатаки поджигают находящихся под действием эффекта врагов, нанося им дополнительный магический урон (тем больший, чем выше уровень Люкс), но снимают эффект.</lol:evidenceText>
    <lol:evidenceField rdf:datatype="http://www.w3.org/2001/XMLSchema#string">description_text</lol:evidenceField>
    <lol:reviewStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">reviewed_by_assistant</lol:reviewStatus>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
