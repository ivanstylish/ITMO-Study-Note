  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Karma_Q_Slow_Enemy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#AbilityEffect"/>
    <rdfs:label>Karma_Q_Slow_Enemy</rdfs:label>
    <lol:hasMechanic rdf:resource="https://example.org/lol-ontology#Slow"/>
    <lol:hasTargetType rdf:resource="https://example.org/lol-ontology#Enemy"/>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Karma"/>
    <lol:conditionText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Попадание сгустком энергии; замедление целей, указанных в tooltip.</lol:conditionText>
    <lol:evidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Карма выпускает сгусток энергии, нанося {{ totaldamage }} магического урона первой пораженной цели и окружающим врагам, а также замедляя их на {{ slowamount*-100 }}% на {{ slowduration }} сек.{{ spellmodifierdescriptionappend }}</lol:evidenceText>
    <lol:evidenceField rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tooltip_text</lol:evidenceField>
    <lol:reviewStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">reviewed_by_assistant</lol:reviewStatus>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Morgana_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Morgana_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Измученная тень</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Morgana"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Morgana:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Моргана создает проклятую тень в выбранной области, нанося урон всем, кто рискнул ступить в ее темный круг. Враги внутри получают периодический магический урон, размер которого зависит от их уровня здоровья.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Моргана поджигает землю на {{ wduration }} сек., нанося {{ totalmindamage }} ед. магического урона в секунду. Урон увеличивается вплоть до {{ totalmaxdamage }} ед. в зависимости от недостающего здоровья целей. Перезарядка этого умения сокращается на {{ cdrefundpercent*100 }}% каждый раз, когда Моргану лечит Вытягивание души .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
    <lol:hasEffect rdf:resource="https://example.org/lol-ontology#Morgana_W_Damage_Enemy"/>
    <lol:hasEffect rdf:resource="https://example.org/lol-ontology#Morgana_W_CooldownReduction_OwnAbility"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#OwnAbility">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#TargetType"/>
    <rdfs:label>OwnAbility</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Собственное умение</lol:name>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Source_Morgana">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#SourceDocument"/>
    <rdfs:label>Source_Morgana</rdfs:label>
    <lol:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://ddragon.leagueoflegends.com/cdn/16.20.1/data/ru_RU/champion/Morgana.json</lol:sourceURL>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Lux_E_Slow_Enemy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#AbilityEffect"/>
    <rdfs:label>Lux_E_Slow_Enemy</rdfs:label>
    <lol:hasMechanic rdf:resource="https://example.org/lol-ontology#Slow"/>
    <lol:hasTargetType rdf:resource="https://example.org/lol-ontology#Enemy"/>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Lux"/>
    <lol:conditionText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Противник находится в области аномалии; tooltip также описывает краткое замедление после взрыва.</lol:conditionText>
    <lol:evidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Люкс создает световую аномалию, замедляющую на {{ slowpercent }}% и раскрывающую область под собой. Через {{ slowzoneduration }} сек. или при повт. применении этого умения аномалия взрывается, нанося {{ totaldamagett }} ед. маг. урона и замедляя еще на {{ slowlingerduration }} сек.{{ spellmodifierdescriptionappend }}</lol:evidenceText>
    <lol:evidenceField rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tooltip_text</lol:evidenceField>
    <lol:reviewStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">reviewed_by_assistant</lol:reviewStatus>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Karma_W_Damage_Enemy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#AbilityEffect"/>
    <rdfs:label>Karma_W_Damage_Enemy</rdfs:label>
    <lol:hasMechanic rdf:resource="https://example.org/lol-ontology#Damage"/>
    <lol:hasTargetType rdf:resource="https://example.org/lol-ontology#Enemy"/>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Karma"/>
    <lol:conditionText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Выбранная вражеская цель связана с Кармой; повторный урон, если связь сохраняется.</lol:conditionText>
    <lol:evidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Карма создает связь между собой и чемпионом или лесным монстром, нанося цели {{ initialdamage }} магического урона и раскрывая ее на {{ tetherduration }} сек. Если связь не разрывается, цель снова получает {{ initialdamage }} магического урона и обездвиживается на {{ rootduration }} сек.{{ spellmodifierdescriptionappend }}</lol:evidenceText>
    <lol:evidenceField rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tooltip_text</lol:evidenceField>
    <lol:reviewStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">reviewed_by_assistant</lol:reviewStatus>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Morgana_Q_Root_Enemy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#AbilityEffect"/>
    <rdfs:label>Morgana_Q_Root_Enemy</rdfs:label>
    <lol:hasMechanic rdf:resource="https://example.org/lol-ontology#Root"/>
    <lol:hasTargetType rdf:resource="https://example.org/lol-ontology#Enemy"/>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Morgana"/>
    <lol:conditionText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Первый враг, в которого попал снаряд.</lol:conditionText>
    <lol:evidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Моргана выпускает заряд звездного огня, который обездвиживает первого пораженного врага на {{ rootduration }} сек. и наносит {{ totaldamage }} магического урона .{{ spellmodifierdescriptionappend }}</lol:evidenceText>
    <lol:evidenceField rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tooltip_text</lol:evidenceField>
    <lol:reviewStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">reviewed_by_assistant</lol:reviewStatus>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nef4958e3c0144f2482f8a6d3908d312a">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://example.org/lol-ontology#hasMechanic"/>
    <owl:someValuesFrom rdf:resource="https://example.org/lol-ontology#MovementControlMechanic"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Morgana_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Morgana_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Темные узы</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Morgana"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Morgana:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Моргана сковывает врага темной магией и наносит магический урон, заставляя почувствовать ту боль, которую он причинил.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Моргана выпускает заряд звездного огня, который обездвиживает первого пораженного врага на {{ rootduration }} сек. и наносит {{ totaldamage }} магического урона .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
    <lol:hasEffect rdf:resource="https://example.org/lol-ontology#Morgana_Q_Damage_Enemy"/>
    <lol:hasEffect rdf:resource="https://example.org/lol-ontology#Morgana_Q_Root_Enemy"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#baseHP">
