  <rdf:Description rdf:about="https://example.org/lol-ontology#PassiveAbility">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>PassiveAbility</rdfs:label>
    <rdfs:comment xml:lang="ru">Пассивное умение, слот P.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://example.org/lol-ontology#Ability"/>
    <owl:disjointWith rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Morgana">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#Champion"/>
    <rdfs:label>Morgana</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Моргана</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Morgana"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Morgana</lol:entityId>
    <lol:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Падшая</lol:title>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
    <lol:resourceType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Мана</lol:resourceType>
    <lol:baseHP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">630.0</lol:baseHP>
    <lol:baseMP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">340.0</lol:baseMP>
    <lol:baseArmor rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">25.0</lol:baseArmor>
    <lol:baseAttackDamage rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">56.0</lol:baseAttackDamage>
    <lol:baseMoveSpeed rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">335.0</lol:baseMoveSpeed>
    <lol:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Support"/>
    <lol:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Mage"/>
    <lol:reviewStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">effects_reviewed_by_assistant</lol:reviewStatus>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Morgana_P"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Morgana_Q"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Morgana_W"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Morgana_E"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Morgana_R"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Source_Karma">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#SourceDocument"/>
