    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Mechanic</rdfs:label>
    <rdfs:comment xml:lang="ru">Тип механики: щит, урон, обездвиживание и т. п.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#canApplyMechanic">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>canApplyMechanic</rdfs:label>
    <rdfs:comment xml:lang="ru">Выводится цепочкой hasAbility / hasEffect / hasMechanic; не хранит условия.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/lol-ontology#Champion"/>
    <rdfs:range rdf:resource="https://example.org/lol-ontology#Mechanic"/>
    <owl:propertyChainAxiom rdf:nodeID="N53d205fc555d4b34b915e1b5a7c17c49"/>
  </rdf:Description>
