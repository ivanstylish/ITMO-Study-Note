    <rdf:first rdf:nodeID="Ne3562ca0f5254400a37b10006ea0273d"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nbfaf5c1604d54f9b98f6c0dd0b71249a">
    <rdf:first rdf:resource="https://example.org/lol-ontology#Stun"/>
    <rdf:rest rdf:nodeID="N721ebf647ebe48989320f3733268b74e"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Morgana_R_Stun_Enemy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#AbilityEffect"/>
    <rdfs:label>Morgana_R_Stun_Enemy</rdfs:label>
    <lol:hasMechanic rdf:resource="https://example.org/lol-ontology#Stun"/>
    <lol:hasTargetType rdf:resource="https://example.org/lol-ontology#Enemy"/>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Morgana"/>
    <lol:conditionText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Цепь с вражеским чемпионом должна сохраниться до окончания задержки.</lol:conditionText>
    <lol:evidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Моргана приковывает себя цепями к окружающим вражеским чемпионам, нанося {{ totaldamage }} магического урона и замедляя их на {{ slowpercent }}%. Через {{ chainduration }} сек. враги, которые не смогли разорвать цепи, дополнительно получают {{ totaldamage }} магического урона и оглушаются на {{ stunduration }} сек. При применении этого умения Моргана увеличивает свою скорость передвижения на {{ hastepercent }}% .{{ spellmodifierdescriptionappend }}</lol:evidenceText>
    <lol:evidenceField rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tooltip_text</lol:evidenceField>
    <lol:reviewStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">reviewed_by_assistant</lol:reviewStatus>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#hasAbility">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>hasAbility</rdfs:label>
    <rdfs:comment xml:lang="ru">У чемпиона есть умение.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/lol-ontology#Champion"/>
    <rdfs:range rdf:resource="https://example.org/lol-ontology#Ability"/>
    <owl:inverseOf rdf:resource="https://example.org/lol-ontology#isAbilityOf"/>
  </rdf:Description>
