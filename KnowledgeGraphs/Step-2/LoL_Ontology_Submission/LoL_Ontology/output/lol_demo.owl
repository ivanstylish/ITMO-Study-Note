  <rdf:Description rdf:about="https://example.org/lol-ontology#Morgana_R">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Morgana_R</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Оковы души</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Morgana"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Morgana:R</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Моргана высвобождает всю свою небесную мощь, расправляя крылья и взмывая над землей. Она выпускает цепи темной агонии во вражеских чемпионов поблизости и увеличивает свою скорость передвижения. Ее цепи замедляют и наносят начальный урон, а после задержки оглушают тех, кто не смог их разорвать.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Моргана приковывает себя цепями к окружающим вражеским чемпионам, нанося {{ totaldamage }} магического урона и замедляя их на {{ slowpercent }}%. Через {{ chainduration }} сек. враги, которые не смогли разорвать цепи, дополнительно получают {{ totaldamage }} магического урона и оглушаются на {{ stunduration }} сек. При применении этого умения Моргана увеличивает свою скорость передвижения на {{ hastepercent }}% .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
    <lol:hasEffect rdf:resource="https://example.org/lol-ontology#Morgana_R_Damage_Enemy"/>
    <lol:hasEffect rdf:resource="https://example.org/lol-ontology#Morgana_R_Slow_Enemy"/>
    <lol:hasEffect rdf:resource="https://example.org/lol-ontology#Morgana_R_Stun_Enemy"/>
    <lol:hasEffect rdf:resource="https://example.org/lol-ontology#Morgana_R_MovementSpeedBoost_Self"/>
  </rdf:Description>
