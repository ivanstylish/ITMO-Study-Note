    <!-- https://example.org/lol-ontology#Aphelios_E -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Aphelios_E">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Aphelios"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Aphelios"/>
        <lol-ontology:description>У Афелия нет третьего умения. В этой ячейке показывается следующее оружие, которое ему даст Алуна. Порядок получения оружия фиксированный, но может меняться по ходу игры. Когда заканчиваются боеприпасы для текущего оружия, оно переносится в конец очереди.</lol-ontology:description>
        <lol-ontology:entityId>Aphelios:E</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Система очереди видов оружия</lol-ontology:name>
        <lol-ontology:slot>E</lol-ontology:slot>
        <lol-ontology:tooltipText>{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Aphelios_E</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Aphelios_P -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Aphelios_P">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Aphelios"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Aphelios"/>
        <lol-ontology:description>Афелий владеет 5 видами оружия Лунари, которые создала его сестра Алуна. Одновременно он использует два оружия: основное и дополнительное. У каждого оружия уникальные автоатаки и умение. Атаки и умения расходуют боеприпасы оружия. Когда они заканчиваются, Афелий выбрасывает текущее оружие и Алуна дает ему следующее в очереди из пяти.</lol-ontology:description>
        <lol-ontology:entityId>Aphelios:P</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Убийца и провидица</lol-ontology:name>
        <lol-ontology:slot>P</lol-ontology:slot>
        <rdfs:label>Aphelios_P</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Aphelios_Q -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Aphelios_Q">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Aphelios"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Aphelios"/>
        <lol-ontology:description>У Афелия есть 5 разных активируемых умений, которые зависят от основного оружия: Калибрум (винтовка): Афелий совершает выстрел с большого расстояния, помечая цель. После этого он может поразить помеченного врага еще раз с дальнего расстояния. Северум (пистолет-коса): Афелий ускоряется и расстреливает ближайших врагов из обоих видов оружия. Гравитум (пушка): Афелий обездвиживает всех врагов, замедленных этим оружием. Инфернум (огнемет): Афелий поражает врагов в конусе и атакует их с помощью дополнительного оружия. Кресцендум (шакрам): Афелий создает стража, который атакует врагов с помощью дополнительного оружия.</lol-ontology:description>
        <lol-ontology:entityId>Aphelios:Q</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Оружейные умения</lol-ontology:name>
        <lol-ontology:slot>Q</lol-ontology:slot>
        <lol-ontology:tooltipText>{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Aphelios_Q</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Aphelios_R -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Aphelios_R">
