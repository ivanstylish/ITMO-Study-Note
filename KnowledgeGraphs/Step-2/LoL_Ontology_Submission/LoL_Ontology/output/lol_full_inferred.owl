        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Hecarim"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Hecarim"/>
        <lol-ontology:description>Сила атаки Гекарима увеличивается на долю от его дополнительной скорости передвижения.</lol-ontology:description>
        <lol-ontology:entityId>Hecarim:P</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
