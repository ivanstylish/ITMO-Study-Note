    <!-- https://example.org/lol-ontology#Kayle_E -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Kayle_E">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Kayle"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Kayle"/>
        <lol-ontology:description>Пассивно: небесный меч Кейл, Добродетель, наносит дополнительный магический урон врагам, которых она атакует. Активно: следующая атака Кейл поражает врага небесным огнем, нанося дополнительный урон в зависимости от недостающего здоровья цели.</lol-ontology:description>
        <lol-ontology:entityId>Kayle:E</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Клинок звездного огня</lol-ontology:name>
        <lol-ontology:slot>E</lol-ontology:slot>
        <lol-ontology:tooltipText>Пассивно: автоатаки дополнительно наносят {{ epassivetotaldamage }} магического урона . Активно: следующая автоатака Кейл становится дальнобойной и дополнительно наносит магический урон в размере {{ activetotalexecutedamage }} от недостающего здоровья . Эта атака улучшается, когда Кейл достигает {{ spell.kaylepassive:levelforpassiverank2 }}-го уровня , и взрывается при поражении цели, нанося урон врагам поблизости.{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Kayle_E</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Kayle_P -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Kayle_P">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Kayle"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Kayle"/>
        <lol-ontology:description>По мере того, как Кейл набирает уровни и тратит очки умений, ее автоатаки усиливаются небесами. Ее крылья воспламеняются, и она постепенно увеличивает скорость атаки, скорость передвижения и дальность атаки. Кроме того, она начинает выпускать волны пламени при автоатаках.</lol-ontology:description>
        <lol-ontology:entityId>Kayle:P</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Божественное восхождение</lol-ontology:name>
        <lol-ontology:slot>P</lol-ontology:slot>
        <rdfs:label>Kayle_P</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Kayle_Q -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Kayle_Q">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
