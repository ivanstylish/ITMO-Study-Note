    <!-- https://example.org/lol-ontology#Renata_E -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Renata_E">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Renata"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Renata"/>
        <lol-ontology:description>Рената выпускает две химтековые ракеты, которые дают щит союзникам, а также замедляют врагов и наносят им урон.</lol-ontology:description>
        <lol-ontology:entityId>Renata:E</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Программа лояльности</lol-ontology:name>
        <lol-ontology:slot>E</lol-ontology:slot>
        <lol-ontology:tooltipText>Рената выпускает две химтековые ракеты, которые наносят пораженным врагам {{ totaldamage }} магического урона и замедляют их на 30% на {{ slowduration }} сек. Задетые союзники получают щит прочностью {{ shieldcalc }} на {{ shieldduration }} сек.{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Renata_E</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Renata_P -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Renata_P">
