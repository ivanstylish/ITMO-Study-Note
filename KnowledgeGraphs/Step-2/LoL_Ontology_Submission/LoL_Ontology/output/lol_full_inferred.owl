    <!-- https://example.org/lol-ontology#Yunara_E -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Yunara_E">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Yunara"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Yunara"/>
        <lol-ontology:description>Юнара получает бонус к скорости передвижения и призрачность. В просветленном состоянии она вместо этого совершает рывок в указанном направлении.</lol-ontology:description>
        <lol-ontology:entityId>Yunara:E</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Шаги канмея | Неприкасаемые тени</lol-ontology:name>
        <lol-ontology:slot>E</lol-ontology:slot>
        <lol-ontology:tooltipText>Юнара получает {{ calc_move_speed }} скорости передвижения на {{ buff_duration }} сек. Бонус увеличивается до {{ calc_move_speed_enhanced }} при движении в сторону вражеского чемпиона. Просветленное состояние – Неприкасаемые тени : Юнара совершает рывок в указанном направлении.{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Yunara_E</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Yunara_P -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Yunara_P">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Yunara"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Yunara"/>
        <lol-ontology:description>Критические удары Юнары наносят дополнительный магический урон.</lol-ontology:description>
        <lol-ontology:entityId>Yunara:P</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Клятва Исконной земле</lol-ontology:name>
