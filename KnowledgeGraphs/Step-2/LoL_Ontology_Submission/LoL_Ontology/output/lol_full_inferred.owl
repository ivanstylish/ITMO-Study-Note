    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Milio_Q -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Milio_Q">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Milio"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Milio"/>
        <lol-ontology:description>Милио пинает огненный мяч. При попадании мяч отбрасывает врага, подлетает вверх, а затем падает обратно, замедляя всех противников в области поражения и нанося им урон.</lol-ontology:description>
        <lol-ontology:entityId>Milio:Q</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Огненный мяч</lol-ontology:name>
        <lol-ontology:slot>Q</lol-ontology:slot>
        <lol-ontology:tooltipText>Милио пинает огненный мяч, который отбрасывает первого пораженного врага. Если мяч попадает в цель, он отскакивает дальше и взрывается, нанося {{ damage }} магического урона окружающим врагам и замедляя их на {{ slowamountpercent }} на {{ slowduration }} сек. Если Огненный мяч поражает хотя бы одного вражеского чемпиона, Милио восстанавливает {{ refundratio*100 }}% от затраченной маны.{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Milio_Q</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Milio_R -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Milio_R">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Milio"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Milio"/>
        <lol-ontology:description>Милио выпускает волну целительного пламени, которое лечит союзников и снимает с них эффекты контроля.</lol-ontology:description>
        <lol-ontology:entityId>Milio:R</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Дыхание жизни</lol-ontology:name>
        <lol-ontology:slot>R</lol-ontology:slot>
        <lol-ontology:tooltipText>Милио выпускает волну целительного пламени, которая снимает с ближайших союзных чемпионов нейтрализующие и обездвиживающие эффекты, а также восстанавливает им {{ healcalc }} здоровья и дает {{ tenacityamount*100 }}% стойкости на {{ tenacityduration }} сек.{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Milio_R</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Milio_W -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Milio_W">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Milio"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Milio"/>
        <lol-ontology:description>Милио создает область усиления, которая лечит союзников и увеличивает дальность атаки бойцов, находящихся внутри. Область следует за союзником, который находится ближе всего к точке применения умения.</lol-ontology:description>
        <lol-ontology:entityId>Milio:W</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Посиделки у костра</lol-ontology:name>
        <lol-ontology:slot>W</lol-ontology:slot>
        <lol-ontology:tooltipText>Милио создает очаг, который следует за союзными чемпионами {{ zoneduration }} сек. Дальность атаки союзных чемпионов поблизости увеличивается на {{ rangepercent }}, и они восстанавливают {{ healingovertime }} здоровья во время действия умения. Очаг также применяет Запал раз в {{ healfrequencyseconds }} сек. Повторное применение: Милио меняет союзника, за которым следует очаг.{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Milio_W</rdfs:label>
    </owl:Thing>
    


