    <!-- https://example.org/lol-ontology#LeeSin_E -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#LeeSin_E">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_LeeSin"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#LeeSin"/>
        <lol-ontology:description>Натиск: Ли Син бьет по земле, создавая ударную волну, которая наносит магический урон и раскрывает вражеских бойцов. Если Натиск поражает противника, Ли Син получает возможность использовать Увечье. Увечье: Ли Син калечит ближайших врагов, пораженных Натиском, замедляя их (эффект постепенно ослабевает).</lol-ontology:description>
        <lol-ontology:entityId>LeeSin:E</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Натиск / Увечье</lol-ontology:name>
        <lol-ontology:slot>E</lol-ontology:slot>
        <lol-ontology:tooltipText>Ли Син бьет по земле, создавая ударную волну, которая наносит {{ initialdamage }} магического урона и раскрывает врагов на {{ slowduration }} сек. Если этот эффект поражает врага, Ли Син может повторно применить это умение в течение {{ reactivatetime }} сек. Повторное применение: Ли Син замедляет окружающих врагов, пораженных ударной волной, на {{ slowamount }}% (эффект ослабевает в течение {{ slowduration }} сек.).{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>LeeSin_E</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#LeeSin_P -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#LeeSin_P">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_LeeSin"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#LeeSin"/>
        <lol-ontology:description>После использования любого умения скорость атаки Ли Сина увеличивается, пока он не проведет две автоатаки. Эти автоатаки восстанавливают ему энергию.</lol-ontology:description>
        <lol-ontology:entityId>LeeSin:P</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Шквал</lol-ontology:name>
        <lol-ontology:slot>P</lol-ontology:slot>
