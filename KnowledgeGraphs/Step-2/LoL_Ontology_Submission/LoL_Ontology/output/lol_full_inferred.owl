    <!-- https://example.org/lol-ontology#Nasus_E -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Nasus_E">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Nasus"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Nasus"/>
        <lol-ontology:description>Насус обрушивает призрачный огонь на выбранную область, нанося урон и уменьшая броню врагов, находящихся в зоне поражения.</lol-ontology:description>
        <lol-ontology:entityId>Nasus:E</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Призрачный огонь</lol-ontology:name>
        <lol-ontology:slot>E</lol-ontology:slot>
        <lol-ontology:tooltipText>Насус разжигает в выбранной области призрачный огонь, наносящий врагам {{ initialdamage }} ед. маг. урона . Враги в этой области теряют {{ armorshredpercent*-100 }}% брони и получают {{ totaldotdamage }} ед. маг. урона в течение {{ duration }} сек.{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Nasus_E</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Nasus_P -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Nasus_P">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
