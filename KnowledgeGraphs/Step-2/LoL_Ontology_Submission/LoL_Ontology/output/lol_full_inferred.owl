    <!-- https://example.org/lol-ontology#Sona_E -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Sona_E">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Sona"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Sona"/>
        <lol-ontology:description>Сона исполняет песнь стремительности, увеличивая скорость передвижения ближайших союзников. Кроме того, Сона получает временную ауру, которая увеличивает скорость передвижения союзных чемпионов, попавших в зону ее действия.</lol-ontology:description>
        <lol-ontology:entityId>Sona:E</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Песнь стремительности</lol-ontology:name>
        <lol-ontology:slot>E</lol-ontology:slot>
        <lol-ontology:tooltipText>Активно: Сона начинает играть новую Мелодию и увеличивает свою скорость передвижения на {{ totalselfmovementspeed }} на {{ selfmovementspeeddurationmin }} сек. Продолжительность ускорения увеличивается вплоть до {{ selfmovementspeeddurationmax }} сек., если Сона не получает урона. Мелодия: Сона на {{ auraduration }} сек. получает ауру, которая увеличивает скорость передвижения союзных чемпионов на {{ totalallymovementspeed }} на {{ allymovementspeedduration }} сек. Мощный аккорд - Темп: Мощный аккорд также замедляет цель на {{ totaltempomovespeedslow }} на {{ tempoduration }} сек.{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Sona_E</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Sona_P -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Sona_P">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Sona"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Sona"/>
        <lol-ontology:description>Аччелерандо : успешно применяя умения, Сона получает заряды, которые навсегда увеличивают ускорение базовых умений. После накопления максимального числа зарядов успешные применения умений сокращают оставшуюся перезарядку ее абсолютного умения. Мощный аккорд : после нескольких применений умений следующая автоатака Соны усиливается: она наносит дополнительный магический урон и имеет бонусный эффект, зависящий от умения, которое Сона использовала последним.</lol-ontology:description>
        <lol-ontology:entityId>Sona:P</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Мощный аккорд</lol-ontology:name>
        <lol-ontology:slot>P</lol-ontology:slot>
        <rdfs:label>Sona_P</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Sona_Q -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Sona_Q">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Sona"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Sona"/>
        <lol-ontology:description>Сона исполняет гимн доблести, нанося магический урон двум врагам неподалеку (предпочтение отдается чемпионам и монстрам). Кроме того, Сона получает временную ауру, увеличивающую урон, который попавшие в зону ее действия союзники наносят при следующей своей автоатаке.</lol-ontology:description>
        <lol-ontology:entityId>Sona:Q</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Гимн доблести</lol-ontology:name>
        <lol-ontology:slot>Q</lol-ontology:slot>
        <lol-ontology:tooltipText>Сона наносит двум ближайшим врагам {{ totaldamage }} магического урона (приоритет отдается чемпионам). После этого она начинает играть новую Мелодию . Сона получает заряд Аччелерандо за каждого чемпиона, которому этот эффект нанес урон. Мелодия: Сона на {{ auraduration }} сек. получает ауру. Следующая автоатака попавших в нее союзных чемпионов, примененная в течение {{ onhitduration }} сек., дополнительно наносит {{ totalonhitdamage }} магического урона %i:OnHit%. Мощный аккорд - Стаккато: Мощный аккорд наносит дополнительный урон ({{ totalstaccatodamage }} магического урона всего).{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Sona_Q</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Sona_R -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Sona_R">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Sona"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Sona"/>
        <lol-ontology:description>Сона исполняет свой лучший аккорд, оглушая вражеских чемпионов, заставляя их танцевать и нанося им магический урон.</lol-ontology:description>
        <lol-ontology:entityId>Sona:R</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Крещендо</lol-ontology:name>
        <lol-ontology:slot>R</lol-ontology:slot>
        <lol-ontology:tooltipText>Сона исполняет свой лучший аккорд, оглушая врагов на {{ stunduration }} сек. и нанося им {{ totaldamage }} магического урона .{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Sona_R</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Sona_W -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Sona_W">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Sona"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Sona"/>
        <lol-ontology:description>Сона исполняет арию стойкости, восстанавливая здоровье себе и наиболее пострадавшему из окружающих союзных чемпионов. Кроме того, Сона получает временную ауру, которая дает союзникам, попавшим в зону ее действия, временный щит.</lol-ontology:description>
        <lol-ontology:entityId>Sona:W</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Ария стойкости</lol-ontology:name>
        <lol-ontology:slot>W</lol-ontology:slot>
        <lol-ontology:tooltipText>Активно: Сона восстанавливает {{ totalheal }} здоровья себе и союзному чемпиону поблизости (приоритет отдается чемпионам с самым низким уровнем здоровья). После этого она начинает играть новую Мелодию . Мелодия: Сона на {{ auraduration }} сек. получает ауру, которая накладывает на союзных чемпионов щит прочностью {{ totalshield }} на {{ shieldduration }} сек. Сона получает заряд Аччелерандо , когда лечит другого раненого союзника или когда щит, наложенный на союзника при помощи этого умения, блокирует по крайней мере {{ accelerandoshieldbreakpoint }} урона. Мощный аккорд - Диминуэндо: Мощный аккорд также уменьшает физический и магический урон цели на {{ totaldiminuendoweakenpercent }} на {{ diminuendoduration }} сек.{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Sona_W</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Soraka -->

