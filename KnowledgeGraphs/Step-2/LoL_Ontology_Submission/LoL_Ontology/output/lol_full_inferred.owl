    <!-- https://example.org/lol-ontology#Bard_E -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Bard_E">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Bard"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Bard"/>
        <lol-ontology:description>Бард создает портал, позволяющий пройти сквозь выбранное препятствие. Порталом могут воспользоваться как союзные, так и вражеские чемпионы, но только в одном направлении.</lol-ontology:description>
        <lol-ontology:entityId>Bard:E</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
