    <!-- https://example.org/lol-ontology#Locke_E -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Locke_E">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Locke"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Locke"/>
        <lol-ontology:description>Локк телепортируется в выбранную точку, а затем совершает рывок к следующей цели, нанося урон врагам на пути.</lol-ontology:description>
        <lol-ontology:entityId>Locke:E</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Путь пепла</lol-ontology:name>
        <lol-ontology:slot>E</lol-ontology:slot>
        <lol-ontology:tooltipText>Локк телепортируется в выбранную точку, нанося {{ onhitdamage }} ед. маг. урона врагам поблизости. Его следующая атака стремительно перемещает его к цели, позволяя нанести {{ dashdamage }} ед. маг. урона всем врагам на пути. Каждое из этих попаданий расходует гвозди души . Перезарядка сбрасывается при участии в убийстве.{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Locke_E</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Locke_P -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Locke_P">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Locke"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Locke"/>
        <lol-ontology:description>Автоатаки Локка дополнительно наносят маг. урон при попадании, зависящий от недост. здоровья врага.</lol-ontology:description>
        <lol-ontology:entityId>Locke:P</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Серебряный кол</lol-ontology:name>
        <lol-ontology:slot>P</lol-ontology:slot>
        <rdfs:label>Locke_P</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Locke_Q -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Locke_Q">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Locke"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Locke"/>
        <lol-ontology:description>Локк подготавливает набор гвоздей души и бросает их, нанося урон пораженным врагам и ставя на них метку. Локк может поглотить метку, нанося доп. урон.</lol-ontology:description>
        <lol-ontology:entityId>Locke:Q</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Ритуальные гвозди</lol-ontology:name>
        <lol-ontology:slot>Q</lol-ontology:slot>
        <lol-ontology:tooltipText>Локк подготавливает набор гвоздей души и бросает их, нанося {{ missiledamage }} ед. маг. урона и помечая пораженных врагов. Гвозди накладывают замедление ({{ slowamount1*100 }}/{{ slowamount2*100 }}/{{ slowamount3*100 }}%) на {{ slowduration1 }}/{{ slowduration2 }}/{{ slowduration3 }} сек. в зависимости от числа попаданий гвоздями. Атаки по врагу расходуют гвозди души , нанося {{ naildamage }} ед. маг. урона за каждый накопленный заряд. Урон растет на {{ twomarkbonuspercent }}% за 2 и на {{ threemarkbonuspercent }}% – за 3 гвоздя.{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Locke_Q</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Locke_R -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Locke_R">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Locke"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Locke"/>
        <lol-ontology:description>Локк бросает сковывающий артефакт, наносящий урон и способный казнить пораженных врагов. Мощь Локка растет за каждого запечатанного враж. чемпиона.</lol-ontology:description>
        <lol-ontology:entityId>Locke:R</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Чистилище</lol-ontology:name>
        <lol-ontology:slot>R</lol-ontology:slot>
        <lol-ontology:tooltipText>Локк бросает в выбранную точку сковывающий артефакт, нанося {{ damage }} ед. маг. урона врагам в области и замедляя их на {{ slowamount*100 }}% (эффект ослабевает в течение {{ slowduration }} сек.). Артефакт помечает пораженных врагов на {{ duration }} сек., запечатывая чемпионов с меткой. Если здоровье любого из них падает ниже {{ executetooltipcalc }} , артефакт запечатывает его и сбрасывает длительность эффекта на прочих чемпионах с меткой. Если по завершении действия эффекта артефакт запечатал хотя бы 1 чемпиона, он падает на землю. Локк может подобрать артефакт, повысив порог срабатывания казни его эффекта на {{ executethresholdperstack*100 }}% и снизив его сумм. перезарядку на {{ cooldownreduction }}% за каждого запечатанного чемпиона. {{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Locke_R</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Locke_W -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Locke_W">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Locke"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Locke"/>
        <lol-ontology:description>Душа Локка воспламеняется – он получает скорость атаки и передвижения и начинает наносить себе урон. По завершении действия эффекта Локк восстановит здоровье в размере части урона, полученного при действии эффекта.</lol-ontology:description>
        <lol-ontology:entityId>Locke:W</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Пламя души</lol-ontology:name>
        <lol-ontology:slot>W</lol-ontology:slot>
        <lol-ontology:tooltipText>Душа Локка воспламеняется. Он получает {{ attackspeed }} скорости атаки и {{ movespeed }} скорости передвижения (бонус ослабевает за {{ decaytimehelper }} сек.). В течение {{ baseduration }} сек. он получает чистый урон в размере {{ healthcost*100 }}% от тек. здоровья в секунду, но восстанавливает здоровье в размере {{ damagerestoreamount }} от получ. урона, а также {{ additionalheal }} здоровья в зависимости от недост. здоровья и длительности умения, вплоть до {{ maxhealingthreshold }} от оставшегося здоровья . Повт. применение завершает действие умения.{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Locke_W</rdfs:label>
    </owl:Thing>
    


