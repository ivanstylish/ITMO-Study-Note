    <!-- https://example.org/lol-ontology#Karthus_E -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Karthus_E">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Karthus"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Karthus"/>
        <lol-ontology:description>Картус пассивно высасывает жизненную энергию из убитых им врагов, восстанавливая себе ману при каждом убийстве. Или же вместо этого он может окружить себя душами своих жертв, которые наносят урон ближайшим врагам, но быстро расходуют его ману.</lol-ontology:description>
        <lol-ontology:entityId>Karthus:E</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Осквернение</lol-ontology:name>
        <lol-ontology:slot>E</lol-ontology:slot>
        <lol-ontology:tooltipText>Пассивно: убивая бойца, Картус восстанавливает {{ manarestoreonkill }} ед. маны . Включено: Картус создает вокруг себя ауру смерти, нанося {{ totaldps }} ед. маг. урона в секунду врагам поблизости.{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Karthus_E</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Karthus_P -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Karthus_P">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Karthus"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Karthus"/>
        <lol-ontology:description>После смерти Картус приобретает форму духа, которая позволяет ему продолжать использовать заклинания.</lol-ontology:description>
        <lol-ontology:entityId>Karthus:P</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Победа над смертью</lol-ontology:name>
        <lol-ontology:slot>P</lol-ontology:slot>
        <rdfs:label>Karthus_P</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Karthus_Q -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Karthus_Q">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Karthus"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Karthus"/>
        <lol-ontology:description>Картус производит отложенный взрыв в указанном месте, нанося урон всем ближайшим врагам. Изолированные враги получают больше урона.</lol-ontology:description>
        <lol-ontology:entityId>Karthus:Q</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Опустошение</lol-ontology:name>
        <lol-ontology:slot>Q</lol-ontology:slot>
        <lol-ontology:tooltipText>Картус создает магический взрыв, который наносит {{ qdamage }} магического урона . Если взрыв поражает только одного врага, он наносит {{ qsingletargetdamage }} магического урона .{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Karthus_Q</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Karthus_R -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Karthus_R">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Karthus"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Karthus"/>
        <lol-ontology:description>Картус читает заклинание в течение 3 секунд, после чего наносит урон всем вражеским чемпионам.</lol-ontology:description>
        <lol-ontology:entityId>Karthus:R</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Реквием</lol-ontology:name>
        <lol-ontology:slot>R</lol-ontology:slot>
        <lol-ontology:tooltipText>Картус читает заклинание в течение 3 сек., после чего наносит {{ totaldamage }} магического урона всем вражеским чемпионам независимо от расстояния.{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Karthus_R</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Karthus_W -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Karthus_W">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Karthus"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Karthus"/>
        <lol-ontology:description>Картус создает энергетический барьер, который замедляет проходящих сквозь него врагов и уменьшает их сопротивление магии на некоторое время.</lol-ontology:description>
        <lol-ontology:entityId>Karthus:W</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Стена боли</lol-ontology:name>
        <lol-ontology:slot>W</lol-ontology:slot>
        <lol-ontology:tooltipText>Картус создает стену на {{ wallduration }} сек. Враги, проходящие сквозь нее, теряют {{ magicresistshred }}% сопр. магии на {{ debuffduration }} сек. и замедляются на {{ slowpercent }}% (эффект ослабевает в течение времени действия).{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Karthus_W</rdfs:label>
    </owl:Thing>
    


