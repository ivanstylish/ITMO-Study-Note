        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Veigar"/>
        <lol-ontology:description>Вейгар поражает вражеского чемпиона, нанося большое количество магического урона, дополнительно увеличенное от недостающего запаса здоровья цели.</lol-ontology:description>
        <lol-ontology:entityId>Veigar:R</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
