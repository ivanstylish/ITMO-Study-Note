    <!-- https://example.org/lol-ontology#Jayce_E -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Jayce_E">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Jayce"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Jayce"/>
        <lol-ontology:description>Стойка с молотом: Джейс наносит врагу магический урон и отбрасывает его назад на небольшое расстояние. Стойка с пушкой: Джейс устанавливает Врата ускорения, которые увеличивают скорость передвижения всех союзных чемпионов, проходящих через них. Если Шоковый заряд пролетает сквозь врата, его скорость, дальность поражения и урон увеличиваются.</lol-ontology:description>
        <lol-ontology:entityId>Jayce:E</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Грохочущий удар / Врата ускорения</lol-ontology:name>
        <lol-ontology:slot>E</lol-ontology:slot>
        <lol-ontology:tooltipText>Стойка с молотом : Джейс бьет своим молотом, отбрасывая цель и нанося магический урон в размере {{ spell.jaycethunderingblow:flatdamage }} плюс {{ spell.jaycethunderingblow:perchpdamage*100 }}% от максимального запаса здоровья .{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Jayce_E</rdfs:label>
    </owl:Thing>
    


