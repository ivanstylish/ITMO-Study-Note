        <rdfs:label>Soraka</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Soraka_E -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Soraka_E">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Soraka"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Soraka"/>
        <lol-ontology:description>Сорака создает в указанной области зону молчания. Враги, не успевшие покинуть ее до окончания времени ее действия, дополнительно обездвиживаются.</lol-ontology:description>
        <lol-ontology:entityId>Soraka:E</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Равноденствие</lol-ontology:name>
        <lol-ontology:slot>E</lol-ontology:slot>
        <lol-ontology:tooltipText>Сорака создает звездное поле, которое наносит {{ totaldamage }} магического урона чемпионам. Это поле существует {{ rootdelay }} сек. и накладывает безмолвие на врагов внутри. Когда поле исчезает, чемпионы внутри обездвиживаются на {{ rootduration }} сек. и получают {{ totaldamage }} магического урона .{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Soraka_E</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Soraka_P -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Soraka_P">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Soraka"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Soraka"/>
        <lol-ontology:description>Скорость передвижения Сораки увеличена при движении в сторону союзников, у которых осталось мало здоровья.</lol-ontology:description>
        <lol-ontology:entityId>Soraka:P</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Спасение</lol-ontology:name>
        <lol-ontology:slot>P</lol-ontology:slot>
        <rdfs:label>Soraka_P</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Soraka_Q -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Soraka_Q">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Soraka"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Soraka"/>
        <lol-ontology:description>По призыву Сораки с неба в указанную область падает звезда, нанося магический урон всем врагам в зоне поражения и замедляя их. Если умение поражает вражеского чемпиона, Сорака восстанавливает себе здоровье.</lol-ontology:description>
        <lol-ontology:entityId>Soraka:Q</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Звездопад</lol-ontology:name>
        <lol-ontology:slot>Q</lol-ontology:slot>
        <lol-ontology:tooltipText>По призыву Сораки с неба в указанную область падает звезда, которая наносит {{ totaldamage }} магического урона и замедляет врагов на {{ movespeedslow*100 }}% на {{ slowduration }} сек. При поражении вражеского чемпиона Сорака получает Обновление , которое восстанавливает ей {{ totalhot }} здоровья в течение {{ hotduration }} сек. и увеличивает ее скорость передвижения на {{ movespeedhaste*100 }}% (уменьшается в течение того же времени).{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Soraka_Q</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Soraka_R -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Soraka_R">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Soraka"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Soraka"/>
        <lol-ontology:description>Сорака наполняет сердца всех союзных чемпионов надеждой, восстанавливая себе и им здоровье.</lol-ontology:description>
        <lol-ontology:entityId>Soraka:R</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Желание</lol-ontology:name>
        <lol-ontology:slot>R</lol-ontology:slot>
        <lol-ontology:tooltipText>Сорака обращается к небесным силам, восстанавливая {{ healingcalc }} здоровья всем союзным чемпионам независимо от расстояния до них. Эффективность лечения увеличивается на {{ ampedhealing }} , если у цели менее 40% здоровья.{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Soraka_R</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Soraka_W -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Soraka_W">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Soraka"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Soraka"/>
        <lol-ontology:description>Сорака жертвует частью своего запаса здоровья, восстанавливая здоровье другому союзному чемпиону.</lol-ontology:description>
        <lol-ontology:entityId>Soraka:W</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Звездная пыль</lol-ontology:name>
        <lol-ontology:slot>W</lol-ontology:slot>
        <lol-ontology:tooltipText>Сорака восстанавливает {{ totalheal }} здоровья другому союзному чемпиону. Если на Сораку действует Обновление , затраты здоровья этого умения снижаются на {{ percenthealthcostrefund*100 }}%, а цель тоже получает Обновление на {{ spell.sorakaq:hotduration }} сек.{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Soraka_W</rdfs:label>
    </owl:Thing>
    


