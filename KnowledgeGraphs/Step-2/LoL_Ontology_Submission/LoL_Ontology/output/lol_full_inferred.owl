    <!-- https://example.org/lol-ontology#Renata_Q -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Renata_Q">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Renata"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Renata"/>
        <lol-ontology:description>Рената выпускает снаряд, который обездвиживает первого пораженного врага. При повторном применении она отбрасывает цель в выбранном направлении.</lol-ontology:description>
        <lol-ontology:entityId>Renata:Q</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Рукопожатие</lol-ontology:name>
        <lol-ontology:slot>Q</lol-ontology:slot>
        <lol-ontology:tooltipText>Рената выпускает из своей руки снаряд, который обездвиживает первого пораженного врага на {{ rootduration }} сек. и наносит ему {{ totaldamage }} магического урона . Повторное применение: Рената отбрасывает врага в выбранном направлении, нанося {{ totaldamage }} магического урона всем, с кем он сталкивается, и оглушая их на {{ stunduration }} сек., если отброшенная цель – чемпион.{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Renata_Q</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Renata_R -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Renata_R">
