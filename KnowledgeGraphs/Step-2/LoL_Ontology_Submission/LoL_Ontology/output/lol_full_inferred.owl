    <!-- https://example.org/lol-ontology#Zaahen_E -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Zaahen_E">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Zaahen"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Zaahen"/>
        <lol-ontology:description>Заахен совершает рывок в указанную точку и рассекает все вокруг себя.</lol-ontology:description>
        <lol-ontology:entityId>Zaahen:E</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Блестящий наскок</lol-ontology:name>
        <lol-ontology:slot>E</lol-ontology:slot>
        <lol-ontology:tooltipText>Заахен совершает рывок и рассекает все вокруг себя, нанося {{ basedamagecalc }} ед. физического урона врагам поблизости. Враги, задетые лезвием, вместо этого получают {{ bonusdamagecalc }} ед. физического урона + магический урон в размере {{ percenthpdamage*100 }}% от их максимального запаса здоровья .{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Zaahen_E</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Zaahen_P -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Zaahen_P">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Zaahen"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Zaahen"/>
        <lol-ontology:description>Попадая по вражеским чемпионам автоатаками и умениями, Заахен получает заряды Решительности. Каждый заряд дает ему дополнительную силу атаки. Когда Заахена переполняет Решительность, бонус к силе атаки повышается, и Заахен может возродиться.</lol-ontology:description>
        <lol-ontology:entityId>Zaahen:P</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Закалка воинственности</lol-ontology:name>
        <lol-ontology:slot>P</lol-ontology:slot>
        <rdfs:label>Zaahen_P</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Zaahen_Q -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Zaahen_Q">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Zaahen"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Zaahen"/>
        <lol-ontology:description>При следующей автоатаке Заахен совершает два удара, нанося дополнительный урон и восстанавливая здоровье. Заахен может применить умение повторно – в таком случае следующая автоатака нанесет дополнительный урон и подбросит цель.</lol-ontology:description>
        <lol-ontology:entityId>Zaahen:Q</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Глефа даркинов</lol-ontology:name>
        <lol-ontology:slot>Q</lol-ontology:slot>
        <lol-ontology:tooltipText>При следующей автоатаке Заахен совершает два удара, дополнительно нанося {{ initialdamage }} ед. физического урона и восстанавливая {{ healpercent*100 }}% от максимального запаса здоровья . Повторное применение: следующая автоатака Заахена дополнительно наносит {{ secondhitdamage }} ед. физического урона и подбрасывает цель на {{ knockupduration }} сек.{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Zaahen_Q</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Zaahen_R -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Zaahen_R">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Zaahen"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Zaahen"/>
        <lol-ontology:description>Заахен взмывает вверх и бьет вниз, нанося врагам урон и восстанавливая здоровье в размере части нанесенного урона.</lol-ontology:description>
        <lol-ontology:entityId>Zaahen:R</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Свирепое избавление</lol-ontology:name>
        <lol-ontology:slot>R</lol-ontology:slot>
        <lol-ontology:tooltipText>Пассивно : Заахен получает {{ armorpen*100 }}% %i:scaleAPen% пробивания брони . Активно : Заахен взмывает вверх. Во время применения получаемый им урон уменьшается на {{ damagereduction*100 }}%. Затем Заахен бьет вниз, нанося {{ damageendcalc }} ед. физического урона и восстанавливая здоровье в размере {{ healpercent*100 }}% от урона, нанесенного вражеским чемпионам .{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Zaahen_R</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Zaahen_W -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Zaahen_W">
