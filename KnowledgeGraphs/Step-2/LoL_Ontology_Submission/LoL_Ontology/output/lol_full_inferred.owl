    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Sivir_Q -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Sivir_Q">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Sivir"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Sivir"/>
        <lol-ontology:description>Сивир бросает свой клинок, как бумеранг, и он наносит урон по пути к точке назначения и обратно.</lol-ontology:description>
        <lol-ontology:entityId>Sivir:Q</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Клинок-бумеранг</lol-ontology:name>
        <lol-ontology:slot>Q</lol-ontology:slot>
        <lol-ontology:tooltipText>Сивир бросает свой клинок как бумеранг, нанося {{ totaldamage }} всем пораженным врагам. Клинок наносит меньше урона каждой последующей цели, не являющейся чемпионом, но не менее {{ falloffminimum*100 }}% от первоначального.{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Sivir_Q</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Sivir_R -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Sivir_R">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Sivir"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Sivir"/>
        <lol-ontology:description>Сивир ведет союзников в бой, увеличивая их скорость передвижения на некоторое время. Кроме того, автоатаки Сивир сокращают перезарядку ее умений.</lol-ontology:description>
        <lol-ontology:entityId>Sivir:R</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>На охоту</lol-ontology:name>
        <lol-ontology:slot>R</lol-ontology:slot>
        <lol-ontology:tooltipText>Сивир воодушевляет ближайших союзников, увеличивая их скорость передвижения на {{ maxms*100 }}% на {{ ultduration }} сек. Во время охоты автоатаки Сивир, поражающие чемпионов, сокращают перезарядку ее базовых умений на {{ attackcooldownrefund }} сек. Гибели врагов, недавно получивших урон от Сивир, обновляет продолжительность охоты.{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Sivir_R</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Sivir_W -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Sivir_W">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Sivir"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Sivir"/>
        <lol-ontology:description>Следующие несколько автоатак Сивир поразят рикошетом дополнительные цели, нанеся им уменьшенный урон. Кроме того, скорость этих атак будет увеличена.</lol-ontology:description>
        <lol-ontology:entityId>Sivir:W</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Рикошет</lol-ontology:name>
        <lol-ontology:slot>W</lol-ontology:slot>
        <lol-ontology:tooltipText>Сивир усиливается на {{ buffduration }} сек., увеличивая свою скорость атаки на {{ ricochetattackspeed*100 }}% . В течение этого времени ее автоатаки поражают рикошетом дополнительные цели, нанося им {{ bouncedamage }} физического урона (максимальное количество отскоков: {{ maxbounces }}). Если автоатака была критической, отскоки тоже наносят критический урон.{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Sivir_W</rdfs:label>
    </owl:Thing>
    


