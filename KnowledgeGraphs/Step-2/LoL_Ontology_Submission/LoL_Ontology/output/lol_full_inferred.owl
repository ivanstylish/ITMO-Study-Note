        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Nasus"/>
        <lol-ontology:description>Насус вытягивает духовную энергию врагов, увеличивая свой вампиризм.</lol-ontology:description>
        <lol-ontology:entityId>Nasus:P</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
