    <!-- https://example.org/lol-ontology#Quinn_E -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Quinn_E">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Quinn"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Quinn"/>
        <lol-ontology:description>Квинн делает рывок к врагу, нанося ему физический урон и замедляя его. Достигнув цели, она отпрыгивает обратно и приземляется на расстоянии, равном максимальной дальности автоатаки.</lol-ontology:description>
        <lol-ontology:entityId>Quinn:E</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Рывок</lol-ontology:name>
        <lol-ontology:slot>E</lol-ontology:slot>
        <lol-ontology:tooltipText>Квинн совершает рывок к врагу, нанося {{ totaldamage }} ед. физ. урона и накладывая метку Хищной птицы . Затем Квинн отскакивает от цели, немного ее отбрасывая и замедляя на {{ slowamount*100 }}% (эффект ослабевает за {{ slowdecaytime }} сек.).{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Quinn_E</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Quinn_P -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Quinn_P">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Quinn"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Quinn"/>
        <lol-ontology:description>Демасийский орел Квинн по кличке Вэлор периодически помечает врагов меткой Хищной птицы . 1-я автоатака Квинн против целей с меткой Хищной птицы наносит доп. физ. урон.</lol-ontology:description>
        <lol-ontology:entityId>Quinn:P</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Хищная птица</lol-ontology:name>
        <lol-ontology:slot>P</lol-ontology:slot>
        <rdfs:label>Quinn_P</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Quinn_Q -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Quinn_Q">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Quinn"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Quinn"/>
        <lol-ontology:description>Вэлор летит по прямой и нападает на первого встретившегося врага, помечая его меткой Уязвимости и значительно уменьшая его радиус обзора. После этого он атакует всех врагов поблизости, нанося им урон.</lol-ontology:description>
        <lol-ontology:entityId>Quinn:Q</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Слепящий удар</lol-ontology:name>
        <lol-ontology:slot>Q</lol-ontology:slot>
        <lol-ontology:tooltipText>Квинн приказывает Вэлору лететь вперед и атаковать 1-го врага на пути. Вэлор накладывает на цель метку Хищной птицы , снижая ее радиус обзора на {{ visionreductionduration }} сек., затем наносит {{ totaldamage }} ед. физ. урона всем врагам поблизости. Если 1-й пораженный враг – не чемпион, он обезоруживается на {{ visionreductionduration }} сек.{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Quinn_Q</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Quinn_R -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Quinn_R">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Quinn"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Quinn"/>
        <lol-ontology:description>Квинн и Вэлор объединяются, летя с существенно повышенной скоростью. По окончании действия умения применяется Небесный удар, наносящий урон ближайшим врагам и накладывающий на чемпионов метки Хищной птицы.</lol-ontology:description>
        <lol-ontology:entityId>Quinn:R</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>В тылу врага</lol-ontology:name>
        <lol-ontology:slot>R</lol-ontology:slot>
        <lol-ontology:tooltipText>Квинн готовится 2 сек., а затем приказывает Вэлору поднять ее в воздух. В воздухе Квинн получает {{ movementspeedmod*100 }}% скорости передвижения и может повторно применить это умение. Применив автоатаку, Слепящий удар или Рывок , Квинн автоматически повторно применяет это умение. Повторное применение : Квинн и Вэлор выполняют воздушный маневр, нанося врагам {{ damage }} ед. физ. урона и накладывая на чемпионов метку Хищной птицы . Действие умения прекращается.{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Quinn_R</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Quinn_W -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Quinn_W">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Quinn"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Quinn"/>
        <lol-ontology:description>Когда Квинн атакует врага, помеченного меткой Хищной птицы , ее скорость атаки и скорость передвижения растут. Активируя умение, Вэлор раскрывает большую область поблизости.</lol-ontology:description>
        <lol-ontology:entityId>Quinn:W</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Обостренные чувства</lol-ontology:name>
        <lol-ontology:slot>W</lol-ontology:slot>
        <lol-ontology:tooltipText>Пассивно: атакуя врага с меткой Хищной птицы , Квинн получает {{ attackspeedbonus*100 }}% скорости атаки и {{ movespeedamount*100 }}% скорости передвижения на {{ buffduration }} сек. Активно: Вэлор раскрывает большую область поблизости на {{ visionduration }} сек.{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Quinn_W</rdfs:label>
    </owl:Thing>
    


