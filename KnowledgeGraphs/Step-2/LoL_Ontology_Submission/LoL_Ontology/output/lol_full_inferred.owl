    <!-- https://example.org/lol-ontology#Milio_E -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Milio_E">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Milio"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Milio"/>
        <lol-ontology:description>Милио накладывает щит на союзника, временно повышая его скорость передвижения. У этого умения может быть до 2 зарядов.</lol-ontology:description>
        <lol-ontology:entityId>Milio:E</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Теплые объятия</lol-ontology:name>
        <lol-ontology:slot>E</lol-ontology:slot>
        <lol-ontology:tooltipText>Милио окружает союзного чемпиона защитным пламенем, накладывая на него щит прочностью {{ shieldcalc }} и увеличивая его скорость передвижения на {{ movespeedamount*100 }}% на {{ movespeedduration }} сек. У этого умения может быть до 2 зарядов. Эффект суммируется.{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Milio_E</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Milio_P -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Milio_P">
