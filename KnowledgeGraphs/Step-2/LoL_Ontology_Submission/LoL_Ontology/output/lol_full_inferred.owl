    <!-- https://example.org/lol-ontology#Sejuani_E -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Sejuani_E">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Sejuani"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Sejuani"/>
        <lol-ontology:description>Седжуани замораживает и оглушает вражеского чемпиона с максимальным количеством зарядов Мороза.</lol-ontology:description>
        <lol-ontology:entityId>Sejuani:E</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Вечная мерзлота</lol-ontology:name>
        <lol-ontology:slot>E</lol-ontology:slot>
        <lol-ontology:tooltipText>Пассивно: автоатаки окружающих союзных чемпионов ближнего боя накладывают заряды на чемпионов и лесных монстров. Активно: Седжуани наносит {{ totaldamage }} ед. маг. урона выбранному врагу с 4 зар. и оглушает его на {{ ccduration }} сек. {{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Sejuani_E</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Sejuani_P -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Sejuani_P">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Sejuani"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Sejuani"/>
        <lol-ontology:description>Если Седжуани находится вне боя, она получает Морозную броню, и ее броня и сопротивление магии значительно увеличиваются, кроме того, она становится невосприимчива к эффектам замедления. Морозная броня пропадает спустя короткое время после получения урона. Седжуани может атаковать замороженного врага, разбив лед и нанеся значительный магический урон.</lol-ontology:description>
        <lol-ontology:entityId>Sejuani:P</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Ярость севера</lol-ontology:name>
        <lol-ontology:slot>P</lol-ontology:slot>
        <rdfs:label>Sejuani_P</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Sejuani_Q -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Sejuani_Q">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Sejuani"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Sejuani"/>
        <lol-ontology:description>Седжуани совершает рывок вперед, подбрасывая врагов в воздух. Рывок прекращается при столкновении с вражеским чемпионом.</lol-ontology:description>
        <lol-ontology:entityId>Sejuani:Q</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Арктическое наступление</lol-ontology:name>
        <lol-ontology:slot>Q</lol-ontology:slot>
        <lol-ontology:tooltipText>Седжуани совершает рывок, нанося {{ totaldamagetooltip }} ед. маг. урона врагам на пути и подбрасывая их на {{ knockupdurationtooltiponly }} сек. Рывок прекращается при столкновении с вражеским чемпионом.{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Sejuani_Q</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Sejuani_R -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Sejuani_R">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Sejuani"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Sejuani"/>
        <lol-ontology:description>Седжуани бросает болас, который замораживает и оглушает первого врага на пути, а также создает ледяную бурю, которая замедляет остальных врагов.</lol-ontology:description>
        <lol-ontology:entityId>Sejuani:R</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Ледниковый плен</lol-ontology:name>
        <lol-ontology:slot>R</lol-ontology:slot>
        <lol-ontology:tooltipText>Седжуани кидает болас из Истинного льда, оглушая и раскрывая первого вражеского чемпиона на пути на {{ basestunduration }} сек., а также нанося ему {{ minordamagetooltip }} ед. маг. урона . Если болас пролетел хотя бы 25% от макс. дальности, длительность оглушения и раскрытия растут до {{ empoweredstunduration }} сек. Также он создает ледяную бурю, замедляющую окружающих врагов на {{ explosionslowamount }}% на {{ zoneduration }} сек. Все пораженные враги получают {{ totaldamagetooltip }} ед. маг. урона .{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Sejuani_R</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Sejuani_W -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Sejuani_W">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Sejuani"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Sejuani"/>
        <lol-ontology:description>Седжуани дважды взмахивает своей булавой, нанося урон, замедляя врагов и накладывая заряды Мороза.</lol-ontology:description>
        <lol-ontology:entityId>Sejuani:W</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Гнев зимы</lol-ontology:name>
        <lol-ontology:slot>W</lol-ontology:slot>
        <lol-ontology:tooltipText>Седжуани раскручивает цеп, нанося {{ firsthitdamagetooltip }} физического урона и отбрасывая миньонов и лесных монстров. После этого она запускает цеп вперед, нанося {{ secondhitdamagetooltip }} физического урона и ненадолго замедляя цели. Оба удара накладывают заряды Вечной мерзлоты .{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Sejuani_W</rdfs:label>
    </owl:Thing>
    


