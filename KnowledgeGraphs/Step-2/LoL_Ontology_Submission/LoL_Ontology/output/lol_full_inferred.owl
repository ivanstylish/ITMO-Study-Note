        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Renata"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Renata"/>
        <lol-ontology:description>Автоатаки Ренаты наносят дополнительный урон и помечают врагов. Когда союзники наносят урон помеченным врагам, те получают дополнительный урон.</lol-ontology:description>
        <lol-ontology:entityId>Renata:P</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Рычаг давления</lol-ontology:name>
