        <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Ashe"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Ashe"/>
        <lol-ontology:description>Автоатаки Эш замедляют врагов и помечают их. Помеченным целям Эш наносит дополнительный урон. Критические удары Эш не наносят увеличенного урона, однако сильнее замедляют цель.</lol-ontology:description>
        <lol-ontology:entityId>Ashe:P</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
