    <!-- https://example.org/lol-ontology#Alistar_E -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Alistar_E">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Alistar"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Alistar"/>
        <lol-ontology:description>Алистар топчет ближайших врагов, получая возможность проходить сквозь бойцов и накапливая заряд за каждое повреждение вражеского чемпиона. При накоплении максимального количества зарядов следующая автоатака Алистара нанесет вражескому чемпиону дополнительный магический урон и оглушит его.</lol-ontology:description>
        <lol-ontology:entityId>Alistar:E</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Топот</lol-ontology:name>
        <lol-ontology:slot>E</lol-ontology:slot>
        <lol-ontology:tooltipText>Алистар начинает топтать землю, получая призрачность и нанося {{ totaldamage }} ед. магического урона врагам поблизости в течение {{ duration }} сек. Каждая волна умения, нанесшая урон чемпиону, дает Алистару заряд. Когда Алистар накапливает {{ maxstacks }} зар., его следующая автоатака против чемпиона оглушает цель на {{ stunduration }} сек. и дополнительно наносит {{ attackbonusdamage }} ед. магического урона .{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Alistar_E</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Alistar_P -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Alistar_P">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Alistar"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Alistar"/>
        <lol-ontology:description>Алистар готовит свой рев, оглушая или смещая вражеских чемпионов, а также находясь рядом с умирающими врагами. Заряженный рев восстанавливает здоровье Алистару и всем ближайшим союзным чемпионам.</lol-ontology:description>
        <lol-ontology:entityId>Alistar:P</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Торжествующий рев</lol-ontology:name>
        <lol-ontology:slot>P</lol-ontology:slot>
        <rdfs:label>Alistar_P</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Alistar_Q -->

