        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Singed"/>
        <lol-ontology:description>Синджед оставляет позади себя ядовитый след, который наносит урон всем попавшим в него врагам.</lol-ontology:description>
        <lol-ontology:entityId>Singed:Q</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Ядовитый след</lol-ontology:name>
        <lol-ontology:slot>Q</lol-ontology:slot>
        <lol-ontology:tooltipText>Переключение: Синджед оставляет позади себя ядовитый след, который наносит {{ damagepersecond }} магического урона в секунду.{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Singed_Q</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Singed_R -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Singed_R">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Singed"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Singed"/>
        <lol-ontology:description>Синджед выпивает мощное зелье, и его боевые показатели увеличиваются, а Ядовитый след начинает накладывать Страшные раны.</lol-ontology:description>
        <lol-ontology:entityId>Singed:R</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Зелье безумия</lol-ontology:name>
        <lol-ontology:slot>R</lol-ontology:slot>
        <lol-ontology:tooltipText>Синджед выпивает мощное химическое зелье, которое увеличивает его силу умений , прочность брони , сопротивление магии , скорость передвижения , восстановление здоровья и восстановление маны на {{ statamount }}. Эффект действует {{ duration }} сек. Когда он активен, Ядовитый след Синджеда накладывает Страшные раны ({{ grievousamount*100 }}%) на {{ grievousduration }} сек.{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Singed_R</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Singed_W -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Singed_W">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Singed"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Singed"/>
        <lol-ontology:description>Синджед разбивает о землю флакон мегаклея. Враги, проходящие по клею, замедляются и теряют способность использовать умения перемещения.</lol-ontology:description>
        <lol-ontology:entityId>Singed:W</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Мегаклей</lol-ontology:name>
        <lol-ontology:slot>W</lol-ontology:slot>
        <lol-ontology:tooltipText>Синджед бросает склянку с клейкой субстанцией, парализуя и замедляя врагов в области действия на {{ slowpercent }}% на {{ wduration }} сек.{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Singed_W</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Sion -->

