        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Riven"/>
        <lol-ontology:description>Ривен излучает энергию Ци, нанося урон всем окружающим врагам и оглушая их.</lol-ontology:description>
        <lol-ontology:entityId>Riven:W</lol-ontology:entityId>
