        <lol-ontology:baseAttackDamage rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">62.0</lol-ontology:baseAttackDamage>
        <lol-ontology:baseHP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">580.0</lol-ontology:baseHP>
        <lol-ontology:baseMP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">315.0</lol-ontology:baseMP>
