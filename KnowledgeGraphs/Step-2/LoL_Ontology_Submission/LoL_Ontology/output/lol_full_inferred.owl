    <!-- https://example.org/lol-ontology#Jax_E -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Jax_E">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Jax"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Jax"/>
        <lol-ontology:description>Искусность Джакса позволяет ему некоторое время уклоняться ото всех автоатак, а затем контратаковать, оглушая всех противников вокруг себя.</lol-ontology:description>
        <lol-ontology:entityId>Jax:E</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Встречный удар</lol-ontology:name>
        <lol-ontology:slot>E</lol-ontology:slot>
        <lol-ontology:tooltipText>Джакс принимает защитную стойку на срок до {{ dodgeduration }} сек., уклоняясь от всех автоатак и получая на {{ aoedamagereduction }}% меньше урона от умений, действующих по площади. Через {{ dodgeduration }} сек. или при повторном применении Джакс наносит врагам поблизости магический урон в размере {{ totaldamage }} + {{ percenthealthdamage }}% от максимального запаса здоровья и оглушает их на {{ stunduration }} сек. Умение наносит на {{ percentincreasedperdodge*100 }}% больше урона за каждую автоатаку, от которой уклонился Джакс (максимальная прибавка – {{ maxdamage }} + {{ maxpercenthealthdamage }}% от максимального запаса здоровья ).{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Jax_E</rdfs:label>
    </owl:Thing>
    


