        <lol-ontology:hasAbility rdf:resource="https://example.org/lol-ontology#DrMundo_P"/>
        <lol-ontology:hasAbility rdf:resource="https://example.org/lol-ontology#DrMundo_Q"/>
        <lol-ontology:hasAbility rdf:resource="https://example.org/lol-ontology#DrMundo_R"/>
        <lol-ontology:hasAbility rdf:resource="https://example.org/lol-ontology#DrMundo_W"/>
        <lol-ontology:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Fighter"/>
        <lol-ontology:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Tank"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_DrMundo"/>
