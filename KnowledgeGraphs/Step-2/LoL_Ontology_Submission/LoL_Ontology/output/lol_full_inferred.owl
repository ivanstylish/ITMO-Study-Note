    <!-- https://example.org/lol-ontology#Kassadin_E -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Kassadin_E">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Kassadin"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Kassadin"/>
        <lol-ontology:description>Кассадин вытягивает энергию из заклинаний, применяющихся вокруг. Когда вытянуто достаточно энергии, Кассадин может использовать Выброс силы, чтобы нанести урон и замедлить противников перед собой.</lol-ontology:description>
        <lol-ontology:entityId>Kassadin:E</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Выброс силы</lol-ontology:name>
        <lol-ontology:slot>E</lol-ontology:slot>
        <lol-ontology:tooltipText>Пассивно: перезарядка умения Выброс силы сокращается на {{ reductionperspellcast }} сек. каждый раз, когда около Кассадина применяется любое умение. Активно: Кассадин выпускает волну энергии Бездны, нанося {{ totaldamage }} ед. маг. урона и замедляя цели на {{ slowamount }}% на {{ slowduration }} сек.{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Kassadin_E</rdfs:label>
    </owl:Thing>
    


