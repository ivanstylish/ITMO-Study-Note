    <!-- https://example.org/lol-ontology#Shen_E -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Shen_E">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Shen"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Shen"/>
        <lol-ontology:description>Шен совершает рывок в указанном направлении, провоцируя вражеских чемпионов на своем пути.</lol-ontology:description>
        <lol-ontology:entityId>Shen:E</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Теневой рывок</lol-ontology:name>
        <lol-ontology:slot>E</lol-ontology:slot>
        <lol-ontology:tooltipText>Пассивно: Шен восстанавливает {{ energyrefund }} энергии , когда наносит урон с помощью этого умения или Сумеречной атаки . Активно: Шен совершает рывок, провоцируя чемпионов и лесных монстров на {{ ccduration }} сек., а также нанося им {{ tauntdamage }} физического урона .{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Shen_E</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Shen_P -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Shen_P">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Shen"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Shen"/>
        <lol-ontology:description>После применения умения Шен получает щит. Если умение оказывает воздействие на союзного или вражеского чемпиона, время перезарядки Барьера Ци сокращается.</lol-ontology:description>
        <lol-ontology:entityId>Shen:P</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Барьер Ци</lol-ontology:name>
        <lol-ontology:slot>P</lol-ontology:slot>
        <rdfs:label>Shen_P</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Shen_Q -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Shen_Q">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Shen"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Shen"/>
        <lol-ontology:description>Шен призывает призрачный клинок, после чего его следующие автоатаки наносят урон, зависящий от максимального запаса здоровья цели. Если клинок на своем пути к Шену задевает вражеского чемпиона, автоатаки дополнительно существенно усиливаются, а задетый чемпион замедляется при попытке убежать от Шена.</lol-ontology:description>
        <lol-ontology:entityId>Shen:Q</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Сумеречная атака</lol-ontology:name>
        <lol-ontology:slot>Q</lol-ontology:slot>
        <lol-ontology:tooltipText>Шен призывает к себе призрачный клинок . Пораженные враги замедляются на {{ slowpercent }}% при движении от Шена в течение следующих {{ slowduration }} сек. Кроме того, следующие автоатаки ({{ numenhancedattacks }}) Шена дополнительно наносят маг. урон в размере {{ baseflatdamage }} плюс {{ basepercenthealth }} от макс. здоровья . Если призрачный клинок задел вражеского чемпиона, урон растет до {{ baseflatdamage }} плюс {{ emppercenthealth }} от макс. здоровья , а скорость усиленных автоатак Шена растет на {{ steroidas }}% .{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Shen_Q</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Shen_R -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Shen_R">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Shen"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Shen"/>
        <lol-ontology:description>Шен защищает союзного чемпиона поглощающим урон щитом и через некоторое время телепортируется к нему на помощь.</lol-ontology:description>
        <lol-ontology:entityId>Shen:R</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Плечом к плечу</lol-ontology:name>
        <lol-ontology:slot>R</lol-ontology:slot>
        <lol-ontology:tooltipText>Шен выбирает любого союзного чемпиона на карте и накладывает на него щит прочностью от {{ shield }} до {{ maxshield }} в зависимости от недостающего здоровья цели на {{ shieldduration }} сек. (максимальная прочность достигается при 60% недостающего здоровья). Спустя {{ channelduration }} сек. подготовки Шен телепортируется к цели со своим призрачным клинком .{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Shen_R</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Shen_W -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Shen_W">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Shen"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Shen"/>
        <lol-ontology:description>Призрачный клинок блокирует автоатаки, направленные против Шена и союзных чемпионов, в зоне вокруг себя.</lol-ontology:description>
        <lol-ontology:entityId>Shen:W</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Пристанище духа</lol-ontology:name>
        <lol-ontology:slot>W</lol-ontology:slot>
        <lol-ontology:tooltipText>Шен создает вокруг своего призрачного клинка охраняемую зону на {{ zoneduration }} сек. Автоатаки против союзных чемпионов в этой области блокируются. Если в момент применения рядом в зоне не будет чемпионов, ее создание отсрочивается на время до {{ zonedelay }} сек.{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Shen_W</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Shield -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Shield">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Mechanic"/>
        <lol-ontology:name>Щит</lol-ontology:name>
        <rdfs:label>Shield</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Shyvana -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Shyvana">
