    <!-- https://example.org/lol-ontology#Ashe_Q -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Ashe_Q">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Ashe"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Ashe"/>
        <lol-ontology:description>Автоатаки Эш повышают Сосредоточенность. Когда накапливается максимальное количество зарядов, умение можно активировать. При этом все заряды Сосредоточенности поглощаются, и скорость атаки Эш на некоторое время увеличивается. Кроме того, в течение этого времени при каждой автоатаке Эш выпускает град стрел.</lol-ontology:description>
        <lol-ontology:entityId>Ashe:Q</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Сосредоточенность стрелка</lol-ontology:name>
        <lol-ontology:slot>Q</lol-ontology:slot>
        <lol-ontology:tooltipText>Пассивно: каждая автоатака Эш дает ей заряд на {{ stackduration }} сек. Набрав {{ maxstacks }} зар., она может применить это умение. Активно: Эш на {{ buffduration }} сек. получает {{ bonusas }}% скорости атаки , и ее автоатаки в течение этого времени наносят {{ empowereddamage }} ед. урона .{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Ashe_Q</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Ashe_R -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Ashe_R">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Ashe"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Ashe"/>
        <lol-ontology:description>Эш выпускает ледяную стрелу в указанном направлении. Если стрела попадает во вражеского чемпиона, она наносит урон и оглушает его на некоторое время (зависит от дальности полета стрелы). Окружающие цель противники тоже получают урон и замедляются.</lol-ontology:description>
        <lol-ontology:entityId>Ashe:R</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Зачарованная ледяная стрела</lol-ontology:name>
        <lol-ontology:slot>R</lol-ontology:slot>
        <lol-ontology:tooltipText>Эш выпускает ледяную стрелу, которая оглушает первого пораженного чемпиона и наносит ему {{ rmaindamage }} ед. магического урона . Длительность оглушения зависит от дальности полета стрелы (но не может превышать {{ maxstunduration }} сек.). Окружающие чемпиона враги замедляются Морозным выстрелом .{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Ashe_R</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Ashe_W -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Ashe_W">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Ashe"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Ashe"/>
        <lol-ontology:description>Эш выпускает веер из стрел, нанося увеличенный урон. Умение также накладывает эффект Морозного выстрела.</lol-ontology:description>
        <lol-ontology:entityId>Ashe:W</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Залп</lol-ontology:name>
        <lol-ontology:slot>W</lol-ontology:slot>
        <lol-ontology:tooltipText>Эш выпускает веер из {{ numberofarrowstooltip }} стрел, каждая из которых наносит {{ totaldamage }} физического урона . Врагов могут поразить нескольких стрел, но урон им нанесет только первая.{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Ashe_W</rdfs:label>
    </owl:Thing>
    


