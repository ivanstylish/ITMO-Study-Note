        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasEffect rdf:resource="https://example.org/lol-ontology#Karma_E_MovementSpeedBoost_Ally"/>
        <lol-ontology:hasEffect rdf:resource="https://example.org/lol-ontology#Karma_E_Shield_Ally"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Karma"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Karma"/>
        <lol-ontology:description>Карма защищает союзника щитом, поглощающим урон и увеличивающим его скорость передвижения. Эффект Мантры: щит излучает энергию, которая увеличивает его прочность и накладывает Воодушевление на ближайших союзных чемпионов.</lol-ontology:description>
        <lol-ontology:entityId>Karma:E</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Воодушевление</lol-ontology:name>
        <lol-ontology:slot>E</lol-ontology:slot>
        <lol-ontology:tooltipText>Карма накладывает на союзного чемпиона щит прочностью {{ totalshield }} на {{ shieldduration }} сек. и увеличивает его скорость передвижения на {{ movespeed*100 }}% на {{ movespeedduration }} сек.{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Karma_E</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Karma_E_MovementSpeedBoost_Ally -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Karma_E_MovementSpeedBoost_Ally">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#AbilityEffect"/>
        <lol-ontology:effectOf rdf:resource="https://example.org/lol-ontology#Karma_E"/>
        <lol-ontology:hasMechanic rdf:resource="https://example.org/lol-ontology#MovementSpeedBoost"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Karma"/>
        <lol-ontology:hasTargetType rdf:resource="https://example.org/lol-ontology#Ally"/>
