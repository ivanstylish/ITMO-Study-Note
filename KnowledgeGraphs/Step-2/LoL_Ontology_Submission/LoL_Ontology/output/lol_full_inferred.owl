    <!-- https://example.org/lol-ontology#Caitlyn_E -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Caitlyn_E">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Caitlyn"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Caitlyn"/>
        <lol-ontology:description>Кейтлин выстреливает тяжелой сетью, замедляя цель. Отдача отбрасывает ее назад.</lol-ontology:description>
        <lol-ontology:entityId>Caitlyn:E</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Сеть 90 калибра</lol-ontology:name>
        <lol-ontology:slot>E</lol-ontology:slot>
        <lol-ontology:tooltipText>Кейтлин выстреливает сетью, отталкивая себя назад. Сеть замедляет первого пораженного врага на {{ slowamount }}% на {{ slowduration }} сек. и наносит {{ netdamage }} ед. маг. урона .{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Caitlyn_E</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Caitlyn_P -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Caitlyn_P">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Caitlyn"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Caitlyn"/>
        <lol-ontology:description>Каждые несколько автоатак или при атаке пойманных в ловушку или сеть врагов Кейтлин стреляет противнику в голову, нанося дополнительный урон, зависящий от шанса критического удара. При стрельбе по пойманным в ловушку или сеть врагам дальность автоатаки увеличивается вдвое.</lol-ontology:description>
        <lol-ontology:entityId>Caitlyn:P</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Выстрел в голову</lol-ontology:name>
        <lol-ontology:slot>P</lol-ontology:slot>
        <rdfs:label>Caitlyn_P</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Caitlyn_Q -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Caitlyn_Q">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Caitlyn"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Caitlyn"/>
        <lol-ontology:description>Кейтлин подстраивает свою винтовку в течение секунды, а затем делает выстрел, который пробивает врагов насквозь, нанося всем пораженным целям физический урон (каждая следующая цель получает меньший урон).</lol-ontology:description>
        <lol-ontology:entityId>Caitlyn:Q</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Пилтоверский миротворец</lol-ontology:name>
        <lol-ontology:slot>Q</lol-ontology:slot>
        <lol-ontology:tooltipText>Кейтлин подстраивает свою винтовку, а затем совершает выстрел пробивной пулей, нанося {{ initialdamage }} физического урона . Поразив первую цель, пуля раскрывается и продолжает полет, нанося {{ secondarydamage }} физического урона последующим целям. Враги, раскрытые умением Ловушка на йордлов , всегда получают полный урон.{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Caitlyn_Q</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Caitlyn_R -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Caitlyn_R">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Caitlyn"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Caitlyn"/>
        <lol-ontology:description>Кейтлин тщательно прицеливается и делает превосходный выстрел, наносящий огромный урон одиночной цели на гигантском расстоянии. Вражеские чемпионы могут заслонить собой своего союзника.</lol-ontology:description>
        <lol-ontology:entityId>Caitlyn:R</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Главный козырь</lol-ontology:name>
        <lol-ontology:slot>R</lol-ontology:slot>
        <lol-ontology:tooltipText>Кейтлин тщательно прицеливается, а затем делает превосходный выстрел, нанося {{ rtotaldamage }} ед. физического урона . Другие вражеские чемпионы могут заслонить собой цель. Это умение дает истинное видение цели на время подготовки умения. Урон повышается в зависимости от шанса критического удара и критического урона Кейтлин. {{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Caitlyn_R</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Caitlyn_W -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Caitlyn_W">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Caitlyn"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Caitlyn"/>
        <lol-ontology:description>Кейтлин устанавливает ловушку. После срабатывания она раскрывает и обездвиживает вражеского чемпиона на 1.5 сек., а также позволяет Кейтлин применить усиленный Выстрел в голову.</lol-ontology:description>
        <lol-ontology:entityId>Caitlyn:W</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Ловушка на йордлов</lol-ontology:name>
        <lol-ontology:slot>W</lol-ontology:slot>
        <lol-ontology:tooltipText>Кейтлин устанавливает ловушку, которая обездвиживает первого ступившего на нее чемпиона на {{ rootduration }} сек., а также дает истинное видение цели на 3 сек. Ловушки существуют {{ trapduration }} сек., а одновременно можно установить не более {{ maximumtraps }} ловушек. У этого умения может быть до {{ maximumcharges }} зар. (новый заряд дается раз в {{ ammorechargetime }} сек.). Цели, обездвиженные этим умением, дополнительно получают {{ headshotbonusdamage }} ед. физического урона от Выстрела в голову .{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Caitlyn_W</rdfs:label>
    </owl:Thing>
    


