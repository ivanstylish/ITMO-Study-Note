        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Akali"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Akali"/>
        <lol-ontology:description>Акали совершает сальто назад и бросает перед собой сюрикен, нанося магический урон и помечая первого пораженного врага или дымовую завесу. При повторном применении Акали совершает рывок к помеченной цели, нанося дополнительный урон.</lol-ontology:description>
        <lol-ontology:entityId>Akali:E</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Сюрикен убийцы</lol-ontology:name>
        <lol-ontology:slot>E</lol-ontology:slot>
        <lol-ontology:tooltipText>Акали совершает сальто назад и бросает перед собой сюрикен, нанося {{ e1damage }} магического урона и помечая первого пораженного врага или дымовую завесу. Акали может повторно применить это умение, чтобы совершить рывок к помеченной цели, нанеся {{ e2damagecalc }} магического урона .{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Akali_E</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Akali_P -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Akali_P">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Akali"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Akali"/>
        <lol-ontology:description>При нанесении урона умением чемпиону вокруг него появляется круг энергии. При выходе из круга Акали усиливает следующую автоатаку, увеличивая ее дальность и урон.</lol-ontology:description>
        <lol-ontology:entityId>Akali:P</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
