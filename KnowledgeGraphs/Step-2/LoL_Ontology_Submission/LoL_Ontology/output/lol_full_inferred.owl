        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Velkoz"/>
        <lol-ontology:description>Вел&apos;Коз вызывает взрыв в указанной области. Враги, оказавшиеся в эпицентре, подбрасываются в воздух, а оказавшиеся рядом с Вел&apos;Козом отбрасываются в направлении взрыва.</lol-ontology:description>
        <lol-ontology:entityId>Velkoz:E</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
