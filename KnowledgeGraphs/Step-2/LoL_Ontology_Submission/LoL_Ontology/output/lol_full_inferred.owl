        <lol-ontology:baseMoveSpeed rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">340.0</lol-ontology:baseMoveSpeed>
        <lol-ontology:entityId>Graves</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
