    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Amumu_Q -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Amumu_Q">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Amumu"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Amumu"/>
        <lol-ontology:description>Амуму кидает во врага бинт. При попадании бинт приклеивается к врагу, оглушая его, и Амуму подтягивается к цели, нанося ей урон.</lol-ontology:description>
        <lol-ontology:entityId>Amumu:Q</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Бросок бинта</lol-ontology:name>
        <lol-ontology:slot>Q</lol-ontology:slot>
        <lol-ontology:tooltipText>Амуму выпускает бинт и притягивается к первому пораженному врагу, оглушая его на {{ stunduration }} сек. и нанося {{ totaldamage }} ед. маг. урона . У этого умения может быть до 2 зарядов.{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Amumu_Q</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Amumu_R -->

