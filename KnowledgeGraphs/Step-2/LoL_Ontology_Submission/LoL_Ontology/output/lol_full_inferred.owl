    <!-- https://example.org/lol-ontology#Garen_E -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Garen_E">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Garen"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Garen"/>
        <lol-ontology:description>Гарен быстро вращается на месте с мечом в руках, нанося физический урон врагам поблизости.</lol-ontology:description>
        <lol-ontology:entityId>Garen:E</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Вердикт</lol-ontology:name>
        <lol-ontology:slot>E</lol-ontology:slot>
        <lol-ontology:tooltipText>Гарен быстро вращает меч вокруг себя в течение {{ duration }} сек., нанося окружающим врагам {{ totaldamage }} ед. физического урона {{ f1 }} р. Ближайший враг получает на {{ nearestenemybonus*100 }}% больше урона . Чемпионы, пораженные хотя бы {{ stackstoshred }} ударами, теряют {{ shredamount*100 }}% брони на {{ shredduration }} сек. Повторное применение : действие этого умения прекращается преждевременно.{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Garen_E</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Garen_P -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Garen_P">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Garen"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Garen"/>
        <lol-ontology:description>Если Гарен не получает урона и не подвергается действию вражеских умений в течение некоторого времени, он начинает восстанавливать часть от своего общего запаса здоровья каждую секунду.</lol-ontology:description>
        <lol-ontology:entityId>Garen:P</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Упорство</lol-ontology:name>
        <lol-ontology:slot>P</lol-ontology:slot>
        <rdfs:label>Garen_P</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Garen_Q -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Garen_Q">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Garen"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Garen"/>
        <lol-ontology:description>Гарен избавляется ото всех замедляющих эффектов, и его скорость передвижения увеличивается. Его следующая автоатака поражает слабое место цели, заставляя ее замолчать и нанося ей дополнительный урон.</lol-ontology:description>
        <lol-ontology:entityId>Garen:Q</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Решающий удар</lol-ontology:name>
        <lol-ontology:slot>Q</lol-ontology:slot>
        <lol-ontology:tooltipText>Гарен снимает с себя все эффекты замедления и получает {{ movementspeedamount*100 }}% скорости передвижения на {{ movementspeedduration }} сек. Его следующая автоатака накладывает на цель безмолвие на {{ silenceduration }} сек. и наносит ей {{ totaldamage }} физического урона .{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Garen_Q</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Garen_R -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Garen_R">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Garen"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Garen"/>
        <lol-ontology:description>Гарен призывает мощь Демасии, чтобы казнить вражеского чемпиона.</lol-ontology:description>
        <lol-ontology:entityId>Garen:R</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Правосудие Демасии</lol-ontology:name>
        <lol-ontology:slot>R</lol-ontology:slot>
        <lol-ontology:tooltipText>Гарен призывает мощь Демасии, чтобы сразить вражеского чемпиона, нанося чистый урон в размере {{ basedamage }} плюс {{ executedamage*100 }}% от недостающего здоровья цели .{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Garen_R</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Garen_W -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Garen_W">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Garen"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Garen"/>
        <lol-ontology:description>Броня и сопротивление магии Гарена увеличиваются, когда он убивает врагов. При активации умения он получает щит и значительный бонус к стойкости на короткий период. В течение оставшегося времени действия Гарен получает немного меньше урона.</lol-ontology:description>
        <lol-ontology:entityId>Garen:W</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Храбрость</lol-ontology:name>
        <lol-ontology:slot>W</lol-ontology:slot>
        <lol-ontology:tooltipText>Пассивно: Гарен имеет{{ resistsfortooltip }} дополнительной брони и {{ resistsfortooltip }} дополнительного сопротивления магии . Каждое убийство бойца навсегда дает защитные показатели в размере {{ resistgainonkilltooltip }} (максимальный бонус – {{ resistmax }} ). Активно: Гарен становится храбрее на {{ drduration }} сек., уменьшая получаемый урон на {{ drpercent*100 }}%. Кроме того, он получает щит прочностью {{ totalshield }} и {{ upfronttenacity*100 }}% стойкости на {{ upfrontduration }} сек.{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Garen_W</rdfs:label>
    </owl:Thing>
    


