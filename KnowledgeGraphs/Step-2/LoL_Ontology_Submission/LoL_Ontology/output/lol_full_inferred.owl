    <!-- https://example.org/lol-ontology#Annie_E -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Annie_E">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Annie"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Annie"/>
        <lol-ontology:description>Энни накладывает на себя или на союзника щит, кратковременно увеличивает скорость передвижения цели, а также наносит урон врагам, которые поражают ее автоатаками или умениями.</lol-ontology:description>
        <lol-ontology:entityId>Annie:E</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Пылающий щит</lol-ontology:name>
        <lol-ontology:slot>E</lol-ontology:slot>
        <lol-ontology:tooltipText>Энни накладывает на союзного чемпиона щит прочностью {{ shieldblocktotal }} на {{ shieldduration }} сек. и увеличивает скорость передвижения цели на {{ movespeedcalc }} (эффект пропадает в течение {{ movementspeedduration }} сек.). Пока существует щит, враги, которые поражают соответствующего союзника автоатаками или умениями, получают {{ damagereturn }} магического урона (не более одного раза за каждый щит). Тибберс всегда получает эффекты Пылающего щита во время призыва.{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Annie_E</rdfs:label>
    </owl:Thing>
    


