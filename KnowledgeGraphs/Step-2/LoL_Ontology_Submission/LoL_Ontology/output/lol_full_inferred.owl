        <lol-ontology:baseMP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.0</lol-ontology:baseMP>
        <lol-ontology:baseMoveSpeed rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">345.0</lol-ontology:baseMoveSpeed>
        <lol-ontology:entityId>DrMundo</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Доктор Мундо</lol-ontology:name>
        <lol-ontology:resourceType>Нет</lol-ontology:resourceType>
        <lol-ontology:reviewStatus>effects_not_reviewed</lol-ontology:reviewStatus>
        <lol-ontology:title>Сумасшедший из Зауна</lol-ontology:title>
        <rdfs:label>DrMundo</rdfs:label>
