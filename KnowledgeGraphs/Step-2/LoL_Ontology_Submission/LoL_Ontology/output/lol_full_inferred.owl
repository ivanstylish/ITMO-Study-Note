    <!-- https://example.org/lol-ontology#Sivir_E -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Sivir_E">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Sivir"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Sivir"/>
        <lol-ontology:description>Сивир создает магический барьер, который блокирует одно вражеское умение. При успешном срабатывании он восстанавливает Сивир здоровье и ненадолго ее ускоряет.</lol-ontology:description>
        <lol-ontology:entityId>Sivir:E</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Щит от магии</lol-ontology:name>
        <lol-ontology:slot>E</lol-ontology:slot>
        <lol-ontology:tooltipText>Сивир создает на {{ spellshieldduration }} сек. магический барьер, блокирующий следующее вражеское умение. При успешном срабатывании он восстанавливает Сивир {{ totalheal }} здоровья и активирует Быстроногую.{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Sivir_E</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Sivir_P -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Sivir_P">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Sivir"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Sivir"/>
        <lol-ontology:description>Сивир получает временное увеличение скорости передвижения, когда она атакует вражеского чемпиона.</lol-ontology:description>
        <lol-ontology:entityId>Sivir:P</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
