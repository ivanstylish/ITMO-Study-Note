    <!-- https://example.org/lol-ontology#Xerath_E -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Xerath_E">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Xerath"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Xerath"/>
        <lol-ontology:description>Зерат выпускает сферу чистой магической энергии, которая оглушает пораженного врага и наносит ему магический урон.</lol-ontology:description>
        <lol-ontology:entityId>Xerath:E</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Поражающая сфера</lol-ontology:name>
        <lol-ontology:slot>E</lol-ontology:slot>
