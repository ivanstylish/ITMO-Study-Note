        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Mel"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Mel"/>
        <lol-ontology:description>При следующей автоатаке после применения умения Мэл дополнительно выпускает 3 снаряда (максимум – 9). Нанося урон автоатаками и умениями, Мэл накладывает на цель заряды ошеломления (суммируются бесконечно). Поразив врага с достаточным количеством зарядов, она мгновенно добивает его.</lol-ontology:description>
        <lol-ontology:entityId>Mel:P</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Обжигающий свет</lol-ontology:name>
        <lol-ontology:slot>P</lol-ontology:slot>
        <rdfs:label>Mel_P</rdfs:label>
    </owl:Thing>
    


