    <!-- https://example.org/lol-ontology#Leona_E -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Leona_E">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Leona"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Leona"/>
        <lol-ontology:description>Леона выпускает копию своего меча, сотканную из лучей солнца и наносящую магический урон всем врагам на своем пути. Когда эта копия рассеется, последний вражеский чемпион на ее пути будет ненадолго обездвижен, и Леона совершит рывок к нему.</lol-ontology:description>
        <lol-ontology:entityId>Leona:E</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Клинок зенита</lol-ontology:name>
        <lol-ontology:slot>E</lol-ontology:slot>
        <lol-ontology:tooltipText>Леона вытягивает вперед свой меч из света, нанося {{ totaldamagetooltip }} ед. маг. урона . Последний пораженный чемпион обездвиживается на {{ rootduration }} сек., а Леона совершает к нему рывок.{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Leona_E</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Leona_P -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Leona_P">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Leona"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Leona"/>
        <lol-ontology:description>Вместе с полученным уроном от заклинаний цель помечается Сиянием солнца на 1,5 секунды. Первая в течение этого времени атака союзного чемпиона снимет этот эффект, но нанесет дополнительный магический урон.</lol-ontology:description>
        <lol-ontology:entityId>Leona:P</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Сияние солнца</lol-ontology:name>
        <lol-ontology:slot>P</lol-ontology:slot>
        <rdfs:label>Leona_P</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Leona_Q -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Leona_Q">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Leona"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Leona"/>
        <lol-ontology:description>Леона использует свой щит для выполнения следующей автоатаки, нанося дополнительный магический урон и оглушая цель.</lol-ontology:description>
        <lol-ontology:entityId>Leona:Q</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Щит рассвета</lol-ontology:name>
        <lol-ontology:slot>Q</lol-ontology:slot>
        <lol-ontology:tooltipText>Следующая автоатака Леоны оглушает врага на {{ stunduration }} сек. и дополнительно наносит {{ totaldamagetooltip }} ед. маг. урона.{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Leona_Q</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Leona_R -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Leona_R">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Leona"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Leona"/>
        <lol-ontology:description>Леона призывает луч солнечной энергии, наносящий урон противникам в области действия заклинания. Противники в центре области будут оглушены, а находящиеся по краям - замедлены.</lol-ontology:description>
        <lol-ontology:entityId>Leona:R</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Солнечная вспышка</lol-ontology:name>
        <lol-ontology:slot>R</lol-ontology:slot>
        <lol-ontology:tooltipText>Леона обрушивает поток солнечной энергии в указанную точку, нанося врагам {{ explosioncalculateddamage }} магического урона и замедляя их на {{ slowpercent }}% на {{ ccduration }} сек. Враги, оказавшиеся в центре области поражения, вместо замедления оглушаются .{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Leona_R</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Leona_W -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Leona_W">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Leona"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Leona"/>
        <lol-ontology:description>Леона поднимает щит, чтобы увеличить свою броню и сопротивление магии, а также получить сопротивление урону. Если во время окончания этого эффекта рядом с ней будут противники, то они получат магический урон, а время действия умения будет увеличено, но только один раз.</lol-ontology:description>
        <lol-ontology:entityId>Leona:W</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Затмение</lol-ontology:name>
        <lol-ontology:slot>W</lol-ontology:slot>
        <lol-ontology:tooltipText>Леона поднимает щит, снижая получаемый урон на {{ flatdamagereduction }} и получая {{ bonusarmortooltip }} брони и {{ bonusmrtooltip }} сопр. магии на {{ armormrduration }} сек. После щит взрывается, нанося {{ totaldamagetooltip }} ед. маг. урона врагам поблизости. Если взрыв поражает хотя бы 1 врага, Леона сохраняет бонус к броне и сопр. магии еще на {{ armormrduration }} сек. {{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Leona_W</rdfs:label>
    </owl:Thing>
    


