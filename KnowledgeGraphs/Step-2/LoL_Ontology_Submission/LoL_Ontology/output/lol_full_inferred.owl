    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Nasus_Q -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Nasus_Q">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Nasus"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Nasus"/>
        <lol-ontology:description>Следующая автоатака Насуса наносит дополнительный урон. Если при этом он убивает цель, этот урон навсегда увеличивается.</lol-ontology:description>
        <lol-ontology:entityId>Nasus:Q</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Вытягивающий удар</lol-ontology:name>
        <lol-ontology:slot>Q</lol-ontology:slot>
        <lol-ontology:tooltipText>Следующая автоатака Насуса наносит {{ totaldamage }} физического урона . Если она убивает врага, Насус навсегда увеличивает урон этого умения на {{ basicstacks }} (на {{ bigstacks }}, если цель – чемпион, большой миньон или большой лесной монстр).{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Nasus_Q</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Nasus_R -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Nasus_R">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Nasus"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Nasus"/>
        <lol-ontology:description>Насус призывает сильнейшую песчаную бурю, обрушивающуюся на ближайших противников. Пока буря бушует, его запас здоровья и дальность атаки увеличены. Кроме того, Насус наносит окружающим врагам урон, быстрее перезаряжает Вытягивающий удар и получает дополнительные броню и сопротивление магии.</lol-ontology:description>
        <lol-ontology:entityId>Nasus:R</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Ярость песков</lol-ontology:name>
        <lol-ontology:slot>R</lol-ontology:slot>
        <lol-ontology:tooltipText>Насус окружает себя песчаной бурей на 15 сек., увеличивая максимальный запас здоровья на {{ bonushealth }} , а также броню и сопротивление магии на {{ initialresistgain }}. Пока бушует буря, враги поблизости каждую секунду получают магический урон в размере {{ damagecalc }} от своего максимального запаса здоровья . Кроме того, во время действия умения перезарядка Вытягивающего удара сокращена на {{ qcdr*100 }}%.{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Nasus_R</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Nasus_W -->

