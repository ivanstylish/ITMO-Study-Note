    <!-- https://example.org/lol-ontology#Anivia_E -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Anivia_E">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Anivia"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Anivia"/>
        <lol-ontology:description>Анивия взмахивает крыльями и направляет порыв ледяного ветра в указанную цель, нанося урон. Если цель была недавно поражена Мгновенной заморозкой или получила урон от Ледяной бури максимального размера, урон удваивается.</lol-ontology:description>
        <lol-ontology:entityId>Anivia:E</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Обморожение</lol-ontology:name>
        <lol-ontology:slot>E</lol-ontology:slot>
        <lol-ontology:tooltipText>Анивия направляет в указанную цель порыв ледяного ветра, нанося {{ totaldamage }} магического урона . Если на цель действует переохлаждение , урон умения увеличивается до {{ empowereddamage }} .{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Anivia_E</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Anivia_P -->

