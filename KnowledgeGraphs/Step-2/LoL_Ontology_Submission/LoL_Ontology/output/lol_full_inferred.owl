        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Malzahar"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Malzahar"/>
        <lol-ontology:description>Мальзахар призывает войдлингов для атаки ближайших врагов.</lol-ontology:description>
        <lol-ontology:entityId>Malzahar:W</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Рой Бездны</lol-ontology:name>
        <lol-ontology:slot>W</lol-ontology:slot>
        <lol-ontology:tooltipText>Пассивно: при применении других умений Мальзахар получает заряды (не более {{ stackcap }} суммарно). Активно: Мальзахар призывает войдлинга плюс еще по одному войдлингу за заряд. Войдлинги существуют в течение {{ voidlingduration }} сек. и с каждым попаданием наносят {{ voidlingbonusdamagetooltip }} магического урона .{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Malzahar_W</rdfs:label>
    </owl:Thing>
    


