        <rdfs:label>Graves</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Graves_E -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Graves_E">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Graves"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Graves"/>
        <lol-ontology:description>Грейвз совершает рывок вперед, и его броня и сопротивление магии увеличиваются на несколько секунд. Если Грейвз совершает рывок по направлению к вражескому чемпиону, он получает два заряда Настоящего мужества. Автоатаки сокращают время перезарядки умения и продлевают продолжительность действия защитного эффекта.</lol-ontology:description>
        <lol-ontology:entityId>Graves:E</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>На изготовку</lol-ontology:name>
        <lol-ontology:slot>E</lol-ontology:slot>
        <lol-ontology:tooltipText>Грейвз совершает рывок и заряжает дробовик одним патроном . Также он получает заряд на {{ buffduration }} сек. (максимум зарядов – {{ maxstacks }}) или 2 заряда, если рывок совершается в сторону вражеского чемпиона. Каждый заряд дает ему {{ armorperstack }} брони и {{ mrgrant }} сопротивления магии . Заряды обновляются, когда Грейвз наносит урон цели, не являющейся миньоном. Каждая попавшая в цель пуля от автоатак Грейвза сокращает перезарядку этого умения на {{ cooldownperhit }} сек.{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Graves_E</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Graves_P -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Graves_P">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Graves"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Graves"/>
        <lol-ontology:description>У дробовика Грейвза есть несколько уникальных свойств. Грейвз должен периодически его перезаряжать. При автоатаках дробовик выпускает 4 пули, которые не могут пробить цель насквозь. Нечемпионы, в которых попало несколько пуль, отбрасываются.</lol-ontology:description>
        <lol-ontology:entityId>Graves:P</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Новая Судьба</lol-ontology:name>
        <lol-ontology:slot>P</lol-ontology:slot>
        <rdfs:label>Graves_P</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Graves_Q -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Graves_Q">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Graves"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Graves"/>
        <lol-ontology:description>Грейвз выпускает разрывной снаряд, который взрывается через 1 секунду или при столкновении с препятствием.</lol-ontology:description>
        <lol-ontology:entityId>Graves:Q</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Финита ля комедия</lol-ontology:name>
        <lol-ontology:slot>Q</lol-ontology:slot>
        <lol-ontology:tooltipText>Грейвз выпускает снаряд, который наносит {{ totaldamage }} физического урона . Через 1 сек. или при столкновении с элементом ландшафта снаряд взрывается, нанося {{ totaldetonationdamage }} физического урона там, где он пролетел, и около взрыва.{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Graves_Q</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Graves_R -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Graves_R">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Graves"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Graves"/>
        <lol-ontology:description>Грейвз выпускает разрывной снаряд, который поражает первого вражеского чемпиона на своем пути, нанося ему большой урон. Кроме того, после попадания в чемпиона или при достижении предельной дальности полета снаряд взрывается, нанося урон всем врагам в секторе за точкой взрыва.</lol-ontology:description>
        <lol-ontology:entityId>Graves:R</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Сопутствующий ущерб</lol-ontology:name>
        <lol-ontology:slot>R</lol-ontology:slot>
        <lol-ontology:tooltipText>Грейвз выпускает разрывной снаряд, при этом отдача от выстрела отбрасывает его назад. Снаряд наносит {{ damage }} физического урона первому пораженному врагу. После попадания в чемпиона или при достижении максимальной дальности снаряд взрывается в направлении полета, нанося {{ falloffdamage }} физического урона .{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Graves_R</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Graves_W -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Graves_W">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Graves"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Graves"/>
        <lol-ontology:description>Грейвз запускает дымовую шашку в указанную область, создавая там дымовую завесу, которая ограничивает обзор. Враги, пораженные первоначальным взрывом шашки, получают магический урон, а их скорость передвижения ненадолго уменьшается.</lol-ontology:description>
        <lol-ontology:entityId>Graves:W</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Дымовая завеса</lol-ontology:name>
        <lol-ontology:slot>W</lol-ontology:slot>
        <lol-ontology:tooltipText>Грейвз на 4 сек. создает дымовую завесу, замедляющую врагов внутри на {{ slowamount }}%. Они не видят, что происходит снаружи. Первоначальный взрыв шашки наносит {{ impactdamage }} ед. маг. урона .{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Graves_W</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Gwen -->

