        <rdfs:label>Akali_P</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Akali_Q -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Akali_Q">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Akali"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Akali"/>
        <lol-ontology:description>Акали бросает пять кунаев, нанося урон в зависимости от дополнительной силы атаки и силы умений, а также замедляя цель.</lol-ontology:description>
        <lol-ontology:entityId>Akali:Q</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Пятиточечный удар</lol-ontology:name>
        <lol-ontology:slot>Q</lol-ontology:slot>
        <lol-ontology:tooltipText>Акали бросает кунаи по дуге перед собой, нанося {{ damage }} магического урона и замедляя врагов в дальней части области поражения на {{ slowpercentage*100 }}% на {{ slowduration }} сек.{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Akali_Q</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Akali_R -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Akali_R">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Akali"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Akali"/>
        <lol-ontology:description>Акали совершает рывок в выбранном направлении, нанося урон пораженным врагам. При повторном применении Акали совершает еще один рывок в выбранном направлении, нанося урон в зависимости от недостающего здоровья цели.</lol-ontology:description>
        <lol-ontology:entityId>Akali:R</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Идеальное убийство</lol-ontology:name>
        <lol-ontology:slot>R</lol-ontology:slot>
        <lol-ontology:tooltipText>Акали перепрыгивает через вражеского чемпиона, нанося {{ cast1damage }} магического урона всем врагам на пути. Акали может повторно применить умение через {{ cooldownbetweencasts }} сек. При этом она совершает рывок, пронзая врагов и нанося им от {{ cast2damagemin }} до {{ cast2damagemax }} магического урона в зависимости от недостающего здоровья.{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Akali_R</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Akali_W -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Akali_W">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Akali"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Akali"/>
        <lol-ontology:description>Акали создает дымовую завесу и ненадолго увеличивает свою скорость передвижения. Находясь внутри, она становится невидимой, а враги не могут выбрать ее в качестве цели для умений или автоатак. При применении автоатак или умений Акали ненадолго раскрывает себя.</lol-ontology:description>
        <lol-ontology:entityId>Akali:W</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Покров сумерек</lol-ontology:name>
        <lol-ontology:slot>W</lol-ontology:slot>
        <lol-ontology:tooltipText>Акали бросает дымовую бомбу, создавая растущую завесу, которая существует {{ baseduration }} сек. и дает Акали {{ movementspeed }}% скорости передвижения (эффект пропадает в течение {{ movementspeedduration }} сек.). Пока существует завеса, максимальный запас энергии Акали увеличивается на {{ energyrestore }}. Пока Акали находится в дыму, она невидима .{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Akali_W</rdfs:label>
    </owl:Thing>
    


