    <!-- https://example.org/lol-ontology#Twitch_E -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Twitch_E">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Twitch"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Twitch"/>
        <lol-ontology:description>Твич распространяет панику среди отравленных жертв, заражая их страшными болезнями.</lol-ontology:description>
        <lol-ontology:entityId>Twitch:E</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
