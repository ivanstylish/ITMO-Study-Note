        <lol-ontology:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Assassin"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Talon"/>
        <lol-ontology:baseArmor rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">30.0</lol-ontology:baseArmor>
        <lol-ontology:baseAttackDamage rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">68.0</lol-ontology:baseAttackDamage>
        <lol-ontology:baseHP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">658.0</lol-ontology:baseHP>
        <lol-ontology:baseMP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">400.0</lol-ontology:baseMP>
        <lol-ontology:baseMoveSpeed rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">335.0</lol-ontology:baseMoveSpeed>
