        <rdfs:label>Nautilus_E</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Nautilus_P -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Nautilus_P">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Nautilus"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Nautilus"/>
        <lol-ontology:description>Первая автоатака Наутилуса против цели наносит больше физического урона и ненадолго обездвиживает.</lol-ontology:description>
        <lol-ontology:entityId>Nautilus:P</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Ошеломляющий удар</lol-ontology:name>
        <lol-ontology:slot>P</lol-ontology:slot>
        <rdfs:label>Nautilus_P</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Nautilus_Q -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Nautilus_Q">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Nautilus"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Nautilus"/>
        <lol-ontology:description>Наутилус бросает вперед свой якорь. Если якорь попадает во врага, они с Наутилусом притягиваются друг к другу, а цель получает магический урон. Если якорь попадает в элемент ландшафта, Наутилус притягивается к нему.</lol-ontology:description>
        <lol-ontology:entityId>Nautilus:Q</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Якорная цепь</lol-ontology:name>
        <lol-ontology:slot>Q</lol-ontology:slot>
        <lol-ontology:tooltipText>Наутилус бросает вперед свой якорь. Если якорь попадает во врага, они с Наутилусом притягиваются друг к другу. При этом цель получает {{ qdamagecalc }} магического урона и ненадолго оглушается . Если якорь попадает в элемент ландшафта, Наутилус притягивается к нему.{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Nautilus_Q</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Nautilus_R -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Nautilus_R">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Nautilus"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Nautilus"/>
        <lol-ontology:description>Наутилус создает подземную ударную волну, преследующую выбранного вражеского чемпиона. По ходу движения волна разрывает землю над собой, нанося урон всем врагам на своем пути и подбрасывая их в воздух. Когда волна настигает свою цель, та тоже получает урон и подбрасывается в воздух, а затем оглушается.</lol-ontology:description>
        <lol-ontology:entityId>Nautilus:R</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Глубинный заряд</lol-ontology:name>
        <lol-ontology:slot>R</lol-ontology:slot>
        <lol-ontology:tooltipText>Наутилус выпускает ударную волну, которая преследует вражеского чемпиона. Волна наносит цели {{ primarytargetdamage }} магического урона , а также подбрасывает и оглушает ее на {{ stunduration }} сек. Другие враги, пораженные волной, также подбрасываются , оглушаются и получают {{ secondarytargetdamage }} магического урона .{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Nautilus_R</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Nautilus_W -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Nautilus_W">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Nautilus"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Nautilus"/>
        <lol-ontology:description>Наутилус ненадолго накладывает на себя щит. Пока существует щит, автоатаки Наутилуса наносят периодический урон цели и окружающим врагам.</lol-ontology:description>
        <lol-ontology:entityId>Nautilus:W</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Гнев титана</lol-ontology:name>
        <lol-ontology:slot>W</lol-ontology:slot>
        <lol-ontology:tooltipText>Наутилус на {{ shieldduration }} сек. получает щит прочностью {{ shieldcalc }} . Пока существует щит , автоатаки Наутилуса дополнительно наносят {{ dotdamagecalc }} магического урона в течение 2 сек. цели и всем окружающим врагам.{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Nautilus_W</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Neeko -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Neeko">
