    <!-- https://example.org/lol-ontology#Yone_E -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Yone_E">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Yone"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Yone"/>
        <lol-ontology:description>Ёнэ покидает тело в форме духа и увеличивает свою скорость передвижения. По окончании действия умения дух Ёнэ возвращается в тело и снова наносит часть урона, нанесенного перед этим.</lol-ontology:description>
        <lol-ontology:entityId>Yone:E</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Освобожденная душа</lol-ontology:name>
        <lol-ontology:slot>E</lol-ontology:slot>
        <lol-ontology:tooltipText>Ёнэ принимает форму духа на {{ returntimer }} сек., покидая тело и увеличивая свою скорость передвижения на {{ startingms*100 }}% (со временем ускорение возрастает до {{ movementspeed*100 }}% ). По окончании действия умения Ёнэ возвращается в тело и снова наносит {{ deathmarkpercent*100 }}% от всего урона от автоатак и умений, который он нанес чемпионам во время пребывания в форме духа. Во время действия умения его можно применить повторно . Повторное применение: дух Ёнэ преждевременно возвращается в тело.{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Yone_E</rdfs:label>
    </owl:Thing>
    


