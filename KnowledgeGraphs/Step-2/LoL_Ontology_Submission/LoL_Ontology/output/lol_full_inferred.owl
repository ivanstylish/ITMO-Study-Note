        <lol-ontology:slot>E</lol-ontology:slot>
        <lol-ontology:tooltipText>Пайк совершает рывок, оставляя за собой призрака утопленника, который вскоре возвращается к нему. Призрак оглушает врагов на {{ stunduration }} сек. и наносит чемпионам {{ totaldamage }} физического урона .{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Pyke_E</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Pyke_P -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Pyke_P">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Pyke"/>
