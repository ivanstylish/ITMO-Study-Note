        <lol-ontology:slot>E</lol-ontology:slot>
        <lol-ontology:tooltipText>Мисс Фортуна обрушивает град пуль на выбранную область, раскрывая ее. Враги внутри замедляются на {{ totalslowamount }} и получают {{ totaldamagepersecond }} магического урона в секунду в течение {{ baseduration }} сек. (всего: {{ totaldamage }} магического урона ).{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>MissFortune_E</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#MissFortune_P -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#MissFortune_P">
