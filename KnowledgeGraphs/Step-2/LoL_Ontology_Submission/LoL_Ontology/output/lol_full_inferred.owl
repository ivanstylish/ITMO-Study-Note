    <!-- https://example.org/lol-ontology#Elise_E -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Elise_E">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Elise"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Elise"/>
        <lol-ontology:description>Человеческая форма: Элиза выпускает паутину, оглушая первого пораженного противника, а также раскрывая его на некоторое время (не действует на невидимых бойцов). Форма паука: Элиза и ее паучки поднимаются в воздух, а затем обрушиваются на выбранного врага. После спуска на вражескую цель дополнительный урон и лечение Королевы пауков увеличиваются.</lol-ontology:description>
        <lol-ontology:entityId>Elise:E</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Кокон / Спуск</lol-ontology:name>
        <lol-ontology:slot>E</lol-ontology:slot>
        <lol-ontology:tooltipText>Человеческая форма : Элиза выпускает кокон, оглушающий и раскрывающий первого пораженного врага на {{ totalstunduration }} сек.{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Elise_E</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Elise_P -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Elise_P">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Elise"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Elise"/>
        <lol-ontology:description>Человеческая форма: каждый раз, когда Элиза поражает противника умением, она подготавливает спящего паучка. Форма паука: Элиза наносит дополнительный магический урон и восстанавливает себе здоровье при автоатаках.</lol-ontology:description>
        <lol-ontology:entityId>Elise:P</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Королева пауков</lol-ontology:name>
        <lol-ontology:slot>P</lol-ontology:slot>
        <rdfs:label>Elise_P</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Elise_Q -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Elise_Q">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Elise"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Elise"/>
        <lol-ontology:description>Человеческая форма: Элиза поражает врага ядом, нанося ему магический урон тем больший, чем больше у него осталось здоровья. Форма паука: Элиза бросается к противнику и наносит ему урон тем больший, чем меньше у него осталось здоровья.</lol-ontology:description>
        <lol-ontology:entityId>Elise:Q</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Нейротоксин / Ядовитый укус</lol-ontology:name>
        <lol-ontology:slot>Q</lol-ontology:slot>
        <lol-ontology:tooltipText>Человеческая форма : Элиза впрыскивает во врага нейротоксин, нанося магический урон в размере {{ basedamage }} плюс {{ humanpercenthealth }} от текущего здоровья цели .{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Elise_Q</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Elise_R -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Elise_R">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Elise"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Elise"/>
        <lol-ontology:description>Элиза превращается в грозного паука и обретает новые умения. Будучи в форме паука, она имеет увеличенную скорость передвижения, но ее дальность атаки уменьшается. Кроме того, она призывает паучков, чтобы они атаковали врагов поблизости.</lol-ontology:description>
        <lol-ontology:entityId>Elise:R</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Форма паука</lol-ontology:name>
        <lol-ontology:slot>R</lol-ontology:slot>
        <lol-ontology:tooltipText>Человеческая форма : Элиза превращается в грозного паука, становится чемпионом ближнего боя и получает умения формы паука . Кроме того, она призывает всех спящих паучков .{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Elise_R</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Elise_W -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Elise_W">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Elise"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Elise"/>
        <lol-ontology:description>Человеческая форма: Элиза выпускает ядовитого паучка, который взрывается при приближении к цели. Форма паука: скорость атаки Элизы и ее паучков увеличивается.</lol-ontology:description>
        <lol-ontology:entityId>Elise:W</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Взрывоопасный паучок / Паучье бешенство</lol-ontology:name>
        <lol-ontology:slot>W</lol-ontology:slot>
        <lol-ontology:tooltipText>Человеческая форма : Элиза призывает взрывного паука, который бежит в указанную область и взрывается при приближении к врагу или через 3 сек. Паук наносит {{ spell.elisehumanw:totaldamage }} магического урона .{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Elise_W</rdfs:label>
    </owl:Thing>
    


