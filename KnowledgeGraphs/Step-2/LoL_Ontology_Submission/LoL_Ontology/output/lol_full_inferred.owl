    <!-- https://example.org/lol-ontology#JarvanIV_E -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#JarvanIV_E">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_JarvanIV"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#JarvanIV"/>
        <lol-ontology:description>Джарван IV несет цвета Демасии, и его скорость атаки пассивно увеличена. При активации умения Джарван IV водружает флаг Демасии, нанося магический урон врагам. Водруженный флаг увеличивает скорость атаки всех союзных чемпионов неподалеку.</lol-ontology:description>
        <lol-ontology:entityId>JarvanIV:E</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Штандарт Демасии</lol-ontology:name>
        <lol-ontology:slot>E</lol-ontology:slot>
        <lol-ontology:tooltipText>Пассивно: Джарван IV получает {{ permanentattackspeed*100 }}% скорости атаки . Активно: Джарван IV бросает свой штандарт, нанося {{ totaldamage }} ед. маг. урона и давая союзникам поблизости {{ baseauraas*100 }}% скорости атаки на {{ e4 }} сек.{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>JarvanIV_E</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#JarvanIV_P -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#JarvanIV_P">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_JarvanIV"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#JarvanIV"/>
        <lol-ontology:description>При первой автоатаке Джарван IV наносит врагу дополнительный физический урон, который зависит от текущего здоровья цели. В отношении одной и той же цели этот эффект может возникать не чаще одного раза в несколько секунд.</lol-ontology:description>
        <lol-ontology:entityId>JarvanIV:P</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Поступь войны</lol-ontology:name>
        <lol-ontology:slot>P</lol-ontology:slot>
        <rdfs:label>JarvanIV_P</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#JarvanIV_Q -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#JarvanIV_Q">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_JarvanIV"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#JarvanIV"/>
        <lol-ontology:description>Джарван IV делает выпад своим копьем, уменьшая броню всех противников, которых оно пронзит, и нанося им физический урон. Кроме того, Джарван подтягивается к Штандарту Демасии, по пути подбрасывая врагов в воздух.</lol-ontology:description>
        <lol-ontology:entityId>JarvanIV:Q</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Удар дракона</lol-ontology:name>
        <lol-ontology:slot>Q</lol-ontology:slot>
        <lol-ontology:tooltipText>Джарван IV вытягивает свое копье, нанося врагам {{ totaldamage }} ед. физ. урона и снижая их броню на {{ basearshred*100 }}% на {{ e3 }} сек. Если копье попадает в Штандарт Демасии , Джарван IV притягивается к нему, подбрасывая всех на пути на 0,75 сек.{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>JarvanIV_Q</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#JarvanIV_R -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#JarvanIV_R">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_JarvanIV"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#JarvanIV"/>
        <lol-ontology:description>Джарван IV отважно бросается в бой, совершая прыжок к цели и обрушиваясь на землю с такой силой, что образуется кратер. Всем окружающим врагам при этом наносится физический урон.</lol-ontology:description>
        <lol-ontology:entityId>JarvanIV:R</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Катаклизм</lol-ontology:name>
        <lol-ontology:slot>R</lol-ontology:slot>
        <lol-ontology:tooltipText>Джарван IV отважно прыгает к вражескому чемпиону, нанося ему и окружающим врагам {{ damagecalc }} физического урона , а также создавая вокруг кратер с непроходимым валом на {{ wallduration }} сек. Джарван IV может повторно применить это умение, чтобы разрушить вал.{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>JarvanIV_R</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#JarvanIV_W -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#JarvanIV_W">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_JarvanIV"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#JarvanIV"/>
        <lol-ontology:description>Джарван IV взывает к древним королям Демасии, чтобы они защитили его от урона и замедлили ближайших противников.</lol-ontology:description>
        <lol-ontology:entityId>JarvanIV:W</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Золотая эгида</lol-ontology:name>
        <lol-ontology:slot>W</lol-ontology:slot>
        <lol-ontology:tooltipText>Джарван IV призывает эгиду, замедляя врагов поблизости на {{ baseslowamount*100 }}% на {{ e5 }} сек. и накладывая на себя щит прочностью {{ totalshield }} . Прочность выше на {{ bonusshield }} за каждого пораженного вражеского чемпиона.{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>JarvanIV_W</rdfs:label>
    </owl:Thing>
    


