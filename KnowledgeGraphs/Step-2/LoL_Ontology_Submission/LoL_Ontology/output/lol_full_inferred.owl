        <lol-ontology:entityId>Poppy:E</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Героический рывок</lol-ontology:name>
        <lol-ontology:slot>E</lol-ontology:slot>
        <lol-ontology:tooltipText>Поппи хватает врага и переносит его вперед, нанося {{ tackledamage }} ед. физического урона . Если цель врезается в элемент ландшафта, она оглушается на {{ stunduration }} сек. и дополнительно получает {{ tackledamage }} ед. физического урона .{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Poppy_E</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Poppy_P -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Poppy_P">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
