        <lol-ontology:hasAbility rdf:resource="https://example.org/lol-ontology#Briar_P"/>
        <lol-ontology:hasAbility rdf:resource="https://example.org/lol-ontology#Briar_Q"/>
        <lol-ontology:hasAbility rdf:resource="https://example.org/lol-ontology#Briar_R"/>
        <lol-ontology:hasAbility rdf:resource="https://example.org/lol-ontology#Briar_W"/>
        <lol-ontology:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Assassin"/>
        <lol-ontology:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Fighter"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Briar"/>
