        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Azir"/>
        <lol-ontology:description>Азир может установить солнечный диск на развалинах союзной или вражеской башни.</lol-ontology:description>
        <lol-ontology:entityId>Azir:P</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
