    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Hecarim_Q -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Hecarim_Q">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Hecarim"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Hecarim"/>
        <lol-ontology:description>Гекарим рассекает ближайших врагов, нанося физический урон. Если Гекарим наносит урон хотя бы одному врагу, он увеличивает урон и сокращает перезарядку последующих применений Буйства.</lol-ontology:description>
        <lol-ontology:entityId>Hecarim:Q</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Буйство</lol-ontology:name>
        <lol-ontology:slot>Q</lol-ontology:slot>
        <lol-ontology:tooltipText>Гекарим рассекает ближайших врагов, нанося {{ damage }} ед. физ. урона . Поражая врага, Гекарим получает заряд, сокращающий перезарядку этого умения на {{ rampagecooldownreduction }} сек. и повышающий его урон на {{ rampagebonusdamageperc }}% на {{ buffduration }} сек. Макс. {{ maxstacks }} зар. {{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Hecarim_Q</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Hecarim_R -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Hecarim_R">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Hecarim"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Hecarim"/>
        <lol-ontology:description>Гекарим призывает призрачных всадников и устремляется вперед, нанося магический урон всем повстречавшимся врагам. В конечной точке его пути возникает ударная волна, заставляющая окружающих противников бежать в ужасе.</lol-ontology:description>
        <lol-ontology:entityId>Hecarim:R</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Натиск теней</lol-ontology:name>
        <lol-ontology:slot>R</lol-ontology:slot>
        <lol-ontology:tooltipText>Гекарим призывает призрачных всадников и устремляется вперед, нанося врагам {{ damagedone }} магического урона . В конечной точке пути Гекарима возникает ударная волна, которая пугает врагов на {{ feardurationmin }}-{{ feardurationmax }} сек. (продолжительность зависит от дальности рывка).{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Hecarim_R</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Hecarim_W -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Hecarim_W">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Hecarim"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Hecarim"/>
        <lol-ontology:description>Гекарим получает прибавку к броне и сопротивлению магии. Кроме того, он наносит магический урон окружающим врагам и восстанавливает себе здоровье в размере части от любого нанесенного этим врагам урона.</lol-ontology:description>
        <lol-ontology:entityId>Hecarim:W</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Аура ужаса</lol-ontology:name>
        <lol-ontology:slot>W</lol-ontology:slot>
        <lol-ontology:tooltipText>Гекарим наносит врагам поблизости {{ totaldamage }} магического урона в течение {{ buffduration }} сек. Кроме того, он получает {{ resistamount }} брони и сопротивления магии , а также лечится на {{ leechamount }}% от урона , который эти враги получают от Гекарима, и на {{ allytooltipleachvalue }}% от урона , который они получают от его союзников.{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Hecarim_W</rdfs:label>
    </owl:Thing>
    


