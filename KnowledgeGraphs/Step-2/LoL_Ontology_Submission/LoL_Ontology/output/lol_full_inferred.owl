        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Twitch"/>
        <lol-ontology:description>Автоатаки Твича отравляют цель %i:OnHit% при попадании , нанося ей чистый урон раз в секунду.</lol-ontology:description>
        <lol-ontology:entityId>Twitch:P</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Смертельный яд</lol-ontology:name>
