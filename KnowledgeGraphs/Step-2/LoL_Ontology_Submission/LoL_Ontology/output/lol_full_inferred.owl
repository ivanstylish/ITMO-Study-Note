        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasEffect rdf:resource="https://example.org/lol-ontology#Lux_E_Damage_Enemy"/>
        <lol-ontology:hasEffect rdf:resource="https://example.org/lol-ontology#Lux_E_Slow_Enemy"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Lux"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Lux"/>
        <lol-ontology:description>Люкс создает в указанной области световую аномалию, замедляющую противников. Люкс может взорвать ее, нанеся урон всем находящимся в зоне поражения врагам.</lol-ontology:description>
        <lol-ontology:entityId>Lux:E</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Светящаяся сингулярность</lol-ontology:name>
        <lol-ontology:slot>E</lol-ontology:slot>
        <lol-ontology:tooltipText>Люкс создает световую аномалию, замедляющую на {{ slowpercent }}% и раскрывающую область под собой. Через {{ slowzoneduration }} сек. или при повт. применении этого умения аномалия взрывается, нанося {{ totaldamagett }} ед. маг. урона и замедляя еще на {{ slowlingerduration }} сек.{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Lux_E</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Lux_E_Damage_Enemy -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Lux_E_Damage_Enemy">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#AbilityEffect"/>
        <lol-ontology:effectOf rdf:resource="https://example.org/lol-ontology#Lux_E"/>
        <lol-ontology:hasMechanic rdf:resource="https://example.org/lol-ontology#Damage"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Lux"/>
        <lol-ontology:hasTargetType rdf:resource="https://example.org/lol-ontology#Enemy"/>
        <lol-ontology:conditionText>Враг находится в зоне поражения при взрыве; взрыв по таймеру или повторному применению.</lol-ontology:conditionText>
        <lol-ontology:evidenceField>tooltip_text</lol-ontology:evidenceField>
