        <lol-ontology:slot>E</lol-ontology:slot>
        <lol-ontology:tooltipText>Ког&apos;Мао выплевывает слизь, которая наносит {{ totaldamage }} ед. магического урона и оставляет за собой след на {{ trailduration }} сек. Враги в слизи замедляются на {{ slowamount }}%.{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>KogMaw_E</rdfs:label>
    </owl:Thing>
    


