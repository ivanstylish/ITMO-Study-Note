    <!-- https://example.org/lol-ontology#MonkeyKing_E -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#MonkeyKing_E">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_MonkeyKing"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#MonkeyKing"/>
        <lol-ontology:description>Вуконг совершает рывок к выбранному врагу и бьет его, нанося урон. Кроме того, он создает свои копии, которые бьют врагов рядом с основной целью, нанося тот же урон.</lol-ontology:description>
        <lol-ontology:entityId>MonkeyKing:E</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Верхом на облаке</lol-ontology:name>
        <lol-ontology:slot>E</lol-ontology:slot>
        <lol-ontology:tooltipText>Вуконг совершает рывок к врагу и выпускает клонов , которые имитируют рывок к {{ extratargets }} дополнительным врагам поблизости. Все пораженные враги получают {{ totaldamage }} магического урона . После этого скорость атаки Вуконга и его клона увеличивается на {{ attackspeed*100 }}% на {{ attackspeedduration }} сек. {{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>MonkeyKing_E</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#MonkeyKing_P -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#MonkeyKing_P">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_MonkeyKing"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#MonkeyKing"/>
        <lol-ontology:description>Сражаясь с чемпионами и монстрами, Вуконг увеличивает броню и восстановление здоровья. Эффект суммируется.</lol-ontology:description>
        <lol-ontology:entityId>MonkeyKing:P</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Каменная кожа</lol-ontology:name>
        <lol-ontology:slot>P</lol-ontology:slot>
        <rdfs:label>MonkeyKing_P</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#MonkeyKing_Q -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#MonkeyKing_Q">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_MonkeyKing"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#MonkeyKing"/>
        <lol-ontology:description>Следующая автоатака Вуконга имеет увеличенную дальность, наносит дополнительный урон и уменьшает броню цели на несколько секунд.</lol-ontology:description>
        <lol-ontology:entityId>MonkeyKing:Q</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Сокрушительный удар</lol-ontology:name>
        <lol-ontology:slot>Q</lol-ontology:slot>
        <lol-ontology:tooltipText>Следующая автоатака Вуконга и его клона имеет увеличенную до {{ attackrangebonus }} дальность, дополнительно наносит {{ bonusdamagett }} физического урона и уменьшает броню на {{ armorshredpercent*100 }}% на {{ shredduration }} сек. Перезарядка этого умения сокращается на {{ cooldowndecrease }} сек. каждый раз, когда Вуконг или его клон поражают врага атакой или умением. При нанесении урона это умение активирует эффекты заклинаний. {{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>MonkeyKing_Q</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#MonkeyKing_R -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#MonkeyKing_R">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_MonkeyKing"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#MonkeyKing"/>
        <lol-ontology:description>Вуконг увеличивает свой посох и начинает вращать им вокруг себя, увеличивая скорость передвижения. Пораженные враги получают урон и подбрасываются.</lol-ontology:description>
        <lol-ontology:entityId>MonkeyKing:R</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Циклон</lol-ontology:name>
        <lol-ontology:slot>R</lol-ontology:slot>
        <lol-ontology:tooltipText>Вуконг увеличивает свою скорость передвижения на {{ movespeed*100 }}% и начинает вращаться с посохом, подбрасывая окружающих врагов на {{ knockupduration }} сек. и нанося физический урон в размере {{ totaldamagett }} плюс {{ percenthpdamagett }} от максимального запаса здоровья в течение {{ spinduration }} сек. Это умение можно применить еще раз в течение {{ recastwindow }} сек., после чего оно уходит на перезарядку.{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>MonkeyKing_R</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#MonkeyKing_W -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#MonkeyKing_W">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_MonkeyKing"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#MonkeyKing"/>
        <lol-ontology:description>Вуконг становится невидимым и совершает рывок в выбранном направлении, оставляя за собой клона, который атакует ближайших врагов.</lol-ontology:description>
        <lol-ontology:entityId>MonkeyKing:W</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Воин-обманщик</lol-ontology:name>
        <lol-ontology:slot>W</lol-ontology:slot>
        <lol-ontology:tooltipText>Вуконг совершает рывок и становится невидимым на {{ stealthduration }} сек., оставляя за собой неподвижного клона на {{ cloneduration }} сек. Клон атакует врагов поблизости, которым недавно наносил урон Вуконг, и имитирует его абсолютное умение, нанося {{ clonedamagemod*100 }}% от обычного урона.{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>MonkeyKing_W</rdfs:label>
    </owl:Thing>
    


