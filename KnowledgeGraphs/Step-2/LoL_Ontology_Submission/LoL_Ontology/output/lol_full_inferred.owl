    <!-- https://example.org/lol-ontology#Olaf_Q -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Olaf_Q">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Olaf"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Olaf"/>
        <lol-ontology:description>Олаф бросает топор в указанную точку, нанося пораженным врагам урон, уменьшая их броню и замедляя. Олаф может подобрать топор после броска, сбросив перезарядку умения.</lol-ontology:description>
        <lol-ontology:entityId>Olaf:Q</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Мощный бросок</lol-ontology:name>
        <lol-ontology:slot>Q</lol-ontology:slot>
        <lol-ontology:tooltipText>Олаф бросает топор, нанося целям {{ totaldamage }} ед. физического урона , а также замедляя их на {{ slowamount*100 }}% на время до {{ maxslowduration }} сек. (в зависимости от расстояния полета). Броня пораженных чемпионов уменьшается на {{ shredamount*100 }}% на {{ debuffduration }} сек. Если Олаф подбирает топор, перезарядка умения сокращается до {{ tooltipcdrefund }} сек. Если прошло {{ tooltipcdrefund }} сек., перезарядка сбрасывается полностью.{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Olaf_Q</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Olaf_R -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Olaf_R">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Olaf"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Olaf"/>
        <lol-ontology:description>Броня и сопротивление магии Олафа увеличены. Применив это умение, он становится невосприимчивым к нейтрализующим эффектам до тех пор, пока продолжает атаковать.</lol-ontology:description>
        <lol-ontology:entityId>Olaf:R</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Рагнарек</lol-ontology:name>
        <lol-ontology:slot>R</lol-ontology:slot>
        <lol-ontology:tooltipText>Пассивно: Олаф получает {{ resists }} к броне и {{ resists }} к сопротивлению магии . Активно: Олаф избавляется ото всех обездвиживающих и нейтрализующих эффектов и становится невосприимчивым к ним на {{ duration }} сек. Пока активно, сила атаки Олафа увеличена на {{ ad }}. Автоатаки и Безрассудные замахи , поразившие чемпионов, продлевают действие умения на {{ durationextension }} сек. Кроме того, Олаф увеличивает свою скорость передвижения на {{ haste*100 }}% при движении к вражеским чемпионам на {{ hasteduration }} сек.{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Olaf_R</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Olaf_W -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Olaf_W">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Olaf"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Olaf"/>
        <lol-ontology:description>Скорость атаки Олафа увеличена, и он получает щит.</lol-ontology:description>
        <lol-ontology:entityId>Olaf:W</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Превозмогание</lol-ontology:name>
        <lol-ontology:slot>W</lol-ontology:slot>
        <lol-ontology:tooltipText>Олаф увеличивает скорость атаки на {{ attackspeed*100 }}% на {{ duration }} сек., а также получает щит прочностью {{ baseshield }} плюс {{ shieldpercmissinghp*100 }}% от недостающего здоровья (максимальная прочность: {{ maxshieldcalc }}, когда уровень здоровья ниже {{ thresholdformax*100 }}%) на {{ shieldduration }} сек.{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Olaf_W</rdfs:label>
    </owl:Thing>
    


