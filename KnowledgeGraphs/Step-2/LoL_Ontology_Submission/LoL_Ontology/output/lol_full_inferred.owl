        <lol-ontology:resourceType>Мана</lol-ontology:resourceType>
        <lol-ontology:reviewStatus>effects_not_reviewed</lol-ontology:reviewStatus>
        <lol-ontology:title>Рука Ноксуса</lol-ontology:title>
        <rdfs:label>Darius</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Darius_E -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Darius_E">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Darius"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Darius"/>
        <lol-ontology:description>Дариус затачивает свой топор, пассивно игнорируя часть брони цели. При активации умения Дариус цепляет врагов крюком топора и притягивает их к себе.</lol-ontology:description>
        <lol-ontology:entityId>Darius:E</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Задержание</lol-ontology:name>
        <lol-ontology:slot>E</lol-ontology:slot>
        <lol-ontology:tooltipText>Пассивно: Дариус получает {{ passivepercentarmorpen }}% пробивания брони. Активно: Дариус совершает захват топором, притягивая , подбрасывая и замедляя врагов на {{ slowpercent }}% на {{ slowduration }} сек.{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Darius_E</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Darius_P -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Darius_P">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Darius"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Darius"/>
        <lol-ontology:description>Автоатаки и наносящие урон умения Дариуса заставляют врагов истекать кровью и получать физический урон в течение 5 сек. Эффект может суммироваться до 5 раз. Когда на цели накапливается максимальное количество зарядов, Дариус впадает в ярость и значительно увеличивает свою силу атаки.</lol-ontology:description>
        <lol-ontology:entityId>Darius:P</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Кровотечение</lol-ontology:name>
        <lol-ontology:slot>P</lol-ontology:slot>
        <rdfs:label>Darius_P</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Darius_Q -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Darius_Q">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Darius"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Darius"/>
        <lol-ontology:description>После небольшой задержки Дариус выполняет круговой удар топором. Враги, задетые лезвием, получают больше урона, чем те, по которым пришелся удар рукоятью. Кроме того, запас здоровья Дариуса восстанавливается на величину, зависящую от числа чемпионов и больших монстров, пораженных лезвием.</lol-ontology:description>
        <lol-ontology:entityId>Darius:Q</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Истребление</lol-ontology:name>
        <lol-ontology:slot>Q</lol-ontology:slot>
        <lol-ontology:tooltipText>Дариус замахивается топором и вращает им вокруг себя, нанося {{ bladedamage }} ед. физ. урона лезвием и {{ handledamage }} ед. урона рукоятью. Враги, пораженные рукоятью, не получают заряд Кровотечения . Дариус восстанавливает {{ missinghealthheal }}% от недост. здоровья за каждого вражеского чемпиона или большого лесного монстра, пораженного лезвием, вплоть до {{ missinghealpercent }}% .{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Darius_Q</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Darius_R -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Darius_R">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Darius"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Darius"/>
        <lol-ontology:description>Дариус прыгает на вражеского чемпиона и выполняет смертоносный удар, нанося чистый урон. Этот урон увеличивается с каждым зарядом Кровотечения на цели. Если цель погибает от Ноксианской гильотины, в течение короткого времени умение можно использовать еще раз.</lol-ontology:description>
        <lol-ontology:entityId>Darius:R</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Ноксианская гильотина</lol-ontology:name>
        <lol-ontology:slot>R</lol-ontology:slot>
        <lol-ontology:tooltipText>Дариус прыгает к врагу и совершает смертельный удар, нанося {{ damage }} чистого урона . За каждый заряд Кровотечения на цели это умение дополнительно наносит {{ rdamagepercentperhemostack*100 }}% урона (максимальный урон - {{ maximumdamage }} ). Если это умение убивает цель, Дариус может применить его повторно в течение {{ rrecastduration }} сек. На 3-м уровне умения оно перестает расходовать ману, а убийство полностью сбрасывает перезарядку.{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Darius_R</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Darius_W -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Darius_W">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Darius"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Darius"/>
        <lol-ontology:description>Следующая автоатака Дариуса повреждает жизненно важную артерию врага. Пока цель истекает кровью, ее скорость передвижения уменьшена.</lol-ontology:description>
        <lol-ontology:entityId>Darius:W</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Калечащий удар</lol-ontology:name>
        <lol-ontology:slot>W</lol-ontology:slot>
        <lol-ontology:tooltipText>Следующая автоатака Дариуса наносит {{ empoweredattackdamage }} ед. физ. урона и замедляет цель на {{ slowpercent }}% на {{ slowduration }} сек. Если цель умирает, Дариус восстанавливает затраченную ману, а перезарядка этого умения сокращается на {{ percentcdrefund }}%. При нанесении урона это умение активирует эффекты заклинаний. {{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Darius_W</rdfs:label>
    </owl:Thing>
    


