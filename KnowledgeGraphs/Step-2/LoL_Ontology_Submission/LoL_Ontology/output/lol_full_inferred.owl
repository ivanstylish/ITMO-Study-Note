    <!-- https://example.org/lol-ontology#Amumu_E -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Amumu_E">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Amumu"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Amumu"/>
        <lol-ontology:description>Амуму получает уменьшенный физический урон. При активации умения Амуму дает волю гневу, нанося урон всем окружающим врагам. Каждый раз, когда Амуму получает урон, перезарядка умения сокращается.</lol-ontology:description>
        <lol-ontology:entityId>Amumu:E</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Вспышка гнева</lol-ontology:name>
        <lol-ontology:slot>E</lol-ontology:slot>
        <lol-ontology:tooltipText>Пассивно: Амуму получает на {{ damagereduction }} меньше физ. урона. Когда Амуму поражают автоатакой, перезарядка этого умения сокращается на {{ cdronhit }} сек. Активно: Амуму срывается, нанося {{ tantrumdamage }} ед. маг. урона врагам поблизости.{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Amumu_E</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Amumu_P -->

