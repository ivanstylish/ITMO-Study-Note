    <!-- https://example.org/lol-ontology#Hecarim_E -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Hecarim_E">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Hecarim"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Hecarim"/>
        <lol-ontology:description>Гекарим постепенно ускоряется и в течение некоторого времени может проходить сквозь бойцов. Его следующая автоатака отбрасывает цель и наносит ей дополнительный физический урон, зависящий от пройденного после активации умения расстояния.</lol-ontology:description>
        <lol-ontology:entityId>Hecarim:E</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Разрушительный рывок</lol-ontology:name>
        <lol-ontology:slot>E</lol-ontology:slot>
        <lol-ontology:tooltipText>Гекарим получает призрачность и {{ minmovespeed*100 }}% скорости передвижения (растет до {{ maxmovespeed*100 }}% за {{ duration }} сек.). Следующая автоатака Гекарима отбрасывает цель, нанося ей {{ mindamage }} –{{ maxdamage }} ед. физ. урона . Дальность отбрасывания и урон зависят от расстояния, преодоленного в ходе действия этого умения.{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Hecarim_E</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Hecarim_P -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Hecarim_P">
