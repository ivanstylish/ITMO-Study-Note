        <lol-ontology:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Tank"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Illaoi"/>
        <lol-ontology:baseArmor rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">35.0</lol-ontology:baseArmor>
        <lol-ontology:baseAttackDamage rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">65.0</lol-ontology:baseAttackDamage>
        <lol-ontology:baseHP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">656.0</lol-ontology:baseHP>
        <lol-ontology:baseMP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">350.0</lol-ontology:baseMP>
        <lol-ontology:baseMoveSpeed rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">350.0</lol-ontology:baseMoveSpeed>
        <lol-ontology:entityId>Illaoi</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Иллаой</lol-ontology:name>
        <lol-ontology:resourceType>Мана</lol-ontology:resourceType>
        <lol-ontology:reviewStatus>effects_not_reviewed</lol-ontology:reviewStatus>
        <lol-ontology:title>Жрица Матери Глубин</lol-ontology:title>
        <rdfs:label>Illaoi</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Illaoi_E -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Illaoi_E">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Illaoi"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Illaoi"/>
        <lol-ontology:description>Иллаой вытягивает душу из вражеского чемпиона и притягивает ее к себе. Часть нанесенного душе урона получает сам чемпион. Если душа уничтожается или если лишенный души чемпион слишком далеко отходит от нее, он становится вместилищем и начинает порождать щупальца.</lol-ontology:description>
        <lol-ontology:entityId>Illaoi:E</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Испытание духа</lol-ontology:name>
        <lol-ontology:slot>E</lol-ontology:slot>
        <lol-ontology:tooltipText>Иллаой вытягивает душу из вражеского чемпиона на {{ spiritduration }} сек. Иллаой и ее союзники могут наносить душе урон как чемпиону, при этом {{ echopercent }} от этого урона передается ее владельцу. Если душа уничтожается или ее владелец покидает область действия, он помечается на {{ vesselduration }} сек. и замедляется на {{ slowamount*100 }}% на {{ slowduration }} сек. Если это возможно, вокруг помеченных врагов появляются щупальца. Щупальца автоматически атакуют души и помеченных врагов каждые {{ timebetweenvesseltentacleslams }} сек.{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Illaoi_E</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Illaoi_P -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Illaoi_P">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Illaoi"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Illaoi"/>
        <lol-ontology:description>Иллаой и вместилища , которые она создает, порождают щупальца на ближайших стенах. Щупальца бьют души, вместилища и бойцов, которым Иллаой преподала Жестокий урок, нанося физический урон и восстанавливая здоровье Иллаой, если они поразили чемпиона.</lol-ontology:description>
        <lol-ontology:entityId>Illaoi:P</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Вестница древнего божества</lol-ontology:name>
        <lol-ontology:slot>P</lol-ontology:slot>
        <rdfs:label>Illaoi_P</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Illaoi_Q -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Illaoi_Q">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Illaoi"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Illaoi"/>
        <lol-ontology:description>Увеличивает наносимый щупальцами урон. При активации умения Иллаой призывает щупальце, которое бьет в указанном направлении, нанося физический урон всем пораженным врагам.</lol-ontology:description>
        <lol-ontology:entityId>Illaoi:Q</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Удар щупальцем</lol-ontology:name>
        <lol-ontology:slot>Q</lol-ontology:slot>
        <lol-ontology:tooltipText>Пассивно: атака щупалец дополнительно наносит {{ spell.illaoiq:tentacledamageamp*100 }}% урона (текущее увеличение: {{ spell.illaoiq:tentacledamagetotal }} ед. физического урона ). Активно: Иллаой взмахивает своим идолом, приказывая щупальцу атаковать в указанном направлении.{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Illaoi_Q</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Illaoi_R -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Illaoi_R">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Illaoi"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Illaoi"/>
        <lol-ontology:description>Иллаой прыгает в воздух и швыряет своего идола на землю, нанося физический урон всем окружающим врагам и призывая по щупальцу за каждого пораженного вражеского чемпиона.</lol-ontology:description>
        <lol-ontology:entityId>Illaoi:R</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Прыжок веры</lol-ontology:name>
        <lol-ontology:slot>R</lol-ontology:slot>
        <lol-ontology:tooltipText>Иллаой прыгает в воздух и швыряет своего идола на землю, нанося {{ damagecalc }} ед. физического урона врагам поблизости и призывая по щупальцу за каждого пораженного вражеского чемпиона. В течение следующих {{ duration }} сек. щупальца атакуют на 50% быстрее. При этом они недосягаемы, а время перезарядки Жестокого урока составляет {{ spell.illaoiw:cooldownduringr }} сек.{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Illaoi_R</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Illaoi_W -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Illaoi_W">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Illaoi"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Illaoi"/>
        <lol-ontology:description>При следующей автоатаке Иллаой совершает рывок вперед, нанося дополнительный физический урон, и приказывает всем ближайшим щупальцам атаковать цель.</lol-ontology:description>
        <lol-ontology:entityId>Illaoi:W</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Жестокий урок</lol-ontology:name>
        <lol-ontology:slot>W</lol-ontology:slot>
        <lol-ontology:tooltipText>Во время следующей автоатаки Иллаой прыгает к своей цели, дополнительно нанося физический урон в размере {{ healthpercenttotal }} от максимального запаса здоровья . Когда Иллаой поражает цель, щупальца поблизости также атакуют ее.{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Illaoi_W</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Irelia -->

