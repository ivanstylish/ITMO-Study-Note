    <!-- https://example.org/lol-ontology#Rakan_Q -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Rakan_Q">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Rakan"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Rakan"/>
        <lol-ontology:description>Рэйкан бросает волшебное перо, которое наносит магический урон. При поражении чемпиона или эпического монстра Рэйкан может излечить своих союзников.</lol-ontology:description>
        <lol-ontology:entityId>Rakan:Q</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Блестящее перо</lol-ontology:name>
        <lol-ontology:slot>Q</lol-ontology:slot>
        <lol-ontology:tooltipText>Рэйкан бросает волшебное перо, которое наносит {{ totaldamage }} магического урона первому врагу на пути. Если перо поражает чемпиона или эпического лесного монстра, Рэйкан восстанавливает {{ totalheal }} здоровья себе и ближайшим союзникам через {{ healdelay }} сек. или мгновенно, если он касается союзника.{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Rakan_Q</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Rakan_R -->

