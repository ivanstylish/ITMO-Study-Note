    <!-- https://example.org/lol-ontology#Jinx_E -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Jinx_E">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Jinx"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Jinx"/>
        <lol-ontology:description>Джинкс бросает линию из гранат-ловушек. Гранаты взрываются через 5 секунд, поджигая врагов. Если над гранатой проходит вражеский чемпион, граната кусает и обездвиживает его.</lol-ontology:description>
        <lol-ontology:entityId>Jinx:E</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Огненные кусаки!</lol-ontology:name>
        <lol-ontology:slot>E</lol-ontology:slot>
        <lol-ontology:tooltipText>Джинкс бросает 3 гранаты-кусаки, которые существуют {{ grenadeduration }} сек. Гранаты взрываются при контакте с вражескими чемпионами, обездвиживая их на {{ rootduration }} сек. и нанося окружающим врагам {{ totaldamage }} магического урона .{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Jinx_E</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Jinx_P -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Jinx_P">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Jinx"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Jinx"/>
        <lol-ontology:description>Скорость передвижения и скорость атаки Джинкс сильно увеличиваются, когда она помогает уничтожить строение либо убить вражеского чемпиона или эпического лесного монстра.</lol-ontology:description>
        <lol-ontology:entityId>Jinx:P</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Бодрячком!</lol-ontology:name>
        <lol-ontology:slot>P</lol-ontology:slot>
        <rdfs:label>Jinx_P</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Jinx_Q -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Jinx_Q">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Jinx"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Jinx"/>
        <lol-ontology:description>Джинкс меняет свое основное оружие, выбирая либо пулемет Пыщ-Пыщ, либо ракетницу Скелетницу. Автоатаки пулеметом Пыщ-Пыщ увеличивают ее скорость атаки, а ракетница Скелетница наносит урон по площади на большом расстоянии, но расходует ману и медленнее стреляет.</lol-ontology:description>
        <lol-ontology:entityId>Jinx:Q</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Кручу-верчу!</lol-ontology:name>
        <lol-ontology:slot>Q</lol-ontology:slot>
        <lol-ontology:tooltipText>Джинкс переключается между ракетницей Скелетницей и пулеметом Пыщ-Пыщ. При использовании ракетницы автоатаки Джинкс расходуют ману, дальность автоатак увеличивается на {{ rocketbonusrange }}, и они наносят {{ rocketdamage }} ед. физического урона цели и врагам рядом с ней, однако дополнительная скорость атаки уменьшается на {{ rocketaspdpenalty*100 }}%. При использовании пулемета автоатаки Джинкс увеличивают ее скорость атаки на {{ minigunattackspeedduration }} сек. Этот эффект может суммироваться до {{ minigunattackspeedstacks }} раз (вплоть до {{ minigunattackspeedmax }}% %i:scaleAS% ).{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Jinx_Q</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Jinx_R -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Jinx_R">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Jinx"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Jinx"/>
        <lol-ontology:description>Джинкс выпускает супер-мега-ракету, которая летит через всю карту. Урон, который она нанесет, увеличивается за время ее полета. Ракета взрывается при столкновении с вражеским чемпионом, нанося урон ему и окружающим врагам, тем больший, чем больше здоровья у них недостает.</lol-ontology:description>
        <lol-ontology:entityId>Jinx:R</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Супер-мега-ракета смерти!</lol-ontology:name>
        <lol-ontology:slot>R</lol-ontology:slot>
        <lol-ontology:tooltipText>Джинкс выпускает ракету, которая взрывается при столкновении с вражеским чемпионом, нанося ему физический урон в размере {{ damagefloor }}-{{ damagemax }} плюс {{ percentdamage }}% от недостающего здоровья . Урон ракеты увеличивается на протяжении первой секунды полета. Окружающие враги получают {{ aoedamagemult*100 }}% урона. Максимальный урон от недостающего здоровья против монстров - {{ monsterexecutemax }}. {{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Jinx_R</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Jinx_W -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Jinx_W">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Jinx"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Jinx"/>
        <lol-ontology:description>Джинкс стреляет из своего пистолета-шокера Чпокера. Заряд поражает первого врага на своем пути, раскрывая его, замедляя и нанося ему урон.</lol-ontology:description>
        <lol-ontology:entityId>Jinx:W</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Пиу-пиу!</lol-ontology:name>
        <lol-ontology:slot>W</lol-ontology:slot>
        <lol-ontology:tooltipText>Джинкс стреляет шоковым зарядом, который наносит {{ totaldamage }} физического урона первому пораженному врагу, замедляет его на {{ slowpercent }}% и раскрывает на {{ slowduration }} сек.{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Jinx_W</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#KSante -->

