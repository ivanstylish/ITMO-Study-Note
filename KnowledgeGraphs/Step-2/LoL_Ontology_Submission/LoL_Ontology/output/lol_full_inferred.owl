        <lol-ontology:tooltipText>Пайк получает маскировку и {{ movespeed }}% скорости передвижения (снижается за {{ camoduration }} сек.).{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Pyke_W</rdfs:label>
