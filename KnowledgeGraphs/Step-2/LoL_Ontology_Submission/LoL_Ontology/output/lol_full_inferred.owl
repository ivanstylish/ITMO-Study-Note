        <lol-ontology:hasAbility rdf:resource="https://example.org/lol-ontology#Senna_E"/>
        <lol-ontology:hasAbility rdf:resource="https://example.org/lol-ontology#Senna_P"/>
        <lol-ontology:hasAbility rdf:resource="https://example.org/lol-ontology#Senna_Q"/>
        <lol-ontology:hasAbility rdf:resource="https://example.org/lol-ontology#Senna_R"/>
        <lol-ontology:hasAbility rdf:resource="https://example.org/lol-ontology#Senna_W"/>
        <lol-ontology:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Marksman"/>
        <lol-ontology:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Support"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Senna"/>
        <lol-ontology:baseArmor rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">25.0</lol-ontology:baseArmor>
        <lol-ontology:baseAttackDamage rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">50.0</lol-ontology:baseAttackDamage>
        <lol-ontology:baseHP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">530.0</lol-ontology:baseHP>
        <lol-ontology:baseMP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">350.0</lol-ontology:baseMP>
        <lol-ontology:baseMoveSpeed rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">330.0</lol-ontology:baseMoveSpeed>
