        <rdfs:label>Nocturne_P</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Nocturne_Q -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Nocturne_Q">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Nocturne"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Nocturne"/>
        <lol-ontology:description>Ноктюрн бросает теневой клинок, наносящий урон всем врагам на своем пути и оставляющий за собой сумеречный след. Кроме того, сумеречный след начинают оставлять пораженные клинком вражеские чемпионы. Когда Ноктюрн передвигается по сумеречному следу, он может проходить сквозь бойцов, а его скорость передвижения и сила атаки увеличены.</lol-ontology:description>
        <lol-ontology:entityId>Nocturne:Q</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Вестник заката</lol-ontology:name>
        <lol-ontology:slot>Q</lol-ontology:slot>
        <lol-ontology:tooltipText>Ноктюрн бросает теневой клинок, наносящий {{ totaldamage }} ед. физ. урона и оставляющий сумеречный след на {{ trailduration }} сек. Пораженные вражеские чемпионы также начинают оставлять за собой сумеречный след. Передвигаясь по следу, Ноктюрн получает призрачность, {{ movespeed }}% скорости передвижения и {{ bonustrailad }} силы атаки .{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Nocturne_Q</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Nocturne_R -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Nocturne_R">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Nocturne"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Nocturne"/>
        <lol-ontology:description>Ноктюрн уменьшает радиус обзора всех вражеских чемпионов и не позволяет им видеть союзников. При повторной активации Паранойи во время ее действия Ноктюрн бросается на выбранного вражеского чемпиона.</lol-ontology:description>
        <lol-ontology:entityId>Nocturne:R</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Паранойя</lol-ontology:name>
        <lol-ontology:slot>R</lol-ontology:slot>
        <lol-ontology:tooltipText>Ноктюрн погружает карту во тьму, уменьшая радиус обзора всех вражеских чемпионов и не позволяя им видеть союзников в течение {{ paranoiaduration }} сек. Во время действия умения Ноктюрн может применить его повторно , чтобы броситься к вражескому чемпиону и нанести ему {{ damage }} физического урона .{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Nocturne_R</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Nocturne_W -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Nocturne_W">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Nocturne"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Nocturne"/>
        <lol-ontology:description>Ноктюрн заряжает свои клинки, пассивно увеличивая скорость атаки. При активации умения Ноктюрн исчезает во тьме, создавая вокруг себя магический барьер, который блокирует следующее вражеское умение. При успешном блокировании пассивное увеличение скорости атаки Ноктюрна удваивается.</lol-ontology:description>
        <lol-ontology:entityId>Nocturne:W</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Покров тьмы</lol-ontology:name>
        <lol-ontology:slot>W</lol-ontology:slot>
        <lol-ontology:tooltipText>Пассивно: Ноктюрн получает {{ activeas }}% скорости атаки . Активно: Ноктюрн на 1,5 сек. создает теневой барьер, блокирующий следующее вражеское умение. При успешном блокировании пассивный эффект умения усилен до {{ activeas*2 }}% на {{ doubleasduration }} сек.{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Nocturne_W</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Nunu -->

