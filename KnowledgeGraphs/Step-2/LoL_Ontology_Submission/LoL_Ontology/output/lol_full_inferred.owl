    <!-- https://example.org/lol-ontology#Skarner_E -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Skarner_E">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Skarner"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Skarner"/>
        <lol-ontology:description>Скарнер устремляется вперед, игнорируя элементы ландшафта, и хватает первого чемпиона или большого монстра на пути. При столкновении со стеной жертва получает урон и оглушается.</lol-ontology:description>
        <lol-ontology:entityId>Skarner:E</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Наступление Ишталя</lol-ontology:name>
        <lol-ontology:slot>E</lol-ontology:slot>
        <lol-ontology:tooltipText>Скарнер устремляется в выбранном направлении, игнорируя элементы ландшафта. Если на пути оказывается чемпион или большой монстр, Скарнер хватает его и переносит с собой. При столкновении со стеной жертва получает {{ pindamage }} физического урона и оглушается на {{ stunduration }} сек. Умение можно применить повторно , прекратив рывок преждевременно.{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Skarner_E</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Skarner_P -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Skarner_P">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Skarner"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Skarner"/>
        <lol-ontology:description>Автоатаки Скарнера, а также Расколотая земля, Сотрясение и Пронзание накладывают на врагов Дрожь. При максимальном количестве зарядов Дрожи они получают периодический магический урон, который зависит от их здоровья.</lol-ontology:description>
        <lol-ontology:entityId>Skarner:P</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Нити вибрации</lol-ontology:name>
        <lol-ontology:slot>P</lol-ontology:slot>
        <rdfs:label>Skarner_P</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Skarner_Q -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Skarner_Q">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Skarner"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Skarner"/>
        <lol-ontology:description>Скарнер вырывает из земли валун и усиливает свои автоатаки. Валун можно швырнуть, нанеся сокрушительный урон.</lol-ontology:description>
        <lol-ontology:entityId>Skarner:Q</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Расколотая земля / Сотрясение</lol-ontology:name>
        <lol-ontology:slot>Q</lol-ontology:slot>
        <lol-ontology:tooltipText>Скарнер вырывает из земли валун и усиливает 3 следующие автоатаки: скорость атаки увеличивается на {{ attackspeed*100 }}%, и они наносят {{ abilitydamage }} физического урона окружающим врагам. Последняя атака дополнительно наносит физический урон в размере {{ maxhppercent*100 }}% от максимального запаса здоровья и замедляет пораженных врагов на {{ slowpercent*100 }}% на {{ slowduration }} сек. Повторное применение: Скарнер прекращает действие этого умения и швыряет валун, нанося физический урон в размере {{ spell.skarnerq:abilitydamage }} + {{ spell.skarnerq:maxhppercent*100 }}% от максимального запаса здоровья первому врагу на пути и всем врагам вокруг, а также замедляя их на {{ spell.skarnerq:slowpercent*100 }}% на {{ spell.skarnerq:slowduration }} сек.{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Skarner_Q</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Skarner_R -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Skarner_R">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Skarner"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Skarner"/>
        <lol-ontology:description>Скарнер бьет хвостами, подавляя вражеских чемпионов. Пока действует подавление, при перемещении Скарнер тащит жертв за собой.</lol-ontology:description>
        <lol-ontology:entityId>Skarner:R</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Пронзание</lol-ontology:name>
        <lol-ontology:slot>R</lol-ontology:slot>
        <lol-ontology:tooltipText>Скарнер бьет хвостами, нанося {{ damage }} магического урона и подавляя первых 3 пораженных чемпионов на {{ duration }} сек. Пока действует это умение, при перемещении Скарнер тащит пораженных чемпионов за собой. Если Скарнер попадает хотя бы по одному чемпиону, его скорость передвижения увеличивается на {{ speedboostamount*100 }}% на {{ speedboostduration }} сек. Если активна Расколотая земля , сначала применяется Сотрясение .{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Skarner_R</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Skarner_W -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Skarner_W">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Skarner"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Skarner"/>
        <lol-ontology:description>Скарнер получает щит и вызывает землетрясение, ударная волна от которого наносит урон и замедляет врагов.</lol-ontology:description>
        <lol-ontology:entityId>Skarner:W</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Сейсмический бастион</lol-ontology:name>
        <lol-ontology:slot>W</lol-ontology:slot>
        <lol-ontology:tooltipText>Скарнер получает щит прочностью {{ initialshield }} на {{ shieldduration }} сек. и вызывает землетрясение, которое наносит врагам поблизости {{ damage }} магического урона и замедляет их на {{ sloweffect*-100 }}% на {{ slowduration }} сек.{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Skarner_W</rdfs:label>
    </owl:Thing>
    


