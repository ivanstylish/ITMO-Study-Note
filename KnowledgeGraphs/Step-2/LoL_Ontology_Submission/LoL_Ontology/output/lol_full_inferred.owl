    <!-- https://example.org/lol-ontology#Swain_E -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Swain_E">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Swain"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Swain"/>
        <lol-ontology:description>Свейн выпускает вперед волну демонической энергии. После этого она возвращается, обездвиживая пораженных врагов. Свейн может подтянуть всех обездвиженных чемпионов к себе. Во время действия Демонического возвышения у этого умения сокращена перезарядка.</lol-ontology:description>
        <lol-ontology:entityId>Swain:E</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Недвижность</lol-ontology:name>
        <lol-ontology:slot>E</lol-ontology:slot>
        <lol-ontology:tooltipText>Свейн выпускает волну демонической энергии, которая затем возвращается к нему, взрываясь при столкновении с первым пораженным врагом. При этом она наносит {{ secondarydamage }} магического урона противникам поблизости и обездвиживает их на {{ rootduration }} сек. Обездвижив чемпиона, Свейн может повторно применить это умение, чтобы подтянуть к себе всех чемпионов, обездвиженных Недвижностью , и вырвать у каждого фрагмент души .{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Swain_E</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Swain_P -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Swain_P">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Swain"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Swain"/>
        <lol-ontology:description>Вороны Свейна собирают фрагменты души , которые лечат его и навсегда увеличивают максимальный запас здоровья.</lol-ontology:description>
        <lol-ontology:entityId>Swain:P</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Ненасытная стая</lol-ontology:name>
        <lol-ontology:slot>P</lol-ontology:slot>
        <rdfs:label>Swain_P</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Swain_Q -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Swain_Q">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Swain"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Swain"/>
        <lol-ontology:description>Свейн выпускает несколько зарядов мистической энергии, которые проходят сквозь врагов. Пораженные враги получают больше урона за каждый попавший в них заряд.</lol-ontology:description>
        <lol-ontology:entityId>Swain:Q</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Рука смерти</lol-ontology:name>
        <lol-ontology:slot>Q</lol-ontology:slot>
        <lol-ontology:tooltipText>Свейн выпускает 5 зарядов мистической энергии, нанося {{ initialdamage }} магического урона плюс {{ extraboltdamage }} магического урона за каждый заряд после первого (максимальный урон – {{ maxdamage }} ).{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Swain_Q</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Swain_R -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Swain_R">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Swain"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Swain"/>
        <lol-ontology:description>Свейн превращается в демона и вытягивает здоровье из вражеских чемпионов, миньонов и нейтральных монстров поблизости. После этого он может применить Вспышку демона, поразив окружающих врагов разрушительным взрывом и замедлив их. Превращение может длиться, пока Свейн вытягивает здоровье из вражеских чемпионов.</lol-ontology:description>
        <lol-ontology:entityId>Swain:R</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Демоническое возвышение</lol-ontology:name>
        <lol-ontology:slot>R</lol-ontology:slot>
        <lol-ontology:tooltipText>Свейн превращается в демона, каждую секунду нанося врагам поблизости {{ damagecalc }} магического урона и восстанавливая себе {{ healingcalc }} здоровья . Со временем его демоническая энергия иссякает, но он может бесконечно пополнять ее запас, вытягивая здоровье из вражеских чемпионов. Когда Свейн участвует в убийстве чемпиона, запас энергии восстанавливается полностью. Через {{ demonflarecastdelay }} сек. и раз в {{ demonflarecooldowntooltip }} сек. после этого Свейн, превращенный в демона, может применить Вспышку демона , которая наносит врагам {{ demonflaredamagetotal }} магического урона и замедляет их на {{ demonflareslowamount*100 }}% (эффект ослабевает в течение {{ demonflareslowduration }} сек.).{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Swain_R</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Swain_W -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Swain_W">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Swain"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Swain"/>
        <lol-ontology:description>Свейн создает демонический глаз, который наносит урон и замедляет врагов. Пораженные чемпионы раскрываются и дают Свейну фрагменты души.</lol-ontology:description>
        <lol-ontology:entityId>Swain:W</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Око империи</lol-ontology:name>
        <lol-ontology:slot>W</lol-ontology:slot>
        <lol-ontology:tooltipText>Свейн создает демонический глаз, который раскрывает выбранное место на 1.5 сек., а затем наносит врагам {{ totaldamage }} магического урона и замедляет их на {{ slow*-100 }}% на {{ slowduration }} сек. Пораженные чемпионы дают Свейну фрагмент души и раскрываются на {{ revealduration }} сек.{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Swain_W</rdfs:label>
    </owl:Thing>
    


