        <rdfs:label>Gwen</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Gwen_E -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Gwen_E">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Gwen"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Gwen"/>
        <lol-ontology:description>Гвен совершает рывок на небольшое расстояние и усиливает свои автоатаки на несколько секунд: их дальность и скорость увеличиваются, и они наносят магический урон при попадании . Если она поражает врага в течение этого времени, перезарядка умения частично сокращается.</lol-ontology:description>
        <lol-ontology:entityId>Gwen:E</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Свободный крой</lol-ontology:name>
        <lol-ontology:slot>E</lol-ontology:slot>
        <lol-ontology:tooltipText>Гвен совершает рывок и усиливает свои автоатаки на {{ buffduration }} сек. Во время действия усиления скорость атаки Гвен увеличена на {{ bonusattackspeed }}, а дальность атак - на {{ bonusattackrange }}. Кроме того, они наносят {{ onhitdamage }} магического урона %i:OnHit% при попадании . Первая усиленная атака, поразившая врага, сокращает перезарядку этого умения на {{ cdrefund*100 }}%.{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Gwen_E</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Gwen_P -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Gwen_P">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Gwen"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Gwen"/>
        <lol-ontology:description>Автоатаки Гвен наносят дополнительный магический урон в зависимости от запаса здоровья цели. Гвен восстанавливает себе здоровье в размере части урона, нанесенного чемпионам с помощью этого эффекта.</lol-ontology:description>
        <lol-ontology:entityId>Gwen:P</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Тысяча порезов</lol-ontology:name>
        <lol-ontology:slot>P</lol-ontology:slot>
        <rdfs:label>Gwen_P</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Gwen_Q -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Gwen_Q">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Gwen"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Gwen"/>
        <lol-ontology:description>Гвен щелкает ножницами в конусе перед собой до 6 раз, нанося магический урон. Бойцы в центре области поражения получают чистый урон, и каждый разрез накладывает на них эффект пассивного умения.</lol-ontology:description>
        <lol-ontology:entityId>Gwen:Q</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Чик-чик!</lol-ontology:name>
        <lol-ontology:slot>Q</lol-ontology:slot>
        <lol-ontology:tooltipText>Пассивно : Гвен получает 1 заряд, когда поражает врага автоатакой (максимум зарядов - 4; заряды существуют {{ buffduration }} сек.). Активно : Гвен поглощает заряды и щелкает ножницами перед собой, нанося {{ miniswipedamage }} магического урона , после чего щелкает еще по одному разу за каждый поглощенный заряд. Затем она щелкает последний раз, нанося {{ finalswipedamage }} магического урона . {{ truedamageconversion*100 }}% от урона, получаемого врагами в центре области поражения, наносится в виде чистого урона . Также на эти цели накладывается эффект Тысячи порезов . Наносит {{ minionmod*100 }}% урона миньонам. Урон миньонам, у которых осталось менее {{ executethreshold*100 }}% здоровья, не уменьшается. Кроме того, они получают {{ executebonus }}% дополнительного урона. {{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Gwen_Q</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Gwen_R -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Gwen_R">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Gwen"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Gwen"/>
        <lol-ontology:description>Гвен выпускает перед собой иголку, которая замедляет врагов, наносит магический урон и накладывает на пораженных чемпионов эффект Тысячи порезов. Это умение можно применить еще два раза – при каждой повторной активации Гвен выпускает больше иголок и наносит увеличенный урон.</lol-ontology:description>
        <lol-ontology:entityId>Gwen:R</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Вышивание</lol-ontology:name>
        <lol-ontology:slot>R</lol-ontology:slot>
        <lol-ontology:tooltipText>Первое применение: Гвен выпускает перед собой иголку, которая наносит {{ totaldamage }} магического урона , замедляет на {{ initialslow*-100 }}% на {{ debuffduration }} сек. и накладывает эффект Тысячи порезов на всех пораженных врагов. Гвен может повторно применить это умение до 2 раз в течение 6 сек. (перезарядка между применениями - {{ lockouttime }} сек.). Второе применение: Гвен выпускает перед собой 3 иголки, которые наносят {{ totaldamage3 }} магического урона . Третье применение: Гвен выпускает перед собой 5 иголок, которые наносят {{ totaldamage5 }} магического урона .{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Gwen_R</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Gwen_W -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Gwen_W">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Gwen"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Gwen"/>
        <lol-ontology:description>Гвен создает область из тумана, которая защищает ее от врагов извне. Выбрать ее целью могут лишь враги, которые находятся в тумане.</lol-ontology:description>
        <lol-ontology:entityId>Gwen:W</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Священный туман</lol-ontology:name>
        <lol-ontology:slot>W</lol-ontology:slot>
        <lol-ontology:tooltipText>Гвен создает вокруг себя область из священного тумана, становясь недосягаемой для всех врагов (кроме башен) извне на {{ zoneduration }} сек. или до тех пор, пока она не покинет область. Пока Гвен находится в тумане, ее броня и сопротивление магии увеличены на {{ totalresists }}. Гвен может один раз повторно применить это умение, призвав туман к себе. Кроме того, оно автоматически применяется повторно при первой попытке Гвен покинуть область.{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Gwen_W</rdfs:label>
    </owl:Thing>
    


