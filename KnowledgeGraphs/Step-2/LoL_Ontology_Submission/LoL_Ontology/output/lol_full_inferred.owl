    <!-- https://example.org/lol-ontology#Tryndamere_Q -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Tryndamere_Q">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Tryndamere"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Tryndamere"/>
        <lol-ontology:description>Триндамир получает наслаждение от битвы: с каждым ранением его сила атаки растет. Он может использовать Жажду крови, чтобы истратить ярость и вылечить себя.</lol-ontology:description>
        <lol-ontology:entityId>Tryndamere:Q</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Жажда крови</lol-ontology:name>
        <lol-ontology:slot>Q</lol-ontology:slot>
        <lol-ontology:tooltipText>Пассивно: Триндамир жаждет крови: он получает вплоть до {{ maximumbonusad }} силы атаки в зависимости от своего недостающего здоровья. Активно: Триндамир поглощает ярость , восстанавливая здоровье в размере {{ baseheal }} плюс {{ healperfury }} за каждую единицу ярости (максимум – {{ maximumheal }}) . {{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Tryndamere_Q</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Tryndamere_R -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Tryndamere_R">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Tryndamere"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Tryndamere"/>
        <lol-ontology:description>Жажда крови и ярость битвы настолько захватывают Триндамира, что он становится неубиваемым на некоторое время.</lol-ontology:description>
        <lol-ontology:entityId>Tryndamere:R</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Неугасающая ярость</lol-ontology:name>
        <lol-ontology:slot>R</lol-ontology:slot>
        <lol-ontology:tooltipText>Триндамир становится неубиваемым на {{ tryndrduration }} сек., сохраняя не менее {{ tryndrminhealth }} здоровья, а также мгновенно получает {{ tryndrfurygain }} ярости .{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Tryndamere_R</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Tryndamere_W -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Tryndamere_W">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
