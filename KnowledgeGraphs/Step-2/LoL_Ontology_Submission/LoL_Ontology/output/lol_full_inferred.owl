    <!-- https://example.org/lol-ontology#Sylas_E -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Sylas_E">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Sylas"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Sylas"/>
        <lol-ontology:description>Сайлас совершает рывок в выбранное место. Применив умение повторно, он выпускает свои цепи и притягивает себя к пораженному врагу.</lol-ontology:description>
        <lol-ontology:entityId>Sylas:E</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Побег/Пленение</lol-ontology:name>
        <lol-ontology:slot>E</lol-ontology:slot>
        <lol-ontology:tooltipText>Сайлас совершает быстрый рывок, после чего может повторно применить умение в течение 3.5 сек. Повторное применение: Сайлас выстреливает цепями и притягивается к первому пораженному врагу, нанося {{ damage }} магического урона и подбрасывая его на {{ knockupduration }} сек.{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Sylas_E</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Sylas_P -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Sylas_P">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Sylas"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Sylas"/>
        <lol-ontology:description>После применения умения Сайлас получает заряд Петрицитового вихря. При автоатаках Сайлас поглощает заряды и раскручивает заряженные цепи, нанося дополнительный магический урон пораженным врагам. Когда у Сайласа есть заряд Петрицитового вихря, его скорость атаки увеличивается.</lol-ontology:description>
        <lol-ontology:entityId>Sylas:P</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Петрицитовый вихрь</lol-ontology:name>
        <lol-ontology:slot>P</lol-ontology:slot>
        <rdfs:label>Sylas_P</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Sylas_Q -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Sylas_Q">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Sylas"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Sylas"/>
        <lol-ontology:description>Сайлас бьет цепями, перекрещивая их в выбранном месте. Цепи наносят урон и замедляют врагов. После задержки в месте пересечения происходит взрыв магической энергии, который наносит урон.</lol-ontology:description>
        <lol-ontology:entityId>Sylas:Q</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Удар цепями</lol-ontology:name>
        <lol-ontology:slot>Q</lol-ontology:slot>
        <lol-ontology:tooltipText>Сайлас бьет своими цепями, нанося врагам {{ damage }} магического урона и замедляя их на {{ slowamountcalc }} на {{ slowduration }} сек. Место, где скрещиваются цепи, взрывается, нанося еще {{ explosiondamage }} магического урона .{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Sylas_Q</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Sylas_R -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Sylas_R">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Sylas"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Sylas"/>
        <lol-ontology:description>Сайлас похищает абсолютное умение врага и может его применить.</lol-ontology:description>
        <lol-ontology:entityId>Sylas:R</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Похищение силы</lol-ontology:name>
        <lol-ontology:slot>R</lol-ontology:slot>
        <lol-ontology:tooltipText>Сайлас грабит вражеского чемпиона, получая возможность применить копию его абсолютного умения. Уровень похищенного умения соответствует уровню абсолютного умения Сайласа, а сила зависит от его показателей. После похищения умения Сайлас не может ограбить того же врага в течение периода, равного {{ pertargetcooldown }}% от времени перезарядки его умения (ускорение умений Сайласа уменьшает этот период; минимальный период - {{ minimumenemycooldown }} сек.).{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Sylas_R</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Sylas_W -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Sylas_W">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Sylas"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Sylas"/>
        <lol-ontology:description>Сайлас совершает рывок к врагу и наносит ему урон. Если цель - чемпион, Сайлас также восстанавливает себе здоровье.</lol-ontology:description>
        <lol-ontology:entityId>Sylas:W</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Убийца королей</lol-ontology:name>
        <lol-ontology:slot>W</lol-ontology:slot>
        <lol-ontology:tooltipText>Сайлас делает выпад к врагу, нанося ему {{ mindamage }} магического урона . Если цель - чемпион, Сайлас восстанавливает себе от {{ minhealing }} до {{ maxhealing }} здоровья в зависимости от своего недостающего здоровья (максимальная эффективность лечения достигается при {{ maxexecutethreshold*100 }}% здоровья).{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Sylas_W</rdfs:label>
    </owl:Thing>
    


