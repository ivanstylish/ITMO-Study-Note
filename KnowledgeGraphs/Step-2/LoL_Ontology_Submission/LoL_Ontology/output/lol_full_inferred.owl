    <!-- https://example.org/lol-ontology#Lucian_E -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Lucian_E">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Lucian"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Lucian"/>
        <lol-ontology:description>Люциан быстро бросается вперед на небольшое расстояние. Автоатаки с эффектом Стрелка света сокращают перезарядку Нескончаемой погони.</lol-ontology:description>
        <lol-ontology:entityId>Lucian:E</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
