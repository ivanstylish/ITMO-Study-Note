        <lol-ontology:hasAbility rdf:resource="https://example.org/lol-ontology#Renekton_R"/>
        <lol-ontology:hasAbility rdf:resource="https://example.org/lol-ontology#Renekton_W"/>
        <lol-ontology:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Fighter"/>
        <lol-ontology:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Tank"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Renekton"/>
        <lol-ontology:baseArmor rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">35.0</lol-ontology:baseArmor>
        <lol-ontology:baseAttackDamage rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">69.0</lol-ontology:baseAttackDamage>
        <lol-ontology:baseHP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">660.0</lol-ontology:baseHP>
        <lol-ontology:baseMP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">100.0</lol-ontology:baseMP>
        <lol-ontology:baseMoveSpeed rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">345.0</lol-ontology:baseMoveSpeed>
        <lol-ontology:entityId>Renekton</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Ренектон</lol-ontology:name>
        <lol-ontology:resourceType>Ярость</lol-ontology:resourceType>
        <lol-ontology:reviewStatus>effects_not_reviewed</lol-ontology:reviewStatus>
        <lol-ontology:title>Мясник из песков</lol-ontology:title>
        <rdfs:label>Renekton</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Renekton_E -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Renekton_E">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Renekton"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Renekton"/>
        <lol-ontology:description>Ренектон совершает рывок, нанося урон всем врагам на своем пути. Если запас ярости Ренектона составляет 50 или более, он наносит дополнительный урон и уменьшает броню пораженных врагов.</lol-ontology:description>
        <lol-ontology:entityId>Renekton:E</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Режь и руби</lol-ontology:name>
        <lol-ontology:slot>E</lol-ontology:slot>
        <lol-ontology:tooltipText>Ренектон совершает рывок, нанося {{ basicdamage }} физического урона . При этом он получает {{ minionragegeneration }} ярости за каждого пораженного врага, не являющегося чемпионом, и {{ championragegeneration }} ярости за каждого пораженного чемпиона. Если Ренектон поразил хотя бы одного врага, он может один раз повторно применить это умение в течение {{ dicetimer }} сек. Бонус ярости : урон рывка при повторном применении увеличивается до {{ empdamage }} . Кроме того, этот рывок уменьшает броню врагов на {{ enragedarmorshred }}% на {{ shredtimer }} сек. Усиленное умение не дает ярости .{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Renekton_E</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Renekton_P -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Renekton_P">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Renekton"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Renekton"/>
        <lol-ontology:description>При каждой автоатаке Ренектон увеличивает запас ярости, которая способна усиливать его умения. Кроме того, Ренектон получает дополнительную ярость, когда у него мало здоровья.</lol-ontology:description>
        <lol-ontology:entityId>Renekton:P</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Всепоглощающий гнев</lol-ontology:name>
        <lol-ontology:slot>P</lol-ontology:slot>
        <rdfs:label>Renekton_P</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Renekton_Q -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Renekton_Q">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Renekton"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Renekton"/>
        <lol-ontology:description>Ренектон рассекает всех врагов вокруг себя, нанося им умеренный физический урон и восстанавливая себе здоровье на долю от этого урона. Если запас ярости Ренектона составляет 50 или более, урон и восстановление здоровья увеличиваются.</lol-ontology:description>
        <lol-ontology:entityId>Renekton:Q</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Смерть слабым</lol-ontology:name>
        <lol-ontology:slot>Q</lol-ontology:slot>
        <lol-ontology:tooltipText>Ренектон совершает круговой удар клинком, нанося врагам {{ basicdamage }} физического урона , а также восстанавливая себе {{ nonchamphealing }} здоровья за каждого пораженного врага, не являющегося чемпионом, и {{ champhealing }} здоровья за каждого пораженного чемпиона. Кроме того, он получает {{ minionfurygain }} ярости за каждого врага, не являющегося чемпионом, и {{ championfurygain }} ярости за каждого чемпиона. Бонус ярости : урон увеличивается до {{ empdamage }} , а лечение – до {{ empnonchamphealing }} против врагов, не являющихся чемпионами, и до {{ empchamphealing }} против чемпионов. Усиленное умение не дает ярости .{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Renekton_Q</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Renekton_R -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Renekton_R">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Renekton"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Renekton"/>
        <lol-ontology:description>Ренектон принимает обличье великого тирана, увеличивая свой запас здоровья и нанося периодический магический урон всем окружающим врагам. Кроме того, текущий запас ярости Ренектона во время действия умения постоянно увеличивается.</lol-ontology:description>
        <lol-ontology:entityId>Renekton:R</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Тиран</lol-ontology:name>
        <lol-ontology:slot>R</lol-ontology:slot>
        <lol-ontology:tooltipText>Ренектон окружает себя темной энергией на {{ buffduration }} сек., увеличивая свой максимальный запас здоровья на {{ healthgain }} и получая {{ furyoncast }} ярости . Пока действует умение, Ренектон каждую секунду наносит врагам {{ totaldamagepersecond }} магического урона и получает {{ furypersecond }} ярости .{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Renekton_R</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Renekton_W -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Renekton_W">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Renekton"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Renekton"/>
        <lol-ontology:description>При следующей автоатаке Ренектон бьет дважды, нанося умеренный физический урон цели и оглушая ее на 0.75 секунды. Если запас ярости Ренектона составляет 50 или более, он бьет трижды, разрушая щиты от урона на цели, нанося ей большой физический урон и оглушая ее на 1.5 секунды.</lol-ontology:description>
        <lol-ontology:entityId>Renekton:W</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Беспощадный хищник</lol-ontology:name>
        <lol-ontology:slot>W</lol-ontology:slot>
        <lol-ontology:tooltipText>При следующей автоатаке Ренектон бьет дважды, оглушая цель на {{ stunduration }} сек. и нанося ей в общей сложности {{ basictotaldamage }} физического урона . Поражая чемпиона, Ренектон дополнительно получает {{ bonusfuryvschamps }} ярости . Бонус ярости : количество ударов увеличивается до 3. Ренектон уничтожает щиты , а затем наносит {{ emptotaldamage }} физического урона и оглушает цель на {{ enragedstunduration }} сек. Усиленное умение не дает ярости .{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Renekton_W</rdfs:label>
    </owl:Thing>
    


