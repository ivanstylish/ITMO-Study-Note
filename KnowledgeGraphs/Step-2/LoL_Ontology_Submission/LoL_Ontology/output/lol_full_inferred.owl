        <lol-ontology:slot>R</lol-ontology:slot>
        <lol-ontology:tooltipText>Вейгар поражает вражеского чемпиона первобытной магией, нанося ему от {{ mindamage }} до {{ maxdamage }} магического урона в зависимости от недостающего здоровья. Максимальный урон достигается при 33% здоровья.{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Veigar_R</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Veigar_W -->

