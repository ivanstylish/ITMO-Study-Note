        <lol-ontology:hasAbility rdf:resource="https://example.org/lol-ontology#Hwei_R"/>
        <lol-ontology:hasAbility rdf:resource="https://example.org/lol-ontology#Hwei_W"/>
        <lol-ontology:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Mage"/>
        <lol-ontology:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Support"/>
