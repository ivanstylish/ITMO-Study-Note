    <!-- https://example.org/lol-ontology#Singed_E -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Singed_E">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Singed"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Singed"/>
        <lol-ontology:description>Синджед перебрасывает выбранного противника за спину, нанося ему урон. Если враг приземляется в липкой зоне, созданной Мегаклеем, он обездвиживается.</lol-ontology:description>
        <lol-ontology:entityId>Singed:E</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Бросок</lol-ontology:name>
        <lol-ontology:slot>E</lol-ontology:slot>
        <lol-ontology:tooltipText>Синджед перебрасывает врага через плечо, нанося магический урон в размере {{ basedamage }} ед. плюс {{ maxhpdamage }}% от макс. запаса здоровья . Если Синджед бросает цель в Мегаклей , она обездвиживается на {{ rootduration }} сек.{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Singed_E</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Singed_P -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Singed_P">
