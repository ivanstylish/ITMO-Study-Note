    <!-- https://example.org/lol-ontology#Seraphine_E -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Seraphine_E">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Seraphine"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Seraphine"/>
        <lol-ontology:description>Серафина наносит урон врагам на прямой и ограничивает их передвижение.</lol-ontology:description>
        <lol-ontology:entityId>Seraphine:E</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Ударный ритм</lol-ontology:name>
        <lol-ontology:slot>E</lol-ontology:slot>
        <lol-ontology:tooltipText>Серафина выпускает мощную звуковую волну, нанося {{ finaldamage }} магического урона врагам на прямой и замедляя их на {{ slowvalue }}% на {{ slowduration }} сек. Замедленных врагов она обездвиживает , а обездвиженных оглушает .{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Seraphine_E</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Seraphine_P -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Seraphine_P">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Seraphine"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Seraphine"/>
        <lol-ontology:description>Каждое третье базовое умение Серафины применяется дважды. Кроме того, если она применяет умения рядом с союзниками, дальность и магический урон ее следующей автоатаки увеличиваются.</lol-ontology:description>
        <lol-ontology:entityId>Seraphine:P</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Сценическое обаяние</lol-ontology:name>
        <lol-ontology:slot>P</lol-ontology:slot>
        <rdfs:label>Seraphine_P</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Seraphine_Q -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Seraphine_Q">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Seraphine"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Seraphine"/>
        <lol-ontology:description>Серафина наносит урон по площади.</lol-ontology:description>
        <lol-ontology:entityId>Seraphine:Q</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Высокая нота</lol-ontology:name>
        <lol-ontology:slot>Q</lol-ontology:slot>
        <lol-ontology:tooltipText>Серафина выдает чистую ноту, нанося {{ explosiondamage }} ед. магического урона . Урон против чемпионов и монстров увеличивается в зависимости от недостающего здоровья цели – вплоть до {{ totalempowereddamage }} ед., когда у цели меньше {{ executethreshold*100 }}% здоровья.{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Seraphine_Q</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Seraphine_R -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Seraphine_R">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Seraphine"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Seraphine"/>
        <lol-ontology:description>Серафина очаровывает пораженных врагов и наносит им урон. Когда заряд касается союзного или вражеского чемпиона, дальность полета обновляется.</lol-ontology:description>
        <lol-ontology:entityId>Seraphine:R</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Исполнение на бис</lol-ontology:name>
        <lol-ontology:slot>R</lol-ontology:slot>
        <lol-ontology:tooltipText>Серафина начинает выступление, выпуская волну, которая очаровывает врагов на {{ rchannelduration }} сек. и наносит {{ r1totaldamage }} магического урона . Все затронутые чемпионы (включая союзников) становятся частью выступления, увеличивая дальность полета волны. Союзные чемпионы при этом получают максимальное количество нот .{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Seraphine_R</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Seraphine_W -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Seraphine_W">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Seraphine"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Seraphine"/>
        <lol-ontology:description>Серафина накладывает щит на союзников поблизости и ускоряет их. Если на Серафину уже наложен щит, она также лечит союзников поблизости.</lol-ontology:description>
        <lol-ontology:entityId>Seraphine:W</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Объемный звук</lol-ontology:name>
        <lol-ontology:slot>W</lol-ontology:slot>
        <lol-ontology:tooltipText>Серафина поет песню для союзных чемпионов поблизости, увеличивая их скорость передвижения на {{ hastevalueallies }} и свою скорость передвижения на {{ wmsbonustotal }} (эффект ослабевает со временем) , а также накладывая на всех щит прочностью {{ shieldvalueseraphine }} на {{ shieldduration }} сек. Если на Серафину уже действует щит , она приглашает союзников присоединиться к ней, восстанавливая им {{ wmissinghpheal }}% от недостающего здоровья через {{ whealsplitdelay }} сек.{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Seraphine_W</rdfs:label>
    </owl:Thing>
    


