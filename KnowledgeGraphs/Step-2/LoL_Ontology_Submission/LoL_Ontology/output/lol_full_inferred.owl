        <rdfs:label>Twitch_P</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Twitch_Q -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Twitch_Q">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Twitch"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Twitch"/>
        <lol-ontology:description>Твич маскируется на короткое время, одновременно увеличивая скорость передвижения. Когда Твич сбрасывает маскировку, его скорость атаки ненадолго увеличивается. Когда умирает вражеский чемпион, пораженный Смертельным ядом, время перезарядки Засады обнуляется.</lol-ontology:description>
        <lol-ontology:entityId>Twitch:Q</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Засада</lol-ontology:name>
        <lol-ontology:slot>Q</lol-ontology:slot>
        <lol-ontology:tooltipText>Твич получает маскировку и увеличивает скорость передвижения на {{ movespeedmod }}% на {{ stealthduration }} сек. Скорость передвижения увеличивается до {{ hiddenspeed }}%, если рядом находится вражеский чемпион, который не видит Твича. После снятия маскировки Твич увеличивает скорость атаки на {{ attackspeedmod*100 }}% на {{ attackspeedduration }} сек. Когда погибает вражеский чемпион, пораженный ядом , перезарядка этого умения сбрасывается.{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Twitch_Q</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Twitch_R -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Twitch_R">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Twitch"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Twitch"/>
        <lol-ontology:description>Твич использует арбалет на полную мощь: болты летят на большое расстояние, пронзая всех врагов на своем пути.</lol-ontology:description>
        <lol-ontology:entityId>Twitch:R</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Стрельба наугад</lol-ontology:name>
        <lol-ontology:slot>R</lol-ontology:slot>
        <lol-ontology:tooltipText>Твич достает свой арбалет, увеличивая дальность атаки на {{ bonusrange }} и силу атаки на {{ bonusad }} на {{ duration }} сек. Во время действия умения снаряды автоатак проходят сквозь врагов и поражают все цели на своем пути, однако каждая последующая цель получает на {{ falloffdamage*100 }}% меньше урона (минимальный урон - {{ minimumfalloffdamage*100 }}%). {{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Twitch_R</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Twitch_W -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Twitch_W">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Twitch"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Twitch"/>
        <lol-ontology:description>Твич бросает склянку с ядом, отравляя всех врагов в зоне поражения Смертельным ядом и замедляя их.</lol-ontology:description>
        <lol-ontology:entityId>Twitch:W</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Склянка с ядом</lol-ontology:name>
        <lol-ontology:slot>W</lol-ontology:slot>
        <lol-ontology:tooltipText>Твич бросает склянку с ядом, накладывая заряд Смертельного яда на всех врагов в зоне поражения и оставляя на этом месте ядовитое облако, сохраняющееся в течение {{ duration }} сек. Враги, стоящие в ядовитом облаке, замедляются на {{ totalslowamount }}% и каждую секунду получают заряд Смертельного яда .{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Twitch_W</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Udyr -->

