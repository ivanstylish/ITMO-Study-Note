        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Nasus"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Nasus"/>
        <lol-ontology:description>Насус старит вражеского чемпиона, постепенно уменьшая его скорость передвижения и скорость атаки.</lol-ontology:description>
        <lol-ontology:entityId>Nasus:W</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Иссушение</lol-ontology:name>
        <lol-ontology:slot>W</lol-ontology:slot>
        <lol-ontology:tooltipText>Насус старит чемпиона, замедляя его на {{ slowbase }}% (эффективность увеличивается до {{ maxslowtooltiponly }}% в течение {{ duration }} сек.). Кроме того, старение уменьшает скорость атаки цели на {{ attackspeedslowmult*100 }}% от замедления .{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Nasus_W</rdfs:label>
    </owl:Thing>
    


