    <!-- https://example.org/lol-ontology#Azir_E -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Azir_E">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Azir"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Azir"/>
        <lol-ontology:description>Азир ненадолго защищает себя щитом и совершает рывок к одному из своих песчаных воинов, нанося урон врагам на своем пути. Если Азир сталкивается с вражеским чемпионом, у него мгновенно появляется в запасе еще один воин, а рывок прекращается.</lol-ontology:description>
        <lol-ontology:entityId>Azir:E</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Подвижный песок</lol-ontology:name>
        <lol-ontology:slot>E</lol-ontology:slot>
        <lol-ontology:tooltipText>Азир накладывает на себя щит прочностью {{ totalshield }} на {{ shieldduration }} сек. и совершает рывок к одному из своих песчаных воинов , нанося {{ totaldamage }} ед. маг. урона всем врагам на пути. Столкнувшись с вражеским чемпионом, Азир останавливается и добавляет в резерв 1 песчаного воина .{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Azir_E</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Azir_P -->

