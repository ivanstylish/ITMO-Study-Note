    <!-- https://example.org/lol-ontology#Gragas_E -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Gragas_E">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Gragas"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Gragas"/>
        <lol-ontology:description>Грагас совершает рывок в указанную точку. Первый противник, с которым он сталкивается на своем пути, и все враги вокруг него получают урон и оглушаются.</lol-ontology:description>
        <lol-ontology:entityId>Gragas:E</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Таран</lol-ontology:name>
        <lol-ontology:slot>E</lol-ontology:slot>
        <lol-ontology:tooltipText>Грагас совершает рывок вперед, останавливаясь при столкновении с первым врагом на пути. При этом он подбрасывает врагов поблизости на {{ stunduration }} сек. и наносит им {{ totaldamage }} магического урона . При столкновении с врагом время перезарядки этого умения сокращается на {{ cooldownrefund*100 }}%.{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Gragas_E</rdfs:label>
    </owl:Thing>
    


