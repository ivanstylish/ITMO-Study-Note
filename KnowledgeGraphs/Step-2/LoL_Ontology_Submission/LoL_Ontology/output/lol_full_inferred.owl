        <rdfs:label>Blitzcrank_Q</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Blitzcrank_R -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Blitzcrank_R">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Blitzcrank"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Blitzcrank"/>
        <lol-ontology:description>Враги, которых атакует Блицкранк, помечаются и через 1 секунду поражаются молнией, которая наносит урон. Умение можно активировать, чтобы уничтожить щиты ближайших врагов, нанести им урон и ненадолго наложить безмолвие.</lol-ontology:description>
        <lol-ontology:entityId>Blitzcrank:R</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Статическое поле</lol-ontology:name>
        <lol-ontology:slot>R</lol-ontology:slot>
        <lol-ontology:tooltipText>Пассивно: когда умение не находится на перезарядке, Блицкранк заряжает свои кулаки электричеством и его автоатаки помечают врагов. Через 1 сек. помеченные цели получают {{ passivedamage }} магического урона . Активно: Блицкранк перегружается, нанося {{ activedamage }} магического урона окружающим врагам и накладывая на них безмолвие на {{ silenceduration }} сек. При этом он разрушает их щиты.{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Blitzcrank_R</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Blitzcrank_W -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Blitzcrank_W">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Blitzcrank"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Blitzcrank"/>
        <lol-ontology:description>Блицкранк перегружает себя, значительно увеличивая свои скорость передвижения и скорость атаки. По окончании перегрузки его скорость передвижения на время уменьшается.</lol-ontology:description>
        <lol-ontology:entityId>Blitzcrank:W</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Ускорение</lol-ontology:name>
        <lol-ontology:slot>W</lol-ontology:slot>
        <lol-ontology:tooltipText>Блицкранк перегружает себя, увеличивая скорость передвижения на {{ movespeedmod*100 }}% (эффект ослабевает со временем) и скорость атаки на {{ attackspeedmod*100 }}% на {{ duration }} сек. По окончании действия эффекта Блицкранк замедляется на {{ movespeedmodreduction*100 }}% на {{ slowduration }} сек.{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Blitzcrank_W</rdfs:label>
    </owl:Thing>
    


