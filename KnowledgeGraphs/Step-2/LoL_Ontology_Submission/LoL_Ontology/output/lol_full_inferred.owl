    <!-- https://example.org/lol-ontology#Pantheon_E -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Pantheon_E">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Pantheon"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Pantheon"/>
        <lol-ontology:description>Пантеон выставляет щит и становится невосприимчивым к урону спереди. При этом он несколько раз наносит удары копьем.</lol-ontology:description>
        <lol-ontology:entityId>Pantheon:E</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Агрессивная защита</lol-ontology:name>
        <lol-ontology:slot>E</lol-ontology:slot>
        <lol-ontology:tooltipText>Пантеон выставляет свой щит и атакует врагов в выбранном направлении в течение {{ shieldduration }} сек., становясь невосприимчивым к урону с этой стороны (кроме урона от башен) и нанося {{ damagecalc }} физического урона на протяжении действия умения. После этого Пантеон бьет своим щитом, нанося {{ shielddamagecalc }} физического урона . Усиление Волей смертного: когда Пантеон бьет щитом, он получает {{ resistscalc }} брони и {{ resistscalc }} сопротивления магии на {{ resistsduration }} сек., а его скорость передвижения увеличивается на {{ speedamount*100 }}% на {{ speedduration }} сек. {{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Pantheon_E</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Pantheon_P -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Pantheon_P">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
