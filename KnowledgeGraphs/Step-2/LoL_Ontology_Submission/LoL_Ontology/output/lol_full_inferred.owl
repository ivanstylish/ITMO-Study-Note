    <!-- https://example.org/lol-ontology#Heimerdinger_E -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Heimerdinger_E">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Heimerdinger"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Heimerdinger"/>
        <lol-ontology:description>Хеймердингер бросает гранату в указанную точку, нанося урон и замедляя всех противников в зоне поражения, а также оглушая врагов, оказавшихся в эпицентре взрыва.</lol-ontology:description>
        <lol-ontology:entityId>Heimerdinger:E</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Оглушающая граната CH-2</lol-ontology:name>
        <lol-ontology:slot>E</lol-ontology:slot>
        <lol-ontology:tooltipText>Хеймердингер бросает гранату, которая наносит {{ damage }} магического урона врагам в области поражения и замедляет их на {{ slowpercent.0*100 }}% на {{ slowduration }} сек. Враги, оказавшиеся в эпицентре взрыва, вдобавок оглушаются на {{ stunduration }} сек. Если граната попадает в чемпиона, ближайшие турели полностью заряжаются.{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Heimerdinger_E</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Heimerdinger_P -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Heimerdinger_P">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Heimerdinger"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Heimerdinger"/>
        <lol-ontology:description>Увеличивает скорость передвижения при нахождении рядом с союзными башнями или турелями Хеймердингера.</lol-ontology:description>
        <lol-ontology:entityId>Heimerdinger:P</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Тяга к хекстеку</lol-ontology:name>
