        <lol-ontology:hasAbility rdf:resource="https://example.org/lol-ontology#Shyvana_Q"/>
        <lol-ontology:hasAbility rdf:resource="https://example.org/lol-ontology#Shyvana_R"/>
        <lol-ontology:hasAbility rdf:resource="https://example.org/lol-ontology#Shyvana_W"/>
        <lol-ontology:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Fighter"/>
        <lol-ontology:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Tank"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Shyvana"/>
        <lol-ontology:baseArmor rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">35.0</lol-ontology:baseArmor>
