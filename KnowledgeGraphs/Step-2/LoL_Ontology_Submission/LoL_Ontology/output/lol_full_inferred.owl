        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Kassadin"/>
        <lol-ontology:description>Кассадин получает меньше магического урона и может проходить сквозь бойцов.</lol-ontology:description>
        <lol-ontology:entityId>Kassadin:P</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
