    <!-- https://example.org/lol-ontology#Kaisa_E -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Kaisa_E">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Kaisa"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Kaisa"/>
        <lol-ontology:description>Кай&apos;Са ненадолго увеличивает скорость передвижения, а затем - скорость атаки. Живое оружие: Сверхзаряд улучшен и ненадолго дает невидимость.</lol-ontology:description>
        <lol-ontology:entityId>Kaisa:E</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Сверхзаряд</lol-ontology:name>
        <lol-ontology:slot>E</lol-ontology:slot>
        <lol-ontology:tooltipText>Кай&apos;Са заряжается энергией Бездны, ненадолго увеличивая свою скорость передвижения на {{ totalmovespeed }} и получая призрачность. После этого она увеличивает свою скорость атаки на {{ e5 }}% на {{ e2 }} сек. Автоатаки сокращают перезарядку этого умения на {{ e4 }} сек. Развитие : Кай&apos;Са также становится невидимой на {{ e7 }} сек. Прогресс: {{ f10.1 }}%/{{ e6 }}% дополнительной скорости атаки {{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Kaisa_E</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Kaisa_P -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Kaisa_P">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Kaisa"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Kaisa"/>
        <lol-ontology:description>Автоатаки Кай&apos;Сы накладывают заряды плазмы, нанося дополнительный магический урон. Обездвиживающие эффекты союзников также накладывают заряды плазмы. Кроме того, при покупке предметов Кай&apos;Са развивает свои базовые умения, и у них появляются дополнительные эффекты.</lol-ontology:description>
        <lol-ontology:entityId>Kaisa:P</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Вторая кожа</lol-ontology:name>
        <lol-ontology:slot>P</lol-ontology:slot>
        <rdfs:label>Kaisa_P</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Kaisa_Q -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Kaisa_Q">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Kaisa"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Kaisa"/>
        <lol-ontology:description>Кай&apos;Са выпускает множество снарядов, которые летят к ближайшим целям. Живое оружие: Дождь Икатии улучшен и выпускает больше зарядов.</lol-ontology:description>
        <lol-ontology:entityId>Kaisa:Q</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Дождь Икатии</lol-ontology:name>
        <lol-ontology:slot>Q</lol-ontology:slot>
        <lol-ontology:tooltipText>Кай&apos;Са выпускает снаряды ({{ e2 }}), которые летят в ближайших врагов. Каждый снаряд наносит {{ totalindividualmissiledamage }} ед. физического урона (максимум: {{ maxdamagedisplay }}). Все последующие попадания по чемпионам или монстрам после первого наносят {{ extrahitreduction*100 }}% урона. Развитие : количество снарядов увеличивается до {{ e7 }}. Прогресс: {{ f11.1 }}/{{ e6 }} дополнительной силы атаки {{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Kaisa_Q</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Kaisa_R -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Kaisa_R">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Kaisa"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Kaisa"/>
        <lol-ontology:description>Кай&apos;Са совершает рывок к вражескому чемпиону.</lol-ontology:description>
        <lol-ontology:entityId>Kaisa:R</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Охотничий инстинкт</lol-ontology:name>
        <lol-ontology:slot>R</lol-ontology:slot>
        <lol-ontology:tooltipText>Кай&apos;Са совершает рывок к вражескому чемпиону, пораженному плазмой , и получает щит прочностью {{ rcalculatedshieldvalue }} на {{ rshieldduration }} сек.{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Kaisa_R</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Kaisa_W -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Kaisa_W">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Kaisa"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Kaisa"/>
        <lol-ontology:description>Кай&apos;Са выпускает дальнобойный снаряд, помечая врагов пассивным умением. Живое оружие: Ловчая из Бездны улучшена и накладывает больше зарядов пассивного умения, а также сокращает перезарядку при поражении чемпионов.</lol-ontology:description>
        <lol-ontology:entityId>Kaisa:W</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Ловчая из Бездны</lol-ontology:name>
        <lol-ontology:slot>W</lol-ontology:slot>
        <lol-ontology:tooltipText>Кай&apos;Са выпускает сгусток энергии Бездны, который наносит первому пораженному врагу {{ totaldamage }} магического урона , накладывает {{ e4 }} заряда плазмы и дает истинное видение цели на {{ spell.kaisapassive:pduration }} сек. Развитие : количество накладываемых зарядов плазмы увеличивается до {{ e5 }}. При поражении чемпиона перезарядка этого умения сокращается на {{ e3 }}%. Прогресс: {{ f2.1 }}/{{ e2 }} силы умений {{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Kaisa_W</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Kalista -->

