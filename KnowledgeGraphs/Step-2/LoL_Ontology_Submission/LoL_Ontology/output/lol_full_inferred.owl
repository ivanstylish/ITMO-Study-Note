        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Olaf"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Olaf"/>
        <lol-ontology:description>Олаф увеличивает свою скорость атаки и вампиризм в зависимости от недостающего здоровья.</lol-ontology:description>
        <lol-ontology:entityId>Olaf:P</lol-ontology:entityId>
