        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Yone"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Yone"/>
        <lol-ontology:description>Ёнэ телепортируется за последнего чемпиона на прямой, поражая всех врагов на пути с такой силой, что они подтягиваются к нему.</lol-ontology:description>
        <lol-ontology:entityId>Yone:R</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Решение судьбы</lol-ontology:name>
        <lol-ontology:slot>R</lol-ontology:slot>
        <lol-ontology:tooltipText>Ёнэ поражает всех врагов на пути перед собой, нанося {{ tooltipdamage }} физического урона и {{ tooltipdamage }} магического урона . При этом Ёнэ телепортируется за последнего пораженного чемпиона и подбрасывает жертв, подтягивая их к себе.{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Yone_R</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Yone_W -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Yone_W">
