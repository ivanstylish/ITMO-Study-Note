        <lol-ontology:slot>E</lol-ontology:slot>
        <lol-ontology:tooltipText>Пассивно: Твистед Фэйт получает {{ attackspeedbonus }}% скорости атаки , и каждая его 4-я автоатака дополнительно наносит {{ bonusdamage }} магического урона .{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>TwistedFate_E</rdfs:label>
    </owl:Thing>
    


