    <!-- https://example.org/lol-ontology#Samira_E -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Samira_E">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Samira"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Samira"/>
        <lol-ontology:description>Самира совершает рывок сквозь врага (включая строения), нанося урон всем противникам на пути и увеличивая скорость атаки. Убийства вражеских чемпионов сбрасывают перезарядку этого умения.</lol-ontology:description>
        <lol-ontology:entityId>Samira:E</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Неистовый рывок</lol-ontology:name>
        <lol-ontology:slot>E</lol-ontology:slot>
        <lol-ontology:tooltipText>Самира совершает рывок сквозь врага (включая строения), нанося {{ dashdamage }} магического урона всем противникам на пути и увеличивая свою скорость атаки на {{ bonusattackspeed*100 }}% на {{ attackspeedduration }} сек. Если вражеский чемпион погибает в течение 3 сек. после того, как Самира нанесла ему урон, перезарядка этого умения сбрасывается.{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Samira_E</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Samira_P -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Samira_P">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Samira"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Samira"/>
        <lol-ontology:description>Попадая автоатаками или умениями, отличными от тех, которыми Самира попала перед этим, она выстраивает комбинацию. Автоатаки Самиры в ближнем бою наносят дополнительный магический урон. Когда Самира применяет автоатаки к врагам, на которых действуют эффекты обездвиживания , она совершает к ним рывок на расстояние дальности атаки. Если цель подброшена , продолжительность подбрасывания немного увеличивается.</lol-ontology:description>
        <lol-ontology:entityId>Samira:P</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Безрассудный порыв</lol-ontology:name>
        <lol-ontology:slot>P</lol-ontology:slot>
        <rdfs:label>Samira_P</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Samira_Q -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Samira_Q">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Samira"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Samira"/>
        <lol-ontology:description>Самира совершает выстрел или удар мечом, нанося урон. При применении во время Неистового рывка Самира поражает всех врагов на своем пути.</lol-ontology:description>
        <lol-ontology:entityId>Samira:Q</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Эпатаж</lol-ontology:name>
        <lol-ontology:slot>Q</lol-ontology:slot>
        <lol-ontology:tooltipText>Самира совершает выстрел, нанося {{ damagecalc }} физического урона первому пораженному врагу. Если это умение направлено во врага вблизи, вместо выстрела Самира совершает удар мечом, нанося {{ damagecalc }} физического урона . {{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Samira_Q</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Samira_R -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Samira_R">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Samira"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Samira"/>
        <lol-ontology:description>Самира безостановочно палит из своих пистолетов, расстреливая всех врагов вокруг.</lol-ontology:description>
        <lol-ontology:entityId>Samira:R</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Адское пекло</lol-ontology:name>
        <lol-ontology:slot>R</lol-ontology:slot>
        <lol-ontology:tooltipText>Самира может применить это умение, только если ее оценка стиля – S. Это умение поглощает весь заработанный стиль . Самира осыпает градом пуль всех врагов вокруг до 10 раз в течение 2 сек. Каждый выстрел наносит {{ damagecalc }} ед. физического урона , и на него действует вампиризм с эффективностью {{ lifestealmod*100 }}%. Кроме того, каждый выстрел может быть критическим.{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Samira_R</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Samira_W -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Samira_W">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Samira"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Samira"/>
        <lol-ontology:description>Самира вращается с мечом, нанося урон врагам и уничтожая вражеские снаряды.</lol-ontology:description>
        <lol-ontology:entityId>Samira:W</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Взмах клинка</lol-ontology:name>
        <lol-ontology:slot>W</lol-ontology:slot>
        <lol-ontology:tooltipText>Самира вращается с мечом в течение {{ slashduration }} сек., дважды нанося врагам {{ damagecalc }} физического урона и уничтожая любые вражеские снаряды, которые к ней подлетают. {{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Samira_W</rdfs:label>
    </owl:Thing>
    


