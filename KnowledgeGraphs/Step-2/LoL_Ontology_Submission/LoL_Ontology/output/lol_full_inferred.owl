    <!-- https://example.org/lol-ontology#Vayne_E -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Vayne_E">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Vayne"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Vayne"/>
        <lol-ontology:description>Вейн выстреливает огромным болтом из тяжелого арбалета за спиной, который откидывает цель назад и наносит ей физический урон. Если цель врежется в препятствие, ее пригвоздит к нему, она получит дополнительный урон и будет оглушена.</lol-ontology:description>
        <lol-ontology:entityId>Vayne:E</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Приговор</lol-ontology:name>
        <lol-ontology:slot>E</lol-ontology:slot>
        <lol-ontology:tooltipText>Вейн выпускает стрелу, которая отбрасывает цель и наносит ей {{ totaldamage }} физического урона . Если цель сталкивается с элементом ландшафта, она дополнительно получает {{ empowereddamagett }} физического урона и оглушается на {{ stunduration }} сек. {{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Vayne_E</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Vayne_P -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Vayne_P">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Vayne"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Vayne"/>
        <lol-ontology:description>Вейн безжалостно охотится на злодеев. При движении в сторону вражеских чемпионов поблизости у нее увеличивается скорость передвижения.</lol-ontology:description>
        <lol-ontology:entityId>Vayne:P</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Ночная охотница</lol-ontology:name>
        <lol-ontology:slot>P</lol-ontology:slot>
