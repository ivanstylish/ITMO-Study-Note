    <!-- https://example.org/lol-ontology#Morgana_W -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Morgana_W">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
