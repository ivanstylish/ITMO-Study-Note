<?xml version="1.0"?>
<rdf:RDF xmlns="https://example.org/lol-ontology/inferred/demo#"
     xml:base="https://example.org/lol-ontology/inferred/demo"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:lol-ontology="https://example.org/lol-ontology#">
    <owl:Ontology rdf:about="https://example.org/lol-ontology/inferred/demo"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.org/dc/terms/description -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/description"/>
    


    <!-- http://purl.org/dc/terms/title -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/title"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://example.org/lol-ontology#canApplyMechanic -->

    <owl:ObjectProperty rdf:about="https://example.org/lol-ontology#canApplyMechanic">
        <rdfs:domain rdf:resource="https://example.org/lol-ontology#Champion"/>
        <rdfs:range rdf:resource="https://example.org/lol-ontology#Mechanic"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="https://example.org/lol-ontology#hasAbility"/>
            <rdf:Description rdf:about="https://example.org/lol-ontology#hasEffect"/>
            <rdf:Description rdf:about="https://example.org/lol-ontology#hasMechanic"/>
        </owl:propertyChainAxiom>
        <rdfs:comment xml:lang="ru">Выводится цепочкой hasAbility / hasEffect / hasMechanic; не хранит условия.</rdfs:comment>
        <rdfs:label>canApplyMechanic</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://example.org/lol-ontology#effectOf -->

    <owl:ObjectProperty rdf:about="https://example.org/lol-ontology#effectOf">
        <owl:inverseOf rdf:resource="https://example.org/lol-ontology#hasEffect"/>
        <rdfs:domain rdf:resource="https://example.org/lol-ontology#AbilityEffect"/>
        <rdfs:range rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdfs:comment xml:lang="ru">Эффект относится к умению; обратное hasEffect.</rdfs:comment>
        <rdfs:label>effectOf</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://example.org/lol-ontology#hasAbility -->

    <owl:ObjectProperty rdf:about="https://example.org/lol-ontology#hasAbility">
        <owl:inverseOf rdf:resource="https://example.org/lol-ontology#isAbilityOf"/>
        <rdfs:domain rdf:resource="https://example.org/lol-ontology#Champion"/>
        <rdfs:range rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdfs:comment xml:lang="ru">У чемпиона есть умение.</rdfs:comment>
        <rdfs:label>hasAbility</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://example.org/lol-ontology#hasCategory -->

    <owl:ObjectProperty rdf:about="https://example.org/lol-ontology#hasCategory">
        <rdfs:domain rdf:resource="https://example.org/lol-ontology#Champion"/>
        <rdfs:range rdf:resource="https://example.org/lol-ontology#ChampionCategory"/>
        <rdfs:comment xml:lang="ru">Категория чемпиона в Data Dragon.</rdfs:comment>
        <rdfs:label>hasCategory</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://example.org/lol-ontology#hasEffect -->

    <owl:ObjectProperty rdf:about="https://example.org/lol-ontology#hasEffect">
        <rdfs:domain rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdfs:range rdf:resource="https://example.org/lol-ontology#AbilityEffect"/>
        <rdfs:comment xml:lang="ru">Умение имеет конкретный эффект.</rdfs:comment>
        <rdfs:label>hasEffect</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://example.org/lol-ontology#hasMechanic -->

    <owl:ObjectProperty rdf:about="https://example.org/lol-ontology#hasMechanic">
        <rdfs:domain rdf:resource="https://example.org/lol-ontology#AbilityEffect"/>
        <rdfs:range rdf:resource="https://example.org/lol-ontology#Mechanic"/>
        <rdfs:comment xml:lang="ru">Механика конкретного эффекта.</rdfs:comment>
        <rdfs:label>hasMechanic</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://example.org/lol-ontology#hasSource -->

    <owl:ObjectProperty rdf:about="https://example.org/lol-ontology#hasSource">
        <rdfs:range rdf:resource="https://example.org/lol-ontology#SourceDocument"/>
        <rdfs:comment xml:lang="ru">Источник сведений об объекте.</rdfs:comment>
        <rdfs:label>hasSource</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://example.org/lol-ontology#hasTargetType -->

    <owl:ObjectProperty rdf:about="https://example.org/lol-ontology#hasTargetType">
        <rdfs:domain rdf:resource="https://example.org/lol-ontology#AbilityEffect"/>
        <rdfs:range rdf:resource="https://example.org/lol-ontology#TargetType"/>
        <rdfs:comment xml:lang="ru">Получатель конкретного эффекта.</rdfs:comment>
        <rdfs:label>hasTargetType</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://example.org/lol-ontology#isAbilityOf -->

    <owl:ObjectProperty rdf:about="https://example.org/lol-ontology#isAbilityOf">
        <rdfs:domain rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdfs:range rdf:resource="https://example.org/lol-ontology#Champion"/>
        <rdfs:comment xml:lang="ru">Умение принадлежит чемпиону; обратное hasAbility.</rdfs:comment>
        <rdfs:label>isAbilityOf</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://example.org/lol-ontology#baseArmor -->

    <owl:DatatypeProperty rdf:about="https://example.org/lol-ontology#baseArmor">
        <rdfs:domain rdf:resource="https://example.org/lol-ontology#Champion"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:label>baseArmor</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://example.org/lol-ontology#baseAttackDamage -->

    <owl:DatatypeProperty rdf:about="https://example.org/lol-ontology#baseAttackDamage">
        <rdfs:domain rdf:resource="https://example.org/lol-ontology#Champion"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:label>baseAttackDamage</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://example.org/lol-ontology#baseHP -->

    <owl:DatatypeProperty rdf:about="https://example.org/lol-ontology#baseHP">
        <rdfs:domain rdf:resource="https://example.org/lol-ontology#Champion"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:label>baseHP</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://example.org/lol-ontology#baseMP -->

    <owl:DatatypeProperty rdf:about="https://example.org/lol-ontology#baseMP">
        <rdfs:domain rdf:resource="https://example.org/lol-ontology#Champion"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:label>baseMP</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://example.org/lol-ontology#baseMoveSpeed -->

    <owl:DatatypeProperty rdf:about="https://example.org/lol-ontology#baseMoveSpeed">
        <rdfs:domain rdf:resource="https://example.org/lol-ontology#Champion"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:label>baseMoveSpeed</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://example.org/lol-ontology#conditionText -->

    <owl:DatatypeProperty rdf:about="https://example.org/lol-ontology#conditionText">
        <rdfs:domain rdf:resource="https://example.org/lol-ontology#AbilityEffect"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>conditionText</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://example.org/lol-ontology#description -->

    <owl:DatatypeProperty rdf:about="https://example.org/lol-ontology#description">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>description</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://example.org/lol-ontology#entityId -->

    <owl:DatatypeProperty rdf:about="https://example.org/lol-ontology#entityId">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>entityId</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://example.org/lol-ontology#evidenceField -->

    <owl:DatatypeProperty rdf:about="https://example.org/lol-ontology#evidenceField">
        <rdfs:domain rdf:resource="https://example.org/lol-ontology#AbilityEffect"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>evidenceField</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://example.org/lol-ontology#evidenceText -->

    <owl:DatatypeProperty rdf:about="https://example.org/lol-ontology#evidenceText">
        <rdfs:domain rdf:resource="https://example.org/lol-ontology#AbilityEffect"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>evidenceText</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://example.org/lol-ontology#gameVersion -->

    <owl:DatatypeProperty rdf:about="https://example.org/lol-ontology#gameVersion">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>gameVersion</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://example.org/lol-ontology#name -->

    <owl:DatatypeProperty rdf:about="https://example.org/lol-ontology#name">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://example.org/lol-ontology#resourceType -->

    <owl:DatatypeProperty rdf:about="https://example.org/lol-ontology#resourceType">
        <rdfs:domain rdf:resource="https://example.org/lol-ontology#Champion"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>resourceType</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://example.org/lol-ontology#reviewStatus -->

    <owl:DatatypeProperty rdf:about="https://example.org/lol-ontology#reviewStatus">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>reviewStatus</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://example.org/lol-ontology#slot -->

    <owl:DatatypeProperty rdf:about="https://example.org/lol-ontology#slot">
        <rdfs:domain rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>slot</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://example.org/lol-ontology#sourceURL -->

    <owl:DatatypeProperty rdf:about="https://example.org/lol-ontology#sourceURL">
        <rdfs:domain rdf:resource="https://example.org/lol-ontology#SourceDocument"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:label>sourceURL</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://example.org/lol-ontology#title -->

    <owl:DatatypeProperty rdf:about="https://example.org/lol-ontology#title">
        <rdfs:domain rdf:resource="https://example.org/lol-ontology#Champion"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>title</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://example.org/lol-ontology#tooltipText -->

    <owl:DatatypeProperty rdf:about="https://example.org/lol-ontology#tooltipText">
        <rdfs:domain rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>tooltipText</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://example.org/lol-ontology#Ability -->

    <owl:Class rdf:about="https://example.org/lol-ontology#Ability">
        <rdfs:comment xml:lang="ru">Основное умение P/Q/W/E/R.</rdfs:comment>
        <rdfs:label>Ability</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/lol-ontology#AbilityEffect -->

    <owl:Class rdf:about="https://example.org/lol-ontology#AbilityEffect">
        <rdfs:comment xml:lang="ru">Один эффект умения с собственной целью и условием.</rdfs:comment>
        <rdfs:label>AbilityEffect</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/lol-ontology#ActiveAbility -->

    <owl:Class rdf:about="https://example.org/lol-ontology#ActiveAbility">
        <rdfs:subClassOf rdf:resource="https://example.org/lol-ontology#Ability"/>
        <owl:disjointWith rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
        <rdfs:comment xml:lang="ru">Активное умение, слот Q/W/E/R.</rdfs:comment>
        <rdfs:label>ActiveAbility</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/lol-ontology#AllyShieldChampion -->

    <owl:Class rdf:about="https://example.org/lol-ontology#AllyShieldChampion">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://example.org/lol-ontology#Champion"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://example.org/lol-ontology#hasAbility"/>
                        <owl:someValuesFrom>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="https://example.org/lol-ontology#hasEffect"/>
                                <owl:someValuesFrom>
                                    <owl:Class>
                                        <owl:intersectionOf rdf:parseType="Collection">
                                            <rdf:Description rdf:about="https://example.org/lol-ontology#AbilityEffect"/>
                                            <owl:Restriction>
                                                <owl:onProperty rdf:resource="https://example.org/lol-ontology#hasMechanic"/>
                                                <owl:hasValue rdf:resource="https://example.org/lol-ontology#Shield"/>
                                            </owl:Restriction>
                                            <owl:Restriction>
                                                <owl:onProperty rdf:resource="https://example.org/lol-ontology#hasTargetType"/>
                                                <owl:hasValue rdf:resource="https://example.org/lol-ontology#Ally"/>
                                            </owl:Restriction>
                                        </owl:intersectionOf>
                                    </owl:Class>
                                </owl:someValuesFrom>
                            </owl:Restriction>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://example.org/lol-ontology#Champion"/>
        <rdfs:comment xml:lang="ru">Чемпион с хотя бы одним эффектом щита для союзников.</rdfs:comment>
        <rdfs:label>AllyShieldChampion</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/lol-ontology#Champion -->

    <owl:Class rdf:about="https://example.org/lol-ontology#Champion">
        <rdfs:comment xml:lang="ru">Игровой чемпион.</rdfs:comment>
        <rdfs:label>Champion</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/lol-ontology#ChampionCategory -->

    <owl:Class rdf:about="https://example.org/lol-ontology#ChampionCategory">
        <rdfs:comment xml:lang="ru">Категория Data Dragon (Mage, Support и т. п.), не позиция на карте.</rdfs:comment>
        <rdfs:label>ChampionCategory</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/lol-ontology#EnemyMovementControlChampion -->

    <owl:Class rdf:about="https://example.org/lol-ontology#EnemyMovementControlChampion">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://example.org/lol-ontology#Champion"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://example.org/lol-ontology#hasAbility"/>
                        <owl:someValuesFrom>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="https://example.org/lol-ontology#hasEffect"/>
                                <owl:someValuesFrom>
                                    <owl:Class>
                                        <owl:intersectionOf rdf:parseType="Collection">
                                            <rdf:Description rdf:about="https://example.org/lol-ontology#AbilityEffect"/>
                                            <owl:Restriction>
                                                <owl:onProperty rdf:resource="https://example.org/lol-ontology#hasMechanic"/>
                                                <owl:someValuesFrom rdf:resource="https://example.org/lol-ontology#MovementControlMechanic"/>
                                            </owl:Restriction>
                                            <owl:Restriction>
                                                <owl:onProperty rdf:resource="https://example.org/lol-ontology#hasTargetType"/>
                                                <owl:hasValue rdf:resource="https://example.org/lol-ontology#Enemy"/>
                                            </owl:Restriction>
                                        </owl:intersectionOf>
                                    </owl:Class>
                                </owl:someValuesFrom>
                            </owl:Restriction>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://example.org/lol-ontology#Champion"/>
        <rdfs:comment xml:lang="ru">Чемпион с хотя бы одним эффектом ограничения передвижения врага.</rdfs:comment>
        <rdfs:label>EnemyMovementControlChampion</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/lol-ontology#MageChampion -->

    <owl:Class rdf:about="https://example.org/lol-ontology#MageChampion">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://example.org/lol-ontology#Champion"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://example.org/lol-ontology#hasCategory"/>
                        <owl:hasValue rdf:resource="https://example.org/lol-ontology#Category_Mage"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://example.org/lol-ontology#Champion"/>
        <rdfs:comment xml:lang="ru">Чемпион с категорией Mage; классифицируется ризонером.</rdfs:comment>
        <rdfs:label>MageChampion</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/lol-ontology#Mechanic -->

    <owl:Class rdf:about="https://example.org/lol-ontology#Mechanic">
        <rdfs:comment xml:lang="ru">Тип механики: щит, урон, обездвиживание и т. п.</rdfs:comment>
        <rdfs:label>Mechanic</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/lol-ontology#MovementControlMechanic -->

    <owl:Class rdf:about="https://example.org/lol-ontology#MovementControlMechanic">
        <rdfs:subClassOf rdf:resource="https://example.org/lol-ontology#Mechanic"/>
        <rdfs:comment xml:lang="ru">Механика ограничения передвижения: Root, Slow или Stun.</rdfs:comment>
        <rdfs:label>MovementControlMechanic</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/lol-ontology#PassiveAbility -->

    <owl:Class rdf:about="https://example.org/lol-ontology#PassiveAbility">
        <rdfs:subClassOf rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdfs:comment xml:lang="ru">Пассивное умение, слот P.</rdfs:comment>
        <rdfs:label>PassiveAbility</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/lol-ontology#SourceDocument -->

    <owl:Class rdf:about="https://example.org/lol-ontology#SourceDocument">
        <rdfs:comment xml:lang="ru">Документ, подтверждающий данные.</rdfs:comment>
        <rdfs:label>SourceDocument</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/lol-ontology#SupportControlMage -->

    <owl:Class rdf:about="https://example.org/lol-ontology#SupportControlMage">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://example.org/lol-ontology#AllyShieldChampion"/>
                    <rdf:Description rdf:about="https://example.org/lol-ontology#EnemyMovementControlChampion"/>
                    <rdf:Description rdf:about="https://example.org/lol-ontology#MageChampion"/>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://example.org/lol-ontology#Champion"/>
        <rdfs:comment xml:lang="ru">Маг, способный дать союзнику щит и ограничить передвижение врага. Умения могут быть разными.</rdfs:comment>
        <rdfs:label>SupportControlMage</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/lol-ontology#TargetType -->

    <owl:Class rdf:about="https://example.org/lol-ontology#TargetType">
        <rdfs:comment xml:lang="ru">Тип получателя конкретного эффекта, не конкретный участник матча.</rdfs:comment>
        <rdfs:label>TargetType</rdfs:label>
    </owl:Class>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Individuals
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://example.org/lol-ontology#Ally -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Ally">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#TargetType"/>
        <lol-ontology:name>Союзник</lol-ontology:name>
        <rdfs:label>Ally</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Category_Mage -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Category_Mage">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ChampionCategory"/>
        <owl:differentFrom rdf:resource="https://example.org/lol-ontology#Category_Support"/>
        <lol-ontology:name>Mage</lol-ontology:name>
        <rdfs:label>Category_Mage</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Category_Support -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Category_Support">
