    <!-- https://example.org/lol-ontology#Morgana_R -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Morgana_R">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#Ability"/>
        <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
        <lol-ontology:hasEffect rdf:resource="https://example.org/lol-ontology#Morgana_R_Damage_Enemy"/>
        <lol-ontology:hasEffect rdf:resource="https://example.org/lol-ontology#Morgana_R_MovementSpeedBoost_Self"/>
        <lol-ontology:hasEffect rdf:resource="https://example.org/lol-ontology#Morgana_R_Slow_Enemy"/>
        <lol-ontology:hasEffect rdf:resource="https://example.org/lol-ontology#Morgana_R_Stun_Enemy"/>
        <lol-ontology:hasSource rdf:resource="https://example.org/lol-ontology#Source_Morgana"/>
        <lol-ontology:isAbilityOf rdf:resource="https://example.org/lol-ontology#Morgana"/>
        <lol-ontology:description>Моргана высвобождает всю свою небесную мощь, расправляя крылья и взмывая над землей. Она выпускает цепи темной агонии во вражеских чемпионов поблизости и увеличивает свою скорость передвижения. Ее цепи замедляют и наносят начальный урон, а после задержки оглушают тех, кто не смог их разорвать.</lol-ontology:description>
        <lol-ontology:entityId>Morgana:R</lol-ontology:entityId>
        <lol-ontology:gameVersion>16.20.1</lol-ontology:gameVersion>
        <lol-ontology:name>Оковы души</lol-ontology:name>
        <lol-ontology:slot>R</lol-ontology:slot>
        <lol-ontology:tooltipText>Моргана приковывает себя цепями к окружающим вражеским чемпионам, нанося {{ totaldamage }} магического урона и замедляя их на {{ slowpercent }}%. Через {{ chainduration }} сек. враги, которые не смогли разорвать цепи, дополнительно получают {{ totaldamage }} магического урона и оглушаются на {{ stunduration }} сек. При применении этого умения Моргана увеличивает свою скорость передвижения на {{ hastepercent }}% .{{ spellmodifierdescriptionappend }}</lol-ontology:tooltipText>
        <rdfs:label>Morgana_R</rdfs:label>
    </owl:Thing>
    


    <!-- https://example.org/lol-ontology#Morgana_R_Damage_Enemy -->

    <owl:Thing rdf:about="https://example.org/lol-ontology#Morgana_R_Damage_Enemy">
