@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix lol-ontology: <https://example.org/lol-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dcterms:description a owl:AnnotationProperty .

dcterms:title a owl:AnnotationProperty .

lol-ontology:baseArmor a owl:DatatypeProperty ;
    rdfs:label "baseArmor" ;
    rdfs:domain lol-ontology:Champion ;
    rdfs:range xsd:decimal .

lol-ontology:baseAttackDamage a owl:DatatypeProperty ;
    rdfs:label "baseAttackDamage" ;
    rdfs:domain lol-ontology:Champion ;
    rdfs:range xsd:decimal .

lol-ontology:baseHP a owl:DatatypeProperty ;
    rdfs:label "baseHP" ;
    rdfs:domain lol-ontology:Champion ;
    rdfs:range xsd:decimal .

lol-ontology:baseMP a owl:DatatypeProperty ;
    rdfs:label "baseMP" ;
    rdfs:domain lol-ontology:Champion ;
    rdfs:range xsd:decimal .

lol-ontology:baseMoveSpeed a owl:DatatypeProperty ;
    rdfs:label "baseMoveSpeed" ;
    rdfs:domain lol-ontology:Champion ;
    rdfs:range xsd:decimal .

lol-ontology:canApplyMechanic a owl:ObjectProperty ;
    rdfs:label "canApplyMechanic" ;
    rdfs:comment "Выводится цепочкой hasAbility / hasEffect / hasMechanic; не хранит условия."@ru ;
    rdfs:domain lol-ontology:Champion ;
    rdfs:range lol-ontology:Mechanic ;
    owl:propertyChainAxiom ( lol-ontology:hasAbility lol-ontology:hasEffect lol-ontology:hasMechanic ) .

lol-ontology:conditionText a owl:DatatypeProperty ;
    rdfs:label "conditionText" ;
    rdfs:domain lol-ontology:AbilityEffect ;
    rdfs:range xsd:string .

lol-ontology:description a owl:DatatypeProperty ;
    rdfs:label "description" ;
    rdfs:range xsd:string .

lol-ontology:effectOf a owl:ObjectProperty ;
    rdfs:label "effectOf" ;
    rdfs:comment "Эффект относится к умению; обратное hasEffect."@ru ;
    rdfs:domain lol-ontology:AbilityEffect ;
    rdfs:range lol-ontology:Ability ;
    owl:inverseOf lol-ontology:hasEffect .

lol-ontology:entityId a owl:DatatypeProperty ;
    rdfs:label "entityId" ;
    rdfs:range xsd:string .

lol-ontology:evidenceField a owl:DatatypeProperty ;
    rdfs:label "evidenceField" ;
    rdfs:domain lol-ontology:AbilityEffect ;
    rdfs:range xsd:string .

lol-ontology:evidenceText a owl:DatatypeProperty ;
    rdfs:label "evidenceText" ;
    rdfs:domain lol-ontology:AbilityEffect ;
    rdfs:range xsd:string .

lol-ontology:gameVersion a owl:DatatypeProperty ;
    rdfs:label "gameVersion" ;
    rdfs:range xsd:string .

lol-ontology:hasSource a owl:ObjectProperty ;
    rdfs:label "hasSource" ;
    rdfs:comment "Источник сведений об объекте."@ru ;
    rdfs:range lol-ontology:SourceDocument .

lol-ontology:name a owl:DatatypeProperty ;
    rdfs:label "name" ;
    rdfs:range xsd:string .

lol-ontology:resourceType a owl:DatatypeProperty ;
    rdfs:label "resourceType" ;
    rdfs:domain lol-ontology:Champion ;
    rdfs:range xsd:string .

lol-ontology:reviewStatus a owl:DatatypeProperty ;
    rdfs:label "reviewStatus" ;
    rdfs:range xsd:string .

lol-ontology:slot a owl:DatatypeProperty ;
    rdfs:label "slot" ;
    rdfs:domain lol-ontology:Ability ;
    rdfs:range xsd:string .

lol-ontology:sourceURL a owl:DatatypeProperty ;
    rdfs:label "sourceURL" ;
    rdfs:domain lol-ontology:SourceDocument ;
    rdfs:range xsd:anyURI .

lol-ontology:title a owl:DatatypeProperty ;
    rdfs:label "title" ;
    rdfs:domain lol-ontology:Champion ;
    rdfs:range xsd:string .

lol-ontology:tooltipText a owl:DatatypeProperty ;
    rdfs:label "tooltipText" ;
    rdfs:domain lol-ontology:Ability ;
    rdfs:range xsd:string .

<https://example.org/lol-ontology/inferred/demo> a owl:Ontology .

lol-ontology:Karma_E_MovementSpeedBoost_Ally a owl:NamedIndividual,
        owl:Thing,
        lol-ontology:AbilityEffect ;
    rdfs:label "Karma_E_MovementSpeedBoost_Ally" ;
    lol-ontology:conditionText "Союзник получает Воодушевление; усиление Мантрой распространяет эффект на ближайших союзников." ;
    lol-ontology:effectOf lol-ontology:Karma_E ;
    lol-ontology:evidenceField "description_text" ;
    lol-ontology:evidenceText "Карма защищает союзника щитом, поглощающим урон и увеличивающим его скорость передвижения. Эффект Мантры: щит излучает энергию, которая увеличивает его прочность и накладывает Воодушевление на ближайших союзных чемпионов." ;
    lol-ontology:gameVersion "16.20.1" ;
    lol-ontology:hasMechanic lol-ontology:MovementSpeedBoost ;
    lol-ontology:hasSource lol-ontology:Source_Karma ;
    lol-ontology:hasTargetType lol-ontology:Ally ;
    lol-ontology:reviewStatus "reviewed_by_assistant" .

lol-ontology:Karma_E_Shield_Ally a owl:NamedIndividual,
        owl:Thing,
        lol-ontology:AbilityEffect ;
    rdfs:label "Karma_E_Shield_Ally" ;
    lol-ontology:conditionText "Выбранный союзник; при усилении Мантрой эффект распространяется на ближайших союзных чемпионов." ;
    lol-ontology:effectOf lol-ontology:Karma_E ;
    lol-ontology:evidenceField "description_text" ;
    lol-ontology:evidenceText "Карма защищает союзника щитом, поглощающим урон и увеличивающим его скорость передвижения. Эффект Мантры: щит излучает энергию, которая увеличивает его прочность и накладывает Воодушевление на ближайших союзных чемпионов." ;
    lol-ontology:gameVersion "16.20.1" ;
    lol-ontology:hasMechanic lol-ontology:Shield ;
    lol-ontology:hasSource lol-ontology:Source_Karma ;
    lol-ontology:hasTargetType lol-ontology:Ally ;
    lol-ontology:reviewStatus "reviewed_by_assistant" .

lol-ontology:Karma_P_CooldownReduction_OwnAbility a owl:NamedIndividual,
        owl:Thing,
        lol-ontology:AbilityEffect ;
    rdfs:label "Karma_P_CooldownReduction_OwnAbility" ;
    lol-ontology:conditionText "При нанесении урона умениями; сокращается перезарядка Мантры." ;
    lol-ontology:effectOf lol-ontology:Karma_P ;
    lol-ontology:evidenceField "description_text" ;
    lol-ontology:evidenceText "Умения Кармы, наносящие урон, сокращают перезарядку Мантры." ;
    lol-ontology:gameVersion "16.20.1" ;
    lol-ontology:hasMechanic lol-ontology:CooldownReduction ;
    lol-ontology:hasSource lol-ontology:Source_Karma ;
    lol-ontology:hasTargetType lol-ontology:OwnAbility ;
    lol-ontology:reviewStatus "reviewed_by_assistant" .

lol-ontology:Karma_Q_Damage_Enemy a owl:NamedIndividual,
        owl:Thing,
        lol-ontology:AbilityEffect ;
    rdfs:label "Karma_Q_Damage_Enemy" ;
    lol-ontology:conditionText "Попадание сгустком энергии; урон получает первая цель и окружающие враги." ;
    lol-ontology:effectOf lol-ontology:Karma_Q ;
    lol-ontology:evidenceField "tooltip_text" ;
    lol-ontology:evidenceText "Карма выпускает сгусток энергии, нанося {{ totaldamage }} магического урона первой пораженной цели и окружающим врагам, а также замедляя их на {{ slowamount*-100 }}% на {{ slowduration }} сек.{{ spellmodifierdescriptionappend }}" ;
    lol-ontology:gameVersion "16.20.1" ;
    lol-ontology:hasMechanic lol-ontology:Damage ;
    lol-ontology:hasSource lol-ontology:Source_Karma ;
    lol-ontology:hasTargetType lol-ontology:Enemy ;
    lol-ontology:reviewStatus "reviewed_by_assistant" .

lol-ontology:Karma_Q_Slow_Enemy a owl:NamedIndividual,
        owl:Thing,
        lol-ontology:AbilityEffect ;
    rdfs:label "Karma_Q_Slow_Enemy" ;
    lol-ontology:conditionText "Попадание сгустком энергии; замедление целей, указанных в tooltip." ;
    lol-ontology:effectOf lol-ontology:Karma_Q ;
    lol-ontology:evidenceField "tooltip_text" ;
    lol-ontology:evidenceText "Карма выпускает сгусток энергии, нанося {{ totaldamage }} магического урона первой пораженной цели и окружающим врагам, а также замедляя их на {{ slowamount*-100 }}% на {{ slowduration }} сек.{{ spellmodifierdescriptionappend }}" ;
    lol-ontology:gameVersion "16.20.1" ;
    lol-ontology:hasMechanic lol-ontology:Slow ;
    lol-ontology:hasSource lol-ontology:Source_Karma ;
    lol-ontology:hasTargetType lol-ontology:Enemy ;
