lol-ontology:Karma_R a owl:NamedIndividual,
        owl:Thing,
        lol-ontology:Ability,
        lol-ontology:ActiveAbility ;
    rdfs:label "Karma_R" ;
    lol-ontology:description "Карма усиливает свое следующее умение дополнительным эффектом. Мантра доступна на 1-м уровне и не требует очка умений." ;
    lol-ontology:entityId "Karma:R" ;
    lol-ontology:gameVersion "16.20.1" ;
    lol-ontology:hasEffect lol-ontology:Karma_R_Empower_OwnAbility ;
    lol-ontology:hasSource lol-ontology:Source_Karma ;
    lol-ontology:isAbilityOf lol-ontology:Karma ;
    lol-ontology:name "Мантра" ;
    lol-ontology:slot "R" ;
    lol-ontology:tooltipText "Карма усиливает свое следующее умение, примененное в течение 8 сек. Внутреннее пламя : дополнительно наносит {{ rqimpactdamage }} магического урона и оставляет круг пламени, который замедляет врагов и наносит еще {{ rqfielddamage }} магического урона . Решимость : Карма восстанавливает {{ rwhealamount }} от недостающего здоровья во время образования и разрыва связи, а продолжительность обездвиживания увеличивается на {{ rwbonusroot }} сек. Воодушевление : прочность щита , накладываемого на цель, увеличивается на {{ rebonusshield }} . Кроме того, Карма накладывает на окружающих чемпионов щит прочностью {{ rebonusshieldarea }} и увеличивает их скорость передвижения на {{ removespeed*100 }}% .{{ spellmodifierdescriptionappend }}" .

lol-ontology:Lux_P a owl:NamedIndividual,
        owl:Thing,
        lol-ontology:Ability,
        lol-ontology:PassiveAbility ;
    rdfs:label "Lux_P" ;
    lol-ontology:description "Используя атакующие умения, Люкс накладывает на врагов эффект Иллюминации на несколько секунд. Ее последующие автоатаки поджигают находящихся под действием эффекта врагов, нанося им дополнительный магический урон (тем больший, чем выше уровень Люкс), но снимают эффект." ;
    lol-ontology:entityId "Lux:P" ;
    lol-ontology:gameVersion "16.20.1" ;
    lol-ontology:hasEffect lol-ontology:Lux_P_Damage_Enemy ;
    lol-ontology:hasSource lol-ontology:Source_Lux ;
    lol-ontology:isAbilityOf lol-ontology:Lux ;
    lol-ontology:name "Иллюминация" ;
    lol-ontology:slot "P" .

lol-ontology:Lux_R a owl:NamedIndividual,
        owl:Thing,
        lol-ontology:Ability,
        lol-ontology:ActiveAbility ;
    rdfs:label "Lux_R" ;
    lol-ontology:description "Люкс накапливает энергию и выпускает мощный луч света, наносящий урон всем врагам на своем пути. Кроме того, луч поджигает врагов, на которых наложен эффект Иллюминации, после чего этот эффект обновляется." ;
    lol-ontology:entityId "Lux:R" ;
