lol-ontology:Lux_E_Damage_Enemy a owl:NamedIndividual,
        owl:Thing,
        lol-ontology:AbilityEffect ;
    rdfs:label "Lux_E_Damage_Enemy" ;
    lol-ontology:conditionText "Враг находится в зоне поражения при взрыве; взрыв по таймеру или повторному применению." ;
    lol-ontology:effectOf lol-ontology:Lux_E ;
    lol-ontology:evidenceField "tooltip_text" ;
    lol-ontology:evidenceText "Люкс создает световую аномалию, замедляющую на {{ slowpercent }}% и раскрывающую область под собой. Через {{ slowzoneduration }} сек. или при повт. применении этого умения аномалия взрывается, нанося {{ totaldamagett }} ед. маг. урона и замедляя еще на {{ slowlingerduration }} сек.{{ spellmodifierdescriptionappend }}" ;
    lol-ontology:gameVersion "16.20.1" ;
    lol-ontology:hasMechanic lol-ontology:Damage ;
    lol-ontology:hasSource lol-ontology:Source_Lux ;
    lol-ontology:hasTargetType lol-ontology:Enemy ;
    lol-ontology:reviewStatus "reviewed_by_assistant" .

