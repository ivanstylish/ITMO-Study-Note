                        owl:someValuesFrom [ a owl:Restriction ;
                                owl:onProperty lol-ontology:hasEffect ;
                                owl:someValuesFrom [ a owl:Class ;
                                        owl:intersectionOf ( lol-ontology:AbilityEffect [ a owl:Restriction ;
                                                    owl:onProperty lol-ontology:hasMechanic ;
                                                    owl:someValuesFrom lol-ontology:MovementControlMechanic ] [ a owl:Restriction ;
                                                    owl:hasValue lol-ontology:Enemy ;
                                                    owl:onProperty lol-ontology:hasTargetType ] ) ] ] ] ) ] .

lol-ontology:MageChampion a owl:Class ;
