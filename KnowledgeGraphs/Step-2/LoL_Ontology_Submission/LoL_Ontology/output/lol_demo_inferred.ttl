lol-ontology:Morgana_R a owl:NamedIndividual,
        owl:Thing,
        lol-ontology:Ability,
        lol-ontology:ActiveAbility ;
    rdfs:label "Morgana_R" ;
    lol-ontology:description "Моргана высвобождает всю свою небесную мощь, расправляя крылья и взмывая над землей. Она выпускает цепи темной агонии во вражеских чемпионов поблизости и увеличивает свою скорость передвижения. Ее цепи замедляют и наносят начальный урон, а после задержки оглушают тех, кто не смог их разорвать." ;
    lol-ontology:entityId "Morgana:R" ;
    lol-ontology:gameVersion "16.20.1" ;
    lol-ontology:hasEffect lol-ontology:Morgana_R_Damage_Enemy,
        lol-ontology:Morgana_R_MovementSpeedBoost_Self,
        lol-ontology:Morgana_R_Slow_Enemy,
        lol-ontology:Morgana_R_Stun_Enemy ;
    lol-ontology:hasSource lol-ontology:Source_Morgana ;
    lol-ontology:isAbilityOf lol-ontology:Morgana ;
    lol-ontology:name "Оковы души" ;
    lol-ontology:slot "R" ;
    lol-ontology:tooltipText "Моргана приковывает себя цепями к окружающим вражеским чемпионам, нанося {{ totaldamage }} магического урона и замедляя их на {{ slowpercent }}%. Через {{ chainduration }} сек. враги, которые не смогли разорвать цепи, дополнительно получают {{ totaldamage }} магического урона и оглушаются на {{ stunduration }} сек. При применении этого умения Моргана увеличивает свою скорость передвижения на {{ hastepercent }}% .{{ spellmodifierdescriptionappend }}" .

