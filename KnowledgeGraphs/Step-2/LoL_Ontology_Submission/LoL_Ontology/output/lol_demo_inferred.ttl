lol-ontology:SupportControlMage a owl:Class ;
    rdfs:label "SupportControlMage" ;
    rdfs:comment "Маг, способный дать союзнику щит и ограничить передвижение врага. Умения могут быть разными."@ru ;
    rdfs:subClassOf lol-ontology:Champion ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( lol-ontology:AllyShieldChampion lol-ontology:EnemyMovementControlChampion lol-ontology:MageChampion ) ] .

lol-ontology:hasAbility a owl:ObjectProperty ;
    rdfs:label "hasAbility" ;
    rdfs:comment "У чемпиона есть умение."@ru ;
    rdfs:domain lol-ontology:Champion ;
    rdfs:range lol-ontology:Ability ;
    owl:inverseOf lol-ontology:isAbilityOf .

lol-ontology:hasMechanic a owl:ObjectProperty ;
    rdfs:label "hasMechanic" ;
    rdfs:comment "Механика конкретного эффекта."@ru ;
    rdfs:domain lol-ontology:AbilityEffect ;
    rdfs:range lol-ontology:Mechanic .

lol-ontology:AllyShieldChampion a owl:Class ;
    rdfs:label "AllyShieldChampion" ;
    rdfs:comment "Чемпион с хотя бы одним эффектом щита для союзников."@ru ;
    rdfs:subClassOf lol-ontology:Champion ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( lol-ontology:Champion [ a owl:Restriction ;
                        owl:onProperty lol-ontology:hasAbility ;
                        owl:someValuesFrom [ a owl:Restriction ;
                                owl:onProperty lol-ontology:hasEffect ;
                                owl:someValuesFrom [ a owl:Class ;
                                        owl:intersectionOf ( lol-ontology:AbilityEffect [ a owl:Restriction ;
                                                    owl:hasValue lol-ontology:Shield ;
                                                    owl:onProperty lol-ontology:hasMechanic ] [ a owl:Restriction ;
                                                    owl:hasValue lol-ontology:Ally ;
                                                    owl:onProperty lol-ontology:hasTargetType ] ) ] ] ] ) ] .

