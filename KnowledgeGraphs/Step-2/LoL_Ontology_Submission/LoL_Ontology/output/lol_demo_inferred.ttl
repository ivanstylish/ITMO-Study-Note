lol-ontology:Lux_R_Damage_Enemy a owl:NamedIndividual,
        owl:Thing,
        lol-ontology:AbilityEffect ;
    rdfs:label "Lux_R_Damage_Enemy" ;
    lol-ontology:conditionText "Враг находится на пути луча; дополнительные взаимодействия с Иллюминацией описаны в исходном тексте." ;
    lol-ontology:effectOf lol-ontology:Lux_R ;
    lol-ontology:evidenceField "description_text" ;
    lol-ontology:evidenceText "Люкс накапливает энергию и выпускает мощный луч света, наносящий урон всем врагам на своем пути. Кроме того, луч поджигает врагов, на которых наложен эффект Иллюминации, после чего этот эффект обновляется." ;
    lol-ontology:gameVersion "16.20.1" ;
    lol-ontology:hasMechanic lol-ontology:Damage ;
    lol-ontology:hasSource lol-ontology:Source_Lux ;
