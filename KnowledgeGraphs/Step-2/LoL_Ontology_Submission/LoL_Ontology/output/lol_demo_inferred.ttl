lol-ontology:Karma_Q a owl:NamedIndividual,
        owl:Thing,
        lol-ontology:Ability,
        lol-ontology:ActiveAbility ;
    rdfs:label "Karma_Q" ;
    lol-ontology:description "Карма выпускает заряд духовной энергии, который взрывается при столкновении с противником, нанося урон. Эффект Мантры: Карма дополнительно увеличивает разрушительную силу Внутреннего пламени, создавая на земле энергетическую аномалию, наносящую урон по прошествии некоторого времени." ;
    lol-ontology:entityId "Karma:Q" ;
    lol-ontology:gameVersion "16.20.1" ;
    lol-ontology:hasEffect lol-ontology:Karma_Q_Damage_Enemy,
        lol-ontology:Karma_Q_Slow_Enemy ;
    lol-ontology:hasSource lol-ontology:Source_Karma ;
    lol-ontology:isAbilityOf lol-ontology:Karma ;
    lol-ontology:name "Внутреннее пламя" ;
    lol-ontology:slot "Q" ;
    lol-ontology:tooltipText "Карма выпускает сгусток энергии, нанося {{ totaldamage }} магического урона первой пораженной цели и окружающим врагам, а также замедляя их на {{ slowamount*-100 }}% на {{ slowduration }} сек.{{ spellmodifierdescriptionappend }}" .

lol-ontology:Lux_E a owl:NamedIndividual,
        owl:Thing,
        lol-ontology:Ability,
        lol-ontology:ActiveAbility ;
    rdfs:label "Lux_E" ;
    lol-ontology:description "Люкс создает в указанной области световую аномалию, замедляющую противников. Люкс может взорвать ее, нанеся урон всем находящимся в зоне поражения врагам." ;
    lol-ontology:entityId "Lux:E" ;
    lol-ontology:gameVersion "16.20.1" ;
    lol-ontology:hasEffect lol-ontology:Lux_E_Damage_Enemy,
        lol-ontology:Lux_E_Slow_Enemy ;
    lol-ontology:hasSource lol-ontology:Source_Lux ;
    lol-ontology:isAbilityOf lol-ontology:Lux ;
    lol-ontology:name "Светящаяся сингулярность" ;
    lol-ontology:slot "E" ;
    lol-ontology:tooltipText "Люкс создает световую аномалию, замедляющую на {{ slowpercent }}% и раскрывающую область под собой. Через {{ slowzoneduration }} сек. или при повт. применении этого умения аномалия взрывается, нанося {{ totaldamagett }} ед. маг. урона и замедляя еще на {{ slowlingerduration }} сек.{{ spellmodifierdescriptionappend }}" .

lol-ontology:Lux_Q a owl:NamedIndividual,
        owl:Thing,
        lol-ontology:Ability,
        lol-ontology:ActiveAbility ;
    rdfs:label "Lux_Q" ;
    lol-ontology:description "Люкс выпускает сферу света, которая наносит урон и обездвиживает до двух врагов." ;
    lol-ontology:entityId "Lux:Q" ;
    lol-ontology:gameVersion "16.20.1" ;
    lol-ontology:hasEffect lol-ontology:Lux_Q_Damage_Enemy,
        lol-ontology:Lux_Q_Root_Enemy ;
    lol-ontology:hasSource lol-ontology:Source_Lux ;
    lol-ontology:isAbilityOf lol-ontology:Lux ;
    lol-ontology:name "Сковывание света" ;
    lol-ontology:slot "Q" ;
    lol-ontology:tooltipText "Люкс выпускает сферу света, обездвиживающую первых 2 врагов на пути на {{ rootduration }} сек. и наносящую им по {{ totaldamagett }} ед. маг. урона .{{ spellmodifierdescriptionappend }}" .

lol-ontology:Morgana_E a owl:NamedIndividual,
        owl:Thing,
        lol-ontology:Ability,
        lol-ontology:ActiveAbility ;
    rdfs:label "Morgana_E" ;
    lol-ontology:description "Моргана защищает союзника защитным барьером из звездного огня, который поглощает магический урон и эффекты контроля, пока не будет уничтожен." ;
    lol-ontology:entityId "Morgana:E" ;
    lol-ontology:gameVersion "16.20.1" ;
    lol-ontology:hasEffect lol-ontology:Morgana_E_ControlImmunity_Ally,
        lol-ontology:Morgana_E_Shield_Ally ;
    lol-ontology:hasSource lol-ontology:Source_Morgana ;
    lol-ontology:isAbilityOf lol-ontology:Morgana ;
    lol-ontology:name "Черный щит" ;
    lol-ontology:slot "E" ;
    lol-ontology:tooltipText "Моргана накладывает на союзного чемпиона щит от магии прочностью {{ totalshieldstrength }} на {{ shieldduration }} сек. Этот щит блокирует нейтрализующие и обездвиживающие эффекты.{{ spellmodifierdescriptionappend }}" .

lol-ontology:Morgana_Q a owl:NamedIndividual,
        owl:Thing,
        lol-ontology:Ability,
        lol-ontology:ActiveAbility ;
    rdfs:label "Morgana_Q" ;
    lol-ontology:description "Моргана сковывает врага темной магией и наносит магический урон, заставляя почувствовать ту боль, которую он причинил." ;
    lol-ontology:entityId "Morgana:Q" ;
    lol-ontology:gameVersion "16.20.1" ;
    lol-ontology:hasEffect lol-ontology:Morgana_Q_Damage_Enemy,
        lol-ontology:Morgana_Q_Root_Enemy ;
    lol-ontology:hasSource lol-ontology:Source_Morgana ;
    lol-ontology:isAbilityOf lol-ontology:Morgana ;
    lol-ontology:name "Темные узы" ;
    lol-ontology:slot "Q" ;
    lol-ontology:tooltipText "Моргана выпускает заряд звездного огня, который обездвиживает первого пораженного врага на {{ rootduration }} сек. и наносит {{ totaldamage }} магического урона .{{ spellmodifierdescriptionappend }}" .

lol-ontology:Morgana_W a owl:NamedIndividual,
        owl:Thing,
        lol-ontology:Ability,
        lol-ontology:ActiveAbility ;
    rdfs:label "Morgana_W" ;
    lol-ontology:description "Моргана создает проклятую тень в выбранной области, нанося урон всем, кто рискнул ступить в ее темный круг. Враги внутри получают периодический магический урон, размер которого зависит от их уровня здоровья." ;
    lol-ontology:entityId "Morgana:W" ;
    lol-ontology:gameVersion "16.20.1" ;
    lol-ontology:hasEffect lol-ontology:Morgana_W_CooldownReduction_OwnAbility,
        lol-ontology:Morgana_W_Damage_Enemy ;
    lol-ontology:hasSource lol-ontology:Source_Morgana ;
    lol-ontology:isAbilityOf lol-ontology:Morgana ;
    lol-ontology:name "Измученная тень" ;
    lol-ontology:slot "W" ;
    lol-ontology:tooltipText "Моргана поджигает землю на {{ wduration }} сек., нанося {{ totalmindamage }} ед. магического урона в секунду. Урон увеличивается вплоть до {{ totalmaxdamage }} ед. в зависимости от недостающего здоровья целей. Перезарядка этого умения сокращается на {{ cdrefundpercent*100 }}% каждый раз, когда Моргану лечит Вытягивание души .{{ spellmodifierdescriptionappend }}" .

