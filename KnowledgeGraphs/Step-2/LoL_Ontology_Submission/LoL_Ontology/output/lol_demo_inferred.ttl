lol-ontology:Lux_P_Damage_Enemy a owl:NamedIndividual,
        owl:Thing,
        lol-ontology:AbilityEffect ;
    rdfs:label "Lux_P_Damage_Enemy" ;
    lol-ontology:conditionText "Враг отмечен Иллюминацией от атакующего умения; последующая автоатака расходует метку и наносит дополнительный урон." ;
    lol-ontology:effectOf lol-ontology:Lux_P ;
    lol-ontology:evidenceField "description_text" ;
    lol-ontology:evidenceText "Используя атакующие умения, Люкс накладывает на врагов эффект Иллюминации на несколько секунд. Ее последующие автоатаки поджигают находящихся под действием эффекта врагов, нанося им дополнительный магический урон (тем больший, чем выше уровень Люкс), но снимают эффект." ;
    lol-ontology:gameVersion "16.20.1" ;
    lol-ontology:hasMechanic lol-ontology:Damage ;
    lol-ontology:hasSource lol-ontology:Source_Lux ;
    lol-ontology:hasTargetType lol-ontology:Enemy ;
