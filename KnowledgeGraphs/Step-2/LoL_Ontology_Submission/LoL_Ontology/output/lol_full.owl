    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
    <lol:resourceType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Мана</lol:resourceType>
    <lol:baseHP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">630.0</lol:baseHP>
    <lol:baseMP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">480.0</lol:baseMP>
    <lol:baseArmor rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">21.0</lol:baseArmor>
    <lol:baseAttackDamage rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">54.0</lol:baseAttackDamage>
    <lol:baseMoveSpeed rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">330.0</lol:baseMoveSpeed>
    <lol:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Mage"/>
    <lol:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Support"/>
    <lol:reviewStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">effects_not_reviewed</lol:reviewStatus>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Mel_P"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Mel_Q"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Mel_W"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Mel_E"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Mel_R"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Irelia_R">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Irelia_R</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Острие авангарда</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Irelia"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Irelia:R</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ирелия выпускает множество клинков, которые разлетаются в стороны при попадании во вражеского чемпиона. Враги, пораженные клинками, получают урон и помечаются. После этого клинки формируют стену, которая наносит урон прошедшим сквозь нее врагам, а также замедляет их.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ирелия выпускает град из клинков, нанося врагам {{ missiledamage }} магического урона и ослабляя чемпионов и больших лесных монстров на {{ markduration }} сек. При поражении первого чемпиона клинки разлетаются и принимают форму клетки на {{ zoneduration }} сек. Клетка наносит {{ zonedamage }} магического урона и замедляет на {{ slowamount }}% на {{ ccduration }} сек.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Graves_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Graves_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Финита ля комедия</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Graves"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Graves:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Грейвз выпускает разрывной снаряд, который взрывается через 1 секунду или при столкновении с препятствием.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Грейвз выпускает снаряд, который наносит {{ totaldamage }} физического урона . Через 1 сек. или при столкновении с элементом ландшафта снаряд взрывается, нанося {{ totaldetonationdamage }} физического урона там, где он пролетел, и около взрыва.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Sejuani_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Sejuani_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Гнев зимы</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Sejuani"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sejuani:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Седжуани дважды взмахивает своей булавой, нанося урон, замедляя врагов и накладывая заряды Мороза.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Седжуани раскручивает цеп, нанося {{ firsthitdamagetooltip }} физического урона и отбрасывая миньонов и лесных монстров. После этого она запускает цеп вперед, нанося {{ secondhitdamagetooltip }} физического урона и ненадолго замедляя цели. Оба удара накладывают заряды Вечной мерзлоты .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Nilah_E">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Nilah_E</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Нырок</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Nilah"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nilah:E</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">E</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Нила совершает рывок сквозь выбранного бойца, нанося урон всем врагам на пути.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Нила совершает рывок сквозь выбранного бойца, нанося {{ dashdamage }} физического урона всем пораженным врагам.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Lillia_P">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
    <rdfs:label>Lillia_P</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Посох снов</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Lillia"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Lillia:P</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">При попадании умением по чемпиону или монстру Лиллия наносит им дополнительный периодический урон от максимального запаса здоровья.</lol:description>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Kassadin">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#Champion"/>
    <rdfs:label>Kassadin</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Кассадин</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Kassadin"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Kassadin</lol:entityId>
    <lol:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Скиталец Бездны</lol:title>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
    <lol:resourceType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Мана</lol:resourceType>
    <lol:baseHP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">646.0</lol:baseHP>
    <lol:baseMP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">400.0</lol:baseMP>
    <lol:baseArmor rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">21.0</lol:baseArmor>
    <lol:baseAttackDamage rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">59.0</lol:baseAttackDamage>
    <lol:baseMoveSpeed rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">335.0</lol:baseMoveSpeed>
    <lol:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Assassin"/>
    <lol:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Mage"/>
    <lol:reviewStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">effects_not_reviewed</lol:reviewStatus>
