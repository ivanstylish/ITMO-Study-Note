  <rdf:Description rdf:about="https://example.org/lol-ontology#Syndra_E">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Syndra_E</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Изгнание слабых</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Syndra"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Syndra:E</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">E</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Синдра отбрасывает врагов и темные сферы. Враги получают магический урон, а также оглушаются, если в них попадает сфера.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Синдра выпускает волну энергии, отбрасывая врагов и темные сферы , а также нанося {{ totaldamage }} магического урона . Отброшенные темные сферы оглушают врагов на {{ stunduration }} сек. и наносят им {{ totaldamage }} магического урона . Осколки гнева ({{ spell.syndrapassive:eupgradethreshold }}) : ширина области поражения этого умения увеличена, и оно замедляет врагов на {{ upgradedslowamount*100 }}% на {{ upgradedslowduration }} сек.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Heimerdinger_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Heimerdinger_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Хекстек-микроракеты</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Heimerdinger"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Heimerdinger:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Хеймердингер выпускает дальнобойные ракеты, сходящиеся в точке курсора.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Хеймердингер выпускает шквал из {{ rockets }} ракет, нанося {{ damage }} магического урона первому пораженному врагу. Дополнительные ракеты наносят меньше урона. Максимальный урон: {{ totaldamage }} . За каждую ракету, попавшую в чемпиона, уровень заряда турелей поблизости увеличивается на 20%.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#MonkeyKing">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#Champion"/>
    <rdfs:label>MonkeyKing</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Вуконг</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_MonkeyKing"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MonkeyKing</lol:entityId>
    <lol:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Царь обезьян</lol:title>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
    <lol:resourceType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Мана</lol:resourceType>
    <lol:baseHP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">610.0</lol:baseHP>
    <lol:baseMP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">330.0</lol:baseMP>
    <lol:baseArmor rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">31.0</lol:baseArmor>
    <lol:baseAttackDamage rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">66.0</lol:baseAttackDamage>
    <lol:baseMoveSpeed rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">340.0</lol:baseMoveSpeed>
    <lol:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Fighter"/>
    <lol:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Tank"/>
    <lol:reviewStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">effects_not_reviewed</lol:reviewStatus>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#MonkeyKing_P"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#MonkeyKing_Q"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#MonkeyKing_W"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#MonkeyKing_E"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#MonkeyKing_R"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Aurora_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Aurora_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Двойное проклятие</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Aurora"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Aurora:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Аврора выпускает сгусток энергии, который накладывает проклятие на всех пораженных врагов. При повторном применении Аврора снимает проклятия и притягивает энергию к себе, нанося урон всем врагам на пути.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Аврора выпускает сгусток энергии в выбранном направлении, нанося врагам {{ damage }} магического урона и проклиная их на {{ markduration }} сек. Повторное применение: Аврора снимает проклятие и вытягивает из врагов фрагменты души. Противники, сквозь которых пролетают эти фрагменты, получают до {{ q2damagemax }} магического урона в зависимости от своего недостающего здоровья. Враги после первого получают на 20% меньше урона. Если время действия проклятия истекает, Аврора автоматически применяет умение повторно .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Lissandra_P">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
    <rdfs:label>Lissandra_P</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Порабощение Хладорожденной</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Lissandra"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Lissandra:P</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Когда вражеский чемпион погибает рядом с Лиссандрой, он превращается в ледяного раба. Ледяные рабы уменьшают скорость передвижения ближайших врагов, а после задержки взрываются из-за чрезмерного охлаждения, нанося магический урон целям поблизости.</lol:description>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Source_MissFortune">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#SourceDocument"/>
    <rdfs:label>Source_MissFortune</rdfs:label>
    <lol:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://ddragon.leagueoflegends.com/cdn/16.20.1/data/ru_RU/champion/MissFortune.json</lol:sourceURL>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#baseMP">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>baseMP</rdfs:label>
    <rdfs:domain rdf:resource="https://example.org/lol-ontology#Champion"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Milio_R">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Milio_R</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Дыхание жизни</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Milio"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Milio:R</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Милио выпускает волну целительного пламени, которое лечит союзников и снимает с них эффекты контроля.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Милио выпускает волну целительного пламени, которая снимает с ближайших союзных чемпионов нейтрализующие и обездвиживающие эффекты, а также восстанавливает им {{ healcalc }} здоровья и дает {{ tenacityamount*100 }}% стойкости на {{ tenacityduration }} сек.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#MasterYi">
