    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#TwistedFate_E"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#TwistedFate_R"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Jayce_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Jayce_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Электрическое поле / Гиперзаряд</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Jayce"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Jayce:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Стойка с молотом: Джейс восстанавливает себе ману при каждой автоатаке. При активации умения Джейс создает электрическое поле, нанося урон окружающим врагам в течение нескольких секунд. Стойка с пушкой: Джейс заряжает себя энергией, увеличивая скорость атаки до максимума на несколько автоатак.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ртутный молот - пассивно: автоатаки Джейса с помощью молота восстанавливают ему {{ spell.jaycestaticfield:managain }} маны . Ртутный молот - активно: Джейс создает вокруг себя электрическую ауру, которая наносит {{ spell.jaycestaticfield:damage }} магического урона в течение {{ spell.jaycestaticfield:duration }} сек.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Lissandra_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Lissandra_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Кольцо мороза</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Lissandra"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Lissandra:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Лиссандра сковывает льдом окружающих врагов, обездвиживая их и нанося им урон.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Лиссандра создает ледяное поле, обездвиживая врагов поблизости на {{ snareduration }} сек. и нанося им {{ totaldamage }} ед. маг. урона .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Ezreal_E">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Ezreal_E</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Магический сдвиг</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Ezreal"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ezreal:E</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">E</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Эзреаль телепортируется в указанное место неподалеку и делает выстрел, который наносит урон ближайшему противнику. Приоритет отдается целям, пораженным Искажением сущности.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Эзреаль телепортируется и выпускает заряд в ближайшего врага, нанося {{ damage }} магического урона . Заряд ставит в приоритет цели, пораженные Искажением сущности .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Kassadin_P">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
    <rdfs:label>Kassadin_P</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Камень Бездны</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Kassadin"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Kassadin:P</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Кассадин получает меньше магического урона и может проходить сквозь бойцов.</lol:description>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
