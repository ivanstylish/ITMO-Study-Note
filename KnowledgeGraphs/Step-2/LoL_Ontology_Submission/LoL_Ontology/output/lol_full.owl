  <rdf:Description rdf:about="https://example.org/lol-ontology#Akshan_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Akshan_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Опасная игра</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Akshan"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Akshan:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пассивно: когда вражеский чемпион убивает союзника Акшана, он становится негодяем. Если Акшан убивает негодяя, он воскрешает всех убитых им союзников и получает дополнительное золото. При этом остальные негодяи избавляются от этого статуса. Активно: Акшан маскируется, а также увеличивает свои скорость передвижения и восстановление маны при перемещении к негодяям. Акшан быстро теряет маскировку, если находится не в кустах и не около элемента ландшафта.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">{{ Spell_AkshanW_Tooltip_{{ gamemodeinteger }} }}{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Garen_E">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Garen_E</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Вердикт</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Garen"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Garen:E</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">E</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Гарен быстро вращается на месте с мечом в руках, нанося физический урон врагам поблизости.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Гарен быстро вращает меч вокруг себя в течение {{ duration }} сек., нанося окружающим врагам {{ totaldamage }} ед. физического урона {{ f1 }} р. Ближайший враг получает на {{ nearestenemybonus*100 }}% больше урона . Чемпионы, пораженные хотя бы {{ stackstoshred }} ударами, теряют {{ shredamount*100 }}% брони на {{ shredduration }} сек. Повторное применение : действие этого умения прекращается преждевременно.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Senna">
