  <rdf:Description rdf:about="https://example.org/lol-ontology#Soraka_E">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Soraka_E</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Равноденствие</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Soraka"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Soraka:E</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">E</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Сорака создает в указанной области зону молчания. Враги, не успевшие покинуть ее до окончания времени ее действия, дополнительно обездвиживаются.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Сорака создает звездное поле, которое наносит {{ totaldamage }} магического урона чемпионам. Это поле существует {{ rootdelay }} сек. и накладывает безмолвие на врагов внутри. Когда поле исчезает, чемпионы внутри обездвиживаются на {{ rootduration }} сек. и получают {{ totaldamage }} магического урона .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Galio_P">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
    <rdfs:label>Galio_P</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Колоссальный удар</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Galio"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Galio:P</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Каждые несколько секунд следующая автоатака Галио дополнительно наносит магический урон по площади.</lol:description>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
