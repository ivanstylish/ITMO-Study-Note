    <lol:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Своевольный Страж</lol:title>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
    <lol:resourceType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Мана</lol:resourceType>
    <lol:baseHP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">610.0</lol:baseHP>
    <lol:baseMP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">350.0</lol:baseMP>
    <lol:baseArmor rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">26.0</lol:baseArmor>
    <lol:baseAttackDamage rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">52.0</lol:baseAttackDamage>
    <lol:baseMoveSpeed rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">330.0</lol:baseMoveSpeed>
    <lol:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Marksman"/>
    <lol:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Assassin"/>
    <lol:reviewStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">effects_not_reviewed</lol:reviewStatus>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Akshan_P"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Akshan_Q"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Akshan_W"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Akshan_E"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Akshan_R"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Lux_E_Slow_Enemy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#AbilityEffect"/>
    <rdfs:label>Lux_E_Slow_Enemy</rdfs:label>
    <lol:hasMechanic rdf:resource="https://example.org/lol-ontology#Slow"/>
    <lol:hasTargetType rdf:resource="https://example.org/lol-ontology#Enemy"/>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Lux"/>
    <lol:conditionText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Противник находится в области аномалии; tooltip также описывает краткое замедление после взрыва.</lol:conditionText>
    <lol:evidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Люкс создает световую аномалию, замедляющую на {{ slowpercent }}% и раскрывающую область под собой. Через {{ slowzoneduration }} сек. или при повт. применении этого умения аномалия взрывается, нанося {{ totaldamagett }} ед. маг. урона и замедляя еще на {{ slowlingerduration }} сек.{{ spellmodifierdescriptionappend }}</lol:evidenceText>
    <lol:evidenceField rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tooltip_text</lol:evidenceField>
    <lol:reviewStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">reviewed_by_assistant</lol:reviewStatus>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Yorick_P">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
    <rdfs:label>Yorick_P</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пастух душ</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Yorick"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Yorick:P</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Проклятая орда: Йорик может призвать туманных ходоков, которые атакуют ближайших врагов.</lol:description>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Qiyana">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#Champion"/>
    <rdfs:label>Qiyana</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Киана</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Qiyana"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Qiyana</lol:entityId>
    <lol:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Повелительница стихий</lol:title>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
    <lol:resourceType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Мана</lol:resourceType>
    <lol:baseHP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">590.0</lol:baseHP>
    <lol:baseMP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">375.0</lol:baseMP>
    <lol:baseArmor rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">31.0</lol:baseArmor>
    <lol:baseAttackDamage rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">64.0</lol:baseAttackDamage>
    <lol:baseMoveSpeed rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">335.0</lol:baseMoveSpeed>
    <lol:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Assassin"/>
    <lol:reviewStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">effects_not_reviewed</lol:reviewStatus>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Qiyana_P"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Qiyana_Q"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Qiyana_W"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Qiyana_E"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Qiyana_R"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Rakan_R">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Rakan_R</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Стремительность</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Rakan"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Rakan:R</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Скорость передвижения Рэйкана увеличивается, и он очаровывает всех врагов, которых касается, и наносит им магический урон.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Рэйкан получает {{ initialcastspeed }}% скорости передвижения на {{ duration }} сек. Касаясь врагов, Рэйкан наносит им {{ totaldamagetooltip }} ед. маг. урона и очаровывает на {{ charmduration }} сек. при 1-м касании. После 1-го очарованного чемпиона Рэйкан получает {{ touchspeed }}% скорости передвижения (постепенно снижается) .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Lux_P_Damage_Enemy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#AbilityEffect"/>
    <rdfs:label>Lux_P_Damage_Enemy</rdfs:label>
    <lol:hasMechanic rdf:resource="https://example.org/lol-ontology#Damage"/>
    <lol:hasTargetType rdf:resource="https://example.org/lol-ontology#Enemy"/>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Lux"/>
    <lol:conditionText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Враг отмечен Иллюминацией от атакующего умения; последующая автоатака расходует метку и наносит дополнительный урон.</lol:conditionText>
    <lol:evidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Используя атакующие умения, Люкс накладывает на врагов эффект Иллюминации на несколько секунд. Ее последующие автоатаки поджигают находящихся под действием эффекта врагов, нанося им дополнительный магический урон (тем больший, чем выше уровень Люкс), но снимают эффект.</lol:evidenceText>
    <lol:evidenceField rdf:datatype="http://www.w3.org/2001/XMLSchema#string">description_text</lol:evidenceField>
    <lol:reviewStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">reviewed_by_assistant</lol:reviewStatus>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Anivia_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Anivia_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Мгновенная заморозка</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Anivia"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Anivia:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Анивия создает сферу льда, которая летит к противникам, охлаждая и нанося урон каждому, кто попадется на ее пути. Когда сфера взрывается, она наносит урон по площади и оглушает всех в зоне поражения.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Анивия выпускает большую сферу льда, которая наносит {{ totalpassthroughdamage }} магического урона и переохлаждает врагов на {{ slowduration }} сек., замедляя их на {{ spell.glacialstorm:slowamount }}%. Когда сфера пролетает весь путь до конца, она взрывается, оглушая врагов на {{ stunduration }} сек. и нанося им {{ totalexplosiondamage }} магического урона . Анивия может повторно применить это умение, чтобы преждевременно взорвать сферу.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Veigar_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Veigar_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Злобный удар</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Veigar"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Veigar:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Вейгар выпускает заряд темной энергии, который наносит магический урон первым двум пораженным врагам. За каждого убитого врага сила умений Вейгара увеличивается.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Вейгар выпускает заряд темной энергии, нанося {{ totaldamage }} магического урона первым двум врагам на пути. Если Вейгар убивает врага этим умением, он получает {{ spell.veigarpassive:dqkillstacks }} заряд Невероятного зла . Большие миньоны и большие монстры дают {{ spell.veigarpassive:dqkillstackslarge }} заряда.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/title">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Alistar_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Alistar_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Сокрушение</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Alistar"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Alistar:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Алистар бьет по земле, нанося урон окружающим врагам и подбрасывая их в воздух.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Алистар бьет по земле, подбрасывая врагов на {{ knockupduration }} сек., а также нанося им {{ totaldamage }} магического урона .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#AurelionSol_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>AurelionSol_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Дыхание солнца</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_AurelionSol"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AurelionSol:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">В течение нескольких секунд Аурелион Сол дышит огнем, нанося урон первому пораженному врагу, а также меньшее количество урона другим противникам поблизости. Каждый раз, когда цель поражается огнем 1 секунду суммарно, она получает дополнительный урон в зависимости от количества собранной звездной материи. Если цель – чемпион, это умение дает Аурелиону Солу звездную материю.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Аурелион Сол дышит звездным огнем до {{ maxchannelduration }} сек., ежесекундно нанося {{ damagepersecond }} магического урона первому пораженному врагу и {{ aoemodifier*100 }}% от этого урона противникам поблизости. Каждый раз, когда цель поражается огнем 1 секунду суммарно, происходит взрыв, который наносит {{ burstdamage }} магического урона плюс магический урон в размере {{ burstbonustruedamagetochamps }} от максимального запаса здоровья . Если цель – чемпион, Аурелион Сол получает {{ qmassstolen }} звездной материи .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#MissFortune_E">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>MissFortune_E</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Свинцовый дождь</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_MissFortune"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MissFortune:E</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">E</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Мисс Фортуна обрушивает град пуль на выбранную область, раскрывая ее. Все находящиеся там противники в течение нескольких секунд получают урон и замедляются.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Мисс Фортуна обрушивает град пуль на выбранную область, раскрывая ее. Враги внутри замедляются на {{ totalslowamount }} и получают {{ totaldamagepersecond }} магического урона в секунду в течение {{ baseduration }} сек. (всего: {{ totaldamage }} магического урона ).{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Mordekaiser">
