    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
    <lol:resourceType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Поток</lol:resourceType>
    <lol:baseHP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">620.0</lol:baseHP>
    <lol:baseMP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">500.0</lol:baseMP>
    <lol:baseArmor rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">33.0</lol:baseArmor>
    <lol:baseAttackDamage rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">62.0</lol:baseAttackDamage>
    <lol:baseMoveSpeed rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">345.0</lol:baseMoveSpeed>
    <lol:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Fighter"/>
    <lol:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Assassin"/>
    <lol:reviewStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">effects_not_reviewed</lol:reviewStatus>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Yone_P"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Yone_Q"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Yone_W"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Yone_E"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Yone_R"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Source_Zed">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#SourceDocument"/>
    <rdfs:label>Source_Zed</rdfs:label>
    <lol:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://ddragon.leagueoflegends.com/cdn/16.20.1/data/ru_RU/champion/Zed.json</lol:sourceURL>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Graves_P">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
    <rdfs:label>Graves_P</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Новая Судьба</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Graves"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Graves:P</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">У дробовика Грейвза есть несколько уникальных свойств. Грейвз должен периодически его перезаряжать. При автоатаках дробовик выпускает 4 пули, которые не могут пробить цель насквозь. Нечемпионы, в которых попало несколько пуль, отбрасываются.</lol:description>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Viktor_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Viktor_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Отвод энергии</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Viktor"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Viktor:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Виктор наносит вражескому бойцу магический урон, а также получает щит и усиливает следующую автоатаку. Улучшение: после применения Отвода энергии у Виктора увеличивается скорость передвижения. Прочность щита увеличивается на 60%.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Виктор поражает цель, нанося {{ totalmissiledamage }} ед. магического урона и получая щит прочностью {{ shieldlevelscaling }} на {{ buffduration }} сек. Следующая автоатака Виктора, примененная в течение 4 сек., наносит {{ attacktotaldmg }} ед. магического урона . Улучшение: дает щит прочностью {{ totalaugmentedshieldvalue }} и увеличивает скорость передвижения Виктора на {{ augmentmovespeedbonus }}% на {{ buffduration }} сек.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Karma_W_Damage_Enemy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#AbilityEffect"/>
    <rdfs:label>Karma_W_Damage_Enemy</rdfs:label>
    <lol:hasMechanic rdf:resource="https://example.org/lol-ontology#Damage"/>
    <lol:hasTargetType rdf:resource="https://example.org/lol-ontology#Enemy"/>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Karma"/>
    <lol:conditionText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Выбранная вражеская цель связана с Кармой; повторный урон, если связь сохраняется.</lol:conditionText>
    <lol:evidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Карма создает связь между собой и чемпионом или лесным монстром, нанося цели {{ initialdamage }} магического урона и раскрывая ее на {{ tetherduration }} сек. Если связь не разрывается, цель снова получает {{ initialdamage }} магического урона и обездвиживается на {{ rootduration }} сек.{{ spellmodifierdescriptionappend }}</lol:evidenceText>
    <lol:evidenceField rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tooltip_text</lol:evidenceField>
    <lol:reviewStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">reviewed_by_assistant</lol:reviewStatus>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#MissFortune_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>MissFortune_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Два по цене одного</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_MissFortune"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MissFortune:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Мисс Фортуна стреляет в противника, нанося урон и ему, и цели за ним. Оба выстрела могут наложить эффект Приветственного выстрела.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Мисс Фортуна стреляет отскакивающей пулей, нанося {{ totaldamagetooltip }} ед. физического урона цели и врагу за ней. Второе попадание может стать критическим, нанеся {{ totaldamagecrit }} ед. физического урона , и всегда становится критическим, если первое попадание убивает цель.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Viktor_E">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Viktor_E</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Хекстековый луч</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Viktor"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Viktor:E</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">E</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Виктор выпускает хекстековый луч из своей биомеханической руки. Луч описывает отрезок, нанося урон всем врагам, которых задевает. Улучшение: после прохождения хекстекового луча следует взрыв, наносящий магический урон.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Виктор выпускает хекстековый луч в выбранном направлении, нанося всем пораженным врагам {{ laserdamage }} магического урона . Улучшение: после прохождения хекстекового луча за ним следует взрыв, который наносит {{ aftershockdamage }} магического урона . {{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Yasuo_P">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
    <rdfs:label>Yasuo_P</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Путь скитальца</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Yasuo"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Yasuo:P</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Шанс критического удара Ясуо увеличен. Кроме того, передвигаясь, Ясуо накапливает поток для создания щита. Щит срабатывает при получении урона от чемпиона или монстра.</lol:description>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Source_DrMundo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#SourceDocument"/>
    <rdfs:label>Source_DrMundo</rdfs:label>
    <lol:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://ddragon.leagueoflegends.com/cdn/16.20.1/data/ru_RU/champion/DrMundo.json</lol:sourceURL>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#DrMundo_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>DrMundo_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Зараженная пила</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_DrMundo"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DrMundo:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Доктор Мундо бросает зараженную хирургическую пилу, которая замедляет первого пораженного врага и наносит урон в зависимости от его текущего здоровья.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Доктор Мундо швыряет свою хирургическую пилу, которая наносит первому пораженному врагу магический урон в размере {{ currenthealthdamage*100 }}% от текущего здоровья и замедляет его на {{ slowamount*100 }}% на {{ slowduration }} сек. Если пила попадает в чемпиона или монстра, Доктор Мундо восстанавливает себе {{ healthrestoreonhitchampionmonster }} здоровья . Если пила попадает в другую цель, Доктор Мундо восстанавливает себе {{ healthrestoreonhitminion }} здоровья .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#TahmKench_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>TahmKench_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Подводный рывок</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_TahmKench"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TahmKench:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Таам Кенч ныряет под поверхность, а затем выныривает в выбранном месте, нанося урон всем окружающим врагам и подбрасывая их.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Таам Кенч ныряет под поверхность, а затем выныривает в выбранном месте, нанося {{ totaldamage }} магического урона всем окружающим врагам и подбрасывая их на {{ knockupduration }} сек. Если Таам Кенч поражает хотя бы одного вражеского чемпиона, перезарядка этого умения сокращается на {{ champrefund*100 }}% и он восстанавливает {{ champrefund*100 }}% от затраченной маны . Если Таам Кенч проглотил союзника, тот отправляется вместе с ним (если не выпрыгнет из желудка раньше времени).{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Twitch">
