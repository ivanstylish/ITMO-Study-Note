    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Брэнд выпускает в указанном направлении огненный шар, который наносит магический урон. Если цель в огне, Выгорание оглушает ее.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Брэнд выпускает огненный шар, который наносит {{ totaldamage }} магического урона первому пораженному врагу. Если цель подожжена , она оглушается на {{ stunduration }} сек.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Mechanic">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Mechanic</rdfs:label>
    <rdfs:comment xml:lang="ru">Тип механики: щит, урон, обездвиживание и т. п.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Lucian_R">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Lucian_R</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Отстрел</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Lucian"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Lucian:R</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Люциан безостановочно палит из своих пистолетов.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Люциан стреляет очередью в выбранном направлении в течение {{ duration }} сек. или до повторного применения умения, выпуская до {{ totalnumshots }} снарядов. Каждый выстрел наносит {{ damageperbullet }} физического урона первому пораженному врагу. Во время стрельбы Люциан может применять Нескончаемую погоню . Общий урон: {{ totaldamage }} физического урона {{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Fizz_P">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
    <rdfs:label>Fizz_P</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Проворный боец</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Fizz"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fizz:P</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Физз может проходить сквозь бойцов и уменьшает получаемый урон из всех источников на фиксированную величину</lol:description>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Pantheon_R">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Pantheon_R</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Великий звездопад</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Pantheon"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pantheon:R</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пантеон собирается с силами, а затем подпрыгивает в воздух и приземляется в выбранном месте в виде кометы.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пассивно: пробивание брони у Пантеона увеличено на {{ armorpenetration*100 }}%. Активно: Пантеон собирается с силами и подпрыгивает высоко в воздух, после чего бросает свое копье, которое наносит {{ spell.pantheonq:holddamagecalc }} физического урона врагам в небольшой области и замедляет их на {{ spearslow*100 }}% на {{ spearslowduration }} сек. После этого Пантеон падает в выбранном месте в виде метеорита, нанося до {{ damagecalc }} магического урона врагам на прямой (урон уменьшается на величину вплоть до {{ edgedamagereduction*100 }}% у краев области поражения). Это умение мгновенно подготавливает Волю смертного .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Yunara_P">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
    <rdfs:label>Yunara_P</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Клятва Исконной земле</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Yunara"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Yunara:P</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Критические удары Юнары наносят дополнительный магический урон.</lol:description>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Pantheon_E">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Pantheon_E</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Агрессивная защита</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Pantheon"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pantheon:E</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">E</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пантеон выставляет щит и становится невосприимчивым к урону спереди. При этом он несколько раз наносит удары копьем.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пантеон выставляет свой щит и атакует врагов в выбранном направлении в течение {{ shieldduration }} сек., становясь невосприимчивым к урону с этой стороны (кроме урона от башен) и нанося {{ damagecalc }} физического урона на протяжении действия умения. После этого Пантеон бьет своим щитом, нанося {{ shielddamagecalc }} физического урона . Усиление Волей смертного: когда Пантеон бьет щитом, он получает {{ resistscalc }} брони и {{ resistscalc }} сопротивления магии на {{ resistsduration }} сек., а его скорость передвижения увеличивается на {{ speedamount*100 }}% на {{ speedduration }} сек. {{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Annie_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Annie_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Расщепление</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Annie"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Annie:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Энни швыряет во врага заряженный маной огненный шар, нанося ему магический урон. Если враг умирает, затраченная мана восстанавливается.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Энни выпускает огненный шар, который наносит {{ totaldamage }} магического урона . Если цель погибает, Энни получает назад затраченную ману, а перезарядка умения сокращается на 50%.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Azir_E">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Azir_E</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Подвижный песок</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Azir"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Azir:E</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">E</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Азир ненадолго защищает себя щитом и совершает рывок к одному из своих песчаных воинов, нанося урон врагам на своем пути. Если Азир сталкивается с вражеским чемпионом, у него мгновенно появляется в запасе еще один воин, а рывок прекращается.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Азир накладывает на себя щит прочностью {{ totalshield }} на {{ shieldduration }} сек. и совершает рывок к одному из своих песчаных воинов , нанося {{ totaldamage }} ед. маг. урона всем врагам на пути. Столкнувшись с вражеским чемпионом, Азир останавливается и добавляет в резерв 1 песчаного воина .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Karthus_R">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Karthus_R</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Реквием</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Karthus"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Karthus:R</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Картус читает заклинание в течение 3 секунд, после чего наносит урон всем вражеским чемпионам.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Картус читает заклинание в течение 3 сек., после чего наносит {{ totaldamage }} магического урона всем вражеским чемпионам независимо от расстояния.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Evelynn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#Champion"/>
    <rdfs:label>Evelynn</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Эвелинн</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Evelynn"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Evelynn</lol:entityId>
    <lol:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Объятия агонии</lol:title>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
    <lol:resourceType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Мана</lol:resourceType>
    <lol:baseHP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">642.0</lol:baseHP>
    <lol:baseMP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">315.0</lol:baseMP>
    <lol:baseArmor rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">37.0</lol:baseArmor>
    <lol:baseAttackDamage rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">61.0</lol:baseAttackDamage>
    <lol:baseMoveSpeed rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">335.0</lol:baseMoveSpeed>
    <lol:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Assassin"/>
    <lol:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Mage"/>
    <lol:reviewStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">effects_not_reviewed</lol:reviewStatus>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Evelynn_P"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Evelynn_Q"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Evelynn_W"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Evelynn_E"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Evelynn_R"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Sejuani_R">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Sejuani_R</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ледниковый плен</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Sejuani"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sejuani:R</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Седжуани бросает болас, который замораживает и оглушает первого врага на пути, а также создает ледяную бурю, которая замедляет остальных врагов.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Седжуани кидает болас из Истинного льда, оглушая и раскрывая первого вражеского чемпиона на пути на {{ basestunduration }} сек., а также нанося ему {{ minordamagetooltip }} ед. маг. урона . Если болас пролетел хотя бы 25% от макс. дальности, длительность оглушения и раскрытия растут до {{ empoweredstunduration }} сек. Также он создает ледяную бурю, замедляющую окружающих врагов на {{ explosionslowamount }}% на {{ zoneduration }} сек. Все пораженные враги получают {{ totaldamagetooltip }} ед. маг. урона .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#TahmKench_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>TahmKench_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Удар языком</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_TahmKench"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TahmKench:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Таам Кенч выбрасывает язык в выбранном направлении, нанося урон первой пораженной цели и замедляя ее, а также восстанавливая себе здоровье, если целью был чемпион. Умение накладывает заряд Жора на вражеского чемпиона. Когда накладывается 3 заряда Жора , чемпион оказывается оглушен, а заряды поглощаются.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Таам Кенч наносит {{ totaldamage }} магического урона первому пораженному врагу и замедляет его на {{ slowamount*100 }}% на {{ slowduration }} сек. Поражая чемпиона, Таам лечится на {{ baseheal }} + {{ percenthealthhealing*100 }}% от своего недостающего здоровья , накладывает на цель заряд умения Жор и дополнительно наносит {{ spell.tahmkenchpassive:totaldamage }} магического урона . Когда на чемпиона накладывается 3 заряда умения Жор , он оглушается на {{ stunduration }} сек., а заряды поглощаются. Когда язык летит к цели, активация Хватай-глотай позволяет проглотить чемпиона с 3 зарядами умения Жор на расстоянии после его поражения.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Source_Ahri">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#SourceDocument"/>
    <rdfs:label>Source_Ahri</rdfs:label>
    <lol:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://ddragon.leagueoflegends.com/cdn/16.20.1/data/ru_RU/champion/Ahri.json</lol:sourceURL>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Bard_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Bard_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Оковы Вселенной</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Bard"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bard:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Бард выпускает в выбранном направлении энергетический заряд, который поражает до двух врагов на своем пути, нанося им урон. Первая пораженная цель замедляется. Если после поражения первой цели заряд попадает во врага или стену, все пораженные цели оглушаются.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Бард выпускает энергетический заряд, который наносит {{ totaldamage }} магического урона первым двум пораженным врагам. Первая цель замедляется на {{ slowamountpercentage }}% на {{ slowduration }} сек. Если после поражения первой цели заряд попадает во врага или в стену, все пораженные цели оглушаются на {{ stunduration }} сек. {{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Braum_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Braum_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Укус зимы</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Braum"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Braum:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Браум стряхивает лед со своего щита, замедляя пораженного врага и нанося ему магический урон. Умение накладывает заряд Оглушающих ударов .</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Браум сбрасывает лед со своего щита, нанося {{ totaldamage }} ед. магического урона первому пораженному врагу и замедляя его на {{ initialslow }}% (эффект пропадает за {{ slowduration }} сек.). Накладывает заряд Оглушающих ударов . {{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Evelynn_E">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Evelynn_E</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Удар хлыста</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Evelynn"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Evelynn:E</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">E</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Эвелинн бьет противника плетью, нанося урон. После этого ее скорость передвижения ненадолго увеличивается.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Эвелинн хлещет врага, нанося магический урон в размере {{ basedamage }} плюс {{ percenthealthbasetooltip }} от максимального запаса здоровья . Эвелинн получает {{ speedamount*100 }}% скорости передвижения на {{ speedduration }} сек. При входе в Демоническую тень перезарядка этого умения сбрасывается и оно усиливается. Когда это умение усилено, Эвелинн совершает рывок к цели и наносит ей и всем врагам, через которых проходит, магический урон в размере {{ empowereddamage }} плюс {{ percenthealthempoweredtooltip }} от максимального запаса здоровья .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Jayce_E">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Jayce_E</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Грохочущий удар / Врата ускорения</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Jayce"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Jayce:E</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">E</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Стойка с молотом: Джейс наносит врагу магический урон и отбрасывает его назад на небольшое расстояние. Стойка с пушкой: Джейс устанавливает Врата ускорения, которые увеличивают скорость передвижения всех союзных чемпионов, проходящих через них. Если Шоковый заряд пролетает сквозь врата, его скорость, дальность поражения и урон увеличиваются.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Стойка с молотом : Джейс бьет своим молотом, отбрасывая цель и нанося магический урон в размере {{ spell.jaycethunderingblow:flatdamage }} плюс {{ spell.jaycethunderingblow:perchpdamage*100 }}% от максимального запаса здоровья .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#MissFortune">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#Champion"/>
    <rdfs:label>MissFortune</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Мисс Фортуна</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_MissFortune"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MissFortune</lol:entityId>
    <lol:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Охотница за головами</lol:title>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
    <lol:resourceType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Мана</lol:resourceType>
    <lol:baseHP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">625.0</lol:baseHP>
    <lol:baseMP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">300.0</lol:baseMP>
    <lol:baseArmor rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">25.0</lol:baseArmor>
    <lol:baseAttackDamage rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">55.0</lol:baseAttackDamage>
    <lol:baseMoveSpeed rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">325.0</lol:baseMoveSpeed>
    <lol:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Marksman"/>
    <lol:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Mage"/>
    <lol:reviewStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">effects_not_reviewed</lol:reviewStatus>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#MissFortune_P"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#MissFortune_Q"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#MissFortune_W"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#MissFortune_E"/>
