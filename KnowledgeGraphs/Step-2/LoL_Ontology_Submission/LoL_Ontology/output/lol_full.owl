  <rdf:Description rdf:about="https://example.org/lol-ontology#Annie_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Annie_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Испепеление</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Annie"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Annie:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Энни создает конус из пламени, нанося урон всем врагам в зоне поражения.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Энни выпускает волну пламени, которая наносит {{ totaldamage }} магического урона .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
