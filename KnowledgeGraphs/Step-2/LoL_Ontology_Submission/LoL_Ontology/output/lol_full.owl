  <rdf:Description rdf:about="https://example.org/lol-ontology#Jhin_R">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Jhin_R</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Выход на поклон</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Jhin"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Jhin:R</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Джин подготавливает свое оружие, а затем может выпустить четыре пули в выбранном секторе, каждая из которых летит, пока не поразит вражеского чемпиона, замедлив его и нанеся большой урон. Последний выстрел Выхода на поклон совершенен: он всегда критический и наносит гораздо больший урон.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Джин занимает позицию, после чего может совершить 4 мощных выстрела, каждый из которых наносит от {{ damagecalc }} до {{ maxincreasecalc }} физического урона первому чемпиону на пути в зависимости от его недостающего здоровья и замедляет его на {{ slowpercent*100 }}% на {{ slowduration }} сек. Четвертый выстрел всегда критический и наносит {{ fourthshotmultiplier*100 }}% урона.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Gwen">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#Champion"/>
    <rdfs:label>Gwen</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Гвен</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Gwen"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gwen</lol:entityId>
    <lol:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Благая швея</lol:title>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
    <lol:resourceType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Мана</lol:resourceType>
    <lol:baseHP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">620.0</lol:baseHP>
    <lol:baseMP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">330.0</lol:baseMP>
    <lol:baseArmor rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">39.0</lol:baseArmor>
    <lol:baseAttackDamage rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">63.0</lol:baseAttackDamage>
    <lol:baseMoveSpeed rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">340.0</lol:baseMoveSpeed>
    <lol:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Fighter"/>
    <lol:reviewStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">effects_not_reviewed</lol:reviewStatus>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Gwen_P"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Gwen_Q"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Gwen_W"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Gwen_E"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Gwen_R"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Tristana_P">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
    <rdfs:label>Tristana_P</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Прицеливание</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Tristana"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tristana:P</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">С каждым уровнем Тристана увеличивает дальность атаки.</lol:description>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Rell_R">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Rell_R</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Магнитная буря</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Rell"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Rell:R</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Релл создает вокруг себя магнитную бурю, резко притягивая окружающих врагов. После этого она продолжает притягивать их к себе еще в течение некоторого времени, нанося им периодический магический урон.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Релл создает вокруг себя магнитную бурю, резко притягивая окружающих врагов. После этого она продолжает притягивать их к себе еще в течение {{ duration }} сек., нанося им {{ totaldamage }} магического урона .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Fizz">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#Champion"/>
    <rdfs:label>Fizz</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Физз</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Fizz"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fizz</lol:entityId>
    <lol:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Морской ловкач</lol:title>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
    <lol:resourceType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Мана</lol:resourceType>
    <lol:baseHP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">640.0</lol:baseHP>
    <lol:baseMP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">317.0</lol:baseMP>
    <lol:baseArmor rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">26.0</lol:baseArmor>
    <lol:baseAttackDamage rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">58.0</lol:baseAttackDamage>
    <lol:baseMoveSpeed rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">335.0</lol:baseMoveSpeed>
    <lol:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Assassin"/>
    <lol:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Fighter"/>
    <lol:reviewStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">effects_not_reviewed</lol:reviewStatus>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Fizz_P"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Fizz_Q"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Fizz_W"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Fizz_E"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Fizz_R"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#DrMundo_P">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
    <rdfs:label>DrMundo_P</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ходить куда хотеть</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_DrMundo"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DrMundo:P</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Доктор Мундо игнорирует первый направленный в него обездвиживающий эффект, но теряет здоровье и роняет неподалеку емкость с химикатами. Когда Доктор Мундо проходит над емкостью, он подбирает ее, восстанавливая здоровье и сокращая перезарядку этого умения. Восстановление здоровья Доктора Мундо значительно увеличено.</lol:description>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Ryze_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Ryze_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Перегрузка</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Ryze"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ryze:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пассивно: другие базовые умения Райза сбрасывают перезарядку Перегрузки и дают заряд руны. Если во время применения Перегрузки у Райза есть два заряда руны, он ненадолго ускоряется. Активно: Райз выпускает в выбранном направлении сгусток чистой энергии, нанося урон первому пораженному врагу. Если цель поражена Потоком, Перегрузка наносит дополнительный урон и распространяется на ближайших врагов с Потоком.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пассивно: Руническая тюрьма и Волшебный поток сбрасывают перезарядку этого умения и дают заряд руны на {{ runeduration }} сек. (максимум зарядов - {{ maximumrunes }}). Активно: Райз выпускает сгусток энергии, который наносит {{ qdamagecalc }} магического урона первому пораженному врагу. Если цель поражена Потоком , он поглощается, а это умение наносит на {{ spell.ryzer:overloaddamagebonus }}% больше урона и распространяется на ближайших врагов с Потоком . Если во время применения у Райза {{ maximumrunes }} заряда рун, они поглощаются, а его скорость передвижения увеличивается на {{ movementspeedamount }}% на {{ movementspeedduration }} сек. {{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Aatrox_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Aatrox_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Клинок даркинов</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Aatrox"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Aatrox:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Атрокс бьет мечом сверху вниз, нанося физический урон. Он может ударить три раза, и каждый раз область поражения будет меняться.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Атрокс бьет своим мечом, нанося {{ qdamage }} физического урона . Если цель находится на краю области поражения, она ненадолго подбрасывается , а урон по ней увеличивается до {{ qedgedamage }} . Это умение можно дважды применить повторно - при каждом повторном применении область поражения меняет форму, а урон увеличивается на 25%.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Zac_P">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
    <rdfs:label>Zac_P</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Цитокинез</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Zac"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Zac:P</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Каждый раз, когда Зак поражает противника умением, он отрывает от своего тела кусочек, который может поглотить обратно, восстановив часть своего здоровья. Получив смертельный урон, Зак распадается на 4 капли, которые пытаются воссоединиться. Если хотя бы одна из этих капель останется жива, Зак возродится с запасом здоровья, зависящим от оставшегося запаса здоровья уцелевших капель. Каждая капля получает долю от максимального запаса здоровья Зака, его брони и сопротивления магии. Перезарядка этого умения занимает 5 минут.</lol:description>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Ivern_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Ivern_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Создатель кустов</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Ivern"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ivern:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Когда Иверн и его союзники поблизости находятся в кустах, их автоатаки наносят дополнительный магический урон. Иверн может активировать это умение, чтобы создать куст.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пассивно: автоатаки Иверна дополнительно наносят {{ totaldamage }} магического урона , когда он находится в кустах, а также в течение {{ buffduration }} сек. после выхода из них. Союзники поблизости тоже получают этот эффект на {{ allybuffduration }} сек., но наносят {{ totalallydamage }} магического урона . Активно: Иверн выращивает куст и раскрывает область на {{ revealduration }} сек. Куст существует, пока команда Иверна не теряет его обзор, или до {{ maxbrushduration }} сек.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Zilean">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#Champion"/>
    <rdfs:label>Zilean</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Зилеан</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Zilean"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Zilean</lol:entityId>
    <lol:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Хранитель времени</lol:title>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
    <lol:resourceType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Мана</lol:resourceType>
    <lol:baseHP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">574.0</lol:baseHP>
    <lol:baseMP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">452.0</lol:baseMP>
    <lol:baseArmor rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">24.0</lol:baseArmor>
    <lol:baseAttackDamage rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">52.0</lol:baseAttackDamage>
    <lol:baseMoveSpeed rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">335.0</lol:baseMoveSpeed>
    <lol:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Support"/>
    <lol:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Mage"/>
    <lol:reviewStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">effects_not_reviewed</lol:reviewStatus>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Zilean_P"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Zilean_Q"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Zilean_W"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Zilean_E"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Zilean_R"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#KogMaw_E">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>KogMaw_E</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Слизь Бездны</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_KogMaw"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">KogMaw:E</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">E</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ког'Мао выплевывает сгусток слизи, который наносит урон всем врагам на своем пути и оставляет за собой след, замедляющий прошедших по нему противников.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ког'Мао выплевывает слизь, которая наносит {{ totaldamage }} ед. магического урона и оставляет за собой след на {{ trailduration }} сек. Враги в слизи замедляются на {{ slowamount }}%.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Viego_P">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
    <rdfs:label>Viego_P</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Право сильного</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Viego"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Viego:P</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Враги, погибшие около Виего, превращаются в призраков. Атаковав призрака, Виего на время берет под контроль тело соответствующего врага. При этом он лечится на процент от максимального запаса здоровья цели, получает доступ к ее базовым умениям и предметам и может бесплатно применить свое абсолютное умение.</lol:description>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Viktor_P">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
    <rdfs:label>Viktor_P</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Великая эволюция</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Viktor"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Viktor:P</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Виктор получает хекстековые фрагменты каждый раз, когда убивает врага. Собрав 100 хекстековых фрагментов, он может навсегда улучшить активное умение. Когда он улучшит все базовые умения, он может улучшить абсолютное, собрав еще 100 хекстековых фрагментов.</lol:description>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#SourceDocument">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>SourceDocument</rdfs:label>
    <rdfs:comment xml:lang="ru">Документ, подтверждающий данные.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Tryndamere_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Tryndamere_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Жажда крови</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Tryndamere"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tryndamere:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Триндамир получает наслаждение от битвы: с каждым ранением его сила атаки растет. Он может использовать Жажду крови, чтобы истратить ярость и вылечить себя.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пассивно: Триндамир жаждет крови: он получает вплоть до {{ maximumbonusad }} силы атаки в зависимости от своего недостающего здоровья. Активно: Триндамир поглощает ярость , восстанавливая здоровье в размере {{ baseheal }} плюс {{ healperfury }} за каждую единицу ярости (максимум – {{ maximumheal }}) . {{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Nautilus_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Nautilus_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Гнев титана</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Nautilus"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nautilus:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Наутилус ненадолго накладывает на себя щит. Пока существует щит, автоатаки Наутилуса наносят периодический урон цели и окружающим врагам.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Наутилус на {{ shieldduration }} сек. получает щит прочностью {{ shieldcalc }} . Пока существует щит , автоатаки Наутилуса дополнительно наносят {{ dotdamagecalc }} магического урона в течение 2 сек. цели и всем окружающим врагам.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Sylas_R">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Sylas_R</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Похищение силы</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Sylas"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sylas:R</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Сайлас похищает абсолютное умение врага и может его применить.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Сайлас грабит вражеского чемпиона, получая возможность применить копию его абсолютного умения. Уровень похищенного умения соответствует уровню абсолютного умения Сайласа, а сила зависит от его показателей. После похищения умения Сайлас не может ограбить того же врага в течение периода, равного {{ pertargetcooldown }}% от времени перезарядки его умения (ускорение умений Сайласа уменьшает этот период; минимальный период - {{ minimumenemycooldown }} сек.).{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Singed_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Singed_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Мегаклей</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Singed"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Singed:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Синджед разбивает о землю флакон мегаклея. Враги, проходящие по клею, замедляются и теряют способность использовать умения перемещения.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Синджед бросает склянку с клейкой субстанцией, парализуя и замедляя врагов в области действия на {{ slowpercent }}% на {{ wduration }} сек.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Karma_E">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Karma_E</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Воодушевление</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Karma"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Karma:E</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">E</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Карма защищает союзника щитом, поглощающим урон и увеличивающим его скорость передвижения. Эффект Мантры: щит излучает энергию, которая увеличивает его прочность и накладывает Воодушевление на ближайших союзных чемпионов.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Карма накладывает на союзного чемпиона щит прочностью {{ totalshield }} на {{ shieldduration }} сек. и увеличивает его скорость передвижения на {{ movespeed*100 }}% на {{ movespeedduration }} сек.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
    <lol:hasEffect rdf:resource="https://example.org/lol-ontology#Karma_E_Shield_Ally"/>
    <lol:hasEffect rdf:resource="https://example.org/lol-ontology#Karma_E_MovementSpeedBoost_Ally"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Riven">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#Champion"/>
    <rdfs:label>Riven</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ривен</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Riven"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Riven</lol:entityId>
    <lol:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Изгнанница</lol:title>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
    <lol:resourceType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Нет</lol:resourceType>
    <lol:baseHP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">630.0</lol:baseHP>
    <lol:baseMP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.0</lol:baseMP>
    <lol:baseArmor rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">33.0</lol:baseArmor>
    <lol:baseAttackDamage rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">64.0</lol:baseAttackDamage>
    <lol:baseMoveSpeed rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">340.0</lol:baseMoveSpeed>
    <lol:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Fighter"/>
    <lol:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Assassin"/>
    <lol:reviewStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">effects_not_reviewed</lol:reviewStatus>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Riven_P"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Riven_Q"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Riven_W"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Riven_E"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Riven_R"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Orianna_R">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Orianna_R</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Приказ: Ударная волна</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Orianna"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Orianna:R</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Орианна приказывает своему шару создать ударную волну, которая после небольшой задержки поражает всех врагов вокруг, нанося им магический урон и притягивая их по направлению к шару.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Орианна приказывает своему шару создать ударную волну, которая наносит {{ totaldamage }} магического урона окружающим врагам и притягивает их в сторону шара .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Ziggs">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#Champion"/>
    <rdfs:label>Ziggs</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Зиггс</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Ziggs"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ziggs</lol:entityId>
    <lol:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Эксперт по хексчатке</lol:title>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
    <lol:resourceType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Мана</lol:resourceType>
    <lol:baseHP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">606.0</lol:baseHP>
    <lol:baseMP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">480.0</lol:baseMP>
    <lol:baseArmor rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">21.0</lol:baseArmor>
    <lol:baseAttackDamage rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">55.0</lol:baseAttackDamage>
    <lol:baseMoveSpeed rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">325.0</lol:baseMoveSpeed>
    <lol:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Mage"/>
    <lol:reviewStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">effects_not_reviewed</lol:reviewStatus>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Ziggs_P"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Ziggs_Q"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Ziggs_W"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Ziggs_E"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Ziggs_R"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Kayn_E">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Kayn_E</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Шаг в сумерки</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Kayn"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Kayn:E</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">E</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Каин может проходить сквозь элементы ландшафта.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Каин увеличивает свою скорость передвижения на {{ e1 }}% , становится призрачным и получает способность проходить сквозь элементы ландшафта на {{ e2 }} сек. При первом прохождении сквозь элемент ландшафта Каин восстанавливает {{ totalhealing }} здоровья . Если Каина обездвиживают или он находится вне элементов ландшафта более {{ e3 }} сек. подряд, действие этого умения прекращается преждевременно. Сумеречный убийца: скорость передвижения Каина увеличивается на {{ e5 }}% . Кроме того, он становится невосприимчивым к замедлению и сокращает перезарядку этого умения до {{ assassincdreduction }} сек.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Viego_E">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Viego_E</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Путь страха</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Viego"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Viego:E</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">E</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Виего приказывает черному туману окружить элемент ландшафта. Когда Виего прячется в тумане, он становится призраком, получая маскировку, а также увеличивая скорость передвижения и скорость атаки.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Виего выпускает вперед призрака, который окружает элемент ландшафта черным туманом на {{ mistduration }} сек. Пока Виего находится в тумане, на него действует маскировка . Кроме того, его скорость передвижения увеличивается на {{ totalmovespeed }} , а скорость атаки - на {{ attackspeed*100 }}% .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Hwei">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#Champion"/>
    <rdfs:label>Hwei</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Хвэй</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Hwei"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hwei</lol:entityId>
    <lol:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Творец</lol:title>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
    <lol:resourceType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Мана</lol:resourceType>
    <lol:baseHP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">580.0</lol:baseHP>
    <lol:baseMP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">480.0</lol:baseMP>
    <lol:baseArmor rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">21.0</lol:baseArmor>
    <lol:baseAttackDamage rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">54.0</lol:baseAttackDamage>
    <lol:baseMoveSpeed rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">330.0</lol:baseMoveSpeed>
    <lol:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Mage"/>
    <lol:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Support"/>
    <lol:reviewStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">effects_not_reviewed</lol:reviewStatus>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Hwei_P"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Hwei_Q"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Hwei_W"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Hwei_E"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Hwei_R"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Naafiri_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Naafiri_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Зов стаи</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Naafiri"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Naafiri:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Наафири становится недосягаемой и призывает дополнительных членов стаи, усиливая ее, а также получает скорость передвижения и силу атаки.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Наафири становится недосягаемой на {{ untargetableduration }} сек. и готовится к охоте, призывая дополнительных членов стаи ({{ packmatestoadd }}) , а также получая {{ bonusad }} силы атаки и {{ movespeedamount*100 }}% скорости передвижения на {{ duration }} сек. Члены стаи становятся недосягаемыми и возвращаются к Наафири. {{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Shyvana_E">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Shyvana_E</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Жидкий огонь</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Shyvana"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Shyvana:E</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">E</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Шивана выпускает огненный шар, который взрывается при попадании в крупную цель и замедляет ее. Когда Шивана в форме дракона, шар проходит сквозь врагов, оставляя огненный след, и взрывается при попадании в крупные цели.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Шивана выпускает в выбранную точку огненный шар, наносящий маг. урон в размере {{ damage }} + {{ calc_max_health_damage }} от макс. здоровья и замедляющий пораженные цели на {{ calc_slow }} на {{ slowduration }} сек. Шар взрывается, сталкиваясь с врагом или достигая конечной точки. В форме дракона размер шара больше, он проходит сквозь врагов. Сталкиваясь с чемпионом или большим монстром либо достигая конечной точки, шар взрывается, нанося маг. урон в размере {{ calc_dragon_damage }} + {{ calc_max_health_dragon_damage }} от макс. здоровья и замедляя пораженные цели на {{ calc_slow_dragon }} на {{ slowduration }} сек. Также в течение {{ groundlingerduration }} сек. он оставляет след, наносящий {{ damagepersecond }} ед. маг. урона в секунду . {{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Draven_P">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
    <rdfs:label>Draven_P</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Лига Дрейвена</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Draven"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Draven:P</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Дрейвен получает Обожание своих поклонников, когда ловит Вращающийся топор или убивает миньона или монстра, либо разрушает башню. Убийства вражеских чемпионов приносят Дрейвену награду в золоте, тем большую, чем больше Обожания у него есть.</lol:description>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Janna_E">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Janna_E</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Око бури</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Janna"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Janna:E</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">E</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Жанна призывает бурю, которая защищает союзного чемпиона или башню от входящего урона, а также увеличивает их силу атаки.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Жанна накладывает на союзного чемпиона или башню щит прочностью {{ totalshield }} на {{ shieldduration }} сек. Пока наложен щит, сила атаки цели увеличена на {{ totalad }}. Когда Жанна ограничивает передвижение вражеских чемпионов при помощи умений, ее перезарядка сокращается на {{ ecdrefundforcc*100 }}%.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Rumble">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#Champion"/>
    <rdfs:label>Rumble</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Рамбл</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Rumble"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Rumble</lol:entityId>
    <lol:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Механизированная угроза</lol:title>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
    <lol:resourceType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Нагрев</lol:resourceType>
    <lol:baseHP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">640.0</lol:baseHP>
    <lol:baseMP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">150.0</lol:baseMP>
    <lol:baseArmor rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">36.0</lol:baseArmor>
    <lol:baseAttackDamage rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">64.0</lol:baseAttackDamage>
    <lol:baseMoveSpeed rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">345.0</lol:baseMoveSpeed>
    <lol:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Fighter"/>
    <lol:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Mage"/>
    <lol:reviewStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">effects_not_reviewed</lol:reviewStatus>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Rumble_P"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Rumble_Q"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Rumble_W"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Rumble_E"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Rumble_R"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nd93108654fe24423b95488dfe70771f0">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:intersectionOf rdf:nodeID="N15229bd906e64fe2ae7de4fb677e83b5"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Briar_P">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
    <rdfs:label>Briar_P</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Алое проклятие</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Briar"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Briar:P</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Автоатаки и умения Брайер вызывают у врагов кровотечение (эффект суммируется), которое восстанавливает ей здоровье в размере части от нанесенного урона. Ее здоровье не регенерирует со временем, но чем меньше его остается, тем эффективнее становится лечение.</lol:description>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Mel_R">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Mel_R</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Золотое затмение</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Mel"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mel:R</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Мэл поражает всех врагов, на которых наложено ошеломление, где бы они ни находились, нанося дополнительный урон за каждый заряд. Урон от ошеломления увеличивается с каждым уровнем Золотого затмения.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пассивно : магический урон от ошеломления увеличивается до {{ passiveflatdamage }} плюс {{ passivestackdamage }} за заряд . Активно : Мэл поражает всех врагов, на которых наложено ошеломление , нанося им {{ ultflatdamage }} магического урона плюс еще {{ ultstackdamage }} магического урона за заряд ошеломления . Умение можно применить, только когда ошеломление наложено хотя бы на одного вражеского чемпиона. {{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Mel_E">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Mel_E</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Солнечная ловушка</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Mel"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mel:E</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">E</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Мэл выпускает сферу света, наносящую периодический урон. Враги в центре сферы обездвиживаются, а по краям – замедляются.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Мэл выпускает сферу света, которая обездвиживает врагов в центре на {{ rootduration }} сек. и наносит им {{ damage }} магического урона . Враги, попавшие в область вокруг сферы, замедляются на {{ areaslowamount*100 }}% и получают {{ areadamagepersecond }} магического урона в секунду .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Talon_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Talon_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Раздирание</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Talon"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Talon:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Талон мечет веером клинки, которые затем возвращаются к нему. По пути туда и обратно клинки наносят врагам физический урон. На пути обратно клинки наносят дополнительный урон и замедляют пораженные цели.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Талон мечет веером клинки, нанося врагам {{ totalinitialdamage }} физического урона . После этого клинки возвращаются к Талону, нанося врагам {{ totalreturndamage }} физического урона и замедляя их на {{ movespeedslow*100 }}% на {{ slowduration }} сек.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Lulu_E">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Lulu_E</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Помоги, Пикс!</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Lulu"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Lulu:E</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">E</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Если целью умения является союзник, Лулу приказывает Пиксу подскочить к нему и защитить его. После этого Пикс следует за ним и помогает ему атаковать. Если целью умения является враг, Лулу приказывает Пиксу подскочить к нему и нанести ему урон. После этого Пикс следует за ним и дает возможность его видеть.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">При применении к союзнику Пикс бросается к цели и дает ей эффект Пикс, волшебный спутник на {{ pixonallyduration }} сек. Если цель – чемпион, Пикс также накладывает щит прочностью {{ totalshield }} на {{ shieldduration }} сек. При применении к вражескому чемпиону Пикс бросается к цели, нанося ей {{ totaldamage }} ед. маг. урона . Он дает истинное видение цели на {{ pixonenemyduration }} сек.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#MonkeyKing_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>MonkeyKing_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Сокрушительный удар</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_MonkeyKing"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MonkeyKing:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Следующая автоатака Вуконга имеет увеличенную дальность, наносит дополнительный урон и уменьшает броню цели на несколько секунд.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Следующая автоатака Вуконга и его клона имеет увеличенную до {{ attackrangebonus }} дальность, дополнительно наносит {{ bonusdamagett }} физического урона и уменьшает броню на {{ armorshredpercent*100 }}% на {{ shredduration }} сек. Перезарядка этого умения сокращается на {{ cooldowndecrease }} сек. каждый раз, когда Вуконг или его клон поражают врага атакой или умением. При нанесении урона это умение активирует эффекты заклинаний. {{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#evidenceText">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>evidenceText</rdfs:label>
    <rdfs:domain rdf:resource="https://example.org/lol-ontology#AbilityEffect"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Anivia_P">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
    <rdfs:label>Anivia_P</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Перерождение</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Anivia"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Anivia:P</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">При получении смертельного урона Анивия превращается в яйцо, а затем перерождается с полным запасом здоровья.</lol:description>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Morgana_E_ControlImmunity_Ally">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#AbilityEffect"/>
    <rdfs:label>Morgana_E_ControlImmunity_Ally</rdfs:label>
    <lol:hasMechanic rdf:resource="https://example.org/lol-ontology#ControlImmunity"/>
    <lol:hasTargetType rdf:resource="https://example.org/lol-ontology#Ally"/>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Morgana"/>
    <lol:conditionText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Барьер блокирует описанные эффекты контроля, пока не будет уничтожен.</lol:conditionText>
    <lol:evidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Моргана защищает союзника защитным барьером из звездного огня, который поглощает магический урон и эффекты контроля, пока не будет уничтожен.</lol:evidenceText>
    <lol:evidenceField rdf:datatype="http://www.w3.org/2001/XMLSchema#string">description_text</lol:evidenceField>
    <lol:reviewStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">reviewed_by_assistant</lol:reviewStatus>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Yasuo_E">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Yasuo_E</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Стремительный клинок</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Yasuo"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Yasuo:E</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">E</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ясуо совершает рывок сквозь цель, нанося магический урон. Каждый рывок увеличивает урон следующего (но не более чем на максимальное значение). Нельзя использовать против одного и того же врага в течение нескольких секунд. Если во время рывка использовать Стальную бурю, она ударит по кругу.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ясуо совершает рывок сквозь цель, нанося {{ totaldamage }} ед. маг. урона . Каждое применение этого умения повышает урон следующих применений на {{ bonusdamageperstack }} на {{ stackduration }} сек. (суммируется до {{ maxstacks }} р.). Перезарядка для каждой цели – {{ pertargetcooldown }} сек.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Kalista_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Kalista_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Дух-хранитель</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Kalista"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Kalista:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Когда Калиста и чемпион, принесший ей Клятву верности, атакуют одну и ту же цель, та получает дополнительный урон. При активации умения Калиста посылает на разведку духа, который раскрывает область перед собой.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пассивно: когда Калиста и союзник, связанный с ней Клятвой верности , применяют автоатаки к одному и тому же врагу, она наносит ему магический урон в размере {{ maxhealthdamage*100 }}% от максимального запаса здоровья . Перезарядка эффекта для каждой цели – {{ pertargetcooldown }} сек. Он наносит не более {{ maximummonsterdamage }} урона целям, не являющимся чемпионами. Активно: Калиста выпускает призрака, который делает три круга по указанной области. Замеченные им чемпионы раскрываются на 4 сек. У этого умения может быть до 2 зарядов (новый заряд дается раз в {{ ammorechargetooltip }} сек.).{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Shaco_R">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Shaco_R</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Галлюцинация</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Shaco"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Shaco:R</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Шако создает рядом с собой свою иллюзию, которая может атаковать ближайших противников (наносит меньше урона башням). После смерти она взрывается, оставляя после себя три Шута из коробки и нанося урон ближайшим врагам.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Шако ненадолго исчезает, после чего появляется вместе со своим клоном. Клон существует {{ clonelifetime }} сек., а после смерти взрывается, нанося врагам {{ explosiontotaldamage }} магического урона и оставляя после себя три маленьких Шута из коробки , которые срабатывают мгновенно. Клон наносит {{ cloneaadamagepercent*100 }}% от урона Шако и получает на {{ cloneincomingdamagepercent*100 }}% больше урона. Маленькие Шуты из коробки наносят {{ aoedamage }} магического урона ({{ stdamage }} урона , если враг один) и пугают врагов на {{ boxfearduration }} сек. {{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Source_Azir">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#SourceDocument"/>
    <rdfs:label>Source_Azir</rdfs:label>
    <lol:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://ddragon.leagueoflegends.com/cdn/16.20.1/data/ru_RU/champion/Azir.json</lol:sourceURL>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Veigar_R">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Veigar_R</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Большой взрыв</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Veigar"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Veigar:R</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Вейгар поражает вражеского чемпиона, нанося большое количество магического урона, дополнительно увеличенное от недостающего запаса здоровья цели.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Вейгар поражает вражеского чемпиона первобытной магией, нанося ему от {{ mindamage }} до {{ maxdamage }} магического урона в зависимости от недостающего здоровья. Максимальный урон достигается при 33% здоровья.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Braum_R">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Braum_R</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ледниковый разлом</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Braum"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Braum:R</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Браум бьет щитом по земле, создавая мощный и дальнобойный направленный удар. Пораженные враги подбрасываются в воздух, получают урон и замедляются.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Браум бьет по земле, создавая перед собой разлом, который подбрасывает врагов на своем пути и около Браума, а также наносит им {{ totaldamage }} магического урона . Первая пораженная цель подбрасывается на {{ minknockup }}-{{ maxknockup }} сек. в зависимости от расстояния до Браума. Все остальные пораженные враги подбрасываются на {{ minknockup }} сек. Разлом также создает ледяную область на {{ slowzoneduration }} сек., которая замедляет на {{ movespeedmod }}%. {{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Sona">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#Champion"/>
    <rdfs:label>Sona</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Сона</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Sona"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sona</lol:entityId>
    <lol:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Виртуоз струн</lol:title>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
    <lol:resourceType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Мана</lol:resourceType>
    <lol:baseHP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">550.0</lol:baseHP>
    <lol:baseMP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">340.0</lol:baseMP>
    <lol:baseArmor rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">26.0</lol:baseArmor>
    <lol:baseAttackDamage rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">49.0</lol:baseAttackDamage>
    <lol:baseMoveSpeed rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">325.0</lol:baseMoveSpeed>
    <lol:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Support"/>
    <lol:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Mage"/>
    <lol:reviewStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">effects_not_reviewed</lol:reviewStatus>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Sona_P"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Sona_Q"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Sona_W"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Sona_E"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Sona_R"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Source_Poppy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#SourceDocument"/>
    <rdfs:label>Source_Poppy</rdfs:label>
    <lol:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://ddragon.leagueoflegends.com/cdn/16.20.1/data/ru_RU/champion/Poppy.json</lol:sourceURL>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Taric_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Taric_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Бастион</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Taric"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Taric:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пассивно увеличивает броню Тарика и союзника, на которого наложен Бастион. При активации умения Тарик накладывает Бастион на союзного чемпиона, укрывая его от урона щитом. Бастион остается на союзнике до тех пор, пока чемпионы не разойдутся достаточно далеко, чтобы разорвать связь. Все умения Тарика одновременно используются и им, и союзником с Бастионом.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пассивно: броня Тарика выше на {{ bonusarmor }} ; он поддерживает связь между собой и союзником, помеченным этим умением. Пока они друг около друга, все умения Тарика одновременно использует и он, и этот союзник, а броня союзника выше на {{ bonusarmor }} . Активно: Тарик помечает союзного чемпиона, накладывая на него щит прочностью {{ shieldhpratio }}% от макс. здоровья на {{ shieldduration }} сек.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Varus_E">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Varus_E</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Град стрел</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Varus"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Varus:E</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">E</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Варус поражает указанную область градом стрел, оскверняя ее и нанося физический урон всем врагам в ее пределах. Кроме того, при нахождении на оскверненной земле скорость передвижения врагов уменьшается, а все эффекты самолечения ослабляются.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Варус поражает указанную область градом стрел, оскверняя ее на {{ groundduration }} сек. Враги внутри получают {{ totaldamage }} ед. физ. урона и Страшные раны ({{ grievousamount*100 }}%), а также замедляются на {{ slowpercent*-100 }}%.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Source_Fiddlesticks">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#SourceDocument"/>
    <rdfs:label>Source_Fiddlesticks</rdfs:label>
    <lol:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://ddragon.leagueoflegends.com/cdn/16.20.1/data/ru_RU/champion/Fiddlesticks.json</lol:sourceURL>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Olaf_E">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Olaf_E</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Безрассудный замах</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Olaf"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Olaf:E</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">E</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Олаф атакует с такой силой, что наносит чистый урон как своей цели, так и самому себе, однако восстанавливает потраченное здоровье, если убьет цель.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Олаф яростно взмахивает топорами, нанося цели {{ totaldamage }} чистого урона . Если враг погибает, затраты на это умение компенсируются. Автоатаки сокращают перезарядку этого умения на 1 сек. (или на 2 сек., если цель – монстр).{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Sivir_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Sivir_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Рикошет</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Sivir"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sivir:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Следующие несколько автоатак Сивир поразят рикошетом дополнительные цели, нанеся им уменьшенный урон. Кроме того, скорость этих атак будет увеличена.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Сивир усиливается на {{ buffduration }} сек., увеличивая свою скорость атаки на {{ ricochetattackspeed*100 }}% . В течение этого времени ее автоатаки поражают рикошетом дополнительные цели, нанося им {{ bouncedamage }} физического урона (максимальное количество отскоков: {{ maxbounces }}). Если автоатака была критической, отскоки тоже наносят критический урон.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Xayah_R">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Xayah_R</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Перьевая буря</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Xayah"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Xayah:R</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Шая взмывает в воздух, становясь недоступной для выбора в качестве цели, и швыряет веер кинжалов, оставляющих после себя перья, которые она может призвать к себе.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Шая взмывает в воздух, становясь недосягаемой и призрачной на 1.5 сек. Затем она бросает вниз кинжалы, которые наносят {{ damage }} физического урона и оставляют ряд перьев .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Draven_E">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Draven_E</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Расходимся!</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Draven"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Draven:E</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">E</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Дрейвен бросает свои топоры, которые наносят физический урон, отбрасывают в сторону и замедляют всех врагов на своем пути.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Дрейвен бросает свои топоры боком, нанося {{ totaldamage }} ед. физ. урона врагам, а также отбрасывая их и замедляя на {{ slowamount }}% на {{ slowduration }} сек.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Seraphine_R">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Seraphine_R</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Исполнение на бис</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Seraphine"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Seraphine:R</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Серафина очаровывает пораженных врагов и наносит им урон. Когда заряд касается союзного или вражеского чемпиона, дальность полета обновляется.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Серафина начинает выступление, выпуская волну, которая очаровывает врагов на {{ rchannelduration }} сек. и наносит {{ r1totaldamage }} магического урона . Все затронутые чемпионы (включая союзников) становятся частью выступления, увеличивая дальность полета волны. Союзные чемпионы при этом получают максимальное количество нот .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Yasuo_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Yasuo_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Стальная буря</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Yasuo"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Yasuo:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ясуо делает выпад вперед, нанося урон всем врагам на прямой линии. При попадании создает один заряд Надвигающегося шторма на несколько секунд. После создания 2 зарядов Стальная буря выпускает вихрь, который подбрасывает врагов. Стальная буря приравнивается к автоатаке и масштабируется так же, как и автоатака.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ясуо делает выпад, нанося {{ totaldamage }} физического урона . Если Ясуо поражает врага, он получает заряд на {{ gatheringstormduration }} сек. Когда у Ясуо накапливается 2 заряда, при следующем применении этого умения он выпускает вихрь, который наносит такой же урон и подбрасывает врагов на {{ knockupdurationtooltiponly }} сек. При применении во время рывка умение бьет по кругу, а не по прямой.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Karma_E_MovementSpeedBoost_Ally">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#AbilityEffect"/>
    <rdfs:label>Karma_E_MovementSpeedBoost_Ally</rdfs:label>
    <lol:hasMechanic rdf:resource="https://example.org/lol-ontology#MovementSpeedBoost"/>
    <lol:hasTargetType rdf:resource="https://example.org/lol-ontology#Ally"/>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Karma"/>
    <lol:conditionText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Союзник получает Воодушевление; усиление Мантрой распространяет эффект на ближайших союзников.</lol:conditionText>
    <lol:evidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Карма защищает союзника щитом, поглощающим урон и увеличивающим его скорость передвижения. Эффект Мантры: щит излучает энергию, которая увеличивает его прочность и накладывает Воодушевление на ближайших союзных чемпионов.</lol:evidenceText>
    <lol:evidenceField rdf:datatype="http://www.w3.org/2001/XMLSchema#string">description_text</lol:evidenceField>
    <lol:reviewStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">reviewed_by_assistant</lol:reviewStatus>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Viktor_R">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Viktor_R</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Вихрь аркейна</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Viktor"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Viktor:R</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Виктор создает в указанной области вихрь аркейна, нанося магический урон и прерывая вражеские умения. Вихрь периодически наносит магический урон всем врагам поблизости, и Виктор может управлять его передвижением. Улучшение: вихрь перемещается на 25% быстрее. Когда погибает чемпион, получивший урон от вихря, он вырастает в размере и у него увеличивается продолжительность действия.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Виктор создает в выбранной области вихрь аркейна на {{ stormduration }} сек., мгновенно нанося пораженным врагам {{ initialburstdamage }} магического урона . После этого вихрь наносит окружающим врагам {{ subsequentburstdamage }} магического урона в секунду. Вихрь автоматически следует за чемпионами, которым он недавно нанес урон. Повторное применение: Виктор перемещает вихрь в указанное место. Улучшение: вихрь перемещается на {{ augmentboost*100 }}% быстрее. Когда погибает чемпион, получивший урон от вихря, он вырастает в размере, а его продолжительность действия увеличивается на {{ tooltip_durationextension }} сек. (до {{ maxgrowths }} раз). {{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#JarvanIV_P">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
    <rdfs:label>JarvanIV_P</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Поступь войны</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_JarvanIV"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">JarvanIV:P</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">При первой автоатаке Джарван IV наносит врагу дополнительный физический урон, который зависит от текущего здоровья цели. В отношении одной и той же цели этот эффект может возникать не чаще одного раза в несколько секунд.</lol:description>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Source_Aphelios">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#SourceDocument"/>
    <rdfs:label>Source_Aphelios</rdfs:label>
    <lol:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://ddragon.leagueoflegends.com/cdn/16.20.1/data/ru_RU/champion/Aphelios.json</lol:sourceURL>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Gwen_R">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Gwen_R</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Вышивание</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Gwen"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gwen:R</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Гвен выпускает перед собой иголку, которая замедляет врагов, наносит магический урон и накладывает на пораженных чемпионов эффект Тысячи порезов. Это умение можно применить еще два раза – при каждой повторной активации Гвен выпускает больше иголок и наносит увеличенный урон.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Первое применение: Гвен выпускает перед собой иголку, которая наносит {{ totaldamage }} магического урона , замедляет на {{ initialslow*-100 }}% на {{ debuffduration }} сек. и накладывает эффект Тысячи порезов на всех пораженных врагов. Гвен может повторно применить это умение до 2 раз в течение 6 сек. (перезарядка между применениями - {{ lockouttime }} сек.). Второе применение: Гвен выпускает перед собой 3 иголки, которые наносят {{ totaldamage3 }} магического урона . Третье применение: Гвен выпускает перед собой 5 иголок, которые наносят {{ totaldamage5 }} магического урона .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Kayn_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Kayn_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Смертельный росчерк</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Kayn"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Kayn:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Каин делает рывок, а затем совершает удар. И то, и другое наносит урон.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Каин совершает рывок, нанося врагам на пути {{ totaldamage }} физического урона , а затем бьет косой по кругу, нанося врагам поблизости такой же урон. Даркин-душегуб: умение наносит физический урон в размере {{ darkinflatdamage }} плюс {{ darkinpercentdamage }} от максимального запаса здоровья .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Kindred">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#Champion"/>
    <rdfs:label>Kindred</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Киндред</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Kindred"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Kindred</lol:entityId>
    <lol:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Вечные охотники</lol:title>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
    <lol:resourceType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Мана</lol:resourceType>
    <lol:baseHP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">595.0</lol:baseHP>
    <lol:baseMP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">300.0</lol:baseMP>
    <lol:baseArmor rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">29.0</lol:baseArmor>
    <lol:baseAttackDamage rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">65.0</lol:baseAttackDamage>
    <lol:baseMoveSpeed rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">325.0</lol:baseMoveSpeed>
    <lol:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Marksman"/>
    <lol:reviewStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">effects_not_reviewed</lol:reviewStatus>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Kindred_P"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Kindred_Q"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Kindred_W"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Kindred_E"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Kindred_R"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Ahri_E">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Ahri_E</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Очарование</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Ahri"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ahri:E</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">E</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ари посылает воздушный поцелуй, который наносит магический урон и очаровывает врага, мгновенно останавливая умения перемещения и заставляя его завороженно идти по направлению к ней.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ари посылает воздушный поцелуй, который очаровывает первого пораженного врага на {{ charmduration }} сек. и наносит ему {{ totaldamage }} магического урона .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Malphite_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Malphite_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Сейсмический осколок</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Malphite"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Malphite:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Мальфит выпускает во врага осколок скалы, нанося ему урон и похищая у него часть скорости передвижения на 3 сек.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Мальфит выпускает во врага осколок скалы, нанося ему {{ qdamagecalc }} ед. маг. урона и замедляя его на {{ speedsteal }}% на {{ slowduration }} сек. Также Мальфит на {{ slowduration }} сек. повышает свою скорость передвижения на величину замедления врага.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#JarvanIV">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#Champion"/>
    <rdfs:label>JarvanIV</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Джарван IV</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_JarvanIV"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">JarvanIV</lol:entityId>
    <lol:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Воплощение Демасии</lol:title>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
    <lol:resourceType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Мана</lol:resourceType>
    <lol:baseHP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">640.0</lol:baseHP>
    <lol:baseMP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">300.0</lol:baseMP>
    <lol:baseArmor rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">36.0</lol:baseArmor>
    <lol:baseAttackDamage rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">64.0</lol:baseAttackDamage>
    <lol:baseMoveSpeed rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">340.0</lol:baseMoveSpeed>
    <lol:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Fighter"/>
    <lol:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Tank"/>
    <lol:reviewStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">effects_not_reviewed</lol:reviewStatus>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#JarvanIV_P"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#JarvanIV_Q"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#JarvanIV_W"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#JarvanIV_E"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#JarvanIV_R"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Ornn_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Ornn_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Дыхание вулкана</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Ornn"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ornn:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Орн наступает, извергая пламя. Враги, пораженные последней порцией пламени, становятся хрупкими.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Орн неудержимо движется вперед, извергая пламя и нанося магический урон в размере {{ maxpercenthpperticktooltip }}% от максимального запаса здоровья в течение {{ breathduration }} сек. Враги, пораженные последней порцией пламени, становятся хрупкими на {{ brittleduration }} сек. Следующий эффект обездвиживания против хрупкого врага будет длиться на 30% дольше и нанесет магический урон в размере {{ brittlepercentmaxhpcalc }} от максимального запаса здоровья . Автоатаки Орна против хрупких целей отбрасывают их и наносят дополнительный урон.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Rumble_P">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
    <rdfs:label>Rumble_P</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Титан со свалки</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Rumble"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Rumble:P</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">При использовании Рамблом умений возникает нагрев. Когда нагрев достигает 50, Рамбл попадает в Опасную зону и его базовые умения усиливаются. Когда нагрев достигает 100, происходит перегрев и Рамбл не может использовать свои умения в течение нескольких секунд, пока не остынет, но его скорость атаки увеличивается, а автоатаки наносят дополнительный урон.</lol:description>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Ashe_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Ashe_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Залп</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Ashe"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ashe:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Эш выпускает веер из стрел, нанося увеличенный урон. Умение также накладывает эффект Морозного выстрела.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Эш выпускает веер из {{ numberofarrowstooltip }} стрел, каждая из которых наносит {{ totaldamage }} физического урона . Врагов могут поразить нескольких стрел, но урон им нанесет только первая.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Sona_P">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
    <rdfs:label>Sona_P</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Мощный аккорд</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Sona"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sona:P</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Аччелерандо : успешно применяя умения, Сона получает заряды, которые навсегда увеличивают ускорение базовых умений. После накопления максимального числа зарядов успешные применения умений сокращают оставшуюся перезарядку ее абсолютного умения. Мощный аккорд : после нескольких применений умений следующая автоатака Соны усиливается: она наносит дополнительный магический урон и имеет бонусный эффект, зависящий от умения, которое Сона использовала последним.</lol:description>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Taliyah_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Taliyah_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Плетеный залп</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Taliyah"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Taliyah:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Талия выпускает в выбранном направлении залп из камней и не утрачивает при этом способность передвигаться. Земля в этой области становится разработанной. Если Талия вновь использует Плетеный залп на разработанной земле, та исчезает, а Талия выпускает один большой камень, который замедляет врагов.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Талия бросает 5 камней. Каждый наносит {{ rockdamage }} ед. маг. урона в области вокруг 1-го пораженного врага. Земля в этой области становится разработанной. Последующие попадания по тому же врагу наносят на {{ extramissilereduceddamagepercent }}% меньше урона. При применении этого умения на разработанной земле оно расходует {{ bigrockmanacost }} маны, а его перезарядка сокращается на {{ workedgroundcdr*100 }}%. Земля перестает быть разработанной, а Талия бросает большой камень, замедляющий пораженных врагов на {{ slowpercent*100 }}% на {{ slowduration }} сек. и наносящий {{ bigrockdamage }} ед. маг. урона основной цели. Монстры, пораженные большим камнем, оглушаются на {{ monsterstunduration }} сек.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Trundle">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#Champion"/>
    <rdfs:label>Trundle</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Трандл</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Trundle"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Trundle</lol:entityId>
    <lol:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Король троллей</lol:title>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
    <lol:resourceType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Мана</lol:resourceType>
    <lol:baseHP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">650.0</lol:baseHP>
    <lol:baseMP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">340.0</lol:baseMP>
    <lol:baseArmor rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">37.0</lol:baseArmor>
    <lol:baseAttackDamage rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">68.0</lol:baseAttackDamage>
    <lol:baseMoveSpeed rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">350.0</lol:baseMoveSpeed>
    <lol:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Fighter"/>
    <lol:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Tank"/>
    <lol:reviewStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">effects_not_reviewed</lol:reviewStatus>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Trundle_P"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Trundle_Q"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Trundle_W"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Trundle_E"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Trundle_R"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Gangplank_R">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Gangplank_R</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пушечный обстрел</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Gangplank"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gangplank:R</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Гангпланк дает сигнал своему судну вести обстрел указанной области. Все противники в зоне обстрела замедляются и получают урон.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Гангпланк дает сигнал своему судну на протяжении {{ zoneduration }} сек. вести обстрел любой выбранной области на карте, накрыв ее {{ totalwavestooltip }} волнами ядер. Каждая волна замедляет врагов на {{ slowpercent }}% на {{ slowduration }} сек. и наносит {{ onewavedamage }} магического урона . Максимальный урон: {{ totaldamagetooltip }}. Это умение можно улучшать в магазине с помощью умения Аррргумент . Стрельба по готовности : судно Гангпланка выпускает 6 дополнительных волн ядер. Дочь смерти : судно Гангпланка выпускает мегаядро, которое наносит {{ deathsdaughterdamage }} чистого урона и замедляет на {{ deathsdaughterslow }}% на {{ deathsdaughterslowduration }} сек. Боевой дух : скорость передвижения союзников в области обстрела увеличивается на {{ raisemoralehaste }}% на {{ raisemoralehasteduration }} сек.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Cassiopeia_E">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Cassiopeia_E</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Два клыка</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Cassiopeia"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cassiopeia:E</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">E</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Кассиопея запускает во врага клыки, нанося увеличенный урон отравленным врагам и восстанавливая здоровье на величину, равную доле от нанесенного урона. Если цель умирает, Кассиопея получает обратно затраченную ману.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Кассиопея выпускает смертоносные шипы, которые наносят {{ basicdamage }} магического урона . Если враг отравлен , он дополнительно получает {{ bonuspoisoneddamage }} магического урона , а Кассиопея восстанавливает себе {{ healcalc }} здоровья . Если цель – миньон с линии или небольшой монстр, эффективность лечения уменьшается до {{ healcalcminion }} . Если это умение убивает цель, Кассиопея восстанавливает себе {{ cost }} маны . {{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Mordekaiser_P">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
    <rdfs:label>Mordekaiser_P</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Восхождение тьмы</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Mordekaiser"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mordekaiser:P</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Мордекайзер получает ауру, наносящую большой урон, и ускоряется после попадания 3 атаками или умениями по чемпионам или монстрам.</lol:description>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Source_Illaoi">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#SourceDocument"/>
    <rdfs:label>Source_Illaoi</rdfs:label>
    <lol:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://ddragon.leagueoflegends.com/cdn/16.20.1/data/ru_RU/champion/Illaoi.json</lol:sourceURL>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Xerath_P">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
    <rdfs:label>Xerath_P</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Всплеск маны</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Xerath"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Xerath:P</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Автоатаки Зерата периодически восстанавливают ману. Когда Зерат убивает бойца, у этого умения сокращается перезарядка.</lol:description>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Lux_E_Damage_Enemy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#AbilityEffect"/>
    <rdfs:label>Lux_E_Damage_Enemy</rdfs:label>
    <lol:hasMechanic rdf:resource="https://example.org/lol-ontology#Damage"/>
    <lol:hasTargetType rdf:resource="https://example.org/lol-ontology#Enemy"/>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Lux"/>
    <lol:conditionText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Враг находится в зоне поражения при взрыве; взрыв по таймеру или повторному применению.</lol:conditionText>
    <lol:evidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Люкс создает световую аномалию, замедляющую на {{ slowpercent }}% и раскрывающую область под собой. Через {{ slowzoneduration }} сек. или при повт. применении этого умения аномалия взрывается, нанося {{ totaldamagett }} ед. маг. урона и замедляя еще на {{ slowlingerduration }} сек.{{ spellmodifierdescriptionappend }}</lol:evidenceText>
    <lol:evidenceField rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tooltip_text</lol:evidenceField>
    <lol:reviewStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">reviewed_by_assistant</lol:reviewStatus>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Sona_R">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Sona_R</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Крещендо</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Sona"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sona:R</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Сона исполняет свой лучший аккорд, оглушая вражеских чемпионов, заставляя их танцевать и нанося им магический урон.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Сона исполняет свой лучший аккорд, оглушая врагов на {{ stunduration }} сек. и нанося им {{ totaldamage }} магического урона .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Swain_E">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Swain_E</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Недвижность</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Swain"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Swain:E</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">E</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Свейн выпускает вперед волну демонической энергии. После этого она возвращается, обездвиживая пораженных врагов. Свейн может подтянуть всех обездвиженных чемпионов к себе. Во время действия Демонического возвышения у этого умения сокращена перезарядка.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Свейн выпускает волну демонической энергии, которая затем возвращается к нему, взрываясь при столкновении с первым пораженным врагом. При этом она наносит {{ secondarydamage }} магического урона противникам поблизости и обездвиживает их на {{ rootduration }} сек. Обездвижив чемпиона, Свейн может повторно применить это умение, чтобы подтянуть к себе всех чемпионов, обездвиженных Недвижностью , и вырвать у каждого фрагмент души .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Azir_P">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
    <rdfs:label>Azir_P</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Наследие Шуримы</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Azir"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Azir:P</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Азир может установить солнечный диск на развалинах союзной или вражеской башни.</lol:description>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Source_Malzahar">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#SourceDocument"/>
    <rdfs:label>Source_Malzahar</rdfs:label>
    <lol:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://ddragon.leagueoflegends.com/cdn/16.20.1/data/ru_RU/champion/Malzahar.json</lol:sourceURL>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Source_Pyke">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#SourceDocument"/>
    <rdfs:label>Source_Pyke</rdfs:label>
    <lol:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://ddragon.leagueoflegends.com/cdn/16.20.1/data/ru_RU/champion/Pyke.json</lol:sourceURL>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Morgana_E">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Morgana_E</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Черный щит</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Morgana"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Morgana:E</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">E</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Моргана защищает союзника защитным барьером из звездного огня, который поглощает магический урон и эффекты контроля, пока не будет уничтожен.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Моргана накладывает на союзного чемпиона щит от магии прочностью {{ totalshieldstrength }} на {{ shieldduration }} сек. Этот щит блокирует нейтрализующие и обездвиживающие эффекты.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
    <lol:hasEffect rdf:resource="https://example.org/lol-ontology#Morgana_E_Shield_Ally"/>
    <lol:hasEffect rdf:resource="https://example.org/lol-ontology#Morgana_E_ControlImmunity_Ally"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Quinn_P">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
    <rdfs:label>Quinn_P</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Хищная птица</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Quinn"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Quinn:P</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Демасийский орел Квинн по кличке Вэлор периодически помечает врагов меткой Хищной птицы . 1-я автоатака Квинн против целей с меткой Хищной птицы наносит доп. физ. урон.</lol:description>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Rumble_E">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Rumble_E</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Электрогарпун</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Rumble"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Rumble:E</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">E</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Рамбл стреляет электрогарпуном, который наносит магический урон, замедляет и уменьшает сопротивление магии. Рамбл может иметь в запасе до 2 гарпунов. Если Рамбл находится в Опасной зоне, урон и замедление увеличиваются.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Рамбл стреляет электрическим гарпуном, который наносит {{ totaldamage }} магического урона , замедляет на {{ baseslowamount }}% на {{ slowduration }} сек. и снижает сопротивление магии на {{ percmagicpen*100 }}% на {{ shredduration }} сек. При поражении врага, который уже замедлен этим умением, эффективность замедления повышается до {{ empoweredslowamount }}%, а также у цели снижается сопротивление магии на {{ enhancedmagicpen*100 }}%. Опасная зона: урон от гарпуна увеличивается до {{ empdamage }} , а эффективность замедления и снижения сопротивления магии – на 50%.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Veigar_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Veigar_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Темная материя</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Veigar"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Veigar:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Вейгар вызывает сгусток темной материи, который падает с неба, нанося магический урон всем врагам в зоне поражения. Заряды Невероятного зла сокращают перезарядку Темной материи.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Вейгар обрушивает с неба темную материю, нанося {{ totaldamage }} магического урона . Каждые {{ spell.veigarpassive:pstacksperdarkmattercdr }} зарядов Невероятного зла сокращают перезарядку этого умения на {{ spell.veigarpassive:darkmattercdrincrement*100 }}%.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Source_Elise">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#SourceDocument"/>
    <rdfs:label>Source_Elise</rdfs:label>
    <lol:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://ddragon.leagueoflegends.com/cdn/16.20.1/data/ru_RU/champion/Elise.json</lol:sourceURL>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Rakan_P">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
    <rdfs:label>Rakan_P</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Шальные перья</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Rakan"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Rakan:P</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Вокруг Рэйкана периодически появляется щит.</lol:description>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Taliyah_R">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Taliyah_R</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Стена Пряхи</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Taliyah"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Taliyah:R</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Талия создает очень длинную стену, затем скользит по ней.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Талия создает длинную земляную стену на {{ wallduration }} сек. Если Талия сразу повторно применяет это умение, она начинает перемещаться с растущей стеной. При передвижении или обездвиживании она спрыгивает со стены. Это умение нельзя применять в течение {{ damagelockouttime }} сек. после получения урона от чемпионов или строений.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Ambessa_E">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Ambessa_E</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Истязание</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Ambessa"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ambessa:E</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">E</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Амбесса совершает круговой удар драконьими гончими, нанося урон врагам вокруг нее и замедляя их. Если это умение активирует Поступь драконьей гончей, она совершает второй удар по окончании рывка.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Амбесса совершает круговой удар цепями, нанося врагам {{ calc_damage_flat }} физического урона и замедляя их на {{ slow_amount*100 }}% (замедление ослабевает в течение {{ slow_duration }} сек.). Если это умение активирует Поступь драконьей гончей , Амбесса совершает еще один удар.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Samira_R">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Samira_R</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Адское пекло</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Samira"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Samira:R</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Самира безостановочно палит из своих пистолетов, расстреливая всех врагов вокруг.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Самира может применить это умение, только если ее оценка стиля – S. Это умение поглощает весь заработанный стиль . Самира осыпает градом пуль всех врагов вокруг до 10 раз в течение 2 сек. Каждый выстрел наносит {{ damagecalc }} ед. физического урона , и на него действует вампиризм с эффективностью {{ lifestealmod*100 }}%. Кроме того, каждый выстрел может быть критическим.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#TwistedFate_P">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
    <rdfs:label>TwistedFate_P</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Шулерские кости</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_TwistedFate"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TwistedFate:P</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">После убийства бойца Твистед Фэйт кидает свои ''счастливые'' кости и получает дополнительно от 1 до 6 золота.</lol:description>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Shield">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#Mechanic"/>
    <rdfs:label>Shield</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Щит</lol:name>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Fiora_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Fiora_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Парирование</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Fiora"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fiora:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">В течение короткого времени Фиора парирует весь входящий урон и игнорирует эффекты контроля, а затем совершает атаку в выбранном направлении. Атака уменьшает скорость передвижения пораженного чемпиона или оглушает его, если Фиора отражает обездвиживающий эффект контроля.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Фиора парирует весь входящий урон, а также нейтрализующие и отрицательные эффекты в течение {{ parryduration }} сек., после чего совершает атаку. Атака наносит {{ stabdamage }} магического урона первому пораженному чемпиону, а также замедляет его на {{ msslowpercent*-100 }}% и уменьшает его скорость атаки на {{ attackslowpercent*-100 }}% на {{ ccduration }} сек. Если Фиора отражает обездвиживающий эффект, враг оглушается , а не замедляется .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Orianna_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Orianna_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Приказ: Диссонанс</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Orianna"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Orianna:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Орианна приказывает своему шару выпустить импульс энергии, который наносит магический урон всем врагам вокруг и оставляет после себя поле, ускоряющее союзников и замедляющее врагов.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Орианна приказывает своему шару выпустить импульс энергии, который наносит {{ totaldamage }} магического урона окружающим врагам. Импульс на {{ fieldduration }} сек. оставляет после себя энергетическое поле, замедляющее врагов на {{ slowamount*100 }}% и увеличивающее скорость передвижения союзников на {{ hasteamount*100 }}% (эффект ослабевает в течение {{ slowandhasteduration }} сек.).{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Sion_R">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Sion_R</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Неудержимое наступление</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Sion"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sion:R</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Сион несется в указанном направлении, набирая скорость с течением времени. Он может незначительно менять направление своего движения, следуя за указателем мыши. При столкновении с врагом Сион наносит ему урон и подбрасывает в воздух (величина урона и продолжительность подбрасывания растут с увеличением расстояния, преодоленного Сионом).</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Сион становится неудержимым и несется в выбранном направлении в течение 8 сек., поворачивая в сторону курсора мыши. Сион останавливается при столкновении с вражеским чемпионом или стеной, а также при повторном применении этого умения. После остановки Сион наносит {{ mindamagetotal }}-{{ maxdamagetotal }} физического урона в зависимости от преодоленного расстояния. Враги около Сиона оглушаются на {{ minstunduration }}-{{ maxstunduration }} сек. в зависимости от преодоленного расстояния. Враги в большей области замедляются на {{ slowamount }}% на 3 сек.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Nunu_P">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
    <rdfs:label>Nunu_P</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Зов Фрельйорда</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Nunu"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nunu:P</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Нуну увеличивает скорость атаки и скорость передвижения Виллумпа и союзника поблизости. Кроме того, автоатаки Виллумпа начинают наносить урон врагам рядом с целью.</lol:description>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Leona_P">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
    <rdfs:label>Leona_P</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Сияние солнца</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Leona"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Leona:P</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Вместе с полученным уроном от заклинаний цель помечается Сиянием солнца на 1,5 секунды. Первая в течение этого времени атака союзного чемпиона снимет этот эффект, но нанесет дополнительный магический урон.</lol:description>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Akali_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Akali_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пятиточечный удар</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Akali"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Akali:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Акали бросает пять кунаев, нанося урон в зависимости от дополнительной силы атаки и силы умений, а также замедляя цель.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Акали бросает кунаи по дуге перед собой, нанося {{ damage }} магического урона и замедляя врагов в дальней части области поражения на {{ slowpercentage*100 }}% на {{ slowduration }} сек.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Ziggs_P">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
    <rdfs:label>Ziggs_P</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Вспыльчивость</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Ziggs"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ziggs:P</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Периодически следующая автоатака Зиггса наносит дополнительный магический урон. Использование умений сокращает время перезарядки этого эффекта.</lol:description>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Ivern_P">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
    <rdfs:label>Ivern_P</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Друг леса</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Ivern"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ivern:P</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Иверн не может атаковать никаких монстров, кроме эпических, и они тоже не станут нападать на него. Иверн способен окружать лагери монстров волшебными рощами, которые со временем разрастаются. Когда роща полностью созреет, Иверн может освободить монстров, получив за них опыт и золото.</lol:description>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Ziggs_E">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Ziggs_E</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Минное поле</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Ziggs"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ziggs:E</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">E</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Зиггс разбрасывает мины, взрывающиеся при соприкосновении с врагами, нанося им магический урон и замедляя их. Если цель поражают несколько мин, каждая последующая наносит меньше урона.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Зиггс разбрасывает мины. Они взрываются при соприкосновении с врагами, нанося им {{ totaldamage }} ед. маг. урона и замедляя их на {{ slow*-100 }}% на {{ slowduration }} сек. Мины существуют {{ mineduration }} сек.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Alistar">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#Champion"/>
    <rdfs:label>Alistar</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Алистар</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Alistar"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Alistar</lol:entityId>
    <lol:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Минотавр</lol:title>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
    <lol:resourceType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Мана</lol:resourceType>
    <lol:baseHP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">685.0</lol:baseHP>
    <lol:baseMP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">350.0</lol:baseMP>
    <lol:baseArmor rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">40.0</lol:baseArmor>
    <lol:baseAttackDamage rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">62.0</lol:baseAttackDamage>
    <lol:baseMoveSpeed rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">335.0</lol:baseMoveSpeed>
    <lol:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Tank"/>
    <lol:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Support"/>
    <lol:reviewStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">effects_not_reviewed</lol:reviewStatus>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Alistar_P"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Alistar_Q"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Alistar_W"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Alistar_E"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Alistar_R"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Yorick">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#Champion"/>
    <rdfs:label>Yorick</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Йорик</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Yorick"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Yorick</lol:entityId>
    <lol:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пастух заблудших душ</lol:title>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
    <lol:resourceType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Мана</lol:resourceType>
    <lol:baseHP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">650.0</lol:baseHP>
    <lol:baseMP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">300.0</lol:baseMP>
    <lol:baseArmor rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">36.0</lol:baseArmor>
    <lol:baseAttackDamage rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">62.0</lol:baseAttackDamage>
    <lol:baseMoveSpeed rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">340.0</lol:baseMoveSpeed>
    <lol:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Fighter"/>
    <lol:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Tank"/>
    <lol:reviewStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">effects_not_reviewed</lol:reviewStatus>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Yorick_P"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Yorick_Q"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Yorick_W"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Yorick_E"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Yorick_R"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#SupportControlMage">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>SupportControlMage</rdfs:label>
    <rdfs:comment xml:lang="ru">Маг, способный дать союзнику щит и ограничить передвижение врага. Умения могут быть разными.</rdfs:comment>
    <owl:equivalentClass rdf:nodeID="N40980dc99f4a447e9d53d70dff245310"/>
    <rdfs:subClassOf rdf:resource="https://example.org/lol-ontology#Champion"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Aphelios_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Aphelios_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Фаза</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Aphelios"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Aphelios:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Афелий меняет местами основное и дополнительное оружие, получая новые автоатаки и активируемое умение.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Афелий меняет местами основное и дополнительное оружие, беря в руки Гравитум .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Diana_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Diana_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Бледный каскад</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Diana"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Diana:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Диана создает вокруг себя три вращающиеся сферы, которые взрываются при столкновении с врагами, нанося урон по площади. Кроме того, она получает временный щит, поглощающий урон. Прочность щита увеличивается, когда взрывается третья сфера.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Диана на {{ shieldduration }} сек. создает три сферы, которые вращаются вокруг нее и взрываются при столкновении с врагами. Каждая сфера наносит {{ totaldamage }} магического урона (максимальный общий урон - {{ totalmaxdamage }} ). Диана также получает щит прочностью {{ shieldvalue }} на то же время. Когда взрывается последняя сфера, Диана получает еще один щит прочностью {{ shieldvalue }} , а время его существования обновляется.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Diana_R">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Diana_R</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Притяжение Луны</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Diana"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Diana:R</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Диана раскрывает и притягивает всех врагов поблизости, а также замедляет их. Если Диана притягивает хотя бы одного вражеского чемпиона, через короткое время ее озаряет лунный свет, который наносит магический урон всем врагам вокруг. Урон увеличивается за каждую притянутую цель, кроме первой.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Диана притягивает к себе окружающих врагов, а также замедляет их на {{ slowtooltip }}% и раскрывает на {{ slowduration }} сек. Если Диана поразила хотя бы одного вражеского чемпиона, она взывает к луне и наносит {{ rexplosiondamage }} магического урона плюс еще {{ rmultihitamplification }} за каждого притянутого чемпиона после первого. Максимальный дополнительный урон - {{ maxdamage }} .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Neeko_R">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Neeko_R</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ударный расцвет</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Neeko"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Neeko:R</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">После небольшой подготовки Нико взмывает в воздух, подбрасывая всех ближайших врагов. По приземлении она наносит урон ближайшим врагам и оглушает их. Если Нико замаскирована, враги не видят подготовки умения.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">После небольшой подготовки Нико взмывает в воздух и подбрасывает всех врагов поблизости на {{ delayuntilexplosion }} сек. Затем она обрушивается на землю, нанося противникам вокруг {{ totaldamage }} магического урона и оглушая их на {{ stunduration }} сек. Если Нико замаскирована, враги не видят подготовки умения. Через {{ delaybeforepassiveremoval }} сек. после применения этого умения у Нико пропадает маскировка. {{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Nami_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Nami_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Водяная тюрьма</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Nami"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nami:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Нами посылает пузырь в указанную область, нанося урон всем врагам в зоне поражения и оглушая их.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Нами выпускает пузырь, оглушая врагов на {{ stunduration }} сек. и нанося им {{ totaldamagett }} ед. маг. урона .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#MageChampion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>MageChampion</rdfs:label>
    <rdfs:comment xml:lang="ru">Чемпион с категорией Mage; классифицируется ризонером.</rdfs:comment>
    <owl:equivalentClass rdf:nodeID="Nd93108654fe24423b95488dfe70771f0"/>
    <rdfs:subClassOf rdf:resource="https://example.org/lol-ontology#Champion"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Source_Lissandra">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#SourceDocument"/>
    <rdfs:label>Source_Lissandra</rdfs:label>
    <lol:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://ddragon.leagueoflegends.com/cdn/16.20.1/data/ru_RU/champion/Lissandra.json</lol:sourceURL>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Karma_Q_Slow_Enemy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#AbilityEffect"/>
    <rdfs:label>Karma_Q_Slow_Enemy</rdfs:label>
    <lol:hasMechanic rdf:resource="https://example.org/lol-ontology#Slow"/>
    <lol:hasTargetType rdf:resource="https://example.org/lol-ontology#Enemy"/>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Karma"/>
    <lol:conditionText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Попадание сгустком энергии; замедление целей, указанных в tooltip.</lol:conditionText>
    <lol:evidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Карма выпускает сгусток энергии, нанося {{ totaldamage }} магического урона первой пораженной цели и окружающим врагам, а также замедляя их на {{ slowamount*-100 }}% на {{ slowduration }} сек.{{ spellmodifierdescriptionappend }}</lol:evidenceText>
    <lol:evidenceField rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tooltip_text</lol:evidenceField>
    <lol:reviewStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">reviewed_by_assistant</lol:reviewStatus>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Illaoi_R">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Illaoi_R</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Прыжок веры</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Illaoi"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Illaoi:R</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Иллаой прыгает в воздух и швыряет своего идола на землю, нанося физический урон всем окружающим врагам и призывая по щупальцу за каждого пораженного вражеского чемпиона.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Иллаой прыгает в воздух и швыряет своего идола на землю, нанося {{ damagecalc }} ед. физического урона врагам поблизости и призывая по щупальцу за каждого пораженного вражеского чемпиона. В течение следующих {{ duration }} сек. щупальца атакуют на 50% быстрее. При этом они недосягаемы, а время перезарядки Жестокого урока составляет {{ spell.illaoiw:cooldownduringr }} сек.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#ControlImmunity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#Mechanic"/>
    <rdfs:label>ControlImmunity</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Защита от эффектов контроля</lol:name>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Shen_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Shen_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Сумеречная атака</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Shen"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Shen:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Шен призывает призрачный клинок, после чего его следующие автоатаки наносят урон, зависящий от максимального запаса здоровья цели. Если клинок на своем пути к Шену задевает вражеского чемпиона, автоатаки дополнительно существенно усиливаются, а задетый чемпион замедляется при попытке убежать от Шена.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Шен призывает к себе призрачный клинок . Пораженные враги замедляются на {{ slowpercent }}% при движении от Шена в течение следующих {{ slowduration }} сек. Кроме того, следующие автоатаки ({{ numenhancedattacks }}) Шена дополнительно наносят маг. урон в размере {{ baseflatdamage }} плюс {{ basepercenthealth }} от макс. здоровья . Если призрачный клинок задел вражеского чемпиона, урон растет до {{ baseflatdamage }} плюс {{ emppercenthealth }} от макс. здоровья , а скорость усиленных автоатак Шена растет на {{ steroidas }}% .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Shen_P">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
    <rdfs:label>Shen_P</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Барьер Ци</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Shen"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Shen:P</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">После применения умения Шен получает щит. Если умение оказывает воздействие на союзного или вражеского чемпиона, время перезарядки Барьера Ци сокращается.</lol:description>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Taliyah_E">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Taliyah_E</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Вздыбленная земля</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Taliyah"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Taliyah:E</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">E</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Талия создает замедляющее поле из каменных глыб. Задевая эти глыбы во время рывка или отбрасывания, враги взрывают их и оглушаются.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Талия создает поле из камней, которые замедляют пораженных врагов на {{ slowpercent*100 }}% и наносят им {{ scatterdamage }} магического урона . Задевая камни во время рывка или отбрасывания , враги взрывают их. При этом они оглушаются на время, равное оставшейся продолжительности перемещения плюс {{ stunduration }} сек., и получают {{ detonationdamage }} магического урона .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Source_Viego">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#SourceDocument"/>
    <rdfs:label>Source_Viego</rdfs:label>
    <lol:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://ddragon.leagueoflegends.com/cdn/16.20.1/data/ru_RU/champion/Viego.json</lol:sourceURL>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Karthus_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Karthus_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Опустошение</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Karthus"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Karthus:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Картус производит отложенный взрыв в указанном месте, нанося урон всем ближайшим врагам. Изолированные враги получают больше урона.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Картус создает магический взрыв, который наносит {{ qdamage }} магического урона . Если взрыв поражает только одного врага, он наносит {{ qsingletargetdamage }} магического урона .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Veigar_P">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
    <rdfs:label>Veigar_P</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Невероятная сила зла</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Veigar"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Veigar:P</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Вейгар – самое злейшее создание, когда-либо ступавшее на Рунтерру – и теперь он становится еще злее! Попадание умением по вражескому чемпиону и убийство чемпионов увеличивают силу умений Вейгара.</lol:description>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Sejuani_E">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Sejuani_E</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Вечная мерзлота</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Sejuani"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sejuani:E</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">E</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Седжуани замораживает и оглушает вражеского чемпиона с максимальным количеством зарядов Мороза.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пассивно: автоатаки окружающих союзных чемпионов ближнего боя накладывают заряды на чемпионов и лесных монстров. Активно: Седжуани наносит {{ totaldamage }} ед. маг. урона выбранному врагу с 4 зар. и оглушает его на {{ ccduration }} сек. {{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Belveth_P">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
    <rdfs:label>Belveth_P</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Лиловая смерть </lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Belveth"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Belveth:P</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Участвуя в убийствах чемпионов, больших миньонов и больших монстров, Бел'Вет получает заряды, которые навсегда повышают ее скорость атаки. Кроме того, ее скорость атаки ненадолго повышается после применения умений.</lol:description>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Teemo_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Teemo_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Слепящий дротик</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Teemo"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Teemo:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Тимо ослепляет врага сильным ядом, нанося ему урон и заставляя его некоторое время промахиваться.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Тимо выпускает дротик, ослепляя цель на {{ blindduration }} сек. и нанося ей {{ calculateddamage }} ед. маг. урона .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Source_Mordekaiser">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#SourceDocument"/>
    <rdfs:label>Source_Mordekaiser</rdfs:label>
    <lol:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://ddragon.leagueoflegends.com/cdn/16.20.1/data/ru_RU/champion/Mordekaiser.json</lol:sourceURL>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Annie_R">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Annie_R</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Призыв Тибберса</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Annie"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Annie:R</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Энни призывает своего медведя Тибберса, который будет сражаться на ее стороне и поджигать ближайших врагов. В момент призыва все враги рядом с Тибберсом получают урон.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пассивно: Энни получает {{ rpercentpenbuff*100 }}% маг. пробивания . Энни призывает своего медведя Тибберса, нанося {{ initialburstdamage }} ед. маг. урона . В течение следующих {{ tibberslifetime }} сек. Тибберс обжигает всех врагов поблизости, нанося {{ tibbersauradamage }} ед. маг. урона в секунду . Тибберс впадает в ярость при призыве, а также когда Энни оглушает вражеского чемпиона или погибает. При этом его скорость атаки растет на 275% , а скорость передвижения – на 100% (эффект ослабевает в течение 3 сек.). Повторное применение: Энни отдает Тибберсу новый приказ.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Nasus_P">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
    <rdfs:label>Nasus_P</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пожиратель душ</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Nasus"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nasus:P</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Насус вытягивает духовную энергию врагов, увеличивая свой вампиризм.</lol:description>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Source_KogMaw">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#SourceDocument"/>
    <rdfs:label>Source_KogMaw</rdfs:label>
    <lol:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://ddragon.leagueoflegends.com/cdn/16.20.1/data/ru_RU/champion/KogMaw.json</lol:sourceURL>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Source_Shaco">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#SourceDocument"/>
    <rdfs:label>Source_Shaco</rdfs:label>
    <lol:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://ddragon.leagueoflegends.com/cdn/16.20.1/data/ru_RU/champion/Shaco.json</lol:sourceURL>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Malzahar_P">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
    <rdfs:label>Malzahar_P</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Сдвиг Бездны</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Malzahar"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Malzahar:P</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Если Мальзахар не получает урон или на него не накладывают эффект контроля в течение какого-то времени, он начинает получать значительно меньше урона, а также становится невосприимчивым к эффектам контроля. После получения урона Сдвиг Бездны продолжает действовать еще некоторое время.</lol:description>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Singed_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Singed_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ядовитый след</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Singed"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Singed:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Синджед оставляет позади себя ядовитый след, который наносит урон всем попавшим в него врагам.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Переключение: Синджед оставляет позади себя ядовитый след, который наносит {{ damagepersecond }} магического урона в секунду.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Source_Amumu">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#SourceDocument"/>
    <rdfs:label>Source_Amumu</rdfs:label>
    <lol:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://ddragon.leagueoflegends.com/cdn/16.20.1/data/ru_RU/champion/Amumu.json</lol:sourceURL>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Source_Khazix">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#SourceDocument"/>
    <rdfs:label>Source_Khazix</rdfs:label>
    <lol:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://ddragon.leagueoflegends.com/cdn/16.20.1/data/ru_RU/champion/Khazix.json</lol:sourceURL>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Briar_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Briar_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Наскок</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Briar"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Briar:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Брайер прыгает к бойцу. Если это враг, она пинает его, нанося урон, оглушая и раскалывая броню.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Брайер прыгает к цели и оглушает ее на {{ stunduration }} сек., а также наносит {{ totaldamage }} ед. физического урона и ослабляет броню и сопротивление магии на {{ shredpercent*100 }}% на {{ shredduration }} сек. Если Брайер применяет это умение к миньону или монстру во время Кровавого бешенства , она перестает атаковать чемпионов в приоритетном порядке. {{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Evelynn_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Evelynn_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Обольщение</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Evelynn"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Evelynn:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Эвелинн проклинает свою цель. Следующие атака или умение Эвелинн, примененные после задержки, очаровывают цель и уменьшают ее сопротивление магии.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Эвелинн помечает выбранного чемпиона или монстра на 5 сек. Если после этого она применяет к цели автоатаку или умение, метка снимается, Эвелинн получает назад затраченную ману, а цель замедляется на {{ slowamount*100 }}% на {{ slowduration }} сек. Если метка существует как минимум 2.5 сек., при ее снятии возникают новые эффекты: Против чемпионов: Эвелинн очаровывает цель на {{ charmduration }} сек. и уменьшает ее сопротивление магии на {{ mrshred*100 }}% на {{ shredduration }} сек. Против монстров: Эвелинн очаровывает цель на {{ monstercharm }} сек. и наносит {{ monsterdamagetotaltooltip }} магического урона .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Source_Pantheon">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#SourceDocument"/>
    <rdfs:label>Source_Pantheon</rdfs:label>
    <lol:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://ddragon.leagueoflegends.com/cdn/16.20.1/data/ru_RU/champion/Pantheon.json</lol:sourceURL>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Xayah_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Xayah_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Парные кинжалы</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Xayah"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Xayah:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Шая бросает два кинжала, наносящих урон, и оставляет перья, которые она может призвать к себе.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Шая бросает два кинжала, которые наносят по {{ totaldamage }} физического урона и оставляют после себя два пера . Цели после первой получают {{ multihitdamage }} урона от каждого кинжала.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Mel_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Mel_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Зеркальный щит</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Mel"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mel:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Мэл создает вокруг себя барьер, который отражает вражеские снаряды обратно в атакующих и предотвращает получение урона. Кроме того, у Мэл увеличивается скорость передвижения.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Мэл создает вокруг себя барьер, который отражает снаряды, выпускаемые вражескими чемпионами, обратно в атакующих. Кроме того, Мэл получает щит прочностью {{ shieldamount }} на {{ duration }} сек., а ее скорость передвижения увеличивается на {{ movespeed*100 }}% на {{ movespeedduration }} сек. (ускорение постепенно ослабевает). Отраженные снаряды наносят магический урон в размере {{ damagepercent }} от изначального .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Category_Tank">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ChampionCategory"/>
    <rdfs:label>Category_Tank</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tank</lol:name>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Karma_E_Shield_Ally">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#AbilityEffect"/>
    <rdfs:label>Karma_E_Shield_Ally</rdfs:label>
    <lol:hasMechanic rdf:resource="https://example.org/lol-ontology#Shield"/>
    <lol:hasTargetType rdf:resource="https://example.org/lol-ontology#Ally"/>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Karma"/>
    <lol:conditionText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Выбранный союзник; при усилении Мантрой эффект распространяется на ближайших союзных чемпионов.</lol:conditionText>
    <lol:evidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Карма защищает союзника щитом, поглощающим урон и увеличивающим его скорость передвижения. Эффект Мантры: щит излучает энергию, которая увеличивает его прочность и накладывает Воодушевление на ближайших союзных чемпионов.</lol:evidenceText>
    <lol:evidenceField rdf:datatype="http://www.w3.org/2001/XMLSchema#string">description_text</lol:evidenceField>
    <lol:reviewStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">reviewed_by_assistant</lol:reviewStatus>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Belveth_E">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Belveth_E</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ярость императрицы</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Belveth"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Belveth:E</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">E</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Бел'Вет замирает на месте и создает вокруг себя убийственный вихрь, который наносит урон врагу с самым низким уровнем здоровья. Вихрь дает ей прибавку к вампиризму и уменьшает получаемый урон.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Бел'Вет создает вокруг себя убийственный вихрь, уменьшая получаемый урон на {{ drpercent*100 }}% и увеличивая вампиризм на {{ totallifesteal }}. Кроме того, она атакует {{ f2.0 }} раз в течение {{ totalduration }} сек. (количество атак зависит от скорости атаки ). Каждая атака поражает врага с самым низким уровнем здоровья, нанося от {{ damageperstrike }} до {{ maxdamageperstriketooltip }} физического урона в зависимости от недостающего здоровья цели. Если Бел'Вет активирует другое умение или повторно применяет это, действие эффекта заканчивается преждевременно. {{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Twitch_E">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Twitch_E</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Зараза</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Twitch"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Twitch:E</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">E</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Твич распространяет панику среди отравленных жертв, заражая их страшными болезнями.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Твич наносит {{ basedamage }} физического урона всем врагам поблизости, пораженным Смертельным ядом , плюс еще {{ physicaldamageperstack }} физического урона и {{ magicdamageperstack }} магического урона за каждый заряд Смертельного яда . Максимальный урон: {{ maxphysicaldamage }} физического урона и {{ maxmagicdamage }} магического урона .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Garen_R">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Garen_R</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Правосудие Демасии</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Garen"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Garen:R</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Гарен призывает мощь Демасии, чтобы казнить вражеского чемпиона.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Гарен призывает мощь Демасии, чтобы сразить вражеского чемпиона, нанося чистый урон в размере {{ basedamage }} плюс {{ executedamage*100 }}% от недостающего здоровья цели .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Source_Yone">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#SourceDocument"/>
    <rdfs:label>Source_Yone</rdfs:label>
    <lol:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://ddragon.leagueoflegends.com/cdn/16.20.1/data/ru_RU/champion/Yone.json</lol:sourceURL>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Vayne_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Vayne_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Серебряные стрелы</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Vayne"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Vayne:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Вейн использует в наконечниках своих стрел редкий металл, ядовитый для всего зла. Каждая третья автоатака или использование умения против одной и той же цели наносит ей дополнительный чистый урон, зависящий от ее максимального запаса здоровья.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пассивно : каждые третьи последовательные автоатака или умение против врага дополнительно наносят чистый урон в размере {{ totaldamage }} от максимального запаса здоровья .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Belveth_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Belveth_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Неотвратимая Бездна</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Belveth"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Belveth:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Бел'Вет совершает рывок в выбранном направлении и наносит урон всем врагам на своем пути.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Бел'Вет совершает рывок, нанося {{ basedamage }} физического урона всем пораженным врагам. У каждого направления отдельная перезарядка – {{ f1 }} сек. (сокращается по мере роста скорости атаки ). {{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Source_Lux">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#SourceDocument"/>
    <rdfs:label>Source_Lux</rdfs:label>
    <lol:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://ddragon.leagueoflegends.com/cdn/16.20.1/data/ru_RU/champion/Lux.json</lol:sourceURL>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Source_Camille">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#SourceDocument"/>
    <rdfs:label>Source_Camille</rdfs:label>
    <lol:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://ddragon.leagueoflegends.com/cdn/16.20.1/data/ru_RU/champion/Camille.json</lol:sourceURL>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Rumble_R">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Rumble_R</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Уравнитель</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Rumble"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Rumble:R</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Рамбл выпускает несколько ракет, создавая огненную стену, наносящую урон врагам и замедляющую их.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Рамбл выпускает несколько ракет, которые оставляют на земле огненную полосу, существующую в течение {{ trailduration }} сек., замедляющую врагов на {{ slowamount }}% и наносящую {{ damagepersecond }} магического урона в секунду. Зону поражения можно задать, щелкнув мышью по начальной точке и потянув в нужном направлении.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Lulu_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Lulu_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Причуда</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Lulu"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Lulu:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Если целью умения является союзник, Лулу увеличивает его скорость атаки и передвижения на короткое время. Если целью умения является враг, Лулу превращает его в очаровательную зверушку, которая не может атаковать или использовать умения.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">При применении к союзнику Лулу повышает скорость передвижения цели на {{ totalms }} и скорость атаки на {{ asbonus*100 }}% на {{ msduration }} сек. При применении к врагу Лулу превращает цель в зверушку на {{ ccduration }} сек.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Kassadin_R">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Kassadin_R</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Шаг в Бездну</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Kassadin"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Kassadin:R</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Кассадин телепортируется в указанную точку, нанося урон ближайшим противникам. Последующие Шаги в Бездну в течение короткого промежутка времени требуют больше маны, но наносят больше урона.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Кассадин телепортируется в указанную точку, нанося врагам {{ basedamage }} магического урона . Каждое последующее применение этого умения в течение следующих {{ rstackduration }} сек. расходует вдвое больше маны и дополнительно наносит {{ bonusdamage }} магического урона . Затраты и урон суммируются до {{ maxstacks }} раз.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Yunara_R">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Yunara_R</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Просветление собственного ''я''</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Yunara"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Yunara:R</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Юнара входит в просветленное состояние, усиливая свои базовые умения.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Юнара входит в просветленное состояние , на {{ buff_duration }} сек. усиливая свои базовые умения.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Zeri_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Zeri_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Импульсный разряд</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Zeri"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Zeri:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Зери выпускает заряд электричества, который замедляет первого пораженного врага и наносит ему урон. Если заряд попадает в стену, из этого места исходит дальнобойный лазерный луч.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Зери выпускает заряд электричества, который наносит {{ totaldamage }} ед. физического урона первому пораженному врагу и замедляет его на {{ slowpercent*100 }}% на {{ slowduration }} сек. Если заряд попадает в элемент ландшафта, из этого места исходит лазерный луч, который бьет по площади и наносит критический урон ({{ walldamage }} ед. физического урона ) чемпионам и монстрам.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Nautilus_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Nautilus_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Якорная цепь</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Nautilus"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nautilus:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Наутилус бросает вперед свой якорь. Если якорь попадает во врага, они с Наутилусом притягиваются друг к другу, а цель получает магический урон. Если якорь попадает в элемент ландшафта, Наутилус притягивается к нему.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Наутилус бросает вперед свой якорь. Если якорь попадает во врага, они с Наутилусом притягиваются друг к другу. При этом цель получает {{ qdamagecalc }} магического урона и ненадолго оглушается . Если якорь попадает в элемент ландшафта, Наутилус притягивается к нему.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Aphelios_R">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Aphelios_R</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Лунный дозор</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Aphelios"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Aphelios:R</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Афелий выпускает концентрированный сгусток лунного света, который взрывается при поражении вражеских чемпионов. Накладывает уникальный эффект основного оружия Афелия.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Афелий выпускает концентрированный сгусток лунного света, который взрывается при поражении чемпиона и наносит {{ maxdamage }} физического урона всем вокруг. После этого Афелий атакует всех пораженных чемпионов с помощью основного оружия. {{ Spell_ApheliosR_WeaponMod_{{ f1 }} }}{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Annie_P">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
    <rdfs:label>Annie_P</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пиромания</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Annie"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Annie:P</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Каждое пятое умение Энни оглушает цель. Энни начинает игру и возрождается с полностью подготовленной Пироманией.</lol:description>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Sejuani_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Sejuani_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Арктическое наступление</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Sejuani"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sejuani:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Седжуани совершает рывок вперед, подбрасывая врагов в воздух. Рывок прекращается при столкновении с вражеским чемпионом.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Седжуани совершает рывок, нанося {{ totaldamagetooltip }} ед. маг. урона врагам на пути и подбрасывая их на {{ knockupdurationtooltiponly }} сек. Рывок прекращается при столкновении с вражеским чемпионом.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Zyra_R">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Zyra_R</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Душащие терния</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Zyra"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Zyra:R</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Зайра вызывает быстрый рост побегов в указанной области. Побеги по мере распространения наносят урон врагам, а затем подбрасывают их в воздух. Задетые побегами растения становятся разъяренными.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Зайра призывает ярость природы, вызывая быстрый рост побегов, наносящих {{ totaldamage }} ед. маг. урона . Через 2 сек. побеги подбрасывают находящихся на них врагов на {{ knockupduration }} сек. Задетые побегами растения Зайры становятся разъяренными: длительность их существования сбрасывается, а здоровье растет на {{ enragedbonushealthpercent*100 }}% . Также они начинают наносить {{ plantdamagebonus }}% дополнительного урона.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Neeko_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Neeko_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Разделение формы</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Neeko"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Neeko:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Каждую третью автоатаку Нико пассивно наносит дополнительный магический урон и ненадолго повышает свою скорость передвижения. При применении умения она выпускает клона в выбранном направлении, а при повторном применении может изменить направление его движения.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пассивно: каждая 3-я автоатака дополнительно наносит {{ passivebonusdamagecalc }} магического урона и увеличивает скорость передвижения Нико на {{ passivehaste }}% на {{ passivehasteduration }} сек. Активно: Нико становится невидимой на {{ stealthduration }} сек. и выпускает клона, который существует {{ cloneduration }} сек. Скорость передвижения Нико и ее клона увеличивается на {{ haste }}% на {{ hasteduration }} сек. Клоном можно управлять с помощью клавиши передвижения питомцев или путем повторного применения умения. Клон имитирует умения, эмоции и Возвращение Нико. {{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Garen_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Garen_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Храбрость</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Garen"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Garen:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Броня и сопротивление магии Гарена увеличиваются, когда он убивает врагов. При активации умения он получает щит и значительный бонус к стойкости на короткий период. В течение оставшегося времени действия Гарен получает немного меньше урона.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пассивно: Гарен имеет{{ resistsfortooltip }} дополнительной брони и {{ resistsfortooltip }} дополнительного сопротивления магии . Каждое убийство бойца навсегда дает защитные показатели в размере {{ resistgainonkilltooltip }} (максимальный бонус – {{ resistmax }} ). Активно: Гарен становится храбрее на {{ drduration }} сек., уменьшая получаемый урон на {{ drpercent*100 }}%. Кроме того, он получает щит прочностью {{ totalshield }} и {{ upfronttenacity*100 }}% стойкости на {{ upfrontduration }} сек.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Source_Sett">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#SourceDocument"/>
    <rdfs:label>Source_Sett</rdfs:label>
    <lol:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://ddragon.leagueoflegends.com/cdn/16.20.1/data/ru_RU/champion/Sett.json</lol:sourceURL>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Shyvana_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Shyvana_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пламенный удар</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Shyvana"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Shyvana:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Следующая автоатака Шиваны поражает цель и врагов поблизости. Умение можно применить повторно. Когда Шивана в форме дракона, она может применить умение в третий раз, нанеся огромный урон одной цели.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пассивно: автоатаки Шиваны дополнительно наносят магический урон в размере {{ calc_max_health_damage }} от макс. запаса здоровья %i:OnHit% при попадании и сокращают время перезарядки умения на {{ cooldown_reduction }} сек. Активно : следующая автоатака Шиваны поражает цель и всех врагов рядом с ней, дополнительно нанося {{ calc_damage }} ед. физического урона . В течение {{ recastduration }} сек. умение можно применить повторно после автоатаки или небольшой задержки. Форма дракона: Шивана может применить умение в третий раз – при следующей автоатаке она укусит цель, дополнительно нанеся {{ calc_dragon_form_damage }} ед. чистого урона .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Source_Sejuani">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#SourceDocument"/>
    <rdfs:label>Source_Sejuani</rdfs:label>
    <lol:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://ddragon.leagueoflegends.com/cdn/16.20.1/data/ru_RU/champion/Sejuani.json</lol:sourceURL>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Aurora_P">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
    <rdfs:label>Aurora_P</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Изгнание духа</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Aurora"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Aurora:P</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Когда Аврора наносит урон автоатаками или умениями, она освобождает духов, вселившихся во врагов. Эти духи следуют за Авророй, восстанавливая ей здоровье.</lol:description>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Mordekaiser_E">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Mordekaiser_E</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Смертельная хватка</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Mordekaiser"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mordekaiser:E</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">E</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Мордекайзер подтягивает всех врагов в области поражения.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пассивно: Мордекайзер получает {{ magicpen*100 }}% маг. пробивания . Активно: Мордекайзер подтягивает врагов к себе, нанося {{ totaldamage }} ед. маг. урона .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Source_Cassiopeia">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#SourceDocument"/>
    <rdfs:label>Source_Cassiopeia</rdfs:label>
    <lol:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://ddragon.leagueoflegends.com/cdn/16.20.1/data/ru_RU/champion/Cassiopeia.json</lol:sourceURL>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Yorick_E">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Yorick_E</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Траурный туман</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Yorick"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Yorick:E</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">E</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Йорик выпускает облако черного тумана, которое наносит урон, а также уменьшает броню врагов, замедляет и помечает их. Призванные бойцы получают скорость передвижения, когда движутся к помеченным целям.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Йорик выпускает облако черного тумана, которое наносит магический урон в размере {{ calc_healthdamage }} от максимального запаса здоровья , замедляет на {{ calc_slow }} на {{ slowduration }} сек. и помечает чемпионов и монстров на {{ markduration }} сек. Броня помеченных врагов уменьшается на {{ armorshred*100 }}% , и они постоянно пробуждают туманных ходоков из могил поблизости (при этом общее количество ходоков не может превышать {{ spell.yorickpassive:yorickpassiveghoulmax }}). Йорик и призванные им бойцы получают {{ hasteamount*100 }}% скорости передвижения при движении к помеченной цели. Туманные ходоки могут один раз прыгнуть к помеченным целям, которые отдалились от них.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Gragas_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Gragas_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пьяный угар</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Gragas"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gragas:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Грагас пробует свой новый напиток в течение 1 секунды, на некоторое время уменьшая получаемый урон. После этого он впадает в буйство, и его следующая автоатака наносит магический урон по площади.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Грагас пробует свой напиток, уменьшая получаемый урон на {{ damagereduction }} на {{ defenseduration }} сек., а его следующая автоатака дополнительно наносит цели и окружающим врагам магический урон в размере {{ totaldamage }} ед. плюс {{ maxhppercentdamage }}% от максимального запаса здоровья .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Karma_P">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
    <rdfs:label>Karma_P</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Разгорающийся огонь</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Karma"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Karma:P</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Умения Кармы, наносящие урон, сокращают перезарядку Мантры.</lol:description>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
    <lol:hasEffect rdf:resource="https://example.org/lol-ontology#Karma_P_CooldownReduction_OwnAbility"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Kled">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#Champion"/>
    <rdfs:label>Kled</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Клед</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Kled"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Kled</lol:entityId>
    <lol:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Сварливый кавалерист</lol:title>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
    <lol:resourceType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Мужество</lol:resourceType>
    <lol:baseHP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">410.0</lol:baseHP>
    <lol:baseMP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">100.0</lol:baseMP>
    <lol:baseArmor rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">35.0</lol:baseArmor>
    <lol:baseAttackDamage rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">65.0</lol:baseAttackDamage>
    <lol:baseMoveSpeed rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">345.0</lol:baseMoveSpeed>
    <lol:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Fighter"/>
    <lol:reviewStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">effects_not_reviewed</lol:reviewStatus>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Kled_P"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Kled_Q"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Kled_W"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Kled_E"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Kled_R"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Olaf_R">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Olaf_R</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Рагнарек</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Olaf"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Olaf:R</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Броня и сопротивление магии Олафа увеличены. Применив это умение, он становится невосприимчивым к нейтрализующим эффектам до тех пор, пока продолжает атаковать.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пассивно: Олаф получает {{ resists }} к броне и {{ resists }} к сопротивлению магии . Активно: Олаф избавляется ото всех обездвиживающих и нейтрализующих эффектов и становится невосприимчивым к ним на {{ duration }} сек. Пока активно, сила атаки Олафа увеличена на {{ ad }}. Автоатаки и Безрассудные замахи , поразившие чемпионов, продлевают действие умения на {{ durationextension }} сек. Кроме того, Олаф увеличивает свою скорость передвижения на {{ haste*100 }}% при движении к вражеским чемпионам на {{ hasteduration }} сек.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Elise_E">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Elise_E</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Кокон / Спуск</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Elise"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Elise:E</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">E</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Человеческая форма: Элиза выпускает паутину, оглушая первого пораженного противника, а также раскрывая его на некоторое время (не действует на невидимых бойцов). Форма паука: Элиза и ее паучки поднимаются в воздух, а затем обрушиваются на выбранного врага. После спуска на вражескую цель дополнительный урон и лечение Королевы пауков увеличиваются.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Человеческая форма : Элиза выпускает кокон, оглушающий и раскрывающий первого пораженного врага на {{ totalstunduration }} сек.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Gangplank_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Gangplank_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Заедание цинги</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Gangplank"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gangplank:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Гангпланк ест цитрусовые, восстанавливая себе здоровье и снимая эффекты контроля.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Гангпланк поглощает большое число цитрусовых, снимая с себя все нейтрализующие эффекты и восстанавливая {{ basehealth }} плюс {{ percentheal }}% от недост. здоровья .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Lux_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Lux_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Сковывание света</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Lux"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Lux:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Люкс выпускает сферу света, которая наносит урон и обездвиживает до двух врагов.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Люкс выпускает сферу света, обездвиживающую первых 2 врагов на пути на {{ rootduration }} сек. и наносящую им по {{ totaldamagett }} ед. маг. урона .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
    <lol:hasEffect rdf:resource="https://example.org/lol-ontology#Lux_Q_Damage_Enemy"/>
    <lol:hasEffect rdf:resource="https://example.org/lol-ontology#Lux_Q_Root_Enemy"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Vex_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Vex_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Личное пространство</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Vex"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Vex:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Векс получает щит и наносит урон врагам поблизости.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Векс получает щит прочностью {{ shieldcalc }} на {{ shieldduration }} сек. и выпускает ударную волну, которая наносит {{ wdamagecalc }} магического урона . Поглощает метки Безысходности с пораженных врагов.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Twitch_R">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Twitch_R</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Стрельба наугад</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Twitch"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Twitch:R</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Твич использует арбалет на полную мощь: болты летят на большое расстояние, пронзая всех врагов на своем пути.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Твич достает свой арбалет, увеличивая дальность атаки на {{ bonusrange }} и силу атаки на {{ bonusad }} на {{ duration }} сек. Во время действия умения снаряды автоатак проходят сквозь врагов и поражают все цели на своем пути, однако каждая последующая цель получает на {{ falloffdamage*100 }}% меньше урона (минимальный урон - {{ minimumfalloffdamage*100 }}%). {{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Viktor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#Champion"/>
    <rdfs:label>Viktor</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Виктор</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Viktor"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Viktor</lol:entityId>
    <lol:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Вестник аркейна</lol:title>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
    <lol:resourceType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Мана</lol:resourceType>
    <lol:baseHP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">600.0</lol:baseHP>
    <lol:baseMP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">405.0</lol:baseMP>
    <lol:baseArmor rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">23.0</lol:baseArmor>
    <lol:baseAttackDamage rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">53.0</lol:baseAttackDamage>
    <lol:baseMoveSpeed rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">335.0</lol:baseMoveSpeed>
    <lol:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Mage"/>
    <lol:reviewStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">effects_not_reviewed</lol:reviewStatus>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Viktor_P"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Viktor_Q"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Viktor_W"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Viktor_E"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Viktor_R"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#hasMechanic">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>hasMechanic</rdfs:label>
    <rdfs:comment xml:lang="ru">Механика конкретного эффекта.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/lol-ontology#AbilityEffect"/>
    <rdfs:range rdf:resource="https://example.org/lol-ontology#Mechanic"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#MissFortune_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>MissFortune_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Походочка</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_MissFortune"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MissFortune:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Скорость передвижения Мисс Фортуны пассивно увеличивается, когда ей не наносят урон. При активации умения скорость атаки Мисс Фортуны на короткое время увеличивается. Перезарядку Походочки можно уменьшить использованием Приветственного выстрела.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пассивно: если Мисс Фортуна не получает урона в течение {{ passivebasemsooc }} сек., ее скорость передвижения увеличивается на {{ passivebasems }} . Еще через {{ passivemaxmsextraooc }} сек. это увеличение достигает {{ passivemaxms }} . Активно: Мисс Фортуна сразу получает максимальное увеличение скорости передвижения пассивного эффекта, а также увеличивает свою скорость атаки на {{ activeas*100 }}% на {{ activeduration }} сек. Приветственный выстрел сокращает перезарядку этого умения на {{ lovetaprefund }} сек.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#KSante_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>KSante_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Удары нтофо</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_KSante"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">KSante:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">К'Санте совершает удар, нанося урон врагам перед собой и замедляя их. Поразив цель, К'Санте получает заряд Ударов нтофо. Когда накапливается 2 заряда, он выпускает ударную волну, которая притягивает врагов. Высвобождение: у умения сокращается перезарядка.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">К'Санте бьет своим оружием, нанося врагам {{ basedamage }} физического урона и замедляя их на {{ slowpercent*100 }}% на {{ slowduration }} сек. Поразив цель, К'Санте получает заряд Ударов нтофо на {{ recastwindow }} сек. Когда накапливается 2 заряда, он выпускает ударную волну, которая притягивает врагов и оглушает их на {{ stunduration }} сек. Высвобождение : перезарядка умения сокращается на {{ rcooldownreduction.0*100 }}%.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Source_Heimerdinger">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#SourceDocument"/>
    <rdfs:label>Source_Heimerdinger</rdfs:label>
    <lol:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://ddragon.leagueoflegends.com/cdn/16.20.1/data/ru_RU/champion/Heimerdinger.json</lol:sourceURL>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Kled_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Kled_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Капкан на веревке</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Kled"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Kled:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Клед бросает капкан, который наносит урон и вцепляется в первого попавшегося вражеского чемпиона. Если капкан удержится на цели в течение некоторого времени, Клед притянет к себе цель и нанесет ей дополнительный физический урон. Когда Клед идет пешком, это умение превращается в Карманный пистолет - дальнобойное оружие, которое отбрасывает Кледа отдачей и возвращает мужество Скарл.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Верхом: Клед бросает капкан, который наносит первому пораженному вражескому чемпиону или большому лесному монстру {{ totaldamage }} ед. физического урона и цепляется за него. Если Клед остается рядом с зацепленной целью в течение {{ tetherpoptime }} сек., он дергает за веревку, нанося врагу {{ totalyankdamage }} ед. физического урона , подтягивая его к себе и замедляя на {{ slowamount*-100 }}% на {{ slowduration }} сек.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Yuumi_R">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Yuumi_R</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Последняя глава</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Yuumi"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Yuumi:R</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Юми выпускает пять волн, которые наносят урон врагам и лечат союзников. Во время применения умения Юми может перемещаться, привязываться к чемпионам и использовать Догонялки. Когда Юми привязана к лучшему другу, направление волн можно менять с помощью мыши.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">В течение {{ ultduration }} сек. Юми выпускает волшебные волны ({{ numberofwaves }}), которые влияют на обе команды. Если умение применяется, когда она привязана , направление волн можно менять с помощью мыши. Пораженные враги получают {{ totalmissiledamage }} ед. магического урона и замедляются на {{ baseslow*-100 }}% на {{ ccduration }} сек. (эффективность увеличивается на {{ bonusslowperwave*-100 }}% за каждую попавшую волну). Союзные чемпионы восстанавливают себе {{ totalhealperwave }} здоровья за волну. Избыточное лечение превращается в щит . Бонус лучшего друга: эффективность лечения лучшего друга увеличена до {{ enhancedhealperwave }} . При применении умения Ты и я! направление волн фиксируется. Во время применения умения Юми может перемещаться и использовать Догонялки . {{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Source_Velkoz">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#SourceDocument"/>
    <rdfs:label>Source_Velkoz</rdfs:label>
    <lol:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://ddragon.leagueoflegends.com/cdn/16.20.1/data/ru_RU/champion/Velkoz.json</lol:sourceURL>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#KSante_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>KSante_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Напролом</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_KSante"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">KSante:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">К'Санте укрывается оружием и начинает получать меньше урона. После этого он совершает рывок, отбрасывая и оглушая врагов. Высвобождение: К'Санте наносит больше урона, но не отбрасывает и не оглушает врагов.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">К'Санте укрывается своим оружием на {{ mindurationtooltip }}-{{ maxduration.1 }} сек., становясь неудержимым и получая на {{ damagereduction*100 }}% меньше урона. После этого он совершает рывок вперед, нанося пораженным врагам физический урон в размере {{ basedamage }} + {{ totalmaxhealthdamage }} от максимального запаса здоровья , а также отбрасывая их и оглушая на {{ minknockbackduration }}-{{ maxknockbackduration }} сек. (в зависимости от времени подготовки). Высвобождение : у умения сбрасывается перезарядка. К'Санте дополнительно наносит {{ rdamageincreasemin*100 }}-{{ rdamageincreasemax*100 }}% чистого урона (в зависимости от времени подготовки), а уменьшение урона увеличивается до {{ rdamagereduction*100 }}%. Также увеличивается скорость рывка, но умение больше не отбрасывает и не оглушает врагов.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Karma_Q_Damage_Enemy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#AbilityEffect"/>
    <rdfs:label>Karma_Q_Damage_Enemy</rdfs:label>
    <lol:hasMechanic rdf:resource="https://example.org/lol-ontology#Damage"/>
    <lol:hasTargetType rdf:resource="https://example.org/lol-ontology#Enemy"/>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Karma"/>
    <lol:conditionText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Попадание сгустком энергии; урон получает первая цель и окружающие враги.</lol:conditionText>
    <lol:evidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Карма выпускает сгусток энергии, нанося {{ totaldamage }} магического урона первой пораженной цели и окружающим врагам, а также замедляя их на {{ slowamount*-100 }}% на {{ slowduration }} сек.{{ spellmodifierdescriptionappend }}</lol:evidenceText>
    <lol:evidenceField rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tooltip_text</lol:evidenceField>
    <lol:reviewStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">reviewed_by_assistant</lol:reviewStatus>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Corki_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Corki_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Фосфорная бомба</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Corki"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Corki:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Корки выпускает фосфорный снаряд в указанную область, нанося магический урон всем врагам в зоне поражения и делая видимыми находящихся там бойцов на некоторое время.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Корки бросает бомбу, которая наносит {{ totaldamage }} магического урона . Область взрыва и пораженные чемпионы раскрываются на {{ revealduration }} сек.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Leblanc_R">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Leblanc_R</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Копия</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Leblanc"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Leblanc:R</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ле Блан применяет копию одного из своих базовых умений.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ле Блан копирует последнее использованное умение, применяя его снова. Копия умения наносит больше урона. Копия Печати порока наносит {{ rq1damage }} магического урона при наложении печати и {{ rq2damage }} магического урона при ее взрыве. Копия Искажения наносит {{ rwdamage }} магического урона . Копия Эфемерных цепей наносит {{ re1damage }} магического урона при попадании цепью и {{ re2damage }} магического урона при обездвиживании .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#MovementControlMechanic">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>MovementControlMechanic</rdfs:label>
    <rdfs:comment xml:lang="ru">Механика ограничения передвижения: Root, Slow или Stun.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://example.org/lol-ontology#Mechanic"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Source_Taliyah">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#SourceDocument"/>
    <rdfs:label>Source_Taliyah</rdfs:label>
    <lol:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://ddragon.leagueoflegends.com/cdn/16.20.1/data/ru_RU/champion/Taliyah.json</lol:sourceURL>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Lux_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Lux_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Призматический барьер</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Lux"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Lux:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Люкс бросает свой жезл, который, касаясь союзных чемпионов, искривляет вокруг них лучи света, защищая от входящего урона.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Люкс бросает свой жезл, на {{ shieldduration }} сек. накладывая щит прочностью {{ totalshieldtt }} на союзников, которых он касается. Затем жезл возвращается, повторно накладывая щит на пути назад.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
    <lol:hasEffect rdf:resource="https://example.org/lol-ontology#Lux_W_Shield_Ally"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Source_Diana">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#SourceDocument"/>
    <rdfs:label>Source_Diana</rdfs:label>
    <lol:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://ddragon.leagueoflegends.com/cdn/16.20.1/data/ru_RU/champion/Diana.json</lol:sourceURL>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Diana_E">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Diana_E</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Лунный рывок</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Diana"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Diana:E</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">E</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Диана становится живым воплощением мстительной луны, совершает рывок к врагу и наносит ему магический урон. Перезарядка Лунного рывка не требуется, если цель находится под действием Лунного света. После использования Лунного рывка эффект Лунного света пропадает для всех врагов, вне зависимости от того, были ли они целью умения или нет.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Диана становится воплощением мстительной луны, совершает рывок к врагу и наносит ему {{ totaldamage }} магического урона . Если цель поражена Лунным светом , перезарядка этого умения сбрасывается.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Nidalee_E">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Nidalee_E</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Зов предков / Размах</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Nidalee"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nidalee:E</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">E</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Находясь в человеческой форме, Нидали призывает дух пумы, чтобы излечить союзника и на время увеличить его скорость атаки. Находясь в форме пумы, Нидали бьет когтями всех врагов перед собой.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Человеческая форма: Нидали восстанавливает {{ totalhealing }} здоровья и увеличивает скорость атаки цели на {{ bonusas*100 }}% на {{ asduration }} сек. Эффективность лечения увеличивается вплоть до {{ maxhealing }} в зависимости от недостающего здоровья цели.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Yone_P">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
    <rdfs:label>Yone_P</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Путь охотника</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Yone"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Yone:P</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Каждая вторая автоатака Ёнэ наносит магический урон. Кроме того, у него увеличен шанс критического удара.</lol:description>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Nilah_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Nilah_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Покров радости</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Nilah"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nilah:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Нила укрывается туманом и ускоряется, а также начинает уклоняться ото всех вражеских автоатак. Если она касается союзников, этот эффект начинает действовать и на них.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Нила укрывается туманом на {{ baseduration }} сек., становясь призрачной и увеличивая свою скорость передвижения на {{ movespeedpercent*100 }}% . Пока действует эффект, она уклоняется от автоатак и получает на {{ magicdamagereduction*100 }}% меньше магического урона . Коснувшись союзного чемпиона, Нила укрывает туманом и его. Союзник получает те же эффекты, но их продолжительность сокращена до {{ sharebaseduration }} сек. {{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Nautilus_E">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Nautilus_E</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Сейсмическая волна</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Nautilus"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nautilus:E</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">E</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Наутилус создает вокруг себя три взрывные волны. Каждый взрыв наносит урон и замедляет врагов.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Наутилус создает вокруг себя три взрывные волны, каждая из которых наносит {{ damagecalc }} магического урона пораженным врагам и замедляет их на {{ slowpercent*100 }}% (эффект ослабевает в течение {{ slowduration }} сек.).{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Tristana_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Tristana_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Беглый огонь</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Tristana"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tristana:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Тристана готовится открыть беглый огонь, увеличивая свою скорость атаки на короткое время.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Тристана увеличивает свою скорость атаки на {{ attackspeedmod*100 }}% на {{ buffduration }} сек.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Source_Maokai">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#SourceDocument"/>
    <rdfs:label>Source_Maokai</rdfs:label>
    <lol:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://ddragon.leagueoflegends.com/cdn/16.20.1/data/ru_RU/champion/Maokai.json</lol:sourceURL>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Gwen_E">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Gwen_E</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Свободный крой</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Gwen"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gwen:E</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">E</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Гвен совершает рывок на небольшое расстояние и усиливает свои автоатаки на несколько секунд: их дальность и скорость увеличиваются, и они наносят магический урон при попадании . Если она поражает врага в течение этого времени, перезарядка умения частично сокращается.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Гвен совершает рывок и усиливает свои автоатаки на {{ buffduration }} сек. Во время действия усиления скорость атаки Гвен увеличена на {{ bonusattackspeed }}, а дальность атак - на {{ bonusattackrange }}. Кроме того, они наносят {{ onhitdamage }} магического урона %i:OnHit% при попадании . Первая усиленная атака, поразившая врага, сокращает перезарядку этого умения на {{ cdrefund*100 }}%.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Irelia_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Irelia_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пульсирующий клинок</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Irelia"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Irelia:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ирелия совершает рывок к своей цели, восстанавливая здоровье. Если цель помечена или умирает от Пульсирующего клинка, перезарядка умения сбрасывается.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ирелия совершает рывок к врагу, нанося ему {{ championdamage }} физического урона и восстанавливая себе {{ healamount }} здоровья . Если враг умирает или был ослаблен , перезарядка умения сбрасывается. Наносит {{ miniondamage }} урона миньонам.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Sylas_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Sylas_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Убийца королей</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Sylas"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sylas:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Сайлас совершает рывок к врагу и наносит ему урон. Если цель - чемпион, Сайлас также восстанавливает себе здоровье.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Сайлас делает выпад к врагу, нанося ему {{ mindamage }} магического урона . Если цель - чемпион, Сайлас восстанавливает себе от {{ minhealing }} до {{ maxhealing }} здоровья в зависимости от своего недостающего здоровья (максимальная эффективность лечения достигается при {{ maxexecutethreshold*100 }}% здоровья).{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Zoe_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Zoe_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Маленькая хитрюга</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Zoe"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Zoe:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Зои может собирать остатки вражеских применений заклинаний призывателя и активных предметов и единожды применять их сама. Когда она применяет заклинание призывателя, она выпускает 3 заряда в ближайшую цель.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пассивно: при применении заклинания призывателя или активируемого предмета враги оставляют осколки заклинаний. Отдельные миньоны также оставляют осколки заклинаний, если их убивает Зои или союзник поблизости. Зои может подобрать осколок и 1 раз использовать его эффект. Пассивно: когда Зои применяет это умение или любое заклинание призывателя, она получает {{ movementspeed*100 }}% скорости передвижения на {{ msduration }} сек. и выпускает в атакованного ей последним врага 3 заряда. Каждый наносит {{ missiledamagetooltip }} ед. маг. урона . Активно: Зои использует эффект, полученный из подобранного осколка заклинаний.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Warwick_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Warwick_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Челюсти зверя</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Warwick"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Warwick:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Варвик бросается вперед и кусает цель, нанося урон от максимального запаса здоровья цели и восстанавливая себе здоровье в зависимости от нанесенного урона.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Нажатие: Варвик совершает выпад вперед и кусает цель, нанося ей маг. урон в размере {{ basebitedamage }} плюс {{ targetpercenthpdamage }}% от макс. здоровья и восстанавливая себе здоровье в размере {{ lifestealpercent }}% от нанесенного урона . Удерживание: Варвик совершает выпад вперед, хватается челюстями за цель и перепрыгивает ее, при этом следуя за целью, куда бы та ни переместилась. После этого он наносит такой же урон и лечится на ту же величину.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Azir_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Azir_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Восстань!</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Azir"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Azir:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">При активации умения Азир призывает песчаного воина, который автоатакует вместо него в пределах своей дальности атаки. Автоатаки песчаных воинов наносят магический урон всем врагам на прямой линии.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Азир призывает песчаного воина на {{ soldierduration }} сек. Когда Азир применяет автоатаку к врагу около песчаного воина , воин атакует вместо Азира, нанося {{ totaldamage }} ед. маг. урона всем врагам перед собой в направлении цели. У этого умения до {{ maxammo }} зар.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Ezreal_R">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Ezreal_R</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Прицельный залп</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Ezreal"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ezreal:R</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">После небольшой подготовки Эзреаль выпускает мощный заряд энергии, который наносит большой урон каждому пораженному бойцу (миньоны и неэпические монстры получают меньше урона).</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Эзреаль выпускает большую волну энергии, наносящую {{ damage }} ед. маг. урона . Миньоны и неэпические лесные монстры получают {{ damageminionmonster }} ед. маг. урона .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Samira_P">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
    <rdfs:label>Samira_P</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Безрассудный порыв</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Samira"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Samira:P</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Попадая автоатаками или умениями, отличными от тех, которыми Самира попала перед этим, она выстраивает комбинацию. Автоатаки Самиры в ближнем бою наносят дополнительный магический урон. Когда Самира применяет автоатаки к врагам, на которых действуют эффекты обездвиживания , она совершает к ним рывок на расстояние дальности атаки. Если цель подброшена , продолжительность подбрасывания немного увеличивается.</lol:description>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Source_Ezreal">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#SourceDocument"/>
    <rdfs:label>Source_Ezreal</rdfs:label>
    <lol:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://ddragon.leagueoflegends.com/cdn/16.20.1/data/ru_RU/champion/Ezreal.json</lol:sourceURL>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Source_Vi">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#SourceDocument"/>
    <rdfs:label>Source_Vi</rdfs:label>
    <lol:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://ddragon.leagueoflegends.com/cdn/16.20.1/data/ru_RU/champion/Vi.json</lol:sourceURL>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Sylas_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Sylas_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Удар цепями</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Sylas"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sylas:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Сайлас бьет цепями, перекрещивая их в выбранном месте. Цепи наносят урон и замедляют врагов. После задержки в месте пересечения происходит взрыв магической энергии, который наносит урон.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Сайлас бьет своими цепями, нанося врагам {{ damage }} магического урона и замедляя их на {{ slowamountcalc }} на {{ slowduration }} сек. Место, где скрещиваются цепи, взрывается, нанося еще {{ explosiondamage }} магического урона .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Damage">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#Mechanic"/>
    <rdfs:label>Damage</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Урон</lol:name>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Caitlyn_P">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
    <rdfs:label>Caitlyn_P</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Выстрел в голову</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Caitlyn"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Caitlyn:P</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Каждые несколько автоатак или при атаке пойманных в ловушку или сеть врагов Кейтлин стреляет противнику в голову, нанося дополнительный урон, зависящий от шанса критического удара. При стрельбе по пойманным в ловушку или сеть врагам дальность автоатаки увеличивается вдвое.</lol:description>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Viego">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#Champion"/>
    <rdfs:label>Viego</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Виего</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Viego"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Viego</lol:entityId>
    <lol:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Падший король</lol:title>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
    <lol:resourceType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Нет</lol:resourceType>
    <lol:baseHP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">630.0</lol:baseHP>
    <lol:baseMP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">10000.0</lol:baseMP>
    <lol:baseArmor rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">34.0</lol:baseArmor>
    <lol:baseAttackDamage rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">57.0</lol:baseAttackDamage>
    <lol:baseMoveSpeed rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">345.0</lol:baseMoveSpeed>
    <lol:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Fighter"/>
    <lol:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Assassin"/>
