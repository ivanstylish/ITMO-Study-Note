    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Garen_Q"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Garen_W"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Garen_E"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Garen_R"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Jinx_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Jinx_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пиу-пиу!</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Jinx"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Jinx:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Джинкс стреляет из своего пистолета-шокера Чпокера. Заряд поражает первого врага на своем пути, раскрывая его, замедляя и нанося ему урон.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Джинкс стреляет шоковым зарядом, который наносит {{ totaldamage }} физического урона первому пораженному врагу, замедляет его на {{ slowpercent }}% и раскрывает на {{ slowduration }} сек.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Ashe_E">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Ashe_E</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ястребиная разведка</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Ashe"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ashe:E</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">E</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Эш отправляет дух ястреба на разведку в любую точку на карте.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Эш посылает ястреба, который раскрывает любое место на карте на 5 сек. Кроме того, он раскрывает область вокруг себя во время полета. У этого умения может быть до 2 зарядов (частота получения зарядов: {{ chargecooldown }} сек.).{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Sivir_R">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Sivir_R</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">На охоту</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Sivir"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sivir:R</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Сивир ведет союзников в бой, увеличивая их скорость передвижения на некоторое время. Кроме того, автоатаки Сивир сокращают перезарядку ее умений.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Сивир воодушевляет ближайших союзников, увеличивая их скорость передвижения на {{ maxms*100 }}% на {{ ultduration }} сек. Во время охоты автоатаки Сивир, поражающие чемпионов, сокращают перезарядку ее базовых умений на {{ attackcooldownrefund }} сек. Гибели врагов, недавно получивших урон от Сивир, обновляет продолжительность охоты.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Shen_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Shen_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пристанище духа</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Shen"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Shen:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Призрачный клинок блокирует автоатаки, направленные против Шена и союзных чемпионов, в зоне вокруг себя.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Шен создает вокруг своего призрачного клинка охраняемую зону на {{ zoneduration }} сек. Автоатаки против союзных чемпионов в этой области блокируются. Если в момент применения рядом в зоне не будет чемпионов, ее создание отсрочивается на время до {{ zonedelay }} сек.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Source_TahmKench">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#SourceDocument"/>
    <rdfs:label>Source_TahmKench</rdfs:label>
    <lol:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://ddragon.leagueoflegends.com/cdn/16.20.1/data/ru_RU/champion/TahmKench.json</lol:sourceURL>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Briar_R">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Briar_R</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Верная смерть</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Briar"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Briar:R</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Брайер пинает гемолит из своих колодок, помечая первого пораженного чемпиона. Затем она летит к своей добыче, а по прибытии пугает всех врагов вокруг и полностью подчиняется жажде крови. Брайер преследует добычу до самой смерти. При этом у нее срабатывает Кровавое бешенство, а также увеличиваются броня, сопротивление магии, вампиризм и скорость передвижения.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Брайер пинает гемолит из своих колодок и летит к первому пораженному чемпиону, помечая его как свою добычу. По прибытии она наносит {{ damage }} магического урона врагам поблизости и пугает всех, кроме добычи, на {{ fearduration }} сек. Затем Брайер переходит в состояние усиленного Кровавого бешенства и преследует добычу до самой смерти. Во время действия эффекта у нее увеличены броня и сопротивление магии (на {{ totalresists }}), вампиризм (на {{ lifestealpercent*100 }}%) и скорость передвижения (на {{ extramovespeedpercent*100 }}%) .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#KogMaw_R">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>KogMaw_R</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Живая артиллерия</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_KogMaw"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">KogMaw:R</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ког'Мао выпускает снаряд на большое расстояние, нанося магический урон и раскрывая пораженных врагов (кроме невидимых). Враги, у которых осталось мало здоровья, получают гораздо больше урона. Каждое последующее использование Живой артиллерии в течение короткого промежутка времени требует все больших затрат маны.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ког'Мао стреляет кислотой в выбранную область, нанося пораженным врагам магический урон в размере {{ basedamagecalc }} плюс {{ tooltipmissinghealthdamageamp }}% за каждый 1% недостающего здоровья и раскрывая их на 2 сек. Враги, у которых осталось менее 40% здоровья , вместо этого получают {{ maxdamagecalc }} магического урона . Каждый последующий выстрел в течение {{ manacostduration }} сек. расходует на {{ basecost }} больше маны (максимальные затраты: {{ manacostcap }} маны ).{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Zeri">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#Champion"/>
    <rdfs:label>Zeri</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Зери</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Zeri"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Zeri</lol:entityId>
    <lol:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Искра Зауна</lol:title>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
    <lol:resourceType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Мана</lol:resourceType>
    <lol:baseHP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">600.0</lol:baseHP>
    <lol:baseMP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">250.0</lol:baseMP>
    <lol:baseArmor rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">24.0</lol:baseArmor>
    <lol:baseAttackDamage rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">56.0</lol:baseAttackDamage>
    <lol:baseMoveSpeed rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">330.0</lol:baseMoveSpeed>
    <lol:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Marksman"/>
    <lol:reviewStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">effects_not_reviewed</lol:reviewStatus>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Zeri_P"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Zeri_Q"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Zeri_W"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Zeri_E"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Zeri_R"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#AurelionSol_P">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
    <rdfs:label>AurelionSol_P</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Вселенский творец</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_AurelionSol"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AurelionSol:P</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Умения, наносящие урон, дают Аурелиону Солу звездную материю , которая навсегда улучшает весь его арсенал.</lol:description>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Zyra_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Zyra_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Безудержный рост</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Zyra"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Zyra:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Зайра сажает семя, действующее в течение 60 секунд. Если Зайра задевает его при использовании Цепких корней или Смертоносных колючек, из него развивается растение, которое сражается за нее. У Зайры может быть несколько семян в запасе, а при убийстве врага время получения новых семян Безудержного роста сокращается.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Зайра сажает семя , существующее {{ seedduration }} сек. Эти семена на {{ visiongranted }} сек. дают истинное видение вражеских чемпионов, наступающих на них, но сами при этом уничтожаются. У этого умения может быть до 2 зар. (новый заряд дается раз в {{ ammorechargetime }} сек.). При убийстве миньона или монстра время до появления нового заряда снижается на {{ killammorefundminion*100 }}%. Участия в убийствах чемпионов сокращают время до появления нового заряда на {{ killammorefundchamp*100 }}%.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Seraphine_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Seraphine_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Высокая нота</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Seraphine"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Seraphine:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Серафина наносит урон по площади.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Серафина выдает чистую ноту, нанося {{ explosiondamage }} ед. магического урона . Урон против чемпионов и монстров увеличивается в зависимости от недостающего здоровья цели – вплоть до {{ totalempowereddamage }} ед., когда у цели меньше {{ executethreshold*100 }}% здоровья.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Source_Zeri">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#SourceDocument"/>
    <rdfs:label>Source_Zeri</rdfs:label>
    <lol:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://ddragon.leagueoflegends.com/cdn/16.20.1/data/ru_RU/champion/Zeri.json</lol:sourceURL>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Morgana_Q_Damage_Enemy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#AbilityEffect"/>
