  <rdf:Description rdf:about="https://example.org/lol-ontology#Elise_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Elise_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Нейротоксин / Ядовитый укус</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Elise"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Elise:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Человеческая форма: Элиза поражает врага ядом, нанося ему магический урон тем больший, чем больше у него осталось здоровья. Форма паука: Элиза бросается к противнику и наносит ему урон тем больший, чем меньше у него осталось здоровья.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Человеческая форма : Элиза впрыскивает во врага нейротоксин, нанося магический урон в размере {{ basedamage }} плюс {{ humanpercenthealth }} от текущего здоровья цели .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
