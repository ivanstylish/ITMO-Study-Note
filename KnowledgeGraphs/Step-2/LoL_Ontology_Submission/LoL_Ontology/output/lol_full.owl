  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Xerath_R">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Xerath_R</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Мистический ритуал</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Xerath"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Xerath:R</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Зерат становится неподвижным и получает возможность наносить урон на большом расстоянии.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Зерат принимает свою истинную форму на {{ duration }} сек. В это время он может повторно применять умение до {{ numberofshots }} р. Повторное применение: Зерат выпускает магический заряд, нанося {{ tooltiptotaldamage }} ед. маг. урона . Урон выше на {{ rampdamagecalc }} ед. за каждого пораженного чемпиона.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Fiddlesticks_P">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
    <rdfs:label>Fiddlesticks_P</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Безобидное пугало</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Fiddlesticks"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fiddlesticks:P</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Аксессуар Фиддлстикса заменяется на чучела.</lol:description>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Amumu_E">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Amumu_E</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Вспышка гнева</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Amumu"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Amumu:E</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">E</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Амуму получает уменьшенный физический урон. При активации умения Амуму дает волю гневу, нанося урон всем окружающим врагам. Каждый раз, когда Амуму получает урон, перезарядка умения сокращается.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пассивно: Амуму получает на {{ damagereduction }} меньше физ. урона. Когда Амуму поражают автоатакой, перезарядка этого умения сокращается на {{ cdronhit }} сек. Активно: Амуму срывается, нанося {{ tantrumdamage }} ед. маг. урона врагам поблизости.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#MissFortune_P">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
    <rdfs:label>MissFortune_P</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Приветственный выстрел</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_MissFortune"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MissFortune:P</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Автоатаки Мисс Фортуны наносят дополнительный физический урон каждый раз, когда она меняет цель.</lol:description>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Source_Sona">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#SourceDocument"/>
    <rdfs:label>Source_Sona</rdfs:label>
    <lol:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://ddragon.leagueoflegends.com/cdn/16.20.1/data/ru_RU/champion/Sona.json</lol:sourceURL>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Vayne_R">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Vayne_R</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Последняя битва</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Vayne"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Vayne:R</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Вейн готовится к страшному противостоянию, получая дополнительную силу атаки, невидимость во время Кувырков, сокращение перезарядки Кувырка, а также усиленное пассивное умение.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Вейн получает {{ bonusattackdamage }} силы атаки на {{ baseduration }} сек. Эта продолжительность увеличивается на {{ durationtoadd }} сек., если погибает чемпион, которому Вейн наносила урон в последние {{ damagedmarkerduration }} сек. Кроме того, в течение этого времени: Ночная охотница увеличивает скорость передвижения на {{ movementspeed }} . Перезарядка Кувырка сокращается на {{ tumblecdreduction }}%, а само умение дает невидимость на {{ tumblestealthduration }} сек.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Camille">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#Champion"/>
    <rdfs:label>Camille</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Камилла</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Camille"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Camille</lol:entityId>
    <lol:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Стальная тень</lol:title>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
    <lol:resourceType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Мана</lol:resourceType>
    <lol:baseHP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">650.0</lol:baseHP>
    <lol:baseMP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">375.0</lol:baseMP>
    <lol:baseArmor rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">35.0</lol:baseArmor>
    <lol:baseAttackDamage rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">68.0</lol:baseAttackDamage>
    <lol:baseMoveSpeed rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">340.0</lol:baseMoveSpeed>
    <lol:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Fighter"/>
    <lol:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Assassin"/>
    <lol:reviewStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">effects_not_reviewed</lol:reviewStatus>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Camille_P"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Camille_Q"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Camille_W"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Camille_E"/>
