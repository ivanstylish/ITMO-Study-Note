  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Gangplank_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Gangplank_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Аррргумент</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Gangplank"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gangplank:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Гангпланк стреляет в цель. За каждого убитого в результате этого бойца Гангпланк получает золото.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">{{Spell_GangplankQWrapper_Tooltip_{{ gamemodeinteger }}}}{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Tryndamere_E">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Tryndamere_E</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Удар вихря</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Tryndamere"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tryndamere:E</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">E</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Триндамир прорубается к цели, нанося урон всем на пути.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Триндамир совершает рывок сквозь врагов, нанося {{ totaldamage }} ед. физического урона и получая {{ nonchampfurygain }} ярости за каждого пораженного врага. Поражая вражеских чемпионов, он получает {{ champfurygain }} ярости . Перезарядка этого умения сокращается на {{ nonchampcdrefund }} сек., когда Триндамир совершает критический удар. Если цель – чемпион, перезарядка сокращается на {{ champcdrefund }} сек.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Skarner_R">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Skarner_R</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пронзание</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Skarner"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Skarner:R</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Скарнер бьет хвостами, подавляя вражеских чемпионов. Пока действует подавление, при перемещении Скарнер тащит жертв за собой.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Скарнер бьет хвостами, нанося {{ damage }} магического урона и подавляя первых 3 пораженных чемпионов на {{ duration }} сек. Пока действует это умение, при перемещении Скарнер тащит пораженных чемпионов за собой. Если Скарнер попадает хотя бы по одному чемпиону, его скорость передвижения увеличивается на {{ speedboostamount*100 }}% на {{ speedboostduration }} сек. Если активна Расколотая земля , сначала применяется Сотрясение .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Source_Rammus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#SourceDocument"/>
    <rdfs:label>Source_Rammus</rdfs:label>
    <lol:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://ddragon.leagueoflegends.com/cdn/16.20.1/data/ru_RU/champion/Rammus.json</lol:sourceURL>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Yone">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#Champion"/>
    <rdfs:label>Yone</rdfs:label>
