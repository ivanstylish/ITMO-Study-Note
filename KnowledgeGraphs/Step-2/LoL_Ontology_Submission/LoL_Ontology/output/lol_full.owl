  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Soraka_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Soraka_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Звездная пыль</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Soraka"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Soraka:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Сорака жертвует частью своего запаса здоровья, восстанавливая здоровье другому союзному чемпиону.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Сорака восстанавливает {{ totalheal }} здоровья другому союзному чемпиону. Если на Сораку действует Обновление , затраты здоровья этого умения снижаются на {{ percenthealthcostrefund*100 }}%, а цель тоже получает Обновление на {{ spell.sorakaq:hotduration }} сек.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Jhin">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#Champion"/>
    <rdfs:label>Jhin</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Джин</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Jhin"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Jhin</lol:entityId>
    <lol:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Виртуоз</lol:title>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
    <lol:resourceType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Мана</lol:resourceType>
    <lol:baseHP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">655.0</lol:baseHP>
    <lol:baseMP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">300.0</lol:baseMP>
    <lol:baseArmor rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">24.0</lol:baseArmor>
    <lol:baseAttackDamage rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">61.0</lol:baseAttackDamage>
    <lol:baseMoveSpeed rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">330.0</lol:baseMoveSpeed>
    <lol:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Marksman"/>
    <lol:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Mage"/>
    <lol:reviewStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">effects_not_reviewed</lol:reviewStatus>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Jhin_P"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Jhin_Q"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Jhin_W"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Jhin_E"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Jhin_R"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Gnar_E">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Gnar_E</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Прыг / Хрясь</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Gnar"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gnar:E</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">E</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Гнар прыгает в выбранном направлении, увеличивая свою скорость атаки. Если он приземляется на любого бойца, он совершает еще один прыжок в том же направлении. Если этот боец вражеский, Гнар наносит ему урон и замедляет его. Мега-Гнар слишком большой для второго прыжка - прыгнув один раз, он обрушивается на землю с ужасающей силой, нанося урон всем врагам вокруг.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Мини-Гнар: Гнар совершает прыжок, увеличивая свою скорость атаки на {{ spell.gnare:minibas*100 }}% на {{ spell.gnare:miniasduration }} сек. При приземлении на любого бойца Гнар совершает еще один прыжок в том же направлении. Если этот боец вражеский, Гнар наносит ему {{ spell.gnare:minitotaldamage }} физического урона и ненадолго замедляет на {{ spell.gnare:movespeedmod*-100 }}%.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Akshan_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Akshan_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Бумеранг мстителя</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Akshan"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Akshan:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Акшан бросает бумеранг, который наносит урон, когда летит вперед и когда возвращается. Дальность полета увеличивается с каждой пораженной целью.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Акшан бросает бумеранг, который наносит {{ finaldamage }} физического урона . Дальность полета бумеранга увеличивается с каждым пораженным врагом. При поражении чемпиона Акшан увеличивает свою скорость передвижения на {{ totalhaste }} (эффект ослабевает в течение {{ hasteduration }} сек.).{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#KogMaw">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#Champion"/>
    <rdfs:label>KogMaw</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ког'Мао</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_KogMaw"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">KogMaw</lol:entityId>
    <lol:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пасть Бездны</lol:title>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
    <lol:resourceType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Мана</lol:resourceType>
    <lol:baseHP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">635.0</lol:baseHP>
    <lol:baseMP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">325.0</lol:baseMP>
    <lol:baseArmor rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">24.0</lol:baseArmor>
    <lol:baseAttackDamage rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">61.0</lol:baseAttackDamage>
    <lol:baseMoveSpeed rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">330.0</lol:baseMoveSpeed>
    <lol:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Marksman"/>
    <lol:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Mage"/>
    <lol:reviewStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">effects_not_reviewed</lol:reviewStatus>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#KogMaw_P"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#KogMaw_Q"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#KogMaw_W"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#KogMaw_E"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#KogMaw_R"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Malzahar_R">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Malzahar_R</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Потусторонняя хватка</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Malzahar"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Malzahar:R</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Мальзахар потоком эссенции Бездны парализует выбранного вражеского чемпиона над областью отрицательной энергии, которая постоянно наносит урон.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Мальзахар подавляет вражеского чемпиона и наносит ему {{ totaldamagetooltip }} ед. магического урона за {{ ccduration }} сек. Вокруг врага появляется область отрицательной энергии, наносящая магический урон в размере {{ zonedamagetooltip }} от макс. запаса здоровья за {{ poolduration }} сек.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Cassiopeia_R">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Cassiopeia_R</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Каменящий взгляд</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Cassiopeia"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cassiopeia:R</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Кассиопея выпускает из глаз поток магической энергии, оглушая всех врагов перед собой, обращенных к ней лицом, и замедляя обращенных к ней спиной.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Кассиопея применяет каменящий взгляд, нанося {{ rdamage }} магического урона и оглушая врагов, которые повернуты к ней, на {{ rccduration }} сек. Враги, которые повернуты в другую сторону, замедляются на {{ rslowpercent }}% (эффект ослабевает в течение того же времени).{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Trundle_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Trundle_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ледяная земля</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Trundle"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Trundle:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Трандл замораживает выбранную область. Пока он находится там, его скорость атаки и скорость передвижения увеличены, а действие всех восстанавливающих здоровье эффектов усилено.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Трандл замораживает область на {{ duration }} сек. Находясь в этой области, он получает {{ msbonus*100 }}% скорости передвижения , {{ asbonus*100 }}% скорости атаки и {{ healingbonus*100 }}% эффективности лечения.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
