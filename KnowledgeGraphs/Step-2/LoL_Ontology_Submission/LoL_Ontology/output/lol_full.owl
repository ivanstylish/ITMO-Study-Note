  <rdf:Description rdf:about="https://example.org/lol-ontology#KogMaw_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>KogMaw_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Едкий плевок</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_KogMaw"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">KogMaw:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ког'Мао плюет кислотой, нанося магический урон и на короткое время уменьшая броню и сопротивление магии цели. Скорость атаки Ког'Мао увеличивается.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пассивно: скорость атаки Ког'Мао увеличена на {{ attackspeed*100 }}% . Активно: Ког'Мао плюется сгустком кислоты, который наносит первому пораженному врагу {{ totaldamage }} ед. магического урона и уменьшает его броню и сопротивление магии на {{ shredamount }}% на {{ shredduration }} сек.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
