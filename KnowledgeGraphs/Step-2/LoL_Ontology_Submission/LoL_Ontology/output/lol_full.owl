    <rdf:type rdf:resource="https://example.org/lol-ontology#SourceDocument"/>
    <rdfs:label>Source_Gnar</rdfs:label>
    <lol:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://ddragon.leagueoflegends.com/cdn/16.20.1/data/ru_RU/champion/Gnar.json</lol:sourceURL>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Camille_P">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
    <rdfs:label>Camille_P</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Адаптивная защита</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Camille"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Camille:P</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">При поражении чемпиона автоатакой Камилла ненадолго получает щит против урона, соответствующего основному типу урона пораженной цели (физическому или магическому). Прочность щита зависит от максимального запаса здоровья Камиллы.</lol:description>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#entityId">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>entityId</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Source_Akshan">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#SourceDocument"/>
    <rdfs:label>Source_Akshan</rdfs:label>
    <lol:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://ddragon.leagueoflegends.com/cdn/16.20.1/data/ru_RU/champion/Akshan.json</lol:sourceURL>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Nidalee_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Nidalee_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ловушка / Прыжок</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Nidalee"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nidalee:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Находясь в человеческой форме, Нидали ставит ловушку, которая делает противника видимым и наносит ему урон. Находясь в форме пумы, Нидали прыгает вперед, нанося небольшой урон по площади в точке приземления.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Человеческая форма: Нидали размещает невидимую ловушку на 2 мин. Если враг наступает на ловушку, она захлопывается и наносит ему {{ damagepersecond }} ед. маг. урона в секунду в течение {{ dotduration }} сек. Одновременно можно разместить не более {{ maxtraps }} ловушек.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Category_Marksman">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ChampionCategory"/>
    <rdfs:label>Category_Marksman</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Marksman</lol:name>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Lucian_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Lucian_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Обжигающее пламя</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Lucian"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Lucian:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Люциан выпускает снаряд, который взрывается в форме звезды, помечая и ненадолго раскрывая врагов. Если Люциан атакует помеченных врагов, его скорость передвижения увеличивается.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Люциан выпускает снаряд, взрывающийся в конце своего пути или при поражении врага и наносящий {{ totaldamage }} ед. маг. урона . Снаряд ненадолго раскрывает врагов и помечает их на 6 сек. Когда Люциан или его союзник наносят урон врагу с меткой, Люциан получает {{ movespeedamount }} скорости передвижения на 1 сек. Когда союзник активирует этот эффект, Люциан получает Бдительность .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Hwei_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Hwei_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Тема: Катастрофа</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Hwei"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hwei:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Хвэй представляет себе катастрофы, получая возможность рисовать образы, которые наносят урон врагам. Применив Катастрофу, Хвэй переключается на умения с уроном: Разрушительное пламя, Калечащий разряд и Извержение лавы.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Хвэй рисует катастрофические образы, которые наносят большой урон врагам. Разрушительное пламя Хвэй выпускает вперед огненный шар. При попадании во врага шар взрывается, нанося всем вокруг магический урон в размере {{ tooltip_qqdamage }} плюс {{ tooltip_qqbonusdamage }}% от максимального запаса здоровья . Калечащий разряд Хвэй рисует разрушительную молнию в выбранном месте на большом расстоянии. После задержки она бьет в землю, нанося врагам {{ tooltip_qwdamage }} магического урона . Изолированные или обездвиженные цели дополнительно получают до {{ tooltip_qwbonusdamage }} магического урона в зависимости от их недостающего здоровья. Извержение лавы Хвэй рисует серию вулканических извержений, после которых остаются лужи лавы. Каждое извержение наносит {{ tooltip_qedamage }} магического урона . Лужи лавы замедляют врагов на {{ spell.hweiqe:slowpercent }}% и наносят им {{ tooltip_qedamagepersecond }} магического урона в секунду в течение {{ spell.hweiqe:duration }} сек.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Brand_R">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Brand_R</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Очищение огнем</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Brand"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Brand:R</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Брэнд высвобождает разрушительный поток огня, который перекидывается между Брэндом и врагами поблизости до 5 раз. При каждом поражении враги получают магический урон. Очищение огнем старается перекинуться на чемпионов для увеличения количества зарядов Поджога. Если цель в огне, Очищение огнем ненадолго замедляет ее.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Брэнд высвобождает разрушительный поток огня, который перекидывается между Брэндом и врагами поблизости до 5 раз. При каждом поражении враги получают {{ totaldamage }} магического урона . Умение старается перекинуться на чемпионов для увеличения количества зарядов Поджога . Если цель подожжена , она ненадолго замедляется на {{ slowamount }}%.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#gameVersion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>gameVersion</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Veigar_E">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Veigar_E</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Горизонт событий</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Veigar"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Veigar:E</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">E</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Вейгар искривляет пространство, создавая клетку, которая оглушает проходящих через нее врагов.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Вейгар искривляет пространство, создавая клетку, оглушающую проходящих через нее врагов на {{ stunduration }} сек. Клетка существует в течение 3 сек.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Yasuo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#Champion"/>
    <rdfs:label>Yasuo</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ясуо</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Yasuo"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Yasuo</lol:entityId>
    <lol:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Непрощенный</lol:title>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
    <lol:resourceType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Поток</lol:resourceType>
    <lol:baseHP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">590.0</lol:baseHP>
    <lol:baseMP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">100.0</lol:baseMP>
    <lol:baseArmor rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">32.0</lol:baseArmor>
    <lol:baseAttackDamage rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">60.0</lol:baseAttackDamage>
    <lol:baseMoveSpeed rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">345.0</lol:baseMoveSpeed>
    <lol:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Fighter"/>
    <lol:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Assassin"/>
    <lol:reviewStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">effects_not_reviewed</lol:reviewStatus>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Yasuo_P"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Yasuo_Q"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Yasuo_W"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Yasuo_E"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Yasuo_R"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#baseMoveSpeed">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>baseMoveSpeed</rdfs:label>
    <rdfs:domain rdf:resource="https://example.org/lol-ontology#Champion"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#JarvanIV_E">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>JarvanIV_E</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Штандарт Демасии</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_JarvanIV"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">JarvanIV:E</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">E</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Джарван IV несет цвета Демасии, и его скорость атаки пассивно увеличена. При активации умения Джарван IV водружает флаг Демасии, нанося магический урон врагам. Водруженный флаг увеличивает скорость атаки всех союзных чемпионов неподалеку.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пассивно: Джарван IV получает {{ permanentattackspeed*100 }}% скорости атаки . Активно: Джарван IV бросает свой штандарт, нанося {{ totaldamage }} ед. маг. урона и давая союзникам поблизости {{ baseauraas*100 }}% скорости атаки на {{ e4 }} сек.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Source_Zilean">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#SourceDocument"/>
    <rdfs:label>Source_Zilean</rdfs:label>
    <lol:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://ddragon.leagueoflegends.com/cdn/16.20.1/data/ru_RU/champion/Zilean.json</lol:sourceURL>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Rell_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Rell_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ферромантия: жесткая посадка</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Rell"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Rell:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">На коне: Релл спрыгивает с коня и надевает доспех, подбрасывая врагов и получая прочный щит. В спешенном виде у нее увеличены броня, сопротивление магии, скорость атаки и дальность атаки, но уменьшена скорость передвижения. Пеший ход: Релл создает коня и запрыгивает на него, ненадолго увеличивая скорость передвижения. Кроме того, при следующей автоатаке она подбрасывает цель.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пассивно – Конная прыть: когда Релл находится на коне, ее скорость передвижения увеличена на {{ spell.rellw_dismount:mountedmovespeed }} . Активно – Ферромантия: жесткая посадка: Релл спрыгивает со своего коня, подбрасывая врагов и нанося им {{ spell.rellw_dismount:dismountdamage }} магического урона . Кроме того, Релл получает щит прочностью {{ spell.rellw_dismount:shield }} , который действует до тех пор, пока она снова не запрыгнет на коня. Затем Релл надевает доспех, получая {{ spell.rellw_dismount:resistanceincrease*100 }}% брони и сопротивления магии , а также увеличивая скорость атаки на {{ spell.rellw_dismount:dismountedasboost*100 }}% и дальность атаки на {{ spell.rellw_dismount:dismountedrangeboost }}. В этой форме она может применить умение Ферромантия: по коням .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Kayle_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Kayle_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Благословение небес</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Kayle"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Kayle:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Благословленная богами, Кейл восстанавливает здоровье и увеличивает скорость передвижения себе и ближайшему союзнику.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Кейл наполняет себя и союзного чемпиона светом, восстанавливая {{ totalheal }} здоровья и увеличивая скорость передвижения на {{ totalhaste }} на {{ hasteduration }} сек.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#AurelionSol_R">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>AurelionSol_R</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Падающая звезда / Обрушение небес</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_AurelionSol"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AurelionSol:R</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Падающая звезда. На землю падает звезда, которая наносит пораженным врагам магический урон и оглушает их. Аурелион Сол получает звездную материю за каждого задетого вражеского чемпиона. Когда Аурелион Сол накапливает достаточное количество звездной материи, его следующая Падающая звезда превращается в Обрушение небес. Обрушение небес. Аурелион Сол обрушивает на землю огромную звезду со значительно увеличенной областью поражения. Она наносит больше урона и вместо оглушения подбрасывает врагов. Затем из области поражения распространяется ударная волна, которая наносит чемпионам урон и замедляет их. Звездная материя увеличивает область поражения Падающей звезды и Обрушения небес.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">На землю падает звезда, которая наносит пораженным врагам {{ maxdamagetooltip }} магического урона и оглушает их на {{ stunduration }} сек. Аурелион Сол получает {{ massstolen }} звездной материи за каждого задетого вражеского чемпиона. Когда Аурелион Сол накапливает {{ calamitystacks }} звездной материи , его следующая Падающая звезда превращается в Обрушение небес . Обрушение небес : Аурелион Сол обрушивает на землю огромную звезду, которая наносит всем врагам в большой области {{ r2damage }} магического урона и подбрасывает их на {{ stunduration }} сек. Затем из области поражения распространяется ударная волна, которая наносит {{ shockwavedamage }} магического урона чемпионам и эпическим монстрам и замедляет всех пораженных врагов на {{ shockwaveslow*100 }}% на 1 сек.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Rengar_P">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
    <rdfs:label>Rengar_P</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Невидимый хищник</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Rengar"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Rengar:P</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Находясь в кустах, Ренгар прыгает на цель при автоатаках. Применяя умения, Ренгар увеличивает запас свирепости. Когда накапливается максимум свирепости, его следующее умение усиливается. За убийство вражеских чемпионов Ренгар получает трофеи на свое Ожерелье из зубов , увеличивая силу атаки.</lol:description>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Lillia_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Lillia_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Удар природы</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Lillia"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Lillia:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пассивно: поражая врагов умениями, Лиллия увеличивает свою скорость передвижения (эффект суммируется). Активно: Лиллия наносит магический урон врагам поблизости. Цели на краю области поражения получают дополнительный чистый урон.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пассивно: поражая врагов умениями, Лиллия увеличивает скорость передвижения на {{ prancespeed }} на {{ pranceduration }} сек. (эффект суммируется до {{ prancemaxstacks }} раз). Активно: Лиллия совершает круговой удар своим посохом, нанося {{ totaldamage }} магического урона врагам плюс {{ bonustruedamage }} чистого урона тем, кто находится на краю области поражения.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Nunu_E">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Nunu_E</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Снежковый обстрел</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Nunu"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nunu:E</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">E</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Нуну бросает несколько снежков, которые наносят урон врагам. После этого Виллумп обездвиживает чемпионов или больших монстров, пораженных снежками.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Нуну бросает 3 снежка, нанося {{ totalsnowballdamage }} магического урона каждым снежком и замедляя врагов, пораженных трижды, на {{ slowamount*-100 }}% на {{ slowduration }} сек. Нуну может повторно применить это умение еще два раза. Через {{ totalspellduration }} сек. Нуну обездвиживает всех врагов поблизости, которые были замедлены снежками, на {{ rootduration }} сек. и дополнительно наносит им {{ totalrootdamage }} магического урона .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Katarina_P">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
    <rdfs:label>Katarina_P</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ненасытность</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Katarina"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Katarina:P</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Оставшееся время перезарядки умений Катарины значительно сокращается каждый раз, когда умирает вражеский чемпион, которому она недавно нанесла урон. Когда Катарина подбирает кинжал , она производит круговую атаку, наносящую магический урон.</lol:description>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#AllyShieldChampion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>AllyShieldChampion</rdfs:label>
    <rdfs:comment xml:lang="ru">Чемпион с хотя бы одним эффектом щита для союзников.</rdfs:comment>
    <owl:equivalentClass rdf:nodeID="N52e9991c3deb473cbf8fed59d3ce4327"/>
    <rdfs:subClassOf rdf:resource="https://example.org/lol-ontology#Champion"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Fizz_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Fizz_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Удар сорванца</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Fizz"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fizz:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Физз совершает рывок сквозь свою цель, нанося дополнительный магический урон и накладывая эффекты при попадании.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Физз совершает рывок сквозь врага, нанося {{ totaldamage }} физического урона плюс {{ qdamage }} магического урона .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Yone_R">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Yone_R</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Решение судьбы</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Yone"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Yone:R</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ёнэ телепортируется за последнего чемпиона на прямой, поражая всех врагов на пути с такой силой, что они подтягиваются к нему.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ёнэ поражает всех врагов на пути перед собой, нанося {{ tooltipdamage }} физического урона и {{ tooltipdamage }} магического урона . При этом Ёнэ телепортируется за последнего пораженного чемпиона и подбрасывает жертв, подтягивая их к себе.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Darius_R">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Darius_R</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ноксианская гильотина</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Darius"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Darius:R</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Дариус прыгает на вражеского чемпиона и выполняет смертоносный удар, нанося чистый урон. Этот урон увеличивается с каждым зарядом Кровотечения на цели. Если цель погибает от Ноксианской гильотины, в течение короткого времени умение можно использовать еще раз.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Дариус прыгает к врагу и совершает смертельный удар, нанося {{ damage }} чистого урона . За каждый заряд Кровотечения на цели это умение дополнительно наносит {{ rdamagepercentperhemostack*100 }}% урона (максимальный урон - {{ maximumdamage }} ). Если это умение убивает цель, Дариус может применить его повторно в течение {{ rrecastduration }} сек. На 3-м уровне умения оно перестает расходовать ману, а убийство полностью сбрасывает перезарядку.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#hasTargetType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>hasTargetType</rdfs:label>
    <rdfs:comment xml:lang="ru">Получатель конкретного эффекта.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/lol-ontology#AbilityEffect"/>
    <rdfs:range rdf:resource="https://example.org/lol-ontology#TargetType"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Malzahar_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Malzahar_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Рой Бездны</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Malzahar"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Malzahar:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Мальзахар призывает войдлингов для атаки ближайших врагов.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пассивно: при применении других умений Мальзахар получает заряды (не более {{ stackcap }} суммарно). Активно: Мальзахар призывает войдлинга плюс еще по одному войдлингу за заряд. Войдлинги существуют в течение {{ voidlingduration }} сек. и с каждым попаданием наносят {{ voidlingbonusdamagetooltip }} магического урона .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Udyr_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Udyr_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Железная щетина</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Udyr"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Udyr:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Удир получает щит, и его следующие две автоатаки восстанавливают ему здоровье. Повторное применение: Удир получает более прочный щит, и его следующие две автоатаки восстанавливают еще больше здоровья в течение пары секунд. Эффективность лечения зависит от его максимального запаса здоровья.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Стойка кабана: Удир получает щит прочностью {{ totalshield }} на {{ shieldduration }} сек. и усиливает следующие две автоатаки: их вампиризм увеличивается на {{ lifesteal*100 }}% и они восстанавливают ему {{ lifeonhit }} здоровья . Пробуждение: Удир получает щит прочностью {{ recastshield }} и восстанавливает себе {{ recastheal }} здоровья в течение {{ shieldduration }} сек. Кроме того, он еще больше усиливает следующие две автоатаки: их вампиризм увеличивается на {{ lifesteal*200 }}% и они восстанавливают ему {{ lifeonhitawakened }} здоровья . {{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Velkoz_P">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
    <rdfs:label>Velkoz_P</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Органический распад</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Velkoz"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Velkoz:P</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Когда Вел'Коз поражает врагов своими умениями, он накладывает на них эффект Органического распада . Каждое третье умение поглощает все заряды и наносит дополнительный чистый урон.</lol:description>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Source_Veigar">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#SourceDocument"/>
    <rdfs:label>Source_Veigar</rdfs:label>
    <lol:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://ddragon.leagueoflegends.com/cdn/16.20.1/data/ru_RU/champion/Veigar.json</lol:sourceURL>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Galio_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Galio_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ветра войны</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Galio"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Galio:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Галио запускает два порыва ветра, и они объединяются в большой вихрь, который наносит периодический урон.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Галио выпускает два порыва ветра, каждый из которых наносит {{ qmissiledamage }} магического урона . Когда порывы соединяются, формируется вихрь, который наносит магический урон в размере {{ percentsuperqdamagett }}% от максимального запаса здоровья в течение {{ superqduration }} сек.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Skarner_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Skarner_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Сейсмический бастион</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Skarner"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Skarner:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Скарнер получает щит и вызывает землетрясение, ударная волна от которого наносит урон и замедляет врагов.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Скарнер получает щит прочностью {{ initialshield }} на {{ shieldduration }} сек. и вызывает землетрясение, которое наносит врагам поблизости {{ damage }} магического урона и замедляет их на {{ sloweffect*-100 }}% на {{ slowduration }} сек.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Sion_E">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Sion_E</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Рев мясника</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Sion"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sion:E</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">E</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Сион создает ударную волну, которая, распространяясь на небольшое расстояние, наносит урон первому пораженному врагу, замедляет его и уменьшает его броню. Если волна поражает миньона или монстра, тот отбрасывается назад, нанося урон всем врагам на своем пути, а также замедляя их и уменьшая их броню.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Сион создает ударную волну, которая наносит врагам {{ totaldamage }} магического урона , замедляет их на {{ slowamount }}% на {{ slowduration }} сек. и уменьшает броню на {{ armorshred }}% на {{ armorshredduration }} сек. Враги, не являющиеся чемпионами, отбрасываются . Враги, пораженные отброшенными бойцами, получают такой же урон, и на них накладываются те же эффекты.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Teemo_R">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Teemo_R</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ядовитая ловушка</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Teemo"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Teemo:R</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Тимо бросает взрывающуюся отравляющую ловушку, используя один из хранящихся в его рюкзаке грибов. Если противник задевает ее, ловушка выпускает ядовитое облако, замедляющее врагов и наносящее им урон с течением времени. Если брошенная ловушка попадает в другую ловушку, она отскакивает и приземляется дальше.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Тимо бросает ловушку в виде гриба, взрывающуюся при контакте с врагом. Ловушки замедляют на {{ slowamount }}% и наносят {{ totaldamage }} ед. маг. урона за {{ debuffduration }} сек. Пораженные враги раскрываются на то же время. Ловушки существуют {{ mushroomduration }} мин. и невидимы. Гриб, брошенный на другой гриб, отскакивает и приземляется в новое место. Макс. заряды: {{ maxammo }} зарядов (новый заряд раз в {{ ammorechargetime }} сек.). {{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Talon_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Talon_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ноксианская дипломатия</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Talon"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Talon:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Талон поражает выбранного бойца. Если удар прошел в ближнем бою, эта атака наносит критический урон. Если Талон находился слишком далеко для атаки, то он прыгает к цели и атакует ее. Если это умение убивает цель, то Талон восстанавливает себе небольшое количество здоровья и сокращает перезарядку этого умения.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Талон прыгает к цели и наносит {{ leapdamage }} физического урона . При применении вблизи Талон совершает критический удар, нанося {{ criticaldamage }} физического урона . Если это умение убивает цель, Талон восстанавливает {{ totalhealing }} здоровья и сокращает его перезарядку на {{ cooldownrefund*100 }}%.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Ahri_P">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
    <rdfs:label>Ahri_P</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Похищение сущности</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Ahri"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ahri:P</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ари лечится, когда убивает 9 миньонов или монстров. Поучаствовав в убийстве чемпиона, она восстанавливает себе еще больше здоровья.</lol:description>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Kalista_P">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
    <rdfs:label>Kalista_P</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Боевая готовность</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Kalista"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Kalista:P</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Если во время автоатаки или при использовании Пронзающего копья Калиста решает сдвинуться с места, она прыгает в указанном курсором направлении после броска копья.</lol:description>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Hecarim_E">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Hecarim_E</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Разрушительный рывок</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Hecarim"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hecarim:E</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">E</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Гекарим постепенно ускоряется и в течение некоторого времени может проходить сквозь бойцов. Его следующая автоатака отбрасывает цель и наносит ей дополнительный физический урон, зависящий от пройденного после активации умения расстояния.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Гекарим получает призрачность и {{ minmovespeed*100 }}% скорости передвижения (растет до {{ maxmovespeed*100 }}% за {{ duration }} сек.). Следующая автоатака Гекарима отбрасывает цель, нанося ей {{ mindamage }} –{{ maxdamage }} ед. физ. урона . Дальность отбрасывания и урон зависят от расстояния, преодоленного в ходе действия этого умения.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Galio_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Galio_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Щит Дюрана</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Galio"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Galio:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Галио уменьшает свою скорость передвижения, подготавливая защитную стойку. После окончания подготовки Галио провоцирует всех ближайших врагов и наносит им урон.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пассивно: если Галио не получает урон в течение {{ passiveshieldooctimer }} сек., он накладывает на себя магический щит прочностью {{ totalpassiveshield }} . Начало подготовки: Галио снижает получаемый магический урон на {{ magicdamagereduction }} и физический урон на {{ physicaldamagereduction }}, а также замедляет себя на {{ selfslowpercent }}%. Применение: Галио провоцирует вражеских чемпионов на {{ ccdurationmin }}–{{ ccdurationmax }} сек., наносит им {{ mintotaldamage }} –{{ maxtotaldamage }} ед. магического урона и продлевает снижение урона на {{ drlingerduration }} сек. Продолжительность, урон и радиус провокации зависят от времени подготовки.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Source_Nocturne">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#SourceDocument"/>
    <rdfs:label>Source_Nocturne</rdfs:label>
    <lol:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://ddragon.leagueoflegends.com/cdn/16.20.1/data/ru_RU/champion/Nocturne.json</lol:sourceURL>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N655258fc81bd4c769ac841a7fb3f29b7">
    <rdf:first rdf:nodeID="Nee431ef9de2b49698c83b01717e58e44"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Renata_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Renata_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Антикризисные меры</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Renata"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Renata:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Рената усиливает союзного чемпиона. После смерти он сразу возрождается, но начинает быстро терять здоровье. Если союзник успевает принять участие в убийстве врага, он остается в живых.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Рената усиливает союзного чемпиона, увеличивая его скорость атаки на {{ ascalc }} и скорость передвижения при перемещении к врагам на {{ mscalc }} . В течение {{ duration }} сек. прибавки увеличиваются до {{ finalascalc }} и {{ finalmscalc }} соответственно. Участия в убийствах чемпионов обновляют продолжительность действия эффекта. При получении смертельного урона здоровье союзника восстанавливается до максимума, но начинает быстро убывать. Через 3 сек. он погибает окончательно. Если в течение этого периода он участвует в убийстве врага, эффект снимается, а его здоровье восстанавливается до {{ triumphpercent }}% от максимального запаса . Потерю здоровья нельзя остановить ничем, кроме участия в убийстве врага, однако смерть можно отсрочить при помощи лечения или подобных эффектов. Чемпионы могут отсрочить свою смерть не более раза. {{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Nocturne_P">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
    <rdfs:label>Nocturne_P</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Клинки чернейшей тени</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Nocturne"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nocturne:P</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Каждые несколько секунд автоатака Ноктюрна наносит окружающим врагам дополнительный физический урон и восстанавливает ему здоровье. Автоатаки Ноктюрна сокращают время перезарядки этого эффекта.</lol:description>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Nocturne_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Nocturne_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Вестник заката</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Nocturne"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nocturne:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ноктюрн бросает теневой клинок, наносящий урон всем врагам на своем пути и оставляющий за собой сумеречный след. Кроме того, сумеречный след начинают оставлять пораженные клинком вражеские чемпионы. Когда Ноктюрн передвигается по сумеречному следу, он может проходить сквозь бойцов, а его скорость передвижения и сила атаки увеличены.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ноктюрн бросает теневой клинок, наносящий {{ totaldamage }} ед. физ. урона и оставляющий сумеречный след на {{ trailduration }} сек. Пораженные вражеские чемпионы также начинают оставлять за собой сумеречный след. Передвигаясь по следу, Ноктюрн получает призрачность, {{ movespeed }}% скорости передвижения и {{ bonustrailad }} силы атаки .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Hecarim_R">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Hecarim_R</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Натиск теней</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Hecarim"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hecarim:R</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Гекарим призывает призрачных всадников и устремляется вперед, нанося магический урон всем повстречавшимся врагам. В конечной точке его пути возникает ударная волна, заставляющая окружающих противников бежать в ужасе.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Гекарим призывает призрачных всадников и устремляется вперед, нанося врагам {{ damagedone }} магического урона . В конечной точке пути Гекарима возникает ударная волна, которая пугает врагов на {{ feardurationmin }}-{{ feardurationmax }} сек. (продолжительность зависит от дальности рывка).{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#title">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>title</rdfs:label>
    <rdfs:domain rdf:resource="https://example.org/lol-ontology#Champion"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#LeeSin_R">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>LeeSin_R</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ярость дракона</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_LeeSin"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LeeSin:R</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ли Син выполняет мощный удар с разворота, отбрасывая вражеского чемпиона назад и нанося при этом физический урон как ему, так и врагам, с которыми он столкнется. Враги, в которых попадает отброшенный чемпион, на короткое время подбрасываются в воздух. Этой технике его обучил Джесси Перринг, хотя Ли Син и не выкидывает игроков за пределы карты.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ли Син выполняет мощный удар с разворота, отбрасывая вражеского чемпиона и нанося ему {{ damage }} физического урона . Враги, в которых попадает отброшенный чемпион, ненадолго подбрасываются и получают физический урон в размере {{ damage }} плюс {{ percenthpcarrythrough }}% от дополнительного здоровья отброшенного чемпиона .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N7702e1ea67074917a105c1e0becfcdf6">
    <rdf:first rdf:resource="https://example.org/lol-ontology#OwnAbility"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Varus_P">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
    <rdfs:label>Varus_P</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Само возмездие</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Varus"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Varus:P</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">При участии в убийстве у Варуса на время увеличиваются сила атаки и сила умений. Прибавки будут больше, если враг – чемпион.</lol:description>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Source_Annie">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#SourceDocument"/>
    <rdfs:label>Source_Annie</rdfs:label>
    <lol:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://ddragon.leagueoflegends.com/cdn/16.20.1/data/ru_RU/champion/Annie.json</lol:sourceURL>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Volibear_E">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Volibear_E</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Громовержец</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Volibear"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Volibear:E</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">E</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Волибир призывает молнию в выбранном месте, которая наносит урон врагам и замедляет их. Если Волибир находится в области удара, он получает щит.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Волибир призывает грозовое облако, которое выпускает молнию, нанося магический урон в размере {{ totaldamagetooltip }} плюс {{ percentdamage*100 }}% от максимального запаса здоровья и замедляя на {{ slowamount*100 }}% на {{ slowduration }} сек. Если Волибир находится в области поражения, он получает щит прочностью {{ shieldapratiotooltip }} плюс {{ shieldamount*100 }}% от максимального запаса здоровья на {{ shieldduration }} сек.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Volibear_R">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Volibear_R</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Вестник бури</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Volibear"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Volibear:R</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Волибир прыгает в выбранное место, нанося урон врагам под собой и замедляя их, а также увеличивая свой запас здоровья. Вражеские башни вокруг его места приземления временно перестают работать.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Волибир преображается и прыгает, увеличивая запас здоровья на {{ healthamount }} и дальность атаки на {{ bonusattackrange }} на {{ transformduration }} сек. По приземлении Волибир отключает башни поблизости на {{ towerdisableduration }} сек. и наносит им {{ towerdamagetooltip }} физического урона . Враги поблизости замедляются на {{ slowamount*100 }}% (эффект ослабевает в течение 1 сек.). Враги прямо под Волибиром получают {{ sweetspotdamagetooltip }} физического урона .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Taliyah_P">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
    <rdfs:label>Taliyah_P</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Катание на камнях</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Taliyah"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Taliyah:P</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Скорость передвижения Талии увеличивается при прохождении рядом со стенами.</lol:description>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Samira_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Samira_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Взмах клинка</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Samira"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Samira:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Самира вращается с мечом, нанося урон врагам и уничтожая вражеские снаряды.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Самира вращается с мечом в течение {{ slashduration }} сек., дважды нанося врагам {{ damagecalc }} физического урона и уничтожая любые вражеские снаряды, которые к ней подлетают. {{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Source_Ambessa">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#SourceDocument"/>
    <rdfs:label>Source_Ambessa</rdfs:label>
    <lol:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://ddragon.leagueoflegends.com/cdn/16.20.1/data/ru_RU/champion/Ambessa.json</lol:sourceURL>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Malphite_E">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Malphite_E</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Удар по земле</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Malphite"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Malphite:E</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">E</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Мальфит бьет по земле, создавая ударную волну, которая наносит магический урон, зависящий от его брони, и уменьшает скорость атаки врагов на короткое время.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Мальфит бьет по земле, нанося врагам {{ edamagecalc }} магического урона и уменьшая их скорость атаки на {{ asreduction }}% на {{ duration }} сек.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Sion_P">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
    <rdfs:label>Sion_P</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Посмертный триумф</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Sion"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sion:P</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Будучи убитым, Сион временно оживает, однако быстро теряет здоровье. При этом у него существенно увеличивается скорость атаки, а его автоатаки лечат его и наносят цели дополнительный урон в зависимости от ее максимального запаса здоровья.</lol:description>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Yuumi_E">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Yuumi_E</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Догонялки</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Yuumi"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Yuumi:E</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">E</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Юми получает щит, а также увеличивает свои скорость передвижения и скорость атаки. Если она привязана, эти эффекты действуют на ее партнера, а не на нее.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Юми получает щит прочностью {{ totalshielding }} и {{ totalattackspeed }}% скорости атаки на {{ msduration }} сек. Пока держится щит, цель также получает {{ msamount }}% скорости передвижения . Если Юми привязана , эффекты этого умения действуют на ее партнера, а не на нее. Кроме того, союзник восстанавливает себе {{ manarestore }} маны . Это значение может увеличиться на величину вплоть до {{ maxmanapercincrease*100 }}% в зависимости от недостающей маны цели.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Vladimir_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Vladimir_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Переливание</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Vladimir"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Vladimir:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Владимир высасывает жизненную силу врага. Когда ресурс Владимира заполнится, Переливание нанесет огромный урон и восстановит здоровье Владимиру.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Владимир вытягивает жизненную силу цели, нанося ей {{ basedamagetooltip }} ед. маг. урона и восстанавливая себе {{ basehealtooltip }} здоровья . Применив это умение дважды, Владимир ускоряется на {{ movementspeedonq2 }}% на 0,5 сек., а его следующее применение этого умения усиливается на {{ frenzyduration }} сек. Усиленная версия этого умения наносит {{ empowereddamagetooltip }} ед. маг. урона и дополнительно лечит на {{ empoweredhealtooltip }} плюс {{ empoweredhealpercenttooltip }} от недост. здоровья .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Source_Ryze">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#SourceDocument"/>
    <rdfs:label>Source_Ryze</rdfs:label>
    <lol:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://ddragon.leagueoflegends.com/cdn/16.20.1/data/ru_RU/champion/Ryze.json</lol:sourceURL>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Ornn_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Ornn_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Вулканический разлом</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Ornn"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ornn:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Орн бьет по земле, создавая в ней трещину, которая наносит врагам урон и замедляет их. После небольшой задержки в области поражения поднимается столп магмы.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Орн бьет по земле, создавая в ней трещину, наносящую врагам {{ totaldamage }} ед. физ. урона и замедляющую их на {{ slowamount }}% на {{ slowduration }} сек. Затем от конца трещины на {{ pillarduration }} сек. поднимается столп магмы. {{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Vex_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Vex_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Черная полоса</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Vex"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Vex:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Векс выпускает наносящий урон снаряд, который ускоряется посреди полета.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Векс выпускает волну тумана, которая наносит {{ qdamagecalc }} магического урона . После задержки волна уменьшается и ускоряется. Поглощает метки Безысходности с пораженных врагов.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Xerath_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Xerath_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Око разрушения</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Xerath"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Xerath:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Зерат вызывает выброс темной энергии, который наносит магический урон всем врагам в зоне поражения и замедляет их. Враги, оказавшиеся в эпицентре, получают дополнительный урон и замедляются сильнее.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Зерат обрушивает на землю заряд энергии, который наносит {{ totaldamage }} магического урона и замедляет врагов на {{ slowamount*100 }}% на {{ slowduration }} сек. Враги в центре получают {{ sweetspottotaldamage }} магического урона и замедляются на {{ sweetspotslowamount*100 }}% (эффект ослабевает в течение {{ slowduration }} сек.).{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Nasus_R">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Nasus_R</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ярость песков</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Nasus"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nasus:R</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Насус призывает сильнейшую песчаную бурю, обрушивающуюся на ближайших противников. Пока буря бушует, его запас здоровья и дальность атаки увеличены. Кроме того, Насус наносит окружающим врагам урон, быстрее перезаряжает Вытягивающий удар и получает дополнительные броню и сопротивление магии.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Насус окружает себя песчаной бурей на 15 сек., увеличивая максимальный запас здоровья на {{ bonushealth }} , а также броню и сопротивление магии на {{ initialresistgain }}. Пока бушует буря, враги поблизости каждую секунду получают магический урон в размере {{ damagecalc }} от своего максимального запаса здоровья . Кроме того, во время действия умения перезарядка Вытягивающего удара сокращена на {{ qcdr*100 }}%.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Leona_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Leona_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Щит рассвета</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Leona"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Leona:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Леона использует свой щит для выполнения следующей автоатаки, нанося дополнительный магический урон и оглушая цель.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Следующая автоатака Леоны оглушает врага на {{ stunduration }} сек. и дополнительно наносит {{ totaldamagetooltip }} ед. маг. урона.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Ezreal_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Ezreal_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Мистический выстрел</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Ezreal"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ezreal:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Эзреаль выстреливает энергетическим зарядом. Если заряд попадает в противника, тому наносится урон, а время перезарядки умений Эзреаля немного сокращается.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Эзреаль выпускает заряд энергии, нанося {{ damage }} физического урона первому пораженному врагу и сокращая перезарядку своих умений на {{ cdrefund }} сек.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Source_Taric">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#SourceDocument"/>
    <rdfs:label>Source_Taric</rdfs:label>
    <lol:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://ddragon.leagueoflegends.com/cdn/16.20.1/data/ru_RU/champion/Taric.json</lol:sourceURL>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Camille_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Camille_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Протокол точности</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Camille"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Camille:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Следующая автоатака Камиллы наносит дополнительный урон и увеличивает ее скорость передвижения. В течение короткого времени это умение можно использовать снова. Урон от второго удара увеличивается, если Камилла нанесет второй удар с задержкой.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Следующая автоатака Камиллы дополнительно наносит {{ bonusdamage }} физического урона и дает ей {{ msbonus*100 }}% скорости передвижения на {{ msduration }} сек. Это умение можно применить повторно в течение {{ qtotalrecasttime }} сек. Если автоатака, усиленная повторным применением умения, поражает врага хотя бы спустя {{ qrampuptime }} сек. после первой атаки, дополнительный урон увеличивается до {{ empoweredbonusdamage }} и {{ damageconversionpercentage }} от урона этой атаки будет чистым . При нанесении урона это умение активирует эффекты заклинаний. {{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Jayce_P">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
    <rdfs:label>Jayce_P</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Хекстек-конденсатор</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Jayce"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Jayce:P</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Когда Джейс меняет оружие, его скорость передвижения ненадолго увеличивается.</lol:description>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Irelia_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Irelia_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Дерзкий танец</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Irelia"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Irelia:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ирелия готовится произвести удар, урон которого зависит от времени подготовки. Во время подготовки Ирелия получает меньше физического урона.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Начало подготовки: Ирелия встает в защитную стойку на время до {{ maxduration }} сек. - при этом она не может совершать действия, но уменьшает получаемый физический урон на {{ finalphysicaldr }}% и получаемый магический урон на {{ finalmagicdr }}%. Применение: Ирелия совершает удар своими клинками, нанося {{ mindamagecalc }} физического урона . Этот урон увеличивается на величину до {{ maxdamagecalc }} в зависимости от времени подготовки.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Source_Kayle">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#SourceDocument"/>
    <rdfs:label>Source_Kayle</rdfs:label>
    <lol:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://ddragon.leagueoflegends.com/cdn/16.20.1/data/ru_RU/champion/Kayle.json</lol:sourceURL>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Viktor_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Viktor_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Гравитационное поле</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Viktor"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Viktor:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Виктор создает область высокой гравитации, замедляя всех врагов внутри нее. Враги, слишком долго задерживающиеся в этой области, оглушаются. Улучшение: умения Виктора замедляют врагов.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Виктор устанавливает гравитационную ловушку на {{ fieldduration }} сек., которая замедляет находящихся внутри врагов на {{ slowpotency*-1 }}%. Враги, которые находятся в ловушке в течение 1.25 сек., оглушаются на {{ stunduration }} сек. Улучшение: умения Виктора замедляют врагов на {{ augmentslow }}% на 1 сек. {{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Talon_P">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
    <rdfs:label>Talon_P</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Острие клинка</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Talon"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Talon:P</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Умения Талона ранят чемпионов и больших монстров, суммируясь до 3 раз. Когда Талон совершает автоатаку по цели с 3 ранениями, она начинает кровоточить, получая большой периодический урон.</lol:description>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Brand_E">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Brand_E</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Воспламенение</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Brand"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Brand:E</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">E</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Брэнд воспламеняет цель, после чего пламя распространяется на ближайших врагов, нанося магический урон. Если цель в огне, дальность распространения Воспламенения увеличивается вдвое.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Брэнд вызывает огненную вспышку, которая поражает указанную цель, нанося {{ edamagecalc }} магического урона окружающим бойцам. Если цель подожжена , дальность распространения увеличивается вдвое.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Source_Karthus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#SourceDocument"/>
    <rdfs:label>Source_Karthus</rdfs:label>
    <lol:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://ddragon.leagueoflegends.com/cdn/16.20.1/data/ru_RU/champion/Karthus.json</lol:sourceURL>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Source_Sivir">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#SourceDocument"/>
    <rdfs:label>Source_Sivir</rdfs:label>
    <lol:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://ddragon.leagueoflegends.com/cdn/16.20.1/data/ru_RU/champion/Sivir.json</lol:sourceURL>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Ornn_E">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Ornn_E</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Обжигающий рывок</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Ornn"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ornn:E</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">E</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Орн делает рывок и наносит урон всем врагам на своем пути. Если Орн сталкивается с препятствием, вокруг него самого возникает ударная волна, которая наносит урон и подбрасывает врагов.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Орн совершает рывок и наносит всем пораженным врагам {{ totaldamage }} физического урона . Если Орн сталкивается с элементом ландшафта, возникает ударная волна, которая подбрасывает врагов на {{ knockupduration }} сек. и наносит такой же урон тем, кто не был поражен рывком. Рывок Орна уничтожает магмовые столпы и элементы ландшафта, созданные врагами.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Qiyana_E">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Qiyana_E</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Дерзость</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Qiyana"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Qiyana:E</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">E</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Киана совершает рывок к врагу, нанося урон.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Киана совершает рывок сквозь врага и наносит ему {{ damage }} физического урона .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Xayah_E">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Xayah_E</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Зов клинков</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Xayah"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Xayah:E</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">E</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Шая призывает к себе все сброшенные перья, нанося урон пораженным врагам и обездвиживая их.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Шая призывает назад все свои перья , нанося каждым из них {{ featherdamage }} физического урона . Если враг поражается хотя бы {{ featherthreshold }} перьями , он обездвиживается на {{ rootduration }} сек.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Source_Varus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#SourceDocument"/>
    <rdfs:label>Source_Varus</rdfs:label>
    <lol:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://ddragon.leagueoflegends.com/cdn/16.20.1/data/ru_RU/champion/Varus.json</lol:sourceURL>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Vayne_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Vayne_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Кувырок</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Vayne"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Vayne:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Вейн совершает кувырок, чтобы занять более удобную позицию для выстрела. Ее следующая автоатака наносит дополнительный урон.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Вейн совершает кувырок на небольшое расстояние, а ее следующая автоатака дополнительно наносит {{ adratiobonus }} физического урона . При нанесении урона это умение активирует эффекты заклинаний. {{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Mel_P">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
    <rdfs:label>Mel_P</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Обжигающий свет</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Mel"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mel:P</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">При следующей автоатаке после применения умения Мэл дополнительно выпускает 3 снаряда (максимум – 9). Нанося урон автоатаками и умениями, Мэл накладывает на цель заряды ошеломления (суммируются бесконечно). Поразив врага с достаточным количеством зарядов, она мгновенно добивает его.</lol:description>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Varus_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Varus_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Оскверненный колчан</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Varus"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Varus:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пассивно: автоатаки Варуса наносят дополнительный магический урон и накладывают Осквернение. Другие умения Варуса поглощают заряды Осквернения, нанося цели дополнительный магический урон, зависящий от ее максимального запаса здоровья. Активно: Варус усиливает следующую Пробивающую стрелу.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пассивно: автоатаки Варуса дополнительно наносят {{ onhitdamage }} ед. маг. урона и накладывают на цели заряд Осквернения на {{ debuffduration }} сек. (макс. заряды – {{ maxstacks }}). Другие умения Варуса взрывают заряды Осквернения , нанося маг. урон в размере {{ percenthpperstack }} от макс. здоровья за заряд (макс. урон – {{ maxpercenthpperstack }} от макс. здоровья ). Взрыв Осквернения на чемпионах и эпических монстрах также сокращает перезарядку баз. умений Варуса на {{ cdrperblightstack*100 }}% от макс. значения за заряд. Активно: следующая Пробивающая стрела Варуса дополнительно наносит маг. урон в размере {{ qempowerpercenthp }} от недост. здоровья . Урон растет до {{ maxqempowerpercenthp }} от недост. здоровья в зависимости от времени подготовки.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Source_Nilah">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#SourceDocument"/>
    <rdfs:label>Source_Nilah</rdfs:label>
    <lol:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://ddragon.leagueoflegends.com/cdn/16.20.1/data/ru_RU/champion/Nilah.json</lol:sourceURL>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N553d87ba68be4e02bedefc629a109784">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://example.org/lol-ontology#hasAbility"/>
    <owl:someValuesFrom rdf:nodeID="N95e0114a76ff479cba0ba558cd3fa661"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Cassiopeia_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Cassiopeia_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Миазмы</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Cassiopeia"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cassiopeia:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Кассиопея выпускает несколько облаков яда, которые наносят небольшой урон, замедляют и парализуют врагов, проходящих сквозь них. Парализованные враги не могут использовать умения перемещения.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Кассиопея выплевывает перед собой яд, оставляя на земле токсичные лужи на {{ cloudduration }} сек. Враги в лужах получают {{ damagepersecond }} ед. магического урона в секунду, а также отравляются , парализуются и замедляются на {{ slowpercent }}%.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Singed_E">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Singed_E</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Бросок</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Singed"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Singed:E</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">E</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Синджед перебрасывает выбранного противника за спину, нанося ему урон. Если враг приземляется в липкой зоне, созданной Мегаклеем, он обездвиживается.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Синджед перебрасывает врага через плечо, нанося магический урон в размере {{ basedamage }} ед. плюс {{ maxhpdamage }}% от макс. запаса здоровья . Если Синджед бросает цель в Мегаклей , она обездвиживается на {{ rootduration }} сек.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Malzahar_E">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Malzahar_E</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пагубные видения</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Malzahar"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Malzahar:E</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">E</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Мальзахар наполняет разум врага ужасными видениями его гибели, нанося урон в течение нескольких секунд. Использование других умений на этой цели обновляет продолжительность действия видений. Если цель умирает, пока страдает от видений, они переходят на ближайшего врага, а Мальзахар восстанавливает себе некоторое количество маны. Враги, находящиеся под действием этого умения, притягивают войдлингов.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Мальзахар вызывает у цели ужасные видения, нанося {{ totaldamage }} магического урона в течение {{ duration }} сек. Применение Зова Бездны или Потусторонней хватки к цели обновляет продолжительность видений. Если цель умирает, видения перекидываются на ближайшего врага, а Мальзахар восстанавливает себе {{ manarestore }} маны . Пагубные видения добивают миньонов, у которых осталось менее {{ minionexecutethreshold }} здоровья. {{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Source_Garen">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#SourceDocument"/>
    <rdfs:label>Source_Garen</rdfs:label>
    <lol:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://ddragon.leagueoflegends.com/cdn/16.20.1/data/ru_RU/champion/Garen.json</lol:sourceURL>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Morgana_R_MovementSpeedBoost_Self">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#AbilityEffect"/>
    <rdfs:label>Morgana_R_MovementSpeedBoost_Self</rdfs:label>
    <lol:hasMechanic rdf:resource="https://example.org/lol-ontology#MovementSpeedBoost"/>
    <lol:hasTargetType rdf:resource="https://example.org/lol-ontology#Self"/>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Morgana"/>
    <lol:conditionText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Моргана увеличивает собственную скорость при применении R.</lol:conditionText>
    <lol:evidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Моргана приковывает себя цепями к окружающим вражеским чемпионам, нанося {{ totaldamage }} магического урона и замедляя их на {{ slowpercent }}%. Через {{ chainduration }} сек. враги, которые не смогли разорвать цепи, дополнительно получают {{ totaldamage }} магического урона и оглушаются на {{ stunduration }} сек. При применении этого умения Моргана увеличивает свою скорость передвижения на {{ hastepercent }}% .{{ spellmodifierdescriptionappend }}</lol:evidenceText>
    <lol:evidenceField rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tooltip_text</lol:evidenceField>
    <lol:reviewStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">reviewed_by_assistant</lol:reviewStatus>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Evelynn_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Evelynn_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Всплеск ненависти</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Evelynn"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Evelynn:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Эвелинн бьет врага своим хлыстом, нанося урон первому пораженному бойцу. Затем она может несколько раз выпустить цепь шипов в ближайших врагов.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Эвелинн бьет плетью, нанося {{ missiledamage }} магического урона первому пораженному врагу. Следующие 3 автоатаки или умения Эвелинн против этого бойца дополнительно наносят {{ totalbonusdamage }} магического урона . Эвелинн может повторно применять это умение до {{ qstackcount }} раз. Повторное применение: Эвелинн выпускает шипы сквозь ближайшего врага, нанося {{ missiledamage }} магического урона всем пораженным врагам.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Ambessa_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Ambessa_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Отречение</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Ambessa"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ambessa:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Амбесса получает щит и после небольшой подготовки бьет по земле, нанося урон врагам поблизости. Если во время подготовки она блокирует урон от любых бойцов, кроме миньонов, это умение наносит больше урона.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Амбесса получает щит прочностью {{ calc_shield }} на {{ shield_duration }} сек. и собирается с силами в течение {{ buff_duration }} сек. Затем она бьет по земле, нанося врагам поблизости {{ calc_damage_low }} физического урона . Этот урон увеличивается до {{ calc_damage_high }} , если во время подготовки она блокирует урон от вражеских чемпионов, больших монстров или строений.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Source_Alistar">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#SourceDocument"/>
    <rdfs:label>Source_Alistar</rdfs:label>
    <lol:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://ddragon.leagueoflegends.com/cdn/16.20.1/data/ru_RU/champion/Alistar.json</lol:sourceURL>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Vi_E">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Vi_E</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Грубая сила</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Vi"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Vi:E</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">E</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Следующая автоатака Вай нанесет урон как цели, так и врагам позади нее.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Следующая автоатака Вай наносит {{ totaldamagetooltip }} физического урона цели и врагам за ней. У этого умения может быть 2 заряда (новый заряд дается раз в {{ ammorechargetime }} сек.).{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Seraphine_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Seraphine_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Объемный звук</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Seraphine"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Seraphine:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Серафина накладывает щит на союзников поблизости и ускоряет их. Если на Серафину уже наложен щит, она также лечит союзников поблизости.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Серафина поет песню для союзных чемпионов поблизости, увеличивая их скорость передвижения на {{ hastevalueallies }} и свою скорость передвижения на {{ wmsbonustotal }} (эффект ослабевает со временем) , а также накладывая на всех щит прочностью {{ shieldvalueseraphine }} на {{ shieldduration }} сек. Если на Серафину уже действует щит , она приглашает союзников присоединиться к ней, восстанавливая им {{ wmissinghpheal }}% от недостающего здоровья через {{ whealsplitdelay }} сек.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Katarina_E">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Katarina_E</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Шунпо</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Katarina"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Katarina:E</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">E</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Катарина телепортируется к цели, нанося урон этой цели, если ей окажется враг, или ближайшему врагу.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Катарина мгновенно перемещается к выбранному союзнику, врагу или кинжалу , нанося {{ totaldamage }} магического урона , если целью оказался враг. Иначе этот урон получает ближайший противник. Каждый раз, когда Катарина подбирает кинжал , перезарядка этого умения сокращается на {{ daggercooldownreduction }} сек. ({{ tooltipdaggerreduction }} ). Катарина может переместиться в любое место рядом с целью.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Kassadin_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Kassadin_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Сфера пустоты</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Kassadin"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Kassadin:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Кассадин выпускает во врага сгусток энергии Бездны, который наносит урон и прерывает использование умений. Кроме того, избыток энергии формирует вокруг Кассадина временный щит, поглощающий магический урон.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Кассадин выпускает сферу энергии Бездны, нанося {{ totaldamage }} магического урона и прерывая врагов, которые применяют умения. Кроме того, Кассадин получает щит от магического урона прочностью {{ totalshield }} на 1.5 сек.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Taric_P">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
    <rdfs:label>Taric_P</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Бравада</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Taric"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Taric:P</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">После каждого использования умения Тарик проводит 2 следующие автоатаки в быстрой последовательности. Также эти автоатаки усилены: они дополнительно наносят магический урон и сокращают перезарядку базовых умений.</lol:description>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Source_Naafiri">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#SourceDocument"/>
    <rdfs:label>Source_Naafiri</rdfs:label>
    <lol:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://ddragon.leagueoflegends.com/cdn/16.20.1/data/ru_RU/champion/Naafiri.json</lol:sourceURL>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Source_Lucian">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#SourceDocument"/>
    <rdfs:label>Source_Lucian</rdfs:label>
    <lol:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://ddragon.leagueoflegends.com/cdn/16.20.1/data/ru_RU/champion/Lucian.json</lol:sourceURL>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Source_Yuumi">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#SourceDocument"/>
    <rdfs:label>Source_Yuumi</rdfs:label>
    <lol:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://ddragon.leagueoflegends.com/cdn/16.20.1/data/ru_RU/champion/Yuumi.json</lol:sourceURL>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N239897f626b5479b921caee08e76b185">
    <rdf:first rdf:resource="https://example.org/lol-ontology#MageChampion"/>
    <rdf:rest rdf:nodeID="N14e71e0562134588b71eb5817a7249c2"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Heimerdinger_P">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
    <rdfs:label>Heimerdinger_P</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Тяга к хекстеку</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Heimerdinger"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Heimerdinger:P</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Увеличивает скорость передвижения при нахождении рядом с союзными башнями или турелями Хеймердингера.</lol:description>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Aurora_R">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Aurora_R</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Междумирье</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Aurora"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Aurora:R</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Аврора прыгает в выбранном направлении и выпускает ударную волну, которая замедляет врагов и наносит им урон. Затем она создает область, которая замедляет врагов внутри. Аврора может телепортироваться от одного края области к другому.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Аврора прыгает в выбранном направлении. По приземлении она соединяет два мира, выпуская волну энергии, которая наносит {{ damagecalc }} ед. магического урона пораженным врагам и замедляет их на {{ slowpercent*-100 }}% на 2 сек. Область двух миров существует {{ areaduration }} сек. и дает Авроре Потустороннюю прогулку на {{ rbuffduration }} сек. Она может перемещаться от одного края области к другому. Враги, которые пытаются зайти в область или выйти из нее, замедляются на {{ exitslowpercent*-100 }}% на {{ stunduration }} сек. Умение можно применить повторно , чтобы преждевременно прекратить его действие.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#XinZhao_E">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>XinZhao_E</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Смелый рывок</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_XinZhao"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">XinZhao:E</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">E</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ксин Жао совершает рывок к цели, увеличивая свою скорость атаки, а также нанося урон всем врагам в области поражения и ненадолго их замедляя. Дальность этого умения увеличена против вызванных на бой целей.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ксин Жао совершает рывок к цели, нанося {{ chargedamage }} ед. маг. урона врагам поблизости и замедляя их на {{ slowamount }}% на {{ slowduration }} сек. Ксин Жао получает {{ f1 }}% (%i:scaleAS%%i:scaleAP%) скорости атаки на {{ asduration }} сек. Дальность умения выше против вызванных на бой врагов. {{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Blitzcrank_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Blitzcrank_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ускорение</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Blitzcrank"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Blitzcrank:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Блицкранк перегружает себя, значительно увеличивая свои скорость передвижения и скорость атаки. По окончании перегрузки его скорость передвижения на время уменьшается.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Блицкранк перегружает себя, увеличивая скорость передвижения на {{ movespeedmod*100 }}% (эффект ослабевает со временем) и скорость атаки на {{ attackspeedmod*100 }}% на {{ duration }} сек. По окончании действия эффекта Блицкранк замедляется на {{ movespeedmodreduction*100 }}% на {{ slowduration }} сек.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Source_Graves">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#SourceDocument"/>
    <rdfs:label>Source_Graves</rdfs:label>
    <lol:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://ddragon.leagueoflegends.com/cdn/16.20.1/data/ru_RU/champion/Graves.json</lol:sourceURL>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Akali_P">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
    <rdfs:label>Akali_P</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Метка убийцы</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Akali"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Akali:P</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">При нанесении урона умением чемпиону вокруг него появляется круг энергии. При выходе из круга Акали усиливает следующую автоатаку, увеличивая ее дальность и урон.</lol:description>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Rammus_R">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Rammus_R</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Мощное приземление</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Rammus"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Rammus:R</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Раммус подлетает в воздух, а затем приземляется в выбранном месте, нанося пораженным врагам магический урон и замедляя их. При применении во время действия Катящегося шара Раммус также подбрасывает врагов в центре области поражения.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Раммус подлетает в воздух, а затем приземляется в выбранном месте, нанося пораженным врагам {{ initialdamagecalc }} ед. магического урона и замедляя их на {{ slowamount*100 }}% на {{ slowduration }} сек. Если это умение применяется во время действия Катящегося шара , враги в центре области дополнительно получают {{ spell.powerball:powerballdamage }} ед. магического урона и подбрасываются на {{ knockupduration }} сек. После приземления Раммус создает в области поражения ударные волны ({{ numberofpulses }}) в течение {{ buffduration }} сек., которые замедляют цели повторно. Дальность этого умения зависит от скорости передвижения Раммуса.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Source_RekSai">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#SourceDocument"/>
    <rdfs:label>Source_RekSai</rdfs:label>
    <lol:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://ddragon.leagueoflegends.com/cdn/16.20.1/data/ru_RU/champion/RekSai.json</lol:sourceURL>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Xayah_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Xayah_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Смертоносные перья</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Xayah"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Xayah:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Шая создает вихрь из клинков, который увеличивает ее скорость атаки и урон автоатак, а также увеличивает ее скорость передвижения при атаке чемпиона.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Шая создает вихрь из клинков на {{ wattackspeedduration }} сек., получая {{ wattackspeedamount }}% скорости атаки . Кроме того, при ее автоатаках выпускается 2-й клинок, наносящий {{ bonusdamagepercent }}% урона. Когда 2-й клинок поражает чемпиона, Шая получает {{ wmovespeedamount }}% скорости передвижения на {{ wmovespeedduration }} сек. Если рядом Рэйкан, он тоже получает эффекты этого умения, но его скорость передвижения растет, когда цель поражает не он, а Шая .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Nami_R">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Nami_R</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Приливная волна</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Nami"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nami:R</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Нами призывает огромную волну, которая наносит урон врагам, подбрасывает и замедляет их. Союзники, задетые волной, получают удвоенное усиление Бурных волн.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Нами призывает огромную волну, подбрасывающую на 0,5 сек., замедляющую на {{ slowamount }}% и наносящую {{ totaldamage }} ед. маг. урона . Длительность замедления растет с расстоянием, пройденным волной (до {{ maxslowduration }} сек.). Союзники, задетые волной, получают удвоенное усиление Бурных волн .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Illaoi_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Illaoi_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Удар щупальцем</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Illaoi"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Illaoi:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Увеличивает наносимый щупальцами урон. При активации умения Иллаой призывает щупальце, которое бьет в указанном направлении, нанося физический урон всем пораженным врагам.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пассивно: атака щупалец дополнительно наносит {{ spell.illaoiq:tentacledamageamp*100 }}% урона (текущее увеличение: {{ spell.illaoiq:tentacledamagetotal }} ед. физического урона ). Активно: Иллаой взмахивает своим идолом, приказывая щупальцу атаковать в указанном направлении.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#TwistedFate_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>TwistedFate_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Дикие карты</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_TwistedFate"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TwistedFate:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Твистед Фэйт бросает веером три карты, нанося урон всем врагам, которых они заденут.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Твистед Фэйт бросает три карты, каждая из которых наносит {{ totaldamage }} магического урона .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Janna_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Janna_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Западный ветер</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Janna"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Janna:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Жанна призывает элементаля воздуха, пассивно увеличивающего ее скорость передвижения и позволяющего ей проходить сквозь других бойцов. Умение можно активировать, чтобы нанести урон и замедлить врага.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пассивно: скорость передвижения Жанны увеличена на {{ totalms }} , и на нее действует призрачность. Активно: Жанна поражает врага стихией, замедляя его на {{ totalslow }} на {{ slowduration }} сек. и нанося {{ totaldamage }} + {{ spell.tailwindself:bonusdamage }} магического урона .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Pyke_P">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
    <rdfs:label>Pyke_P</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Дар утопленников</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Pyke"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pyke:P</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Прячась от врагов, Пайк восстанавливает здоровье, которое недавно потерял в бою с вражескими чемпионами. Кроме того, он не может увеличить свой максимальный запас здоровья из любых источников, получая вместо этого дополнительную силу атаки.</lol:description>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Viego_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Viego_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Призрачная пасть</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Viego"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Viego:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">После подготовки Виего совершает рывок, выпуская сгусток черного тумана, который оглушает первого пораженного врага.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Начало подготовки: Виего начинает собирать черный туман, замедляя себя на {{ selfslowpercent*100 }}%. Применение: Виего совершает рывок и выпускает вперед собранный туман, который наносит первому пораженному врагу {{ totaldamage }} магического урона и оглушает его на {{ stunduration }}-{{ maxstuntt }} сек. в зависимости от времени подготовки. {{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Source_Zoe">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#SourceDocument"/>
    <rdfs:label>Source_Zoe</rdfs:label>
    <lol:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://ddragon.leagueoflegends.com/cdn/16.20.1/data/ru_RU/champion/Zoe.json</lol:sourceURL>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Source_Renata">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#SourceDocument"/>
    <rdfs:label>Source_Renata</rdfs:label>
    <lol:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://ddragon.leagueoflegends.com/cdn/16.20.1/data/ru_RU/champion/Renata.json</lol:sourceURL>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Source_Ekko">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#SourceDocument"/>
    <rdfs:label>Source_Ekko</rdfs:label>
    <lol:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://ddragon.leagueoflegends.com/cdn/16.20.1/data/ru_RU/champion/Ekko.json</lol:sourceURL>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Sion_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Sion_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Опустошающий удар</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Sion"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sion:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Сион копит силы, а затем проводит мощнейший удар, нанося урон всем врагам перед собой. Если Сион копит силы достаточное время, пораженные враги также подбрасываются и оглушаются.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Начало подготовки: Сион до 2 сек. копит силы для мощного удара. Применение: Сион бьет по земле топором, ненадолго замедляя врагов и нанося им {{ mindamagetotal }}-{{ maxdamagetotal }} физического урона (в зависимости от времени подготовки). Если Сион копит силы как минимум 1 сек., пораженные враги подбрасываются и оглушаются на {{ basestuntime }}-2.25 сек. (в зависимости от времени подготовки).{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Nunu_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Nunu_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Огромный снежный ком</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Nunu"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nunu:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Виллумп создает снежный ком, который растет в размере и ускоряется по мере движения. Снежный ком подбрасывает врагов и наносит им урон.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Нуну и Виллумп создают снежный ком и начинают его катить, постепенно увеличивая скорость и размер кома. Их скорость поворота снижена, но чем дольше Нуну и Виллумп поворачивают в одном направлении, тем больше она становится. Снежный ком наносит от {{ noimpactsnowballdamage }} до {{ maximumsnowballdamage }} магического урона и подбрасывает на {{ baseknockupduration }}-{{ maximumstunduration }} сек., когда врезается в чемпиона, большого монстра или стену. Эти значения зависят от пройденного расстояния. Нуну и Виллумп могут повторно применить это умение, чтобы преждевременно отпустить снежный ком.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Fizz_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Fizz_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Морской трезубец</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Fizz"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fizz:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Автоатаки Физза вызывают у врагов кровотечение, нанося магический урон в течение нескольких секунд. Физз может усилить свою следующую автоатаку, чтобы она нанесла дополнительный урон и усилила его последующие атаки на короткое время.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пассивно : автоатаки Физза вызывают у врагов кровотечение, которое наносит {{ dotdamage }} магического урона в течение {{ bleedduration }} сек. Активно : следующая автоатака Физза дополнительно наносит {{ activedamage }} магического урона . Если эта автоатака убивает цель, Физз восстанавливает {{ onkillmanarefund }} маны и сокращает время перезарядки этого умения на {{ onkillnewcooldown }} сек. Если цель не погибает, автоатаки Физза начинают дополнительно наносить {{ onhitbuffdamage }} магического урона в течение следующих {{ onhitbuffduration }} сек.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Teemo_E">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Teemo_E</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Отравленный выстрел</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Teemo"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Teemo:E</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">E</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Автоатаки Тимо отравляют цель %i:OnHit% при попадании , нанося урон сразу и затем дополнительный урон каждую секунду в течение 4 сек.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пассивно: автоатаки Тимо отравляют цель %i:OnHit% при попадании , дополнительно нанося {{ impactcalculateddamage }} ед. маг. урона плюс {{ totaldotdamage }} ед. маг. урона в течение {{ poisonduration }} сек.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Yunara_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Yunara_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Дуга правосудия | Дуга погибели</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Yunara"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Yunara:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Юнара выпускает в воздух вращающиеся четки, которые наносят врагам урон и замедляют их. В просветленном состоянии она выпускает луч энергии, который наносит врагам урон и замедляет их.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Юнара выпускает в воздух четки, которые наносят врагам {{ calc_damage_initial }} ед. магического урона и замедляют их на {{ calc_slow }} (эффект ослабевает в течение {{ slow_duration }} сек.) . Четки дополнительно наносят {{ calc_damage_per_second }} ед. магического урона в секунду. Просветленное состояние – Дуга погибели : Юнара выпускает луч энергии, который наносит врагам {{ spell.yunarar:calc_rw_damage }} ед. магического урона и замедляет их на {{ spell.yunarar:calc_rw_slow_amount }} (эффект ослабевает в течение {{ spell.yunarar:rw_slow_duration }} сек.) .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Senna_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Senna_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Прощальные объятия</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Senna"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Senna:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Сенна выпускает вперед волну черного тумана. При поражении врага туман жадно вцепляется в него, спустя короткое время обездвиживая основную цель и всех вокруг нее.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Сенна выпускает вперед черный туман, который наносит {{ damage }} физического урона первому пораженному врагу. Спустя {{ delaytime }} сек. эта цель и другие враги поблизости оказываются обездвижены на {{ rootduration }} сек.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Warwick_E">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Warwick_E</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Первобытный вой</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Warwick"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Warwick:E</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">E</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">В течение 2,5 сек. Варвик получает меньше урона. По окончании действия умения или при повторном использовании Варвик издает вой, заставляя ближайших врагов бежать в страхе в течение 1 сек.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Варвик получает на {{ dramount }}% меньше урона в течение {{ drduration }} сек. После он воет, пугая врагов поблизости на {{ fearduration }} сек. Варвик может повторно применить это умение, чтобы завершить его преждевременно.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Aatrox_R">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Aatrox_R</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Губитель мира</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Aatrox"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Aatrox:R</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Атрокс принимает демоническую форму, пугая ближайших вражеских миньонов, а также увеличивая свою силу атаки, принимаемое лечение и скорость передвижения. Если он зарабатывает убийство или содействие, продолжительность эффекта увеличивается.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Атрокс принимает свою истинную демоническую форму, пугая миньонов поблизости на {{ rminionfearduration }} сек. и получая {{ rmovementspeedbonus*100 }}% скорости передвижения (эффект пропадает в течение {{ rduration }} сек.). Кроме того, он получает {{ rtotaladamp*100 }}% силы атаки и увеличивает эффективность самолечения на {{ rhealingamp*100 }}% до конца действия умения. Убийства и содействия увеличивают продолжительность действия этого эффекта на {{ rextension }} сек. и снова дают прибавку к скорости передвижения .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Source_JarvanIV">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#SourceDocument"/>
    <rdfs:label>Source_JarvanIV</rdfs:label>
    <lol:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://ddragon.leagueoflegends.com/cdn/16.20.1/data/ru_RU/champion/JarvanIV.json</lol:sourceURL>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Source_Shen">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#SourceDocument"/>
    <rdfs:label>Source_Shen</rdfs:label>
    <lol:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://ddragon.leagueoflegends.com/cdn/16.20.1/data/ru_RU/champion/Shen.json</lol:sourceURL>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#name">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>name</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Zyra_P">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
    <rdfs:label>Zyra_P</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Терновый сад</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Zyra"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Zyra:P</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Периодически вокруг Зайры появляются семена. Чем выше ее уровень, тем быстрее появляются семена. Зайра может использовать умения, чтобы из семени развилось растение, которое будет за нее сражаться.</lol:description>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Source_Brand">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#SourceDocument"/>
    <rdfs:label>Source_Brand</rdfs:label>
    <lol:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://ddragon.leagueoflegends.com/cdn/16.20.1/data/ru_RU/champion/Brand.json</lol:sourceURL>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Hwei_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Hwei_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Тема: Безмятежность</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Hwei"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hwei:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Хвэй представляет себе безмятежность, получая возможность рисовать образы, которые помогают ему и союзникам. Применив Безмятежность, Хвэй переключается на умения с полезными эффектами: Быстрое течение, Тихую заводь и Парящие огоньки.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Хвэй рисует безмятежные образы, которые наделяют полезными эффектами его самого и союзных чемпионов. Быстрое течение Хвэй создает стремительный водный поток, который дает {{ tooltip_wqmovespeed }} скорости передвижения всем союзникам. Тихая заводь Хвэй создает защитную заводь, которая накладывает на союзных чемпионов щиты прочностью {{ tooltip_wwshieldamount }} (постепенно увеличивается). Союзники получают щиты прочностью {{ spell.hweiww:tooltipallymod*100 }}% от обычной. Парящие огоньки Хвэй рисует вокруг себя три парящих огонька, которые усиливают три его умения или автоатаки. Они дополнительно наносят {{ tooltip_weonhitdamage }} магического урона и восстанавливают {{ tooltip_weonhitmanarestore }} маны .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Yasuo_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Yasuo_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Стена ветра</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Yasuo"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Yasuo:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ясуо создает движущуюся стену, которая блокирует все выстрелы врагов в течение 4 сек.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ясуо создает движущуюся стену ветра, которая блокирует все вражеские снаряды в течение 4 сек.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Source_Hwei">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#SourceDocument"/>
    <rdfs:label>Source_Hwei</rdfs:label>
    <lol:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://ddragon.leagueoflegends.com/cdn/16.20.1/data/ru_RU/champion/Hwei.json</lol:sourceURL>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Shaco_P">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
    <rdfs:label>Shaco_P</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Удар в спину</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Shaco"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Shaco:P</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">При применении со спины автоатаки и Отравленные заточки Шако наносят дополнительный урон.</lol:description>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#MovementSpeedBoost">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#Mechanic"/>
    <rdfs:label>MovementSpeedBoost</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ускорение</lol:name>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Ashe_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Ashe_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Сосредоточенность стрелка</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Ashe"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ashe:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Автоатаки Эш повышают Сосредоточенность. Когда накапливается максимальное количество зарядов, умение можно активировать. При этом все заряды Сосредоточенности поглощаются, и скорость атаки Эш на некоторое время увеличивается. Кроме того, в течение этого времени при каждой автоатаке Эш выпускает град стрел.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пассивно: каждая автоатака Эш дает ей заряд на {{ stackduration }} сек. Набрав {{ maxstacks }} зар., она может применить это умение. Активно: Эш на {{ buffduration }} сек. получает {{ bonusas }}% скорости атаки , и ее автоатаки в течение этого времени наносят {{ empowereddamage }} ед. урона .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Akali_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Akali_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Покров сумерек</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Akali"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Akali:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Акали создает дымовую завесу и ненадолго увеличивает свою скорость передвижения. Находясь внутри, она становится невидимой, а враги не могут выбрать ее в качестве цели для умений или автоатак. При применении автоатак или умений Акали ненадолго раскрывает себя.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Акали бросает дымовую бомбу, создавая растущую завесу, которая существует {{ baseduration }} сек. и дает Акали {{ movementspeed }}% скорости передвижения (эффект пропадает в течение {{ movementspeedduration }} сек.). Пока существует завеса, максимальный запас энергии Акали увеличивается на {{ energyrestore }}. Пока Акали находится в дыму, она невидима .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Neeko_E">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Neeko_E</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Оплетающие тернии</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Neeko"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Neeko:E</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">E</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Нико выпускает тернии, которые обездвиживают всех врагов на пути и наносят им урон. Если тернии убивают врага или проходят сквозь чемпиона, они становятся больше и быстрее, а продолжительность их обездвиживания увеличивается.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Нико выпускает тернии, которые наносят {{ basedamage }} магического урона и обездвиживают на {{ minrootduration }} сек. После поражения врага тернии становятся больше и быстрее, а продолжительность обездвиживания увеличивается до {{ maxrootduration }} сек.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N13885039630d4ab08c5e256521058afd">
    <rdf:first rdf:resource="https://example.org/lol-ontology#Ability"/>
    <rdf:rest rdf:nodeID="N87defabfe916485fb8e3c91e3e02b086"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Source_Zac">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#SourceDocument"/>
    <rdfs:label>Source_Zac</rdfs:label>
    <lol:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://ddragon.leagueoflegends.com/cdn/16.20.1/data/ru_RU/champion/Zac.json</lol:sourceURL>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N0ad30572c5e043f485d0f468469faf27">
    <rdf:first rdf:resource="https://example.org/lol-ontology#ChampionCategory"/>
    <rdf:rest rdf:nodeID="N13885039630d4ab08c5e256521058afd"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Varus_R">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Varus_R</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Цепь порчи</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Varus"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Varus:R</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Варус выпускает в указанном направлении щупальце порчи, которое наносит магический урон и обездвиживает первого вражеского чемпиона на своем пути, а затем пытается дотянуться до еще не пораженных чемпионов поблизости, чтобы обездвижить их тоже и нанести им урон.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Варус выпускает в указанном направлении щупальце порчи, обездвиживающее первого пораженного чемпиона на {{ rootduration }} сек. и наносящее ему {{ totaldamage }} ед. маг. урона . Обездвиженные враги получают {{ passivestacks }} зар. Осквернения в ходе действия умения. Порча распространяется на еще не пораженных чемпионов поблизости, нанося им такой же урон и обездвиживая .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N3a59cfa5bd724885b348ab4378951ac0">
    <rdf:first rdf:resource="https://example.org/lol-ontology#SourceDocument"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N79acaf50ed6b4cad9ee0a015dc8ad15a">
    <rdf:first rdf:resource="https://example.org/lol-ontology#hasAbility"/>
    <rdf:rest rdf:nodeID="N5d371dd1c24e45d69cdc6125893064a0"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Sion_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Sion_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Горнило душ</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Sion"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sion:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Сион защищает себя щитом. Он может повторно активировать умение через 3 секунды, чтобы вызвать детонацию щита и нанести магический урон окружающим врагам. Кроме того, когда Сион убивает врага, его максимальный запас здоровья увеличивается.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пассивно : Сион получает {{ hpperkill }} макс. здоровья при убийстве бойца или {{ hpperchampkill }} – при убийстве большого миньона или большого монстра либо участии в убийстве чемпиона. Активно : Сион получает щит прочностью {{ totalshield }} на 6 сек. Если щит существует {{ detonaterecastcooldown }} сек., Сион может повторно применить это умение, взорвав щит и нанеся врагам поблизости маг. урон в размере {{ totaldamage }} плюс {{ maxhpdamageratio }}% от макс. здоровья .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Nocturne_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Nocturne_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Покров тьмы</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Nocturne"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nocturne:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ноктюрн заряжает свои клинки, пассивно увеличивая скорость атаки. При активации умения Ноктюрн исчезает во тьме, создавая вокруг себя магический барьер, который блокирует следующее вражеское умение. При успешном блокировании пассивное увеличение скорости атаки Ноктюрна удваивается.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пассивно: Ноктюрн получает {{ activeas }}% скорости атаки . Активно: Ноктюрн на 1,5 сек. создает теневой барьер, блокирующий следующее вражеское умение. При успешном блокировании пассивный эффект умения усилен до {{ activeas*2 }}% на {{ doubleasduration }} сек.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N1075cc3491b04c38a97d4061e8a69293">
    <rdf:first rdf:resource="https://example.org/lol-ontology#hasMechanic"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Nasus_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Nasus_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Иссушение</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Nasus"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nasus:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Насус старит вражеского чемпиона, постепенно уменьшая его скорость передвижения и скорость атаки.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Насус старит чемпиона, замедляя его на {{ slowbase }}% (эффективность увеличивается до {{ maxslowtooltiponly }}% в течение {{ duration }} сек.). Кроме того, старение уменьшает скорость атаки цели на {{ attackspeedslowmult*100 }}% от замедления .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Pyke_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Pyke_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Кошмарное погружение</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Pyke"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pyke:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пайк получает маскировку и значительно увеличивает свою скорость передвижения (ускорение постепенно ослабевает со временем).</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пайк получает маскировку и {{ movespeed }}% скорости передвижения (снижается за {{ camoduration }} сек.).{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Source_Janna">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#SourceDocument"/>
    <rdfs:label>Source_Janna</rdfs:label>
    <lol:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://ddragon.leagueoflegends.com/cdn/16.20.1/data/ru_RU/champion/Janna.json</lol:sourceURL>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Amumu_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Amumu_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Отчаяние</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Amumu"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Amumu:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Амуму внушает отчаяние окружающим врагам, отчего они теряют долю от своего максимального запаса здоровья каждую секунду, а наложенное на них Проклятие обновляется.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Переключение: Амуму начинает плакать, нанося магический урон в размере {{ basedamage }} плюс {{ totalhealthdamage }}% от максимального запаса здоровья окружающим врагам каждую секунду и обновляя Проклятие .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Caitlyn_E">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Caitlyn_E</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Сеть 90 калибра</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Caitlyn"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Caitlyn:E</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">E</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Кейтлин выстреливает тяжелой сетью, замедляя цель. Отдача отбрасывает ее назад.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Кейтлин выстреливает сетью, отталкивая себя назад. Сеть замедляет первого пораженного врага на {{ slowamount }}% на {{ slowduration }} сек. и наносит {{ netdamage }} ед. маг. урона .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Fiora_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Fiora_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Выпад</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Fiora"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fiora:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Фиора делает выпад в указанном направлении и поражает ближайшего врага, нанося ему физический урон и накладывая эффекты при попадании.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Фиора делает выпад в выбранном направлении и поражает ближайшего врага, тотем или строение, нанося цели {{ totaldamage }} физического урона . Этот удар ставит в приоритет слабые места и врагов, которых можно убить. Если Фиора поражает врага, перезарядка этого умения сокращается на {{ cdrefundpercent*100 }}%.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Source_Rengar">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#SourceDocument"/>
    <rdfs:label>Source_Rengar</rdfs:label>
    <lol:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://ddragon.leagueoflegends.com/cdn/16.20.1/data/ru_RU/champion/Rengar.json</lol:sourceURL>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Sett_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Sett_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Головоломка</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Sett"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sett:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пассивно: Сетт сохраняет получаемый урон в виде выдержки. Активно: Сетт расходует всю выдержку, получает щит и бьет по площади. Враги в центре области поражения получают чистый урон, а по краям – физический.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пассивно: Сетт сохраняет {{ damagestored*100 }}% от полученного урона в виде выдержки - вплоть до {{ maxgrit }} . Выдержка начинает быстро заканчиваться через {{ adrenalinestoragewindow }} сек. после получения урона. Активно: Сетт расходует всю выдержку и получает щит прочностью {{ shieldconversion*100 }}% от потраченной выдержки (прочность щита уменьшается в течение {{ shieldmaxduration }} сек.). После этого Сетт совершает мощный удар, нанося врагам в центре чистый урон в размере {{ damagecalc }} плюс {{ damageconversion }} от потраченной выдержки (но не более {{ f1 }} урона ). Враги по краям получают физический урон .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#ActiveAbility">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>ActiveAbility</rdfs:label>
    <rdfs:comment xml:lang="ru">Активное умение, слот Q/W/E/R.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://example.org/lol-ontology#Ability"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Ashe_R">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Ashe_R</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Зачарованная ледяная стрела</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Ashe"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ashe:R</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Эш выпускает ледяную стрелу в указанном направлении. Если стрела попадает во вражеского чемпиона, она наносит урон и оглушает его на некоторое время (зависит от дальности полета стрелы). Окружающие цель противники тоже получают урон и замедляются.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Эш выпускает ледяную стрелу, которая оглушает первого пораженного чемпиона и наносит ему {{ rmaindamage }} ед. магического урона . Длительность оглушения зависит от дальности полета стрелы (но не может превышать {{ maxstunduration }} сек.). Окружающие чемпиона враги замедляются Морозным выстрелом .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Kaisa_P">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
    <rdfs:label>Kaisa_P</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Вторая кожа</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Kaisa"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Kaisa:P</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Автоатаки Кай'Сы накладывают заряды плазмы, нанося дополнительный магический урон. Обездвиживающие эффекты союзников также накладывают заряды плазмы. Кроме того, при покупке предметов Кай'Са развивает свои базовые умения, и у них появляются дополнительные эффекты.</lol:description>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Source_XinZhao">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#SourceDocument"/>
    <rdfs:label>Source_XinZhao</rdfs:label>
    <lol:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://ddragon.leagueoflegends.com/cdn/16.20.1/data/ru_RU/champion/XinZhao.json</lol:sourceURL>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Lulu_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Lulu_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Сияющая стрела</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Lulu"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Lulu:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пикс и Лулу выпускают по заряду магической энергии, нанося урон всем пораженным врагам, а также сильно их замедляя.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Лулу и Пикс выпускают по заряду магической энергии, которые наносят {{ totaldamage }} ед. магического урона и замедляют на {{ slowamount*-100 }}% (эффект ослабевает в течение {{ slowduration }} сек.). Дополнительные заряды наносят врагам {{ bonusmissiledamage }} ед. магического урона .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Ezreal_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Ezreal_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Искажение сущности</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Ezreal"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ezreal:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Эзреаль выпускает сферу, которая прикрепляется к первому пораженному чемпиону или объекту. Если Эзреаль поражает врага со сферой, она взрывается и наносит урон.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Эзреаль выпускает магическую сферу, которая прикрепляется к первому пораженному чемпиону, строению или эпическому лесному монстру на {{ detonationtimeout }} сек. Если Эзреаль попадает по этой цели умением или автоатакой, сфера взрывается, нанося {{ damage }} магического урона . Если сфера взрывается от умения, Эзреаль восстанавливает себе ману в размере стоимости этого умения плюс {{ manareturn }} .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Zaahen_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Zaahen_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ужасающее возвращение</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Zaahen"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Zaahen:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Заахен бьет в указанном направлении, нанося пораженным врагам урон и притягивая их к себе.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Заахен бьет в указанном направлении, нанося пораженным врагам {{ initialdamage }} ед. физического урона , а затем притягивает их к себе, нанося {{ secondarydamage }} ед. физического урона .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Olaf_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Olaf_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Мощный бросок</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Olaf"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Olaf:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Олаф бросает топор в указанную точку, нанося пораженным врагам урон, уменьшая их броню и замедляя. Олаф может подобрать топор после броска, сбросив перезарядку умения.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Олаф бросает топор, нанося целям {{ totaldamage }} ед. физического урона , а также замедляя их на {{ slowamount*100 }}% на время до {{ maxslowduration }} сек. (в зависимости от расстояния полета). Броня пораженных чемпионов уменьшается на {{ shredamount*100 }}% на {{ debuffduration }} сек. Если Олаф подбирает топор, перезарядка умения сокращается до {{ tooltipcdrefund }} сек. Если прошло {{ tooltipcdrefund }} сек., перезарядка сбрасывается полностью.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Caitlyn_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Caitlyn_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пилтоверский миротворец</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Caitlyn"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Caitlyn:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Кейтлин подстраивает свою винтовку в течение секунды, а затем делает выстрел, который пробивает врагов насквозь, нанося всем пораженным целям физический урон (каждая следующая цель получает меньший урон).</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Кейтлин подстраивает свою винтовку, а затем совершает выстрел пробивной пулей, нанося {{ initialdamage }} физического урона . Поразив первую цель, пуля раскрывается и продолжает полет, нанося {{ secondarydamage }} физического урона последующим целям. Враги, раскрытые умением Ловушка на йордлов , всегда получают полный урон.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Pantheon_P">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
    <rdfs:label>Pantheon_P</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Воля смертного</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Pantheon"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pantheon:P</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Следующее умение Пантеона после применения нескольких умений или атак становится усиленным.</lol:description>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Hwei_P">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
    <rdfs:label>Hwei_P</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Подпись творца</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Hwei"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hwei:P</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Хвэй помечает вражеских чемпионов, которым он наносит урон при помощи умений. Поразив врага другим умением, наносящим урон, Хвэй ставит под ним свою подпись. После небольшой задержки она взрывается, нанося магический урон всем врагам поблизости.</lol:description>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Source_Vladimir">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#SourceDocument"/>
    <rdfs:label>Source_Vladimir</rdfs:label>
    <lol:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://ddragon.leagueoflegends.com/cdn/16.20.1/data/ru_RU/champion/Vladimir.json</lol:sourceURL>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Source_Rakan">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#SourceDocument"/>
    <rdfs:label>Source_Rakan</rdfs:label>
    <lol:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://ddragon.leagueoflegends.com/cdn/16.20.1/data/ru_RU/champion/Rakan.json</lol:sourceURL>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Rengar_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Rengar_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Дикость</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Rengar"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Rengar:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Во время следующей атаки Ренгар яростно пронзает цель, нанося ей дополнительный урон. Эффект свирепости: умение наносит еще больше урона и увеличивает скорость атаки.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Скорость атаки 2 следующих автоатак Ренгара увеличивается на {{ asbonus }}% . Первая атака наносит {{ qtotaldamage }} ед. физического урона . Максимальная свирепость: первая атака наносит {{ empoweredqtotaldamage }} ед. физического урона и увеличивает скорость атаки Ренгара на {{ empoweredqas }} на {{ asduration }} сек.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Velkoz">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#Champion"/>
    <rdfs:label>Velkoz</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Вел'Коз</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Velkoz"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Velkoz</lol:entityId>
    <lol:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Око Бездны</lol:title>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
    <lol:resourceType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Мана</lol:resourceType>
    <lol:baseHP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">590.0</lol:baseHP>
    <lol:baseMP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">469.0</lol:baseMP>
    <lol:baseArmor rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">22.0</lol:baseArmor>
    <lol:baseAttackDamage rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">55.0</lol:baseAttackDamage>
    <lol:baseMoveSpeed rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">340.0</lol:baseMoveSpeed>
    <lol:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Mage"/>
    <lol:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Support"/>
    <lol:reviewStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">effects_not_reviewed</lol:reviewStatus>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Velkoz_P"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Velkoz_Q"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Velkoz_W"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Velkoz_E"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Velkoz_R"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Source_Sion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#SourceDocument"/>
    <rdfs:label>Source_Sion</rdfs:label>
    <lol:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://ddragon.leagueoflegends.com/cdn/16.20.1/data/ru_RU/champion/Sion.json</lol:sourceURL>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Source_Ashe">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#SourceDocument"/>
    <rdfs:label>Source_Ashe</rdfs:label>
    <lol:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://ddragon.leagueoflegends.com/cdn/16.20.1/data/ru_RU/champion/Ashe.json</lol:sourceURL>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Ambessa_R">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Ambessa_R</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Показательная расправа</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Ambessa"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ambessa:R</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Амбесса телепортируется к самому дальнему вражескому чемпиону на прямой линии и подавляет его. Затем она бьет его об землю, нанося урон и оглушая.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пассивно : %i:scaleAPen% пробивание брони Амбессы увеличено на {{ armor_penetration*100 }}% . Умения лечат ее на {{ calc_omnivamp }} от наносимого урона . Активно : Амбесса становится неудержимой и телепортируется к самому дальнему вражескому чемпиону на прямой линии, подавляя его на {{ suppress_duration }} сек. и ударяя об землю. Цель получает {{ calc_damage }} физического урона и оглушается на {{ stun_duration }} сек.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Malphite_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Malphite_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Удар грома</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Malphite"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Malphite:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Мальфит атакует с такой силой, что возникает звуковой удар. В течение нескольких следующих секунд в зоне перед собой Мальфит создает ударные волны.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пассивно: Мальфит получает {{ bonusarmorpassive*100 }}% брони (%i:scaleArmor%{{ f1 }}) . Сила эффекта растет до {{ bonusarmorpassive*300 }}% (%i:scaleArmor%{{ f2 }}) при активном Гранитном щите . Активно: следующая автоатака Мальфита дополнительно наносит {{ totalbonusdamage }} ед. физ. урона и создает ударную волну, наносящую {{ thunderclapsplash }} ед. физ. урона %i:OnHit% при попадании . Автоатаки Мальфита продолжают создавать ударные волны %i:OnHit% при попадании еще {{ thunderclapbuffduration }} сек.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Zaahen_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Zaahen_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Глефа даркинов</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Zaahen"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Zaahen:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">При следующей автоатаке Заахен совершает два удара, нанося дополнительный урон и восстанавливая здоровье. Заахен может применить умение повторно – в таком случае следующая автоатака нанесет дополнительный урон и подбросит цель.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">При следующей автоатаке Заахен совершает два удара, дополнительно нанося {{ initialdamage }} ед. физического урона и восстанавливая {{ healpercent*100 }}% от максимального запаса здоровья . Повторное применение: следующая автоатака Заахена дополнительно наносит {{ secondhitdamage }} ед. физического урона и подбрасывает цель на {{ knockupduration }} сек.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Source_Yunara">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#SourceDocument"/>
    <rdfs:label>Source_Yunara</rdfs:label>
    <lol:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://ddragon.leagueoflegends.com/cdn/16.20.1/data/ru_RU/champion/Yunara.json</lol:sourceURL>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Sett_P">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
    <rdfs:label>Sett_P</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Бойцовская выдержка</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Sett"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sett:P</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">При нанесении автоатак Сетт чередует удары слева и справа. Удар справа немного сильнее и быстрее. Кроме того, Сетт ненавидит проигрывать, поэтому его восстановление здоровья растет в зависимости от недостающего здоровья.</lol:description>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Nunu_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Nunu_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Поглощение</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Nunu"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nunu:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Виллумп кусает миньона, монстра или вражеского чемпиона, нанося урон и восстанавливая себе здоровье.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Виллумп кусает врага, нанося {{ monsterminiondamage }} чистого урона и восстанавливая {{ monsterhealing }} здоровья , если цель - миньон или лесной монстр. Если цель - чемпион, умение вместо этого наносит {{ totalchampiondamage }} магического урона и восстанавливает {{ championhealing }} здоровья . Эффективность лечения увеличивается на {{ lowhealthhealingscalar*100 }}%, когда у Нуну и Виллумпа менее {{ lowhealththreshhold*100 }}% здоровья.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Riven_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Riven_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Всплеск Ци</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Riven"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Riven:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ривен излучает энергию Ци, нанося урон всем окружающим врагам и оглушая их.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ривен выпускает вокруг себя руническую энергию, наносящую врагам {{ totaldamage }} ед. физ. урона и оглушающую их на {{ stunduration }} сек.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Udyr_E">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Udyr_E</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пламенный натиск</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Udyr"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Udyr:E</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">E</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Удир увеличивает свою скорость передвижения, и его первая автоатака против каждой цели оглушает ее. Повторное применение: Удир еще сильнее увеличивает скорость передвижения и на несколько секунд становится невосприимчивым к эффектам обездвиживания.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Стойка овна: Удир получает {{ movespeed }} скорости передвижения (ослабевает за {{ movespeedduration }} сек.). Также при автоатаках он совершает рывок к целям и оглушает их на {{ stunduration }} сек. (перезарядка – {{ icd }} сек. для каждой цели). Пробуждение: Удир получает невосприимчивость к обездвиживающим и нейтрализующим эффектам и {{ movespeedbonus }} скорости передвижения на {{ unstoppableduration }} сек.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Olaf_P">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
    <rdfs:label>Olaf_P</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ярость берсерка</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Olaf"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Olaf:P</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Олаф увеличивает свою скорость атаки и вампиризм в зависимости от недостающего здоровья.</lol:description>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Source_Vex">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#SourceDocument"/>
    <rdfs:label>Source_Vex</rdfs:label>
    <lol:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://ddragon.leagueoflegends.com/cdn/16.20.1/data/ru_RU/champion/Vex.json</lol:sourceURL>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Darius_P">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
    <rdfs:label>Darius_P</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Кровотечение</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Darius"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Darius:P</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Автоатаки и наносящие урон умения Дариуса заставляют врагов истекать кровью и получать физический урон в течение 5 сек. Эффект может суммироваться до 5 раз. Когда на цели накапливается максимальное количество зарядов, Дариус впадает в ярость и значительно увеличивает свою силу атаки.</lol:description>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Vi_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Vi_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Сминающие удары</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Vi"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Vi:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Вай сминает броню врага своими ударами, нанося ему дополнительный урон и увеличивая свою скорость атаки.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пассивно: каждая 3-я автоатака Вай против одного и того же врага наносит физический урон в размере {{ totaldamagetooltip }} от максимального запаса здоровья , уменьшает его броню на {{ shredamount }}% и увеличивает скорость атаки Вай на {{ attackspeed }}% на {{ sharedbuffsduration }} сек. Кроме того, это умение сокращает оставшуюся перезарядку Пламеотражателя на {{ spell.vipassive:cdreductionon3hit }} сек.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Rell_E">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Rell_E</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Полный ход</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Rell"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Rell:E</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">E</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пассивно: у Релл увеличена скорость передвижения вне боя. Активно: Релл и ее союзник постепенно ускоряются – вдвое сильнее при перемещении к врагам или друг к другу. Во время ее следующей автоатаки происходит взрыв, который наносит врагам магический урон.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Релл и ее союзник получают {{ minms*100 }}% скорости передвижения на {{ duration }} сек. Ускорение увеличивается до {{ maxms*100 }}% при перемещении к вражеским чемпионам или друг к другу. Во время следующей автоатаки или умения Пробивающий удар Релл происходит взрыв, который наносит пораженным врагам магический урон в размере {{ maxhealthdamagecalc }} от максимального запаса здоровья .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Empower">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#Mechanic"/>
    <rdfs:label>Empower</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Усиление умения</lol:name>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Source_Kindred">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#SourceDocument"/>
    <rdfs:label>Source_Kindred</rdfs:label>
    <lol:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://ddragon.leagueoflegends.com/cdn/16.20.1/data/ru_RU/champion/Kindred.json</lol:sourceURL>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#MasterYi_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>MasterYi_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Первый удар</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_MasterYi"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MasterYi:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Мастер Йи становится недосягаемым и беспорядочно телепортируется по полю боя, нанося физический урон многочисленным врагам, стоящим на его пути. Первый удар может нанести критический урон и наносит дополнительный физический урон монстрам. Автоатаки сокращают время перезарядки умения.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Мастер Йи становится недосягаемым и телепортируется по полю боя, быстро поражая врагов около цели. После {{ alphastrikebounces }} ударов он наносит всем задетым противникам {{ totaldamage }} физического урона . Это умение может поражать одного и того же врага несколько раз, если рядом нет других целей. При этом каждое попадание после первого наносит {{ subsequenthitmultiplier*100 }}% урона ({{ subesquentdamage }} ). Максимальный общий урон одной цели: {{ singletotaldamage }} .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Leblanc_P">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
    <rdfs:label>Leblanc_P</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Отражение</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Leblanc"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Leblanc:P</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Когда у Ле Блан остается менее 40% здоровья, она становится невидимой на 1 сек. и на 8 сек. создает свою копию, которая не наносит урона.</lol:description>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Source_Smolder">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#SourceDocument"/>
    <rdfs:label>Source_Smolder</rdfs:label>
    <lol:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://ddragon.leagueoflegends.com/cdn/16.20.1/data/ru_RU/champion/Smolder.json</lol:sourceURL>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Jinx_R">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Jinx_R</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Супер-мега-ракета смерти!</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Jinx"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Jinx:R</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Джинкс выпускает супер-мега-ракету, которая летит через всю карту. Урон, который она нанесет, увеличивается за время ее полета. Ракета взрывается при столкновении с вражеским чемпионом, нанося урон ему и окружающим врагам, тем больший, чем больше здоровья у них недостает.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Джинкс выпускает ракету, которая взрывается при столкновении с вражеским чемпионом, нанося ему физический урон в размере {{ damagefloor }}-{{ damagemax }} плюс {{ percentdamage }}% от недостающего здоровья . Урон ракеты увеличивается на протяжении первой секунды полета. Окружающие враги получают {{ aoedamagemult*100 }}% урона. Максимальный урон от недостающего здоровья против монстров - {{ monsterexecutemax }}. {{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Diana_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Diana_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Удар полумесяца</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Diana"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Diana:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Диана взмахивает клинком, создавая поток энергии, наносящий магический урон по дуге. Пораженные враги попадают под действие Лунного света, который раскрывает их на 3 сек. (не действует на невидимых бойцов).</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Диана выпускает дугу лунной энергии, которая наносит {{ totaldamage }} магического урона и помечает цели Лунным светом на {{ moonlightduration }} сек. Лунный свет раскрывает врагов, если они не невидимы .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N7101ea547dc74c839c0b0210d76fd7b0">
    <rdf:first rdf:resource="https://example.org/lol-ontology#Self"/>
    <rdf:rest rdf:nodeID="N7702e1ea67074917a105c1e0becfcdf6"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Ryze_R">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Ryze_R</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Искривление пространства</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Ryze"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ryze:R</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пассивно: Перегрузка наносит больше урона целям, пораженным Потоком. Активно: Райз открывает портал в место неподалеку. Спустя несколько секунд все союзники, находящиеся в зоне действия портала, переносятся в выбранное место.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пассивно: если цель поражена Потоком , Перегрузка наносит на {{ overloaddamagebonus }}% больше урона. Активно: Райз открывает портал в указанную точку. Через {{ chargetimetooltip }} сек. все союзники, находящиеся в области действия портала, переносятся в выбранное место.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Alistar_E">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Alistar_E</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Топот</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Alistar"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Alistar:E</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">E</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Алистар топчет ближайших врагов, получая возможность проходить сквозь бойцов и накапливая заряд за каждое повреждение вражеского чемпиона. При накоплении максимального количества зарядов следующая автоатака Алистара нанесет вражескому чемпиону дополнительный магический урон и оглушит его.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Алистар начинает топтать землю, получая призрачность и нанося {{ totaldamage }} ед. магического урона врагам поблизости в течение {{ duration }} сек. Каждая волна умения, нанесшая урон чемпиону, дает Алистару заряд. Когда Алистар накапливает {{ maxstacks }} зар., его следующая автоатака против чемпиона оглушает цель на {{ stunduration }} сек. и дополнительно наносит {{ attackbonusdamage }} ед. магического урона .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Jayce_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Jayce_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">В небо! / Шоковый заряд</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Jayce"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Jayce:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Стойка с молотом: Прыгает на врага, нанося физический урон и замедляя врагов. Стойка с пушкой: Выпускает электрический шар, взрывающийся при ударе о противника (или в конце своей дистанции), который наносит физический урон всем пораженным врагам.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ртутный молот: Джейс прыгает на врага, нанося {{ spell.jaycetotheskies:damage }} физического урона окружающим врагам и замедляя их на {{ spell.jaycetotheskies:slow*-100 }}% на {{ spell.jaycetotheskies:slowduration }} сек.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Source_Teemo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#SourceDocument"/>
    <rdfs:label>Source_Teemo</rdfs:label>
    <lol:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://ddragon.leagueoflegends.com/cdn/16.20.1/data/ru_RU/champion/Teemo.json</lol:sourceURL>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#AurelionSol_E">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>AurelionSol_E</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Сингулярность</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_AurelionSol"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AurelionSol:E</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">E</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Аурелион Сол создает черную дыру, которая наносит врагам урон и медленно притягивает их к своему центру. Это умение дает звездную материю каждый раз, когда в черной дыре погибает враг, и за каждую секунду, когда в ней находятся вражеские чемпионы. Враги в центре черной дыры погибают, когда у них остается определенное количество здоровья. Звездная материя увеличивает размер Сингулярности и порог казни.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Аурелион Сол создает черную дыру, которая наносит врагам {{ damagepersecond }} магического урона в секунду и притягивает их к своему центру в течение {{ duration }} сек. Враги в центре, у которых остается менее {{ currentexecutionthreshold }}% здоровья , мгновенно погибают. Аурелион Сол получает звездную материю каждый раз, когда в черной дыре погибает враг, и за каждую секунду, когда в ней находятся вражеские чемпионы.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Ekko_P">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
    <rdfs:label>Ekko_P</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Резонанс Z-привода</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Ekko"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ekko:P</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Каждая третья автоатака или наносящее урон умение против одной и той же цели наносит дополнительный магический урон. Если цель - чемпион, Экко также ненадолго ускоряется.</lol:description>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Swain_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Swain_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Рука смерти</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Swain"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Swain:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Свейн выпускает несколько зарядов мистической энергии, которые проходят сквозь врагов. Пораженные враги получают больше урона за каждый попавший в них заряд.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Свейн выпускает 5 зарядов мистической энергии, нанося {{ initialdamage }} магического урона плюс {{ extraboltdamage }} магического урона за каждый заряд после первого (максимальный урон – {{ maxdamage }} ).{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Source_Lillia">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#SourceDocument"/>
    <rdfs:label>Source_Lillia</rdfs:label>
    <lol:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://ddragon.leagueoflegends.com/cdn/16.20.1/data/ru_RU/champion/Lillia.json</lol:sourceURL>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Jax_P">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
    <rdfs:label>Jax_P</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Град ударов</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Jax"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Jax:P</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Последовательные автоатаки Джакса увеличивают его скорость атаки.</lol:description>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#baseHP">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>baseHP</rdfs:label>
    <rdfs:domain rdf:resource="https://example.org/lol-ontology#Champion"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Lucian_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Lucian_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пронзающий свет</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Lucian"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Lucian:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Люциан выпускает заряд света, пронзающий цель.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Люциан выпускает пронзающий заряд света, нанося {{ totaldamage }} физического урона . {{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Source_Leblanc">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#SourceDocument"/>
    <rdfs:label>Source_Leblanc</rdfs:label>
    <lol:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://ddragon.leagueoflegends.com/cdn/16.20.1/data/ru_RU/champion/Leblanc.json</lol:sourceURL>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Lucian_P">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
    <rdfs:label>Lucian_P</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Стрелок света</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Lucian"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Lucian:P</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Во время следующей автоатаки после применения умения Люциан совершает двойной выстрел. Когда союзник лечит Люциана или накладывает на него щит, а также когда поблизости обездвиживается вражеский чемпион, следующие 2 автоатаки Люциана наносят дополнительный магический урон.</lol:description>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#TwistedFate_E">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>TwistedFate_E</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Сложенная колода</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_TwistedFate"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TwistedFate:E</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">E</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Твистед Фэйт наносит дополнительный урон при каждой 4-й автоатаке. Кроме того, его скорость атаки увеличена.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пассивно: Твистед Фэйт получает {{ attackspeedbonus }}% скорости атаки , и каждая его 4-я автоатака дополнительно наносит {{ bonusdamage }} магического урона .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Source_Xayah">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#SourceDocument"/>
    <rdfs:label>Source_Xayah</rdfs:label>
    <lol:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://ddragon.leagueoflegends.com/cdn/16.20.1/data/ru_RU/champion/Xayah.json</lol:sourceURL>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Skarner_P">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
    <rdfs:label>Skarner_P</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Нити вибрации</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Skarner"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Skarner:P</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Автоатаки Скарнера, а также Расколотая земля, Сотрясение и Пронзание накладывают на врагов Дрожь. При максимальном количестве зарядов Дрожи они получают периодический магический урон, который зависит от их здоровья.</lol:description>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Source_Mel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#SourceDocument"/>
    <rdfs:label>Source_Mel</rdfs:label>
    <lol:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://ddragon.leagueoflegends.com/cdn/16.20.1/data/ru_RU/champion/Mel.json</lol:sourceURL>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Nilah_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Nilah_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Хлесткий клинок</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Nilah"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nilah:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Нила бьет хлыстом по прямой, нанося урон всем пораженным врагам. После этого у нее ненадолго увеличивается дальность атаки.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пассивно: пробивание брони Нилы увеличено на {{ critarmorpen }}, а ее автоатаки против чемпионов лечат ее на {{ critlifesteal }} от нанесенного урона . Избыточное лечение от этого эффекта превращается в щит , который действует {{ shieldduration }} сек. Активно: Нила бьет своим хлыстом, нанося врагам {{ damagecalc }} ед. физического урона . Если поражается вражеский боец или строение, Нила усиливается на {{ buffduration }} сек.: ее дальность атаки увеличивается на 125, а скорость атаки – на {{ bonusattackspeedcalc }}% . Кроме того, в течение этого времени ее автоатаки поражают врагов в конусе. {{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Zac_E">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Zac_E</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Эластичная рогатка</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Zac"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Zac:E</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">E</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Зак цепляется руками за землю, оттягивает свое тело назад, а затем запускает себя в указанном направлении.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Начало подготовки: Зак оттягивает свое тело назад, готовясь к прыжку в течение {{ channeltime }} сек. Применение: Зак запускает себя, подбрасывает врагов в точке приземления (вплоть до {{ maxstun }} сек., зависит от времени подготовки) и наносит им {{ damage }} ед. маг. урона . За каждого пораженного чемпиона от тела Зака отрываются дополнительные кусочки слизи .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Rumble_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Rumble_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Огнемет</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Rumble"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Rumble:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Рамбл поджаривает врагов перед собой, нанося им магический урон в течение 3 секунд. Если он находится в Опасной зоне, урон увеличивается.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Рамбл включает огнемет, который наносит магический урон в размере {{ flatdamage }} плюс {{ healthdamage*100 }}% от максимального запаса здоровья в течение {{ flamespitterduration }} сек. (миньоны получают {{ minionmod*100 }}% урона). Опасная зона: урон увеличивается до {{ empowereddamage }} плюс {{ empoweredhealth }} от максимального запаса здоровья . Максимальный процентный урон монстрам – {{ monstercap }}. {{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Riven_P">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
    <rdfs:label>Riven_P</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Рунический клинок</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Riven"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Riven:P</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Применяя умения, Ривен заряжает свой клинок. Ее автоатаки расходуют заряды и наносят дополнительный урон.</lol:description>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#conditionText">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>conditionText</rdfs:label>
    <rdfs:domain rdf:resource="https://example.org/lol-ontology#AbilityEffect"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Swain_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Swain_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Око империи</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Swain"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Swain:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Свейн создает демонический глаз, который наносит урон и замедляет врагов. Пораженные чемпионы раскрываются и дают Свейну фрагменты души.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Свейн создает демонический глаз, который раскрывает выбранное место на 1.5 сек., а затем наносит врагам {{ totaldamage }} магического урона и замедляет их на {{ slow*-100 }}% на {{ slowduration }} сек. Пораженные чемпионы дают Свейну фрагмент души и раскрываются на {{ revealduration }} сек.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Vi_P">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
    <rdfs:label>Vi_P</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пламеотражатель</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Vi"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Vi:P</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Вай постепенно заряжает щит, который активируется, когда она поражает противника одним из своих умений.</lol:description>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Kassadin_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Kassadin_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Клинок пустоты</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Kassadin"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Kassadin:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Кассадин пассивно наносит дополнительный магический урон при автоатаках. При активации умения следующая автоатака Кассадина наносит существенный дополнительный магический урон и восстанавливает ману.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пассивно: автоатаки Кассадина дополнительно наносят {{ onhitdamage }} магического урона . Активно: Кассадин заряжает свой клинок и при следующей автоатаке дополнительно наносит {{ activedamage }} магического урона , а также восстанавливает себе {{ missingmanaratio }}% от недостающей маны . Если цель – чемпион, восстановление увеличивается до {{ championmissingmanaratio }}% .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Twitch_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Twitch_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Засада</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Twitch"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Twitch:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Твич маскируется на короткое время, одновременно увеличивая скорость передвижения. Когда Твич сбрасывает маскировку, его скорость атаки ненадолго увеличивается. Когда умирает вражеский чемпион, пораженный Смертельным ядом, время перезарядки Засады обнуляется.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Твич получает маскировку и увеличивает скорость передвижения на {{ movespeedmod }}% на {{ stealthduration }} сек. Скорость передвижения увеличивается до {{ hiddenspeed }}%, если рядом находится вражеский чемпион, который не видит Твича. После снятия маскировки Твич увеличивает скорость атаки на {{ attackspeedmod*100 }}% на {{ attackspeedduration }} сек. Когда погибает вражеский чемпион, пораженный ядом , перезарядка этого умения сбрасывается.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Kayle_P">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
    <rdfs:label>Kayle_P</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Божественное восхождение</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Kayle"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Kayle:P</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">По мере того, как Кейл набирает уровни и тратит очки умений, ее автоатаки усиливаются небесами. Ее крылья воспламеняются, и она постепенно увеличивает скорость атаки, скорость передвижения и дальность атаки. Кроме того, она начинает выпускать волны пламени при автоатаках.</lol:description>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Poppy_P">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
    <rdfs:label>Poppy_P</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Железный посол</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Poppy"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Poppy:P</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Время от времени при автоатаке Поппи бросает свой баклер, который падает на землю, поразив врага. Поппи может поднять его, чтобы получить временный щит, поглощающий урон.</lol:description>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Illaoi_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Illaoi_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Жестокий урок</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Illaoi"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Illaoi:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">При следующей автоатаке Иллаой совершает рывок вперед, нанося дополнительный физический урон, и приказывает всем ближайшим щупальцам атаковать цель.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Во время следующей автоатаки Иллаой прыгает к своей цели, дополнительно нанося физический урон в размере {{ healthpercenttotal }} от максимального запаса здоровья . Когда Иллаой поражает цель, щупальца поблизости также атакуют ее.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Taric_E">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Taric_E</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ослепление</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Taric"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Taric:E</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">E</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Тарик подготавливает к использованию луч звездного света, который после короткой задержки наносит магический урон и оглушает противников.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Тарик подготавливает луч звездного света, по истечении {{ chargeduration }} сек. наносящий врагам {{ totaldamage }} ед. маг. урона и оглушающий их на {{ stunduration }} сек.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Jhin_P">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
    <rdfs:label>Jhin_P</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Шепот</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Jhin"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Jhin:P</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Шепот, ружье Джина, - сложный механизм, созданный для нанесения большого урона. Он вмещает всего четыре патрона, и скорость стрельбы из него постоянна. Джин наполняет последний патрон темной магической энергией, поэтому четвертый выстрел всегда критический и наносит дополнительный урон. После каждого критического выстрела скорость передвижения Джина ненадолго увеличивается.</lol:description>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Source_Kennen">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#SourceDocument"/>
    <rdfs:label>Source_Kennen</rdfs:label>
    <lol:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://ddragon.leagueoflegends.com/cdn/16.20.1/data/ru_RU/champion/Kennen.json</lol:sourceURL>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Source_Fizz">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#SourceDocument"/>
    <rdfs:label>Source_Fizz</rdfs:label>
    <lol:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://ddragon.leagueoflegends.com/cdn/16.20.1/data/ru_RU/champion/Fizz.json</lol:sourceURL>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Akali">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#Champion"/>
    <rdfs:label>Akali</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Акали</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Akali"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Akali</lol:entityId>
    <lol:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Вольная убийца</lol:title>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
    <lol:resourceType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Энергия</lol:resourceType>
    <lol:baseHP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">600.0</lol:baseHP>
    <lol:baseMP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">200.0</lol:baseMP>
    <lol:baseArmor rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">23.0</lol:baseArmor>
    <lol:baseAttackDamage rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">62.0</lol:baseAttackDamage>
    <lol:baseMoveSpeed rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">345.0</lol:baseMoveSpeed>
    <lol:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Assassin"/>
    <lol:reviewStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">effects_not_reviewed</lol:reviewStatus>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Akali_P"/>
