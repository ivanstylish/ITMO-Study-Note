  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Kalista_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Kalista_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пронзающее копье</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Kalista"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Kalista:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Калиста мечет тонкое быстролетящее копье, которое пробивает убитых им врагов насквозь, продолжая свой путь.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Калиста швыряет копье, нанося {{ totaldamage }} физического урона первой пораженной цели. Если копье убивает цель, оно летит дальше, перенося все заряды умения Раздирание на следующего пораженного врага. Калиста может совершить рывок после этого умения с помощью умения Боевая готовность .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Irelia">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#Champion"/>
    <rdfs:label>Irelia</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ирелия</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Irelia"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Irelia</lol:entityId>
    <lol:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Танцующая с клинками</lol:title>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
    <lol:resourceType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Мана</lol:resourceType>
    <lol:baseHP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">630.0</lol:baseHP>
    <lol:baseMP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">350.0</lol:baseMP>
    <lol:baseArmor rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">36.0</lol:baseArmor>
    <lol:baseAttackDamage rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">65.0</lol:baseAttackDamage>
    <lol:baseMoveSpeed rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">335.0</lol:baseMoveSpeed>
    <lol:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Fighter"/>
    <lol:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Assassin"/>
    <lol:reviewStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">effects_not_reviewed</lol:reviewStatus>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Irelia_P"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Irelia_Q"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Irelia_W"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Irelia_E"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Irelia_R"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Viego_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Viego_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Клинок Падшего короля</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Viego"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Viego:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Призрачный клинок Виего всегда наносит дополнительный урон при попадании , который зависит от текущего запаса здоровья цели. Кроме того, когда Виего атакует врага, который недавно был поражен его умением, он бьет дважды и похищает его здоровье. Виего может активировать это умение, совершив выпад с мечом и пронзив врагов перед собой.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пассивно: автоатаки Виего дополнительно наносят физический урон в размере {{ totalpercenthealthonhit }} от текущего запаса здоровья цели . Первая автоатака Виего против цели, которой он недавно наносил урон с помощью умения, применяется второй раз, нанося {{ secondattackdamage }} физического урона и восстанавливая ему здоровье в размере {{ healmodvschamps*100 }}% от нанесенного урона . Эти эффекты действуют и во время подчинения врагов. Активно: Виего совершает выпад с мечом, нанося пораженным врагам {{ totaldamage }} физического урона .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Kayn_R">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Kayn_R</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Теневая интервенция</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Kayn"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Kayn:R</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Каин прячется в теле врага, нанося значительный урон во время выхода.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пассивно: когда Каин наносит урон чемпиону, тот помечается на 3.15 сек. Каин вселяется в помеченного врага, становясь недосягаемым. Через {{ infestduration }} сек. или при повторном применении Каин вырывается из врага, нанося ему {{ damage }} физического урона . Сумеречный убийца: дальность действия увеличена (как при вселении в жертву, так и при покидании ее). Когда Каин покидает жертву, он сбрасывает перезарядку Косы даркинов . Даркин-душегуб: умение наносит физический урон в размере {{ slayerdamage }} от максимального запаса здоровья и восстанавливает {{ healvalue }} здоровья ({{ slayerhealpercent*100 }}% от нанесенного урона).{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Kennen_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Kennen_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Скачок напряжения</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Kennen"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Kennen:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Кеннен пассивно наносит дополнительный урон и накладывает на цель Знак бури при каждой пятой автоатаке. Активация этого умения накладывает еще один Знак бури на всех уже отмеченных врагов неподалеку и наносит им урон.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пассивно: каждая 5-я автоатака дополнительно наносит {{ totaldamagepassive }} ед. маг. урона %i:OnHit% при попадании . Активно: Кеннен выпускает заряд электричества, нанося {{ totaldamageactive }} ед. маг. урона ближайшим врагам, на которых наложен Знак бури . {{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Velkoz_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Velkoz_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пролом в Бездну</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Velkoz"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Velkoz:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Вел'Коз создает пролом в Бездну, который наносит урон в момент появления и дополнительный урон после некоторой задержки.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Вел'Коз создает разлом в Бездну, нанося {{ initialdamage }} магического урона . После этого разлом взрывается, нанося {{ secondarydamage }} магического урона . У этого умения может быть до 2 зарядов (новый заряд дается раз в {{ ammorechargetime }} сек.).{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Vex">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#Champion"/>
    <rdfs:label>Vex</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Векс</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Vex"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Vex</lol:entityId>
    <lol:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Мрачнистка</lol:title>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
    <lol:resourceType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Мана</lol:resourceType>
    <lol:baseHP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">590.0</lol:baseHP>
    <lol:baseMP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">490.0</lol:baseMP>
    <lol:baseArmor rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">23.0</lol:baseArmor>
    <lol:baseAttackDamage rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">54.0</lol:baseAttackDamage>
    <lol:baseMoveSpeed rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">335.0</lol:baseMoveSpeed>
    <lol:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Mage"/>
    <lol:reviewStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">effects_not_reviewed</lol:reviewStatus>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Vex_P"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Vex_Q"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Vex_W"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Vex_E"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Vex_R"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Vladimir_E">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Vladimir_E</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Потоки крови</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Vladimir"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Vladimir:E</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">E</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Владимир тратит собственное здоровье, чтобы наполнить резервуар крови. После использования он нанесет урон по площади, но вражеские бойцы могут его заблокировать.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Начало подготовки: Владимир заполняет резервуар крови, расходуя до {{ chargehealthtooltip }} здоровья . При максимальном уровне заряда Владимир замедляется на 20%. Применение: Владимир выпускает фонтан крови, поражая окружающих врагов и нанося от {{ mindamagetooltip }} до {{ maxdamagetooltip }} магического урона в зависимости от времени подготовки. Если подготовка длилась хотя бы 1 сек., умение также замедляет цели на {{ slowpercent }}% на 0.5 сек.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#effectOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>effectOf</rdfs:label>
    <rdfs:comment xml:lang="ru">Эффект относится к умению; обратное hasEffect.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/lol-ontology#AbilityEffect"/>
    <rdfs:range rdf:resource="https://example.org/lol-ontology#Ability"/>
  </rdf:Description>
