  <rdf:Description rdf:about="https://example.org/lol-ontology#MonkeyKing_P">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
    <rdfs:label>MonkeyKing_P</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Каменная кожа</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_MonkeyKing"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MonkeyKing:P</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Сражаясь с чемпионами и монстрами, Вуконг увеличивает броню и восстановление здоровья. Эффект суммируется.</lol:description>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N0544a455a86f4dcdbe371253d4d53844">
    <rdf:first rdf:resource="https://example.org/lol-ontology#Category_Marksman"/>
