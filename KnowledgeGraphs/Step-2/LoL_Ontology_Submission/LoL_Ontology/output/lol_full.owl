    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Когда у Блицкранка остается мало здоровья, он получает щит, прочность которого зависит от его запаса маны.</lol:description>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
