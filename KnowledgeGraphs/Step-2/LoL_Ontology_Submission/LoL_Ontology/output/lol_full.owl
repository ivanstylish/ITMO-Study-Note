  <rdf:Description rdf:about="https://example.org/lol-ontology#Nami_E">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Nami_E</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Благословение Повелительницы морей</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Nami"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nami:E</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">E</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Нами усиливает союзного чемпиона на короткое время. Автоатаки и умения союзника наносят дополнительный магический урон и замедляют цель.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Нами усиливает {{ hitcount }} автоатаки и умения союзного чемпиона на {{ buffduration }} сек. Усиленные автоатаки и умения замедляют цели на {{ totalslow }} на {{ slowduration }} сек. и дополнительно наносят {{ totaldamage }} магического урона . {{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
