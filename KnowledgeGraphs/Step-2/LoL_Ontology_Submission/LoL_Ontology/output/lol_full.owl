  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Root">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#MovementControlMechanic"/>
    <rdfs:label>Root</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Обездвиживание</lol:name>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Elise_P">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
    <rdfs:label>Elise_P</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Королева пауков</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Elise"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Elise:P</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Человеческая форма: каждый раз, когда Элиза поражает противника умением, она подготавливает спящего паучка. Форма паука: Элиза наносит дополнительный магический урон и восстанавливает себе здоровье при автоатаках.</lol:description>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Category_Assassin">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ChampionCategory"/>
    <rdfs:label>Category_Assassin</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Assassin</lol:name>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Kled_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Kled_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Склонность к насилию</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Kled"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Kled:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Скорость атаки Кледа значительно увеличивается на следующие четыре автоатаки. Четвертая автоатака наносит еще больше урона.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пассивно: следующая автоатака Кледа увеличивает его скорость атаки на {{ attackspeed*100 }}% на четыре автоатаки или на {{ activeduration }} сек. Четвертая автоатака дополнительно наносит физический урон в размере {{ baseflatdamage }} ед. плюс {{ percentdamage }} от максимального запаса здоровья .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#DrMundo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#Champion"/>
    <rdfs:label>DrMundo</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Доктор Мундо</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_DrMundo"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DrMundo</lol:entityId>
    <lol:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Сумасшедший из Зауна</lol:title>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
    <lol:resourceType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Нет</lol:resourceType>
    <lol:baseHP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">640.0</lol:baseHP>
    <lol:baseMP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.0</lol:baseMP>
    <lol:baseArmor rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">32.0</lol:baseArmor>
    <lol:baseAttackDamage rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">61.0</lol:baseAttackDamage>
    <lol:baseMoveSpeed rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">345.0</lol:baseMoveSpeed>
    <lol:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Tank"/>
    <lol:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Fighter"/>
    <lol:reviewStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">effects_not_reviewed</lol:reviewStatus>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#DrMundo_P"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#DrMundo_Q"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#DrMundo_W"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#DrMundo_E"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#DrMundo_R"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Nami_P">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
    <rdfs:label>Nami_P</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Бурные волны</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Nami"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nami:P</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Когда умения Нами задевают союзных чемпионов, их скорость передвижения ненадолго увеличивается.</lol:description>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Blitzcrank_E">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Blitzcrank_E</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Силовой кулак</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Blitzcrank"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Blitzcrank:E</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">E</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Блицкранк заряжает кулак энергией, чтобы нанести двойной урон и подбросить противника в воздух при следующей атаке.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Блицкранк заряжает свой кулак, и его следующая автоатака подбрасывает цель на {{ ccduration }} сек. и наносит {{ totaldamage }} физического урона .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Ivern_E">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Ivern_E</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Посадка семян</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Ivern"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ivern:E</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">E</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Иверн защищает союзника щитом, который взрывается через некоторое время, нанося урон и замедляя врагов. Если взрыв не задевает врагов, прочность щита восстанавливается.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Иверн накладывает на союзного чемпиона или Маргаритку щит прочностью {{ totalshield }} . Через {{ shieldduration }} сек. щит взрывается, нанося врагам {{ totaldamage }} магического урона и замедляя их на {{ slowamount*100 }}% на {{ slowduration }} сек. Если взрыв от Посадки семян не поражает вражеских чемпионов, а щит еще действует, союзник получает новый щит прочностью {{ totalshield }} на {{ shieldduration }} сек.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Azir_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Azir_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Неумолимые пески</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Azir"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Azir:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Азир отдает приказ всем песчаным воинам сделать рывок в указанную точку. Воины наносят магический урон врагам на своем пути и замедляют их на 1 секунду.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Азир приказывает всем песчаным воинам сделать рывок в указанную область. При этом они наносят {{ totaldamage }} ед. магического урона всем врагам на пути и замедляют их на {{ slowamount*-100 }}% на 1 сек.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Sivir_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Sivir_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Клинок-бумеранг</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Sivir"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sivir:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Сивир бросает свой клинок, как бумеранг, и он наносит урон по пути к точке назначения и обратно.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Сивир бросает свой клинок как бумеранг, нанося {{ totaldamage }} всем пораженным врагам. Клинок наносит меньше урона каждой последующей цели, не являющейся чемпионом, но не менее {{ falloffminimum*100 }}% от первоначального.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Quinn_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Quinn_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Обостренные чувства</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Quinn"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Quinn:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Когда Квинн атакует врага, помеченного меткой Хищной птицы , ее скорость атаки и скорость передвижения растут. Активируя умение, Вэлор раскрывает большую область поблизости.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пассивно: атакуя врага с меткой Хищной птицы , Квинн получает {{ attackspeedbonus*100 }}% скорости атаки и {{ movespeedamount*100 }}% скорости передвижения на {{ buffduration }} сек. Активно: Вэлор раскрывает большую область поблизости на {{ visionduration }} сек.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Bard_P">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
    <rdfs:label>Bard_P</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Зов скитальца</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Bard"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bard:P</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Мипы: Бард притягивает маленьких духов, которые помогают ему при автоатаках, нанося дополнительный магический урон. Когда Бард собирает достаточно колокольчиков , его мипы начинают наносить урон по площади и замедлять пораженных врагов. Колокольчики: в случайных местах на карте появляются древние колокольчики , которые Бард может собирать. Они дают опыт, восстанавливают ману и увеличивают скорость передвижения вне боя.</lol:description>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Renata_P">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
    <rdfs:label>Renata_P</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Рычаг давления</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Renata"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Renata:P</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Автоатаки Ренаты наносят дополнительный урон и помечают врагов. Когда союзники наносят урон помеченным врагам, те получают дополнительный урон.</lol:description>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#sourceURL">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>sourceURL</rdfs:label>
    <rdfs:domain rdf:resource="https://example.org/lol-ontology#SourceDocument"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Rakan_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Rakan_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Великолепное появление</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Rakan"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Rakan:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Рэйкан делает рывок в выбранное место, после чего подбрасывает ближайших врагов.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Рэйкан совершает рывок, а затем подпрыгивает, подбрасывая цель на {{ knockupduration }} сек. и нанося {{ totaldamage }} магического урона .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <owl:versionInfo>1.0 / Data Dragon 16.20.1 / ru_RU</owl:versionInfo>
    <rdfs:label xml:lang="en">League of Legends: champions, abilities and effects</rdfs:label>
    <dcterms:title xml:lang="en">League of Legends: champions, abilities and effects</dcterms:title>
    <dcterms:description xml:lang="en">An OWL 2 DL ontology of champions, abilities and qualified effects. The demo contains Lux, Morgana and Karma. Effect conditions and source evidence are preserved. Data Dragon 16.20.1, ru_RU. Effect annotations reviewed by an assistant.</dcterms:description>
    <rdfs:comment xml:lang="ru">Учебная онтология. Качественная разметка эффектов проверена ассистентом только для Lux, Morgana, Karma. Условия сохранены текстом; вывод означает наличие способности при указанных условиях, а не результат любого применения. Отсутствие разметки не означает отсутствие механики. Числа из шаблонов tooltip не угадываются.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Heimerdinger">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#Champion"/>
    <rdfs:label>Heimerdinger</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Хеймердингер</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Heimerdinger"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Heimerdinger</lol:entityId>
    <lol:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Одержимый ученый</lol:title>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
    <lol:resourceType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Мана</lol:resourceType>
    <lol:baseHP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">558.0</lol:baseHP>
    <lol:baseMP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">385.0</lol:baseMP>
    <lol:baseArmor rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">19.0</lol:baseArmor>
    <lol:baseAttackDamage rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">56.0</lol:baseAttackDamage>
    <lol:baseMoveSpeed rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">340.0</lol:baseMoveSpeed>
    <lol:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Mage"/>
    <lol:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Support"/>
    <lol:reviewStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">effects_not_reviewed</lol:reviewStatus>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Heimerdinger_P"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Heimerdinger_Q"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Heimerdinger_W"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Heimerdinger_E"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Heimerdinger_R"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Rammus_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Rammus_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Катящийся шар</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Rammus"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Rammus:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Раммус сворачивается в клубок и катится на противников, нанося урон и замедляя всех окружающих врагов после столкновения.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Раммус сворачивается в клубок и получает прибавку к скорости передвижения в размере {{ minimummovespeed }} , которая увеличивается до {{ maximummovespeed }} в течение {{ rollduration }} сек. При столкновении с врагом Раммус останавливается и наносит {{ powerballdamage }} ед. магического урона , а также отбрасывает и замедляет противников поблизости на {{ slowpercent }}% на {{ slowduration }} сек. Повторное применение : действие этого умения прекращается преждевременно.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Jinx_E">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Jinx_E</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Огненные кусаки!</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Jinx"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Jinx:E</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">E</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Джинкс бросает линию из гранат-ловушек. Гранаты взрываются через 5 секунд, поджигая врагов. Если над гранатой проходит вражеский чемпион, граната кусает и обездвиживает его.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Джинкс бросает 3 гранаты-кусаки, которые существуют {{ grenadeduration }} сек. Гранаты взрываются при контакте с вражескими чемпионами, обездвиживая их на {{ rootduration }} сек. и нанося окружающим врагам {{ totaldamage }} магического урона .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Naafiri_P">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
    <rdfs:label>Naafiri_P</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Одно целое</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Naafiri"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Naafiri:P</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Наафири призывает членов стаи, которые атакуют цели ее атак и умений.</lol:description>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Yone_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Yone_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Сталь смертного</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Yone"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Yone:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ёнэ делает выпад вперед, нанося урон всем врагам на прямой линии. При попадании Ёнэ получает заряд Надвигающейся бури на несколько секунд. После накопления 2 зарядов Ёнэ при использовании Стали смертного совершает рывок вперед с порывом ветра, подбрасывая врагов.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ёнэ делает выпад вперед, нанося {{ qdamage }} физического урона . При попадании Ёнэ получает заряд на {{ buffduration }} сек. После накопления 2 зарядов Ёнэ при использовании этого умения совершает рывок вперед с порывом ветра, подбрасывая врагов на {{ q3knockupduration }} сек. и нанося им {{ qdamage }} физического урона . {{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Malphite_P">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
    <rdfs:label>Malphite_P</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Гранитный щит</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Malphite"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Malphite:P</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Мальфит защищен каменным щитом, поглощающим урон, равный 10% от его максимального запаса здоровья. Если в течение нескольких секунд Мальфит не получает урона, щит возникает вновь.</lol:description>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Vex_P">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
    <rdfs:label>Vex_P</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Тлен и безысходность</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Vex"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Vex:P</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Векс периодически усиливается, и ее следующее базовое умение пугает врагов и прерывает рывки. Когда враги рядом с Векс совершают рывки, она помечает их, а при снятии метки наносит дополнительный урон и сокращает перезарядку своего усиления.</lol:description>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Zilean_P">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
    <rdfs:label>Zilean_P</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Время в бутылке</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Zilean"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Zilean:P</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Зилеан сохраняет время в виде опыта и может передать его союзникам. Когда сохраненного опыта хватает для повышения уровня союзника, Зилеан может щелкнуть по нему правой кнопкой мыши, чтобы передать этот опыт. Сам Зилеан при этом получает столько же опыта, сколько дает.</lol:description>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#KSante_P">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
    <rdfs:label>KSante_P</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Бесстрашие</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_KSante"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">KSante:P</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Умения К'Санте помечают цели, увеличивая урон от его следующей автоатаки. Высвобождение: все автоатаки и умения К'Санте наносят больше урона.</lol:description>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Janna_P">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
    <rdfs:label>Janna_P</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Попутный ветер</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Janna"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Janna:P</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Скорость передвижения союзников Жанны увеличивается при перемещении к ней. Жанна наносит дополнительный магический урон при попадании и при применении Западного ветра в зависимости от ее дополнительной скорости передвижения.</lol:description>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Smolder">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#Champion"/>
    <rdfs:label>Smolder</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Смолдер</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Smolder"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Smolder</lol:entityId>
    <lol:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Жгучий дракончик</lol:title>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
    <lol:resourceType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Мана</lol:resourceType>
    <lol:baseHP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">575.0</lol:baseHP>
    <lol:baseMP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">300.0</lol:baseMP>
    <lol:baseArmor rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">24.0</lol:baseArmor>
    <lol:baseAttackDamage rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">58.0</lol:baseAttackDamage>
    <lol:baseMoveSpeed rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">330.0</lol:baseMoveSpeed>
    <lol:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Marksman"/>
    <lol:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Mage"/>
    <lol:reviewStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">effects_not_reviewed</lol:reviewStatus>
