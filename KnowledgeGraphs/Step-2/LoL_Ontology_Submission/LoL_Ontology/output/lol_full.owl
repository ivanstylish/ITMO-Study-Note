  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Lissandra_E">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Lissandra_E</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ледяная тропа</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Lissandra"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Lissandra:E</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">E</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Лиссандра создает ледяные когти, наносящие урон. Повторная активация умения переносит Лиссандру к месту текущего положения когтей.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Лиссандра выпускает вперед ледяные когти, которые наносят {{ totaldamage }} магического урона . Лиссандра может повторно применить это умение во время перемещения когтей, чтобы телепортироваться к ним.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Anivia">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#Champion"/>
    <rdfs:label>Anivia</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Анивия</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Anivia"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Anivia</lol:entityId>
    <lol:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Криофеникс</lol:title>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
    <lol:resourceType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Мана</lol:resourceType>
    <lol:baseHP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">550.0</lol:baseHP>
    <lol:baseMP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">495.0</lol:baseMP>
    <lol:baseArmor rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">19.0</lol:baseArmor>
    <lol:baseAttackDamage rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">51.0</lol:baseAttackDamage>
    <lol:baseMoveSpeed rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">325.0</lol:baseMoveSpeed>
    <lol:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Mage"/>
    <lol:reviewStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">effects_not_reviewed</lol:reviewStatus>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Anivia_P"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Anivia_Q"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Anivia_W"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Anivia_E"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Anivia_R"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Neeko_P">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
    <rdfs:label>Neeko_P</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Мимикрия</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Neeko"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Neeko:P</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Нико может маскироваться под союзных чемпионов или под других бойцов на карте. Маскировка пропадает, если Нико обездвиживают эффектом контроля, она применяет умение, наносящее урон, она наносит урон вражеской башне в нечемпионском облике или она получает урон в размере текущего запаса здоровья объекта, под который она замаскирована.</lol:description>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#MasterYi_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>MasterYi_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Медитация</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_MasterYi"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MasterYi:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Мастер Йи обновляет свое тело силой разума, восстанавливая здоровье и получая уменьшенный входящий урон в течение короткого времени. Кроме того, Мастер Йи получает заряды Двойного удара и приостанавливает действие Стиля вуджу и Горца на каждую секунду действия умения.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Мастер Йи начинает медитировать, восстанавливая {{ totalheal }} здоровья в течение {{ healduration }} сек. Эффективность лечения может увеличиваться на величину вплоть до {{ maxmissinghealthpercent*100 }}% в зависимости от недостающего здоровья Мастера Йи. Во время медитации и в течение {{ drlinger }} сек. после нее Мастер Йи получает на {{ initialdr }} меньше урона. Это значение уменьшается до {{ damagereduction*100 }}% после первых {{ initialextradrduration }} сек.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#RekSai_R">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>RekSai_R</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Натиск Бездны</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_RekSai"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RekSai:R</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пассивно: Рек'Сай помечает цели при нанесении урона. Активно: Рек'Сай готовится к атаке в течение короткого времени, получая недосягаемость, после чего набрасывается на помеченного врага и наносит ему большой урон в зависимости от его максимального запаса здоровья.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Рек'Сай выбирает целью врага, которому она наносила урон за последние {{ preymarkduration }} сек., а затем уходит под землю и получает недосягаемость. После небольшой задержки она получает неудержимость и прыгает к своей цели, нанося ей физический урон в размере {{ rbasedamagecalc }} ед. плюс {{ percenthealthdamage }}% от максимального запаса здоровья и сбрасывая перезарядку умения Уход под землю / Выход на поверхность .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Bard_R">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Bard_R</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Отсрочка неизбежного</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Bard"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bard:R</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Бард посылает энергию духов в указанную область, на короткое время помещая всех бойцов и башни в ней в стазис.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Бард посылает магическую защитную энергию в выбранную область, помещая всех бойцов и строения в ней в стазис на {{ rstasisduration }} сек.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Ability">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Ability</rdfs:label>
    <rdfs:comment xml:lang="ru">Основное умение P/Q/W/E/R.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Maokai">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#Champion"/>
    <rdfs:label>Maokai</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Маокай</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Maokai"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Maokai</lol:entityId>
    <lol:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Испорченный энт</lol:title>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
    <lol:resourceType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Мана</lol:resourceType>
    <lol:baseHP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">665.0</lol:baseHP>
    <lol:baseMP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">375.0</lol:baseMP>
    <lol:baseArmor rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">35.0</lol:baseArmor>
    <lol:baseAttackDamage rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">64.0</lol:baseAttackDamage>
    <lol:baseMoveSpeed rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">335.0</lol:baseMoveSpeed>
    <lol:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Tank"/>
    <lol:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Support"/>
    <lol:reviewStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">effects_not_reviewed</lol:reviewStatus>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Maokai_P"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Maokai_Q"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Maokai_W"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Maokai_E"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Maokai_R"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Sivir_E">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Sivir_E</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Щит от магии</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Sivir"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sivir:E</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">E</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Сивир создает магический барьер, который блокирует одно вражеское умение. При успешном срабатывании он восстанавливает Сивир здоровье и ненадолго ее ускоряет.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Сивир создает на {{ spellshieldduration }} сек. магический барьер, блокирующий следующее вражеское умение. При успешном срабатывании он восстанавливает Сивир {{ totalheal }} здоровья и активирует Быстроногую.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Shaco_E">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Shaco_E</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Отравленные заточки</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Shaco"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Shaco:E</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">E</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Шако отравляет врагов при автоатаках, уменьшая их скорость передвижения. При активации умения Шако мечет нож, нанося врагу урон и отравляя его. Брошенные ножи наносят дополнительный урон, если у цели осталось менее 30% здоровья.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пассивно: когда это умение не находится на перезарядке, автоатаки Шако замедляют цель на {{ slowamount*-100 }}% на {{ slowdurationpassive }} сек. Активно: Шако мечет заточку, которая наносит врагу {{ totaldamage }} магического урона и замедляет его на {{ slowamount*-100 }}% на {{ slowdurationactive }} сек. Если у цели осталось менее {{ executehealththreshold*100 }}% здоровья, заточка вместо этого наносит {{ totalexecutedamage }} урона .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Morgana_R_Slow_Enemy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#AbilityEffect"/>
    <rdfs:label>Morgana_R_Slow_Enemy</rdfs:label>
    <lol:hasMechanic rdf:resource="https://example.org/lol-ontology#Slow"/>
    <lol:hasTargetType rdf:resource="https://example.org/lol-ontology#Enemy"/>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Morgana"/>
    <lol:conditionText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Вражеский чемпион связан цепью Моргани.</lol:conditionText>
    <lol:evidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Моргана приковывает себя цепями к окружающим вражеским чемпионам, нанося {{ totaldamage }} магического урона и замедляя их на {{ slowpercent }}%. Через {{ chainduration }} сек. враги, которые не смогли разорвать цепи, дополнительно получают {{ totaldamage }} магического урона и оглушаются на {{ stunduration }} сек. При применении этого умения Моргана увеличивает свою скорость передвижения на {{ hastepercent }}% .{{ spellmodifierdescriptionappend }}</lol:evidenceText>
    <lol:evidenceField rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tooltip_text</lol:evidenceField>
    <lol:reviewStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">reviewed_by_assistant</lol:reviewStatus>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Yasuo_R">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Yasuo_R</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Последний вздох</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Yasuo"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Yasuo:R</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ясуо телепортируется к подброшенному вражескому чемпиону, нанося физический урон и удерживая в воздухе всех подброшенных рядом врагов. При этом его запас потока увеличивается до максимального, но все заряды Надвигающегося шторма обнуляются. Кроме того, в течение некоторого времени после этого критические удары Ясуо игнорируют значительную часть дополнительной брони врага.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ясуо телепортируется к подброшенному вражескому чемпиону, нанося {{ damage }} физического урона и удерживая в воздухе всех подброшенных рядом врагов еще {{ rknockupduration }} сек. При этом его запас потока увеличивается до максимального, но все заряды умения Стальная буря обнуляются. После этого критические удары Ясуо игнорируют {{ rpercentarmorpen }}% дополнительной брони в течение {{ rbuffduration }} сек.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Briar_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Briar_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Кровавое бешенство / Перекус</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Briar"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Briar:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Брайер прыгает вперед, разбивает свои колодки и переходит в состояние Кровавого бешенства, начиная гоняться за ближайшим врагом (приоритет отдается чемпионам). Во время Кровавого бешенства у Брайер повышены скорость атаки и скорость передвижения, а ее автоатаки наносят урон всем, кто находится вокруг цели. Брайер может применить это умение повторно. В таком случае при следующей автоатаке она кусает врага, нанося дополнительный урон, который зависит от недостающего здоровья цели. Сама же Брайер восстанавливает себе здоровье в размере части от нанесенного урона.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Брайер прыгает в выбранное место и переходит в состояние Кровавого бешенства , натравливая себя на ближайшего врага на {{ berserkduration }} сек. (приоритет отдается чемпионам). В этом состоянии она получает {{ berserkas*100 }}% скорости атаки и {{ berserkms*100 }}% скорости передвижения , а ее автоатаки наносят {{ totalaoedamage }} физического урона врагам вокруг цели. При повторном применении умения Брайер усиливает свою следующую автоатаку. Она наносит физический урон в размере {{ totalattackbonusdamage }} + {{ totalattackpercentmissinghealth }}% от недостающего здоровья и восстанавливает Брайер здоровье в размере {{ attackmaxhpheal }} + {{ attackhealpercent*100 }}% от нанесенного урона . {{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Kennen_R">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Kennen_R</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Убийственный шторм</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Kennen"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Kennen:R</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Кеннен призывает бурю, которая наносит магический урон окружающим вражеским чемпионам.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Кеннен создает бурю, нанося {{ pertickdamagecalculated }} магического урона всем окружающим врагам раз в {{ kennenrtickrate }} сек., а также получая {{ kennenrdefenses }} брони и {{ kennenrdefenses }} сопротивления магии . Буря действует в течение {{ kennenrduration }} сек. Если враг поражается несколько раз, каждый последующий разряд наносит ему на {{ damageamp*100 }}% больше урона.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Nilah">
