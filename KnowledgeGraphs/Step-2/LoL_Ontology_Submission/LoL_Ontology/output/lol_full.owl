  <rdf:Description rdf:about="https://example.org/lol-ontology#Pyke_E">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Pyke_E</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Призрачный прилив</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Pyke"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pyke:E</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">E</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пайк совершает рывок и оставляет позади себя призрака, который возвращается к нему, оглушая вражеских чемпионов на своем пути.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пайк совершает рывок, оставляя за собой призрака утопленника, который вскоре возвращается к нему. Призрак оглушает врагов на {{ stunduration }} сек. и наносит чемпионам {{ totaldamage }} физического урона .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Karthus_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Karthus_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Стена боли</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Karthus"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Karthus:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Картус создает энергетический барьер, который замедляет проходящих сквозь него врагов и уменьшает их сопротивление магии на некоторое время.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Картус создает стену на {{ wallduration }} сек. Враги, проходящие сквозь нее, теряют {{ magicresistshred }}% сопр. магии на {{ debuffduration }} сек. и замедляются на {{ slowpercent }}% (эффект ослабевает в течение времени действия).{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
