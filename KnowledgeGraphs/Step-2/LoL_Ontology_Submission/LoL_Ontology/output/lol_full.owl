  <rdf:Description rdf:about="https://example.org/lol-ontology#Source_Volibear">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#SourceDocument"/>
    <rdfs:label>Source_Volibear</rdfs:label>
    <lol:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://ddragon.leagueoflegends.com/cdn/16.20.1/data/ru_RU/champion/Volibear.json</lol:sourceURL>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N14e71e0562134588b71eb5817a7249c2">
    <rdf:first rdf:resource="https://example.org/lol-ontology#AllyShieldChampion"/>
    <rdf:rest rdf:nodeID="N65660cc27a87488b9e116c3dadb3e2f6"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Zeri_P">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
    <rdfs:label>Zeri_P</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ходячая батарейка</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Zeri"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Zeri:P</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Автоатаки Зери наносят магический урон и считаются умениями. Передвигаясь и применяя Стрельбу очередью, Зери заряжает энергией электроранец. Когда уровень заряда достигает максимума, ее следующая автоатака наносит дополнительный урон.</lol:description>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#MasterYi_P">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
    <rdfs:label>MasterYi_P</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Двойной удар</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_MasterYi"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MasterYi:P</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Мастер Йи бьет дважды через каждые несколько автоатак.</lol:description>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Udyr_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Udyr_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Дикий коготь</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Udyr"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Udyr:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Удир увеличивает свою скорость атаки, и его следующие две автоатаки наносят дополнительный физический урон. Повторное применение: Удир еще сильнее увеличивает скорость атаки, и его следующие две автоатаки поражают цель молнией.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Стойка медведя: Удир увеличивает свою скорость атаки на {{ attackspeedbase*100 }}% на {{ attackspeeddurationbase }} сек. В течение этого времени его автоатаки дополнительно наносят {{ onhitdamage }} физического урона %i:OnHit% при попадании . Кроме того, его следующие две автоатаки в этой стойке дополнительно наносят физический урон в размере {{ maxhponhit1 }} от максимального запаса здоровья . Дальность этих автоатак увеличена на {{ attackrange }}. Пробуждение: прибавка к скорости атаки увеличивается до {{ empoweredtotalas }} , а урон от максимального запаса здоровья – до {{ q2totalonhithpdamage }} . Кроме того, при следующих двух автоатаках Удир создает цепные молнии, которые бьют 6 раз, нанося изолированным целям магический урон в размере {{ empoweredlightningbonusmax }} от максимального запаса здоровья суммарно (если рядом есть другие враги, молнии бьют по ним). {{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Olaf_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Olaf_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Превозмогание</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Olaf"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Olaf:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Скорость атаки Олафа увеличена, и он получает щит.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Олаф увеличивает скорость атаки на {{ attackspeed*100 }}% на {{ duration }} сек., а также получает щит прочностью {{ baseshield }} плюс {{ shieldpercmissinghp*100 }}% от недостающего здоровья (максимальная прочность: {{ maxshieldcalc }}, когда уровень здоровья ниже {{ thresholdformax*100 }}%) на {{ shieldduration }} сек.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Taric">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#Champion"/>
    <rdfs:label>Taric</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Тарик</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Taric"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Taric</lol:entityId>
    <lol:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Щит Валорана</lol:title>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
    <lol:resourceType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Мана</lol:resourceType>
    <lol:baseHP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">645.0</lol:baseHP>
    <lol:baseMP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">300.0</lol:baseMP>
    <lol:baseArmor rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">40.0</lol:baseArmor>
    <lol:baseAttackDamage rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">55.0</lol:baseAttackDamage>
    <lol:baseMoveSpeed rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">340.0</lol:baseMoveSpeed>
    <lol:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Support"/>
    <lol:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Tank"/>
    <lol:reviewStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">effects_not_reviewed</lol:reviewStatus>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Taric_P"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Taric_Q"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Taric_W"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Taric_E"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Taric_R"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Sylas_E">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Sylas_E</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Побег/Пленение</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Sylas"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sylas:E</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">E</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Сайлас совершает рывок в выбранное место. Применив умение повторно, он выпускает свои цепи и притягивает себя к пораженному врагу.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Сайлас совершает быстрый рывок, после чего может повторно применить умение в течение 3.5 сек. Повторное применение: Сайлас выстреливает цепями и притягивается к первому пораженному врагу, нанося {{ damage }} магического урона и подбрасывая его на {{ knockupduration }} сек.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Xerath_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Xerath_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Магический разряд</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Xerath"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Xerath:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Зерат выпускает разряд магической энергии, нанося магический урон всем врагам на прямой линии.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Начало подготовки: Зерат начинает заряжать магический луч, постепенно замедляясь на значение вплоть до 50%. Применение: Зерат выпускает луч, нанося {{ tooltiptotaldamage }} магического урона . Дальность действия зависит от времени подготовки.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Rell_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Rell_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пробивающий удар</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Rell"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Rell:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Релл наносит магический урон бойцам перед собой, оглушая их и уничтожая наложенные на них щиты.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Релл совершает выпад копьем, оглушая пораженных врагов на {{ stunduration }} сек., уничтожая наложенные на них щиты и нанося {{ damage }} магического урона .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Pyke">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#Champion"/>
    <rdfs:label>Pyke</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пайк</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Pyke"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pyke</lol:entityId>
    <lol:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Потрошитель из Кровавой гавани</lol:title>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
    <lol:resourceType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Мана</lol:resourceType>
    <lol:baseHP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">670.0</lol:baseHP>
    <lol:baseMP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">415.0</lol:baseMP>
    <lol:baseArmor rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">37.0</lol:baseArmor>
    <lol:baseAttackDamage rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">62.0</lol:baseAttackDamage>
    <lol:baseMoveSpeed rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">330.0</lol:baseMoveSpeed>
    <lol:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Support"/>
    <lol:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Assassin"/>
    <lol:reviewStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">effects_not_reviewed</lol:reviewStatus>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Pyke_P"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Pyke_Q"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Pyke_W"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Pyke_E"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Pyke_R"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#XinZhao_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>XinZhao_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Удар трех когтей</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_XinZhao"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">XinZhao:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Следующие три автоатаки Ксина Жао наносят дополнительный урон. Кроме того, третья автоатака подбрасывает противника в воздух.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Следующие 3 автоатаки Ксина Жао дополнительно наносят {{ bonusdamage }} ед. физ. урона и сокращают перезарядку его остальных умений на 1 сек. 3-я автоатака также подбрасывает врага на {{ knockupduration }} сек. {{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Aurora_E">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Aurora_E</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Чудовство</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Aurora"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Aurora:E</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">E</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Аврора соединяет два мира, выпуская заряд духовной энергии, который замедляет врагов и наносит им урон. Затем Аврора отпрыгивает в безопасное место.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Аврора соединяет два мира, выпуская заряд духовной энергии, который наносит {{ damagecalc }} магического урона врагам в области поражения и замедляет их на {{ slowpercent*-100 }}% (эффект ослабевает в течение {{ slowduration }} сек.). После применения умения Аврора отскакивает назад на небольшое расстояние. {{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Shen_E">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Shen_E</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Теневой рывок</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Shen"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Shen:E</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">E</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Шен совершает рывок в указанном направлении, провоцируя вражеских чемпионов на своем пути.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пассивно: Шен восстанавливает {{ energyrefund }} энергии , когда наносит урон с помощью этого умения или Сумеречной атаки . Активно: Шен совершает рывок, провоцируя чемпионов и лесных монстров на {{ ccduration }} сек., а также нанося им {{ tauntdamage }} физического урона .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Gragas">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#Champion"/>
    <rdfs:label>Gragas</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Грагас</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Gragas"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gragas</lol:entityId>
    <lol:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Бедокур</lol:title>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
    <lol:resourceType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Мана</lol:resourceType>
    <lol:baseHP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">640.0</lol:baseHP>
    <lol:baseMP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">400.0</lol:baseMP>
    <lol:baseArmor rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">38.0</lol:baseArmor>
    <lol:baseAttackDamage rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">64.0</lol:baseAttackDamage>
    <lol:baseMoveSpeed rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">330.0</lol:baseMoveSpeed>
    <lol:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Fighter"/>
    <lol:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Mage"/>
    <lol:reviewStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">effects_not_reviewed</lol:reviewStatus>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Gragas_P"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Gragas_Q"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Gragas_W"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Gragas_E"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Gragas_R"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Vladimir_P">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
    <rdfs:label>Vladimir_P</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Багряный пакт</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Vladimir"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Vladimir:P</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Каждые 30 дополнительного здоровья Владимира увеличивают его силу умений на 1. Каждая единица силы умений Владимира увеличивает его запас здоровья на 1,6. Эти эффекты не влияют друг на друга.</lol:description>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
