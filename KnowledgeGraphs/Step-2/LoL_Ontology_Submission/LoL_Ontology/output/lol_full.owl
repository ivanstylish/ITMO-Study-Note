  <rdf:Description rdf:about="https://example.org/lol-ontology#Velkoz_R">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Velkoz_R</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Луч дезинтеграции форм жизни</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Velkoz"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Velkoz:R</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Вел'Коз испускает луч, который следует за курсором в течение 2.5 секунд и наносит магический урон. Органический распад изучает вражеских чемпионов и наносит изученным целям чистый урон.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Вел'Коз выпускает луч энергии, который следует за курсором, наносит в общей сложности {{ totaldamage }} магического урона в течение 2.5 сек. и замедляет на {{ e3 }}%. Это умение наносит чистый урон врагам, которые недавно были поражены умением Органический распад . Враги, которых поражает луч, периодически получают заряды Распада .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
