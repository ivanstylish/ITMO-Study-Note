  <rdf:Description rdf:about="https://example.org/lol-ontology#Fiddlesticks_E">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Fiddlesticks_E</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Жатва</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Fiddlesticks"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fiddlesticks:E</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">E</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Фиддлстикс рассекает область своей косой, замедляя всех пораженных врагов и накладывая безмолвие на тех из них, кто оказался в центре этой области.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Фиддлстикс выпускает темную магию, нанося врагам {{ damage }} магического урона и замедляя их на {{ slowamount*-100 }}% на {{ silenceduration }} сек. На врагов в центре также накладывается безмолвие на то же время.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Ziggs_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Ziggs_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Прыгающая бомба</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Ziggs"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ziggs:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Зиггс бросает отскакивающую от земли бомбу, которая наносит магический урон.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Зиггс бросает отскакивающую от земли бомбу, которая наносит {{ totaldamage }} магического урона .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Veigar">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
