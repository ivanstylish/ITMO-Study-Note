  <rdf:Description rdf:about="https://example.org/lol-ontology#Smolder_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Smolder_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Супержаркое дыхание</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Smolder"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Smolder:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Смолдер дышит пламенем на врага. Чем больше зарядов он накапливает, тем сильнее становится умение.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Смолдер дышит пламенем на врага, нанося {{ totaldamage }} физического урона и {{ spell.smolderp:passive_qdamageincrease }} магического урона . Если цель погибает, Смолдер восстанавливает {{ manarestore }} маны (не более одного раза за применение умения). Это умение усиливается в зависимости от количества зарядов Драконьей тренировки : {{ stacktier1 }} : Смолдер наносит урон всем врагам вокруг цели. {{ stacktier2 }} : за целью происходят взрывы ({{ tier2_numberofblowback }} ), которые наносят {{ tier2_blowbackpercentagedamage }}% урона этого умения. {{ stacktier3 }} : Смолдер поджигает цель, нанося ей чистый урон в размере {{ tier3_burn }} от максимального запаса здоровья в течение {{ tier3_dotlength }} сек. Если у подожженного вражеского чемпиона остается менее {{ tier3_executethreshold }} здоровья, он мгновенно погибает.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Neeko_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Neeko_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Взрывное цветение</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Neeko"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Neeko:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Нико бросает семя, которое наносит магический урон. Семя расцветает снова, если поражает чемпионов или убивает бойцов.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Нико бросает семя, которое расцветает и наносит {{ explosiondamage }} магического урона . Если семя убивает бойца или поражает чемпиона либо большого монстра, оно расцветает еще раз, нанося {{ seconddamage }} магического урона . Семя может расцвести повторно не более 2 раз.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
