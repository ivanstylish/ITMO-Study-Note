  <rdf:Description rdf:about="https://example.org/lol-ontology#Shyvana_P">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
    <rdfs:label>Shyvana_P</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Крепкая чешуя</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Shyvana"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Shyvana:P</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">При участии в убийстве вражеских чемпионов, а также больших миньонов и монстров Шивана получает заряды Крепкой чешуи, повышая свои защитные показатели.</lol:description>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Amumu_R">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Amumu_R</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Проклятие печальной мумии</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Amumu"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Amumu:R</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Амуму опутывает окружающих врагов бинтами, накладывая на них Проклятие , нанося урон и оглушая.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Амуму выпускает в стороны свои бинты, оглушая врагов на {{ rduration }} сек., нанося {{ rcalculateddamage }} магического урона и накладывая Проклятие .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
