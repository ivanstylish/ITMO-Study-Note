  <rdf:Description rdf:about="https://example.org/lol-ontology#Morgana_Q_Root_Enemy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#AbilityEffect"/>
    <rdfs:label>Morgana_Q_Root_Enemy</rdfs:label>
    <lol:hasMechanic rdf:resource="https://example.org/lol-ontology#Root"/>
    <lol:hasTargetType rdf:resource="https://example.org/lol-ontology#Enemy"/>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Morgana"/>
    <lol:conditionText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Первый враг, в которого попал снаряд.</lol:conditionText>
    <lol:evidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Моргана выпускает заряд звездного огня, который обездвиживает первого пораженного врага на {{ rootduration }} сек. и наносит {{ totaldamage }} магического урона .{{ spellmodifierdescriptionappend }}</lol:evidenceText>
    <lol:evidenceField rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tooltip_text</lol:evidenceField>
    <lol:reviewStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">reviewed_by_assistant</lol:reviewStatus>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Udyr_R">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Udyr_R</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Лютая вьюга</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Udyr"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Udyr:R</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Удир создает вокруг себя ледяную бурю, которая замедляет врагов поблизости и наносит им урон. Повторное применение: Удир усиливает и отпускает бурю, после чего она преследует врагов и наносит дополнительный урон.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Стойка криофеникса: Удир на {{ buffduration }} сек. создает вокруг себя ледяную бурю, которая наносит врагам поблизости {{ stormdamage }} магического урона в секунду и замедляет их на {{ slowpotency*100 }}%. Кроме того, следующие две автоатаки Удира в этой стойке наносят {{ pulsedamage }} магического урона врагам внутри бури. Пробуждение: буря отходит от Удира и начинает преследовать врага, которого он атаковал последним. При этом она дополнительно наносит магический урон в размере {{ percenthpblast }} от максимального запаса здоровья на протяжении действия и замедляет еще на {{ empoweredslow }}.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Lux">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#Champion"/>
    <rdfs:label>Lux</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Люкс</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Lux"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Lux</lol:entityId>
    <lol:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Леди сияния</lol:title>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
    <lol:resourceType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Мана</lol:resourceType>
    <lol:baseHP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">580.0</lol:baseHP>
    <lol:baseMP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">440.0</lol:baseMP>
    <lol:baseArmor rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">21.0</lol:baseArmor>
    <lol:baseAttackDamage rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">54.0</lol:baseAttackDamage>
    <lol:baseMoveSpeed rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">330.0</lol:baseMoveSpeed>
    <lol:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Mage"/>
    <lol:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Support"/>
    <lol:reviewStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">effects_reviewed_by_assistant</lol:reviewStatus>
