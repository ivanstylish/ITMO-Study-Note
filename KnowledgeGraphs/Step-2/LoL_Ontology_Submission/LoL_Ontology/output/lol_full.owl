    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Viego_Q"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Viego_W"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Viego_E"/>
