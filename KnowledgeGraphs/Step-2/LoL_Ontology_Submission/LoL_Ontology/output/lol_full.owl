    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Veigar_R"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Syndra_R">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Syndra_R</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Высвобожденная сила</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Syndra"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Syndra:R</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Синдра наносит цели урон всеми активными сферами.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пассивно : на Темную сферу дополнительно действует {{ qhasteperrank }} ускорения умений за каждый уровень Высвобожденной силы . Синдра низвергает на вражеского чемпиона катастрофическую мощь, запуская в него 3 темные сферы , которые вращаются вокруг нее, и до 4 сфер поблизости. Каждая темная сфера наносит {{ damagecalc }} ед. магического урона (но не более {{ maxdamagecalc }} ед. магического урона ). Осколки гнева ({{ spell.syndrapassive:rupgradethreshold }}) : это умение казнит врагов, у которых осталось менее {{ upgradeexecutethreshold*100 }}% здоровья.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Source_Galio">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#SourceDocument"/>
    <rdfs:label>Source_Galio</rdfs:label>
    <lol:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://ddragon.leagueoflegends.com/cdn/16.20.1/data/ru_RU/champion/Galio.json</lol:sourceURL>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
