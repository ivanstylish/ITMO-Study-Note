  <rdf:Description rdf:about="https://example.org/lol-ontology#TahmKench_P">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
    <rdfs:label>TahmKench_P</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Жор</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_TahmKench"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TahmKench:P</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">При использовании умений Таам Кенч пользуется преимуществами своей огромной массы, нанося дополнительный урон, зависящий от его максимального запаса здоровья. Таам Кенч накладывает заряд Жора на всех чемпионов, которым наносит урон. Когда накапливается три заряда, он получает возможность проглотить их при помощи Хватай-глотай .</lol:description>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
