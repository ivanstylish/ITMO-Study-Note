   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Draven">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#Champion"/>
    <rdfs:label>Draven</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Дрейвен</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Draven"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Draven</lol:entityId>
    <lol:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Блистательный палач</lol:title>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
    <lol:resourceType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Мана</lol:resourceType>
    <lol:baseHP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">675.0</lol:baseHP>
    <lol:baseMP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">361.0</lol:baseMP>
    <lol:baseArmor rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">29.0</lol:baseArmor>
    <lol:baseAttackDamage rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">64.0</lol:baseAttackDamage>
    <lol:baseMoveSpeed rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">330.0</lol:baseMoveSpeed>
    <lol:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Marksman"/>
    <lol:reviewStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">effects_not_reviewed</lol:reviewStatus>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Draven_P"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Draven_Q"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Draven_W"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Draven_E"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Draven_R"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Draven_R">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Draven_R</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Кружащаяся смерть</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Draven"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Draven:R</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Дрейвен с силой швыряет два массивных топора, которые наносят физический урон всем врагам на своем пути. Топоры меняют направление движения на обратное и возвращаются к Дрейвену после поражения вражеского чемпиона. Дрейвен может активировать умение повторно, чтобы заставить их вернуться раньше. Топоры наносят меньше урона каждому последующему врагу (при смене направления уменьшение урона сбрасывается). Если у врага остается меньше здоровья, чем текущее количество зарядов Обожания, Дрейвен добивает его.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Дрейвен кидает два больших топора, которые наносят {{ rcalculateddamage }} физического урона . При поражении вражеского чемпиона или повторном применении умения топоры разворачиваются и возвращаются к Дрейвену. Топоры наносят на {{ rdamagereductionperhit*100 }}% меньше урона за каждого пораженного врага (минимальный урон - {{ rmindamagepercent }}%). Если после поражения умением Кружащаяся смерть у вражеского чемпиона остается меньше здоровья, чем {{ rpassivestackscoefficient*100 }}% от текущего количества зарядов умения Лига Дрейвена ({{ rpassivetruedamage }}), Дрейвен добивает его.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Mel_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Mel_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Лучезарный залп</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Mel"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mel:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Мэл выпускает несколько снарядов, которые взрываются в выбранном месте, нанося урон врагам в области поражения.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Мэл выпускает залп из {{ explosioncount }} снарядов, которые взрываются в выбранном месте. Первый взрыв наносит {{ initialexplosiondamage }} ед. магического урона , а каждый последующий взрыв наносит {{ totalexplosiondamage }} ед. магического урона (до {{ alldamagehit }} ед. магического урона суммарно).{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#LeeSin_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>LeeSin_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Звуковая волна / Резонирующий удар</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_LeeSin"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LeeSin:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Звуковая волна: Ли Син создает диссонирующую волну звука, которая позволяет обнаружить противников и наносит физический урон первому врагу, с которым столкнется. Если Звуковая волна поражает врага, Ли Син может использовать Резонирующий удар в течение следующих 3 секунд. Резонирующий удар: Ли Син совершает рывок к врагу, пораженному Звуковой волной, и наносит физический урон, который зависит от недостающего запаса здоровья цели.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ли Син создает диссонирующую волну звука, которая наносит {{ initialdamage }} ед. физического урона первому врагу на пути. Кроме того, Ли Син получает истинное видение цели и может повторно применить умение в течение {{ reactivatetime }} сек. Повторное применение: Ли Син совершает рывок к врагу, пораженному Звуковой волной, и наносит от {{ recastdamage }} до {{ empowereddamage }} ед. физического урона в зависимости от недостающего здоровья цели. {{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Ivern_R">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Ivern_R</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Маргаритка!</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Ivern"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ivern:R</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Иверн призывает стража по имени Маргаритка, которая помогает ему в бою. Применяйте умение повторно, чтобы отдавать Маргаритке новые команды.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Иверн призывает стража по имени Маргаритка, которая помогает ему в бою в течение {{ daisyduration }} сек. Маргаритка, бей!: каждая 3-я атака Маргаритки подряд против одного и того же чемпиона либо эпического монстра запускает ударную волну, которая наносит всем пораженным врагам {{ totalshockwavedamage }} магического урона , а также подбрасывает их на {{ shockwaveccduration }} сек. Этот эффект срабатывает не чаще чем раз в {{ shockwavecd }} сек. Повторное применение: Иверн указывает Маргаритке, кого атаковать и куда перемещаться.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
