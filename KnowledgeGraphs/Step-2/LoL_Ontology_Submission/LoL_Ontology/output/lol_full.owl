  <rdf:Description rdf:about="https://example.org/lol-ontology#Heimerdinger_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Heimerdinger_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Эволюционирующая турель H-28G</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Heimerdinger"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Heimerdinger:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Хеймердингер сооружает турель, оборудованную скорострельной пушкой и пронзающим цели лазером (турели наносят вдвое меньше урона башням).</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Хеймердингер создает турель , которая атакует врагов поблизости. Одновременно он может установить до {{ maxturrets }} турелей. Турели постепенно заряжаются. Полностью зарядившись, они применяют усиленную атаку. Если Хеймердингер отходит слишком далеко, его турели отключаются через 8 сек. У этого умения может быть до {{ maxkits }} зарядов.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Source_Viktor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#SourceDocument"/>
