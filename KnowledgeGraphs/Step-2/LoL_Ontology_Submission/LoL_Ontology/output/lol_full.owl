  <rdf:Description rdf:about="https://example.org/lol-ontology#RekSai_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>RekSai_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Гнев королевы / Поиск жертвы</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_RekSai"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RekSai:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Три следующие автоатаки Рек'Сай наносят дополнительный физический урон всем окружающим ее врагам. Будучи под землей, Рек'Сай выстреливает зарядом энергии Бездны, который взрывается при столкновении с первым врагом на пути, нанося урон всем противникам в области поражения и раскрывая их.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">На поверхности: скорость атаки 3 следующих автоатак Рек'Сай, примененных в течение {{ buffduration }} сек., увеличивается на {{ attackspeed*100 }}%, и они дополнительно наносят {{ totaldamagetooltip }} физического урона врагам поблизости. Автоатаки обновляют продолжительность действия этого умения.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Taliyah">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
