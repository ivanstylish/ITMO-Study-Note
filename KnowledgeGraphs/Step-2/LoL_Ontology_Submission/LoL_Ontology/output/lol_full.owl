  <rdf:Description rdf:about="https://example.org/lol-ontology#Source_Skarner">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#SourceDocument"/>
    <rdfs:label>Source_Skarner</rdfs:label>
    <lol:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://ddragon.leagueoflegends.com/cdn/16.20.1/data/ru_RU/champion/Skarner.json</lol:sourceURL>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Velkoz_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Velkoz_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Плазменное деление</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Velkoz"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Velkoz:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Вел'Коз стреляет зарядом плазмы, который разделяется надвое после повторной активации умения или после попадания во врага. Попадая во врага, плазма наносит урон и замедляет его.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Вел'Коз стреляет зарядом плазмы, который наносит врагам {{ totaldamage }} магического урона и замедляет их на {{ slowamount*100 }}% (эффект ослабевает в течение {{ slowduration }} сек.). Когда заряд пролетает максимальную дальность, или попадает во врага, или Вел'Коз повторно применяет умение, он разделяется надвое и его части разлетаются под углом 90 градусов к первоначальной траектории. Убийство бойца с помощью этого умения восстанавливает {{ tooltipmanarefund }} маны .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Illaoi">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#Champion"/>
    <rdfs:label>Illaoi</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Иллаой</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Illaoi"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Illaoi</lol:entityId>
    <lol:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Жрица Матери Глубин</lol:title>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
    <lol:resourceType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Мана</lol:resourceType>
    <lol:baseHP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">656.0</lol:baseHP>
    <lol:baseMP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">350.0</lol:baseMP>
    <lol:baseArmor rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">35.0</lol:baseArmor>
    <lol:baseAttackDamage rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">65.0</lol:baseAttackDamage>
    <lol:baseMoveSpeed rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">350.0</lol:baseMoveSpeed>
    <lol:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Fighter"/>
    <lol:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Tank"/>
    <lol:reviewStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">effects_not_reviewed</lol:reviewStatus>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Illaoi_P"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Illaoi_Q"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Illaoi_W"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Illaoi_E"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Illaoi_R"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Leblanc_E">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Leblanc_E</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Эфемерные цепи</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Leblanc"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Leblanc:E</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">E</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ле Блан бросает цепь, которая сковывает первого пораженного врага. Если цель остается скованной в течение 1.5 секунды, Ле Блан обездвиживает ее и наносит дополнительный урон.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ле Блан бросает цепь, которая сковывает первого пораженного врага, нанося {{ initialdamage }} ед. магического урона . Ле Блан получает истинное видение цели. Если цель скована в течение {{ tetherduration }} сек., Ле Блан обездвиживает ее на {{ rootduration }} сек. и дополнительно наносит {{ delayeddamage }} ед. магического урона .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Karma_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Karma_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Решимость</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Karma"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Karma:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Карма создает связь с выбранным вражеским чемпионом, делая его видимым и нанося ему урон. Если связь не прерывается, враг обездвиживается и вновь получает урон. Эффект Мантры: Карма усиливает связь с врагом, восстанавливая себе здоровье и увеличивая продолжительность обездвиживания.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Карма создает связь между собой и чемпионом или лесным монстром, нанося цели {{ initialdamage }} магического урона и раскрывая ее на {{ tetherduration }} сек. Если связь не разрывается, цель снова получает {{ initialdamage }} магического урона и обездвиживается на {{ rootduration }} сек.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
    <lol:hasEffect rdf:resource="https://example.org/lol-ontology#Karma_W_Damage_Enemy"/>
    <lol:hasEffect rdf:resource="https://example.org/lol-ontology#Karma_W_Reveal_Enemy"/>
    <lol:hasEffect rdf:resource="https://example.org/lol-ontology#Karma_W_Root_Enemy"/>
    <lol:hasEffect rdf:resource="https://example.org/lol-ontology#Karma_W_Heal_Self"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Xerath_E">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Xerath_E</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Поражающая сфера</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Xerath"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Xerath:E</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">E</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Зерат выпускает сферу чистой магической энергии, которая оглушает пораженного врага и наносит ему магический урон.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Зерат выпускает сферу чистой магии, оглушая первого врага на пути на время вплоть до {{ maxstunduration }} сек. в зависимости от расстояния полета, а также нанося {{ tooltiptotaldamage }} магического урона . {{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Shen_R">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Shen_R</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Плечом к плечу</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Shen"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Shen:R</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Шен защищает союзного чемпиона поглощающим урон щитом и через некоторое время телепортируется к нему на помощь.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Шен выбирает любого союзного чемпиона на карте и накладывает на него щит прочностью от {{ shield }} до {{ maxshield }} в зависимости от недостающего здоровья цели на {{ shieldduration }} сек. (максимальная прочность достигается при 60% недостающего здоровья). Спустя {{ channelduration }} сек. подготовки Шен телепортируется к цели со своим призрачным клинком .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Trundle_E">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Trundle_E</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ледяной столп</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Trundle"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Trundle:E</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">E</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Трандл создает в выбранной точке ледяной столп, который делает область непроходимой и замедляет всех врагов вокруг.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Трандл создает ледяной столп на {{ pillarduration }} сек., слегка отбрасывая врагов, находящихся прямо в точке его появления. Враги поблизости замедляются на {{ slowamount }}%.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Kayle_E">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Kayle_E</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Клинок звездного огня</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Kayle"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Kayle:E</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">E</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пассивно: небесный меч Кейл, Добродетель, наносит дополнительный магический урон врагам, которых она атакует. Активно: следующая атака Кейл поражает врага небесным огнем, нанося дополнительный урон в зависимости от недостающего здоровья цели.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пассивно: автоатаки дополнительно наносят {{ epassivetotaldamage }} магического урона . Активно: следующая автоатака Кейл становится дальнобойной и дополнительно наносит магический урон в размере {{ activetotalexecutedamage }} от недостающего здоровья . Эта атака улучшается, когда Кейл достигает {{ spell.kaylepassive:levelforpassiverank2 }}-го уровня , и взрывается при поражении цели, нанося урон врагам поблизости.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Seraphine_P">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
    <rdfs:label>Seraphine_P</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Сценическое обаяние</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Seraphine"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Seraphine:P</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Каждое третье базовое умение Серафины применяется дважды. Кроме того, если она применяет умения рядом с союзниками, дальность и магический урон ее следующей автоатаки увеличиваются.</lol:description>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Lulu_R">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Lulu_R</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Буйный рост</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Lulu"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Lulu:R</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Лулу увеличивает союзника в размере, подбрасывая окружающих его врагов в воздух. На несколько секунд он получает большое количество дополнительного здоровья и ауру, которая замедляет врагов поблизости.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Лулу увеличивает союзника, подбрасывая окружающих его врагов на {{ knockbackduration }} сек. При этом максимальный запас здоровья цели увеличивается на {{ totalbonushealth }} и она замедляет окружающих врагов на {{ slowpercent }}% на {{ buffduration }} сек.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Jax">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#Champion"/>
