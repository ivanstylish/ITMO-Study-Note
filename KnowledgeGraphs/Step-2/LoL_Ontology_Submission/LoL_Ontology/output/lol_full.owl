    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Shen_Q"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Shen_W"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Shen_E"/>
