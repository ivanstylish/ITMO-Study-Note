  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Belveth_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Belveth_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Сверху и снизу</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Belveth"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Belveth:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Бел'Вет бьет хвостом, нанося пораженным врагам урон, а также подбрасывая их и замедляя.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Бел'Вет бьет хвостом, нанося врагам {{ damage }} магического урона , а также подбрасывая их на {{ duration }} сек. и замедляя на {{ slowpercent*100 }}% на {{ slowduration }} сек. При попадании по вражескому чемпиону это умение сокращает перезарядку Неотвратимой Бездны в том направлении, в котором находилась цель.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Syndra">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#Champion"/>
    <rdfs:label>Syndra</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Синдра</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Syndra"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Syndra</lol:entityId>
    <lol:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Темная властительница</lol:title>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
    <lol:resourceType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Мана</lol:resourceType>
    <lol:baseHP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">583.0</lol:baseHP>
    <lol:baseMP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">480.0</lol:baseMP>
    <lol:baseArmor rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">25.0</lol:baseArmor>
    <lol:baseAttackDamage rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">54.0</lol:baseAttackDamage>
    <lol:baseMoveSpeed rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">330.0</lol:baseMoveSpeed>
    <lol:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Mage"/>
    <lol:reviewStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">effects_not_reviewed</lol:reviewStatus>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Syndra_P"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Syndra_Q"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Syndra_W"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Syndra_E"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Syndra_R"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Hecarim_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Hecarim_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Буйство</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Hecarim"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hecarim:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Гекарим рассекает ближайших врагов, нанося физический урон. Если Гекарим наносит урон хотя бы одному врагу, он увеличивает урон и сокращает перезарядку последующих применений Буйства.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Гекарим рассекает ближайших врагов, нанося {{ damage }} ед. физ. урона . Поражая врага, Гекарим получает заряд, сокращающий перезарядку этого умения на {{ rampagecooldownreduction }} сек. и повышающий его урон на {{ rampagebonusdamageperc }}% на {{ buffduration }} сек. Макс. {{ maxstacks }} зар. {{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#resourceType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>resourceType</rdfs:label>
    <rdfs:domain rdf:resource="https://example.org/lol-ontology#Champion"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Brand">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#Champion"/>
    <rdfs:label>Brand</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Брэнд</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Brand"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Brand</lol:entityId>
    <lol:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пылающее возмездие</lol:title>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
    <lol:resourceType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Мана</lol:resourceType>
    <lol:baseHP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">570.0</lol:baseHP>
    <lol:baseMP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">469.0</lol:baseMP>
    <lol:baseArmor rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">24.0</lol:baseArmor>
    <lol:baseAttackDamage rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">57.0</lol:baseAttackDamage>
    <lol:baseMoveSpeed rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">340.0</lol:baseMoveSpeed>
    <lol:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Mage"/>
    <lol:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Support"/>
    <lol:reviewStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">effects_not_reviewed</lol:reviewStatus>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Brand_P"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Brand_Q"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Brand_W"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Brand_E"/>
