  <rdf:Description rdf:about="https://example.org/lol-ontology#Ashe_P">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
    <rdfs:label>Ashe_P</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Морозный выстрел</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Ashe"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ashe:P</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Автоатаки Эш замедляют врагов и помечают их. Помеченным целям Эш наносит дополнительный урон. Критические удары Эш не наносят увеличенного урона, однако сильнее замедляют цель.</lol:description>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
