  <rdf:Description rdf:about="https://example.org/lol-ontology#Yorick_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Yorick_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Темная процессия</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Yorick"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Yorick:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Йорик создает разрушаемую стену, которая окружает выбранную область и препятствует передвижению врагов.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Йорик призывает стену духов, которая не пропускает врагов, но пропускает союзников. У стены {{ wallhealthtooltip }} здоровья , и она исчезает через {{ circleduration }} сек.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Fiddlesticks">
