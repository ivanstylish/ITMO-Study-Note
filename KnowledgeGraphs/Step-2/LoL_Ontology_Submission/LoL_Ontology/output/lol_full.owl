  <rdf:Description rdf:about="https://example.org/lol-ontology#Corki_E">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Corki_E</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пулемет</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Corki"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Corki:E</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">E</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Корки ведет огонь из пулемета по противникам перед собой, нанося им урон и уменьшая их броню и сопротивление магии.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Корки стреляет из пулемета перед собой, нанося врагам {{ totaldamage }} физического урона в течение {{ sprayduration }} сек., а также уменьшая их броню и сопротивление магии на {{ shredmax*-1 }}.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Chogath_R">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Chogath_R</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пожирание</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Chogath"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chogath:R</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Чо'Гат пожирает врага, нанося ему большое количество чистого урона. Если цель умирает, Чо'Гат растет, получая прибавку к максимальному запасу здоровья.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Чо'Гат жадно пожирает противника, нанося {{ rdamage }} чистого урона чемпионам или {{ rmonsterdamage }} урона миньонам и лесным монстрам. Если цель умирает, Чо'Гат получает заряд, от чего он растет, увеличивая свой максимальный запас здоровья на {{ rhealthperstack }} . Пожирая миньонов и неэпических лесных монстров, можно накопить не более {{ rminionmaxstacks }} зарядов. {{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
