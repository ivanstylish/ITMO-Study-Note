  <rdf:Description rdf:about="https://example.org/lol-ontology#Karma_W_Reveal_Enemy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#AbilityEffect"/>
    <rdfs:label>Karma_W_Reveal_Enemy</rdfs:label>
    <lol:hasMechanic rdf:resource="https://example.org/lol-ontology#Reveal"/>
    <lol:hasTargetType rdf:resource="https://example.org/lol-ontology#Enemy"/>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Karma"/>
    <lol:conditionText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">На время связи раскрывается выбранная вражеская цель.</lol:conditionText>
    <lol:evidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Карма создает связь между собой и чемпионом или лесным монстром, нанося цели {{ initialdamage }} магического урона и раскрывая ее на {{ tetherduration }} сек. Если связь не разрывается, цель снова получает {{ initialdamage }} магического урона и обездвиживается на {{ rootduration }} сек.{{ spellmodifierdescriptionappend }}</lol:evidenceText>
    <lol:evidenceField rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tooltip_text</lol:evidenceField>
    <lol:reviewStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">reviewed_by_assistant</lol:reviewStatus>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Akshan_R">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Akshan_R</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Расплата</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Akshan"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Akshan:R</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Акшан фиксируется на вражеском чемпионе и накапливает пули. Затем он начинает стрелять. Каждая пуля наносит первому пораженному чемпиону, миньону или строению урон, который зависит от недостающего здоровья цели.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Акшан фиксируется на вражеском чемпионе и начинает заряжать пистолет энергией. Подготовка длится до {{ channelduration }} сек., и за это время накапливается до {{ numberofbullets }} пуль. Повторное применение: Акшан выпускает все накопленные пули. Каждая из них наносит {{ damageperbulletwithcrit }} физического урона первому пораженному врагу или строению. Урон увеличивается вплоть до {{ maxdamageperbullet }} в зависимости от недостающего здоровья.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#canApplyMechanic">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>canApplyMechanic</rdfs:label>
    <rdfs:comment xml:lang="ru">Выводится цепочкой hasAbility / hasEffect / hasMechanic; не хранит условия.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/lol-ontology#Champion"/>
    <rdfs:range rdf:resource="https://example.org/lol-ontology#Mechanic"/>
    <owl:propertyChainAxiom rdf:nodeID="N79acaf50ed6b4cad9ee0a015dc8ad15a"/>
  </rdf:Description>
