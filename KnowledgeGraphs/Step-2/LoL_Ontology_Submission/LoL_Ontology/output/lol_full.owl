  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Poppy_R">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Poppy_R</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Вердикт Хранительницы</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Poppy"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Poppy:R</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Поппи некоторое время готовится, а потом с огромной силой бьет молотом, нанося урон и отбрасывая врагов очень далеко.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Начало подготовки: Поппи до {{ channelmaxduration }} сек. готовится к мощному удару молотом, замедляясь на {{ selfslow }}%. Применение: Поппи бьет по земле, создавая ударную волну, которая наносит {{ damage }} физического урона первому пораженному чемпиону и окружающим врагам, а также отбрасывает их в сторону вражеского нексуса (во время полета враги недосягаемы). Дальность применения и отбрасывания зависит от времени подготовки. Незаряженный удар наносит {{ halfdamage }} физического урона и подбрасывает на {{ knockupdurationsnap }} сек.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Jinx">
