  <rdf:Description rdf:about="https://example.org/lol-ontology#Nami_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Nami_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Прилив и отлив</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Nami"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nami:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Нами выпускает поток воды, который рикошетит между союзными и вражескими чемпионами, восстанавливая здоровье первым и нанося урон последним.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Нами выпускает поток воды, который рикошетит между союзными и вражескими чемпионами. Поток отскакивает к каждому чемпиону только один раз и поражает до {{ maxtargets }} целей. Восстанавливает {{ totalheal }} здоровья союзникам и отскакивает к ближайшему вражескому чемпиону. Наносит {{ totaldamage }} магического урона врагам и отскакивает к ближайшему союзному чемпиону. С каждым следующим отскоком восстанавливаемое здоровье и наносимый урон изменяются на {{ bouncescaling }}. {{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Morgana_W_CooldownReduction_OwnAbility">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#AbilityEffect"/>
    <rdfs:label>Morgana_W_CooldownReduction_OwnAbility</rdfs:label>
    <lol:hasMechanic rdf:resource="https://example.org/lol-ontology#CooldownReduction"/>
    <lol:hasTargetType rdf:resource="https://example.org/lol-ontology#OwnAbility"/>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Morgana"/>
    <lol:conditionText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Перезарядка W сокращается, когда Моргану лечит Вытягивание души.</lol:conditionText>
    <lol:evidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Моргана поджигает землю на {{ wduration }} сек., нанося {{ totalmindamage }} ед. магического урона в секунду. Урон увеличивается вплоть до {{ totalmaxdamage }} ед. в зависимости от недостающего здоровья целей. Перезарядка этого умения сокращается на {{ cdrefundpercent*100 }}% каждый раз, когда Моргану лечит Вытягивание души .{{ spellmodifierdescriptionappend }}</lol:evidenceText>
    <lol:evidenceField rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tooltip_text</lol:evidenceField>
    <lol:reviewStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">reviewed_by_assistant</lol:reviewStatus>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
