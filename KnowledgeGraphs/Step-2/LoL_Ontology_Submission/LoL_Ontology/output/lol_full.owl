  <rdf:Description rdf:about="https://example.org/lol-ontology#Ryze_E">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Ryze_E</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Волшебный поток</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Ryze"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ryze:E</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">E</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Райз выпускает сферу чистой магической энергии, которая наносит урон цели и ослабляет всех врагов поблизости. Умения Райза получают дополнительные эффекты против ослабленных врагов.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Райз выпускает сферу, которая наносит {{ edamagecalc }} магического урона , а также накладывает Поток на цель и врагов поблизости на {{ debuffduration }} сек. Если на цель уже наложен Поток , дальность распространения увеличивается.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Corki_P">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
    <rdfs:label>Corki_P</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Хекстековые боеприпасы</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Corki"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Corki:P</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Часть урона от автоатак Корки наносится в виде дополнительного чистого урона .</lol:description>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Chogath_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Chogath_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Дикий крик</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Chogath"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chogath:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Чо'Гат издает ужасающий крик, который наносит находящимся перед ним врагам магический урон и заставляет их замолчать на несколько секунд.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Чо'Гат издает крик, накладывая на врагов безмолвие на {{ e2 }} сек. и нанося им {{ totaldamagetooltip }} магического урона .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N96962955893a44db9a6860ba837aefbf">
    <rdf:first rdf:nodeID="N8db45ae29697494abdaf3b4feaf10922"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
