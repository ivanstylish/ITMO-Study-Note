  <rdf:Description rdf:about="https://example.org/lol-ontology#Anivia_E">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Anivia_E</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Обморожение</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Anivia"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Anivia:E</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">E</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Анивия взмахивает крыльями и направляет порыв ледяного ветра в указанную цель, нанося урон. Если цель была недавно поражена Мгновенной заморозкой или получила урон от Ледяной бури максимального размера, урон удваивается.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Анивия направляет в указанную цель порыв ледяного ветра, нанося {{ totaldamage }} магического урона . Если на цель действует переохлаждение , урон умения увеличивается до {{ empowereddamage }} .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Thresh_P">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
    <rdfs:label>Thresh_P</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Проклятие</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Thresh"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Thresh:P</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Треш может собирать души врагов, умерших неподалеку, увеличивая при этом броню и силу умений.</lol:description>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
