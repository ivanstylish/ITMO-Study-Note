    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Kassadin_Q"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Kassadin_W"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Kassadin_E"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Kassadin_R"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Smolder_R">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Smolder_R</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">МА-А-АМ!</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Smolder"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Smolder:R</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Смолдер зовет свою маму, и она дышит огнем с небес. Враги в центре области поражения получают дополнительный урон и замедляются.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Мама Смолдера дышит огнем с небес, нанося врагам {{ totaldamage }} физического урона . Враги в центре области поражения вместо этого получают {{ tooltiponly_totalsweetspotdamage }} физического урона и замедляются на {{ slowamount*100 }}% на {{ slowduration }} сек. Задев Смолдера, огонь восстанавливает ему {{ momhealcalc }} здоровья .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Sylas_P">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
    <rdfs:label>Sylas_P</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Петрицитовый вихрь</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Sylas"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sylas:P</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">После применения умения Сайлас получает заряд Петрицитового вихря. При автоатаках Сайлас поглощает заряды и раскручивает заряженные цепи, нанося дополнительный магический урон пораженным врагам. Когда у Сайласа есть заряд Петрицитового вихря, его скорость атаки увеличивается.</lol:description>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#LeeSin_P">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
    <rdfs:label>LeeSin_P</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Шквал</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_LeeSin"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LeeSin:P</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">После использования любого умения скорость атаки Ли Сина увеличивается, пока он не проведет две автоатаки. Эти автоатаки восстанавливают ему энергию.</lol:description>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Katarina_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Katarina_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Танцующий клинок</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Katarina"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Katarina:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Катарина мечет во врага кинжал , который рикошетом поражает еще несколько целей, после чего падает на землю.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Катарина мечет кинжал , нанося {{ totaldamage }} магического урона цели и {{ maxbounces }} врагам поблизости. После этого кинжал отскакивает и падает на землю за основной целью.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Sona_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Sona_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ария стойкости</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Sona"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sona:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Сона исполняет арию стойкости, восстанавливая здоровье себе и наиболее пострадавшему из окружающих союзных чемпионов. Кроме того, Сона получает временную ауру, которая дает союзникам, попавшим в зону ее действия, временный щит.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Активно: Сона восстанавливает {{ totalheal }} здоровья себе и союзному чемпиону поблизости (приоритет отдается чемпионам с самым низким уровнем здоровья). После этого она начинает играть новую Мелодию . Мелодия: Сона на {{ auraduration }} сек. получает ауру, которая накладывает на союзных чемпионов щит прочностью {{ totalshield }} на {{ shieldduration }} сек. Сона получает заряд Аччелерандо , когда лечит другого раненого союзника или когда щит, наложенный на союзника при помощи этого умения, блокирует по крайней мере {{ accelerandoshieldbreakpoint }} урона. Мощный аккорд - Диминуэндо: Мощный аккорд также уменьшает физический и магический урон цели на {{ totaldiminuendoweakenpercent }} на {{ diminuendoduration }} сек.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Fiora_R">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Fiora_R</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Дерзкий вызов</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Fiora"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fiora:R</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Фиора определяет четыре слабых места чемпиона. При этом, когда она находится рядом с целью, ее скорость передвижения увеличивается. Если Фиора поражает все четыре слабых места цели или поражает хотя бы одно из них до того, как цель умрет, вокруг врага на несколько секунд возникает область, восстанавливающая здоровье Фиоре и ее союзникам.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пассивно: прибавка к скорости передвижения умения Танец дуэлянта увеличена до {{ percentms*100 }}%. Активно: Фиора определяет все четыре слабых места чемпиона и может нанести ему чистый урон в размере до {{ spell.fiorapassive:rdamagetotal }} от максимального запаса здоровья . Кроме того, находясь рядом с целью, она получает прибавку к скорости передвижения от умения Танец дуэлянта . Если Фиора поражает все четыре слабых места в течение {{ markduration }} сек. или если цель умирает после поражения хотя бы одного слабого места, Фиора восстанавливает {{ healpersecondcalc }} здоровья в секунду окружающим союзным чемпионам в течение {{ healduration }} сек.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Nami">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#Champion"/>
    <rdfs:label>Nami</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Нами</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Nami"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nami</lol:entityId>
    <lol:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Повелительница морей</lol:title>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
    <lol:resourceType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Мана</lol:resourceType>
    <lol:baseHP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">560.0</lol:baseHP>
    <lol:baseMP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">365.0</lol:baseMP>
    <lol:baseArmor rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">29.0</lol:baseArmor>
    <lol:baseAttackDamage rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">54.0</lol:baseAttackDamage>
    <lol:baseMoveSpeed rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">335.0</lol:baseMoveSpeed>
    <lol:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Support"/>
    <lol:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Mage"/>
    <lol:reviewStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">effects_not_reviewed</lol:reviewStatus>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Nami_P"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Nami_Q"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Nami_W"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Nami_E"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Nami_R"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Lulu_P">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
    <rdfs:label>Lulu_P</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пикс, волшебный спутник</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Lulu"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Lulu:P</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пикс выпускает магические заряды при каждой автоатаке чемпиона, за которым он следует. Заряды наводятся на цель, но могут быть блокированы другими бойцами.</lol:description>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Self">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#TargetType"/>
    <rdfs:label>Self</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Сам чемпион</lol:name>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Shyvana_R">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Shyvana_R</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Приземление дракона</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Shyvana"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Shyvana:R</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Шивана превращается в дракона и прыгает вперед, заставляя врагов на своем пути бежать прочь. В форме дракона она увеличивается в размерах, а ее базовые умения становятся мощнее.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пассивно : Шивана накапливает {{ fury_generation }} ед. драконьей ярости , поражая врагов автоатаками и умениями. В форме дракона она накапливает на {{ tt_fury_mult }} больше, а при нанесении урона по области целям, не являющимся чемпионами, – на {{ tt_fury_aoe_penalty }} меньше. Активно : Шивана принимает форму дракона , получает неудержимость и летит в указанную точку. Она поливает врагов под ней огнем, нанося {{ damage }} ед. магического урона и заставляя их бежать прочь в течение {{ fearduration }} сек. Когда Шивана в этой форме, ее базовые умения улучшаются, она получает {{ calc_bonus_health }} доп. здоровья и увеличивается в размере, а ее дальность атаки повышается. Шивана постепенно тратит драконью ярость и примет человеческую форму, когда истратит всю драконью ярость .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Renekton_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Renekton_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Беспощадный хищник</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Renekton"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Renekton:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">При следующей автоатаке Ренектон бьет дважды, нанося умеренный физический урон цели и оглушая ее на 0.75 секунды. Если запас ярости Ренектона составляет 50 или более, он бьет трижды, разрушая щиты от урона на цели, нанося ей большой физический урон и оглушая ее на 1.5 секунды.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">При следующей автоатаке Ренектон бьет дважды, оглушая цель на {{ stunduration }} сек. и нанося ей в общей сложности {{ basictotaldamage }} физического урона . Поражая чемпиона, Ренектон дополнительно получает {{ bonusfuryvschamps }} ярости . Бонус ярости : количество ударов увеличивается до 3. Ренектон уничтожает щиты , а затем наносит {{ emptotaldamage }} физического урона и оглушает цель на {{ enragedstunduration }} сек. Усиленное умение не дает ярости .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Thresh_R">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Thresh_R</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Короб</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Thresh"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Thresh:R</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Треш создает призрачные стены вокруг себя, которые наносят урон и замедляют врагов, пытающихся пройти сквозь них.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Треш создает тюрьму с призрачными стенами, замедляющую чемпионов на {{ slowamount }}% на {{ slowduration }} сек. и наносящую {{ totaldamage }} ед. маг. урона . Стены уничтожаются, когда их касается враг. После уничтожения первой стены остальные перестают наносить урон, а длительность их замедления падает вдвое.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Source_Kayn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#SourceDocument"/>
    <rdfs:label>Source_Kayn</rdfs:label>
    <lol:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://ddragon.leagueoflegends.com/cdn/16.20.1/data/ru_RU/champion/Kayn.json</lol:sourceURL>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Aphelios">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#Champion"/>
    <rdfs:label>Aphelios</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Афелий</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Aphelios"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Aphelios</lol:entityId>
    <lol:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Оружие веры</lol:title>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
    <lol:resourceType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Мана</lol:resourceType>
    <lol:baseHP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">600.0</lol:baseHP>
    <lol:baseMP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">348.0</lol:baseMP>
    <lol:baseArmor rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">26.0</lol:baseArmor>
    <lol:baseAttackDamage rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">55.0</lol:baseAttackDamage>
    <lol:baseMoveSpeed rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">325.0</lol:baseMoveSpeed>
    <lol:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Marksman"/>
    <lol:reviewStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">effects_not_reviewed</lol:reviewStatus>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Aphelios_P"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Aphelios_Q"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Aphelios_W"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Aphelios_E"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Aphelios_R"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Leblanc_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Leblanc_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Искажение</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Leblanc"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Leblanc:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ле Блан совершает рывок в выбранную точку, после чего наносит урон врагам вокруг себя. При повторной активации умения в течение следующих 4 секунд она возвращается в исходную точку.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ле Блан совершает рывок, после чего наносит {{ totaldamage }} ед. магического урона врагам поблизости. Ле Блан может повторно применить это умение в течение {{ snapbacktimeallowed }} сек. Повторное применение: Ле Блан возвращается в место, из которого совершила рывок.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Vladimir_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Vladimir_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Алый омут</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Vladimir"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Vladimir:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Владимир погружается в омут крови и становится недосягаемым на 2 сек., замедляя врагов над собой и вытягивая у них здоровье.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Владимир погружается в омут крови на 2 сек., увеличивая свою скорость передвижения на {{ hasteboost*100 }}% (эффект ослабевает со временем) на {{ hasteduration }} сек., а также становясь недосягаемым и призрачным . Враги в омуте замедляются на {{ movespeedmod*-100 }}%. Владимир наносит {{ totaldamage }} магического урона и восстанавливает себе {{ totalheal }} здоровья за каждого врага на протяжении действия умения.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Nunu">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#Champion"/>
    <rdfs:label>Nunu</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Нуну и Виллумп</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Nunu"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nunu</lol:entityId>
    <lol:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Мальчик и его йети</lol:title>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
    <lol:resourceType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Мана</lol:resourceType>
    <lol:baseHP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">610.0</lol:baseHP>
    <lol:baseMP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">280.0</lol:baseMP>
    <lol:baseArmor rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">29.0</lol:baseArmor>
    <lol:baseAttackDamage rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">61.0</lol:baseAttackDamage>
    <lol:baseMoveSpeed rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">345.0</lol:baseMoveSpeed>
    <lol:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Tank"/>
    <lol:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Mage"/>
    <lol:reviewStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">effects_not_reviewed</lol:reviewStatus>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Nunu_P"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Nunu_Q"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Nunu_W"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Nunu_E"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Nunu_R"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Urgot_R">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Urgot_R</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Сильнее страха смерти</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Urgot"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Urgot:R</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ургот активирует химтековый бур, который пронзает первого задетого вражеского чемпиона. Если здоровье этого чемпиона падает ниже определенного порога, Ургот признает его слабым и может казнить его.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ургот выпускает химтековый бур, который пронзает первого пораженного вражеского чемпиона, нанося {{ rcalculateddamage }} физического урона и замедляя на {{ rslowduration }} сек. на 1% за каждый 1% недостающего здоровья (максимальное замедление - {{ rmovespeedmod }}%). Если у пронзенной цели остается менее {{ rhealththreshold }}% здоровья, Ургот может повторно применить это умение, подавив цель и притянув ее к себе. Когда жертва достигает Ургота, она погибает, а окружающие враги пугаются на {{ rfearduration }} сек.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Zed_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Zed_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Живая тень</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Zed"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Zed:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пассивно: Зед восстанавливает энергию, когда он и его тени поражают врага одним умением. Восстановление энергии возможно лишь единожды для каждого повторенного умения. Активно: тень Зеда совершает рывок, после чего остается на месте в течение нескольких секунд. При повторной активации умения Зед меняется с тенью местами.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пассивно: Зед восстанавливает {{ energyrestoredoublehit }} энергии , когда он и его тени поражают врага одним и тем же умением. Активно: тень Зеда совершает рывок, после чего остается на месте в течение {{ shadowdurationtooltip }} сек. При повторном применении этого умения Зед меняется с тенью местами.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Quinn_E">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Quinn_E</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Рывок</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Quinn"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Quinn:E</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">E</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Квинн делает рывок к врагу, нанося ему физический урон и замедляя его. Достигнув цели, она отпрыгивает обратно и приземляется на расстоянии, равном максимальной дальности автоатаки.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Квинн совершает рывок к врагу, нанося {{ totaldamage }} ед. физ. урона и накладывая метку Хищной птицы . Затем Квинн отскакивает от цели, немного ее отбрасывая и замедляя на {{ slowamount*100 }}% (эффект ослабевает за {{ slowdecaytime }} сек.).{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Source_Vayne">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#SourceDocument"/>
    <rdfs:label>Source_Vayne</rdfs:label>
    <lol:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://ddragon.leagueoflegends.com/cdn/16.20.1/data/ru_RU/champion/Vayne.json</lol:sourceURL>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Jax_E">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Jax_E</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Встречный удар</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Jax"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Jax:E</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">E</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Искусность Джакса позволяет ему некоторое время уклоняться ото всех автоатак, а затем контратаковать, оглушая всех противников вокруг себя.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Джакс принимает защитную стойку на срок до {{ dodgeduration }} сек., уклоняясь от всех автоатак и получая на {{ aoedamagereduction }}% меньше урона от умений, действующих по площади. Через {{ dodgeduration }} сек. или при повторном применении Джакс наносит врагам поблизости магический урон в размере {{ totaldamage }} + {{ percenthealthdamage }}% от максимального запаса здоровья и оглушает их на {{ stunduration }} сек. Умение наносит на {{ percentincreasedperdodge*100 }}% больше урона за каждую автоатаку, от которой уклонился Джакс (максимальная прибавка – {{ maxdamage }} + {{ maxpercenthealthdamage }}% от максимального запаса здоровья ).{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Anivia_R">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Anivia_R</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ледяная буря</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Anivia"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Anivia:R</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Анивия призывает ледяную бурю, которая замедляет противников и наносит им урон.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Включено: Анивия призывает бурю изо льда и града, которая замедляет врагов на {{ slowamount }}% и наносит им {{ totaldamagepersecond }} магического урона в секунду . Буря увеличивается в размере в течение {{ growthtime }} сек. Когда буря достигает максимального размера, она переохлаждает и замедляет врагов на {{ slowpercentempoweredtt }}%, а ее урон увеличивается до {{ empowereddamagepersecondtooltiponly }} в секунду .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Blitzcrank_R">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Blitzcrank_R</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Статическое поле</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Blitzcrank"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Blitzcrank:R</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Враги, которых атакует Блицкранк, помечаются и через 1 секунду поражаются молнией, которая наносит урон. Умение можно активировать, чтобы уничтожить щиты ближайших врагов, нанести им урон и ненадолго наложить безмолвие.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пассивно: когда умение не находится на перезарядке, Блицкранк заряжает свои кулаки электричеством и его автоатаки помечают врагов. Через 1 сек. помеченные цели получают {{ passivedamage }} магического урона . Активно: Блицкранк перегружается, нанося {{ activedamage }} магического урона окружающим врагам и накладывая на них безмолвие на {{ silenceduration }} сек. При этом он разрушает их щиты.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Poppy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#Champion"/>
    <rdfs:label>Poppy</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Поппи</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Poppy"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Poppy</lol:entityId>
    <lol:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Хранительница молота</lol:title>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
    <lol:resourceType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Мана</lol:resourceType>
    <lol:baseHP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">610.0</lol:baseHP>
    <lol:baseMP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">300.0</lol:baseMP>
    <lol:baseArmor rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">35.0</lol:baseArmor>
    <lol:baseAttackDamage rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">56.0</lol:baseAttackDamage>
    <lol:baseMoveSpeed rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">345.0</lol:baseMoveSpeed>
    <lol:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Tank"/>
    <lol:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Fighter"/>
    <lol:reviewStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">effects_not_reviewed</lol:reviewStatus>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Poppy_P"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Poppy_Q"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Poppy_W"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Poppy_E"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Poppy_R"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Locke_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Locke_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ритуальные гвозди</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Locke"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Locke:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Локк подготавливает набор гвоздей души и бросает их, нанося урон пораженным врагам и ставя на них метку. Локк может поглотить метку, нанося доп. урон.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Локк подготавливает набор гвоздей души и бросает их, нанося {{ missiledamage }} ед. маг. урона и помечая пораженных врагов. Гвозди накладывают замедление ({{ slowamount1*100 }}/{{ slowamount2*100 }}/{{ slowamount3*100 }}%) на {{ slowduration1 }}/{{ slowduration2 }}/{{ slowduration3 }} сек. в зависимости от числа попаданий гвоздями. Атаки по врагу расходуют гвозди души , нанося {{ naildamage }} ед. маг. урона за каждый накопленный заряд. Урон растет на {{ twomarkbonuspercent }}% за 2 и на {{ threemarkbonuspercent }}% – за 3 гвоздя.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Pyke_R">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Pyke_R</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Смерть из глубин</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Pyke"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pyke:R</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пайк телепортируется к чемпионам и казнит врагов с низким уровнем здоровья. Если цель умирает, Пайк может применить умение еще раз, а союзник, помогавший с убийством, получает дополнительное золото.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пайк поражает всех вражеских чемпионов в X-образной области, телепортируясь к ним и казня тех, у кого осталось менее {{ rdamage }} здоровья. Чемпионы, у которых больше здоровья, и враги, не являющиеся чемпионами, получают физический урон в размере {{ reduceddamage*100 }}% от этого значения ({{ reduceddamagefinal }} ). Если в области действия умения погибает вражеский чемпион, Пайк может повторно применить это умение без затрат маны в течение {{ rrecastduration }} сек. Если эту цель казнил Пайк, последний помогавший ему союзник также получает золото за убийство. Сам Пайк всегда получает золото за убийство - даже если цель добил не он. {{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Zeri_E">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Zeri_E</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Шальная искра</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Zeri"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Zeri:E</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">E</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Зери совершает рывок на небольшое расстояние и усиливает следующее применение Стрельбы очередью – снаряды проходят сквозь врагов. Если Зери сталкивается с любым элементом ландшафта, она перелетает его.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Зери совершает рывок на небольшое расстояние и перелетает любой элемент ландшафта, с которым столкнется. В следующие {{ buffduration }} сек. снаряды умения Стрельба очередью проходят сквозь врагов, нанося {{ pendamagepercent*100 }}% урона всем целям после первой и еще {{ bonusdamagetotal }} ед. магического урона при попадании первому пораженному врагу. Поражая врагов автоатаками, Зери сокращает перезарядку этого умения на {{ cdreductionperhit }} сек. Критические удары сокращают перезарядку на {{ critcdreductionperhit }} сек.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Twitch_W">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Twitch_W</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Склянка с ядом</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Twitch"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Twitch:W</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Твич бросает склянку с ядом, отравляя всех врагов в зоне поражения Смертельным ядом и замедляя их.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Твич бросает склянку с ядом, накладывая заряд Смертельного яда на всех врагов в зоне поражения и оставляя на этом месте ядовитое облако, сохраняющееся в течение {{ duration }} сек. Враги, стоящие в ядовитом облаке, замедляются на {{ totalslowamount }}% и каждую секунду получают заряд Смертельного яда .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Zed_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Zed_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Бросок сюрикена</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Zed"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Zed:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Зед и его тени бросают сюрикены. Сюрикен наносит урон при каждом попадании по врагу.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Зед и его тени бросают сюрикены. Каждая пара сюрикенов наносит {{ totaldamage }} физического урона первому пораженному врагу и {{ passthroughdamage }} физического урона каждому последующему.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Akali_E">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Akali_E</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Сюрикен убийцы</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Akali"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Akali:E</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">E</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Акали совершает сальто назад и бросает перед собой сюрикен, нанося магический урон и помечая первого пораженного врага или дымовую завесу. При повторном применении Акали совершает рывок к помеченной цели, нанося дополнительный урон.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Акали совершает сальто назад и бросает перед собой сюрикен, нанося {{ e1damage }} магического урона и помечая первого пораженного врага или дымовую завесу. Акали может повторно применить это умение, чтобы совершить рывок к помеченной цели, нанеся {{ e2damagecalc }} магического урона .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Karma_R_Empower_OwnAbility">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#AbilityEffect"/>
    <rdfs:label>Karma_R_Empower_OwnAbility</rdfs:label>
    <lol:hasMechanic rdf:resource="https://example.org/lol-ontology#Empower"/>
    <lol:hasTargetType rdf:resource="https://example.org/lol-ontology#OwnAbility"/>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Karma"/>
    <lol:conditionText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Усиливает следующее умение Кармы, примененное в течение 8 секунд.</lol:conditionText>
    <lol:evidenceText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Карма усиливает свое следующее умение, примененное в течение 8 сек. Внутреннее пламя : дополнительно наносит {{ rqimpactdamage }} магического урона и оставляет круг пламени, который замедляет врагов и наносит еще {{ rqfielddamage }} магического урона . Решимость : Карма восстанавливает {{ rwhealamount }} от недостающего здоровья во время образования и разрыва связи, а продолжительность обездвиживания увеличивается на {{ rwbonusroot }} сек. Воодушевление : прочность щита , накладываемого на цель, увеличивается на {{ rebonusshield }} . Кроме того, Карма накладывает на окружающих чемпионов щит прочностью {{ rebonusshieldarea }} и увеличивает их скорость передвижения на {{ removespeed*100 }}% .{{ spellmodifierdescriptionappend }}</lol:evidenceText>
    <lol:evidenceField rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tooltip_text</lol:evidenceField>
    <lol:reviewStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">reviewed_by_assistant</lol:reviewStatus>
