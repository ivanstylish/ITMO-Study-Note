  <rdf:Description rdf:about="https://example.org/lol-ontology#Soraka_R">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Soraka_R</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Желание</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Soraka"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Soraka:R</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Сорака наполняет сердца всех союзных чемпионов надеждой, восстанавливая себе и им здоровье.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Сорака обращается к небесным силам, восстанавливая {{ healingcalc }} здоровья всем союзным чемпионам независимо от расстояния до них. Эффективность лечения увеличивается на {{ ampedhealing }} , если у цели менее 40% здоровья.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
