  <rdf:Description rdf:about="https://example.org/lol-ontology#Aphelios_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Aphelios_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Оружейные умения</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Aphelios"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Aphelios:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">У Афелия есть 5 разных активируемых умений, которые зависят от основного оружия: Калибрум (винтовка): Афелий совершает выстрел с большого расстояния, помечая цель. После этого он может поразить помеченного врага еще раз с дальнего расстояния. Северум (пистолет-коса): Афелий ускоряется и расстреливает ближайших врагов из обоих видов оружия. Гравитум (пушка): Афелий обездвиживает всех врагов, замедленных этим оружием. Инфернум (огнемет): Афелий поражает врагов в конусе и атакует их с помощью дополнительного оружия. Кресцендум (шакрам): Афелий создает стража, который атакует врагов с помощью дополнительного оружия.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Trundle_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Trundle_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Укус</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Trundle"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Trundle:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Трандл кусает врага, нанося ему урон, ненадолго замедляя и похищая часть его силы атаки.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Следующая автоатака Трандла наносит {{ totaldamage }} физического урона и ненадолго замедляет врага на {{ slowamount*100 }}%. После этого Трандл получает {{ bonusad }} силы атаки на {{ sapdebuffduration }} сек., а цель теряет {{ sappedad*-1 }} силы атаки на то же время.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#XinZhao_P">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#PassiveAbility"/>
    <rdfs:label>XinZhao_P</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Решительность</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_XinZhao"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">XinZhao:P</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Каждая третья автоатака наносит дополнительный урон и лечит Ксина Жао.</lol:description>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
