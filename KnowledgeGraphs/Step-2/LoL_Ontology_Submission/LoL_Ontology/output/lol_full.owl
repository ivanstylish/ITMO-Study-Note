    <rdfs:range rdf:resource="https://example.org/lol-ontology#ChampionCategory"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Zac">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#Champion"/>
    <rdfs:label>Zac</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Зак</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Zac"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Zac</lol:entityId>
    <lol:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Секретное оружие</lol:title>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
    <lol:resourceType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Нет</lol:resourceType>
    <lol:baseHP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">685.0</lol:baseHP>
    <lol:baseMP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.0</lol:baseMP>
    <lol:baseArmor rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">33.0</lol:baseArmor>
    <lol:baseAttackDamage rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">60.0</lol:baseAttackDamage>
    <lol:baseMoveSpeed rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">340.0</lol:baseMoveSpeed>
    <lol:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Tank"/>
    <lol:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Fighter"/>
    <lol:reviewStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">effects_not_reviewed</lol:reviewStatus>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Zac_P"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Zac_Q"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Zac_W"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Zac_E"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Zac_R"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Kindred_R">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Kindred_R</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Милость Овечки</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Kindred"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Kindred:R</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Овечка дарует всем бойцам в зоне действия умения защиту от смерти. Во время действия умения никто не может умереть. По окончании его действия всем восстанавливается здоровье.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Киндред благословляют землю вокруг себя на {{ buffduration }} сек., создавая область, в которой никто не умирает (действует на всех союзных, вражеских и нейтр. бойцов). Когда здоровье бойца достигает 10%, он получает невосприимчивость к урону и лечению, пока не покинет область. По окончании действия благословения все бойцы в области восстанавливают {{ healflat }} здоровья .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Vex_R">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Vex_R</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Стремительная тень</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Vex"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Vex:R</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Векс выпускает снаряд, который помечает вражеского чемпиона. При повторном применении умения Векс совершает рывок к цели и наносит урон.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Тень восторженно летит вперед, нанося {{ spell.vexr:rdamagecalc }} магического урона и помечая первого пораженного вражеского чемпиона на 4 сек. Повторное применение : Векс совершает рывок к помеченному чемпиону, нанося {{ spell.vexr:recastdamagecalc }} магического урона по прибытии. Если помеченный чемпион погибает в течение {{ spell.vexr:takedownwindow }} сек. после получения урона от этого умения, его перезарядка временно сбрасывается.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Morgana">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#Champion"/>
    <rdfs:label>Morgana</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Моргана</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Morgana"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Morgana</lol:entityId>
    <lol:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Падшая</lol:title>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
    <lol:resourceType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Мана</lol:resourceType>
    <lol:baseHP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">630.0</lol:baseHP>
    <lol:baseMP rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">340.0</lol:baseMP>
    <lol:baseArmor rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">25.0</lol:baseArmor>
    <lol:baseAttackDamage rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">56.0</lol:baseAttackDamage>
    <lol:baseMoveSpeed rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">335.0</lol:baseMoveSpeed>
    <lol:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Support"/>
    <lol:hasCategory rdf:resource="https://example.org/lol-ontology#Category_Mage"/>
    <lol:reviewStatus rdf:datatype="http://www.w3.org/2001/XMLSchema#string">effects_reviewed_by_assistant</lol:reviewStatus>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Morgana_P"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Morgana_Q"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Morgana_W"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Morgana_E"/>
    <lol:hasAbility rdf:resource="https://example.org/lol-ontology#Morgana_R"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Yunara_Q">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Yunara_Q</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Выращивание духа</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Yunara"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Yunara:Q</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Скорость атаки Юнары повышается, а ее атаки наносят дополнительный урон при попадании и поражают врагов поблизости.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Пассивно : Юнара наносит {{ calc_passive_damage }} ед. магического урона %i:OnHit% при попадании и при атаке получает {{ resource_nonchampion }} зар. Высвобождения ({{ resource_champion }} зар. , когда атакует чемпионов). Активно : Юнара поглощает {{ resource_max }} зар. Высвобождения и на {{ buff_duration }} сек. получает {{ calc_attack_speed }} скорости атаки , а ее атаки дополнительно наносят {{ calc_damage }} ед. магического урона %i:OnHit% при попадании . Во время действия эффекта атаки Юнары поражают врагов поблизости, нанося им {{ calc_damage_spread }} ед. физического урона . Просветленное состояние : это умение применяется мгновенно и действует {{ spell.yunarar:buff_duration }} сек.{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Renekton_E">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Renekton_E</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Режь и руби</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Renekton"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Renekton:E</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">E</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ренектон совершает рывок, нанося урон всем врагам на своем пути. Если запас ярости Ренектона составляет 50 или более, он наносит дополнительный урон и уменьшает броню пораженных врагов.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ренектон совершает рывок, нанося {{ basicdamage }} физического урона . При этом он получает {{ minionragegeneration }} ярости за каждого пораженного врага, не являющегося чемпионом, и {{ championragegeneration }} ярости за каждого пораженного чемпиона. Если Ренектон поразил хотя бы одного врага, он может один раз повторно применить это умение в течение {{ dicetimer }} сек. Бонус ярости : урон рывка при повторном применении увеличивается до {{ empdamage }} . Кроме того, этот рывок уменьшает броню врагов на {{ enragedarmorshred }}% на {{ shredtimer }} сек. Усиленное умение не дает ярости .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Source_Malphite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#SourceDocument"/>
    <rdfs:label>Source_Malphite</rdfs:label>
    <lol:sourceURL rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://ddragon.leagueoflegends.com/cdn/16.20.1/data/ru_RU/champion/Malphite.json</lol:sourceURL>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Morgana_R">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>Morgana_R</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Оковы души</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_Morgana"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Morgana:R</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Моргана высвобождает всю свою небесную мощь, расправляя крылья и взмывая над землей. Она выпускает цепи темной агонии во вражеских чемпионов поблизости и увеличивает свою скорость передвижения. Ее цепи замедляют и наносят начальный урон, а после задержки оглушают тех, кто не смог их разорвать.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Моргана приковывает себя цепями к окружающим вражеским чемпионам, нанося {{ totaldamage }} магического урона и замедляя их на {{ slowpercent }}%. Через {{ chainduration }} сек. враги, которые не смогли разорвать цепи, дополнительно получают {{ totaldamage }} магического урона и оглушаются на {{ stunduration }} сек. При применении этого умения Моргана увеличивает свою скорость передвижения на {{ hastepercent }}% .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
    <lol:hasEffect rdf:resource="https://example.org/lol-ontology#Morgana_R_Damage_Enemy"/>
    <lol:hasEffect rdf:resource="https://example.org/lol-ontology#Morgana_R_Slow_Enemy"/>
    <lol:hasEffect rdf:resource="https://example.org/lol-ontology#Morgana_R_Stun_Enemy"/>
    <lol:hasEffect rdf:resource="https://example.org/lol-ontology#Morgana_R_MovementSpeedBoost_Self"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#MissFortune_R">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#ActiveAbility"/>
    <rdfs:label>MissFortune_R</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Время умирать</lol:name>
    <lol:hasSource rdf:resource="https://example.org/lol-ontology#Source_MissFortune"/>
    <lol:entityId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MissFortune:R</lol:entityId>
    <lol:slot rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R</lol:slot>
    <lol:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Мисс Фортуна выпускает шквал пуль веером перед собой, нанося гигантский урон врагам. Каждая волна может наносить критический урон.</lol:description>
    <lol:tooltipText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Мисс Фортуна выпускает шквал пуль из {{ basewaves }} залпов в течение {{ basechannelduration }} сек., нанося {{ physicaldamageperwave }} ед. физического урона каждым залпом (всего умение наносит {{ totalphysicaldamage }} ед. физического урона ). Каждый залп может быть критическим. В таком случае он наносит %i:scaleCrit% {{ critdamageperwave }} ед. физического урона .{{ spellmodifierdescriptionappend }}</lol:tooltipText>
    <lol:gameVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">16.20.1</lol:gameVersion>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lol-ontology#Neeko">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lol-ontology#Champion"/>
    <rdfs:label>Neeko</rdfs:label>
    <lol:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Нико</lol:name>
