      "boundElements": null,
      "updated": 1791216569868,
      "link": null,
      "locked": false,
      "text": "Робот не читает данные с отдельных сенсоров. \nСоздаём SensorFusionEngine который аггрегирует\nданные с разных сенсоров.",
      "fontSize": 20,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 68,
      "containerId": null,
      "originalText": "Робот не читает данные с отдельных сенсоров. \nСоздаём SensorFusionEngine который аггрегирует\nданные с разных сенсоров.",
      "lineHeight": 1.25
    },
    {
      "type": "text",
      "version": 223,
      "versionNonce": 838437612,
      "isDeleted": false,
