      "locked": false,
      "fontSize": 36,
      "fontFamily": 1,
      "text": "«Встречный разъезд двух роботов в узком межстеллажном проезде (Deadlock Avoidance)»",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "«Встречный разъезд двух роботов в узком межстеллажном проезде (Deadlock Avoidance)»",
      "lineHeight": 1.25,
      "baseline": 32
    },
    {
      "type": "text",
      "version": 132,
      "versionNonce": 1559893588,
      "isDeleted": false,
      "id": "3yqOeZKtMZcEDn1xqvXzv",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": -90.08744517071455,
      "y": 1260.0634485883786,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "width": 1729.6875,
      "height": 43.199999999999996,
      "seed": 1973772500,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1791215801273,
      "link": null,
      "locked": false,
      "fontSize": 36,
      "fontFamily": 3,
      "text": "[Робот A (С грузом)] ===>  | Узкий коридор (1 полоса) |  <=== [Робот B (Порожний)]",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "[Робот A (С грузом)] ===>  | Узкий коридор (1 полоса) |  <=== [Робот B (Порожний)]",
      "lineHeight": 1.2,
      "baseline": 35
    },
    {
      "type": "text",
      "version": 266,
      "versionNonce": 404236524,
      "isDeleted": false,
      "id": "ULPT7DWcDkScaxZzHxr7r",
