    {
      "id": "-7fbY6dQ18ixO1og3DeRq",
      "type": "text",
      "x": 1861.1396092531181,
      "y": 410.832422029188,
      "width": 1052.7156982421875,
      "height": 490,
      "angle": 0,
      "strokeColor": "#1e1e1e",
