{
  "folders": [
    {
      "name": "ITMO 学习笔记",
      "path": "."
    }
  ],
  "settings": {
    "[markdown]": {
      "editor.wordWrap": "on"
    },
    "markdown.preview.fontSize": 16,
    "markdown.preview.lineHeight": 1.7,
    "markdown.preview.scrollEditorWithPreview": true,
    "markdown.preview.scrollPreviewWithEditor": true,
    "search.exclude": {
      "**/node_modules": true,
      "**/.packages": true,
      "**/.python_deps": true,
      "**/javafx-sdk-*": true,
      "**/target": true,
      "**/build": true,
      "**/bin": true,
      "**/obj": true,
      "**/__pycache__": true,
      "**/tmp": true,
      "**/.build": true
    },
    "files.exclude": {
      "**/node_modules": true,
      "**/.packages": true,
      "**/.python_deps": true,
      "**/__pycache__": true,
      "**/.build": true
    }
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "知识库：生成学期与课程导航",
        "type": "process",
        "command": "node",
        "args": [
          "tools/generate-index.mjs"
        ],
        "options": {
          "cwd": "${workspaceFolder}"
        },
        "problemMatcher": []
      }
    ]
  }
}
